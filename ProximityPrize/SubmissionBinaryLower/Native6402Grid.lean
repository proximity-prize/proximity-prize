theorem branches_ok : ∀ i : Fin 120, ∀ r : Fin 5, covered key (tag i) r last first ((chain i r).1::(chain i r).2)=true := by decide +kernel

theorem select (i : Fin 120) (r : Fin 5) (c : ℚ) (lo : first≤c) (hi : c≤last) :
    ∃ j : Fin 237,(key j).branch=tag i ∧ coversGap (key j) r ∧ 0<(key j).cLoDen ∧ 0<(key j).cHiDen ∧
      B6402GridProfile.lo (key j)≤c ∧ c≤B6402GridProfile.hi (key j) :=
  closed_sound key (tag i) r last first c _ _ (branches_ok i r) hi lo

theorem tag_A (br : T4ABranch)
    (ok : match br with | .det | .p0Zero => True | .p0 m _ p q => m=false → p=true ∧ q=false
                        | .b1c1 _ _ i => i<6) : ∃ i : Fin 120,tag i=.inl br := by
  cases br with
  | det => decide +kernel
  | p0Zero => decide +kernel
  | p0 m r p q =>
    cases m <;> cases r <;> cases p <;> cases q <;> simp at ok <;> decide +kernel
  | b1c1 a b c =>
    change c<6 at ok
    cases a <;> cases b <;> interval_cases c <;> decide +kernel

theorem tag_B (br : T4BBranch) (q : br.q1Case<3) (o : br.odeCase<7) : ∃ i : Fin 120,tag i=.inr br := by
  rcases br with ⟨a,b,c,d⟩
  change c<3 at q; change d<7 at o
  cases a <;> cases b <;> interval_cases c <;> interval_cases d <;> decide +kernel

#print axioms select
#print axioms tag_A
#print axioms tag_B
end Native6402Grid
