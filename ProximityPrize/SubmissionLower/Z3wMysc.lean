set_option autoImplicit true
namespace qoWrama
open qxuyiwe (h52)
open qHde8fc (Ground Exponent Triple aD yv)
noncomputable section
abbrev aY := {e :Exponent // e.degree=52}
abbrev gU (cut:ℕ) :=
  qK9H6va.Lh 52 (cut:ℤ)
def cP:Triple→ℕ
  | (b,c,f)=>4*(52 - (b+c+f))+b+2*c+3*f
def dZ (e :aY) :ℕ :=
  ((cP (aD e.val)*53+e.val 3)*53+e.val 2)*53+e.val 1
def cE (cut:ℕ) (v :Triple) :gU cut→Ground :=
  yv Subtype.val v
abbrev Gap:=Fin h52.length
abbrev Group (g:Gap) :=Σ i:Fin 57,Fin (groupCount g.val i.val)
abbrev GroupedPivot:=Σ g:Gap,Group g
def Ug (j:GroupedPivot) :Triple :=
  ZX j.1.val j.2.1.val j.2.2.val
def Nx (j:GroupedPivot) :ℤ:=j.2.1.val
def c37 (j:GroupedPivot) :ℕ:=j.1.val+j.2.1.val
abbrev iw (e :aY) := {v :aY // dZ v<dZ e}
def bk1 (e :aY) :Prop :=
  ∃ cut:ℕ,
    (cut≤ cP (aD e.val)-98 ∨
      ∃ j:GroupedPivot,Ug j=aD e.val ∧
        c37 j=cP (aD e.val)∧(cut:ℤ)≤Nx j+1) ∧
    cE cut (aD e.val) ∈
      Submodule.span Ground (Set.range fun v :iw e=>cE cut (aD v.val.val))
def aGq (lo hi:ℕ) :Prop :=
  ∀ e :aY,lo≤ cP (aD e.val)→cP (aD e.val)≤hi →
    bk1 e
abbrev bk9 (cut:ℕ) := {j:GroupedPivot //
  c37 j<tailCost∧(cut:ℤ)≤Nx j}
end
end qoWrama
end
section
set_option autoImplicit true
namespace qoWrama
open qK9H6va (XN iO Gy Vm)
open qHde8fc (Ground aD yv)
open fP (lP m9 cF oG)
open private EI from ProximityPrize.SubmissionLower.ZzeWNbd
local instance :Fact (Nat.Prime P1.p) :=⟨KoalaBear.is_prime⟩
noncomputable section
theorem Sj (e :aY) :cP (aD e.val)=52+e.val.weight m9:= by
  have hd:=e.property
  rw [cF] at hd
  rw [oG]
  simp only [aD,cP]
  omega
private theorem d0t {e v :aY} (h:dZ v<dZ e) :
    cP (aD v.val)≤ cP (aD e.val) := by
  have he :=e.property
  rw [cF] at he
  unfold dZ at h
  omega
abbrev Visible (g w:ℤ) :=
  {j:GroupedPivot // (c37 j:ℤ)<w ∧ -g≤Nx j}
instance (g w:ℤ) :Fintype (Visible g w) :=Fintype.ofFinite _
private def cGT (q:ℕ) (g:ℤ) (cut:ℕ) (hd:iO q=52)
    (hcut:cut≤(-g).toNat) :XN q g→ gU cut:= fun m =>
  ⟨m.val,m.property.1.trans hd,by
    have hlo:=m.property.2.1
    have hn:0≤(m.val.weight lP:ℤ) := by omega
    omega,m.property.2.2⟩
theorem rank_le_visible (head:aGq 52 (tailCost - 1))
    (tail : ∀ cut:ℕ,tailCost - 98≤ cut→cut≤56 →
      Fintype.card (gU cut)≤Fintype.card (bk9 cut))
    (q:ℕ) (g:ℤ) (hd:iO q=52) :
    (Gy q g).rank≤Fintype.card (Visible g (Vm q g+52)) := by
  classical
  let w:=Vm q g+52
  let v (j:Visible g w) :=yv (κ:=XN q g) Subtype.val (Ug j.val)
  let S:=Submodule.span Ground (Set.range v)
  let ell:=(-g).toNat
  have hq:52≤q:= by
    rw [← hd]
    exact min_le_left q (P6_6_1.asu q)
  have hcutoff :w≤99 - g:= by dsimp [w,Vm]; omega
  by_cases hwide : (tailCost:ℤ)<w
  · have hcut:tailCost - 98≤ell:= by dsimp only [ell]; omega
    by_cases hell:ell≤56
    · let f :=cGT q g ell hd le_rfl
      have hf :Function.Injective f := fun _ _ h =>
        Subtype.ext (congrArg (fun m:gU ell=>m.val) h)
      let addPivot (j:bk9 ell) :Visible g w :=
        ⟨j.val,by
          have h:=j.property.1
          omega,by
          have h:=j.property.2
          dsimp only [ell] at h
          omega⟩
      have hinj:Function.Injective addPivot:= fun _ _ h =>
        Subtype.ext (congrArg (fun j:Visible g w=>j.val) h)
      exact (Gy q g).rank_le_card_width.trans
        ((Fintype.card_le_of_injective f hf).trans
          ((tail ell hcut hell).trans (Fintype.card_le_of_injective addPivot hinj)))
    · have hnot (m:XN q g) :False := by
        have hlo:=m.property.2.1
        have hhi:=m.property.2.2.1
        dsimp only [ell] at hell
        omega
      let:IsEmpty (XN q g) :=⟨hnot⟩
      exact (Gy q g).rank_le_card_width.trans (by simp)
  have hrows : ∀ n (e :aY),dZ e=n →
      (cP (aD e.val) :ℤ)<w →
      yv (κ:=XN q g) Subtype.val (aD e.val)∈S:= by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro e he hweight
      let R:=cP (aD e.val)
      have hRlo:52≤R:= by dsimp only [R]; rw [Sj]; omega
      change (R:ℤ)<w at hweight
      have hRhi:R≤tailCost - 1 := by omega
      have hRcut:R<99+ell:= by dsimp only [ell]; omega
      obtain ⟨cut,hsmall,hdep⟩:=head e hRlo hRhi
      by_cases hcut:cut≤ell
      · exact EI (cGT q g cut hd hcut)
          (fun a :iw e=>cE cut (aD a.val.val)) _ S hdep (by
            intro a
            have hlt:=a.property.trans_le he.le
            have hle :=d0t a.property
            exact ih _ hlt a.val rfl (by omega))
      · rcases hsmall with hsmall | ⟨j,hj,hw,hik⟩
        · omega
        · have heng : -g≤Nx j:= by
            have hcut' : ell<cut:=Nat.lt_of_not_ge hcut
            dsimp only [ell] at hcut'
            omega
          have hmem:=Submodule.subset_span (R:=Ground)
            (Set.mem_range_self (f :=v) (⟨j,by rwa [hw],heng⟩:Visible g w))
          change yv _ (Ug j)∈S at hmem
          simpa only [hj] using hmem
  rw [Matrix.rank_eq_finrank_span_row]
  refine (Submodule.finrank_mono (show Submodule.span Ground (Set.range (Gy q g).row)≤S
    from Submodule.span_le.mpr ?_)).trans (finrank_range_le_card v)
  rintro _ ⟨e,rfl⟩
  let E :aY:=⟨e.val,e.property.1.trans hd⟩
  have hw:=e.property.2
  exact hrows _ E rfl (by
    rw [Sj]
    change e.val.weight m9<(Vm q g).toNat at hw
    dsimp only [w,E]
    omega)
end
end qoWrama
end
