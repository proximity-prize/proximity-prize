set_option Elab.async true

theorem zero_r20_part96 : ∀ i ∈ List.range 1, ZeroCheckAt 20 (96+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 20 96 := by decide +kernel
  exact zeroAtFast_sound 20 96 hfast

