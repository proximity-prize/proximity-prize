theorem jets_finite (q : Surface) (hq : Parent q) :
    Module.Finite SectionField (SectionRing q .jets) := by
  obtain ⟨g, hg, hk, _⟩ := hq.jet_side
  have hd : q.asIdeal.comap jetProjection.intoJet = ⊥ := by
