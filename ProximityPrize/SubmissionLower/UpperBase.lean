section
namespace P1_7
noncomputable section
open Polynomial
open P1 (HighBand AnchorModel AnchoredFamily K p node twist agreement)
open K1_14 (L FX Seeds Equation Shape Jet Banks SeedBound liftPoly graphEval atX atMark
  jetAt triangle slots shapeSum)
open K1_14_3 (Surface Parent)
open scoped BigOperators
def InBand (b : HighBand) (w : ℤ) : Prop := (b.row.lo : ℤ) ≤ w ∧ w ≤ (b.row.hi : ℤ)
def AdjacentChart {u del} (M : AnchorModel u del) {Γ} (F : AnchoredFamily M Γ)
    (H : L[X]) : Prop :=
  let σ := frobenius L p
  let H' := H.map σ
  H.Monic ∧ H.natDegree = M.overhead.toNat ∧ H ∣ liftPoly M.E ∧
  H'.Monic ∧ H'.natDegree = M.overhead.toNat ∧ H' ∣ liftPoly (M.E.map twist) ∧
  IsCoprime H H' ∧
  (∀ i, H.eval (algebraMap K L (node i)) ≠ 0 ∧ H'.eval (algebraMap K L (node i)) ≠ 0) ∧
  IsCoprime (liftPoly (M.Q * M.factor * M.A₀)) H ∧
  IsCoprime ((liftPoly (M.Q * M.factor * M.A₀)).map σ) H' ∧
  ∀ γ ∈ Γ,
    let z := algebraMap K L (M.label γ)
    let D := liftPoly (M.factor * M.amplitude γ)
    let S := liftPoly (F.scalar γ)
    IsCoprime D H ∧ IsCoprime (D.map σ) H' ∧
    H ∣ D * S + C z * liftPoly M.Q ∧
    H' ∣ D.map σ * S + C (z ^ p) * (liftPoly M.Q).map σ
abbrev GradeIndex (b : HighBand) := Fin (grades b).length
def Listed (b : HighBand) (t : Bank) : Prop :=
  t = terminal b ∨ (∃ s ∈ stages b, t = s.free ∨ t = s.moving) ∨
    ∃ i : GradeIndex b, t = subbank b ((grades b).get i)
def fullCutoff (s : Shape) := s.m * agreement - 1
def buffered (h r : ℕ) (s : Shape) := fullCutoff s - 2*h*r
def debit (h : ℕ) (t : Bank) :=
  triangle t.shape.U * t.nodeRows + 2*h*(t.shape.U+1)*t.poleMoment
def RankFloor (h : ℕ) (t : Bank) (rows : Banks) : Prop :=
  ∀ W < t.shape.m * agreement,
    (∀ q ≤ t.shape.B, ∀ j ≤ min q t.shape.J, q * (131071-h) ≤ W+1+j) →
    triangle t.shape.U * shapeSum t.shape (fun q j => W+1+j - q*(131071-h)) ≤
      debit h t + ∑ w ∈ Finset.range (W+1), Module.finrank FX (rows t.shape w)
structure Source (b : HighBand) {u del} (M : AnchorModel u del) {Γ}
    (F : AnchoredFamily M Γ) (rows : Banks) : Prop where
  nested : ∀ t, Listed b t → ∀ t', Listed b t' →
    t.shape.m = t'.shape.m → t.shape.B = t'.shape.B → t.shape.J = t'.shape.J →
    t.shape.U ≤ t'.shape.U → ∀ W W', W ≤ W' → rows t.shape W ≤ rows t'.shape W'
  necessary : ∀ t, Listed b t → ∀ W < t.shape.m * agreement, ∀ P ∈ rows t.shape W,
    ∀ γ ∈ Γ, jetAt P (M.label γ) (F.scalar γ) = 0
  shape : ∀ t, Listed b t → ∀ W, ∀ P ∈ rows t.shape W, K1_14_3.RowCaps P t.shape
  leading : ∀ t, Listed b t → K1_14_3.LeadingFilter M.overhead.toNat rows t.shape
  shift : ∀ t, Listed b t → K1_14_3.SeedShift M.overhead.toNat rows t.shape
  floor_bound : ∀ t, Listed b t → RankFloor M.overhead.toNat t rows
structure BufferedPair (h : ℕ) (rows : Banks) (s : Stage) where
  free : Jet
  moving : Jet
  free_ne : free ≠ 0
  moving_ne : moving ≠ 0
  free_mem : free ∈ rows s.free.shape (buffered h s.reserve s.free.shape)
  moving_mem : moving ∈ rows s.moving.shape (buffered h s.reserve s.moving.shape)
  no_moving : K1_14_3.NoMovingCommon free moving
abbrev Pairs (b : HighBand) (h : ℕ) (rows : Banks) :=
  ∀ s ∈ stages b, BufferedPair h rows s
def BankPass (rows : Banks) (s : Shape) (q : Surface) : Prop :=
  ∀ P ∈ rows s (fullCutoff s), P ∈ q.asIdeal
def PairPass {h rows s} (pair : BufferedPair h rows s) (q : Surface) : Prop :=
  BankPass rows s.free.shape q ∧ BankPass rows s.moving.shape q ∧
    K1_14_3R.compatible pair.free pair.moving q
def MarkOn {u del} (M : AnchorModel u del) {Γ} (F : AnchoredFamily M Γ)
    (q : Surface) (γ : K) : Prop :=
  q.asIdeal ≤ RingHom.ker
    (eval₂RingHom (eval₂RingHom (graphEval (M.label γ)) (atX (F.scalar γ)))
      (atX (F.scalar γ).derivative))
structure PrefixInventory (b : HighBand) {u del} (M : AnchorModel u del) {Γ}
    (F : AnchoredFamily M Γ) {rows : Banks} (pairs : Pairs b M.overhead.toNat rows) where
  books : PrefixBooks b
  parents : Finset Surface
  geometric : ∀ q ∈ parents, Parent q
  stage_pass : ∀ q ∈ parents, ∀ s (hs : s ∈ stages b), 0 < s.reserve →
    PairPass (pairs s hs) q
  terminal_pass : ∀ q ∈ parents, BankPass rows (terminal b).shape q
  covers : ∀ γ ∈ Γ, γ ∈ books.union ∨ ∃ q ∈ parents, MarkOn M F q γ
def curveUnit (hi g : ℕ) : ℚ :=
  let d := degreeAt hi
  (2*(g : ℚ)-1) * (1 + 2*((P1.blockLength : ℚ)/agreement)*d) +
    ((P1.blockLength - d : ℕ) : ℚ) / gap hi
def CurveTariff (b : HighBand) {u del} (M : AnchorModel u del) {Γ}
    (F : AnchoredFamily M Γ) : Prop :=
  ∀ T ⊆ Γ, ∀ J g H, 0 < g → g ≤ 80 →
    K1_14_2.SmallRootCurve J g H →
    Module.finrank K1_14_2.SeedField (K1_14_2.RootSeedSection J) < p →
    (∀ γ ∈ T, K1_14_2.OnRoot J (M.label γ) (F.scalar γ)) →
    (T.card : ℚ) ≤ curveUnit b.row.hi g * H + g
abbrev Test (b : HighBand) := Option (GradeIndex b)
def tested (b : HighBand) : Test b → Bank
  | none => terminal b
  | some i => subbank b ((grades b).get i)
def threshold (b : HighBand) : Test b → ℕ
  | none => (grades b).length + 1
  | some i => i.val + 1
def seedThreshold (b : HighBand) : Test b → ℕ
  | none => 0
  | some i => ((grades b).get i).seedCap + 1
def contactPower (h : ℕ) (s : Shape) (W : ℕ) := 1 + (fullCutoff s - W)/(2*h)
def jointGain (h : ℕ) (s : Shape) (E v : ℕ) : ℕ :=
  shapeSum s fun q j =>
    let g := (q-j)/E
    let x := s.m*agreement+j - q*(131071-h)
    let c := fun a => slots s.U (a*v)
    (∑ a ∈ Finset.range g, (c a - c (a+1)) * (x - 2*h*(j+a))) +
      c g * (x - 2*h*(j+g))
structure TerminalTrace (h : ℕ) (t : Bank) (rows : Banks) (f : Equation) : Prop where
  floor_bound : RankFloor h t rows
  shape : ∀ W, ∀ P ∈ rows t.shape W, K1_14_3.RowCaps P t.shape
  leading : K1_14_3.LeadingFilter h rows t.shape
  divides : ∀ W < t.shape.m * agreement, ∀ P ∈ rows t.shape W, P ≠ 0 →
    f ^ (contactPower h t.shape W - P.natDegree) ∣ P.leadingCoeff
def Reduced (f : Equation) : Prop :=
  0 < f.natDegree ∧ f.IsPrimitive ∧ (f.map (algebraMap Seeds (FractionRing Seeds))).Separable
def regularRoot (f : Equation) (z : K) (S : K[X]) : Prop :=
  atMark f z S = 0 ∧ graphEval z (f.resultant f.derivative) ≠ 0 ∧
    atMark f.derivative z S ≠ 0
end
end P1_7
end
section
namespace P1_7
noncomputable section
open Polynomial
open P1 (AnchorModel AnchoredFamily K p node twist)
open K1_14 (FX L Seeds Equation liftPoly graphEval atX atMark SeedBound)
open private resultant_degree derivative_seedBound from ProximityPrize.SubmissionLower.Fast023
theorem adjacent_chart {u del} (M : AnchorModel u del) {Γ} (F : AnchoredFamily M Γ) :
    ∃ H, AdjacentChart M F H := by
  let φ := algebraMap K L
  let σ := frobenius L p
  have hsmall : M.overhead.toNat ≤ (liftPoly M.E).natDegree := by
    rw [liftPoly, natDegree_map]
    unfold P1.AnchorModel.overhead P1.ModelAt.overhead
    omega
  obtain ⟨H, hm, hdeg, hd⟩ := K1_14.trim _ _ hsmall
  have hd' : H.map σ ∣ liftPoly (M.E.map twist) := by
    change H.map σ ∣ liftPoly (M.E.map K1.twist)
    rw [K1_14.twist_lift]
    exact Polynomial.map_dvd σ hd
  have hcop : IsCoprime H (H.map σ) := by
    have ha := M.adjacent_coprime.map (Polynomial.mapRingHom φ)
    exact (ha.of_isCoprime_of_dvd_left hd).of_isCoprime_of_dvd_right hd'
  have hunit : IsCoprime (liftPoly (M.Q * M.factor * M.A₀)) H :=
    (((M.offset_reduced.mul_left M.coprime_factor.symm).mul_left M.first_amplitude_unit).map
      (Polynomial.mapRingHom φ)).of_isCoprime_of_dvd_right hd
  refine ⟨H, hm, hdeg, hd, hm.map σ, (natDegree_map σ).trans hdeg, hd', hcop, ?_,
    hunit, hunit.map (Polynomial.mapRingHom σ), ?_⟩
  · intro i
    have h₀ : H.eval (φ (node i)) ≠ 0 := by
      intro hz
      have hb : (liftPoly M.E).eval (φ (node i)) = 0 := by
        obtain ⟨J, hj⟩ := hd
        simp [hj, eval_mul, hz]
      exact M.E_nodes i (φ.injective (by simpa [liftPoly, φ] using hb))
    have hx : σ (φ (node i)) = φ (node i) := by
      change φ (node i) ^ p = _
      rw [← map_pow, FrobeniusLocator.Native.native_domain_fixed]
    refine ⟨h₀, ?_⟩
    rw [← hx, eval_map_apply]
    exact (map_ne_zero σ).mpr h₀
  · intro γ hγ
    let z := M.label γ
    let B := F.mark γ hγ
    have ha : IsCoprime (liftPoly (M.factor * M.amplitude γ)) H :=
      ((M.coprime_factor.symm.mul_left B.pole_unit).map
        (Polynomial.mapRingHom φ)).of_isCoprime_of_dvd_right hd
    have hid : M.E ∣ (M.factor * M.amplitude γ) * F.scalar γ + C z * M.Q :=
      ⟨M.decoder B.bad, by rw [← B.identity]; ring⟩
    have hres : H ∣ liftPoly (M.factor * M.amplitude γ) * liftPoly (F.scalar γ) +
        C (φ z) * liftPoly M.Q := by
      simpa only [liftPoly, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C]
        using hd.trans (Polynomial.map_dvd φ hid)
    have hfix : (liftPoly (F.scalar γ)).map σ = liftPoly (F.scalar γ) := by
      rw [← K1_14.twist_lift]
      exact congrArg liftPoly B.scalar_fixed
    refine ⟨ha, ha.map (Polynomial.mapRingHom σ), hres, ?_⟩
    simpa only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, hfix,
      σ, frobenius_def] using (Polynomial.map_dvd σ hres)
theorem resultant_bounds {f : Equation} {v : ℕ} (hf : Reduced f) (hs : SeedBound f v) :
    f.resultant f.derivative ≠ 0 ∧
    (f.resultant f.derivative).totalDegree ≤ singularDegree f.natDegree v := by
  let ι := algebraMap Seeds (FractionRing Seeds)
  have hi := IsFractionRing.injective Seeds (FractionRing Seeds)
  have hcop : IsCoprime (f.map ι) (f.derivative.map ι) := by
    simpa only [Separable, ← derivative_map] using hf.2.2
  have hne := resultant_ne_zero _ _ hcop
  rw [natDegree_map_eq_of_injective hi, natDegree_map_eq_of_injective hi,
    resultant_map_map] at hne
  refine ⟨fun h => hne (by simp [h]), (resultant_degree hs (derivative_seedBound hs)).trans ?_⟩
  apply Nat.mul_le_mul_right
  have := natDegree_derivative_le f
  omega
theorem regular_of_resultant {f : Equation} {z : K} {S : K[X]} (hf : 0 < f.natDegree)
    (hr : atMark f z S = 0) (hg : graphEval z (f.resultant f.derivative) ≠ 0) :
    regularRoot f z S := by
  refine ⟨hr, hg, fun hd => hg ?_⟩
  obtain ⟨a, b, _, _, hbez⟩ := exists_mul_add_mul_eq_C_resultant f f.derivative
    (le_refl _) (le_refl _) (Or.inl hf.ne')
  have ev := congrArg (eval₂RingHom (graphEval z) (atX S)) hbez
  change f.eval₂ _ _ = 0 at hr
  change f.derivative.eval₂ _ _ = 0 at hd
  simpa [eval₂_add, eval₂_mul, hr, hd] using ev.symm
theorem resultant_count {u del} (M : AnchorModel u del) {f : Equation} {v : ℕ}
    (hf : Reduced f) (hs : SeedBound f v) (hp : singularDegree f.natDegree v < p)
    (T : Finset K) (he : ∀ γ ∈ T, graphEval (M.label γ) (f.resultant f.derivative) = 0) :
    T.card ≤ singularFee f.natDegree v := by
  classical
  obtain ⟨hn, hd⟩ := resultant_bounds hf hs
  let C : K1_14_3.SeedCover := ⟨_, hn, ∅⟩
  have hz := K1_14_3.seed_count (T := T) (label := M.label)
    (fun _ _ _ _ h => sub_left_inj.mp h) C (hd.trans_lt hp) (fun γ hγ => Or.inl (he γ hγ))
  exact (show T.card ≤ (p+1)*(f.resultant f.derivative).totalDegree by
    simpa only [C, Finset.card_empty, Nat.add_zero] using hz).trans (Nat.mul_le_mul_left _ hd)
theorem fixed_count {u del} (M : AnchorModel u del) {Γ} (F : AnchoredFamily M Γ)
    (T : Finset K) (hT : T ⊆ Γ) {f : Equation} (hf : 0 < f.natDegree) (hs : SeedBound f 0)
    (hr : ∀ γ ∈ T, atMark f (M.label γ) (F.scalar γ) = 0) : T.card ≤ f.natDegree := by
  classical
  let g := f.map (graphEval 0)
  have hc (z : K) (i : ℕ) : graphEval z (f.coeff i) = (f.coeff i).coeff 0 := by
    have h := MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp (Nat.eq_zero_of_le_zero (hs i))
    conv_lhs => rw [h]
    simp [graphEval]
  have he (z : K) : f.map (graphEval z) = g := by
    ext i
    simp only [g, coeff_map, hc]
  have hn : g ≠ 0 := by
    intro hz
    have hlead := congrArg (fun G : FX[X] => G.coeff f.natDegree) hz
    simp only [g, coeff_map, hc, coeff_zero] at hlead
    have h := MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp
      (Nat.eq_zero_of_le_zero (hs f.natDegree))
    have hfn : f ≠ 0 := fun h0 => by simp [h0] at hf
    exact (leadingCoeff_ne_zero.mpr hfn) (h.trans (by rw [hlead, map_zero]))
  let val := fun γ => atX (F.scalar γ)
  have hi : Set.InjOn val (T : Set K) :=
    fun _ ha _ hb h => F.distinct (hT ha) (hT hb) (K1_14_3.scalar_atX_injective h)
  calc
    T.card = (T.image val).card := (Finset.card_image_of_injOn hi).symm
    _ ≤ g.natDegree := Polynomial.card_le_degree_of_subset_roots (by
      intro x hx
      obtain ⟨γ, hγ, rfl⟩ := Finset.mem_image.mp hx
      apply (Polynomial.mem_roots hn).mpr
      change g.eval (val γ) = 0
      rw [← he (M.label γ), Polynomial.eval_map]
      exact hr γ hγ)
    _ ≤ f.natDegree := Polynomial.natDegree_map_le
end
end P1_7
