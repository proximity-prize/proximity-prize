abbrev agreement : ℕ := 179974
abbrev errors : ℕ := 82170
abbrev physicalDegree := LowCover82170.physicalDegree
abbrev taylorLength : ℕ := physicalDegree + 1
abbrev incidenceGap : ℕ := agreement - physicalDegree
abbrev anchorCutoff := LowCover82170.anchorCutoff
abbrev primaryCutoff := LowLayers82170.primaryCutoff
abbrev primaryBox := LowLayers82170.primaryBox
abbrev TrueWeightLE {n : ℕ} := @PrimaryRows82170.TrueWeightLE n
