theorem zr27p16:∀ i ∈ List.range 1,ZeroCheckAt 27 (16+i):=by
  intro i hi
  have hi0:i = 0:=by have:=List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast:ZeroAtFast 27 16:=by decide +kernel
  exact zeroAtFast_sound 27 16 hfast

