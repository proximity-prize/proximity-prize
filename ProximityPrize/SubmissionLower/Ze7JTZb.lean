private theorem fWE (b:fO) (o:ℕ) (k :Fin 4) :
 0≤bookResidual b o k :=div_nonneg (Nat.cast_nonneg _) (by decide)
private theorem rank_at {b:fO} {o:ℕ}
   (h1 :rankPrice b o 1≤bookResidual b o 1)
   (h2 :rankPrice b o 2≤bookResidual b o 2) (k :Fin 4) :
   rankPrice b o k≤bookResidual b o k := by
 fin_cases k
 · change rankPrice b o 0≤bookResidual b o 0
   cases hb:P5_7_2.rankBlend b <;>
     simpa only [rankPrice,hb,Matrix.cons_val_zero] using fWE b o 0
 · exact h1
 · exact h2
 · change rankPrice b o (Fin.succ (Fin.succ (Fin.succ 0)))≤bookResidual b o 3
   cases hb:P5_7_2.rankBlend b <;>
     simpa only [rankPrice,hb,Matrix.cons_val_zero,Matrix.cons_val_succ] using fWE b o 3
private theorem rank_packed (b:fO) :
  ∀ o:Fin (originCount b),rankPrice b o 1≤bookResidual b o 1 ∧
    rankPrice b o 2≤bookResidual b o 2 := by
 fin_cases b <;> decide +kernel
theorem rank_paid (b:fO) (o:ℕ) (ho:o∈origins b) (k :Fin 4) :
  rankPrice b o k≤ng b o 0 k := by
 have h:=rank_packed b ⟨o,mem_range.mp ho⟩
 have he : ¬ afterFree b≤0:= by unfold afterFree; omega
 have hg:0≤ sumPrefix (bookGlobal b) 0 k :=
  sum_nonneg fun _ _=>div_nonneg (Nat.cast_nonneg _) (by decide)
 simp only [ng,he,ite_false,add_zero]
 exact (rank_at h.1 h.2 k).trans (le_add_of_nonneg_left hg)
end qB9xHGe
