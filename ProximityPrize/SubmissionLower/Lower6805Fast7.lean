  have hcaps:=(mem_flagGlobalCoefficientBox_iff F
    18315643 131071 350390 30 (by decide +kernel)).mp hbox
  have hr:wt residualSWeights F ≤ 30:=hcaps.2.1
  have hw:=residualYS_mul_le_contact_add_slope F 131071 (by decide +kernel)
  have hc:wt (contactWeights 131071) F ≤ 18315643:=by omega
  omega
theorem common_A_slope_le (u0 u1:I → K) (F:P4) (hF:F ≠ 0)
    (hdiv:∀ v:AKernel u0 u1,F ∣ reconstruct K 18315643 131071 350390 30 v.1) :
    wt residualSWeights F ≤ 30:=
  ((mem_flagGlobalCoefficientBox_iff F 18315643 131071 350390 30 (by decide +kernel)).mp
    (full_A_divisor_mem_box u0 u1 F hF hdiv)).2.1
theorem common_B_slope_le (u0 u1:I → K) (F:P4) (hF:F ≠ 0)
