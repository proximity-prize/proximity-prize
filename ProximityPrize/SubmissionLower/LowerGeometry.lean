        + (tailSeeds F selected Gamma).card) ≤
      ChainAmort.capSumT (fun t => (Pc t).regularCountCap) S.countCap s :=
    le_trans (Finset.sum_le_sum hrow)
      (ChainAmort.sum_capSumT_le (fun t => (Pc t).regularCountCap) hcmono S.countCap htailLe
