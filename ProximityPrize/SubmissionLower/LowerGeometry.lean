theorem identity_mixed_gateC2 (b s : ℕ) (flag : FlagDegree)
    (hS : s + 2 ≤ 30) (hY : b + s + 3 ≤ 136)
    (hfs : flag.all ≤ s + 2) (hfy : flag.yz + flag.all ≤ b + s + 3) :
