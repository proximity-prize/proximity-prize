      have hMr : M + 1 - h = M - h + 1 := by omega
      have hsr : s + 1 - h = s - h + 1 := by omega
      have hLr : L + 1 - h = L - h + 1 := by omega
      unfold rectangularCount
      rw [hMr, hsr, hLr]
      simp only [Nat.sub_zero]
