        RCN206.directionFlag, cellA, cellB, cellS, hybridCoordinateC1,
        rationalFlag, RCN327.w, Nat.reduceAdd, Nat.reduceMul] <;> omega
  · apply flagDegree_ext <;>
      simp only [cellMovingFiber, RCN206.fiberFlag, cellA, cellB, cellS,
        movingFiber] <;> omega
  · apply flagDegree_ext <;>
