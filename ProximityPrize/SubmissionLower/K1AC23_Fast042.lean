    rintro ⟨_, b, hb', rfl⟩
    change IsUnit (image (P.intoJet b))
    rw [← RingHom.comp_apply, hpin, RingHom.comp_apply]
    exact (isUnit_iff_ne_zero.mpr (fun e => (mem_nonZeroDivisors_iff_ne_zero.mp hb')
