    (congrArg backward (hforward a)).trans ((hbackward _).trans (hfromE _))
  have h2 : backward.comp forward = AlgHom.id G S := by
    apply Ideal.Quotient.algHom_ext
    apply AlgHom.coe_ringHom_injective
