  have ht:7200 ≤ wt residualTotalWeights F:=by omega
  have hdivK:∀ v:TCapKernel u0 u1,
      F ∣ kernelReconstructLinear (K:=K)
        36268600 131071 7204 62 200 IRSProfile.domain u0 u1 v:=by
