theorem full_A_divisor_mem_box (u0 u1:I → K) (F:P4) (_hF:F ≠ 0)
    (hdiv:∀ v:AKernel u0 u1,F ∣ reconstruct K 18315643 131071 350390 30 v.1) :
    F ∈ globalCoefficientBox K 18315643 131071 350390 30:=
  full_divisor_mem_box 18315643 131071 350390 30 101 gateA u0 u1 F hdiv
theorem full_B_divisor_mem_box (u0 u1:I → K) (F:P4) (_hF:F ≠ 0)
    (hdiv:∀ v:BKernel u0 u1,F ∣ reconstruct K 20129073 131071 21378 33 v.1) :
    F ∈ globalCoefficientBox K 20129073 131071 21378 33:=
  full_divisor_mem_box 20129073 131071 21378 33 111 gateB u0 u1 F hdiv
theorem common_A_ys_le (u0 u1:I → K) (F:P4) (hF:F ≠ 0)
    (hdiv:∀ v:AKernel u0 u1,F ∣ reconstruct K 18315643 131071 350390 30 v.1) :
    wt residualYSWeights F ≤ 139:=by
