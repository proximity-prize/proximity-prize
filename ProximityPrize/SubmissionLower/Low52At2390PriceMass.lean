private theorem mass_eq (r y : Shape) (L : ℕ) (hr : r = zeroShape ∨ 0 < r.j)
    (hj : 0 < r.j+y.j) : availableMass r y L =
    P3_6_8_1.sumBelow (fastLayer r y L) (L + 1650 / (r.j+y.j)) := by
  rw [P3_6_8_1.sumBelow_eq, Low52At2390PriceLayer.availableMass_eq_sum hr hj le_rfl]

open private Low52At2390PriceLayer.check from ProximityPrize.SubmissionLower.Low52At2390PriceLayer

private theorem receipt (k : Band) (b j L : ℕ) (values : List ℕ)
    (hj : 0 < (start k).j+j)
    (h : Low52At2390PriceLayer.check (fastLayer (start k) ⟨b,j,0⟩ L) 0 (L + 1650 / ((start k).j+j)) values = true)
    (hv : values.sum < layerNeed) :
    availableMass (start k) ⟨b,j,0⟩ L < layerNeed := by
  rw [mass_eq (start k) ⟨b,j,0⟩ L (Low52At2390PriceCaps.start_or_index _) hj]
  exact Low52At2390PriceLayer.sumBelow_lt _ _ values h hv

