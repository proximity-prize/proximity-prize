    obtain ⟨hpos, hsmall⟩ := thresholds_valid k q hq
    have hr : start k = zeroShape ∨ 0 < (start k).j := Low52At2390PriceCaps.start_or_index k
    have hi : 0 < (start k).j + q.j := by omega
    exact (Low52At2390PriceLayer.availableMass_anti_prefix (y := ⟨q.b,q.j,0⟩) hr hi hb hj).trans_lt hsmall
