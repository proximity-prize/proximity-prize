private theorem mem_of_dvd {J:Ideal Jet} {a b:Jet} (h:a∣b) (aJ:a∈J) : b∈J:=by
  obtain ⟨c,rfl⟩:=h
  exact J.mul_mem_right _ aJ

/-- After removing main parents that cannot carry a nonzero-helper mark,
coincident graphs give the exact two parent sets. -/
theorem same_sets {A R:Finset Surface} {G H:Pade.Row SeedField} (a:Native G) (b:Native H)
    (ga:G.primitive) (hb:H.primitive) (zero:GraphIntersection.determinant a b=0)
    (miss:∀q∈A,a.poly∉q.asIdeal) (own:∀q∈R,a.poly∈q.asIdeal) :
    owning b.poly (A∪R)=R ∧ outside b.poly (A∪R)=A := by
  have same:=HelperGraph.associated_of_zero a b ga hb zero
  constructor
  · ext q
    constructor
    · intro h
      obtain ⟨hq,on⟩:=mem_filter.mp h
      exact (mem_union.mp hq).resolve_left (fun l=>(miss q l) (mem_of_dvd same.symm.dvd on))
    · intro h
      exact mem_filter.mpr ⟨mem_union_right _ h,mem_of_dvd same.dvd (own q h)⟩
  · ext q
    constructor
    · intro h
      obtain ⟨hq,off⟩:=mem_filter.mp h
      exact (mem_union.mp hq).resolve_right (fun r=>off (mem_of_dvd same.dvd (own q r)))
    · intro h
      exact mem_filter.mpr ⟨mem_union_left _ h,fun on=>(miss q h) (mem_of_dvd same.symm.dvd on)⟩

/-- In the distinct-graph case the rescue projection divides the product
of the global off-graph equation and the single comparison determinant.
Adding the on-graph primary equation covers the entire union. -/
theorem splits {A R:Finset Surface} {G H:Pade.Row SeedField} (a:Native G) (b:Native H)
    (ga:G.primitive) (hb:H.primitive) (own:∀q∈R,a.poly∈q.asIdeal)
    {mainOn off rescue whole:Equation} (pm:JointProjection.Product (owning b.poly A) mainOn)
    (pj:JointProjection.Product (outside b.poly (A∪R)) off)
    (pr:JointProjection.Product R rescue) (pf:JointProjection.Product (A∪R) whole) :
    rescue∣off*GraphIntersection.determinant a b ∧
      whole∣mainOn*(off*GraphIntersection.determinant a b) := by
  let D:=GraphIntersection.determinant a b
  have rmark q (h:q∈R): C (off*D)∈q.asIdeal:=by
    rw [map_mul]
    by_cases good:b.poly∈q.asIdeal
    · exact q.asIdeal.mul_mem_left _ (SharedGraphCount.determinant_mem a b ga hb (own q h) good)
    · exact q.asIdeal.mul_mem_right _ (pj.vanishes (mem_filter.mpr ⟨mem_union_right _ h,good⟩))
  refine ⟨pr.divides rmark,pf.divides ?_⟩
  intro q h
  rw [map_mul]
  rcases mem_union.mp h with main|res
  · by_cases good:b.poly∈q.asIdeal
    · exact q.asIdeal.mul_mem_right _ (pm.vanishes (mem_filter.mpr ⟨main,good⟩))
    · exact q.asIdeal.mul_mem_left _ (by
        rw [map_mul]
        exact q.asIdeal.mul_mem_right _ (pj.vanishes (mem_filter.mpr ⟨h,good⟩)))
  · exact q.asIdeal.mul_mem_left _ (rmark q res)

theorem degree_limits {A R:Finset Surface} {G H:Pade.Row SeedField} (a:Native G) (b:Native H)
    (ga:G.primitive) (hb:H.primitive) (own:∀q∈R,a.poly∈q.asIdeal)
    (ne:GraphIntersection.determinant a b≠0) {x cross:ℕ} (cap:(GraphIntersection.determinant a b).natDegree≤cross)
    {mainOn off rescue whole:Equation} (pm:JointProjection.Product (owning b.poly A) mainOn)
    (pj:JointProjection.Product (outside b.poly (A∪R)) off) (small:off.natDegree≤x)
    (pr:JointProjection.Product R rescue) (pf:JointProjection.Product (A∪R) whole) :
    rescue.natDegree≤x+cross ∧ whole.natDegree≤mainOn.natDegree+x+cross := by
  obtain ⟨rd,fd⟩:=splits a b ga hb own pm pj pr pf
  have nz:=mul_ne_zero pj.primitive.ne_zero ne
  have cut:=natDegree_mul pj.primitive.ne_zero ne
  have left:=natDegree_le_of_dvd rd nz
  have right:=natDegree_le_of_dvd fd (mul_ne_zero pm.primitive.ne_zero nz)
  rw [natDegree_mul pm.primitive.ne_zero nz,cut] at right
  rw [cut] at left
  omega

end
