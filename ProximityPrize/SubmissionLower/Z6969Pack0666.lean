    (pm:JointProjection.Product A pMain) (pr:JointProjection.Product R pRes)
    (pa:JointProjection.Product (A∪R) pAll) : Nonempty (Pieces pOn pOff pMain pRes pAll) := by
  have union:NearBook.owning G A ∪ NearBook.outside G A=A:=by
    ext q
    simp only [NearBook.owning,NearBook.outside,mem_union,mem_filter]
    tauto
  obtain ⟨b,mb,bd,bn,bg,bs⟩:=JointProjection.exclusive on off (union ▸ pm)
  obtain ⟨c,mc,cd,cn,cg,cs⟩:=JointProjection.exclusive pm pr pa
