    rw [mb,K1_14_4.seedDegree_mul on.primitive.ne_zero bn]
  exact ⟨⟨b,c,mb,mc,bd,cd,bn,cn,(JointProjection.remainder off bd).1,
    (JointProjection.remainder pr cd).1,bs,cs,bg ▸ cg,seed⟩⟩

/-- Mark assignment is by specialization. A mark transferred to the first
factor needs only its native root. A mark left on the exclusive rescue
factor is genuinely outside the whole primary projection. -/
theorem labels {K:Type*} [DecidableEq K] {pOn pOff pMain pRes pAll:Equation}
    (P:Pieces pOn pOff pMain pRes pAll) (labels:Finset K) (ev:K→Equation→+*FX)
    (all:∀z∈labels, ev z pAll=0) :
    ∃ a b c:Finset K,a⊆labels ∧ b⊆labels ∧ c⊆labels ∧ a.card+b.card+c.card=labels.card ∧
      (∀z∈a, ev z pOn=0) ∧ (∀z∈b,ev z P.off=0) ∧
      (∀z∈c,ev z P.rescue=0 ∧ ev z pMain≠0) := by
  classical
  let a:=labels.filter fun z=>ev z pOn=0
  let rest:=labels\a
  let b:=rest.filter fun z=>ev z P.off=0
  let c:=rest\b
  have asub:a⊆labels:=filter_subset _ _
  have rsub:rest⊆labels:=sdiff_subset
  have bsub:b⊆rest:=filter_subset _ _
  have csub:c⊆rest:=sdiff_subset
  have s1:rest.card+a.card=labels.card:=card_sdiff_add_card_eq_card asub
  have s2:c.card+b.card=rest.card:=card_sdiff_add_card_eq_card bsub
  refine ⟨a,b,c,asub,bsub.trans rsub,csub.trans rsub,by omega,fun _ hz=>(mem_filter.mp hz).2,fun _ hz=>(mem_filter.mp hz).2,?_⟩
  intro z hz
  have a0:ev z pOn≠0:=fun h=>(mem_sdiff.mp (csub hz)).2 (mem_filter.mpr ⟨rsub (csub hz),h⟩)
  have b0:ev z P.off≠0:=fun h=>(mem_sdiff.mp hz).2 (mem_filter.mpr ⟨csub hz,h⟩)
  have main:ev z pMain≠0:=by rw [P.main_eq,map_mul];exact mul_ne_zero a0 b0
  have root:=all z (rsub (csub hz))
  rw [P.all_eq,map_mul] at root
  exact ⟨(mul_eq_zero.mp root).resolve_left main,main⟩

end
