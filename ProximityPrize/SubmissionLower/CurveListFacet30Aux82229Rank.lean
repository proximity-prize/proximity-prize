private def grade (q : ℕ) : ℕ := total (allowance q) (75-q)
private def gradeBlock (j : ℕ) : ℕ := ∑ q ∈ range 6, grade (6*j+q)

private theorem split_grades (t : ℕ) : ∑ q ∈ range (6*t), grade q = ∑ j ∈ range t, gradeBlock j := by
  induction t with
  | zero => simp
  | succ t ih =>
    calc
      _ = (∑ q ∈ range (6*t), grade q) + gradeBlock t := by
        simpa only [Nat.mul_succ, gradeBlock] using (sum_range_add grade (6*t) 6)
      _ = _ := by rw [ih, sum_range_succ]

private theorem total_rank : (∑ q ∈ range 73, grade q) = 136577 := by
  have h0 : gradeBlock 0 = 2758 := by decide +kernel
  have h1 : gradeBlock 1 = 13447 := by decide +kernel
  have h2 : gradeBlock 2 = 24541 := by decide +kernel
  have h3 : gradeBlock 3 = 26615 := by decide +kernel
  have h4 : gradeBlock 4 = 22260 := by decide +kernel
  have h5 : gradeBlock 5 = 17246 := by decide +kernel
  have h6 : gradeBlock 6 = 12494 := by decide +kernel
  have h7 : gradeBlock 7 = 8360 := by decide +kernel
  have h8 : gradeBlock 8 = 5038 := by decide +kernel
  have h9 : gradeBlock 9 = 2588 := by decide +kernel
  have h10 : gradeBlock 10 = 1003 := by decide +kernel
  have h11 : gradeBlock 11 = 221 := by decide +kernel
  have h12 : grade 72 = 6 := by decide +kernel
  rw [sum_range_succ, show 72 = 6 * 12 by decide, split_grades]
  simp only [sum_range_succ, sum_range_zero, zero_add]
  rw [h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12]

theorem prefix_bound_82229 : prefixRank support 73 ≤ 136577 := by
  change (∑ q ∈ range 73, ∑ u ∈ range (75-q), (blockMatrix support q ((u : ℤ)-22)).rank) ≤ _
  calc
    _ ≤ ∑ q ∈ range 73, ∑ u ∈ range (75-q), allowance q u :=
      sum_le_sum fun q _ => sum_le_sum fun u _ => bound q u
    _ = ∑ q ∈ range 73, grade q := by simp only [grade, total_eq_sum]
    _ = 136577 := total_rank

