theorem zero_r29_part16 : ∀ i ∈ List.range 1, ZeroCheckAt 29 (16+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 29 16 := by decide +kernel
  exact zeroAtFast_sound 29 16 hfast

