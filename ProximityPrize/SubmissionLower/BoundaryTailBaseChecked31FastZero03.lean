theorem zr31p32:∀ i ∈ List.range 1,ZeroCheckAt 31 (32+i):=by
  intro i hi
  have hi0:i = 0:=by have:=List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast:ZeroAtFast 31 32:=by decide +kernel
  exact zeroAtFast_sound 31 32 hfast

