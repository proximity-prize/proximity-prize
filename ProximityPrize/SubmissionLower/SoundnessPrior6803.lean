      by_cases hm : 6 ≤ multiplicity C
      · simp only [cost, if_pos hm]
        calc _ ≤ (stageErrorCap + 1) * B.yzCost C := hcount
          _ ≤ B.weightedCost (cellHybridCoordinateC1 t y r) C :=
            yzCost_mul_le_weightedCost B (cellHybridCoordinateC1 t y r) C
