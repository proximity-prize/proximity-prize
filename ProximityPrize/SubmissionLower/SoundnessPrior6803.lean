theorem channelCount_mono {T T' YS YS' S S':ℕ}
    (ht:T ≤ T') (hy:YS ≤ YS') (hs:S ≤ S') :
    channelCount T YS S ≤ channelCount T' YS' S':=by
  rw [channelCount_eq, channelCount_eq]
