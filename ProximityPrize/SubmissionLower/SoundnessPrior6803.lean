          (rawCost (r a) (v a)) (rawCost (r c) (v c))
          (rawCost_mono_z (r a) (v a)) (rawCost_mono_z (r c) (v c))
          (fun n => rawCost_discreteConvex (r a) (v a) n hra)
          (fun n => rawCost_discreteConvex (r c) (v c) n hrc)
