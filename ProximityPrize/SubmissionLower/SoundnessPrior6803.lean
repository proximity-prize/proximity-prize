        refine ⟨a, by simp, ?_⟩
        simp
      · have hsne : s.Nonempty := Finset.nonempty_iff_ne_empty.mpr hs
        obtain ⟨c, hc, hbound⟩ := ih (fun i hi => hr i (by simp [hi])) hsne
        have hra : 1 ≤ r a := hr a (by simp)
        have hrc : 1 ≤ r c := hr c (by simp [hc])
