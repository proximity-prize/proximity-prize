    ∃ c ∈ s,
      (∑ i ∈ s, rawCost (r i) (v i) (z i)) ≤
        rawCost (r c) (v c) (∑ i ∈ s, z i) +
          ∑ i ∈ s.erase c, rawCost (r i) (v i) 0 := by
  induction s using Finset.induction_on with
  | empty => simp at hne
  | @insert a s ha ih =>
      by_cases hs : s = ∅
