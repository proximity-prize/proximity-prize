      middle (hybridCoordinateC1 p) = 131074 * (padY p - 3) + 5 ∧
      total (hybridCoordinateC1 p) = 131074 * (padT p - 3) + 5 :=
  rationalFlag_cumulative p

theorem hybridCoordinateC1_mono {p q : FlagDegree} (h : Below p q) :
