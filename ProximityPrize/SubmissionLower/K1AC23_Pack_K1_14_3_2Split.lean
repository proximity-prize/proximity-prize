      ∀ z S, atMark f z S = 0 → ∃ q ∈ qs, AtSurface q z S := by
  obtain ⟨g, a, ha, hproper, htest⟩ := test f hi hd hp
  obtain ⟨qs, hqs, hcover⟩ := properPairCover hproper
  refine ⟨qs, fun q hq => (hqs q hq).1, bound f g a hi hd hp ha hproper qs hqs, ?_⟩
  intro z S hz
