def capAt (rq yi ti:ℕ):Option P33.Window:=
 match (((capIndex.getD rq []).getD yi []).getD ti 0) with
 | 0 => none
 | j+1 => windows[j]?
theorem capAt_mem {rq yi ti:ℕ} {W:P33.Window} (h:capAt rq yi ti=some W):W ∈ windows:=by
 unfold capAt at h
 split at h
 · exact absurd h (by simp)
 · exact List.mem_of_getElem? h

/-- the window of a cap entry contains its box and satisfies the packet bounds (`fiber_le_window` hypotheses) -/
def capOK (rq j k : ℕ) (W : P33.Window) : Bool :=
 decide (rq ≤ W.r ∧ min (rq + 3 * j + 2) 71 ≤ W.y ∧ 300 * (k + 1) ≤ W.t ∧ W.low ≤ 300 * k ∧
   5 ≤ W.r ∧ W.r ≤ 14 ∧ W.r + 2 ≤ W.y ∧ W.y ≤ 71 ∧ W.y ≤ W.t ∧ W.t ≤ 7200 ∧
   923 < W.low ∧ 6000000000000000 ≤ W.cap)
def capCheck : Bool :=
 (List.range 15).all fun rq => (List.range 24).all fun j => (List.range 30).all fun k =>
   match capAt rq j k with
   | none => true
   | some W => capOK rq j k W
theorem capCheck_ok : capCheck = true := by decide +kernel
theorem capOK_of {rq j k : ℕ} {W : P33.Window} (hrq : rq < 15) (hj : j < 24) (hk : k < 30)
    (h : capAt rq j k = some W) : capOK rq j k W = true := by
 have hc := capCheck_ok
 simp only [capCheck, List.all_eq_true, List.mem_range] at hc
 have := hc rq hrq j hj k hk
 rwa [h] at this

