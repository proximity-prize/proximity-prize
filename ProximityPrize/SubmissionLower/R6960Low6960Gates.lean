  exact ⟨a,d.val,IsLocalization.map_units S d,by simpa only [Algebra.smul_def] using id⟩

theorem clear_poly {R S:Type*} [CommRing R] [CommRing S] (f:R→+*S) (base:Clears f) :
    ∀ P:S[X],∃ (A:R[X]) (d:R),IsUnit (f d) ∧ A.map f=C (f d)*P := by
  intro P
