  | add P Q hp hq =>
    obtain ⟨A,a,au,hA⟩:=hp
    obtain ⟨B,b,bu,hB⟩:=hq
    refine ⟨C b*A+C a*B,a*b,(map_mul f a b) ▸ au.mul bu,?_⟩
    rw [Polynomial.map_add,Polynomial.map_mul,Polynomial.map_mul,Polynomial.map_C,Polynomial.map_C,hA,hB,map_mul f,map_mul]
