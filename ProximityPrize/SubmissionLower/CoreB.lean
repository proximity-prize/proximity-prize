/-!
The contracts `CurveCount`, `LevelCount`, `XContracts` and the cost statement `SharedRCostAt` with the cut
of R as a parameter: a flag `Hf` of `H = ∂F/∂R` in the place of the cell flag `⟨t - y, y - r, r - 1⟩`, and
first-cut flags `Φ` in the place of `ASY t y r`. The cut of the tail of index `m` is `cutFlag m Hf`.

* `Cut.priceNumerator`: the numerator of the price for a cut flag `C` and first-cut flags `Φ`;
  `pairNumeratorR` is its value at `cellCutR t y r` and `ASY t y r` (`priceNumerator_cell`, by `rfl`).
* `Cut.CurveCount`, `Cut.LevelCount`, `Cut.XContracts`, `Cut.SharedCostAt`: these statements
  for `Hf` and `Φ`. `ExchangeCount` and `PacketFrame` do not mention the cut and are used as they
  are.
* `Cut.FirstCutLaw`: the first-cut law for first-cut flags `Φ` and the weights of a flag `W`.
* `Cut.IsHFlag P Hf`: `Hf` bounds the pole of `H` on the carrier; `IsHFlag.cell`, `IsHFlag.euler`.
* `cutFlag_delay_le_smul`: the delay comparison, for every `Hf`.
* The statements without the parameter are the instances at the cell flag: `cutFlag_cellR`,
  `cutFlag_cellCutR`, `curveCount_cell`, `levelCount_cell`, `xContracts_cell`, `sharedCostAt_cell`.
-/

namespace ProximityPrize.SubmissionLower.FormalR.Cut
noncomputable section
open scoped Classical BigOperators
open RCN074 RCN086 RCN095 RCN135 RCN199 RCN222 RCN238 RCN243 RCN264 RCN313 RCN334
open BD DU BOE AYR AFA TW CB HFreeDir6813 RL
local notation "w" => RCN326.w

/-- The numerator of the price, cleared of the multiplicity `d` of the source, for a cut flag `C` and
first-cut flags `Φ`: `9 * d * scale * count ≤ priceNumerator`. -/
def priceNumerator (d scale z u v : ℕ) (C : FlagDegree) (Φ : Fin 3 → FlagDegree) (flag source : FlagDegree) :
    ℕ :=
  d * (scale * (∑ j : Fin 3, weight C j * flagMixed flag (Φ j) (BD.direction j)) +
      8 * (w + 1) * price C z u v) +
    16 * (w + 1) ^ 2 * price source z u v

theorem priceNumerator_cell (d scale z u v t y r : ℕ) (flag source : FlagDegree) :
    priceNumerator d scale z u v (cellCutR t y r) (ASY t y r) flag source =
      pairNumeratorR d scale z u v t y r flag source :=
  rfl

/-- The delay comparison for every flag `Hf` of `H`: the cut of the tail of index `w + delay` is below
`mu` times the cut of the tail of index `w + 1`, for `delay ≤ mu`. -/
theorem cutFlag_delay_le_smul (Hf : FlagDegree) (mu delay : ℕ) (hmu : 1 ≤ mu) (hdelay : delay ≤ mu) :
    (cutFlag (w + delay) Hf).zOnly ≤ (mu • cutFlag (w + 1) Hf).zOnly ∧
    (cutFlag (w + delay) Hf).yz ≤ (mu • cutFlag (w + 1) Hf).yz ∧
    (cutFlag (w + delay) Hf).all ≤ (mu • cutFlag (w + 1) Hf).all := by
  have hscale : w + delay ≤ mu * (w + 1) := by nlinarith [Nat.mul_le_mul_right w hmu]
  have ha := Nat.mul_le_mul_right (2 * Hf.all - 5) hscale
  have hv := Nat.mul_le_mul_right (2 * Hf.yz) hscale
  have hz := Nat.mul_le_mul_right (2 * Hf.zOnly) hscale
  simp only [cutFlag, add_zOnly, add_yz, add_all, nsmul_zOnly, nsmul_yz, nsmul_all]
  refine ⟨?_, ?_, ?_⟩ <;> nlinarith

theorem cutFlag_cellR (m t y r : ℕ) : cutFlag m ⟨t - y, y - r, r - 1⟩ = cutR m r (y - r) (t - y) :=
  cutFlag_cell m (t - y) (y - r) r

theorem cutFlag_cellCutR (t y r : ℕ) : cutFlag (w + 1) ⟨t - y, y - r, r - 1⟩ = cellCutR t y r :=
  cutFlag_cellR (w + 1) t y r

variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

/-- `FormalR.CurveCount` for a flag `Hf` of `H`: the count on a live curve with the cut
`cutFlag (w + delay) Hf`. -/
def CurveCount (P : Packet x t y r) (SZ : Source P.F) (Hf : FlagDegree)
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F))
    (moving : Curve P → ℕ) (o : ℕ → Curve P → ℕ) : Prop :=
  ∀ n : ℕ, ∀ a ∈ active P SZ, ∀ delay : ℕ, 1 ≤ delay →
    _Q2 (AL K) (P.stage a.1).F (w + 1 + delay) ∉ a.2.1 →
    3 * n * (HF Ω (P.stage a.1).G
        (_Q2 (AL K) (P.stage a.1).F (w + 1))
        (CR (AL K) (P.stage a.1).F)
        (KK K P.F P.selected P.seeds a.1)
        (DK (AL K) (P.stage a.1).selected) a.2).card ≤
      n * (budget a).weightedCost (cutFlag (w + delay) Hf) +
        4 * (w + delay) * (n * moving a + o n a)

/-- `FormalR.LevelCount` for a flag `Hf` of `H`: the count of `A_1` on the level curve against the
price of the cut `cutFlag (w + 1) Hf`. -/
def LevelCount (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (Hf : FlagDegree) (scale z u v : ℕ) (moving : Curve P → ℕ) (Lam : ℕ) : Prop :=
  3 * SZ.d * scale * (∑ a ∈ active P SZ, multiplicity P hp a * moving a) + scale * Lam ≤
    SZ.d * price (cutFlag (w + 1) Hf) z u v + 4 * (w + 1) * price SZ.flag z u v

/-- `FormalR.XContracts` for a flag `Hf` of `H`. -/
def XContracts (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (Hf : FlagDegree) (scale z u v : ℕ) : Prop :=
  ∀ (lam mu : Ω) (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F)),
    PacketFrame P hp SZ scale z u v lam mu geometry budget →
    ∃ (moving : Curve P → ℕ) (o : ℕ → Curve P → ℕ) (Lam Kc : ℕ),
      CurveCount P SZ Hf budget moving o ∧ LevelCount P hp SZ Hf scale z u v moving Lam ∧
        ExchangeCount P hp SZ o Lam Kc

/-- `FormalR.SharedRCostAt` for a flag `Hf` of `H` and first-cut flags `Φ`. -/
def SharedCostAt (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (Hf : FlagDegree) (Φ : Fin 3 → FlagDegree) (scale z u v : ℕ) : Prop :=
  ∃ (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F)) (loss : ℕ),
    (∀ a, (budget a).zCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).zCost a.2 ∧
      (budget a).yzCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).yzCost a.2 ∧
      (budget a).allCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).allCost a.2) ∧
    ∀ bound : ℕ, ∃ (den : ℕ) (mov : Curve P → ℕ), bound < den ∧
    (∀ a ∈ active P SZ, ∀ delay : ℕ, 1 ≤ delay →
      _Q2 (AL K) (P.stage a.1).F (w + 1 + delay) ∉ a.2.1 →
      3 * den * (HF Ω (P.stage a.1).G
          (_Q2 (AL K) (P.stage a.1).F (w + 1))
          (CR (AL K) (P.stage a.1).F)
          (KK K P.F P.selected P.seeds a.1)
          (DK (AL K) (P.stage a.1).selected) a.2).card ≤
        den * (budget a).weightedCost (cutFlag (w + delay) Hf) +
          4 * (w + delay) * mov a) ∧
    (3 * SZ.d * scale) * (∑ a ∈ active P SZ, multiplicity P hp a *
        (den * ordinary P hp geometry a (cutFlag (w + 1) Hf) + 4 * (w + 1) * mov a)) ≤
      den * priceNumerator SZ.d scale z u v (cutFlag (w + 1) Hf) Φ ⟨t - y, y - r, r⟩ SZ.flag + loss

/-- The first-cut law with first-cut flags `Φ`, for the weights of a flag `W`. For `Φ = ASY t y r` it is
the second conjunct of `exists_packet_frame`. -/
def FirstCutLaw (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F)
    (Φ : Fin 3 → FlagDegree) (scale z u v : ℕ) (geometry : ∀ g, ABN (P.stage g)) (W : FlagDegree) :
    Prop :=
  3 * scale * (∑ a ∈ active P SZ, multiplicity P hp a * ordinary P hp geometry a W) ≤
    scale * (∑ j : Fin 3, weight W j * flagMixed ⟨t - y, y - r, r⟩ (Φ j) (BD.direction j)) +
      4 * (w + 1) * price W z u v

theorem curveCount_cell (P : Packet x t y r) (SZ : Source P.F)
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F))
    (moving : Curve P → ℕ) (o : ℕ → Curve P → ℕ) :
    CurveCount P SZ ⟨t - y, y - r, r - 1⟩ budget moving o ↔ FormalR.CurveCount P SZ budget moving o := by
  simp only [CurveCount, FormalR.CurveCount, cutFlag_cellR]

theorem levelCount_cell (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) (moving : Curve P → ℕ) (Lam : ℕ) :
    LevelCount P hp SZ ⟨t - y, y - r, r - 1⟩ scale z u v moving Lam ↔
      FormalR.LevelCount P hp SZ scale z u v moving Lam := by
  simp only [LevelCount, FormalR.LevelCount, cutFlag_cellCutR]

theorem xContracts_cell (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) :
    XContracts P hp SZ ⟨t - y, y - r, r - 1⟩ scale z u v ↔ FormalR.XContracts P hp SZ scale z u v := by
  simp only [XContracts, FormalR.XContracts, curveCount_cell, levelCount_cell]

theorem sharedCostAt_cell (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) :
    SharedCostAt P hp SZ ⟨t - y, y - r, r - 1⟩ (ASY t y r) scale z u v ↔
      SharedRCostAt P hp SZ scale z u v := by
  unfold SharedCostAt
  simp only [cutFlag_cellR]
  exact Iff.rfl

end

section HFlag
noncomputable section
open WithZero MvPolynomial HFree6812
open RCN095 RCN204 RCN313 RCN187 DU BD BX
variable {K I : Type} [Field K] {x : I → K} {t y r : ℕ}

/-- `Hf` is a flag of `H = ∂F/∂R` on the carrier of the packet: at every valuation of the function field
of the carrier that is trivial on the constants and at most 1 on `X`, the pole of `H` is at most the pole
of the flag. With `5 ≤ 2 * Hf.all` this is what the count on a live curve and the function `A_1` use of
`Hf`. -/
def IsHFlag (P : Packet x t y r) (Hf : FlagDegree) : Prop :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  ∀ v : Valuation (SliceField P.F) ℤᵐ⁰, (∀ a : K, a ≠ 0 → v (algebraMap K (SliceField P.F) a) = 1) →
    v (sliceProj P.F (MvPolynomial.X 0)) ≤ 1 →
    v (sliceProj P.F (polyH K P.F)) ≤ exp (flagPole v (sliceCoord P.F) Hf)

/-- The cell flag `⟨t - y, y - r, r - 1⟩` is a flag of `H`. -/
theorem IsHFlag.cell (P : Packet x t y r) : IsHFlag P ⟨t - y, y - r, r - 1⟩ :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  fun v hK hX0 => polyH_flag_le P.F P.F v hK hX0 (t - y) (y - r) r
    (cell_support t y r (by have := P.rlow; omega) (by have := P.ylow; omega) P.F P.support)

/-- The Euler flag `⟨t - y, y - r + 1, r - 2⟩` is a flag of `H` (`polyH_euler_le`). -/
theorem IsHFlag.euler (P : Packet x t y r) : IsHFlag P ⟨t - y, y - r + 1, r - 2⟩ :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  fun v hK hX0 => polyH_euler_le P.F P.F (dvd_refl P.F) v hK hX0 (t - y) (y - r) r
    (cell_support t y r (by have := P.rlow; omega) (by have := P.ylow; omega) P.F P.support)

end
end HFlag

end ProximityPrize.SubmissionLower.FormalR.Cut
