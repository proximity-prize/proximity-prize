/-!
The eight charts of the fan of the flag polytope, for a valued field `L` with three nonzero coordinates
`x 0 = Y`, `x 1 = R`, `x 2 = Z` (the order of `flagPole`). Pole vectors are written in the order
`(Y, R, Z)`. A chart takes one ray of each pair `{-e_R, (0,1,0)}`, `{-e_Y, (1,1,0)}`, `{-e_Z, (1,1,1)}`; the
Boolean of a pair is `true` for its ray at infinity.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero RCN204 RCN095

variable {L : Type*} [Field L]

/-- Laurent monomial in the three coordinates. -/
def lmono (x : Fin 3 → L) (a : Fin 3 → ℤ) : L := x 0 ^ a 0 * x 1 ^ a 1 * x 2 ^ a 2

/-- Exponent vectors (of `Y`, `R`, `Z`) of the three monomial coordinates of the chart `(sR, sY, sZ)`:
row 0 belongs to the pair of `R`, row 1 to the pair of `Y`, row 2 to the pair of `Z`.
`chartExp false false false` is the affine chart `(R, Y, Z)`, `chartExp true true true` is
`(Y/R, Z/Y, 1/Z)`. -/
def chartExp : Bool → Bool → Bool → Fin 3 → Fin 3 → ℤ
  | false, false, false => ![![0, 1, 0], ![1, 0, 0], ![0, 0, 1]]
  | true, false, false => ![![0, -1, 0], ![1, 0, 0], ![0, 0, 1]]
  | false, true, false => ![![-1, 1, 0], ![-1, 0, 0], ![0, 0, 1]]
  | true, true, false => ![![1, -1, 0], ![-1, 0, 0], ![0, 0, 1]]
  | false, false, true => ![![0, 1, -1], ![1, 0, -1], ![0, 0, -1]]
  | true, false, true => ![![0, -1, 1], ![1, 0, -1], ![0, 0, -1]]
  | false, true, true => ![![-1, 1, 0], ![-1, 0, 1], ![0, 0, -1]]
  | true, true, true => ![![1, -1, 0], ![-1, 0, 1], ![0, 0, -1]]

/-- Exponent vector (of `Y`, `R`, `Z`) of the vertex monomial of the flag `W` in the chart `(sR, sY, sZ)`. -/
def vertexExp (sR sY sZ : Bool) (W : FlagDegree) : Fin 3 → ℤ :=
  ![if sY then (W.yz : ℤ) + W.all - (if sR then (W.all : ℤ) else 0) else 0,
    if sR then (W.all : ℤ) else 0,
    if sZ then (W.zOnly : ℤ) + W.yz + W.all -
      (if sY then (W.yz : ℤ) + W.all - (if sR then (W.all : ℤ) else 0) else 0) -
      (if sR then (W.all : ℤ) else 0) else 0]

theorem lmono_val (v : Valuation L ℤᵐ⁰) (x : Fin 3 → L) (hx : ∀ j, x j ≠ 0) (a : Fin 3 → ℤ) :
    v (lmono x a) =
      exp (a 0 * (v (x 0)).log + a 1 * (v (x 1)).log + a 2 * (v (x 2)).log) := by
  have h : ∀ j, v (x j) = exp (v (x j)).log := fun j =>
    (exp_log ((Valuation.ne_zero_iff v).2 (hx j))).symm
  have hz : ∀ (j : Fin 3) (n : ℤ), v (x j) ^ n = exp (n * (v (x j)).log) := by
    intro j n
    conv_lhs => rw [h j]
    rw [← exp_zsmul, smul_eq_mul]
  rw [lmono, map_mul, map_mul, map_zpow₀, map_zpow₀, map_zpow₀, hz, hz, hz, ← exp_add, ← exp_add]

theorem lmono_le_one_iff (v : Valuation L ℤᵐ⁰) (x : Fin 3 → L) (hx : ∀ j, x j ≠ 0) (a : Fin 3 → ℤ) :
    v (lmono x a) ≤ 1 ↔
      a 0 * (v (x 0)).log + a 1 * (v (x 1)).log + a 2 * (v (x 2)).log ≤ 0 := by
  rw [lmono_val v x hx, ← exp_zero, exp_le_exp]

/-- Every valuation is at most 1 on the three monomial coordinates of one of the eight charts. -/
theorem chart_cover (v : Valuation L ℤᵐ⁰) (x : Fin 3 → L) (hx : ∀ j, x j ≠ 0) :
    ∃ sR sY sZ : Bool, ∀ i, v (lmono x (chartExp sR sY sZ i)) ≤ 1 := by
  set l0 := (v (x 0)).log with hl0
  set l1 := (v (x 1)).log with hl1
  set l2 := (v (x 2)).log with hl2
  have key : ∀ sR sY sZ : Bool,
      (∀ i : Fin 3, chartExp sR sY sZ i 0 * l0 + chartExp sR sY sZ i 1 * l1 +
        chartExp sR sY sZ i 2 * l2 ≤ 0) → ∀ i, v (lmono x (chartExp sR sY sZ i)) ≤ 1 :=
    fun sR sY sZ h i => (lmono_le_one_iff v x hx _).2 (h i)
  by_cases hZ : l2 ≤ 0
  · by_cases hY : l0 ≤ 0
    · by_cases hR : l1 ≤ 0
      · exact ⟨false, false, false, key _ _ _ (by intro i; fin_cases i <;> simp [chartExp] <;> omega)⟩
      · exact ⟨true, false, false, key _ _ _ (by intro i; fin_cases i <;> simp [chartExp] <;> omega)⟩
    · by_cases hR : l1 ≤ l0
      · exact ⟨false, true, false, key _ _ _ (by intro i; fin_cases i <;> simp [chartExp] <;> omega)⟩
      · exact ⟨true, true, false, key _ _ _ (by intro i; fin_cases i <;> simp [chartExp] <;> omega)⟩
  · by_cases hY : l0 ≤ l2
    · by_cases hR : l1 ≤ l2
      · exact ⟨false, false, true, key _ _ _ (by intro i; fin_cases i <;> simp [chartExp] <;> omega)⟩
      · exact ⟨true, false, true, key _ _ _ (by intro i; fin_cases i <;> simp [chartExp] <;> omega)⟩
    · by_cases hR : l1 ≤ l0
      · exact ⟨false, true, true, key _ _ _ (by intro i; fin_cases i <;> simp [chartExp] <;> omega)⟩
      · exact ⟨true, true, true, key _ _ _ (by intro i; fin_cases i <;> simp [chartExp] <;> omega)⟩

/-- For a valuation that is at most 1 on the coordinates of a chart, `flagPole v x W` is the
pole order of the vertex monomial of `W` in that chart. -/
theorem flagPole_eq_vertex (v : Valuation L ℤᵐ⁰) (x : Fin 3 → L) (hx : ∀ j, x j ≠ 0)
    (sR sY sZ : Bool) (h : ∀ i, v (lmono x (chartExp sR sY sZ i)) ≤ 1) (W : FlagDegree) :
    v (lmono x (vertexExp sR sY sZ W)) = exp (flagPole v x W) := by
  have h0 := (lmono_le_one_iff v x hx _).1 (h 0)
  have h1 := (lmono_le_one_iff v x hx _).1 (h 1)
  have h2 := (lmono_le_one_iff v x hx _).1 (h 2)
  rw [lmono_val v x hx, flagPole, RCN187.poleOrder, RCN187.poleOrder, RCN187.poleOrder]
  congr 1
  generalize (v (x 0)).log = l0 at *
  generalize (v (x 1)).log = l1 at *
  generalize (v (x 2)).log = l2 at *
  generalize hA : max 0 l2 = A
  generalize hB : max (max 0 l0) A = B
  generalize hC : max (max 0 l1) B = C
  rcases sR with _ | _ <;> rcases sY with _ | _ <;> rcases sZ with _ | _ <;>
    simp [chartExp] at h0 h1 h2
  · have e1 : A = 0 := by omega
    have e2 : B = 0 := by omega
    have e3 : C = 0 := by omega
    subst e1 e2 e3
    simp [vertexExp]
  · have e1 : A = l2 := by omega
    have e2 : B = l2 := by omega
    have e3 : C = l2 := by omega
    subst e1 e2 e3
    simp [vertexExp]; ring
  · have e1 : A = 0 := by omega
    have e2 : B = l0 := by omega
    have e3 : C = l0 := by omega
    subst e1 e2 e3
    simp [vertexExp]; ring
  · have e1 : A = l2 := by omega
    have e2 : B = l0 := by omega
    have e3 : C = l0 := by omega
    subst e1 e2 e3
    simp [vertexExp]; ring
  · have e1 : A = 0 := by omega
    have e2 : B = 0 := by omega
    have e3 : C = l1 := by omega
    subst e1 e2 e3
    simp [vertexExp]
  · have e1 : A = l2 := by omega
    have e2 : B = l2 := by omega
    have e3 : C = l1 := by omega
    subst e1 e2 e3
    simp [vertexExp]; ring
  · have e1 : A = 0 := by omega
    have e2 : B = l0 := by omega
    have e3 : C = l1 := by omega
    subst e1 e2 e3
    simp [vertexExp]
  · have e1 : A = l2 := by omega
    have e2 : B = l0 := by omega
    have e3 : C = l1 := by omega
    subst e1 e2 e3
    simp [vertexExp]; ring

end ProximityPrize.SubmissionLower.FormalR
end
