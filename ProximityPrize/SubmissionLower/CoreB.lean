/-!
The poles of a linear form against its general fibre.

On an affine curve over an algebraically closed field let `ℓ` be a polynomial that is not constant on
the curve. Its class `t` is transcendental over the constants, so the function field is an algebra over
the rational functions `k(X)` with `X ↦ t`. If the function field is finite and separable over `k(X)`,
of degree `d`, then the poles of `t` at any finite set of places are at most `d`, and all values but
finitely many are taken by `ℓ` at `d` points of the curve, which can be taken off the zeros of a
polynomial that is not zero on the curve.

On a good level curve a polynomial of degree at most one has this separability.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Bud

open scoped Classical BigOperators
open WithZero MvPolynomial
open RCN002 RCN084 RCN095 RCN135 RCN136 RCN187 RCN264 RCN313
open BD DU LF WC _Q7

noncomputable section

section Curve

variable {k : Type} [Field k] [IsAlgClosed k]

/-- A polynomial that equals no constant on the curve has a transcendental class in its function field. -/
theorem transcendental_of_not_const (D : Ideal (MvPolynomial (Fin 3) k)) [D.IsPrime]
    (ℓ : MvPolynomial (Fin 3) k) (hnc : ∀ a : k, ℓ - C a ∉ D) : Transcendental k (BR k D ℓ) := by
  intro halg
  obtain ⟨a, ha⟩ : ∃ a : k, algebraMap k (AJ k D) a = BR k D ℓ :=
    minpoly.mem_range_of_degree_eq_one k _
      (IsAlgClosed.degree_eq_one_of_irreducible k (minpoly.irreducible halg.isIntegral))
  refine hnc a ?_
  rw [← FB k D]
  show BR k D (ℓ - C a) = 0
  rw [map_sub, algHom_C, ha, sub_self]

/-- The poles of a function against its general fibre: if the function field is finite and separable
over the rational functions in the class of `ℓ`, all values `a` but finitely many are taken by `ℓ` at
finitely many points of the curve off the zeros of `g`, no fewer than the poles of `ℓ` at any finite set
of places. -/
theorem fibre_of_separable (D : Ideal (MvPolynomial (Fin 3) k)) [D.IsPrime]
    (ℓ g : MvPolynomial (Fin 3) k) (hnc : ∀ a : k, ℓ - C a ∉ D) (hg : g ∉ D)
    (hsep : ∀ [Algebra (RatFunc k) (AJ k D)] [IsScalarTower k (RatFunc k) (AJ k D)],
      algebraMap (RatFunc k) (AJ k D) RatFunc.X = BR k D ℓ →
        FiniteDimensional (RatFunc k) (AJ k D) ∧ Algebra.IsSeparable (RatFunc k) (AJ k D)) :
    {a : k | ¬∃ pts : Finset (Fin 3 → k),
      (∀ w ∈ pts, D ≤ RingHom.ker (MvPolynomial.aeval w).toRingHom ∧ MvPolynomial.eval w ℓ = a ∧
        MvPolynomial.eval w g ≠ 0) ∧
      ∀ U : Finset (RCN026.Place k (AJ k D)),
        ∑ v ∈ U, poleOrder v.val (BR k D ℓ) ≤ (pts.card : ℤ)}.Finite := by
  have htr := transcendental_of_not_const D ℓ hnc
  let φ : RatFunc k →ₐ[k] AJ k D := RatFunc.liftAlgHom (Polynomial.aeval (BR k D ℓ))
    (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective (Polynomial.aeval (BR k D ℓ)).toRingHom
      (transcendental_iff_injective.mp htr))
  have hφ : ∀ p : Polynomial k,
      φ (algebraMap (Polynomial k) (RatFunc k) p) = Polynomial.aeval (BR k D ℓ) p := fun p =>
    RatFunc.liftRingHom_algebraMap _ _ p
  let _a1 : Algebra (Polynomial k) (AJ k D) := (Polynomial.aeval (BR k D ℓ)).toRingHom.toAlgebra
  let _a2 : Algebra (RatFunc k) (AJ k D) := φ.toRingHom.toAlgebra
  have _t1 : IsScalarTower k (Polynomial k) (AJ k D) :=
    IsScalarTower.of_algebraMap_eq fun c => ((Polynomial.aeval (BR k D ℓ)).commutes c).symm
  have _t2 : IsScalarTower k (RatFunc k) (AJ k D) :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  have _t3 : IsScalarTower (Polynomial k) (RatFunc k) (AJ k D) :=
    IsScalarTower.of_algebraMap_eq fun p => (hφ p).symm
  have hX : algebraMap (RatFunc k) (AJ k D) RatFunc.X = BR k D ℓ := by
    rw [← RatFunc.algebraMap_X]
    exact (hφ Polynomial.X).trans (Polynomial.aeval_X _)
  obtain ⟨_t4, _t5⟩ := hsep hX
  have hegm : ∀ U : Finset (RCN026.Place k (AJ k D)),
      ∑ v ∈ U, poleOrder v.val (BR k D ℓ) ≤ (Module.finrank (RatFunc k) (AJ k D) : ℤ) := by
    intro U
    have h := RCN346.EGM k (AJ k D) U
    have hpar : RCN345.parameter k (AJ k D) = BR k D ℓ := by
      show Polynomial.aeval (BR k D ℓ) Polynomial.X = BR k D ℓ
      exact Polynomial.aeval_X _
    rw [hpar] at h
    exact h
  refine (finite_setOf_not_exists_zeros_off k D ℓ hX g hg).subset fun a ha hS => ha ?_
  obtain ⟨S, hcard, hS⟩ := hS
  refine ⟨S, fun w hw => ⟨fun r hr => (hS w hw).1 r hr, (hS w hw).2.1, (hS w hw).2.2⟩, fun U => ?_⟩
  rw [hcard]
  exact hegm U

end Curve

