/-!
The count on a live curve for `Ψ_c`: objects and statements.

On a geometric component `G` over `Ω = GenericField K` with the slice embedding `ψ = RY G F hker`:

* `Curve.psiC F G hker f c m`: `Ψ_c = ψ(τ_m^3 H^(2m)) / (f - c)^(4m)`.
* `Curve.StepOne`: at every prime divisor `B` of every point `q` of the model, `Ψ_c` divided by the vertex
  monomial of the chart of `q` for the flag `cutFlag m Hf` has order at least `-4 m ord_B(L_c)`.
* `Curve.psiCOn F C fC c m`: the restriction of `Ψ_c` for the tail of index `m + 1` to a curve `C`, for the
  restriction `fC` of `f`.
* `Curve.LevelRestrict`: `n pole_μ(Ψ'_c restricted) ≤ 4 (m + 1) o_μ(n)` at every place `μ` of the
  curve over every point `q`, with `o_μ(n) = S.leastOrder hq (levelIdeal f c n) μ`.
* `CurveNeeds`: what the count asks of the data `Q`, `A`, `c` and of the curves.
* `Curve.CountStatement`: `CurveCount` for `moving a = curveMoving (S a) f c` and
  `o = Exch.baseOrder P Q A c S`, in terms of `Exch.component` and `Exch.moving`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

section Component
noncomputable section
open WithZero MvPolynomial HFree6812
open RCN002 RCN095 RCN135 RCN136 RCN187 RCN204 RCN313

attribute [local instance] SurfacePoint.isNoetherianRing SurfacePoint.isIntegrallyClosed
  SurfacePoint.isFractionRing

variable {K : Type} [Field K]

namespace Curve

/-- `Ψ_c` on a geometric component for the tail of index `m`: the image of `τ_m^3 H^(2m)` divided by
`(f - c)^(4m)`. -/
def psiC (F : MvPolynomial (Fin 4) K) [Fact (Irreducible F)]
    (G : Ideal (MvPolynomial (Fin 3) (GenericField K))) [G.IsPrime]
    (hker : RingHom.ker (sliceMap (K := K) G) = Ideal.span {F}) (f : AJ (GenericField K) G)
    (c : GenericField K) (m : ℕ) : AJ (GenericField K) G :=
  RY G F hker (tail F F (dvd_refl F) m ^ 3 * sliceProj F (polyH K F) ^ (2 * m)) /
    (f - algebraMap (GenericField K) (AJ (GenericField K) G) c) ^ (4 * m)

/-- At every prime divisor `B` of every point `q`,
`ord_B(Ψ_c / χ^(u(cutFlag m Hf))) ≥ -4 m ord_B(L_c)`, `u` the chart of `q`. -/
def StepOne (F : MvPolynomial (Fin 4) K) [Fact (Irreducible F)]
    (G : Ideal (MvPolynomial (Fin 3) (GenericField K))) [G.IsPrime]
    (hker : RingHom.ker (sliceMap (K := K) G) = Ideal.span {F}) (Hf : FlagDegree)
    (f : AJ (GenericField K) G) (c : GenericField K) : Prop :=
  ∀ (q : SurfacePoint G) (B : PrimeDivisor q.ring) (m : ℕ),
    B.valuation (AJ (GenericField K) G) (psiC F G hker f c m /
        lmono (coordinate (GenericField K) G)
          (vertexExp q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2 (cutFlag m Hf))) ≤
      exp (4 * m * (q.level f c B : ℤ))

/-- The restriction to a curve `C` of `Ψ_c` for the tail of index `m + 1`, for the restriction `fC` of the
moving function. -/
def psiCOn (F : MvPolynomial (Fin 4) K) (C : Ideal (MvPolynomial (Fin 3) (GenericField K)))
    [C.IsPrime] (fC : AJ (GenericField K) C) (c : GenericField K) (m : ℕ) : AJ (GenericField K) C :=
  tailCubeOn (AL K) F C m / (fC - algebraMap (GenericField K) (AJ (GenericField K) C) c) ^ (4 * (m + 1))

/-- For the tail of index `m + 1`: at every place `μ` of the curve over a point `q`,
`n ord_μ(Ψ_c restricted) ≥ -n flagPole_μ(cutFlag (m + 1) Hf) - 4 (m + 1) o_μ(n)`. -/
def LevelRestrict (F : MvPolynomial (Fin 4) K) (G C : Ideal (MvPolynomial (Fin 3) (GenericField K)))
    [G.IsPrime] [C.IsPrime] (S : Specialization (AJ (GenericField K) G) (AJ (GenericField K) C))
    (Hf : FlagDegree) (f : AJ (GenericField K) G) (fC : AJ (GenericField K) C) (c : GenericField K)
    (m : ℕ) : Prop :=
  ∀ (q : SurfacePoint G) (hq : q.On S) (μ : RCN026.Place (GenericField K) (AJ (GenericField K) C)),
    μ ∈ S.placesOn (GenericField K) hq → ∀ n : ℕ,
      μ.val (psiCOn F C fC c m) ^ n ≤
        exp (n * flagPole μ.val (coordinate (GenericField K) C) (cutFlag (m + 1) Hf) +
          4 * (m + 1) * (S.leastOrder hq (levelIdeal (AJ (GenericField K) G) f c n) μ.val : ℤ))

end Curve

end
end Component

