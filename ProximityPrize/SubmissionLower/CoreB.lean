/-!
The shared cost `SharedRCostAsym` for a packet with a proper tail cut, under the hypotheses of
`BOE.ELK`: the statement on which the pair count `BTJ.FRX` rests.

`shared_R_cost_asym_of_contracts` with the contract `XContracts` at the pair's four
expressions from `Assembly.xContracts` and the theorems `Curve.count`,
`Exch.Proved.exchange_count`, `LevelCount.level_count`, `Sec.section_bound`,
and for the existence of the data `Sec.choice_of_data_of_section` on `Data.data` and
`SecChoice.sections`.
-/

namespace ProximityPrize.SubmissionLower.FormalR
noncomputable section
open scoped Classical
open RCN095 RCN313 BD DU CB
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}

theorem shared_R_cost_asym
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ SP SQ : Source P.F) (hZd : SZ.k < 2130706433)
    (hcop : IsRelPrime SP.P SQ.P) (delta : ℕ) (hd : 0 < delta) (hdchar : delta ≤ 2130706433)
    (hP : delta ≤ SP.d) (hQ : delta ≤ SQ.d)
    (hz : flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitZFlag < 2130706433)
    (hu : flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitYZFlag < 2130706433) :
    SharedRCostAsym P hp SZ SP SQ delta :=
  shared_R_cost_asym_of_contracts P hp SZ SP SQ hZd hcop delta hd hdchar hP hQ hz hu
    (Assembly.xContracts P hp SZ hZd _ _ _ _ (Curve.count P SZ) (Exch.Proved.exchange_count P hp SZ)
      (LevelCount.level_count P hp SZ _ _ _ _) (Sec.section_bound P SZ _ _ _ _)
      (Sec.choice_of_data_of_section P SZ (Data.data P hp SZ) (SecChoice.sections P SZ)))

end
end ProximityPrize.SubmissionLower.FormalR
