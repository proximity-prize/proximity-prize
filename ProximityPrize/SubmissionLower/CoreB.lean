section Surface

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime]

attribute [local instance] SurfacePoint.isNoetherianRing SurfacePoint.isIntegrallyClosed
  SurfacePoint.isFractionRing

theorem SurfaceDivisor.trivial_on_constants {sR sY sZ : Bool} {nu : Valuation (AJ E G) ℤᵐ⁰}
    (h : SurfaceDivisor G sR sY sZ nu) (a : E) (ha : a ≠ 0) : nu (algebraMap E (AJ E G) a) = 1 := by
  obtain ⟨t, -, -, ht⟩ := h.nonconst
  exact ht _ (IntermediateField.algebraMap_mem _ a) ((map_ne_zero _).mpr ha)

/-- `LevelDisjoint` holds when the coordinates and `A₁` are units along every prime divisor of the eight
charts on which `f - c` vanishes. -/
theorem levelDisjoint_of_unit {N p : ℕ} [CharP E p]
    (hN : ∀ sR sY sZ, SurfaceNoether G sR sY sZ N) (hp : 3 * N < p) (f : AJ E G) (c : E)
    (A₁ : AJ E G) (W : FlagDegree)
    (hunit : ∀ nu : Valuation (AJ E G) ℤᵐ⁰, (∃ sR sY sZ, SurfaceDivisor G sR sY sZ nu) →
      nu (f - algebraMap E (AJ E G) c) < 1 → (∀ j, nu (coordinate E G j) = 1) ∧ nu A₁ = 1) :
    LevelDisjoint f c A₁ W := by
  intro q hf P hlev
  have hne : f - algebraMap E (AJ E G) c ≠ 0 := fun h0 => hf (by
    rw [sub_eq_zero.mp h0]
    exact q.ring.algebraMap_mem c)
  have h3 : q.level f c P = (-(P.valuation (AJ E G) (f - algebraMap E (AJ E G) c)).log).toNat :=
    zeroDivisor_apply (AJ E G) hne P
  rw [h3] at hlev
  have hlt : P.valuation (AJ E G) (f - algebraMap E (AJ E G) c) < 1 := by
    rw [← exp_zero]
    exact (log_lt_iff_lt_exp ((Valuation.ne_zero_iff _).mpr hne)).mp (by omega)
  obtain ⟨h2, h1⟩ := hunit _ ⟨_, _, _, q.surfaceDivisor hN hp P⟩ hlt
  rw [SurfacePoint.localFunction, map_div₀, h1, lmono, map_mul, map_mul, map_zpow₀, map_zpow₀,
    map_zpow₀, h2, h2, h2, one_zpow, one_zpow, one_zpow, mul_one, mul_one, div_one]

/-- `LevelDisjoint` fails for finitely many levels `c` only. -/
theorem finite_not_levelDisjoint {N p : ℕ} [CharP E p]
    (hN : ∀ sR sY sZ, SurfaceNoether G sR sY sZ N) (hp : 3 * N < p)
    (hc : ∀ j, coordinate E G j ≠ 0) (f A₁ : AJ E G) (hA : A₁ ≠ 0) (W : FlagDegree) :
    {c : E | ¬LevelDisjoint f c A₁ W}.Finite := by
  have hfin : ({nu : Valuation (AJ E G) ℤᵐ⁰ |
      (∃ sR sY sZ, SurfaceDivisor G sR sY sZ nu) ∧ nu A₁ ≠ 1} ∪
      ⋃ j : Fin 3, {nu : Valuation (AJ E G) ℤᵐ⁰ |
        (∃ sR sY sZ, SurfaceDivisor G sR sY sZ nu) ∧ nu (coordinate E G j) ≠ 1}).Finite :=
    (finite_surfaceDivisor_ne_one hN hp A₁ hA).union
      (Set.finite_iUnion fun j => finite_surfaceDivisor_ne_one hN hp _ (hc j))
  refine (finite_level_values _ hfin (fun v hv a ha => ?_) f).subset fun c hbad => ?_
  · rcases hv with ⟨⟨sR, sY, sZ, hsd⟩, -⟩ | hv
    · exact SurfaceDivisor.trivial_on_constants hsd a ha
    · obtain ⟨j, ⟨sR, sY, sZ, hsd⟩, -⟩ := Set.mem_iUnion.mp hv
      exact SurfaceDivisor.trivial_on_constants hsd a ha
  · by_contra hgood
    refine hbad (levelDisjoint_of_unit hN hp f c A₁ W fun nu hnu hlt => ?_)
    exact ⟨fun j => by_contra fun h =>
        hgood ⟨nu, Or.inr (Set.mem_iUnion.mpr ⟨j, hnu, h⟩), hlt⟩,
      by_contra fun h => hgood ⟨nu, Or.inl ⟨hnu, h⟩, hlt⟩⟩

end Surface

