/-!
The count of `A₁` on the level curve: definitions.

Level E, one geometric component `G` with function field `AJ E G`, a function `f` and a constant `c`:

* `LevelComponent G f c`: a component of the level curve `f = c` whose centre is a curve,
  as the valuation of its prime divisor; `B.prime` (a prime of height two of `E[Y, R, Z]`), `B.curve` are the
  curve, `B.mult = ord_B (f - c)` its multiplicity in the level curve.
* `levelFlagSum s T W`: `Σ_{B ∈ s} ord_B(L_c) Σ_{λ ∈ T B} flagPole_λ(W)`, the part of `[L_c . W]` at the finite
  sets `T B` of places of the components `B ∈ s`.
* `LevelCount.Needs`: what the count asks of `c` on one component.

A packet, in the terms of `Exch.component`, `Exch.moving`, `Exch.function`, `Exch.flag`,
`Exch.lam`: `LevelNeeds` (all that the count asks of `Q`, `A`, `c` and of the curves), `SectionBound` (the
three bounds `scale * [L_c . e_j] ≤ (z, u, v)_j` for free numbers `scale`, `z`, `u`, `v`),
`LevelCount.Statement` (the count).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

section Component

open WithZero MvPolynomial HFree6812
open RCN002 RCN095

noncomputable section

variable {E : Type} [Field E] (G : Ideal (MvPolynomial (Fin 3) E)) [G.IsPrime]

/-- A component of the level curve `f = c` on the model of `G` whose centre is a curve:
the valuation of a prime divisor along which `f - c` vanishes and whose centre in `E[Y, R, Z]` is a curve
`C ⊇ G`, with its residue map. The height excludes the valuations centred at a point (residue field `E`):
on those no coordinate is transcendental, so they have no place and no separable coordinate. -/
def LevelComponent (f : AJ E G) (c : E) : Type :=
  {nu : Valuation (AJ E G) ℤᵐ⁰ // nu (f - algebraMap E (AJ E G) c) < 1 ∧
    ∃ (C : Ideal (MvPolynomial (Fin 3) E)) (_ : C.IsPrime) (S : Specialization (AJ E G) (AJ E C)),
      IsCurveOnSurface G C S ∧ S.val = nu ∧ C.height = 2}

namespace LevelComponent

variable {G} {f : AJ E G} {c : E} (B : LevelComponent G f c)

/-- The valuation of the component. -/
def val : Valuation (AJ E G) ℤᵐ⁰ := B.1

theorem val_lt_one : B.val (f - algebraMap E (AJ E G) c) < 1 := B.2.1

/-- The prime of the component in `E[Y, R, Z]`. -/
def prime : Ideal (MvPolynomial (Fin 3) E) := B.2.2.choose

theorem isPrime : B.prime.IsPrime := B.2.2.choose_spec.choose

attribute [local instance] isPrime

/-- The component as a curve with its residue map. -/
def curve : Specialization (AJ E G) (AJ E B.prime) := B.2.2.choose_spec.choose_spec.choose

theorem isCurve : IsCurveOnSurface G B.prime B.curve := B.2.2.choose_spec.choose_spec.choose_spec.1

theorem curve_val : B.curve.val = B.val := B.2.2.choose_spec.choose_spec.choose_spec.2.1

theorem height : B.prime.height = 2 := B.2.2.choose_spec.choose_spec.choose_spec.2.2

/-- A component is not a point: a coordinate is transcendental on it. -/
theorem exists_transcendental [IsAlgClosed E] : ∃ j, Transcendental E (coordinate E B.prime j) :=
  TE E B.prime fun v heq => by
    have h := RCN072.ECU E v
    rw [show RCN072.pointKernel E v = B.prime from heq.symm, B.height] at h
    exact absurd h (by norm_num)

/-- The multiplicity `ord_B (f - c)` of the component in the level curve. -/
def mult : ℕ := (-(B.val (f - algebraMap E (AJ E G) c)).log).toNat

end LevelComponent

attribute [local instance] LevelComponent.isPrime

variable {G}

/-- `Σ_{B ∈ s} ord_B(L_c) Σ_{λ ∈ T B} flagPole_λ(W)`: the poles of the flag `W` on the components `s` of
the level curve, with their multiplicities, at the finite sets `T B` of places. `[L_c . W] ≤ d` is the
statement that every such sum is at most `d`. -/
def levelFlagSum {f : AJ E G} {c : E} (s : Finset (LevelComponent G f c))
    (T : ∀ B : LevelComponent G f c, Finset (RCN026.Place E (AJ E B.prime))) (W : FlagDegree) : ℤ :=
  ∑ B ∈ s, (B.mult : ℤ) * ∑ v ∈ T B, RCN204.flagPole v.val (coordinate E B.prime) W

variable (G)

/-- What the count on the level curve asks of the constant `c` on one geometric component `G = (g)`,
for the moving function `f` and the function `A₁`: `f` is not the constant `c`, and along every prime
divisor of the eight charts on which `f - c` vanishes the three coordinates, the `R`-derivative of `g`,
the polynomial `H` and `A₁` are units. Each condition excludes finitely many `c`
(`finite_surfaceDivisor_ne_one` and `finite_level_values`), when the coordinates, the derivative, `H` and
`A₁` are not zero on the component. -/
structure LevelCount.Needs (g H : MvPolynomial (Fin 3) E) (f : AJ E G) (c : E) (A₁ : AJ E G) : Prop where
  ne : f ≠ algebraMap E (AJ E G) c
  unit : ∀ nu : Valuation (AJ E G) ℤᵐ⁰, (∃ sR sY sZ, SurfaceDivisor G sR sY sZ nu) →
    nu (f - algebraMap E (AJ E G) c) < 1 →
      (∀ j, nu (coordinate E G j) = 1) ∧ nu (BR E G (pderiv 1 g)) = 1 ∧ nu (BR E G H) = 1 ∧ nu A₁ = 1

end

end Component

section Packet
noncomputable section
open scoped Classical BigOperators
open WithZero
open RCN002 RCN046 RCN074 RCN086 RCN095 RCN130 RCN135 RCN156 RCN199 RCN222 RCN234 RCN237 RCN238 RCN243
open RCN264 RCN313 RCN334 RCN340 RCN344
open FA PR BD HK HFreeDir6813 HFree6812 DU BLL AYR BIO BBT _Q7 AFA RL TW CB BOE
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] LevelComponent.isPrime Exch.component_isPrime

/-- All that the count on the level curve asks of `Q`, `A`, `c` and of the curves `S a`:

* `component`: on every geometric component the conditions `LevelCount.Needs` for `c`;
* `live`: no live curve is a component of the level curve;
* `closure`: the local ring of a live curve at a point of the level curve where the moving function is
  regular has a finite integral closure;
* `levelClosure`: the local ring of a component of the level curve at each of its points, the points at
  infinity included, has a finite integral closure. -/
structure LevelNeeds (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1)) : Prop where
  component : ∀ g, LevelCount.Needs (Exch.component P g) (P.stage g).G (baseH P.F)
    (Exch.moving P Q A g) c (Exch.function P SZ g)
  live : ∀ a ∈ active P SZ, (S a).val (Exch.moving P Q A a.1 -
    algebraMap Ω (AJ Ω (Exch.component P a.1)) c) = 1
  closure : ∀ a ∈ active P SZ, ∀ (q : SurfacePoint (Exch.component P a.1)) (hq : q.On (S a)),
    Exch.moving P Q A a.1 ∈ q.ring → q.level (Exch.moving P Q A a.1) c ≠ 0 →
      Module.Finite ((S a).image hq) (integralClosure ((S a).image hq) (AJ Ω a.2.1))
  levelClosure : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c)
    (q : SurfacePoint (Exch.component P g)) (hq : q.On B.curve),
    Module.Finite (B.curve.image hq) (integralClosure (B.curve.image hq) (AJ Ω B.prime))

/-- The section bound: `scale * [L_c . e_j] ≤ (z, u, v)_j` for the three unit
flags, for every finite set of components of the level curves of the geometric components and every
finite set of places of each. In the application `scale = stageScale SZ delta` and `z`, `u`, `v`
are the three heights of `PacketFrame.point_budget`. -/
def SectionBound (P : Packet x t y r) (scale z u v : ℕ) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω) : Prop :=
  ∀ (s : ∀ g, Finset (LevelComponent (Exch.component P g) (Exch.moving P Q A g) c))
    (T : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c),
      Finset (RCN026.Place Ω (AJ Ω B.prime))),
    (scale : ℤ) * (∑ g, levelFlagSum (s g) (T g) unitZFlag) ≤ (z : ℤ) ∧
      (scale : ℤ) * (∑ g, levelFlagSum (s g) (T g) unitYZFlag) ≤ (u : ℤ) ∧
      (scale : ℤ) * (∑ g, levelFlagSum (s g) (T g) unitAllFlag) ≤ (v : ℤ)

/-- The count of `A₁` on the level curve for one packet, as a statement: for a flag `Hf` of `H` for which
the flag `Exch.flag SZ Hf` of `A₁` is below `d • cellCutR + 4 (w + 1) • SZ.flag`, and free numbers
`scale`, `z`, `u`, `v`, `LevelCount` for `moving a = curveMoving (S a) f c` and
`Lam = Exch.lam P SZ Q A c (Exch.flag SZ Hf)`. Hypotheses, in this order: the curves; the flag; the needs;
the section bound; those of `Exch.Statement.exchange_count` (nonzero coordinates,
`PsiSIntegral`, `SurfaceNoether`, the tail bridge); the flags of `Q` and `A` (they bound the degree of
the level cut, which gives the separable coordinate of the components of the level curve:
`LevelCount.separable`). -/
def LevelCount.Statement (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) : Prop :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  ∀ (Hf : FlagDegree) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1)),
    (∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a)) →
    ((Exch.flag SZ Hf).zOnly ≤ SZ.d * (cellCutR t y r).zOnly + 4 * (w + 1) * SZ.flag.zOnly ∧
      (Exch.flag SZ Hf).yz ≤ SZ.d * (cellCutR t y r).yz + 4 * (w + 1) * SZ.flag.yz ∧
      (Exch.flag SZ Hf).all ≤ SZ.d * (cellCutR t y r).all + 4 * (w + 1) * SZ.flag.all) →
    LevelNeeds P SZ Q A c S →
    SectionBound P scale z u v Q A c →
    (∀ j, sliceCoord P.F j ≠ 0) →
    (∀ sR sY sZ, PsiSIntegral P.F P.F (dvd_refl P.F) SZ Hf sR sY sZ) →
    ∀ N : ℕ, (∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N) → 3 * N < 2130706433 →
    Exch.TailOrder P hp SZ S →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A →
    LevelCount P hp SZ scale z u v (fun a => curveMoving (S a) (Exch.moving P Q A a.1) c)
      (Exch.lam P SZ Q A c (Exch.flag SZ Hf))

end
end Packet

end ProximityPrize.SubmissionLower.FormalR
