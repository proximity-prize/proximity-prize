/-!
The counted points of the point budget lie on good level curves.

Over an algebraically closed field let `G = 0`, `M = 0` and `A = 0` be three surfaces. A common
point `v` of the three is isolated (`RCN084.UK G M A v`) when `A` vanishes on no irreducible set
of positive dimension through `v` inside `G = M = 0`. The components are the elements of
`RCN264.AU Ω G M R`: the minimal primes of `(G, M)` on which `R` is not zero. Such a prime may be a
common factor of `G` and `M`; a component through an isolated point is not.

* `Counted.not_mem_of_isolated`: `A` is not zero on a component through an isolated point.
* `Counted.exists_factor`: the irreducible factor of `G` that vanishes on a component through an
  isolated point does not divide `M`; otherwise `A` would cut a curve through the point out of that
  factor, inside `G = M = 0`. Nothing is asked of `M`, in particular no transcendental level.
* `Counted.height_eq_two`: a component on such a factor has height two.
* `Counted.nonempty_separable`: it has a separable coordinate under two degree gates: `s < p` and
  `2 s s' < p` for the degree sums `s`, `s'` of flags of `G`, `M` and the characteristic `p`.
* `Counted.good`: the three together for the generic level cut on the carrier of a packet, where the
  gates hold.
* `counted`: the counted points are centres of as many places of the level curves that carry one;
  the cut is not zero on these curves and has a zero at each of these places.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Bud

open MvPolynomial RCN002 RCN095 RCN072 RCN264 RCN084

noncomputable section

namespace Counted

section Curve

variable {Ω : Type} [Field Ω] {G M R A : MvPolynomial (Fin 3) Ω} {v : Fin 3 → Ω}

theorem not_mem_of_isolated (V : AU Ω G M R) (hV : V.1 ≤ RingHom.ker (aeval v).toRingHom)
    (hi : UK G M A v) : A ∉ V.1 :=
  hi V.1 inferInstance (PU Ω G M R V) hV (EN Ω G M R V) (GV Ω G M R V)

theorem exists_factor (hG0 : G ≠ 0) (V : AU Ω G M R)
    (hV : V.1 ≤ RingHom.ker (aeval v).toRingHom) (hA : aeval v A = 0) (hi : UK G M A v) :
    ∃ g, Irreducible g ∧ g ∣ G ∧ g ∈ V.1 ∧ ¬g ∣ M := by
  obtain ⟨g, hg, hgV⟩ := RCN137.XP (Ideal.Quotient.mk V.1) G hG0
    (Ideal.Quotient.eq_zero_iff_mem.mpr (EN Ω G M R V))
  have hgV' : g ∈ V.1 := Ideal.Quotient.eq_zero_iff_mem.mp hgV
  obtain ⟨hgi, hgG⟩ := RCN137.VA G g hg
  refine ⟨g, hgi, hgG, hgV', fun hgM => ?_⟩
  obtain ⟨D, hD, hDv⟩ := DHO Ω g A v (hV hgV') hA
  have hgD : g ∈ D := DVL Ω g A D hD (Ideal.subset_span (Set.mem_insert g {A}))
  exact hi D (FUW Ω g A D hD) (fun w => ENO Ω g A D hD w) hDv (D.mem_of_dvd hgG hgD)
    (D.mem_of_dvd hgM hgD)
    (DVL Ω g A D hD (Ideal.subset_span (Set.mem_insert_of_mem g (Set.mem_singleton A))))

theorem height_eq_two (V : AU Ω G M R) {g : MvPolynomial (Fin 3) Ω} (hg : Irreducible g)
    (hgV : g ∈ V.1) (hgM : ¬g ∣ M) : V.1.height = 2 := by
  have hprime : (Ideal.span {g}).IsPrime :=
    (Ideal.span_singleton_prime hg.ne_zero).mpr
      (UniqueFactorizationMonoid.irreducible_iff_prime.mp hg)
  have hbot : (⊥ : Ideal (MvPolynomial (Fin 3) Ω)) < Ideal.span {g} :=
    bot_lt_iff_ne_bot.mpr fun h => hg.ne_zero (Ideal.span_singleton_eq_bot.mp h)
  have hlt : Ideal.span {g} < V.1 :=
    lt_of_le_of_ne ((Ideal.span_singleton_le_iff_mem _).mpr hgV) fun h =>
      hgM (Ideal.mem_span_singleton.mp (h.symm ▸ GV Ω G M R V))
  have h1 := Ideal.height_add_one_le_of_lt_of_isPrime hbot
  have h2 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
  refine le_antisymm (DIQ Ω G M V.1 (AAS Ω G M R V)) ?_
  calc (2 : ℕ∞) = 0 + 1 + 1 := by norm_num
    _ ≤ (⊥ : Ideal (MvPolynomial (Fin 3) Ω)).height + 1 + 1 := by gcongr; exact zero_le
    _ ≤ (Ideal.span {g}).height + 1 := by gcongr
    _ ≤ V.1.height := h2

theorem nonempty_separable [IsAlgClosed Ω] {p : ℕ} [CharP Ω p] (hG0 : G ≠ 0) (a b : FlagDegree)
    (hGa : BI a G) (hMb : BI b M) (hdeg : a.zOnly + a.yz + a.all < p)
    (hmix : 2 * (a.zOnly + a.yz + a.all) * (b.zOnly + b.yz + b.all) < p) (V : AU Ω G M R)
    {g : MvPolynomial (Fin 3) Ω} (hg : Irreducible g) (hgG : g ∣ G) (hgV : g ∈ V.1)
    (hgM : ¬g ∣ M) : Nonempty (RCN341.BP V.1) := by
  obtain ⟨i, htr⟩ := TE Ω V.1 (PU Ω G M R V)
  exact LevelCount.nonempty_separable i htr G g M hG0 hg hgG hgV (GV Ω G M R V) hgM a b hGa hMb
    hdeg hmix

end Curve

