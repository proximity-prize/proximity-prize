/-!
The two facts about `g_u = q.localFunction A₁ W` at a point `q` of a geometric component.

* `localFunction_mem`, `localFunction_function_mem`: `g_u` is regular at `q`, from the contract
  `PsiSIntegral`: the embedding `HFree6812.RY` maps a chart ring of the carrier into the chart ring of the
  component, so it maps integral elements to integral elements.
* `val_vertex_eq_one`: along a curve through `q` without pole of a coordinate the vertex monomial of the
  chart of `q` has value 1.
* `val_function_le`, `val_localFunction_function_le`: along a live curve `A₁` and `g_u` have order at least
  `3 d μ`, from the tail bridge for the curve.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.Exch

open WithZero MvPolynomial HFree6812
open RCN002 RCN095 RCN204

section Embedding

variable {K : Type} [Field K] {E : Type} [Field E] [Algebra (RCN135.GenericField K) E]
  (D : Ideal (MvPolynomial (Fin 3) E)) [D.IsPrime] (F₀ : MvPolynomial (Fin 4) K)
  [Fact (Irreducible F₀)] (hker : RingHom.ker (sliceMap (K := K) D) = Ideal.span {F₀})

theorem embedding_lmono (e : Fin 3 → ℤ) :
    RY D F₀ hker (lmono (sliceCoord F₀) e) = lmono (coordinate E D) e := by
  rw [lmono, map_mul, map_mul, map_zpow₀, map_zpow₀, map_zpow₀, psi_coord, psi_coord, psi_coord]
  rfl

theorem embedding_xField {a : SliceField F₀} (ha : a ∈ xField F₀) :
    RY D F₀ hker a ∈ (algebraMap E (AJ E D)).fieldRange := by
  induction ha using IntermediateField.adjoin_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx
    rw [hx, psi_X0]
    exact ⟨_, rfl⟩
  | algebraMap a =>
    rw [psi_const]
    exact ⟨_, rfl⟩
  | add x y _ _ ihx ihy =>
    rw [map_add]
    exact add_mem ihx ihy
  | inv x _ ihx =>
    rw [map_inv₀]
    exact inv_mem ihx
  | mul x y _ _ ihx ihy =>
    rw [map_mul]
    exact mul_mem ihx ihy

theorem embedding_chartRing (sR sY sZ : Bool) {a : SliceField F₀}
    (ha : a ∈ chartRing F₀ sR sY sZ) : RY D F₀ hker a ∈ surfaceChartRing D sR sY sZ := by
  induction ha using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    rw [chartCoord, embedding_lmono]
    exact Algebra.subset_adjoin ⟨i, rfl⟩
  | algebraMap r =>
    obtain ⟨b, hb⟩ := embedding_xField D F₀ hker r.2
    rw [show algebraMap (xField F₀) (SliceField F₀) r = (r : SliceField F₀) from rfl, ← hb]
    exact Subalgebra.algebraMap_mem _ b
  | add x y _ _ ihx ihy =>
    rw [map_add]
    exact add_mem ihx ihy
  | mul x y _ _ ihx ihy =>
    rw [map_mul]
    exact mul_mem ihx ihy

/-- An element integral over a chart ring of the carrier maps to an element integral over the chart ring
of the geometric component. -/
theorem isIntegral_embedding (sR sY sZ : Bool) {a : SliceField F₀}
    (ha : IsIntegral (chartRing F₀ sR sY sZ) a) :
    IsIntegral (surfaceChartRing D sR sY sZ) (RY D F₀ hker a) :=
  ha.map_of_comp_eq
    (((RY D F₀ hker).comp (algebraMap (chartRing F₀ sR sY sZ) (SliceField F₀))).codRestrict
      (surfaceChartRing D sR sY sZ) fun a => embedding_chartRing D F₀ hker sR sY sZ a.2)
    (RY D F₀ hker) rfl

/-- `g_u` is regular at every point of the model. -/
theorem localFunction_mem (F : MvPolynomial (Fin 4) K) (hdvd : F₀ ∣ F) (S : BD.Source F)
    (Hf : FlagDegree) (hI : ∀ sR sY sZ, PsiSIntegral F F₀ hdvd S Hf sR sY sZ)
    (q : SurfacePoint D) (m : ℕ) :
    q.localFunction (RY D F₀ hker (psiS F F₀ hdvd S m))
      (S.d • cutFlag m Hf + (4 * m) • S.flag) ∈ q.ring := by
  have h := isIntegral_embedding D F₀ hker _ _ _ (hI q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2 m)
  rw [map_div₀, embedding_lmono] at h
  exact q.chartOf_spec.1 h

end Embedding

section Curve

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime]

/-- Along a curve through `q` without pole of a coordinate, the vertex monomial of the chart of `q` has
value 1. -/
theorem val_vertex_eq_one {F : Type*} [Field F] (hc : ∀ j, coordinate E G j ≠ 0)
    (q : SurfacePoint G) (S : Specialization (AJ E G) F) (hq : q.On S)
    (hcoord : ∀ j, S.val (coordinate E G j) ≤ 1) (W : FlagDegree) :
    S.val (lmono (coordinate E G) (vertexExp q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2 W)) = 1 := by
  have hchart : ∀ i, S.val (lmono (coordinate E G)
      (chartExp q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2 i)) ≤ 1 := fun i =>
    hq ⟨_, q.chartOf_spec.1 (isIntegral_algebraMap (R := surfaceChartRing G _ _ _)
      (x := ⟨_, Algebra.subset_adjoin ⟨i, rfl⟩⟩))⟩
  have h0 : ∀ j, RCN187.poleOrder S.val (coordinate E G j) = 0 := fun j =>
    max_eq_left ((log_le_iff_le_exp ((Valuation.ne_zero_iff _).mpr (hc j))).mpr
      (by rw [exp_zero]; exact hcoord j))
  rw [flagPole_eq_vertex S.val _ hc _ _ _ hchart W]
  simp only [flagPole, h0, max_self, mul_zero, add_zero, exp_zero]

theorem val_pow_mul_le {L : Type*} [Field L] (v : Valuation L ℤᵐ⁰) (a b c : L) (m d e f : ℕ)
    (ha : v a ≤ exp (-(m : ℤ))) (hb : v b ≤ 1) (hc : v c ≤ 1) :
    v (a ^ (3 * d) * b ^ e * c ^ f) ≤ exp (-((3 * d * m : ℕ) : ℤ)) := by
  rw [map_mul, map_mul, map_pow, map_pow, map_pow]
  calc v a ^ (3 * d) * v b ^ e * v c ^ f
      ≤ exp (-(m : ℤ)) ^ (3 * d) * 1 ^ e * 1 ^ f :=
        mul_le_mul' (mul_le_mul' (pow_le_pow_left' ha _) (pow_le_pow_left' hb _))
          (pow_le_pow_left' hc _)
    _ = exp (-((3 * d * m : ℕ) : ℤ)) := by
        rw [one_pow, one_pow, mul_one, mul_one, ← exp_nsmul]
        congr 1
        push_cast
        simp only [nsmul_eq_mul]
        push_cast
        ring

variable {C : Ideal (MvPolynomial (Fin 3) E)} [C.IsPrime] {S : Specialization (AJ E G) (AJ E C)}

theorem val_le_one_of_isCurveOnSurface (h : IsCurveOnSurface G C S) (A : MvPolynomial (Fin 3) E) :
    S.val (BR E G A) ≤ 1 :=
  (Valuation.mem_valuationSubring_iff _ _).mp (h A).1

/-- The prime of a curve on the surface is the centre of its valuation on the polynomials. -/
theorem mem_iff_of_isCurveOnSurface (h : IsCurveOnSurface G C S) (A : MvPolynomial (Fin 3) E) :
    A ∈ C ↔ S.val (BR E G A) < 1 := by
  obtain ⟨hmem, hres⟩ := h A
  rw [← ABU C A, ← hres, S.res_eq_zero_iff]

end Curve

section Packet
noncomputable section
open scoped Classical
open RCN074 RCN135 RCN136 RCN159 RCN222 RCN264 RCN313 RCN334
open DU BD AFA BOE
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] component_isPrime fact_irreducible

theorem embedding_sliceProj (P : Packet x t y r) (g : EX K P.F) (A : MvPolynomial (Fin 4) K) :
    embedding P g (sliceProj P.F A) = BR Ω (component P g) (surfaceMap (AL K) A) := by
  rw [embedding, SR, sliceMap_component]

theorem coordinate_ne_zero (P : Packet x t y r) (g : EX K P.F) (hc : ∀ j, sliceCoord P.F j ≠ 0)
    (j : Fin 3) : coordinate Ω (component P g) j ≠ 0 := by
  rw [← psi_coord (component P g) P.F (ker_sliceMap_component P g) j]
  exact (map_ne_zero _).mpr (hc j)

/-- `g_u` for the function `A₁` of a packet is regular at every point of a geometric component. -/
theorem localFunction_function_mem (P : Packet x t y r) (SZ : Source P.F) (Hf : FlagDegree)
    (hI : ∀ sR sY sZ, PsiSIntegral P.F P.F (dvd_refl P.F) SZ Hf sR sY sZ) (g : EX K P.F)
    (q : SurfacePoint (component P g)) :
    q.localFunction (function P SZ g) (flag SZ Hf) ∈ q.ring :=
  localFunction_mem (component P g) P.F (ker_sliceMap_component P g) P.F (dvd_refl P.F) SZ Hf hI q w

theorem function_eq (P : Packet x t y r) (SZ : Source P.F) (g : EX K P.F) :
    function P SZ g = embedding P g (tail P.F P.F (dvd_refl P.F) w) ^ (3 * SZ.d) *
      embedding P g (sliceProj P.F (polyH K P.F)) ^ (2 * w * SZ.d) *
      embedding P g (srcLead P.F P.F SZ) ^ (4 * w) := by
  rw [function, psiS, map_mul, map_mul, map_pow, map_pow, map_pow]

/-- `A₁` is not zero on a geometric component when the tail, `H` and the leading coefficient of the
source are not zero on the carrier. -/
theorem function_ne_zero (P : Packet x t y r) (SZ : Source P.F) (g : EX K P.F)
    (htail : tail P.F P.F (dvd_refl P.F) w ≠ 0) (hH : sliceProj P.F (polyH K P.F) ≠ 0)
    (hlead : srcLead P.F P.F SZ ≠ 0) : function P SZ g ≠ 0 := by
  rw [function_eq]
  exact mul_ne_zero (mul_ne_zero (pow_ne_zero _ ((map_ne_zero _).mpr htail))
    (pow_ne_zero _ ((map_ne_zero _).mpr hH))) (pow_ne_zero _ ((map_ne_zero _).mpr hlead))

/-- Along a live curve `A₁` has order at least `3 d μ`, given the tail bridge for the curve. -/
theorem val_function_le (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (a : Curve P)
    (S : Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1))
    (hS : IsCurveOnSurface (component P a.1) a.2.1 S)
    (htail : S.val (embedding P a.1 (tail P.F P.F (dvd_refl P.F) w)) ≤
      exp (-(multiplicity P hp a : ℤ))) :
    S.val (function P SZ a.1) ≤ exp (-((3 * SZ.d * multiplicity P hp a : ℕ) : ℤ)) := by
  rw [function_eq]
  refine val_pow_mul_le S.val _ _ _ _ _ _ _ htail ?_ ?_
  · rw [embedding_sliceProj]
    exact val_le_one_of_isCurveOnSurface hS _
  · rw [srcLead, embedding_sliceProj]
    exact val_le_one_of_isCurveOnSurface hS _

/-- Along a live curve through `q` the function `g_u` has order at least `3 d μ`, given the tail bridge
for the curve. -/
theorem val_localFunction_function_le (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (W : FlagDegree) (hc : ∀ j, sliceCoord P.F j ≠ 0) (a : Curve P)
    (S : Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1))
    (hS : IsCurveOnSurface (component P a.1) a.2.1 S)
    (htail : S.val (embedding P a.1 (tail P.F P.F (dvd_refl P.F) w)) ≤
      exp (-(multiplicity P hp a : ℤ)))
    (q : SurfacePoint (component P a.1)) (hq : q.On S) :
    S.val (q.localFunction (function P SZ a.1) W) ≤
      exp (-((3 * SZ.d * multiplicity P hp a : ℕ) : ℤ)) := by
  rw [SurfacePoint.localFunction, map_div₀,
    val_vertex_eq_one (coordinate_ne_zero P a.1 hc) q S hq
      (fun j => val_le_one_of_isCurveOnSurface hS (MvPolynomial.X j)) W, div_one]
  exact val_function_le P hp SZ a S hS htail

end
end Packet

end ProximityPrize.SubmissionLower.FormalR.Exch
end
section

/-!
The tail on a live curve.

* `tailCubeOn phi F C n`: the restriction to a curve `C` of the carrier of `τ_(n+1)^3 H^(2 (n+1))`, as the
  quotient `N_n^3 / H^(4 n + 1)` of the numerators `N_n = RCN055.MN F n`
  (`tailCubeOn_mem_resGraph`).
* `seed_place`, `seed_tailCube`: at a place over a seed of a component of the first tail cut of a stage of
  depth `d`, `H` is a unit and the numerators `N_n`, `d ≤ n + 1`, vanish.
* `tail_curve_count`: the count on a live curve of a stage for `(τ_(m+1)^3 H^(2 (m+1)))^n * u`, `u` a unit at
  the places over the seeds, with the pole side as hypothesis.
* `tail_cube_integral`: for a pair `(s, n)` with `ord_w s ≥ n placeT_w` at the prime divisors `w` of a chart,
  `(τ_m^3 H^(2 m))^n s^(4 m)` divided by the vertex monomial of `n • cutFlag m Hf` is integral over the chart
  ring, from `ChartKrull` and `ChartPlaceLaw`.
* `tail_cube_curve`: its restriction to `C` at a valuation centred in the chart, with
  `exp (flagPole (n • cutFlag m Hf))` on the right; `tail_cube_place`: at every valuation of the curve, in
  the chart of `chart_select`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero MvPolynomial HFree6812
open RCN002 RCN055 RCN086 RCN095 RCN136 RCN204 RCN313

noncomputable section

theorem le_exp_neg_one_of_lt_one {a : ℤᵐ⁰} (h : a < 1) : a ≤ exp (-1) := by
  rcases eq_or_ne a 0 with rfl | ha
  · exact zero_le
  · have hlog : log a < 0 := (log_lt_iff_lt_exp ha).2 (by rwa [exp_zero])
    exact (log_le_iff_le_exp ha).1 (by omega)

theorem div_pow_mul_div_pow {R L : Type*} [CommRing R] [Field L] (f : R →+* L) (a b c d : R)
    (n k : ℕ) : (f a / f b) ^ n * (f c / f d) ^ k = f (a ^ n * c ^ k) / f (b ^ n * d ^ k) := by
  rw [map_mul, map_mul, map_pow, map_pow, map_pow, map_pow, div_pow, div_pow, div_mul_div_comm]

/-- For the flag `⟨z, v, r - 1⟩` of `H`, `cutFlag` is the flag `cutR m r v z`. -/
theorem cutFlag_cell (m z v r : ℕ) :
    cutFlag m ⟨z, v, r - 1⟩ = m • (⟨2 * z, 2 * v, 2 * r - 7⟩ : FlagDegree) + ⟨0, 0, 3⟩ := by
  show m • (⟨2 * z, 2 * v, 2 * (r - 1) - 5⟩ : FlagDegree) + ⟨0, 0, 3⟩ = _
  rw [show 2 * (r - 1) - 5 = 2 * r - 7 by omega]

variable {K E : Type} [Field K] [Field E]

/-- The exponents of a polynomial with the support data of the cell `(t, y, r)`: the hypothesis of
`polyH_flag_le` and `polyH_euler_le` for `z = t - y`, `y - r`, `r`. -/
theorem cell_support (t y r : ℕ) (hr : 2 ≤ r) (hy : r + 1 ≤ y) (F : MvPolynomial (Fin 4) K)
    (hF : RCN275.KW (FA.cellSupport t y r) F) :
    ∀ e ∈ F.support, e 2 ≤ r ∧ e 1 + e 2 ≤ r + (y - r) ∧ e 1 + e 2 + e 3 ≤ r + (y - r) + (t - y) := by
  intro e he
  have h1 := (MvPolynomial.le_weightedTotalDegree RCN156.BE he).trans hF.s_weight
  have h2 := (MvPolynomial.le_weightedTotalDegree RCN156.BC he).trans hF.ys_weight
  have h3 := (MvPolynomial.le_weightedTotalDegree RCN156.AT he).trans hF.total_weight
  rw [RCN081.weight_fin4] at h1 h2 h3
  change e 0 * 0 + e 1 * 0 + e 2 * 1 + e 3 * 0 ≤ r - 2 + 2 at h1
  change e 0 * 0 + e 1 * 1 + e 2 * 1 + e 3 * 0 ≤ y - r - 1 + (r - 2) + 3 at h2
  change e 0 * 0 + e 1 * 1 + e 2 * 1 + e 3 * 1 ≤ t - y + (y - r - 1) + (r - 2) + 3 at h3
  omega

theorem tailCut_eq (phi : Polynomial K →+* E) (F : MvPolynomial (Fin 4) K) (n : ℕ) :
    _Q2 phi F (n + 2) = surfaceMap phi (polyH K F) ^ 3 * surfaceMap phi (MN F n) *
      MvPolynomial.C ((-phi Polynomial.X) ^ (n + 2)) := by
  rw [ALA, CAN, map_mul, map_pow]

/-- No coordinate vanishes identically on a component of the carrier on which `H` and one tail numerator
are not identically zero. -/
theorem sliceCoord_ne_zero (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (hH : sliceProj F₀ (polyH K F) ≠ 0) (n : ℕ) (hn : sliceProj F₀ (MN F n) ≠ 0) (j : Fin 3) :
    sliceCoord F₀ j ≠ 0 := by
  have hR : sliceCoord F₀ 1 ≠ 0 := fun h0 => by
    have h := DJY F F₀ hdvd hH n
    rw [show sliceProj F₀ (MvPolynomial.X 2) = sliceCoord F₀ 1 from rfl, h0,
      Function.iterate_fixed (map_zero _) (n + 1)] at h
    exact hn ((div_eq_zero_iff.1 h.symm).resolve_right (pow_ne_zero _ hH))
  have hY : sliceCoord F₀ 0 ≠ 0 := fun h0 => by
    have h := ATS F F₀ hdvd hH
    rw [h0, map_zero] at h
    exact hR h.symm
  have hZ : sliceCoord F₀ 2 ≠ 0 := fun h0 => by
    obtain ⟨c, hc⟩ := (BMJ F₀ (MvPolynomial.X 3)).1 h0
    have hX : Irreducible (MvPolynomial.X 3 : MvPolynomial (Fin 4) K) := MvPolynomial.X_prime.irreducible
    have hcu : IsUnit c := (hX.isUnit_or_isUnit hc).resolve_left (Fact.out : Irreducible F₀).not_isUnit
    obtain ⟨G₁, hG⟩ : (MvPolynomial.X 3 : MvPolynomial (Fin 4) K) ∣ F := by
      rw [hc]
      exact hcu.mul_right_dvd.2 hdvd
    refine hH ((BMJ F₀ _).2 (dvd_trans ⟨c, hc⟩ ?_))
    rw [polyH, hG, Derivation.leibniz, pderiv_X_of_ne (by decide), smul_zero, add_zero]
    exact ⟨_, rfl⟩
  fin_cases j
  exacts [hY, hR, hZ]

theorem tail_cube_eq (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (hH : sliceProj F₀ (polyH K F) ≠ 0) (n : ℕ) :
    tail F F₀ hdvd (n + 1) ^ 3 * sliceProj F₀ (polyH K F) ^ (2 * (n + 1)) =
      sliceProj F₀ (MN F n ^ 3) / sliceProj F₀ (polyH K F ^ (4 * n + 1)) := by
  rw [tail, show sliceCoord F₀ 1 = sliceProj F₀ (MvPolynomial.X 2) from rfl, DJY F F₀ hdvd hH n,
    map_pow, map_pow, div_pow, ← pow_mul, div_mul_eq_mul_div,
    div_eq_div_iff (pow_ne_zero _ hH) (pow_ne_zero _ hH)]
  ring

/-- The restriction of `τ_(n+1)^3 H^(2 (n+1))` to a curve `C` of the carrier on which `H` is not identically
zero. -/
def tailCubeOn (phi : Polynomial K →+* E) (F : MvPolynomial (Fin 4) K)
    (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (n : ℕ) : AJ E C :=
  CT.GP phi C (MN F n ^ 3) / CT.GP phi C (polyH K F ^ (4 * n + 1))

theorem tailCubeOn_mem_resGraph (phi : Polynomial K →+* E) (F F₀ : MvPolynomial (Fin 4) K)
    [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F) (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime]
    (hFC : surfaceMap phi F₀ ∈ C) (hHC : surfaceMap phi (polyH K F) ∉ C) (n : ℕ) :
    (tail F F₀ hdvd (n + 1) ^ 3 * sliceProj F₀ (polyH K F) ^ (2 * (n + 1)), tailCubeOn phi F C n) ∈
      resGraph (sliceProj F₀) (CT.GP phi C) := by
  have hfg := GP_eq_zero_of_sliceProj (F₀ := F₀) (phi := phi) (C := C) hFC
  have hH0 : CT.GP phi C (polyH K F) ≠ 0 := fun h => hHC ((CT.AAE C _).1 h)
  rw [tail_cube_eq F F₀ hdvd (fun h => hH0 (hfg _ h)) n]
  exact mem_resGraph hfg _ _ (by rw [map_pow]; exact pow_ne_zero _ hH0)

/-- `ChartKrull` and `ChartPlaceLaw` on a chart for a pair `(s, n)`: `s` has order at least `n placeT` at
every prime divisor of the chart. -/
theorem tail_cube_integral (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (hH : sliceProj F₀ (polyH K F) ≠ 0) (hc : ∀ j, sliceCoord F₀ j ≠ 0) (Hf : FlagDegree)
    (h5 : 5 ≤ 2 * Hf.all) (sR sY sZ : Bool)
    (hHf : ∀ w, ChartDivisor F₀ sR sY sZ w →
      w (sliceProj F₀ (polyH K F)) ≤ exp (flagPole w (sliceCoord F₀) Hf))
    (hKr : ChartKrull F₀ sR sY sZ) (hPL : ChartPlaceLaw F F₀ hdvd sR sY sZ) (m n : ℕ)
    (s : SliceField F₀)
    (hs : ∀ w, ChartDivisor F₀ sR sY sZ w → w s ≤ exp (-((n : ℤ) * placeT F F₀ w))) :
    IsIntegral (chartRing F₀ sR sY sZ)
      ((tail F F₀ hdvd m ^ 3 * sliceProj F₀ (polyH K F) ^ (2 * m)) ^ n * s ^ (4 * m) /
        lmono (sliceCoord F₀) (vertexExp sR sY sZ (n • cutFlag m Hf))) := by
  refine hKr _ fun w hw => ?_
  have h1 := tail_cube_bound F F₀ hdvd hH w m (hPL w hw m) Hf h5 (hHf w hw)
  rw [map_div₀, flagPole_eq_vertex w _ hc sR sY sZ hw.coord_le_one]
  simp only [map_mul, map_pow]
  refine (div_le_one₀ (zero_lt_iff.2 exp_ne_zero)).2 ?_
  calc (w (tail F F₀ hdvd m) ^ 3 * w (sliceProj F₀ (polyH K F)) ^ (2 * m)) ^ n * w s ^ (4 * m)
      ≤ exp (4 * m * placeT F F₀ w + flagPole w (sliceCoord F₀) (cutFlag m Hf)) ^ n *
          exp (-((n : ℤ) * placeT F F₀ w)) ^ (4 * m) :=
        mul_le_mul' (pow_le_pow_left' h1 n) (pow_le_pow_left' (hs w hw) (4 * m))
    _ = exp (flagPole w (sliceCoord F₀) (n • cutFlag m Hf)) := by
        rw [← exp_nsmul, ← exp_nsmul, ← exp_add, DZP]
        congr 1
        simp only [nsmul_eq_mul]
        push_cast
        ring

/-- The bound for `τ_(m+1)^3 H^(2 (m+1))` on a curve `C` of the carrier, at a valuation centred in a chart
that inverts no coordinate vanishing on `C`: for a pair `(s, n)` of the chart,
`n ord(τ^3 H^(2 (m+1)) on C) + 4 (m+1) ord(s on C) ≥ -flagPole (n • cutFlag (m+1) Hf)`. -/
theorem tail_cube_curve (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (Hf : FlagDegree) (h5 : 5 ≤ 2 * Hf.all) (sR sY sZ : Bool)
    (hHf : ∀ w, ChartDivisor F₀ sR sY sZ w →
      w (sliceProj F₀ (polyH K F)) ≤ exp (flagPole w (sliceCoord F₀) Hf))
    (hKr : ChartKrull F₀ sR sY sZ) (hPL : ChartPlaceLaw F F₀ hdvd sR sY sZ)
    (phi : Polynomial K →+* E) (hphi : Function.Injective phi)
    (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (hFC : surfaceMap phi F₀ ∈ C)
    (hHC : surfaceMap phi (polyH K F) ∉ C)
    (hR : sR = true → coordinate E C 1 ≠ 0) (hY : sY = true → coordinate E C 0 ≠ 0)
    (hZ : sZ = true → coordinate E C 2 ≠ 0)
    (m n : ℕ) (hn : 1 ≤ n) (snum sden : MvPolynomial (Fin 4) K) (hsden : CT.GP phi C sden ≠ 0)
    (hs : ∀ w, ChartDivisor F₀ sR sY sZ w →
      w (sliceProj F₀ snum / sliceProj F₀ sden) ≤ exp (-((n : ℤ) * placeT F F₀ w)))
    (nu : Valuation (AJ E C) ℤᵐ⁰) (hnuE : ∀ a : E, nu (algebraMap E (AJ E C) a) ≤ 1)
    (hchart : ∀ i, nu (lmono (coordinate E C) (chartExp sR sY sZ i)) ≤ 1) :
    nu (tailCubeOn phi F C m) ^ n * nu (CT.GP phi C snum / CT.GP phi C sden) ^ (4 * (m + 1)) ≤
      exp (flagPole nu (coordinate E C) (n • cutFlag (m + 1) Hf)) := by
  have hfg := GP_eq_zero_of_sliceProj (F₀ := F₀) (phi := phi) (C := C) hFC
  have hH0 : CT.GP phi C (polyH K F) ≠ 0 := fun h => hHC ((CT.AAE C _).1 h)
  have hH : sliceProj F₀ (polyH K F) ≠ 0 := fun h => hH0 (hfg _ h)
  by_cases hT : CT.GP phi C (MN F m) = 0
  · have h0 : tailCubeOn phi F C m = 0 := by
      rw [tailCubeOn, map_pow, hT, zero_pow (by norm_num), zero_div]
    rw [h0, map_zero, zero_pow (by omega), zero_mul]
    exact zero_le
  · have hc := sliceCoord_ne_zero F F₀ hdvd hH m fun h => hT (hfg _ h)
    have hint := tail_cube_integral F F₀ hdvd hH hc Hf h5 sR sY sZ hHf hKr hPL (m + 1) n _ hs
    rw [tail_cube_eq F F₀ hdvd hH m, div_pow_mul_div_pow] at hint
    have h := res_le_flagPole_chart F₀ sR sY sZ phi hphi C hFC hR hY hZ _ _
      (by
        simp only [map_mul, map_pow]
        exact mul_ne_zero (pow_ne_zero _ (pow_ne_zero _ hH0)) (pow_ne_zero _ hsden))
      _ hint nu hnuE hchart
    rw [← div_pow_mul_div_pow, map_mul, map_pow nu, map_pow nu] at h
    exact h

/-- The same at every valuation of the curve, in the chart selected by the valuation. -/
theorem tail_cube_place (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (Hf : FlagDegree) (h5 : 5 ≤ 2 * Hf.all)
    (hHf : ∀ sR sY sZ w, ChartDivisor F₀ sR sY sZ w →
      w (sliceProj F₀ (polyH K F)) ≤ exp (flagPole w (sliceCoord F₀) Hf))
    (hKr : ∀ sR sY sZ, ChartKrull F₀ sR sY sZ) (hPL : ∀ sR sY sZ, ChartPlaceLaw F F₀ hdvd sR sY sZ)
    (phi : Polynomial K →+* E) (hphi : Function.Injective phi)
    (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (hFC : surfaceMap phi F₀ ∈ C)
    (hHC : surfaceMap phi (polyH K F) ∉ C)
    (nu : Valuation (AJ E C) ℤᵐ⁰) (hnuE : ∀ a : E, nu (algebraMap E (AJ E C) a) ≤ 1) :
    ∃ sR sY sZ : Bool, (∀ i, nu (lmono (coordinate E C) (chartExp sR sY sZ i)) ≤ 1) ∧
      ∀ (m n : ℕ) (snum sden : MvPolynomial (Fin 4) K), 1 ≤ n → CT.GP phi C sden ≠ 0 →
        (∀ w, ChartDivisor F₀ sR sY sZ w →
          w (sliceProj F₀ snum / sliceProj F₀ sden) ≤ exp (-((n : ℤ) * placeT F F₀ w))) →
        nu (tailCubeOn phi F C m) ^ n * nu (CT.GP phi C snum / CT.GP phi C sden) ^ (4 * (m + 1)) ≤
          exp (flagPole nu (coordinate E C) (n • cutFlag (m + 1) Hf)) := by
  obtain ⟨sR, sY, sZ, hR, hY, hZ, hchart, -⟩ := chart_select nu (coordinate E C)
  exact ⟨sR, sY, sZ, hchart, fun m n snum sden hn hsden hs =>
    tail_cube_curve F F₀ hdvd Hf h5 sR sY sZ (hHf sR sY sZ) (hKr sR sY sZ) (hPL sR sY sZ) phi hphi
      C hFC hHC hR hY hZ m n hn snum sden hsden hs nu hnuE hchart⟩

section Stage

open RCN074 RCN135 RCN159 RCN238 RCN243 RCN264 RCN330

variable {K I : Type} [Field K] {Gamma : Finset K} {x : I → K} {p : ℕ} {flag : FlagDegree}
  [CharP (GenericField K) p] {stageErrorCap d : ℕ} {sup : RCN275.BT}

/-- The places over a seed of a live curve: `H` is a unit there and the numerator `N_n` of the tail
`τ_(n+1)` vanishes there, for every `n + 1` that is at least the depth `d` of the stage. -/
theorem seed_place (S : FH (AL K) Gamma x p stageErrorCap flag d sup) (C : CM S) (γ : K)
    (hγ : γ ∈ HF (GenericField K) S.G (_Q2 (AL K) S.F (d + 1)) (CR (AL K) S.F) Gamma
      (DK (AL K) S.selected) C)
    (mu : RCN026.Place (GenericField K) (AJ (GenericField K) C.1))
    (hmu : PlaceOver C.1 (DK (AL K) S.selected γ) mu) :
    mu.val (CT.GP (AL K) C.1 (polyH K S.F)) = 1 ∧
      ∀ n, d ≤ n + 1 → mu.val (CT.GP (AL K) C.1 (MN S.F n)) < 1 := by
  have hΓ : γ ∈ Gamma := LU (GenericField K) S.G _ _ Gamma (DK (AL K) S.selected) C hγ
  have hHv : MvPolynomial.aeval (DK (AL K) S.selected γ) (surfaceMap (AL K) (polyH K S.F)) ≠ 0 := by
    change MvPolynomial.eval (DK (AL K) S.selected γ)
      (surfaceMap (AL K) (MvPolynomial.pderiv (2 : Fin 4) S.F)) ≠ 0
    rw [WQ (AL K) S.selected γ]
    exact S.regular γ hΓ
  have h1 : mu.val (BR (GenericField K) C.1 (surfaceMap (AL K) (polyH K S.F))) = 1 :=
    hmu.eq_one _ hHv
  refine ⟨h1, fun n hn => hmu (surfaceMap (AL K) (MN S.F n)) ?_⟩
  have hz := VZ (AL K) S.F S.selected γ d (n + 2) (S.degree_le γ hΓ) (S.solution γ hΓ) (by omega)
  rw [tailCut_eq, map_mul, map_mul, map_pow, MvPolynomial.aeval_C] at hz
  rcases mul_eq_zero.1 hz with h2 | h2
  · exact (mul_eq_zero.1 h2).resolve_left (pow_ne_zero _ hHv)
  · exact absurd h2 (AVR (AL K) (DI K) (n + 2))

/-- `τ_(n+1)^3 H^(2 (n+1))` has order at least 3 at the places over a seed. -/
theorem seed_tailCube (S : FH (AL K) Gamma x p stageErrorCap flag d sup) (C : CM S) (γ : K)
    (hγ : γ ∈ HF (GenericField K) S.G (_Q2 (AL K) S.F (d + 1)) (CR (AL K) S.F) Gamma
      (DK (AL K) S.selected) C)
    (mu : RCN026.Place (GenericField K) (AJ (GenericField K) C.1))
    (hmu : PlaceOver C.1 (DK (AL K) S.selected γ) mu) (n : ℕ) (hn : d ≤ n + 1) :
    mu.val (tailCubeOn (AL K) S.F C.1 n) ≤ exp (-3) := by
  obtain ⟨h1, h2⟩ := seed_place S C γ hγ mu hmu
  simp only [tailCubeOn, map_div₀, map_pow, h1, one_pow, div_one]
  calc mu.val (CT.GP (AL K) C.1 (MN S.F n)) ^ 3 ≤ exp (-1) ^ 3 :=
        pow_le_pow_left' (le_exp_neg_one_of_lt_one (h2 n hn)) 3
    _ = exp (-3) := by
        rw [← exp_nsmul]
        norm_num

/-- The count on a live curve of a stage for `psi = (τ_(m+1)^3 H^(2 (m+1)))^n * u` with `u` a unit at the
places over the seeds: the seeds are zeros of order at least `3 n` and the pole side is the hypothesis,
with an allowance `e` whose sums over finite sets of places are at most `B`. -/
theorem Curve.tail_curve_count_of_bound (S : FH (AL K) Gamma x p stageErrorCap flag d sup)
    (C : CM S) (base : RCN341.BP C.1) {Hb Gb : MvPolynomial (Fin 3) (GenericField K)}
    (budget : RCN199.RD C.1 Hb Gb) (m n : ℕ) (hm : d ≤ m + 1) (u : AJ (GenericField K) C.1)
    (hu : ∀ γ ∈ HF (GenericField K) S.G (_Q2 (AL K) S.F (d + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C,
      ∀ mu : RCN026.Place (GenericField K) (AJ (GenericField K) C.1),
        PlaceOver C.1 (DK (AL K) S.selected γ) mu → mu.val u = 1)
    (hpsi : tailCubeOn (AL K) S.F C.1 m ^ n * u ≠ 0) (W : FlagDegree)
    (e : RCN026.Place (GenericField K) (AJ (GenericField K) C.1) → ℕ) (B : ℕ)
    (hB : ∀ T : Finset (RCN026.Place (GenericField K) (AJ (GenericField K) C.1)),
      ∑ mu ∈ T, e mu ≤ B)
    (hpole : ∀ mu : RCN026.Place (GenericField K) (AJ (GenericField K) C.1),
      -flagPole mu.val (coordinate (GenericField K) C.1) W - e mu ≤
        RCN026.order (GenericField K) (AJ (GenericField K) C.1) mu
          (tailCubeOn (AL K) S.F C.1 m ^ n * u)) :
    3 * n * (HF (GenericField K) S.G (_Q2 (AL K) S.F (d + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C).card ≤ budget.weightedCost W + B := by
  refine Curve.curve_count_of_bound S.G _ _ C base budget Gamma (DK (AL K) S.selected)
    (ABD (AL K) S.selected) _ hpsi (3 * n) (fun γ hγ mu hmu => ?_) W e B hB hpole
  have h1 := seed_tailCube S C γ hγ mu hmu m hm
  have h2 : mu.val (tailCubeOn (AL K) S.F C.1 m ^ n * u) ≤ exp (-((3 * n : ℕ) : ℤ)) := by
    rw [map_mul, map_pow, hu γ hγ mu hmu, mul_one]
    calc mu.val (tailCubeOn (AL K) S.F C.1 m) ^ n ≤ exp (-3) ^ n := pow_le_pow_left' h1 n
      _ = exp (-((3 * n : ℕ) : ℤ)) := by
          rw [← exp_nsmul, nsmul_eq_mul]
          congr 1
          push_cast
          ring
  have h3 := (log_le_iff_le_exp ((Valuation.ne_zero_iff _).2 hpsi)).2 h2
  change ((3 * n : ℕ) : ℤ) ≤ -(mu.val (tailCubeOn (AL K) S.F C.1 m ^ n * u)).log
  omega

/-- The same for an allowance that is zero outside a finite set. -/
theorem tail_curve_count (S : FH (AL K) Gamma x p stageErrorCap flag d sup) (C : CM S)
    (base : RCN341.BP C.1) {Hb Gb : MvPolynomial (Fin 3) (GenericField K)}
    (budget : RCN199.RD C.1 Hb Gb) (m n : ℕ) (hm : d ≤ m + 1) (u : AJ (GenericField K) C.1)
    (hu : ∀ γ ∈ HF (GenericField K) S.G (_Q2 (AL K) S.F (d + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C,
      ∀ mu : RCN026.Place (GenericField K) (AJ (GenericField K) C.1),
        PlaceOver C.1 (DK (AL K) S.selected γ) mu → mu.val u = 1)
    (hpsi : tailCubeOn (AL K) S.F C.1 m ^ n * u ≠ 0) (W : FlagDegree)
    (e : RCN026.Place (GenericField K) (AJ (GenericField K) C.1) → ℕ)
    (E : Finset (RCN026.Place (GenericField K) (AJ (GenericField K) C.1)))
    (he : ∀ mu, mu ∉ E → e mu = 0)
    (hpole : ∀ mu : RCN026.Place (GenericField K) (AJ (GenericField K) C.1),
      -flagPole mu.val (coordinate (GenericField K) C.1) W - e mu ≤
        RCN026.order (GenericField K) (AJ (GenericField K) C.1) mu
          (tailCubeOn (AL K) S.F C.1 m ^ n * u)) :
    3 * n * (HF (GenericField K) S.G (_Q2 (AL K) S.F (d + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C).card ≤ budget.weightedCost W + ∑ mu ∈ E, e mu :=
  Curve.tail_curve_count_of_bound S C base budget m n hm u hu hpsi W e _
    (fun _ => Finset.sum_le_sum_of_ne_zero fun mu _ hne => by_contra fun hE => hne (he mu hE)) hpole

end Stage

end

end ProximityPrize.SubmissionLower.FormalR
end
