/-!
The centre of a curve on the surface at a point of the model is not the closed point. If it
were, the valuation ring of the curve would dominate the local ring of the point; by the overlap of two
charts (`PlaceSurf.chart_overlap`, with the chart of the point and the affine chart) the three
coordinates would lie in that local ring, and their residues along the curve would be constants.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero
open RCN002

section

variable {E : Type} [Field E] {G C : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime] [C.IsPrime]

/-- The coordinates in the affine chart. -/
theorem Surf.lmono_affine_mem {L : Type*} [Field L] (x : Fin 3 → L) (W : Set L) :
    (∀ i, lmono x (chartExp false false false i) ∈ W) ↔ ∀ j, x j ∈ W := by
  have h0 : lmono x (chartExp false false false 0) = x 1 := by
    rw [PlaceSurf.lmono_chartExp_zero]
    simp [PlaceSurf.flip, PlaceSurf.denR, PlaceSurf.denY]
  have h1 : lmono x (chartExp false false false 1) = x 0 := by
    rw [PlaceSurf.lmono_chartExp_one]
    simp [PlaceSurf.flip, PlaceSurf.denY]
  have h2 : lmono x (chartExp false false false 2) = x 2 := by
    rw [PlaceSurf.lmono_chartExp_two]
    simp [PlaceSurf.flip]
  constructor
  · intro hall
    have a0 := hall 0
    have a1 := hall 1
    have a2 := hall 2
    rw [h0] at a0
    rw [h1] at a1
    rw [h2] at a2
    intro j
    fin_cases j
    · exact a1
    · exact a0
    · exact a2
  · intro hall i
    fin_cases i
    · exact h0 ▸ hall 1
    · exact h1 ▸ hall 0
    · exact h2 ▸ hall 2

/-- The prime of a curve on the surface at a point of the model is not the maximal ideal of the point. -/
theorem IsCurveOnSurface.not_isMaximal_centre {S : Specialization (AJ E G) (AJ E C)}
    (h : IsCurveOnSurface G C S) (hc : ∀ j, coordinate E G j ≠ 0)
    (htr : ∃ j, Transcendental E (coordinate E C j)) (q : SurfacePoint G) (hq : q.On S) :
    ¬(centre (AJ E G) S.val hq).IsMaximal := by
  intro hmax
  have hloc := q.isLocalRing
  obtain ⟨φ, hφ⟩ := q.residue
  have hlt : ∀ a : q.ring, ¬IsUnit a → S.val (a : AJ E G) < 1 := fun a ha => by
    have h1 : a ∈ centre (AJ E G) S.val hq := by
      rw [IsLocalRing.eq_maximalIdeal hmax]
      exact ha
    exact h1
  have hU : ∀ a ∈ (q.ring : Set (AJ E G)), a⁻¹ ∈ {y : AJ E G | S.val y ≤ 1} →
      a⁻¹ ∈ (q.ring : Set (AJ E G)) := by
    intro a ha hinv
    by_cases ha0 : a = 0
    · rw [ha0, inv_zero]
      exact q.ring.zero_mem
    · have hva : S.val a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha0
      have h1 : S.val a⁻¹ ≤ 1 := hinv
      rw [map_inv₀, inv_le_one₀ (zero_lt_iff.mpr hva)] at h1
      have hunit : IsUnit (⟨a, ha⟩ : q.ring) := by
        by_contra hnu
        exact absurd (hlt ⟨a, ha⟩ hnu) (not_lt.mpr h1)
      obtain ⟨u, hu⟩ := hunit
      have h2 : ((↑u⁻¹ : q.ring) : AJ E G) * a = 1 := by
        have h3 := congrArg (Subtype.val : q.ring → AJ E G) (Units.inv_mul u)
        rwa [hu] at h3
      rw [← eq_inv_of_mul_eq_one_left h2]
      exact (↑u⁻¹ : q.ring).2
  have hx : ∀ j, coordinate E G j ∈ {y : AJ E G | S.val y ≤ 1} := fun j =>
    (Valuation.mem_valuationSubring_iff _ _).mp (h (MvPolynomial.X j)).1
  have hO : ∀ i, lmono (coordinate E G)
      (chartExp q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2 i) ∈ (q.ring : Set (AJ E G)) := fun i =>
    q.chartOf_spec.1 (Surf.chart_le_normalChart (Algebra.subset_adjoin ⟨i, rfl⟩))
  have hmem : ∀ j, coordinate E G j ∈ (q.ring : Set (AJ E G)) :=
    (Surf.lmono_affine_mem _ _).mp fun i =>
      PlaceSurf.chart_overlap (coordinate E G) hc q.ring.one_mem
        (fun a ha b hb => q.ring.mul_mem ha hb) hU _ _ _ false false false hO
        ((Surf.lmono_affine_mem _ _).mpr hx) i
  obtain ⟨j, hj⟩ := htr
  have hb : ¬IsUnit ((⟨coordinate E G j, hmem j⟩ : q.ring) -
      algebraMap E q.ring (φ ⟨coordinate E G j, hmem j⟩)) :=
    (hφ _).mp (by rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self_apply, sub_self])
  have h2 := hlt _ hb
  have h3 : S.val (BR E G (MvPolynomial.X j -
      MvPolynomial.C (φ ⟨coordinate E G j, hmem j⟩))) < 1 := by
    rw [map_sub, show BR E G (MvPolynomial.X j) = coordinate E G j from rfl,
      show BR E G (MvPolynomial.C (φ ⟨coordinate E G j, hmem j⟩)) =
        algebraMap E (AJ E G) (φ ⟨coordinate E G j, hmem j⟩) from (BR E G).commutes _]
    exact h2
  obtain ⟨hm, hres⟩ := h (MvPolynomial.X j - MvPolynomial.C (φ ⟨coordinate E G j, hmem j⟩))
  rw [(S.res_eq_zero_iff ⟨_, hm⟩).mpr h3, map_sub,
    show BR E C (MvPolynomial.X j) = coordinate E C j from rfl,
    show BR E C (MvPolynomial.C (φ ⟨coordinate E G j, hmem j⟩)) =
      algebraMap E (AJ E C) (φ ⟨coordinate E G j, hmem j⟩) from (BR E C).commutes _] at hres
  exact hj ((sub_eq_zero.mp hres.symm) ▸ isAlgebraic_algebraMap _)

end

end ProximityPrize.SubmissionLower.FormalR
end
