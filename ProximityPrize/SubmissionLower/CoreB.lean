/-!
Restriction to a curve: a function on the carrier that is integral over a chart ring has no pole at a
valuation of a curve `C` of the carrier that is centred in the chart, provided the function is defined at
the generic point of `C`. No regularity of the carrier along `C` is used.

`resGraph f g`, for ring homomorphisms `f : R →+* S` and `g : R →+* U` into fields with `ker f ⊆ ker g`, is
the local ring of `f R` at the prime `f (ker g)` together with its residue map, as the subring of `S × U` of
the pairs `(f a / f b, g a / g b)`. For the carrier, `f = sliceProj F₀` and `g = CT.GP phi C`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero MvPolynomial HFree6812
open RCN002 RCN095 RCN136 RCN204

noncomputable section

section Graph

variable {R S U : Type*} [CommRing R] [Field S] [Field U]

/-- The pairs `(f a / f b, g a / g b)` with `f b ≠ 0` and `g b ≠ 0`. -/
def resGraph (f : R →+* S) (g : R →+* U) : Subring (S × U) where
  carrier := {p | ∃ a b : R, f b ≠ 0 ∧ g b ≠ 0 ∧ p = (f a / f b, g a / g b)}
  mul_mem' := by
    rintro _ _ ⟨a, b, hb, hb', rfl⟩ ⟨c, d, hd, hd', rfl⟩
    exact ⟨a * c, b * d, by rw [map_mul]; exact mul_ne_zero hb hd,
      by rw [map_mul]; exact mul_ne_zero hb' hd',
      by rw [Prod.mk_mul_mk, map_mul, map_mul, map_mul, map_mul, div_mul_div_comm, div_mul_div_comm]⟩
  one_mem' := ⟨1, 1, by rw [map_one]; exact one_ne_zero, by rw [map_one]; exact one_ne_zero,
    by rw [map_one, map_one, div_one, div_one]; rfl⟩
  add_mem' := by
    rintro _ _ ⟨a, b, hb, hb', rfl⟩ ⟨c, d, hd, hd', rfl⟩
    refine ⟨a * d + b * c, b * d, by rw [map_mul]; exact mul_ne_zero hb hd,
      by rw [map_mul]; exact mul_ne_zero hb' hd', ?_⟩
    rw [Prod.mk_add_mk, div_add_div _ _ hb hd, div_add_div _ _ hb' hd']
    simp only [map_add, map_mul]
  zero_mem' := ⟨0, 1, by rw [map_one]; exact one_ne_zero, by rw [map_one]; exact one_ne_zero,
    by rw [map_zero, map_zero, zero_div, zero_div]; rfl⟩
  neg_mem' := by
    rintro _ ⟨a, b, hb, hb', rfl⟩
    exact ⟨-a, b, hb, hb', by rw [Prod.neg_mk, map_neg, map_neg, neg_div, neg_div]⟩

variable {f : R →+* S} {g : R →+* U}

theorem mem_resGraph (hfg : ∀ a, f a = 0 → g a = 0) (a b : R) (hb : g b ≠ 0) :
    (f a / f b, g a / g b) ∈ resGraph f g :=
  ⟨a, b, fun h => hb (hfg b h), hb, rfl⟩

/-- `resGraph` is the graph of a map: the second component is determined by the first. -/
theorem resGraph_snd_eq_zero (hfg : ∀ a, f a = 0 → g a = 0) {y : U}
    (h : ((0 : S), y) ∈ resGraph f g) : y = 0 := by
  obtain ⟨a, b, hb, -, h⟩ := h
  rw [Prod.mk.injEq] at h
  have ha : f a = 0 := by
    have h1 := h.1.symm
    rwa [div_eq_zero_iff, or_iff_left hb] at h1
  rw [h.2, hfg a ha, zero_div]

theorem zpow_mem_resGraph (hfg : ∀ a, f a = 0 → g a = 0) (q : R) (n : ℤ) (hn : n < 0 → g q ≠ 0) :
    (f q ^ n, g q ^ n) ∈ resGraph f g := by
  have h1 : (f q, g q) ∈ resGraph f g := by
    simpa only [map_one, div_one] using mem_resGraph hfg q 1 (by rw [map_one]; exact one_ne_zero)
  obtain ⟨k, rfl | rfl⟩ := n.eq_nat_or_neg
  · simpa only [zpow_natCast, Prod.pow_mk] using pow_mem h1 k
  · rcases Nat.eq_zero_or_pos k with rfl | hk
    · simpa only [Nat.cast_zero, neg_zero, zpow_zero, Prod.mk_one_one] using (resGraph f g).one_mem
    · have h2 := mem_resGraph hfg 1 q (hn (by omega))
      simp only [map_one, one_div] at h2
      simpa only [zpow_neg, zpow_natCast, inv_pow, Prod.pow_mk] using pow_mem h2 k

/-- Integrality passes to the residue: if every element of `A` has a residue of value at most 1, then an
element of the local ring that is integral over `A` has a residue of value at most 1. -/
theorem le_one_of_isIntegral_resGraph (hfg : ∀ a, f a = 0 → g a = 0) {A Γ : Type*} [CommRing A]
    [Algebra A S] [LinearOrderedCommGroupWithZero Γ] (nu : Valuation U Γ)
    (hA : ∀ a : A, ∃ b, (algebraMap A S a, b) ∈ resGraph f g ∧ nu b ≤ 1) {x : S} {y : U}
    (hxy : (x, y) ∈ resGraph f g) (hx : IsIntegral A x) : nu y ≤ 1 := by
  by_contra hlt
  rw [not_le] at hlt
  obtain ⟨p, hp, hpx⟩ := hx
  rw [hp.as_sum, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum] at hpx
  have hy0 : 0 < nu y := zero_lt_one.trans hlt
  obtain ⟨y', hy', hlt'⟩ : ∃ y', (∑ i ∈ Finset.range p.natDegree,
      Polynomial.eval₂ (algebraMap A S) x (Polynomial.C (p.coeff i) * Polynomial.X ^ i), y') ∈
        resGraph f g ∧ nu y' < nu y ^ p.natDegree := by
    refine Finset.sum_induction _
      (fun s => ∃ y', (s, y') ∈ resGraph f g ∧ nu y' < nu y ^ p.natDegree) ?_ ?_ ?_
    · rintro s t ⟨b, hb, hb1⟩ ⟨c, hc, hc1⟩
      exact ⟨b + c, add_mem hb hc, nu.map_add_lt hb1 hc1⟩
    · exact ⟨0, zero_mem _, by rw [map_zero]; exact pow_pos hy0 _⟩
    · intro i hi
      obtain ⟨b, hb, hb1⟩ := hA (p.coeff i)
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
      refine ⟨b * y ^ i, ?_, ?_⟩
      · simpa only [Prod.mk_mul_mk, Prod.pow_mk] using mul_mem hb (pow_mem hxy i)
      · rw [map_mul, map_pow]
        exact lt_of_le_of_lt (mul_le_of_le_one_left' hb1)
          (pow_lt_pow_right₀ hlt (Finset.mem_range.1 hi))
  have hsum := add_mem (pow_mem hxy p.natDegree) hy'
  rw [Prod.pow_mk, Prod.mk_add_mk, hpx] at hsum
  have hz := resGraph_snd_eq_zero hfg hsum
  have h1 : nu y ^ p.natDegree = nu y' := by
    rw [← map_pow, eq_neg_of_add_eq_zero_left hz, Valuation.map_neg]
  rw [h1] at hlt'
  exact lt_irrefl _ hlt'

end Graph

variable {K E : Type} [Field K] [Field E]

section Carrier

variable {F₀ : MvPolynomial (Fin 4) K} [Fact (Irreducible F₀)] {phi : Polynomial K →+* E}
  {C : Ideal (MvPolynomial (Fin 3) E)} [C.IsPrime]

omit [Fact (Irreducible F₀)] in
theorem GP_eq_zero_of_sliceProj (hFC : surfaceMap phi F₀ ∈ C) (a : MvPolynomial (Fin 4) K)
    (ha : sliceProj F₀ a = 0) : CT.GP phi C a = 0 := by
  obtain ⟨c, rfl⟩ := (BMJ F₀ a).1 ha
  have h0 : CT.GP phi C F₀ = 0 := (CT.AAE C _).2 hFC
  rw [map_mul, h0, zero_mul]

theorem GP_X_succ (phi : Polynomial K →+* E) (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime]
    (j : Fin 3) : CT.GP phi C (MvPolynomial.X j.succ) = coordinate E C j := by
  change BR E C (surfaceMap phi (MvPolynomial.X j.succ)) = BR E C (MvPolynomial.X j)
  rw [AMP]

theorem lmono_mem_resGraph (hFC : surfaceMap phi F₀ ∈ C) (a : Fin 3 → ℤ)
    (ha : ∀ j, a j < 0 → coordinate E C j ≠ 0) :
    (lmono (sliceCoord F₀) a, lmono (coordinate E C) a) ∈
      resGraph (sliceProj F₀) (CT.GP phi C) := by
  have h : ∀ j : Fin 3, (sliceCoord F₀ j ^ a j, coordinate E C j ^ a j) ∈
      resGraph (sliceProj F₀) (CT.GP phi C) := fun j => by
    have h1 := zpow_mem_resGraph (GP_eq_zero_of_sliceProj hFC) (MvPolynomial.X j.succ) (a j)
      (by rw [GP_X_succ]; exact ha j)
    rwa [GP_X_succ] at h1
  simpa only [lmono, Prod.mk_mul_mk] using mul_mem (mul_mem (h 0) (h 1)) (h 2)

theorem GP_aeval_X0 (phi : Polynomial K →+* E) (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime]
    (p : Polynomial K) :
    CT.GP phi C (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 4) K) p) =
      algebraMap E (AJ E C) (phi p) := by
  have h : (CT.GP phi C).comp
      (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 4) K)).toRingHom =
      (algebraMap E (AJ E C)).comp phi := by
    apply Polynomial.ringHom_ext
    · intro a
      simp [CT.GP, HJ]
    · simp [CT.GP, HJ]
  exact RingHom.congr_fun h p

theorem sliceProj_aeval_X0 (F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (p : Polynomial K) :
    sliceProj F₀ (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 4) K) p) =
      Polynomial.aeval (sliceProj F₀ (MvPolynomial.X 0)) p := by
  have h : (sliceProj F₀).comp (algebraMap K (MvPolynomial (Fin 4) K)) =
      algebraMap K (SliceField F₀) :=
    RingHom.ext fun a => by rw [RingHom.comp_apply, MvPolynomial.algebraMap_eq, sliceProj_C]
  rw [Polynomial.aeval_def, Polynomial.hom_eval₂, h, Polynomial.aeval_def]

end Carrier

/-- The contract `ResPlaceLeOne` for a curve `C` of the carrier on which the coordinates in the
denominators of the chart coordinates do not vanish identically. -/
theorem res_place_le_one (F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (sR sY sZ : Bool)
    (phi : Polynomial K →+* E) (hphi : Function.Injective phi)
    (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (hFC : surfaceMap phi F₀ ∈ C)
    (hcoord : ∀ i j, chartExp sR sY sZ i j < 0 → coordinate E C j ≠ 0) :
    ResPlaceLeOne F₀ sR sY sZ phi C := by
  intro num den hden hint nu hnuE hnu
  have hfg := GP_eq_zero_of_sliceProj (F₀ := F₀) hFC
  have hA : ∀ a ∈ chartRing F₀ sR sY sZ,
      ∃ b, (a, b) ∈ resGraph (sliceProj F₀) (CT.GP phi C) ∧ nu b ≤ 1 := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact ⟨_, lmono_mem_resGraph hFC _ (hcoord i), hnu i⟩
    | algebraMap r =>
      obtain ⟨p, q, hr⟩ := (IntermediateField.mem_adjoin_simple_iff K (r : SliceField F₀)).1 r.2
      change ∃ b, ((r : SliceField F₀), b) ∈ resGraph (sliceProj F₀) (CT.GP phi C) ∧ nu b ≤ 1
      rw [hr, ← sliceProj_aeval_X0, ← sliceProj_aeval_X0]
      by_cases hq : phi q = 0
      · have hq0 : q = 0 := hphi (by rw [hq, map_zero])
        subst hq0
        refine ⟨0, ?_, by rw [map_zero]; exact zero_le⟩
        simpa only [map_zero, div_zero, Prod.mk_zero_zero] using
          (resGraph (sliceProj F₀) (CT.GP phi C)).zero_mem
      · have hq' : CT.GP phi C (Polynomial.aeval (MvPolynomial.X 0) q) ≠ 0 := by
          rw [GP_aeval_X0]
          exact (map_ne_zero _).2 hq
        refine ⟨_, mem_resGraph hfg _ _ hq', ?_⟩
        rw [GP_aeval_X0, GP_aeval_X0, ← map_div₀]
        exact hnuE _
    | add x y _ _ hx hy =>
      obtain ⟨b, hb, hb1⟩ := hx
      obtain ⟨c, hc, hc1⟩ := hy
      exact ⟨b + c, add_mem hb hc, nu.map_add_le hb1 hc1⟩
    | mul x y _ _ hx hy =>
      obtain ⟨b, hb, hb1⟩ := hx
      obtain ⟨c, hc, hc1⟩ := hy
      exact ⟨b * c, mul_mem hb hc, by rw [map_mul]; exact mul_le_one' hb1 hc1⟩
  exact le_one_of_isIntegral_resGraph hfg nu (fun a => hA a.1 a.2) (mem_resGraph hfg num den hden) hint

section Select

variable {L : Type*} [Field L]

theorem chartExp_neg (sR sY sZ : Bool) (i j : Fin 3) (h : chartExp sR sY sZ i j < 0) :
    (j = 0 ∧ sY = true) ∨ (j = 1 ∧ sR = true) ∨ (j = 2 ∧ sZ = true) := by
  revert sR sY sZ i j
  decide

theorem vertexExp_nonneg (sR sY sZ : Bool) (W : FlagDegree) (j : Fin 3) :
    0 ≤ vertexExp sR sY sZ W j := by
  rcases sR with _ | _ <;> rcases sY with _ | _ <;> rcases sZ with _ | _ <;> fin_cases j <;>
    simp [vertexExp] <;> omega

theorem vertexExp_ne_zero (sR sY sZ : Bool) (W : FlagDegree) (j : Fin 3)
    (h : vertexExp sR sY sZ W j ≠ 0) :
    (j = 0 ∧ sY = true) ∨ (j = 1 ∧ sR = true) ∨ (j = 2 ∧ sZ = true) := by
  rcases sR with _ | _ <;> rcases sY with _ | _ <;> rcases sZ with _ | _ <;> fin_cases j <;>
    simp [vertexExp] at h ⊢

/-- The chart of a valuation, for coordinates that may vanish (a vanishing
coordinate counts as a coordinate without pole): no vanishing coordinate is inverted, the valuation is at
most 1 on the three chart coordinates, and the vertex monomial of every flag has the pole `flagPole`. -/
theorem chart_select (v : Valuation L ℤᵐ⁰) (x : Fin 3 → L) :
    ∃ sR sY sZ : Bool, (sR = true → x 1 ≠ 0) ∧ (sY = true → x 0 ≠ 0) ∧ (sZ = true → x 2 ≠ 0) ∧
      (∀ i, v (lmono x (chartExp sR sY sZ i)) ≤ 1) ∧
      ∀ W, v (lmono x (vertexExp sR sY sZ W)) = exp (flagPole v x W) := by
  classical
  let x' : Fin 3 → L := fun j => if x j = 0 then 1 else x j
  have hx'0 : ∀ j, x j = 0 → x' j = 1 := fun j h => ite_eq_left_iff.2 fun hn => absurd h hn
  have hx'1 : ∀ j, x j ≠ 0 → x' j = x j := fun j h => ite_eq_right_iff.2 fun hp => absurd hp h
  have hx' : ∀ j, x' j ≠ 0 := fun j => by
    by_cases h : x j = 0
    · rw [hx'0 j h]; exact one_ne_zero
    · rw [hx'1 j h]; exact h
  have hlog : ∀ j, (v (x' j)).log = (v (x j)).log := fun j => by
    by_cases h : x j = 0
    · rw [hx'0 j h, h, map_one, map_zero, log_one, log_zero]
    · rw [hx'1 j h]
  have hpole : ∀ W, flagPole v x' W = flagPole v x W := fun W => by
    simp only [flagPole, RCN187.poleOrder, hlog]
  have hmono_eq : ∀ a : Fin 3 → ℤ, (∀ j, a j ≠ 0 → x j ≠ 0) → lmono x a = lmono x' a := by
    intro a ha
    have h : ∀ j, x j ^ a j = x' j ^ a j := fun j => by
      by_cases hj : x j = 0
      · have h0 : a j = 0 := by
          by_contra h
          exact ha j h hj
        rw [h0, zpow_zero, zpow_zero]
      · rw [hx'1 j hj]
    rw [lmono, lmono, h 0, h 1, h 2]
  have hmono_le : ∀ a : Fin 3 → ℤ, (∀ j, a j < 0 → x j ≠ 0) → v (lmono x a) ≤ v (lmono x' a) := by
    intro a ha
    by_cases h : ∀ j, a j ≠ 0 → x j ≠ 0
    · rw [hmono_eq a h]
    · obtain ⟨j, hj⟩ := not_forall.1 h
      obtain ⟨hj, hxj⟩ := Classical.not_imp.1 hj
      rw [not_not] at hxj
      have hz : x j ^ a j = 0 := by rw [hxj, zero_zpow _ hj]
      have h0 : lmono x a = 0 := by
        rw [lmono]
        fin_cases j
        · rw [show x 0 ^ a 0 = 0 from hz, zero_mul, zero_mul]
        · rw [show x 1 ^ a 1 = 0 from hz, mul_zero, zero_mul]
        · rw [show x 2 ^ a 2 = 0 from hz, mul_zero]
      rw [h0, map_zero]
      exact zero_le
  have key : ∀ sR sY sZ : Bool,
      (∀ i : Fin 3, chartExp sR sY sZ i 0 * (v (x 0)).log + chartExp sR sY sZ i 1 * (v (x 1)).log +
        chartExp sR sY sZ i 2 * (v (x 2)).log ≤ 0) →
      (sR = true → x 1 ≠ 0) → (sY = true → x 0 ≠ 0) → (sZ = true → x 2 ≠ 0) →
      ∃ sR sY sZ : Bool, (sR = true → x 1 ≠ 0) ∧ (sY = true → x 0 ≠ 0) ∧ (sZ = true → x 2 ≠ 0) ∧
        (∀ i, v (lmono x (chartExp sR sY sZ i)) ≤ 1) ∧
        ∀ W, v (lmono x (vertexExp sR sY sZ W)) = exp (flagPole v x W) := by
    intro sR sY sZ h hR hY hZ
    have hbit : ∀ j : Fin 3, (j = 0 ∧ sY = true) ∨ (j = 1 ∧ sR = true) ∨ (j = 2 ∧ sZ = true) →
        x j ≠ 0 := by
      rintro j (⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, h⟩)
      exacts [hY h, hR h, hZ h]
    have h' : ∀ i, v (lmono x' (chartExp sR sY sZ i)) ≤ 1 := fun i => by
      rw [lmono_le_one_iff v x' hx', hlog, hlog, hlog]
      exact h i
    refine ⟨sR, sY, sZ, hR, hY, hZ, fun i => (hmono_le _ fun j hj =>
      hbit j (chartExp_neg sR sY sZ i j hj)).trans (h' i), fun W => ?_⟩
    rw [hmono_eq _ fun j hj => hbit j (vertexExp_ne_zero sR sY sZ W j hj),
      flagPole_eq_vertex v x' hx' sR sY sZ h' W, hpole]
  have hl : ∀ j, x j = 0 → (v (x j)).log = 0 := fun j h => by rw [h, map_zero, log_zero]
  have hl0 := hl 0
  have hl1 := hl 1
  have hl2 := hl 2
  generalize (v (x 0)).log = l0 at key hl0
  generalize (v (x 1)).log = l1 at key hl1
  generalize (v (x 2)).log = l2 at key hl2
  by_cases hZ : l2 ≤ 0
  · by_cases hY : l0 ≤ 0
    · by_cases hR : l1 ≤ 0
      · exact key false false false (by intro i; fin_cases i <;> simp [chartExp] <;> omega)
          nofun nofun nofun
      · exact key true false false (by intro i; fin_cases i <;> simp [chartExp] <;> omega)
          (fun _ hx => hR (hl1 hx).le) nofun nofun
    · by_cases hR : l1 ≤ l0
      · exact key false true false (by intro i; fin_cases i <;> simp [chartExp] <;> omega)
          nofun (fun _ hx => hY (hl0 hx).le) nofun
      · exact key true true false (by intro i; fin_cases i <;> simp [chartExp] <;> omega)
          (fun _ hx => hR (by have := hl1 hx; omega)) (fun _ hx => hY (hl0 hx).le) nofun
  · by_cases hY : l0 ≤ l2
    · by_cases hR : l1 ≤ l2
      · exact key false false true (by intro i; fin_cases i <;> simp [chartExp] <;> omega)
          nofun nofun (fun _ hx => hZ (hl2 hx).le)
      · exact key true false true (by intro i; fin_cases i <;> simp [chartExp] <;> omega)
          (fun _ hx => hR (by have := hl1 hx; omega)) nofun (fun _ hx => hZ (hl2 hx).le)
    · by_cases hR : l1 ≤ l0
      · exact key false true true (by intro i; fin_cases i <;> simp [chartExp] <;> omega)
          nofun (fun _ hx => hY (by have := hl0 hx; omega)) (fun _ hx => hZ (hl2 hx).le)
      · exact key true true true (by intro i; fin_cases i <;> simp [chartExp] <;> omega)
          (fun _ hx => hR (by have := hl1 hx; omega)) (fun _ hx => hY (by have := hl0 hx; omega))
          (fun _ hx => hZ (hl2 hx).le)

end Select

/-- A monomial with exponents `a ≥ 0` in the last three variables is the Laurent monomial `lmono` of the
images of these variables. -/
theorem map_mono_eq_lmono {L : Type*} [Field L] (f : MvPolynomial (Fin 4) K →+* L) (a : Fin 3 → ℤ)
    (ha : ∀ j, 0 ≤ a j) :
    f (MvPolynomial.X 1 ^ (a 0).toNat * MvPolynomial.X 2 ^ (a 1).toNat *
        MvPolynomial.X 3 ^ (a 2).toNat) = lmono (fun j : Fin 3 => f (MvPolynomial.X j.succ)) a := by
  have e : ∀ j : Fin 3, f (MvPolynomial.X j.succ) ^ a j = f (MvPolynomial.X j.succ) ^ (a j).toNat :=
    fun j => by
      conv_lhs => rw [← Int.toNat_of_nonneg (ha j)]
      rw [zpow_natCast]
  rw [lmono, e 0, e 1, e 2, map_mul, map_mul, map_pow, map_pow, map_pow]
  rfl

/-- Restriction with the monomial multiplier of the chart: if a function on the carrier, divided by the vertex
monomial of the flag `W`, is integral over each of the eight chart rings, then on a curve `C` of the carrier
on which its denominator does not vanish identically its value at every valuation that is at most 1 on the
constants is at most `exp (flagPole W)`. Coordinates that vanish identically on `C` are allowed. -/
theorem res_le_flagPole (F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (phi : Polynomial K →+* E) (hphi : Function.Injective phi)
    (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (hFC : surfaceMap phi F₀ ∈ C)
    (num den : MvPolynomial (Fin 4) K) (hden : CT.GP phi C den ≠ 0) (W : FlagDegree)
    (hint : ∀ sR sY sZ : Bool, IsIntegral (chartRing F₀ sR sY sZ)
      (sliceProj F₀ num / sliceProj F₀ den / lmono (sliceCoord F₀) (vertexExp sR sY sZ W)))
    (nu : Valuation (AJ E C) ℤᵐ⁰) (hnuE : ∀ a : E, nu (algebraMap E (AJ E C) a) ≤ 1) :
    nu (CT.GP phi C num / CT.GP phi C den) ≤ exp (flagPole nu (coordinate E C) W) := by
  obtain ⟨sR, sY, sZ, hR, hY, hZ, hchart, hvert⟩ := chart_select nu (coordinate E C)
  have hcoord : ∀ i j, chartExp sR sY sZ i j < 0 → coordinate E C j ≠ 0 := fun i j h => by
    rcases chartExp_neg sR sY sZ i j h with ⟨rfl, hb⟩ | ⟨rfl, hb⟩ | ⟨rfl, hb⟩
    exacts [hY hb, hR hb, hZ hb]
  have ha0 := vertexExp_nonneg sR sY sZ W
  obtain ⟨mono, hs, hc⟩ : ∃ mono : MvPolynomial (Fin 4) K,
      sliceProj F₀ mono = lmono (sliceCoord F₀) (vertexExp sR sY sZ W) ∧
      CT.GP phi C mono = lmono (coordinate E C) (vertexExp sR sY sZ W) :=
    ⟨_, map_mono_eq_lmono (sliceProj F₀) _ ha0, (map_mono_eq_lmono (CT.GP phi C) _ ha0).trans
      (congrArg (fun y => lmono y (vertexExp sR sY sZ W)) (funext (GP_X_succ phi C)))⟩
  have hm0 : lmono (coordinate E C) (vertexExp sR sY sZ W) ≠ 0 := fun h => by
    have h1 := hvert W
    rw [h, map_zero] at h1
    exact exp_ne_zero h1.symm
  have h := res_place_le_one F₀ sR sY sZ phi hphi C hFC hcoord num (den * mono)
    (by rw [map_mul, hc]; exact mul_ne_zero hden hm0)
    (by rw [map_mul, hs, ← div_div]; exact hint sR sY sZ) nu hnuE hchart
  rw [map_mul, hc, ← div_div, map_div₀, hvert W] at h
  exact (div_le_one₀ (zero_lt_iff.2 exp_ne_zero)).1 h

/-- The same as a bound for the pole order. -/
theorem res_pole_le_flagPole (F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (phi : Polynomial K →+* E) (hphi : Function.Injective phi)
    (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (hFC : surfaceMap phi F₀ ∈ C)
    (num den : MvPolynomial (Fin 4) K) (hden : CT.GP phi C den ≠ 0) (W : FlagDegree)
    (hint : ∀ sR sY sZ : Bool, IsIntegral (chartRing F₀ sR sY sZ)
      (sliceProj F₀ num / sliceProj F₀ den / lmono (sliceCoord F₀) (vertexExp sR sY sZ W)))
    (nu : Valuation (AJ E C) ℤᵐ⁰) (hnuE : ∀ a : E, nu (algebraMap E (AJ E C) a) ≤ 1) :
    RCN187.poleOrder nu (CT.GP phi C num / CT.GP phi C den) ≤ flagPole nu (coordinate E C) W := by
  have h := res_le_flagPole F₀ phi hphi C hFC num den hden W hint nu hnuE
  refine max_le (ALZ nu _ W) ?_
  by_cases h0 : nu (CT.GP phi C num / CT.GP phi C den) = 0
  · rw [h0, log_zero]
    exact ALZ nu _ W
  · exact (log_le_iff_le_exp h0).2 h

end

end ProximityPrize.SubmissionLower.FormalR
end
section

/-!
Order bounds at a valuation `v` of `SliceField F₀` that satisfies the place law `PlaceLaw` for `m`, for a flag
`Hf` of `H` (`v H ≤ exp (flagPole Hf)`):

* `tail_cube_bound`: `v (τ_m ^ 3 * H ^ (2 m)) ≤ exp (4 m placeT + flagPole (cutFlag m Hf))`;
* `psiS_bound`: with the divisor inequality of the source,
  `v (Ψ_S(m)) ≤ exp (flagPole (d • cutFlag m Hf + (4 m) • S.flag))`;
* `psiS_integral`: the contract `PsiSIntegral` from the contracts `ChartKrull` and `ChartPlaceLaw`;
* `polyH_flag_le`, `polyH_euler_le`: the flags `⟨z, y, r - 1⟩` and `⟨z, y + 1, r - 2⟩` of `H = ∂F/∂R` for a
  polynomial `F` with exponents in the flag `⟨z, y, r⟩`, the second one on the carrier.

The orders of `H` and of the leading coefficient of the source are signed: `(v H).log` enters with the
coefficient `2 m`, and the pole of `H` is bounded by the flag, the zero of `H` by `placeH` of `PlaceLaw`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero MvPolynomial HFree6812
open RCN095 RCN204 RCN313 RCN187
open BD BX

theorem flagPole_cutFlag {L : Type*} [Field L] (v : Valuation L ℤᵐ⁰) (x : Fin 3 → L) (m : ℕ)
    (Hf : FlagDegree) (h5 : 5 ≤ 2 * Hf.all) :
    flagPole v x (cutFlag m Hf) =
      m * (2 * flagPole v x Hf -
          5 * max (poleOrder v (x 1)) (max (poleOrder v (x 0)) (poleOrder v (x 2)))) +
        3 * max (poleOrder v (x 1)) (max (poleOrder v (x 0)) (poleOrder v (x 2))) := by
  have c : ((2 * Hf.all - 5 : ℕ) : ℤ) = 2 * (Hf.all : ℤ) - 5 := by omega
  rw [cutFlag, flagPole_add, DZP]
  simp only [flagPole]
  rw [c]
  push_cast
  ring

variable {K : Type} [Field K]

theorem tail_cube_bound (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (hH : sliceProj F₀ (polyH K F) ≠ 0) (v : Valuation (SliceField F₀) ℤᵐ⁰) (m : ℕ)
    (hPL : PlaceLaw F F₀ hdvd v m) (Hf : FlagDegree) (h5 : 5 ≤ 2 * Hf.all)
    (hHf : v (sliceProj F₀ (polyH K F)) ≤ exp (flagPole v (sliceCoord F₀) Hf)) :
    v (tail F F₀ hdvd m) ^ 3 * v (sliceProj F₀ (polyH K F)) ^ (2 * m) ≤
      exp (4 * m * placeT F F₀ v + flagPole v (sliceCoord F₀) (cutFlag m Hf)) := by
  set τ := tail F F₀ hdvd m with hτdef
  set Hs := sliceProj F₀ (polyH K F) with hHs
  have hHs0 : v Hs ≠ 0 := (Valuation.ne_zero_iff v).2 hH
  have hHsexp : v Hs = exp (v Hs).log := (exp_log hHs0).symm
  have hτ : v τ ≤ exp (vpole v τ) := AQZ v τ
  have hq : (v Hs).log ≤ flagPole v (sliceCoord F₀) Hf := by
    rw [hHsexp, exp_le_exp] at hHf
    exact hHf
  have hq0 := ALZ v (sliceCoord F₀) Hf
  have hh : placeH F F₀ v = max 0 (-(v Hs).log) := rfl
  have hα : placeP F₀ v = max (poleOrder v (sliceCoord F₀ 1))
      (max (poleOrder v (sliceCoord F₀ 0)) (poleOrder v (sliceCoord F₀ 2))) := rfl
  calc v τ ^ 3 * v Hs ^ (2 * m) ≤ exp (vpole v τ) ^ 3 * exp (v Hs).log ^ (2 * m) := by
        rw [← hHsexp]
        exact mul_le_mul' (pow_le_pow_left' hτ 3) le_rfl
    _ = exp (3 * vpole v τ + 2 * m * (v Hs).log) := by
        rw [← exp_nsmul, ← exp_nsmul, ← exp_add]
        simp only [nsmul_eq_mul]
        push_cast
        rfl
    _ ≤ _ := by
        rw [exp_le_exp, flagPole_cutFlag v _ m Hf h5, ← hα]
        unfold PlaceLaw at hPL
        rw [hh, ← hτdef] at hPL
        have hmax : max 0 (-(v Hs).log) + (v Hs).log ≤ flagPole v (sliceCoord F₀) Hf := by
          rcases le_total 0 (-(v Hs).log) with h | h
          · rw [max_eq_right h]; linarith
          · rw [max_eq_left h]; linarith
        have hm : (0 : ℤ) ≤ m := Nat.cast_nonneg m
        nlinarith [mul_le_mul_of_nonneg_left hmax hm]

theorem psiS_bound (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (hH : sliceProj F₀ (polyH K F) ≠ 0) (h2 : (2 : K) ≠ 0) (S : Source F)
    (hfact : (S.k.factorial : K) ≠ 0) (v : Valuation (SliceField F₀) ℤᵐ⁰)
    (hK : ∀ a : K, a ≠ 0 → v (algebraMap K (SliceField F₀) a) = 1)
    (hX0 : v (sliceProj F₀ (MvPolynomial.X 0)) ≤ 1) (hlead : srcLead F F₀ S ≠ 0) (m : ℕ)
    (hPL : PlaceLaw F F₀ hdvd v m) (Hf : FlagDegree) (h5 : 5 ≤ 2 * Hf.all)
    (hHf : v (sliceProj F₀ (polyH K F)) ≤ exp (flagPole v (sliceCoord F₀) Hf)) :
    v (psiS F F₀ hdvd S m) ≤
      exp (flagPole v (sliceCoord F₀) (S.d • cutFlag m Hf + (4 * m) • S.flag)) := by
  have h1 := tail_cube_bound F F₀ hdvd hH v m hPL Hf h5 hHf
  have hN : (S.d : ℤ) * placeT F F₀ v + (v (srcLead F F₀ S)).log ≤ flagPole v (sliceCoord F₀) S.flag :=
    source_place_bound F F₀ hdvd hH h2 S hfact v hK hX0 hlead
  have hc0 : v (srcLead F F₀ S) ≠ 0 := (Valuation.ne_zero_iff v).2 hlead
  have hcexp : v (srcLead F F₀ S) = exp (v (srcLead F F₀ S)).log := (exp_log hc0).symm
  have e1 : v (tail F F₀ hdvd m) ^ (3 * S.d) * v (sliceProj F₀ (polyH K F)) ^ (2 * m * S.d) =
      (v (tail F F₀ hdvd m) ^ 3 * v (sliceProj F₀ (polyH K F)) ^ (2 * m)) ^ S.d := by
    rw [mul_pow, ← pow_mul, ← pow_mul]
  rw [psiS, map_mul, map_mul, map_pow, map_pow, map_pow, e1]
  calc (v (tail F F₀ hdvd m) ^ 3 * v (sliceProj F₀ (polyH K F)) ^ (2 * m)) ^ S.d *
        v (srcLead F F₀ S) ^ (4 * m)
      ≤ exp (4 * m * placeT F F₀ v + flagPole v (sliceCoord F₀) (cutFlag m Hf)) ^ S.d *
        exp (v (srcLead F F₀ S)).log ^ (4 * m) := by
        rw [← hcexp]
        exact mul_le_mul' (pow_le_pow_left' h1 _) le_rfl
    _ = exp (S.d * (4 * m * placeT F F₀ v + flagPole v (sliceCoord F₀) (cutFlag m Hf)) +
        4 * m * (v (srcLead F F₀ S)).log) := by
        rw [← exp_nsmul, ← exp_nsmul, ← exp_add]
        simp only [nsmul_eq_mul]
        push_cast
        rfl
    _ ≤ _ := by
        rw [exp_le_exp, flagPole_add, DZP, DZP]
        have hm : (0 : ℤ) ≤ 4 * m := by positivity
        push_cast
        nlinarith [mul_le_mul_of_nonneg_left hN hm]

theorem psiS_div_vertex_le_one (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (hdvd : F₀ ∣ F) (hH : sliceProj F₀ (polyH K F) ≠ 0) (h2 : (2 : K) ≠ 0) (S : Source F)
    (hfact : (S.k.factorial : K) ≠ 0) (v : Valuation (SliceField F₀) ℤᵐ⁰)
    (hK : ∀ a : K, a ≠ 0 → v (algebraMap K (SliceField F₀) a) = 1)
    (hX0 : v (sliceProj F₀ (MvPolynomial.X 0)) ≤ 1) (hlead : srcLead F F₀ S ≠ 0) (m : ℕ)
    (hPL : PlaceLaw F F₀ hdvd v m) (Hf : FlagDegree) (h5 : 5 ≤ 2 * Hf.all)
    (hHf : v (sliceProj F₀ (polyH K F)) ≤ exp (flagPole v (sliceCoord F₀) Hf))
    (sR sY sZ : Bool) (hc : ∀ j, sliceCoord F₀ j ≠ 0)
    (hchart : ∀ i, v (lmono (sliceCoord F₀) (chartExp sR sY sZ i)) ≤ 1) :
    v (psiS F F₀ hdvd S m /
      lmono (sliceCoord F₀) (vertexExp sR sY sZ (S.d • cutFlag m Hf + (4 * m) • S.flag))) ≤ 1 := by
  rw [map_div₀, flagPole_eq_vertex v _ hc sR sY sZ hchart]
  exact (div_le_one₀ (zero_lt_iff.2 exp_ne_zero)).2
    (psiS_bound F F₀ hdvd hH h2 S hfact v hK hX0 hlead m hPL Hf h5 hHf)

/-- The contract `PsiSIntegral` from `ChartKrull` and `ChartPlaceLaw`. -/
theorem psiS_integral (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (hdvd : F₀ ∣ F) (hH : sliceProj F₀ (polyH K F) ≠ 0) (h2 : (2 : K) ≠ 0) (S : Source F)
    (hfact : (S.k.factorial : K) ≠ 0) (hlead : srcLead F F₀ S ≠ 0) (hc : ∀ j, sliceCoord F₀ j ≠ 0)
    (Hf : FlagDegree) (h5 : 5 ≤ 2 * Hf.all)
    (hHf : ∀ w : Valuation (SliceField F₀) ℤᵐ⁰,
      (∀ a : K, a ≠ 0 → w (algebraMap K (SliceField F₀) a) = 1) →
      w (sliceProj F₀ (MvPolynomial.X 0)) ≤ 1 →
      w (sliceProj F₀ (polyH K F)) ≤ exp (flagPole w (sliceCoord F₀) Hf))
    (sR sY sZ : Bool) (hKr : ChartKrull F₀ sR sY sZ) (hPL : ChartPlaceLaw F F₀ hdvd sR sY sZ) :
    PsiSIntegral F F₀ hdvd S Hf sR sY sZ :=
  fun m => hKr _ fun w hw =>
    psiS_div_vertex_le_one F F₀ hdvd hH h2 S hfact w hw.trivial_on_K hw.x0_le_one hlead m
      (hPL w hw m) Hf h5 (hHf w hw.trivial_on_K hw.x0_le_one) sR sY sZ hc hw.coord_le_one

theorem coeff_pderiv_succ {σ : Type*} [DecidableEq σ] (i : σ) (F : MvPolynomial σ K) (e : σ →₀ ℕ) :
    (pderiv i F).coeff e = ((e i + 1 : ℕ) : K) * F.coeff (e + Finsupp.single i 1) := by
  induction F using MvPolynomial.induction_on' with
  | monomial s a =>
    rw [pderiv_monomial, coeff_monomial, coeff_monomial]
    by_cases h : s = e + Finsupp.single i 1
    · subst h
      simp [mul_comm]
    · simp only [h, ↓reduceIte, mul_zero]
      split_ifs with h1
      · have hs : s i = 0 := by
          by_contra hne
          apply h
          rw [← h1]
          ext j
          by_cases hj : j = i
          · subst hj
            simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
              Finsupp.single_eq_same]
            omega
          · simp [Finsupp.single_eq_of_ne hj]
        rw [hs, Nat.cast_zero, mul_zero]
      · rfl
  | add p q hp hq =>
    rw [map_add, AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply,
      Finsupp.add_apply, hp, hq, mul_add]

theorem polyH_flag_le (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (v : Valuation (SliceField F₀) ℤᵐ⁰)
    (hK : ∀ a : K, a ≠ 0 → v (algebraMap K (SliceField F₀) a) = 1)
    (hX0 : v (sliceProj F₀ (MvPolynomial.X 0)) ≤ 1) (z y r : ℕ)
    (hF : ∀ e ∈ F.support, e 2 ≤ r ∧ e 1 + e 2 ≤ r + y ∧ e 1 + e 2 + e 3 ≤ r + y + z) :
    v (sliceProj F₀ (polyH K F)) ≤ exp (flagPole v (sliceCoord F₀) ⟨z, y, r - 1⟩) := by
  classical
  refine sliceProj_flag_le F₀ v hK hX0 (polyH K F) ⟨z, y, r - 1⟩ fun e he => ?_
  have hne : (pderiv (2 : Fin 4) F).coeff e ≠ 0 := MvPolynomial.mem_support_iff.1 he
  rw [coeff_pderiv_succ] at hne
  have hmem : e + Finsupp.single (2 : Fin 4) 1 ∈ F.support :=
    MvPolynomial.mem_support_iff.2 (right_ne_zero_of_mul hne)
  obtain ⟨h1, h2, h3⟩ := hF _ hmem
  have e2 : (e + Finsupp.single (2 : Fin 4) 1 : Fin 4 →₀ ℕ) 2 = e 2 + 1 := by simp
  have e1 : (e + Finsupp.single (2 : Fin 4) 1 : Fin 4 →₀ ℕ) 1 = e 1 := by
    simp [Finsupp.single_eq_of_ne (show (1 : Fin 4) ≠ 2 by decide)]
  have e3 : (e + Finsupp.single (2 : Fin 4) 1 : Fin 4 →₀ ℕ) 3 = e 3 := by
    simp [Finsupp.single_eq_of_ne (show (3 : Fin 4) ≠ 2 by decide)]
  rw [e2] at h1
  rw [e1, e2] at h2
  rw [e1, e2, e3] at h3
  dsimp only
  omega

theorem coeff_X_mul_pderiv {σ : Type*} [DecidableEq σ] (i : σ) (F : MvPolynomial σ K) (e : σ →₀ ℕ) :
    (MvPolynomial.X i * pderiv i F).coeff e = (e i : K) * F.coeff e := by
  induction F using MvPolynomial.induction_on' with
  | monomial s a =>
    rw [MvPolynomial.X_mul_pderiv_monomial, coeff_smul, coeff_monomial]
    split_ifs with h
    · subst h
      rw [nsmul_eq_mul]
    · rw [smul_zero, mul_zero]
  | add p q hp hq =>
    rw [map_add, mul_add, AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply,
      Finsupp.add_apply, hp, hq, mul_add]

/-- The Euler cap: on the carrier, `R * H = r * F - (r * F - R * ∂F/∂R)`, and the polynomial in brackets
has `R`-degree below `r`. -/
theorem polyH_euler_le (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (v : Valuation (SliceField F₀) ℤᵐ⁰)
    (hK : ∀ a : K, a ≠ 0 → v (algebraMap K (SliceField F₀) a) = 1)
    (hX0 : v (sliceProj F₀ (MvPolynomial.X 0)) ≤ 1) (z y r : ℕ)
    (hF : ∀ e ∈ F.support, e 2 ≤ r ∧ e 1 + e 2 ≤ r + y ∧ e 1 + e 2 + e 3 ≤ r + y + z) :
    v (sliceProj F₀ (polyH K F)) ≤ exp (flagPole v (sliceCoord F₀) ⟨z, y + 1, r - 2⟩) := by
  classical
  have hpY : 0 ≤ poleOrder v (sliceCoord F₀ 0) := vpole_nonneg v _
  have hpR : 0 ≤ poleOrder v (sliceCoord F₀ 1) := vpole_nonneg v _
  have hβ : 0 ≤ max (poleOrder v (sliceCoord F₀ 0)) (poleOrder v (sliceCoord F₀ 2)) :=
    hpY.trans (le_max_left _ _)
  rcases le_or_gt (poleOrder v (sliceCoord F₀ 1))
      (max (poleOrder v (sliceCoord F₀ 0)) (poleOrder v (sliceCoord F₀ 2))) with hcase | hcase
  · refine (polyH_flag_le F F₀ v hK hX0 z y r hF).trans ?_
    rw [exp_le_exp]
    simp only [flagPole, max_eq_right hcase]
    have c : ((r - 1 : ℕ) : ℤ) ≤ ((r - 2 : ℕ) : ℤ) + 1 := by omega
    push_cast
    nlinarith [mul_le_mul_of_nonneg_right c hβ]
  · have hvR : v (sliceCoord F₀ 1) = exp (poleOrder v (sliceCoord F₀ 1)) := by
      have epole : poleOrder v (sliceCoord F₀ 1) = max 0 (v (sliceCoord F₀ 1)).log := rfl
      have hlog : 0 < (v (sliceCoord F₀ 1)).log := by
        by_contra h
        rw [epole, max_eq_left (not_lt.1 h)] at hcase
        exact absurd hβ (not_le.2 hcase)
      have hne : v (sliceCoord F₀ 1) ≠ 0 := fun h0 => by
        rw [h0, log_zero] at hlog
        exact lt_irrefl _ hlog
      rw [epole, max_eq_right hlog.le, exp_log hne]
    have hE := sliceProj_flag_le F₀ v hK hX0
      (C (r : K) * F - MvPolynomial.X 2 * pderiv 2 F) ⟨z, y + 1, r - 1⟩ (fun e he => by
        have hne : (C (r : K) * F - MvPolynomial.X 2 * pderiv 2 F).coeff e ≠ 0 :=
          MvPolynomial.mem_support_iff.1 he
        rw [coeff_sub, coeff_C_mul, coeff_X_mul_pderiv, ← sub_mul] at hne
        have hr : e 2 ≠ r := fun h => hne (by rw [h, sub_self, zero_mul])
        obtain ⟨h1, h2, h3⟩ := hF e (MvPolynomial.mem_support_iff.2 (right_ne_zero_of_mul hne))
        dsimp only
        omega)
    have hval : sliceProj F₀ (C (r : K) * F - MvPolynomial.X 2 * pderiv 2 F) =
        -(sliceCoord F₀ 1 * sliceProj F₀ (polyH K F)) := by
      rw [map_sub, map_mul, (BMJ F₀ F).2 hdvd, mul_zero, zero_sub, map_mul]
      rfl
    rw [hval, Valuation.map_neg, map_mul, hvR] at hE
    have hmul := mul_le_mul_right hE (exp (-poleOrder v (sliceCoord F₀ 1)))
    rw [← mul_assoc, ← exp_add, neg_add_cancel, exp_zero, one_mul, ← exp_add] at hmul
    refine hmul.trans ?_
    rw [exp_le_exp]
    simp only [flagPole, max_eq_left hcase.le]
    have c : ((r - 1 : ℕ) : ℤ) - 1 ≤ ((r - 2 : ℕ) : ℤ) := by omega
    push_cast
    nlinarith [mul_le_mul_of_nonneg_right c hpR]

/-- `PsiSIntegral` for the flag `⟨z, y, r - 1⟩` of `H`. -/
theorem psiS_integral_flag (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (hdvd : F₀ ∣ F) (hH : sliceProj F₀ (polyH K F) ≠ 0) (h2 : (2 : K) ≠ 0) (S : Source F)
    (hfact : (S.k.factorial : K) ≠ 0) (hlead : srcLead F F₀ S ≠ 0) (hc : ∀ j, sliceCoord F₀ j ≠ 0)
    (z y r : ℕ) (hr : 4 ≤ r)
    (hF : ∀ e ∈ F.support, e 2 ≤ r ∧ e 1 + e 2 ≤ r + y ∧ e 1 + e 2 + e 3 ≤ r + y + z)
    (sR sY sZ : Bool) (hKr : ChartKrull F₀ sR sY sZ) (hPL : ChartPlaceLaw F F₀ hdvd sR sY sZ) :
    PsiSIntegral F F₀ hdvd S ⟨z, y, r - 1⟩ sR sY sZ :=
  psiS_integral F F₀ hdvd hH h2 S hfact hlead hc ⟨z, y, r - 1⟩ (by dsimp only; omega)
    (fun w hK hX0 => polyH_flag_le F F₀ w hK hX0 z y r hF) sR sY sZ hKr hPL

/-- `PsiSIntegral` for the Euler flag `⟨z, y + 1, r - 2⟩` of `H`. -/
theorem psiS_integral_euler (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (hdvd : F₀ ∣ F) (hH : sliceProj F₀ (polyH K F) ≠ 0) (h2 : (2 : K) ≠ 0) (S : Source F)
    (hfact : (S.k.factorial : K) ≠ 0) (hlead : srcLead F F₀ S ≠ 0) (hc : ∀ j, sliceCoord F₀ j ≠ 0)
    (z y r : ℕ) (hr : 5 ≤ r)
    (hF : ∀ e ∈ F.support, e 2 ≤ r ∧ e 1 + e 2 ≤ r + y ∧ e 1 + e 2 + e 3 ≤ r + y + z)
    (sR sY sZ : Bool) (hKr : ChartKrull F₀ sR sY sZ) (hPL : ChartPlaceLaw F F₀ hdvd sR sY sZ) :
    PsiSIntegral F F₀ hdvd S ⟨z, y + 1, r - 2⟩ sR sY sZ :=
  psiS_integral F F₀ hdvd hH h2 S hfact hlead hc ⟨z, y + 1, r - 2⟩ (by dsimp only; omega)
    (fun w hK hX0 => polyH_euler_le F F₀ hdvd w hK hX0 z y r hF) sR sY sZ hKr hPL

end ProximityPrize.SubmissionLower.FormalR
end
section

/-!
A prime divisor of a chart has a monomial coordinate with transcendental residue
(`ChartDivisor.exists_unit_coord`).

`ResAlg k w x` says that `x` is integral at the valuation `w` and that its residue is algebraic over the
residues of the subfield `k`, on which `w` is trivial. These elements are closed under the ring operations
and under the inverse of units, so a polynomial in residue-algebraic elements is residue-algebraic.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero MvPolynomial HFree6812

section Residue

/-- `x` is integral at `w` and its residue is a root of a monic polynomial over `k`. -/
def ResAlg (k : Type*) {L : Type*} [Field k] [Field L] [Algebra k L] (w : Valuation L ℤᵐ⁰)
    (x : L) : Prop :=
  w x ≤ 1 ∧ ∃ p : Polynomial k, p.Monic ∧ w (Polynomial.aeval x p) < 1

variable {k L : Type*} [Field k] [Field L] [Algebra k L] (w : Valuation L ℤᵐ⁰)

theorem resAlg_closure (hk : ∀ a : k, w (algebraMap k L a) ≤ 1) :
    (∀ x y, ResAlg k w x → ResAlg k w y → ResAlg k w (x + y)) ∧
    (∀ x y, ResAlg k w x → ResAlg k w y → ResAlg k w (x * y)) ∧
    (∀ x, ResAlg k w x → w x = 1 → ResAlg k w x⁻¹) ∧
    (∀ x, w x ≤ 1 → ∀ p : Polynomial k, w (Polynomial.aeval x p) ≤ 1) := by
  classical
  let O := w.valuationSubring
  let j : k →+* O := (algebraMap k L).codRestrict O fun a =>
    (Valuation.mem_valuationSubring_iff _ _).2 (hk a)
  let r : O →+* IsLocalRing.ResidueField O := IsLocalRing.residue O
  let ι : k →+* IsLocalRing.ResidueField O := r.comp j
  have hev : ∀ (x : L) (hx : w x ≤ 1) (p : Polynomial k),
      ((p.eval₂ j ⟨x, hx⟩ : O) : L) = Polynomial.aeval x p := fun x hx p =>
    Polynomial.hom_eval₂ p j O.subtype ⟨x, hx⟩
  have hres0 : ∀ y : O, r y = 0 ↔ w (y : L) < 1 := fun y => by
    rw [← ZT w y.1 y.2, AJL w y.1 y.2]
  have hiff : ∀ (x : L) (hx : w x ≤ 1), ResAlg k w x ↔ ι.IsIntegralElem (r ⟨x, hx⟩) := by
    intro x hx
    constructor
    · rintro ⟨-, p, hp, hlt⟩
      refine ⟨p, hp, ?_⟩
      rw [← Polynomial.hom_eval₂, hres0, hev]
      exact hlt
    · rintro ⟨p, hp, h0⟩
      rw [← Polynomial.hom_eval₂, hres0, hev] at h0
      exact ⟨hx, p, hp, h0⟩
  refine ⟨fun x y hx hy => ?_, fun x y hx hy => ?_, fun x hx h1 => ?_, fun x hx p => ?_⟩
  · have hxy : w (x + y) ≤ 1 := (w.map_add _ _).trans (max_le hx.1 hy.1)
    exact (hiff _ hxy).2 (RingHom.IsIntegralElem.add ι ((hiff x hx.1).1 hx) ((hiff y hy.1).1 hy))
  · have hxy : w (x * y) ≤ 1 := by rw [map_mul]; exact mul_le_one' hx.1 hy.1
    exact (hiff _ hxy).2 (RingHom.IsIntegralElem.mul ι ((hiff x hx.1).1 hx) ((hiff y hy.1).1 hy))
  · have hxi : w x⁻¹ ≤ 1 := by rw [map_inv₀, h1, inv_one]
    have hx0 : x ≠ 0 := by rintro rfl; rw [w.map_zero] at h1; exact zero_ne_one h1
    have hmul : r ⟨x⁻¹, hxi⟩ * r ⟨x, hx.1⟩ = 1 := by
      rw [← map_mul, ← map_one r]
      exact congrArg r (Subtype.ext (inv_mul_cancel₀ hx0))
    refine (hiff _ hxi).2 ?_
    rw [eq_inv_of_mul_eq_one_left hmul]
    let _ : Algebra k (IsLocalRing.ResidueField O) := ι.toAlgebra
    exact IsIntegral.inv (R := k) ((hiff x hx.1).1 hx)
  · rw [← hev x hx p]
    exact (p.eval₂ j ⟨x, hx⟩).2

variable (hk : ∀ a : k, a ≠ 0 → w (algebraMap k L a) = 1)
include hk

theorem algebraMap_le_one_of_trivial (a : k) : w (algebraMap k L a) ≤ 1 := by
  by_cases h0 : a = 0
  · rw [h0, map_zero, w.map_zero]; exact zero_le
  · exact (hk a h0).le

theorem resAlg_algebraMap (a : k) : ResAlg k w (algebraMap k L a) :=
  ⟨algebraMap_le_one_of_trivial w hk a, Polynomial.X - Polynomial.C a, Polynomial.monic_X_sub_C a, by simp⟩

theorem resAlg_adjoin (S : Set L) (hS : ∀ s ∈ S, ResAlg k w s) :
    ∀ x ∈ Algebra.adjoin k S, ResAlg k w x := by
  obtain ⟨hadd, hmul, -, -⟩ := resAlg_closure w (algebraMap_le_one_of_trivial w hk)
  intro x hx
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact hS x hx
  | algebraMap a => exact resAlg_algebraMap w hk a
  | add x y _ _ hx hy => exact hadd x y hx hy
  | mul x y _ _ hx hy => exact hmul x y hx hy

theorem resAlg_zpow (x : L) (hx : ResAlg k w x) (n : ℤ) (hn : 0 ≤ n ∨ w x = 1) :
    ResAlg k w (x ^ n) := by
  obtain ⟨-, hmul, hinv, -⟩ := resAlg_closure w (algebraMap_le_one_of_trivial w hk)
  have hpow : ∀ (y : L), ResAlg k w y → ∀ m : ℕ, ResAlg k w (y ^ m) := by
    intro y hy m
    induction m with
    | zero => rw [pow_zero, ← map_one (algebraMap k L)]; exact resAlg_algebraMap w hk 1
    | succ m ih => rw [pow_succ]; exact hmul _ _ ih hy
  by_cases h0 : 0 ≤ n
  · obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le h0
    rw [zpow_natCast]; exact hpow x hx m
  · have h1 : w x = 1 := hn.resolve_left h0
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = -(m : ℤ) := ⟨(-n).toNat, by omega⟩
    rw [zpow_neg, zpow_natCast, ← inv_pow]
    exact hpow _ (hinv x hx h1) m

theorem resAlg_lmono (x : Fin 3 → L) (a : Fin 3 → ℤ)
    (h : ∀ j, ResAlg k w (x j) ∧ (0 ≤ a j ∨ w (x j) = 1)) : ResAlg k w (lmono x a) := by
  obtain ⟨-, hmul, -, -⟩ := resAlg_closure w (algebraMap_le_one_of_trivial w hk)
  exact hmul _ _ (hmul _ _ (resAlg_zpow w hk _ (h 0).1 _ (h 0).2)
    (resAlg_zpow w hk _ (h 1).1 _ (h 1).2)) (resAlg_zpow w hk _ (h 2).1 _ (h 2).2)

omit hk in
theorem not_resAlg_of_trivial (x : L)
    (h : ∀ p : Polynomial k, p ≠ 0 → w (Polynomial.aeval x p) = 1) : ¬ ResAlg k w x := by
  rintro ⟨-, p, hp, hlt⟩
  rw [h p hp.ne_zero] at hlt
  exact lt_irrefl _ hlt

theorem trivial_of_not_resAlg (x : L) (hx : w x ≤ 1) (h : ¬ ResAlg k w x) :
    ∀ p : Polynomial k, p ≠ 0 → w (Polynomial.aeval x p) = 1 := by
  obtain ⟨-, -, -, hle⟩ := resAlg_closure w (algebraMap_le_one_of_trivial w hk)
  intro p hp
  have hmon := Polynomial.monic_mul_leadingCoeff_inv hp
  have h1 : w (Polynomial.aeval x (p * Polynomial.C p.leadingCoeff⁻¹)) = 1 :=
    le_antisymm (hle x hx _) (not_lt.1 fun hlt => h ⟨hx, _, hmon, hlt⟩)
  rwa [map_mul, map_mul, Polynomial.aeval_C,
    hk _ (inv_ne_zero (Polynomial.leadingCoeff_ne_zero.2 hp)), mul_one] at h1

end Residue

theorem optionElim_comp_finSucc {A : Type*} {n : ℕ} (a : A) (x : Fin n → A) :
    (Fin.cons a x : Fin (n + 1) → A) ∘ (finSuccEquiv n).symm = fun o : Option (Fin n) => o.elim a x := by
  funext o
  rcases o with _ | j
  · rfl
  · simp

section Slice

variable {K : Type} [Field K] (F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]

theorem xField_le_unitField (t : SliceField F₀) : xField F₀ ≤ unitField F₀ t :=
  IntermediateField.adjoin.mono K _ _ (Set.singleton_subset_iff.2 (Set.mem_insert_of_mem _ rfl))

theorem xField_trivial (w : Valuation (SliceField F₀) ℤᵐ⁰) (t : SliceField F₀)
    (htv : ∀ a ∈ unitField F₀ t, a ≠ 0 → w a = 1) (a : xField F₀) (ha : a ≠ 0) :
    w (algebraMap (xField F₀) (SliceField F₀) a) = 1 :=
  htv (a : SliceField F₀) (xField_le_unitField F₀ t a.2) fun h => ha (Subtype.ext h)

/-- A valuation that is trivial on `K(t, X)`, with `t` and `X` algebraically independent, takes the value 1
on the nonzero polynomials in `t` over `K(X)`. -/
theorem aeval_trivial_of_unitField (w : Valuation (SliceField F₀) ℤᵐ⁰) (t : SliceField F₀)
    (hind : AlgebraicIndependent K ![t, sliceProj F₀ (MvPolynomial.X 0)])
    (htv : ∀ a ∈ unitField F₀ t, a ≠ 0 → w a = 1) :
    ∀ p : Polynomial (xField F₀), p ≠ 0 → w (Polynomial.aeval t p) = 1 := by
  have htr : Transcendental (xField F₀) t := by
    have h1 : AlgebraicIndependent K (fun o : Option (Fin 1) =>
        o.elim t ![sliceProj F₀ (MvPolynomial.X 0)]) :=
      (algebraicIndependent_equiv' (finSuccEquiv 1).symm (optionElim_comp_finSucc _ _)).2 hind
    have h2 := (AlgebraicIndependent.option_iff.1 h1).2
    rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty] at h2
    exact IntermediateField.transcendental_adjoin_iff.2 h2
  have hxle := xField_le_unitField F₀ t
  have htm : t ∈ unitField F₀ t := IntermediateField.subset_adjoin K _ (Set.mem_insert _ _)
  intro p hp
  refine htv _ ?_ fun h0 => hp ((transcendental_iff.1 htr) p h0)
  rw [Polynomial.aeval_eq_sum_range]
  refine sum_mem fun n _ => ?_
  rw [Algebra.smul_def]
  exact mul_mem (hxle (p.coeff n).2) (pow_mem htm n)

/-- Converse of `aeval_trivial_of_unitField`, given that `X` is transcendental over `K`. -/
theorem unitField_trivial_of_aeval (w : Valuation (SliceField F₀) ℤᵐ⁰) (c : SliceField F₀)
    (hX : AlgebraicIndependent K ![sliceProj F₀ (MvPolynomial.X 0)])
    (h : ∀ p : Polynomial (xField F₀), p ≠ 0 → w (Polynomial.aeval c p) = 1) :
    AlgebraicIndependent K ![c, sliceProj F₀ (MvPolynomial.X 0)] ∧
      ∀ a ∈ unitField F₀ c, a ≠ 0 → w a = 1 := by
  have h0 : ∀ p : Polynomial (xField F₀), p ≠ 0 → Polynomial.aeval c p ≠ 0 := fun p hp h0 => by
    have h1 := h p hp
    rw [h0, w.map_zero] at h1
    exact zero_ne_one h1
  have htr : Transcendental (xField F₀) c :=
    transcendental_iff.2 fun p hp => by_contra fun hne => h0 p hne hp
  constructor
  · have h2 : Transcendental (Algebra.adjoin K (Set.range ![sliceProj F₀ (MvPolynomial.X 0)])) c := by
      rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty]
      exact IntermediateField.transcendental_adjoin_iff.1 htr
    exact (algebraicIndependent_equiv' (finSuccEquiv 1).symm (optionElim_comp_finSucc _ _)).1
      (AlgebraicIndependent.option_iff.2 ⟨hX, h2⟩)
  · have hle : unitField F₀ c ≤ (IntermediateField.adjoin (xField F₀) {c}).restrictScalars K := by
      rw [IntermediateField.adjoin_le_iff]
      rintro _ (rfl | rfl)
      · exact IntermediateField.mem_adjoin_simple_self (xField F₀) _
      · exact (IntermediateField.adjoin (xField F₀) {c}).algebraMap_mem
          ⟨_, IntermediateField.subset_adjoin K _ (Set.mem_singleton _)⟩
    intro a ha ha0
    obtain ⟨r, s, rfl⟩ := (IntermediateField.mem_adjoin_simple_iff (xField F₀) a).1 (hle ha)
    have hr : r ≠ 0 := by rintro rfl; simp at ha0
    have hs : s ≠ 0 := by rintro rfl; simp at ha0
    rw [map_div₀, h r hr, h s hs, div_one]

theorem ChartDivisor.exists_unit_coord (sR sY sZ : Bool) : ChartUnitCoord F₀ sR sY sZ := by
  intro w hw
  obtain ⟨t, ht, hind, htv⟩ := hw.nonconst
  have hk := xField_trivial F₀ w t htv
  have hX : AlgebraicIndependent K ![sliceProj F₀ (MvPolynomial.X 0)] := by
    have h := hind.comp (Fin.succ : Fin 1 → Fin 2) (Fin.succ_injective _)
    have he : ![t, sliceProj F₀ (MvPolynomial.X 0)] ∘ (Fin.succ : Fin 1 → Fin 2) =
        ![sliceProj F₀ (MvPolynomial.X 0)] := by funext j; fin_cases j; rfl
    rwa [he] at h
  have ht' : t ∈ Algebra.adjoin (xField F₀) (Set.range (chartCoord F₀ sR sY sZ)) := ht
  by_contra hno
  have hall : ∀ s ∈ Set.range (chartCoord F₀ sR sY sZ), ResAlg (xField F₀) w s := by
    rintro _ ⟨i, rfl⟩
    by_contra hi
    have hle : w (chartCoord F₀ sR sY sZ i) ≤ 1 := hw.le_one _ (Algebra.subset_adjoin ⟨i, rfl⟩)
    have htriv := trivial_of_not_resAlg w hk (chartCoord F₀ sR sY sZ i) hle hi
    exact hno ⟨i, unitField_trivial_of_aeval F₀ w _ hX htriv⟩
  exact not_resAlg_of_trivial w t (aeval_trivial_of_unitField F₀ w t hind htv)
    (resAlg_adjoin w hk _ hall t ht')

end Slice

end ProximityPrize.SubmissionLower.FormalR
end
section

/-!
The bridge between the two function fields: a valuation of the function field `AJ E G` of a geometric
component over the constant field `E` that is at most 1 on a chart ring and trivial on `E(t)` for a
transcendental `t` of that chart ring restricts along `ψ : SliceField F₀ →+* AJ E G` either trivially or
as a power of a valuation of the class `ChartDivisor` (`surface_divisor_restrict`).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero MvPolynomial HFree6812
open RCN002 RCN136

noncomputable section

section Residue

variable {E : Type*} [Field E] {L : Type*} [Field L] [Algebra E L]

/-- If a valuation is at most 1 on `E[T]` and trivial on `E(t)` for a transcendental `t` of `E[T]`, then
it is trivial on `E(T i)` for one of the generators, and that generator is transcendental: the residue of
`t` is transcendental over `E`, so the residues of the generators are not all algebraic. -/
theorem exists_trivial_on_generator {ι : Type*} (nu : Valuation L ℤᵐ⁰) (T : ι → L)
    (h1 : ∀ a ∈ Algebra.adjoin E (Set.range T), nu a ≤ 1) (t : L)
    (ht : t ∈ Algebra.adjoin E (Set.range T)) (htr : Transcendental E t)
    (h2 : ∀ a ∈ IntermediateField.adjoin E {t}, a ≠ 0 → nu a = 1) :
    ∃ i, Transcendental E (T i) ∧ ∀ a ∈ IntermediateField.adjoin E {T i}, a ≠ 0 → nu a = 1 := by
  have hE : ∀ a : E, nu (algebraMap E L a) ≤ 1 := fun a => h1 _ (Subalgebra.algebraMap_mem _ a)
  let V := nu.valuationSubring
  let ιE : E →+* V := (algebraMap E L).codRestrict V fun a =>
    (Valuation.mem_valuationSubring_iff nu _).mpr (hE a)
  let ρ : V →+* IsLocalRing.ResidueField V := IsLocalRing.residue V
  let _ : Algebra E (IsLocalRing.ResidueField V) := (ρ.comp ιE).toAlgebra
  have key1 : ∀ (x : V) (P : Polynomial E), Polynomial.aeval (ρ x) P = ρ (P.eval₂ ιE x) :=
    fun x P => by rw [Polynomial.aeval_def, Polynomial.hom_eval₂]; rfl
  have key2 : ∀ (x : V) (P : Polynomial E),
      ((P.eval₂ ιE x : V) : L) = Polynomial.aeval (x : L) P := fun x P => by
    rw [Polynomial.aeval_def]
    exact Polynomial.hom_eval₂ P ιE V.subtype x
  have hres : ∀ x : V, ρ x = 0 ↔ nu (x : L) < 1 := fun x => by
    rw [IsLocalRing.residue_eq_zero_iff, ValuationSubring.valuation_lt_one_iff]
    exact (Valuation.isEquiv_valuation_valuationSubring nu).lt_one_iff_lt_one.symm
  have hmem : ∀ a ∈ Algebra.adjoin E (Set.range T), a ∈ V := fun a ha =>
    (Valuation.mem_valuationSubring_iff nu a).mpr (h1 a ha)
  have hTV : ∀ i, T i ∈ V := fun i => hmem _ (Algebra.subset_adjoin ⟨i, rfl⟩)
  -- the residue of a polynomial in `x` vanishes iff the value of the polynomial is less than 1
  have key3 : ∀ (x : V) (P : Polynomial E),
      Polynomial.aeval (ρ x) P = 0 ↔ nu (Polynomial.aeval (x : L) P) < 1 := fun x P => by
    rw [key1, hres, key2]
  obtain ⟨i, hi⟩ : ∃ i, Transcendental E (ρ ⟨T i, hTV i⟩) := by
    by_contra hall
    have halg : ∀ a (ha : a ∈ Algebra.adjoin E (Set.range T)), IsAlgebraic E (ρ ⟨a, hmem a ha⟩) := by
      intro a ha
      induction ha using Algebra.adjoin_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact not_not.mp (not_exists.mp hall i)
      | algebraMap r => exact isAlgebraic_algebraMap (R := E) r
      | add x y hx hy ihx ihy => exact ihx.add ihy
      | mul x y hx hy ihx ihy => exact ihx.mul ihy
    obtain ⟨P, hP0, hP⟩ := halg t ht
    have h3 := (key3 ⟨t, hmem t ht⟩ P).mp hP
    have h4 : Polynomial.aeval t P ≠ 0 := fun h => hP0 ((transcendental_iff.mp htr) P h)
    have h5 := h2 _ (IntermediateField.algebra_adjoin_le_adjoin E _
      (Polynomial.aeval_mem_adjoin_singleton E t)) h4
    exact absurd h3 (by rw [h5]; exact lt_irrefl _)
  have hone : ∀ P : Polynomial E, P ≠ 0 → nu (Polynomial.aeval (T i) P) = 1 := by
    intro P hP0
    have hle : nu (Polynomial.aeval (T i) P) ≤ 1 :=
      h1 _ (Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_range_self i))
        (Polynomial.aeval_mem_adjoin_singleton E (T i)))
    refine le_antisymm hle (not_lt.mp fun hlt => hP0 ?_)
    exact (transcendental_iff.mp hi) P ((key3 ⟨T i, hTV i⟩ P).mpr hlt)
  refine ⟨i, fun ⟨P, hP0, hP⟩ => ?_, fun a ha ha0 => ?_⟩
  · have := hone P hP0
    rw [hP, map_zero] at this
    exact zero_ne_one this
  · obtain ⟨r, s, rfl⟩ := (IntermediateField.mem_adjoin_simple_iff E a).mp ha
    have hr : r ≠ 0 := by
      rintro rfl
      rw [map_zero, zero_div] at ha0
      exact ha0 rfl
    have hs : s ≠ 0 := by
      rintro rfl
      rw [map_zero, div_zero] at ha0
      exact ha0 rfl
    rw [map_div₀, hone r hr, hone s hs, div_one]

end Residue

section Independence

variable {K E : Type*} [Field K] [Field E] {L₀ L : Type*} [Field L₀] [Algebra K L₀] [Field L]
  [Algebra E L]

/-- Algebraic independence of `t, x` over `K` from the transcendence of the image of `t` over `E`, for
a ring homomorphism `ψ` that sends `K[x]` into `E` injectively. -/
theorem algebraicIndependent_pair_of_map (phi : Polynomial K →+* E) (hphi : Function.Injective phi)
    (ψ : L₀ →+* L) (hK : ∀ a : K, ψ (algebraMap K L₀ a) = algebraMap E L (phi (Polynomial.C a)))
    (t x : L₀) (hx : ψ x = algebraMap E L (phi Polynomial.X)) (ht : Transcendental E (ψ t)) :
    AlgebraicIndependent K ![t, x] := by
  let φ₁ : MvPolynomial (Fin 1) K →+* E :=
    phi.comp (MvPolynomial.aeval fun _ : Fin 1 => (Polynomial.X : Polynomial K)).toRingHom
  have hφ₁ : Function.Injective φ₁ := by
    refine hphi.comp ?_
    have : AlgebraicIndependent K fun _ : Fin 1 => (Polynomial.X : Polynomial K) :=
      algebraicIndependent_unique_type_iff.mpr (Polynomial.transcendental_X K)
    exact this
  let Θ : MvPolynomial (Fin 2) K →+* Polynomial E :=
    (Polynomial.mapRingHom φ₁).comp (MvPolynomial.finSuccEquiv K 1).toRingEquiv.toRingHom
  have hΘ : Function.Injective Θ :=
    (Polynomial.map_injective φ₁ hφ₁).comp (MvPolynomial.finSuccEquiv K 1).injective
  have hcomp : ψ.comp (MvPolynomial.aeval ![t, x]).toRingHom =
      (Polynomial.aeval (ψ t)).toRingHom.comp Θ := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) fun j => ?_
    · have h1 : (MvPolynomial.finSuccEquiv K 1) (MvPolynomial.C a) =
          Polynomial.C (MvPolynomial.C a) := (MvPolynomial.finSuccEquiv K 1).commutes a
      simp [Θ, φ₁, h1, hK]
    · fin_cases j
      · simp [Θ, MvPolynomial.finSuccEquiv_X_zero]
      · have h1 : (MvPolynomial.finSuccEquiv K 1) (MvPolynomial.X (1 : Fin 2)) =
            Polynomial.C (MvPolynomial.X 0) :=
          MvPolynomial.finSuccEquiv_X_succ (j := (0 : Fin 1))
        simp [Θ, φ₁, h1, hx]
  rw [algebraicIndependent_iff_injective_aeval, injective_iff_map_eq_zero]
  intro P hP
  have h1 : ψ.comp (MvPolynomial.aeval ![t, x]).toRingHom P = 0 := by
    change ψ (MvPolynomial.aeval ![t, x] P) = 0
    rw [hP, map_zero]
  rw [hcomp] at h1
  exact (injective_iff_map_eq_zero Θ).mp hΘ P ((transcendental_iff.mp ht) (Θ P) h1)

end Independence

section Bridge

variable {K E : Type} [Field K] [Field E]

/-- The contract `SurfaceDivisorRestrict` for every `ψ` that restricts on polynomials to
the coefficient map of an injective `phi`. -/
theorem surface_divisor_restrict (F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (sR sY sZ : Bool) (phi : Polynomial K →+* E) (hphi : Function.Injective phi)
    (G : Ideal (MvPolynomial (Fin 3) E)) [G.IsPrime] (ψ : SliceField F₀ →+* AJ E G)
    (hψ : ∀ A, ψ (sliceProj F₀ A) = CT.GP phi G A) :
    SurfaceDivisorRestrict F₀ sR sY sZ G ψ := by
  have hC : ∀ a : E, BR E G (MvPolynomial.C a) = algebraMap E (AJ E G) a := fun a =>
    (BR E G).commutes a
  have hcoord : ∀ j, ψ (sliceCoord F₀ j) = coordinate E G j := fun j => by
    rw [sliceCoord, hψ, CT.GP, RingHom.comp_apply, AMP]
    rfl
  have hx0 : ψ (sliceProj F₀ (MvPolynomial.X 0)) = algebraMap E (AJ E G) (phi Polynomial.X) := by
    rw [hψ, CT.GP, RingHom.comp_apply, CSU]
    exact hC _
  have hK : ∀ a : K, ψ (algebraMap K (SliceField F₀) a) =
      algebraMap E (AJ E G) (phi (Polynomial.C a)) := fun a => by
    have h : algebraMap K (SliceField F₀) a = sliceProj F₀ (MvPolynomial.C a) := rfl
    rw [h, hψ, CT.GP, RingHom.comp_apply, surfaceMap_C]
    exact hC _
  have hmono : ∀ i, ψ (chartCoord F₀ sR sY sZ i) =
      lmono (coordinate E G) (chartExp sR sY sZ i) := fun i => by
    simp only [chartCoord, lmono, map_mul, map_zpow₀, hcoord]
  intro nu h1 h2
  obtain ⟨t, ht, htr, htriv⟩ := h2
  by_cases hall : ∀ a, a ≠ 0 → nu (ψ a) = 1
  · exact Or.inl hall
  right
  obtain ⟨a₀, ha₀, hne⟩ : ∃ a, a ≠ 0 ∧ nu (ψ a) ≠ 1 := by
    by_contra h
    exact hall fun a ha => by_contra fun hn => h ⟨a, ha, hn⟩
  obtain ⟨e, w, he, hnorm, hw⟩ := DZW (nu.comap ψ)
    ⟨a₀, (Valuation.ne_zero_iff _).mpr ha₀, hne⟩
  have hw' : ∀ a, nu (ψ a) = w a ^ e := hw
  have he0 : e ≠ 0 := by omega
  have hxE : ∀ r ∈ xField F₀, ∃ a : E, ψ r = algebraMap E (AJ E G) a := by
    intro r hr
    induction hr using IntermediateField.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨_, hx0⟩
    | algebraMap a => exact ⟨_, hK a⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨b, hb⟩ := ihy
      exact ⟨a + b, by rw [map_add, ha, hb, map_add]⟩
    | inv x _ ihx =>
      obtain ⟨a, ha⟩ := ihx
      exact ⟨a⁻¹, by rw [map_inv₀, ha, map_inv₀]⟩
    | mul x y _ _ ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨b, hb⟩ := ihy
      exact ⟨a * b, by rw [map_mul, ha, hb, map_mul]⟩
  have hle : ∀ a ∈ chartRing F₀ sR sY sZ, nu (ψ a) ≤ 1 := by
    intro a ha
    rw [chartRing] at ha
    induction ha using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      rw [hmono]
      exact h1 _ (Algebra.subset_adjoin ⟨i, rfl⟩)
    | algebraMap r =>
      obtain ⟨a, ha⟩ := hxE r r.2
      change nu (ψ (r : SliceField F₀)) ≤ 1
      rw [ha]
      exact h1 _ (Subalgebra.algebraMap_mem _ a)
    | add x y _ _ ihx ihy =>
      rw [map_add]
      exact (nu.map_add _ _).trans (max_le ihx ihy)
    | mul x y _ _ ihx ihy =>
      rw [map_mul, map_mul]
      exact mul_le_one' ihx ihy
  obtain ⟨i, hi, hitriv⟩ := exists_trivial_on_generator nu
    (fun i => lmono (coordinate E G) (chartExp sR sY sZ i)) h1 t ht htr htriv
  have hmem : ∀ a ∈ unitField F₀ (chartCoord F₀ sR sY sZ i), ψ a ∈
      IntermediateField.adjoin E {lmono (coordinate E G) (chartExp sR sY sZ i)} := by
    intro a ha
    induction ha using IntermediateField.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · rw [hmono]
        exact IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        rw [hx0]
        exact IntermediateField.algebraMap_mem _ _
    | algebraMap a =>
      rw [hK]
      exact IntermediateField.algebraMap_mem _ _
    | add x y _ _ ihx ihy =>
      rw [map_add]
      exact add_mem ihx ihy
    | inv x _ ihx =>
      rw [map_inv₀]
      exact inv_mem ihx
    | mul x y _ _ ihx ihy =>
      rw [map_mul]
      exact mul_mem ihx ihy
  refine ⟨e, w, he, ⟨hnorm, fun a ha => ?_, chartCoord F₀ sR sY sZ i,
    Algebra.subset_adjoin ⟨i, rfl⟩, ?_, fun a ha ha0 => ?_⟩, hw'⟩
  · have h3 := hle a ha
    rw [hw'] at h3
    exact (pow_le_one_iff_of_nonneg zero_le he0).mp h3
  · exact algebraicIndependent_pair_of_map phi hphi ψ hK _ _ hx0 (by rw [hmono]; exact hi)
  · have h3 := hitriv _ (hmem a ha) ((map_ne_zero ψ).mpr ha0)
    rw [hw'] at h3
    exact (pow_eq_one_iff_of_nonneg zero_le he0).mp h3

/-- The bridge for the embedding `RY` of the function field of the carrier into the function
field of a geometric component over an extension `E` of `GenericField K`. -/
theorem surface_divisor_restrict_sliceEmbedding [Algebra (RCN135.GenericField K) E]
    (D : Ideal (MvPolynomial (Fin 3) E)) [D.IsPrime] (F₀ : MvPolynomial (Fin 4) K)
    [Fact (Irreducible F₀)] (hker : RingHom.ker (sliceMap (K := K) D) = Ideal.span {F₀})
    (sR sY sZ : Bool) : SurfaceDivisorRestrict F₀ sR sY sZ D (RY D F₀ hker) :=
  surface_divisor_restrict F₀ sR sY sZ
    ((algebraMap (RCN135.GenericField K) E).comp (RCN135.AL K))
    ((algebraMap (RCN135.GenericField K) E).injective.comp (RCN135.DI K)) D _
    fun A => SR D F₀ hker A

end Bridge

end

end ProximityPrize.SubmissionLower.FormalR
end
section

/-!
The chart polynomial of the carrier `F₀ = 0` in the monomial coordinates of a chart, in its three uses on
`SliceField F₀`: as a relation of one coordinate over the other two and `X` (`chart_core_poly`), as a
relation of two coordinates over `K(z, X)` in the form of the counting lemma (`chart_two_coord`), and in the
Noether normalization of the chart ring over `K(X)` (`chart_noether`).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open MvPolynomial HFree6812
open RCN313

/-- Algebraic independence over a domain passes to its field of fractions. -/
theorem Chart.algebraicIndependent_of_isFractionRing {A k L ι : Type*} [CommRing A] [IsDomain A] [Field k]
    [Algebra A k] [IsFractionRing A k] [CommRing L] [Algebra A L] [Algebra k L] [IsScalarTower A k L]
    (y : ι → L) (hy : AlgebraicIndependent A y) : AlgebraicIndependent k y := by
  let _ := MvPolynomial.algebraMvPolynomial (R := A) (S := k) (σ := ι)
  rw [algebraicIndependent_iff_injective_aeval, injective_iff_map_eq_zero]
  intro Q hQ
  obtain ⟨⟨Q', m⟩, h⟩ :=
    IsLocalization.surj ((nonZeroDivisors A).map (MvPolynomial.C (σ := ι))) Q
  obtain ⟨a, ha, hm⟩ := Submonoid.mem_map.1 m.2
  dsimp only at h
  rw [MvPolynomial.algebraMap_def, ← hm, map_C] at h
  have h1 : aeval y Q' = 0 := by
    have h3 := congrArg (aeval y) h
    rw [map_mul, hQ, zero_mul, aeval_def, eval₂_map, ← IsScalarTower.algebraMap_eq, ← aeval_def] at h3
    exact h3.symm
  rw [(injective_iff_map_eq_zero _).1 hy Q' h1, map_zero] at h
  refine (mul_eq_zero.1 h).resolve_right fun h0 => nonZeroDivisors.ne_zero ha ?_
  exact IsFractionRing.injective A k ((C_eq_zero.1 h0).trans (map_zero _).symm)

section Slots

/-- Variable `s` of the chart polynomial as a slot of the family `(t_k; t_i, t_j, X)`. -/
def Chart.coreSlot (i j : Fin 3) : Fin 4 → Option (Fin 3) :=
  Fin.cases (some 2) fun m => if m = i then some 0 else if m = j then some 1 else none

theorem Chart.coreSlot_injective : ∀ i j : Fin 3, i ≠ j → Function.Injective (coreSlot i j) := by decide

theorem Chart.coreSlot_succ : ∀ i j k : Fin 3, i ≠ k → j ≠ k → coreSlot i j k.succ = none := by decide

theorem Chart.chartSlot_eq_third {i j k m : Fin 3} (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    (hmi : m ≠ i) (hmj : m ≠ j) : m = k := by
  rw [ne_eq, Fin.ext_iff] at hij hik hjk hmi hmj
  have := i.isLt
  have := j.isLt
  have := k.isLt
  have := m.isLt
  ext
  omega

theorem Chart.coreSlot_elim {α : Type*} {i j k : Fin 3} (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) (x0 : α)
    (t : Fin 3 → α) (s : Fin 4) :
    (coreSlot i j s).elim (t k) ![t i, t j, x0] = (Fin.cons x0 t : Fin 4 → α) s := by
  refine Fin.cases rfl (fun m => ?_) s
  rw [Fin.cons_succ]
  show (if m = i then some 0 else if m = j then some 1 else none : Option (Fin 3)).elim (t k)
    ![t i, t j, x0] = t m
  by_cases hmi : m = i
  · simp [hmi]
  by_cases hmj : m = j
  · simp [hmj, hij.symm]
  · obtain rfl := chartSlot_eq_third hij hik hjk hmi hmj
    simp [hmi, hmj]

/-- The variables of the chart polynomial as `(t_k, t_j; t_i, X)`. -/
def Chart.twoSlot (i j k : Fin 3) : Fin 2 ⊕ Fin 2 → Fin 4 :=
  Sum.elim ![k.succ, j.succ] ![i.succ, 0]

theorem Chart.twoSlot_bijective :
    ∀ i j k : Fin 3, i ≠ j → i ≠ k → j ≠ k → Function.Bijective (twoSlot i j k) := by decide

/-- The variables of `F₀` as `(Y, R, Z; X)`. -/
def Chart.xSlot : Fin 3 ⊕ Unit → Fin 4 :=
  Sum.elim Fin.succ fun _ => 0

theorem Chart.xSlot_bijective : Function.Bijective xSlot := by decide

end Slots

variable {K : Type} [Field K] (F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]

section Coordinates

variable (hc : ∀ j, sliceCoord F₀ j ≠ 0) (sR sY sZ : Bool)
include hc

theorem Chart.chartCoord_ne_zero (i : Fin 3) : chartCoord F₀ sR sY sZ i ≠ 0 :=
  lmono_ne_zero _ hc _

/-- A Laurent monomial in `Y`, `R`, `Z` as a Laurent monomial in the coordinates of a chart. -/
theorem Chart.lmono_chartCoord (a b c : ℤ) :
    lmono (chartCoord F₀ sR sY sZ) (chartLam sR sY sZ a b c) = lmono (sliceCoord F₀) ![a, b, c] :=
  lmono_chart _ hc sR sY sZ a b c

theorem Chart.sliceCoord_eq_lmono_chartCoord (j : Fin 3) :
    sliceCoord F₀ j = lmono (chartCoord F₀ sR sY sZ)
      (chartLam sR sY sZ (if j = 0 then 1 else 0) (if j = 1 then 1 else 0) (if j = 2 then 1 else 0)) :=
  coord_eq_lmono_chart _ hc sR sY sZ j

/-- The coordinates of a chart generate the function field over `K(X)`. -/
theorem Chart.chart_gen (E : Subfield (SliceField F₀)) (hK : ∀ a : K, algebraMap K (SliceField F₀) a ∈ E)
    (hX : sliceProj F₀ (MvPolynomial.X 0) ∈ E) (ht : ∀ i, chartCoord F₀ sR sY sZ i ∈ E) :
    ∀ z, z ∈ E :=
  slice_gen F₀ E hK hX (coord_mem_of_chart_mem _ hc sR sY sZ E ht)

end Coordinates

/-- The chart polynomial: `F₀` in the monomial coordinates of a chart, of degree at most `N` in each. -/
theorem Chart.exists_sliceChartPoly (N : ℕ) (hN : weightedTotalDegree ![0, 1, 1, 1] F₀ ≤ N)
    (hc : ∀ j, sliceCoord F₀ j ≠ 0) (sR sY sZ : Bool) :
    ∃ P : MvPolynomial (Fin 4) K, P ≠ 0 ∧
      aeval (Fin.cons (sliceProj F₀ (MvPolynomial.X 0)) (chartCoord F₀ sR sY sZ) :
        Fin 4 → SliceField F₀) P = 0 ∧
      ∀ e ∈ P.support, ∀ i : Fin 3, e i.succ ≤ N :=
  exists_chartPoly₄ (sliceProj F₀ (MvPolynomial.X 0)) (sliceCoord F₀) hc F₀
    (Fact.out : Irreducible F₀).ne_zero (by rw [aeval_slice]; exact (BMJ F₀ F₀).2 dvd_rfl) N
    (ELD F₀ N hN) sR sY sZ

open Chart in
theorem chart_core_poly (N : ℕ) (hN : weightedTotalDegree ![0, 1, 1, 1] F₀ ≤ N)
    (hc : ∀ j, sliceCoord F₀ j ≠ 0) (sR sY sZ : Bool) : ChartCorePoly F₀ N sR sY sZ := by
  intro i j k hij hik hjk hind
  obtain ⟨P, hP0, hPt, hPs⟩ := exists_sliceChartPoly F₀ N hN hc sR sY sZ
  obtain ⟨Q, hQ0, hQy, hQd, hQc⟩ := exists_corePoly P hP0 (coreSlot i j)
    (coreSlot_injective i j hij) _ hind (chartCoord F₀ sR sY sZ k)
    (by
      rw [← hPt]
      exact congrArg (fun f : Fin 4 → SliceField F₀ => aeval f P)
        (funext (coreSlot_elim hij hik hjk _ _)))
    k.succ (coreSlot_succ i j k hik hjk) N (degreeOf_le_iff.2 fun e he => hPs e he k)
  refine ⟨Q, hQ0, hQy, hQd, fun n => Algebra.adjoin_mono ?_ (hQc n)⟩
  rintro _ ⟨o, rfl⟩
  fin_cases o <;> simp

open Chart in
theorem chart_two_coord (N : ℕ) (hN : weightedTotalDegree ![0, 1, 1, 1] F₀ ≤ N)
    (hc : ∀ j, sliceCoord F₀ j ≠ 0) (sR sY sZ : Bool) : ChartTwoCoord F₀ N sR sY sZ := by
  intro i j k hij hik hjk hind
  obtain ⟨P, hP0, hPt, hPs⟩ := exists_sliceChartPoly F₀ N hN hc sR sY sZ
  obtain ⟨e, he⟩ : ∃ e : Fin 4 ≃ Fin 2 ⊕ Fin 2, ∀ x, e.symm x = twoSlot i j k x :=
    ⟨(Equiv.ofBijective _ (twoSlot_bijective i j k hij hik hjk)).symm, fun _ => rfl⟩
  obtain ⟨w, hw0, hw1⟩ : ∃ w : Fin 2 → unitField F₀ (chartCoord F₀ sR sY sZ i),
      (w 0 : SliceField F₀) = chartCoord F₀ sR sY sZ i ∧
      (w 1 : SliceField F₀) = sliceProj F₀ (MvPolynomial.X 0) :=
    ⟨![⟨_, IntermediateField.subset_adjoin K _ (Set.mem_insert _ _)⟩,
      ⟨_, IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem _ rfl)⟩], rfl, rfl⟩
  have hw : AlgebraicIndependent K w := by
    refine AlgebraicIndependent.of_comp (unitField F₀ (chartCoord F₀ sR sY sZ i)).val ?_
    have hcomp : (unitField F₀ (chartCoord F₀ sR sY sZ i)).val ∘ w =
        ![chartCoord F₀ sR sY sZ i, sliceProj F₀ (MvPolynomial.X 0)] := by
      funext o
      fin_cases o
      · exact hw0
      · exact hw1
    rw [hcomp]
    exact hind
  have : Infinite (unitField F₀ (chartCoord F₀ sR sY sZ i)) := Infinite.of_injective _ hw
  have hP₂ : specialize e w P ≠ 0 := fun h =>
    hP0 (specialize_injective e w hw (h.trans (map_zero _).symm))
  have hP₂v : aeval ![chartCoord F₀ sR sY sZ k, chartCoord F₀ sR sY sZ j] (specialize e w P) = 0 := by
    rw [aeval_specialize, ← hPt]
    refine congrArg (fun f : Fin 4 → SliceField F₀ => aeval f P) (funext fun s => ?_)
    obtain ⟨x, rfl⟩ := e.symm.surjective s
    rw [Equiv.apply_symm_apply, he]
    rcases x with o | o <;> fin_cases o
    · show chartCoord F₀ sR sY sZ k = (Fin.cons (sliceProj F₀ (MvPolynomial.X 0)) (chartCoord F₀ sR sY sZ) : Fin 4 → SliceField F₀) k.succ
      rw [Fin.cons_succ]
    · show chartCoord F₀ sR sY sZ j = (Fin.cons (sliceProj F₀ (MvPolynomial.X 0)) (chartCoord F₀ sR sY sZ) : Fin 4 → SliceField F₀) j.succ
      rw [Fin.cons_succ]
    · show (w 0 : SliceField F₀) = (Fin.cons (sliceProj F₀ (MvPolynomial.X 0)) (chartCoord F₀ sR sY sZ) : Fin 4 → SliceField F₀) i.succ
      rw [Fin.cons_succ, hw0]
    · exact hw1
  have hdeg : (specialize e w P).totalDegree ≤ 2 * N := by
    rw [totalDegree_eq]
    refine Finset.sup_le fun m hm => ?_
    obtain ⟨d, hd, hmd⟩ := support_specialize e w P m hm
    rw [Finsupp.card_toMultiset, Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two, hmd 0,
      hmd 1, he, he]
    have h0 : d k.succ ≤ N := hPs d hd k
    have h1 : d j.succ ≤ N := hPs d hd j
    simp only [id]
    exact (Nat.add_le_add h0 h1).trans (two_mul N).ge
  obtain ⟨a, c, hc1, hc2⟩ := exists_twoCoord (specialize e w P) hP₂ (chartCoord F₀ sR sY sZ k)
    (chartCoord F₀ sR sY sZ j) hP₂v
  rw [Algebra.smul_def] at hc2
  exact ⟨a, _, c, hdeg, hc1, hc2⟩

/-- `Y`, `Z` and `X` are algebraically independent over `K` when `∂F₀/∂R` does not vanish on the
carrier. -/
theorem Chart.algebraicIndependent_YZ_X (hH : sliceProj F₀ (polyH K F₀) ≠ 0) :
    AlgebraicIndependent K (Sum.elim ![sliceCoord F₀ 0, sliceCoord F₀ 2]
      fun _ : Unit => sliceProj F₀ (MvPolynomial.X 0)) := by
  have h2 : (2 : Fin 4) ∈ F₀.vars := by
    by_contra h
    refine hH ?_
    rw [polyH, pderiv_eq_zero_of_notMem_vars h, map_zero]
  have hYZX := algInd_of_Y'_free F₀ ![1, 0, 0] 0 2 (by decide) (by decide) (by decide) rfl rfl h2
  have hL : sliceLinearL F₀ ![1, 0, 0] = sliceCoord F₀ 0 := by
    simp [sliceLinearL, Fin.sum_univ_three]
  rw [hL] at hYZX
  have h := hYZX.comp (Sum.elim ![some 0, none] fun _ : Unit => some 1) (by decide)
  have hfun : (fun o : Option (Fin 2) => o.elim (sliceCoord F₀ 2)
      ![sliceCoord F₀ 0, sliceProj F₀ (MvPolynomial.X 0)]) ∘
      (Sum.elim ![some 0, none] fun _ : Unit => some 1) =
      Sum.elim ![sliceCoord F₀ 0, sliceCoord F₀ 2]
        fun _ : Unit => sliceProj F₀ (MvPolynomial.X 0) := by
    funext s
    rcases s with o | u
    · fin_cases o <;> rfl
    · rfl
  rwa [hfun] at h

open Chart in
open scoped IntermediateField.algebraAdjoinAdjoin in
theorem chart_noether (N : ℕ) (hN : weightedTotalDegree ![0, 1, 1, 1] F₀ ≤ N)
    (hH : sliceProj F₀ (polyH K F₀) ≠ 0) (hc : ∀ j, sliceCoord F₀ j ≠ 0) (sR sY sZ : Bool) :
    ChartNoether F₀ N sR sY sZ := by
  obtain ⟨hX1, hy1⟩ := AlgebraicIndependent.sumElim_iff.1 (algebraicIndependent_YZ_X F₀ hH)
  rw [Set.range_const] at hy1
  have hy : AlgebraicIndependent (xField F₀) ![sliceCoord F₀ 0, sliceCoord F₀ 2] :=
    algebraicIndependent_of_isFractionRing _ hy1
  obtain ⟨x0, hx0⟩ : ∃ x0 : xField F₀, (x0 : SliceField F₀) = sliceProj F₀ (MvPolynomial.X 0) :=
    ⟨⟨_, IntermediateField.mem_adjoin_simple_self K _⟩, rfl⟩
  have hX : AlgebraicIndependent K fun _ : Unit => x0 := by
    refine AlgebraicIndependent.of_comp (xField F₀).val ?_
    have hcomp : ((xField F₀).val ∘ fun _ : Unit => x0) =
        fun _ : Unit => sliceProj F₀ (MvPolynomial.X 0) := funext fun _ => hx0
    rw [hcomp]
    exact hX1
  have : Infinite (xField F₀) := Infinite.of_injective _ hX
  obtain ⟨e, he⟩ : ∃ e : Fin 4 ≃ Fin 3 ⊕ Unit, ∀ x, e.symm x = xSlot x :=
    ⟨(Equiv.ofBijective _ xSlot_bijective).symm, fun _ => rfl⟩
  have hF₃ : specialize e (fun _ : Unit => x0) F₀ ≠ 0 := fun h =>
    (Fact.out : Irreducible F₀).ne_zero
      (specialize_injective e _ hX (h.trans (map_zero _).symm))
  have hF₃x : aeval (sliceCoord F₀) (specialize e (fun _ : Unit => x0) F₀) = 0 := by
    rw [aeval_specialize, ← (BMJ F₀ F₀).2 dvd_rfl, ← aeval_slice]
    refine congrArg (fun f : Fin 4 → SliceField F₀ => aeval f F₀) (funext fun s => ?_)
    obtain ⟨x, rfl⟩ := e.symm.surjective s
    rw [Equiv.apply_symm_apply, he]
    rcases x with o | u
    · show sliceCoord F₀ o =
        (Fin.cons (sliceProj F₀ (MvPolynomial.X 0)) (sliceCoord F₀) : Fin 4 → SliceField F₀) o.succ
      rw [Fin.cons_succ]
    · exact hx0
  have hF₃N : ∀ d ∈ (specialize e (fun _ : Unit => x0) F₀).support, d 0 + d 1 + d 2 ≤ N := by
    intro m hm
    obtain ⟨d, hd, hmd⟩ := support_specialize e _ F₀ m hm
    rw [hmd 0, hmd 1, hmd 2, he, he, he]
    exact ELD F₀ N hN d hd
  exact exists_chart_noether (sliceCoord F₀) hc _ hF₃ hF₃x N hF₃N
    (fun E hk hx => slice_gen F₀ E (fun a => hk (algebraMap K (xField F₀) a))
      (hx0 ▸ hk x0) hx) _ hy sR sY sZ

end ProximityPrize.SubmissionLower.FormalR
end
section

/-!
The exchange at one point, by lengths.

`O` is a Noetherian integrally closed domain with fraction field `K` and the chain condition, `g ≠ 0` a
function, `D` a divisor without common component with `div g`. For finitely many prime divisors `P a` with
weights `m a ≤ ord_(P a) g` and numbers `ord a`, `δ a` with `ord a ≤ length O/(P a + O(-n D)) + δ a`:

    ∑ a, m a * ord a ≤ n * λ_D(g) + loss K g + ∑ a, m a * δ a,

`λ_D(g) = ∑_Q D(Q) length O/(Q + gO)` and `loss K g` the least element of `lossSet K g`.
-/

namespace ProximityPrize.SubmissionLower.FormalR.Exch

variable {O : Type*} [CommRing O] (K : Type*) [Field K] [Algebra O K]

/-- The constants of `exists_bound_sum_length_quotient_nsmul` for `g`. -/
def lossSet (g : O) : Set ℕ :=
  {K' | ∀ L : Divisor O, (∀ P ∈ L.support, g ∉ P.ideal) → ∀ n : ℕ,
    ((div K g).sum fun P e =>
      (e : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ divisorIdeal K (n • L)))) ≤
    n * (L.sum fun P m => (m : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ Ideal.span {g}))) + K'}

/-- The least element of `lossSet K g`. -/
noncomputable def loss (g : O) : ℕ := sInf (lossSet K g)

variable [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O] [IsFractionRing O K]

theorem loss_mem (hO : DivisorChain O) {g : O} (hg : g ≠ 0) : loss K g ∈ lossSet K g :=
  Nat.sInf_mem (exists_bound_sum_length_quotient_nsmul K hO hg)

/-- The chain at a point, in `ℕ∞`. -/
theorem sum_mul_le (hO : DivisorChain O) {g : O} (hg : g ≠ 0) (D : Divisor O)
    (hD : ∀ P ∈ D.support, g ∉ P.ideal) {ι : Type*} (s : Finset ι) (P : ι → PrimeDivisor O)
    (hP : Set.InjOn P s) (m : ι → ℕ) (hm : ∀ a ∈ s, m a ≤ div K g (P a)) (ord δ : ι → ℕ) (n : ℕ)
    (hord : ∀ a ∈ s, (ord a : ℕ∞) ≤
      Module.length O (O ⧸ ((P a).ideal ⊔ divisorIdeal K (n • D))) + δ a) :
    ((∑ a ∈ s, m a * ord a : ℕ) : ℕ∞) ≤
      n * (D.sum fun Q k => (k : ℕ∞) * Module.length O (O ⧸ (Q.ideal ⊔ Ideal.span {g}))) +
        loss K g + (∑ a ∈ s, m a * δ a : ℕ) := by
  classical
  set len : PrimeDivisor O → ℕ∞ := fun Q =>
    Module.length O (O ⧸ (Q.ideal ⊔ divisorIdeal K (n • D))) with hlen
  have h1 : ((∑ a ∈ s, m a * ord a : ℕ) : ℕ∞) ≤
      ∑ a ∈ s, (div K g (P a) : ℕ∞) * len (P a) + (∑ a ∈ s, m a * δ a : ℕ) := by
    push_cast
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun a ha => ?_
    calc (m a : ℕ∞) * ord a ≤ m a * (len (P a) + δ a) := mul_le_mul' le_rfl (hord a ha)
      _ = m a * len (P a) + m a * δ a := mul_add _ _ _
      _ ≤ _ := add_le_add (mul_le_mul' (Nat.cast_le.mpr (hm a ha)) le_rfl) le_rfl
  have h2 : ∑ a ∈ s, (div K g (P a) : ℕ∞) * len (P a) ≤
      (div K g).sum fun Q e => (e : ℕ∞) * len Q := by
    rw [← Finset.sum_image (f := fun Q => (div K g Q : ℕ∞) * len Q) hP]
    refine Finset.sum_le_sum_of_ne_zero fun Q _ hne => Finsupp.mem_support_iff.mpr fun h0 => hne ?_
    rw [h0, Nat.cast_zero, zero_mul]
  calc ((∑ a ∈ s, m a * ord a : ℕ) : ℕ∞)
      ≤ ∑ a ∈ s, (div K g (P a) : ℕ∞) * len (P a) + (∑ a ∈ s, m a * δ a : ℕ) := h1
    _ ≤ _ := add_le_add (h2.trans (loss_mem K hO hg D hD n)) le_rfl

omit [IsDomain O] [IsIntegrallyClosed O] in
/-- `λ_D(g)` is finite when `g` lies in no prime of the support of `D`. -/
theorem sum_length_ne_top (hO : DivisorChain O) (g : O) (D : Divisor O)
    (hD : ∀ P ∈ D.support, g ∉ P.ideal) :
    (D.sum fun Q k => (k : ℕ∞) * Module.length O (O ⧸ (Q.ideal ⊔ Ideal.span {g}))) ≠ ⊤ := by
  rw [Finsupp.sum]
  exact Finset.sum_induction _ (· ≠ ⊤) (fun _ _ ha hb => WithTop.add_ne_top.mpr ⟨ha, hb⟩)
    ENat.zero_ne_top fun Q hQ =>
      WithTop.mul_ne_top (ENat.natCast_ne_top _) (length_quotient_sup_span_ne_top hO Q (hD Q hQ))

/-- The chain at a point, in `ℕ`. -/
theorem sum_mul_le_toNat (hO : DivisorChain O) {g : O} (hg : g ≠ 0) (D : Divisor O)
    (hD : ∀ P ∈ D.support, g ∉ P.ideal) {ι : Type*} (s : Finset ι) (P : ι → PrimeDivisor O)
    (hP : Set.InjOn P s) (m : ι → ℕ) (hm : ∀ a ∈ s, m a ≤ div K g (P a)) (ord δ : ι → ℕ) (n : ℕ)
    (hord : ∀ a ∈ s, (ord a : ℕ∞) ≤
      Module.length O (O ⧸ ((P a).ideal ⊔ divisorIdeal K (n • D))) + δ a) :
    ∑ a ∈ s, m a * ord a ≤
      n * (D.sum fun Q k => (k : ℕ∞) * Module.length O (O ⧸ (Q.ideal ⊔ Ideal.span {g}))).toNat +
        loss K g + ∑ a ∈ s, m a * δ a := by
  have h := sum_mul_le K hO hg D hD s P hP m hm ord δ n hord
  rw [← ENat.natCast_toNat (sum_length_ne_top hO g D hD)] at h
  exact_mod_cast h

end ProximityPrize.SubmissionLower.FormalR.Exch
end
section

/-!
The statements on prime divisors and lengths as propositions: `Statement.X` is a statement as a
`Prop`-valued definition, and `Proved.X` is its proof.

`O` is a Noetherian integrally closed domain with fraction field `K`. No locality is assumed.
-/

open WithZero

namespace ProximityPrize.SubmissionLower.FormalR

variable {O : Type*} [CommRing O] (K : Type*) [Field K] [Algebra O K]

namespace Statement

variable (O) [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O] [IsFractionRing O K]

/-- The valuation of a prime divisor is surjective, at most 1 on `O`, and less than 1
on `O` exactly on `P`. -/
def valuation_spec : Prop := ∀ P : PrimeDivisor O, P.IsValuation K (P.valuation K)

/-- Identification: a valuation with these three properties is the valuation of `P`. -/
def valuation_unique : Prop :=
  ∀ (P : PrimeDivisor O) (v : Valuation K ℤᵐ⁰), P.IsValuation K v → v = P.valuation K

/-- The valuation ring of `ord_P` is the localization of `O` at `P`. -/
def valuation_le_one_iff : Prop :=
  ∀ (P : PrimeDivisor O) (x : K), P.valuation K x ≤ 1 ↔
    ∃ a s : O, s ∉ P.ideal ∧ x * algebraMap O K s = algebraMap O K a

/-- An element of `K` with value at most 1 at every prime divisor lies in `O`. -/
def mem_range_of_valuation_le_one : Prop :=
  ∀ x : K, (∀ P : PrimeDivisor O, P.valuation K x ≤ 1) → ∃ a : O, algebraMap O K a = x

/-- Membership in `O(-D)`. -/
def mem_divisorIdeal : Prop :=
  ∀ (D : Divisor O) (a : O), a ∈ divisorIdeal K D ↔
    ∀ P : PrimeDivisor O, P.valuation K (algebraMap O K a) ≤ exp (-(D P : ℤ))

def valuation_eq_exp_neg_div : Prop :=
  ∀ (g : O), g ≠ 0 → ∀ P : PrimeDivisor O,
    P.valuation K (algebraMap O K g) = exp (-(div K g P : ℤ))

def mem_support_div : Prop :=
  ∀ (g : O), g ≠ 0 → ∀ P : PrimeDivisor O, P ∈ (div K g).support ↔ g ∈ P.ideal

/-- `O(-div g) = gO`. -/
def divisorIdeal_div : Prop := ∀ g : O, g ≠ 0 → divisorIdeal K (div K g) = Ideal.span {g}

/-- The chain condition from Krull dimension at most 2. -/
def divisorChain_of_krullDimLE_two : Prop := Ring.KrullDimLE 2 O → DivisorChain O

/-- Finiteness: `O/(P + I)` has finite length when `I` is not contained in `P`. -/
def length_quotient_sup_ne_top : Prop :=
  DivisorChain O → ∀ (P : PrimeDivisor O) (I : Ideal O), ¬ I ≤ P.ideal →
    Module.length O (O ⧸ (P.ideal ⊔ I)) ≠ ⊤

/-- `O(-L)` is not contained in a prime divisor outside the support of `L`. -/
def divisorIdeal_not_le : Prop :=
  ∀ (L : Divisor O) (P : PrimeDivisor O), L P = 0 → ¬ divisorIdeal K L ≤ P.ideal

/-- `length O/(O(-L) + gO) = Σ_P L(P) · length O/(P + gO)` for `g` in no prime of the support of `L`. -/
def length_quotient_divisorIdeal_sup_span : Prop :=
  DivisorChain O → ∀ (g : O) (L : Divisor O), (∀ P ∈ L.support, g ∉ P.ideal) →
    Module.length O (O ⧸ (divisorIdeal K L ⊔ Ideal.span {g})) =
      L.sum fun P n => (n : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ Ideal.span {g}))

/-- `O/(O(-L) + gO)` has finite length for `g` in no prime of the support of `L`. -/
def length_quotient_divisorIdeal_sup_span_ne_top : Prop :=
  DivisorChain O → ∀ (g : O) (L : Divisor O), (∀ P ∈ L.support, g ∉ P.ideal) →
    Module.length O (O ⧸ (divisorIdeal K L ⊔ Ideal.span {g})) ≠ ⊤

/-- For `g ≠ 0` a constant `K'` with `Σ_P ord_P(g) · length O/(P + O(-L)) ≤ length O/(O(-L) + gO) + K'`
for every `L` whose support avoids the primes that contain `g`. -/
def exists_bound_sum_length_quotient : Prop :=
  DivisorChain O → ∀ g : O, g ≠ 0 → ∃ K' : ℕ, ∀ L : Divisor O, (∀ P ∈ L.support, g ∉ P.ideal) →
    ((div K g).sum fun P e => (e : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ divisorIdeal K L))) ≤
      Module.length O (O ⧸ (divisorIdeal K L ⊔ Ideal.span {g})) + K'

/-- The two statements above joined for the multiples `n • L`, with one constant for all `L` and `n`. -/
def exists_bound_sum_length_quotient_nsmul : Prop :=
  DivisorChain O → ∀ g : O, g ≠ 0 → ∃ K' : ℕ, ∀ L : Divisor O, (∀ P ∈ L.support, g ∉ P.ideal) →
    ∀ n : ℕ,
      ((div K g).sum fun P e =>
        (e : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ divisorIdeal K (n • L)))) ≤
      n * (L.sum fun P m => (m : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ Ideal.span {g}))) + K'

/-- `Σ_P L(P) · length O/(P + gO) ≤ Σ_P ord_P(g) · length O/(P + uO)` for `g ≠ 0` in no prime of the
support of `L` and `u` in `O(-L)` and in no prime that contains `g`. -/
def sum_length_quotient_le : Prop :=
  DivisorChain O → ∀ g : O, g ≠ 0 → ∀ L : Divisor O, (∀ P ∈ L.support, g ∉ P.ideal) →
    ∀ u ∈ divisorIdeal K L, (∀ P ∈ (div K g).support, u ∉ P.ideal) →
      (L.sum fun P n => (n : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ Ideal.span {g}))) ≤
        (div K g).sum fun P e => (e : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ Ideal.span {u}))

end Statement

namespace Proved

variable (O) [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O] [IsFractionRing O K]

theorem valuation_spec : Statement.valuation_spec O K := fun P => P.isValuation_valuation K

theorem valuation_unique : Statement.valuation_unique O K := fun P v h => P.valuation_unique K v h

theorem valuation_le_one_iff : Statement.valuation_le_one_iff O K := fun P x => P.valuation_le_one_iff K x

theorem mem_range_of_valuation_le_one : Statement.mem_range_of_valuation_le_one O K :=
  ProximityPrize.SubmissionLower.FormalR.mem_range_of_valuation_le_one K

omit [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O] [IsFractionRing O K] in
theorem mem_divisorIdeal : Statement.mem_divisorIdeal O K :=
  fun _ _ => ProximityPrize.SubmissionLower.FormalR.mem_divisorIdeal K

theorem valuation_eq_exp_neg_div : Statement.valuation_eq_exp_neg_div O K :=
  fun _ hg P => ProximityPrize.SubmissionLower.FormalR.valuation_eq_exp_neg_div K hg P

theorem mem_support_div : Statement.mem_support_div O K :=
  fun _ hg P => ProximityPrize.SubmissionLower.FormalR.mem_support_div K hg P

theorem divisorIdeal_div : Statement.divisorIdeal_div O K :=
  fun _ hg => ProximityPrize.SubmissionLower.FormalR.divisorIdeal_div K hg

omit [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O] in
theorem divisorChain_of_krullDimLE_two : Statement.divisorChain_of_krullDimLE_two O :=
  fun _ => ProximityPrize.SubmissionLower.FormalR.divisorChain_of_krullDimLE_two

omit [IsDomain O] [IsIntegrallyClosed O] in
theorem length_quotient_sup_ne_top : Statement.length_quotient_sup_ne_top O :=
  fun hO P _ hI => ProximityPrize.SubmissionLower.FormalR.length_quotient_sup_ne_top hO P hI

theorem divisorIdeal_not_le : Statement.divisorIdeal_not_le O K :=
  fun _ _ h => ProximityPrize.SubmissionLower.FormalR.divisorIdeal_not_le K h

theorem length_quotient_divisorIdeal_sup_span :
    Statement.length_quotient_divisorIdeal_sup_span O K := fun hO g L hg =>
  ProximityPrize.SubmissionLower.FormalR.length_quotient_divisorIdeal_sup_span K hO g L hg

theorem length_quotient_divisorIdeal_sup_span_ne_top :
    Statement.length_quotient_divisorIdeal_sup_span_ne_top O K := fun hO g L hg =>
  ProximityPrize.SubmissionLower.FormalR.length_quotient_divisorIdeal_sup_span_ne_top K hO g L hg

theorem exists_bound_sum_length_quotient : Statement.exists_bound_sum_length_quotient O K := fun hO _ hg =>
  ProximityPrize.SubmissionLower.FormalR.exists_bound_sum_length_quotient K hO hg

theorem exists_bound_sum_length_quotient_nsmul :
    Statement.exists_bound_sum_length_quotient_nsmul O K := fun hO _ hg =>
  ProximityPrize.SubmissionLower.FormalR.exists_bound_sum_length_quotient_nsmul K hO hg

theorem sum_length_quotient_le : Statement.sum_length_quotient_le O K := fun hO _ hg L hL _ hu hu' =>
  ProximityPrize.SubmissionLower.FormalR.sum_length_quotient_le K hO hg L hL hu hu'

end Proved

end ProximityPrize.SubmissionLower.FormalR
end
section

/-!
The integral closure `C` of `E[s₀, s₁]` in a field `L`, for `s₀`, `s₁` algebraically independent over a
field `E`: `C` is integrally closed with fraction field `L` when `L` is
algebraic over `E(s₀, s₁)`, every chain of primes `0 < p < p'` of `C` ends at a maximal ideal, `C` is of
finite type over `E` when `L` is finite and separable over `E(s₀, s₁)`, a prime of height one of `C`
contains no nonzero polynomial in `s_j` alone for one `j` (going down), and the centre on `C` of a
valuation that is trivial on `E(t)` for a transcendental `t` of `C` is not a maximal ideal (Zariski's
lemma). The last section compares the primes of two subalgebras of `L` one of which is a ring of
fractions of the other.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero

namespace Surf

/-! ## Chains of primes -/

section Chain

theorem primeChain_of_ringKrullDim_le {A : Type*} [CommRing A] [IsDomain A]
    (h : ringKrullDim A ≤ 2) : PrimeChain A := by
  intro p p' hp hp' hp0 hlt
  by_contra hmax
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal p' hp'.ne_top
  have hm' := hm.isPrime
  have hlt' : p' < m := lt_of_le_of_ne hle fun h => hmax (h ▸ hm)
  have h1 := Ideal.height_add_one_le_of_lt_of_isPrime (bot_lt_iff_ne_bot.mpr hp0)
  have h2 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
  have h3 := Ideal.height_add_one_le_of_lt_of_isPrime hlt'
  have h4 : (m.height : WithBot ℕ∞) ≤ ((2 : ℕ∞) : WithBot ℕ∞) :=
    Ideal.height_le_ringKrullDim_of_isPrime.trans h
  have h5 : m.height ≤ 2 := WithBot.coe_le_coe.mp h4
  rw [Ideal.height_bot, zero_add] at h1
  have h6 : (1 : ℕ∞) + 1 + 1 ≤ m.height :=
    (add_le_add_left ((add_le_add_left h1 1).trans h2) 1).trans h3
  exact absurd (h6.trans h5) (by decide)

theorem primeChain_of_isIntegral {A B : Type*} [CommRing A] [Nontrivial A] [CommRing B] [IsDomain B]
    [Algebra A B] [Algebra.IsIntegral A B] (h : PrimeChain A) : PrimeChain B := by
  intro p p' hp hp' hp0 hlt
  have h3 : p.under A ≠ ⊥ := fun h0 => hp0 (Ideal.eq_bot_of_under_eq_bot h0)
  obtain ⟨x, hx', hx⟩ := SetLike.exists_of_lt hlt
  have h4 : p.under A < p'.under A :=
    Ideal.under_lt_under_of_integral_mem_sdiff hlt.le ⟨hx', hx⟩ (Algebra.IsIntegral.isIntegral x)
  have h5 := h _ _ (hp.under A) (hp'.under A) h3 h4
  exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A B)
    (algebraMap_isIntegral_iff.mpr inferInstance) p' h5

end Chain

/-! ## The polynomial ring `E[s₀, s₁]` -/

section Plane

variable {E L : Type*} [Field E] [Field L] [Algebra E L] {s : Fin 2 → L}
  (hs : AlgebraicIndependent E s)
include hs

theorem plane_isNoetherianRing : IsNoetherianRing (Algebra.adjoin E (Set.range s)) :=
  isNoetherianRing_of_ringEquiv _ hs.aevalEquiv.toRingEquiv

theorem plane_isIntegrallyClosed : IsIntegrallyClosed (Algebra.adjoin E (Set.range s)) := by
  have : UniqueFactorizationMonoid (Algebra.adjoin E (Set.range s)) :=
    hs.aevalEquiv.toMulEquiv.uniqueFactorizationMonoid inferInstance
  infer_instance

theorem plane_primeChain : PrimeChain (Algebra.adjoin E (Set.range s)) := by
  apply primeChain_of_ringKrullDim_le
  rw [← ringKrullDim_eq_of_ringEquiv hs.aevalEquiv.toRingEquiv,
    MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field,
    Nat.card_eq_fintype_card, Fintype.card_fin, zero_add]
  rfl

end Plane

/-! ## The integral closure of `E[s₀, s₁]` in `L` -/

section Closure

open scoped IntermediateField.algebraAdjoinAdjoin

variable {E L : Type*} [Field E] [Field L] [Algebra E L] {s : Fin 2 → L}

/-- The integral closure of a chart ring that is integral over `E[s₀, s₁]` and contains it. -/
theorem mem_integralClosure_iff {R : Subalgebra E L} (hsR : ∀ j, s j ∈ R)
    (hint : ∀ a ∈ R, IsIntegral (Algebra.adjoin E (Set.range s)) a) (x : L) :
    x ∈ (integralClosure R L).restrictScalars E ↔ IsIntegral (Algebra.adjoin E (Set.range s)) x := by
  have hle : Algebra.adjoin E (Set.range s) ≤ R :=
    Algebra.adjoin_le (by rintro _ ⟨j, rfl⟩; exact hsR j)
  let _ : Algebra (Algebra.adjoin E (Set.range s)) R := (Subalgebra.inclusion hle).toRingHom.toAlgebra
  have _ : IsScalarTower (Algebra.adjoin E (Set.range s)) R L :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : Algebra.IsIntegral (Algebra.adjoin E (Set.range s)) R :=
    ⟨fun a => (isIntegral_algebraMap_iff (B := L)).mp (hint a a.2)⟩
  exact ⟨fun hx => isIntegral_trans x hx, fun hx => hx.tower_top⟩

variable {C : Subalgebra E L}
  (hC : ∀ x : L, x ∈ C ↔ IsIntegral (Algebra.adjoin E (Set.range s)) x)
include hC

theorem adjoin_le_closure : Algebra.adjoin E (Set.range s) ≤ C := fun x hx =>
  (hC x).mpr (isIntegral_algebraMap (x := (⟨x, hx⟩ : Algebra.adjoin E (Set.range s))))

theorem closure_isFractionRing
    (halg : ∀ a : L, IsAlgebraic (IntermediateField.adjoin E (Set.range s)) a) :
    IsFractionRing C L := by
  let _ : Algebra (Algebra.adjoin E (Set.range s)) C :=
    (Subalgebra.inclusion (adjoin_le_closure hC)).toRingHom.toAlgebra
  have _ : IsScalarTower (Algebra.adjoin E (Set.range s)) C L :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : IsIntegralClosure C (Algebra.adjoin E (Set.range s)) L :=
    ⟨Subtype.val_injective, fun {x} => ⟨fun h => ⟨⟨x, (hC x).mpr h⟩, rfl⟩,
      fun ⟨y, hy⟩ => hy ▸ (hC y).mp y.2⟩⟩
  have _ : Algebra.IsAlgebraic (Algebra.adjoin E (Set.range s)) L :=
    ⟨fun a => (IsFractionRing.isAlgebraic_iff (Algebra.adjoin E (Set.range s))
      (IntermediateField.adjoin E (Set.range s)) L).mpr (halg a)⟩
  exact IsIntegralClosure.isFractionRing_of_algebraic (Algebra.adjoin E (Set.range s)) C
    fun x hx => Subtype.ext hx

theorem closure_isIntegrallyClosed
    (halg : ∀ a : L, IsAlgebraic (IntermediateField.adjoin E (Set.range s)) a) :
    IsIntegrallyClosed C := by
  have := closure_isFractionRing hC halg
  let _ : Algebra (Algebra.adjoin E (Set.range s)) C :=
    (Subalgebra.inclusion (adjoin_le_closure hC)).toRingHom.toAlgebra
  have _ : IsScalarTower (Algebra.adjoin E (Set.range s)) C L :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : Algebra.IsIntegral (Algebra.adjoin E (Set.range s)) C :=
    ⟨fun a => (isIntegral_algebraMap_iff (B := L)).mp ((hC a).mp a.2)⟩
  exact (isIntegrallyClosed_iff L).mpr fun {x} hx => ⟨⟨x, (hC x).mpr (isIntegral_trans x hx)⟩, rfl⟩

theorem closure_primeChain (hs : AlgebraicIndependent E s) : PrimeChain C := by
  let _ : Algebra (Algebra.adjoin E (Set.range s)) C :=
    (Subalgebra.inclusion (adjoin_le_closure hC)).toRingHom.toAlgebra
  have _ : IsScalarTower (Algebra.adjoin E (Set.range s)) C L :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : Algebra.IsIntegral (Algebra.adjoin E (Set.range s)) C :=
    ⟨fun a => (isIntegral_algebraMap_iff (B := L)).mp ((hC a).mp a.2)⟩
  exact primeChain_of_isIntegral (plane_primeChain hs)

theorem closure_finiteType (hs : AlgebraicIndependent E s)
    [FiniteDimensional (IntermediateField.adjoin E (Set.range s)) L]
    [Algebra.IsSeparable (IntermediateField.adjoin E (Set.range s)) L] :
    Algebra.FiniteType E C := by
  let _ : Algebra (Algebra.adjoin E (Set.range s)) C :=
    (Subalgebra.inclusion (adjoin_le_closure hC)).toRingHom.toAlgebra
  have _ : IsScalarTower (Algebra.adjoin E (Set.range s)) C L :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : IsScalarTower E (Algebra.adjoin E (Set.range s)) C :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : IsIntegralClosure C (Algebra.adjoin E (Set.range s)) L :=
    ⟨Subtype.val_injective, fun {x} => ⟨fun h => ⟨⟨x, (hC x).mpr h⟩, rfl⟩,
      fun ⟨y, hy⟩ => hy ▸ (hC y).mp y.2⟩⟩
  have _ := plane_isNoetherianRing hs
  have _ := plane_isIntegrallyClosed hs
  have _ : Module.Finite (Algebra.adjoin E (Set.range s)) C :=
    IsIntegralClosure.finite (Algebra.adjoin E (Set.range s))
      (IntermediateField.adjoin E (Set.range s)) L C
  have h1 : Algebra.FiniteType E (Algebra.adjoin E (Set.range s)) :=
    Algebra.FiniteType.equiv inferInstance hs.aevalEquiv
  exact h1.trans inferInstance

/-- A prime of height one of the closure contains no nonzero polynomial in `s_j` alone, for one
`j`. -/
theorem closure_exists_disjoint (hs : AlgebraicIndependent E s) [IsNoetherianRing C] (Q : Ideal C)
    [Q.IsPrime] (hQ : Q.height = 1) :
    ∃ j, ∀ a : C, a ∈ Q → (a : L) ∈ Algebra.adjoin E {s j} → a = 0 := by
  let _ : Algebra (Algebra.adjoin E (Set.range s)) C :=
    (Subalgebra.inclusion (adjoin_le_closure hC)).toRingHom.toAlgebra
  have _ : IsScalarTower (Algebra.adjoin E (Set.range s)) C L :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : Algebra.IsIntegral (Algebra.adjoin E (Set.range s)) C :=
    ⟨fun a => (isIntegral_algebraMap_iff (B := L)).mp ((hC a).mp a.2)⟩
  have _ := plane_isNoetherianRing hs
  have _ := plane_isIntegrallyClosed hs
  have _ : FaithfulSMul (Algebra.adjoin E (Set.range s)) C :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr
      (Subalgebra.inclusion_injective (adjoin_le_closure hC))
  have h1 := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
    (Q.under (Algebra.adjoin E (Set.range s))) Q
  have h2 : (Q.under (Algebra.adjoin E (Set.range s))).height ≤ 1 := by
    rw [← hQ, h1]
    exact le_self_add
  have h3 : Q.under (Algebra.adjoin E (Set.range s)) ≠ ⊥ := fun h0 =>
    Ideal.ne_bot_of_height_eq_one hQ (Ideal.eq_bot_of_under_eq_bot h0)
  have h4 : (Q.under (Algebra.adjoin E (Set.range s))).height = 1 := by
    refine le_antisymm h2 ?_
    have h5 := Ideal.height_add_one_le_of_lt_of_isPrime (bot_lt_iff_ne_bot.mpr h3)
    rwa [Ideal.height_bot, zero_add] at h5
  have _ : IsDiscreteValuationRing
      (Localization.AtPrime (Q.under (Algebra.adjoin E (Set.range s)))) :=
    isDiscreteValuationRing_of_height_eq_one _ h4 _
  obtain ⟨j, hj⟩ := Chart.exists_adjoin_singleton_disjoint s hs
    (Q.under (Algebra.adjoin E (Set.range s)))
  refine ⟨j, fun a haQ ha => ?_⟩
  have haP : (a : L) ∈ Algebra.adjoin E (Set.range s) :=
    Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_range_self j)) ha
  have h6 := hj ⟨a, haP⟩ (show algebraMap (Algebra.adjoin E (Set.range s)) C ⟨a, haP⟩ ∈ Q from haQ) ha
  have h7 : ((⟨a, haP⟩ : Algebra.adjoin E (Set.range s)) : L) =
      ((0 : Algebra.adjoin E (Set.range s)) : L) := congrArg _ h6
  exact Subtype.ext h7

end Closure

/-! ## Residue fields and centres -/

section Residue

variable {E : Type*} [Field E] {A : Type*} [CommRing A] [Algebra E A] [Algebra.FiniteType E A]

/-- Zariski's lemma for a closed point of an algebra of finite type. -/
theorem isIntegral_quotient (m : Ideal A) [m.IsMaximal] : Algebra.IsIntegral E (A ⧸ m) := by
  let _ : Field (A ⧸ m) := Ideal.Quotient.field m
  have _ : Algebra.FiniteType E (A ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ E m) (Ideal.Quotient.mkₐ_surjective E m)
  have _ : Module.Finite E (A ⧸ m) := finite_of_finite_type_of_isJacobsonRing E (A ⧸ m)
  exact Algebra.IsIntegral.of_finite E (A ⧸ m)

theorem residue_bijective [IsAlgClosed E] (m : Ideal A) [m.IsMaximal] :
    Function.Bijective (algebraMap E (A ⧸ m)) := by
  have := isIntegral_quotient (E := E) m
  exact IsAlgClosed.algebraMap_bijective_of_isIntegral

variable {L : Type*} [Field L] [Algebra E L] [Algebra A L] [IsScalarTower E A L]

/-- The centre of a valuation that is trivial on `E(t)`, for a transcendental `t` of the ring, is not
a closed point. -/
theorem not_isMaximal_centre (ν : Valuation L ℤᵐ⁰) (h : ∀ a : A, ν (algebraMap A L a) ≤ 1) (t : A)
    (htr : Transcendental E (algebraMap A L t))
    (h1 : ∀ a ∈ IntermediateField.adjoin E {algebraMap A L t}, a ≠ 0 → ν a = 1) :
    ¬(centre L ν h).IsMaximal := by
  intro hmax
  have hint := isIntegral_quotient (E := E) (centre L ν h)
  obtain ⟨f, hf, hf0⟩ := Algebra.IsIntegral.isIntegral (R := E)
    (Ideal.Quotient.mk (centre L ν h) t)
  have h2 : Polynomial.aeval t f ∈ centre L ν h := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact (Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ E (centre L ν h)) t f).symm.trans hf0
  have h3 : ν (algebraMap A L (Polynomial.aeval t f)) < 1 := h2
  rw [← Polynomial.aeval_algebraMap_apply] at h3
  have h4 : Polynomial.aeval (algebraMap A L t) f ≠ 0 := fun h0 => htr ⟨f, hf.ne_zero, h0⟩
  have h5 : Polynomial.aeval (algebraMap A L t) f ∈ IntermediateField.adjoin E {algebraMap A L t} :=
    IntermediateField.algebra_adjoin_le_adjoin E _ (Polynomial.aeval_mem_adjoin_singleton E _)
  exact absurd (h1 _ h5 h4) h3.ne

end Residue

section Trivial

variable {E L : Type*} [Field E] [Field L] [Algebra E L]

/-- A valuation that is at most 1 on `E[t]` and less than 1 at no nonzero element of it is trivial
on `E(t)`. -/
theorem trivial_on_adjoin_singleton (ν : Valuation L ℤᵐ⁰) (t : L)
    (hle : ∀ a ∈ Algebra.adjoin E {t}, ν a ≤ 1) (hdisj : ∀ a ∈ Algebra.adjoin E {t}, ν a < 1 → a = 0) :
    ∀ a ∈ IntermediateField.adjoin E {t}, a ≠ 0 → ν a = 1 := by
  have hunit : ∀ a ∈ Algebra.adjoin E {t}, a ≠ 0 → ν a = 1 := fun a ha ha0 =>
    le_antisymm (hle a ha) (not_lt.mp fun hlt => ha0 (hdisj a ha hlt))
  intro a ha ha0
  obtain ⟨r, hr, q, hq, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp ha
  have hq0 : q ≠ 0 := fun h => ha0 (by rw [h, div_zero])
  have hr0 : r ≠ 0 := fun h => ha0 (by rw [h, zero_div])
  rw [map_div₀, hunit r hr hr0, hunit q hq hq0, div_one]

/-- A valuation that is at most 1 on a ring is at most 1 on the elements that are integral over it. -/
theorem valuation_le_one_of_isIntegral {A : Type*} [CommRing A] [Algebra A L] (ν : Valuation L ℤᵐ⁰)
    (hA : ∀ a : A, ν (algebraMap A L a) ≤ 1) {x : L} (hx : IsIntegral A x) : ν x ≤ 1 := by
  obtain ⟨f, hf, hfx⟩ := hx
  let φ : A →+* ν.valuationSubring := (algebraMap A L).codRestrict ν.valuationSubring hA
  refine (Valuation.valuationSubring.integers ν).isIntegral_iff_v_le_one.mp
    ⟨f.map φ, hf.map φ, ?_⟩
  rw [Polynomial.eval₂_map]
  exact hfx

end Trivial

/-! ## Rings of fractions inside `L` -/

section Fractions

variable {E L : Type*} [Field E] [Field L] [Algebra E L] {C O : Subalgebra E L}

/-- The primes of a ring of fractions `O` of `C` restrict to primes of `C` of the same height. -/
theorem exists_under_of_fractions (hle : C ≤ O)
    (hfrac : ∀ x ∈ O, ∃ s ∈ C, s ≠ 0 ∧ s⁻¹ ∈ O ∧ x * s ∈ C) (Q : Ideal O) [Q.IsPrime] :
    ∃ Q' : Ideal C, Q'.IsPrime ∧ Q'.height = Q.height ∧
      ∀ a : C, a ∈ Q' ↔ Subalgebra.inclusion hle a ∈ Q := by
  let _ : Algebra C O := (Subalgebra.inclusion hle).toRingHom.toAlgebra
  let S : Submonoid C := (IsUnit.submonoid O).comap (algebraMap C O)
  have hloc : IsLocalization S O := by
    refine (isLocalization_iff S O).mpr ⟨fun y => y.2, fun z => ?_, fun {x y} hxy => ⟨1, ?_⟩⟩
    · obtain ⟨s, hs, hs0, hsinv, hzs⟩ := hfrac z z.2
      have hu : IsUnit (algebraMap C O ⟨s, hs⟩) :=
        isUnit_iff_exists_inv.mpr ⟨⟨s⁻¹, hsinv⟩, Subtype.ext (mul_inv_cancel₀ hs0)⟩
      exact ⟨(⟨z * s, hzs⟩, ⟨⟨s, hs⟩, hu⟩), Subtype.ext rfl⟩
    · rw [Subalgebra.inclusion_injective hle hxy]
  exact ⟨Q.under C, inferInstance, IsLocalization.height_under S Q, fun a => Iff.rfl⟩

end Fractions

end Surf

end ProximityPrize.SubmissionLower.FormalR
end
