/-!
The section bound on one geometric component `G = (g)` over `E`.

For a section `s` with the needs, a moving function `f = Q + A Gs / H` and a level `c`:

    Σ_B ord_B(L_c) Σ_{v ∈ T B} flagPole_v(W) ≤ Σ_D Σ_{ν ∈ V D} zeros_ν((f - c) restricted to D)

over the components `B` of the level curve and the components `D` of the section on which `H` does not
vanish (`Sec.component_count`). The places `V D` do not depend on the sets `T B`.

The steps: poles of the flag are at most zeros of `s` on `B` (`Sec.exists_zeros_bound`); a zero lies over
a point `q` of the surface where the polynomials and `1 / H` are regular (`Sec.exists_finite_point`); at
`q` the conversion `PlaceSurf.surfacePoint_length_eq_zeros` on `B` and on the components of the section,
and `Sec.local_sum_le`, give `Sec.local_le`; a place lies over one point
(`SurfacePoint.eq_of_place`).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.Sec

open scoped Classical
open WithZero MvPolynomial
open RCN002 RCN072 RCN095 RCN264

noncomputable section

section Places

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime]
  {F : Type*} [Field F] [Algebra E F]

/-- The places of the curve over the point `q`; none when the curve does not pass through `q`. -/
def placesAt (S : Specialization (AJ E G) F) (q : SurfacePoint G) : Set (RCN026.Place E F) :=
  {μ | ∃ hq : q.On S, μ ∈ S.placesOn E hq}

theorem placesAt_of_on (S : Specialization (AJ E G) F) (q : SurfacePoint G) (hq : q.On S) :
    placesAt S q = S.placesOn E hq :=
  Set.ext fun _ => ⟨fun ⟨_, h⟩ => h, fun h => ⟨hq, h⟩⟩

/-- The zeros of a function `y` of the curve at the places over the point `q`. -/
def zerosAt (S : Specialization (AJ E G) F) (q : SurfacePoint G) (y : F) : ℕ :=
  ∑ᶠ μ ∈ placesAt S q, (RCN026.order E F μ y).toNat

theorem zerosAt_of_not_on (S : Specialization (AJ E G) F) (q : SurfacePoint G) (hq : ¬q.On S)
    (y : F) : zerosAt S q y = 0 := by
  rw [zerosAt, show placesAt S q = ∅ from Set.eq_empty_of_forall_notMem fun _ ⟨h, _⟩ => hq h,
    finsum_mem_empty]

/-- Zeros at finitely many places, each over a point of a finite set, are at most the zeros over the
points of the set. -/
theorem sum_le_sum_zerosAt (S : Specialization (AJ E G) F) (y : F)
    (Zs : Finset (RCN026.Place E F))
    (hfin : {μ : RCN026.Place E F | (RCN026.order E F μ y).toNat ≠ 0}.Finite)
    (pt : RCN026.Place E F → SurfacePoint G) (Qs : Finset (SurfacePoint G))
    (hpt : ∀ v ∈ Zs, pt v ∈ Qs ∧ v ∈ placesAt S (pt v)) :
    ∑ v ∈ Zs, (RCN026.order E F v y).toNat ≤ ∑ q ∈ Qs, zerosAt S q y := by
  rw [← Finset.sum_fiberwise_of_maps_to (g := pt) (t := Qs) fun v hv => (hpt v hv).1]
  refine Finset.sum_le_sum fun q _ => sum_le_finsum_mem _ _ _ (fun v hv => ?_)
    (hfin.subset fun μ hμ => hμ.2)
  obtain ⟨hvZ, rfl⟩ := Finset.mem_filter.mp hv
  exact (hpt v hvZ).2

/-- The zeros over the points of a finite set are at most all the zeros: a place lies over one point. -/
theorem sum_zerosAt_le (hc : ∀ j, coordinate E G j ≠ 0) (S : Specialization (AJ E G) F) (y : F)
    (Qs : Finset (SurfacePoint G)) (V : Finset (RCN026.Place E F))
    (hV : ∀ μ, (RCN026.order E F μ y).toNat ≠ 0 → μ ∈ V) :
    ∑ q ∈ Qs, zerosAt S q y ≤ ∑ μ ∈ V, (RCN026.order E F μ y).toNat :=
  sum_finsum_mem_le Qs (placesAt S) _ V hV fun q _ q' _ μ ⟨hq, h⟩ ⟨hq', h'⟩ =>
    SurfacePoint.eq_of_place hc S q q' hq hq' μ h h'

theorem val_lt_one_of_order_toNat_ne_zero (μ : RCN026.Place E F) (y : F)
    (h : (RCN026.order E F μ y).toNat ≠ 0) : μ.val y < 1 := by
  have hpos : 0 < RCN026.order E F μ y := by omega
  rw [RCN026.order, neg_pos] at hpos
  have h0 : μ.val y ≠ 0 := fun h0 => by
    rw [h0, log_zero] at hpos
    exact lt_irrefl _ hpos
  rw [← exp_zero]
  exact (log_lt_iff_lt_exp h0).mp hpos

end Places

section Curve

variable {E : Type} [Field E] [IsAlgClosed E]

/-- On a curve with a separable literal coordinate a function has zeros at finitely many places. -/
theorem exists_zero_places (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (sep : RCN341.BP C)
    (x : AJ E C) : ∃ V : Finset (RCN026.Place E (AJ E C)),
      ∀ μ, (RCN026.order E (AJ E C) μ x).toNat ≠ 0 → μ ∈ V := by
  let _ := RCN006.IP E C sep.index
  let _ := RCN005.DT E C sep.index sep.transcendental
  let _ := RCN006.IU E C sep.index
  let _ := RCN006._Q5 E C sep.index sep.transcendental
  let _ := RCN005.IS E C sep.index sep.transcendental
  let _ : FiniteDimensional (RatFunc E) (AJ E C) := sep.finite
  let _ : Algebra.IsSeparable (RatFunc E) (AJ E C) := sep.separable
  by_cases hx : x = 0
  · refine ⟨∅, fun μ hμ => absurd ?_ hμ⟩
    rw [hx, RCN026.order, map_zero, log_zero, neg_zero, Int.toNat_zero]
  · exact ⟨RCN026.placesFor E (AJ E C) x hx, fun μ hμ =>
      RCN026.ALB E (AJ E C) x hx μ fun h0 => hμ (by rw [h0, Int.toNat_zero])⟩

end Curve

/-! ## The count on one geometric component -/

section Component

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime]

attribute [local instance] SurfacePoint.isNoetherianRing SurfacePoint.isIntegrallyClosed
  SurfacePoint.isFractionRing LevelComponent.isPrime

local notation "Poly" => MvPolynomial (Fin 3) E

/-- The standing hypotheses of the section bound on one geometric component `G = (g)` over `E`: the model
(`algClosed`, `charP`, `noether`, `char`, `coord`, `irreducible`, `span`), `H` is not zero on the surface
and lies in the ideal of `g` and its `R`-derivative, the section `s` has multiplicity one along its
components (`not_dvd`, `localGen`: from `GoodSection`), the needs of the section on the components of the
level curve, and a separable literal coordinate on the components of the level curve and of the section. -/
structure Setup (G : Ideal (MvPolynomial (Fin 3) E)) [G.IsPrime] (N p : ℕ)
    (g H Gs Q A : MvPolynomial (Fin 3) E) (c : E) (W : FlagDegree) (s : MvPolynomial (Fin 3) E) :
    Prop where
  algClosed : IsAlgClosed E
  charP : CharP E p
  noether : ∀ sR sY sZ, SurfaceNoether G sR sY sZ N
  char : 3 * N < p
  coord : ∀ j, coordinate E G j ≠ 0
  irreducible : Irreducible g
  span : G = Ideal.span {g}
  unitH : BR E G H ≠ 0
  memH : H ∈ Ideal.span {g, pderiv 1 g}
  not_dvd : ¬g ∣ s
  localGen : ∀ C ∈ AUR E g s, LocalGen g s C
  needs : ComponentNeeds G H (RCN208.movingValue G H Gs Q A) c W s
  sep : ∀ B : LevelComponent G (RCN208.movingValue G H Gs Q A) c, Nonempty (RCN341.BP B.prime)
  sepD : ∀ D : AU E g s H, Nonempty (RCN341.BP D.1)

variable {N p : ℕ} {g H Gs Q A : MvPolynomial (Fin 3) E} {c : E} {W : FlagDegree}
  {s : MvPolynomial (Fin 3) E}

theorem Setup.mem (M : Setup G N p g H Gs Q A c W s) : g ∈ G :=
  M.span ▸ Ideal.mem_span_singleton_self g

/-- Every component of the section on which `H` does not vanish is a curve of the surface. -/
theorem Setup.exists_sectionCurve (M : Setup G N p g H Gs Q A c W s) (D : AU E g s H) :
    ∃ S : Specialization (AJ E G) (AJ E D.1), IsCurveOnSurface G D.1 S := by
  refine exists_curve g s M.irreducible M.span M.not_dvd D.1 (AAS E g s H D) fun hd => ?_
  refine _Q6 E g s H D ((Ideal.span_le.mpr ?_) M.memH)
  rintro x (hx | hx)
  · rw [hx]
    exact EN E g s H D
  · rw [Set.mem_singleton_iff.mp hx]
    exact hd

/-- The component `D` of the section as a prime divisor with its residue map. -/
def Setup.sectionCurve (M : Setup G N p g H Gs Q A c W s) (D : AU E g s H) :
    Specialization (AJ E G) (AJ E D.1) :=
  (M.exists_sectionCurve D).choose

theorem Setup.sectionCurve_spec (M : Setup G N p g H Gs Q A c W s) (D : AU E g s H) :
    IsCurveOnSurface G D.1 (M.sectionCurve D) :=
  (M.exists_sectionCurve D).choose_spec

/-- At a point where the polynomials and `1 / H` are regular, every prime divisor through the point is a
curve on the surface on which `H` does not vanish. -/
theorem Setup.exists_curve_of_primeDivisor (M : Setup G N p g H Gs Q A c W s) (q : SurfacePoint G)
    (hpoly : ∀ B : Poly, BR E G B ∈ q.ring) (hHq : (BR E G H)⁻¹ ∈ q.ring)
    (Pd : PrimeDivisor q.ring) :
    ∃ (C : Ideal Poly) (_ : C.IsPrime) (S : Specialization (AJ E G) (AJ E C)),
      IsCurveOnSurface G C S ∧ S.val = Pd.valuation (AJ E G) ∧ C.height = 2 ∧ H ∉ C := by
  have := M.charP
  have hsd := q.surfaceDivisor M.noether M.char Pd
  have hle : ∀ B : Poly, Pd.valuation (AJ E G) (BR E G B) ≤ 1 := fun B =>
    Pd.valuation_le_one (AJ E G) ⟨BR E G B, hpoly B⟩
  have hH1 : Pd.valuation (AJ E G) (BR E G H) = 1 := by
    refine le_antisymm (hle H) ?_
    have h2 := Pd.valuation_le_one (AJ E G) ⟨(BR E G H)⁻¹, hHq⟩
    rw [show algebraMap q.ring (AJ E G) ⟨(BR E G H)⁻¹, hHq⟩ = (BR E G H)⁻¹ from rfl, map_inv₀] at h2
    exact (inv_le_one₀ (zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr M.unitH))).mp h2
  have hd : Pd.valuation (AJ E G) (BR E G (pderiv 1 g)) = 1 := by
    refine le_antisymm (hle _) ?_
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp M.memH
    have hBR : BR E G H = BR E G b * BR E G (pderiv 1 g) := by
      rw [← hab, map_add, map_mul, map_mul, (BR_eq_zero_iff (G := G) g).mpr M.mem, mul_zero,
        zero_add]
    rw [hBR, map_mul] at hH1
    calc (1 : ℤᵐ⁰) = Pd.valuation (AJ E G) (BR E G b) * Pd.valuation (AJ E G) (BR E G (pderiv 1 g)) :=
          hH1.symm
      _ ≤ 1 * Pd.valuation (AJ E G) (BR E G (pderiv 1 g)) := mul_le_mul' (hle b) le_rfl
      _ = _ := one_mul _
  obtain ⟨C, hC, S, hS, hval, hC2, -⟩ :=
    hsd.exists_isCurveOnSurface M.coord (fun j => hle (MvPolynomial.X j)) g M.irreducible M.span 1 hd
  refine ⟨C, hC, S, hS, hval, hC2, fun hHC => ?_⟩
  have hlt := (curve_val_lt_one_iff hS H).mpr hHC
  rw [hval, hH1] at hlt
  exact lt_irrefl _ hlt

/-- At a point where the polynomials and `1 / H` are regular, `f - c` and the section have no common prime
divisor: a common one would be a component of the level curve inside the section (the need `ne`). -/
theorem Setup.not_mem_of_mem (M : Setup G N p g H Gs Q A c W s) (q : SurfacePoint G)
    (hpoly : ∀ B : Poly, BR E G B ∈ q.ring) (hHq : (BR E G H)⁻¹ ∈ q.ring) {φ sb : q.ring}
    (hφ : (φ : AJ E G) = RCN208.movingValue G H Gs Q A - algebraMap E (AJ E G) c)
    (hsb : (sb : AJ E G) = BR E G s) (Pd : PrimeDivisor q.ring) (hφP : φ ∈ Pd.ideal) :
    sb ∉ Pd.ideal := by
  intro hsP
  obtain ⟨C, hC, S, hS, hval, hC2, -⟩ := M.exists_curve_of_primeDivisor q hpoly hHq Pd
  have hlt : Pd.valuation (AJ E G)
      (RCN208.movingValue G H Gs Q A - algebraMap E (AJ E G) c) < 1 := by
    rw [← hφ]
    exact (Pd.valuation_lt_one_iff (AJ E G) φ).mpr hφP
  let B' : LevelComponent G (RCN208.movingValue G H Gs Q A) c :=
    ⟨Pd.valuation (AJ E G), hlt, C, hC, S, hS, hval, hC2⟩
  have hs' : s ∈ B'.prime := (curve_val_lt_one_iff B'.isCurve s).mp (by
    rw [B'.curve_val]
    show Pd.valuation (AJ E G) (BR E G s) < 1
    rw [← hsb]
    exact (Pd.valuation_lt_one_iff (AJ E G) sb).mpr hsP)
  exact M.needs.ne B' ((BR_eq_zero_iff (G := B'.prime) s).mpr hs')

/-- The multiplicity of a component of the level curve is the order of `f - c` along its prime divisor at
a point. -/
theorem mult_eq_div {q : SurfacePoint G} {f : AJ E G} (B : LevelComponent G f c) {φ : q.ring}
    (hφ0 : φ ≠ 0) (hφ : (φ : AJ E G) = f - algebraMap E (AJ E G) c) (P : PrimeDivisor q.ring)
    (hP : P.valuation (AJ E G) = B.curve.val) : B.mult = div (AJ E G) φ P := by
  have h := valuation_eq_exp_neg_div (AJ E G) hφ0 P
  rw [hP, B.curve_val] at h
  have h' : B.val (f - algebraMap E (AJ E G) c) = exp (-(div (AJ E G) φ P : ℤ)) := by
    rw [← hφ]
    exact h
  rw [LevelComponent.mult, h', log_exp, neg_neg, Int.toNat_natCast]

/-- The zeros of the section on a component of the level curve over a point are the length of the
quotient by the prime divisor of the component and the section (`PlaceSurf.surfacePoint_length_eq_zeros`). -/
theorem Setup.zerosAt_level_le (M : Setup G N p g H Gs Q A c W s) (q : SurfacePoint G) {sb : q.ring}
    (hsb : (sb : AJ E G) = BR E G s) (B : LevelComponent G (RCN208.movingValue G H Gs Q A) c)
    (hq : q.On B.curve) (P : PrimeDivisor q.ring)
    (hP : ∀ x : q.ring, x ∈ P.ideal ↔ B.curve.val (x : AJ E G) < 1) :
    ((zerosAt B.curve q (BR E B.prime s) : ℕ) : ℕ∞) ≤
      Module.length q.ring (q.ring ⧸ (P.ideal ⊔ Ideal.span {sb})) := by
  have := M.algClosed
  have := M.charP
  obtain ⟨sepB⟩ := M.sep B
  have hsbP : sb ∉ P.ideal := fun hmem => by
    have hlt := (hP sb).mp hmem
    rw [hsb] at hlt
    exact M.needs.ne B ((BR_eq_zero_iff (G := B.prime) s).mpr
      ((curve_val_lt_one_iff B.isCurve s).mp hlt))
  have hlen := PlaceSurf.surfacePoint_length_eq_zeros q B.curve hq
    (B.isCurve.finite_integralClosure M.coord q hq sepB) P.ideal hP sb hsbP
  have hres : B.curve.resOn hq sb = BR E B.prime s := by
    obtain ⟨hm', hr⟩ := B.isCurve s
    rw [← hr]
    show B.curve.res _ = B.curve.res _
    exact congrArg B.curve.res (Subtype.ext hsb)
  rw [hlen, hres, zerosAt, placesAt_of_on _ _ hq]

/-- At a point where the polynomials and `1 / H` are regular, a prime divisor along which the section
vanishes is a component of the section on which `H` does not vanish, and the section has order one along
it. -/
theorem Setup.exists_section_of_primeDivisor (M : Setup G N p g H Gs Q A c W s) (q : SurfacePoint G)
    (hpoly : ∀ B : Poly, BR E G B ∈ q.ring) (hHq : (BR E G H)⁻¹ ∈ q.ring) {sb : q.ring}
    (hsb : (sb : AJ E G) = BR E G s) (hsb0 : sb ≠ 0) (Pd : PrimeDivisor q.ring)
    (hsP : sb ∈ Pd.ideal) :
    ∃ D : AU E g s H, Pd.valuation (AJ E G) = (M.sectionCurve D).val ∧
      div (AJ E G) sb Pd = 1 := by
  obtain ⟨C, hC, S, hS, hval, hC2, hHC⟩ := M.exists_curve_of_primeDivisor q hpoly hHq Pd
  have hsC : s ∈ C := (curve_val_lt_one_iff hS s).mp (by
    rw [hval, ← hsb]
    exact (Pd.valuation_lt_one_iff (AJ E G) sb).mpr hsP)
  have hCmem : C ∈ AUR E g s :=
    mem_of_height_eq_two g s M.irreducible M.not_dvd C (hS.le M.mem) hsC hC2
  have hgen := M.localGen C hCmem
  have hvalP : ∀ B : Poly, Pd.valuation (AJ E G) (BR E G B) < 1 ↔ B ∈ C := fun B => by
    rw [← hval]
    exact curve_val_lt_one_iff hS B
  obtain ⟨D, hD⟩ : ∃ D : AU E g s H, D.1 = C := ⟨⟨C, (AJF E).mpr ⟨hCmem, hHC⟩⟩, rfl⟩
  subst hD
  have hRD : Pd.valuation (AJ E G) = (M.sectionCurve D).val :=
    val_eq_curve_val (M.sectionCurve_spec D) g s M.mem hgen hsC (Pd.valuation (AJ E G))
      (Pd.valuation_surjective (AJ E G))
      (fun B => Pd.valuation_le_one (AJ E G) ⟨BR E G B, hpoly B⟩) hvalP
  refine ⟨D, hRD, ?_⟩
  have h1 := valuation_eq_exp_neg_div (AJ E G) hsb0 Pd
  have h2 := curve_val_section (M.sectionCurve_spec D) g s M.mem hgen hsC
  rw [hRD, show algebraMap q.ring (AJ E G) sb = BR E G s from hsb, h2, exp_inj] at h1
  omega

/-- The length of the quotient by a component of the section and `f - c` at a point is the number of
zeros of `f - c` on the component over the point (`PlaceSurf.surfacePoint_length_eq_zeros`). -/
theorem Setup.length_le_zerosAt (M : Setup G N p g H Gs Q A c W s) (q : SurfacePoint G) {φ : q.ring}
    (hφ : (φ : AJ E G) = RCN208.movingValue G H Gs Q A - algebraMap E (AJ E G) c)
    (Pd : PrimeDivisor q.ring) (hφP : φ ∉ Pd.ideal) (D : AU E g s H)
    (hRD : Pd.valuation (AJ E G) = (M.sectionCurve D).val) :
    Module.length q.ring (q.ring ⧸ (Pd.ideal ⊔ Ideal.span {φ})) ≤
      ((zerosAt (M.sectionCurve D) q
        (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c) : ℕ) : ℕ∞) := by
  have := M.algClosed
  have := M.charP
  have hHC : H ∉ D.1 := _Q6 E g s H D
  have hqD : q.On (M.sectionCurve D) := fun x => by
    rw [← hRD]
    exact Pd.valuation_le_one (AJ E G) x
  have hPD : ∀ x : q.ring, x ∈ Pd.ideal ↔ (M.sectionCurve D).val (x : AJ E G) < 1 := fun x => by
    rw [← hRD]
    exact (Pd.valuation_lt_one_iff (AJ E G) x).symm
  obtain ⟨sepD⟩ := M.sepD D
  have hlen := PlaceSurf.surfacePoint_length_eq_zeros q (M.sectionCurve D) hqD
    ((M.sectionCurve_spec D).finite_integralClosure M.coord q hqD sepD) Pd.ideal hPD φ hφP
  have hBRc : ∀ (I : Ideal Poly) [I.IsPrime],
      BR E I (MvPolynomial.C c) = algebraMap E (AJ E I) c := fun I _ => by
    rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
  have hres : (M.sectionCurve D).resOn hqD φ =
      RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c := by
    obtain ⟨hf, hfr⟩ := (M.sectionCurve_spec D).res_movingValue H Gs Q A hHC
    obtain ⟨hcm, hcr⟩ := M.sectionCurve_spec D (MvPolynomial.C c)
    rw [← hfr, ← hBRc D.1, ← hcr, ← map_sub]
    show (M.sectionCurve D).res _ = (M.sectionCurve D).res _
    refine congrArg (M.sectionCurve D).res (Subtype.ext ?_)
    show (φ : AJ E G) = RCN208.movingValue G H Gs Q A - BR E G (MvPolynomial.C c)
    rw [hφ, hBRc G]
  rw [hlen, hres, zerosAt, placesAt_of_on _ _ hqD]

/-- The local inequality at a point where the polynomials and `1 / H` are regular: the zeros of the
section on the components of the level curve through the point, with the multiplicities of the level
curve, are at most the zeros of `f - c` on the components of the section through the point. -/
theorem Setup.local_le (M : Setup G N p g H Gs Q A c W s) (q : SurfacePoint G)
    (hpoly : ∀ B : Poly, BR E G B ∈ q.ring) (hHq : (BR E G H)⁻¹ ∈ q.ring)
    (sB : Finset (LevelComponent G (RCN208.movingValue G H Gs Q A) c)) :
    ∑ B ∈ sB, B.mult * zerosAt B.curve q (BR E B.prime s) ≤
      ∑ D : AU E g s H, zerosAt (M.sectionCurve D) q
        (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c) := by
  have := M.algClosed
  have := M.charP
  by_cases hf0 : RCN208.movingValue G H Gs Q A - algebraMap E (AJ E G) c = 0
  · refine le_trans (le_of_eq (Finset.sum_eq_zero fun B _ => ?_)) (Nat.zero_le _)
    have hm : B.mult = 0 := by
      rw [LevelComponent.mult, hf0, map_zero, log_zero, neg_zero, Int.toNat_zero]
    rw [hm, zero_mul]
  have hfq : RCN208.movingValue G H Gs Q A ∈ q.ring := by
    rw [RCN208.movingValue, div_eq_mul_inv]
    exact q.ring.add_mem (hpoly Q) (q.ring.mul_mem (q.ring.mul_mem (hpoly A) (hpoly Gs)) hHq)
  obtain ⟨φ, hφ⟩ : ∃ φ : q.ring,
      (φ : AJ E G) = RCN208.movingValue G H Gs Q A - algebraMap E (AJ E G) c :=
    ⟨⟨_, q.ring.sub_mem hfq (q.ring.algebraMap_mem c)⟩, rfl⟩
  obtain ⟨sb, hsb⟩ : ∃ sb : q.ring, (sb : AJ E G) = BR E G s := ⟨⟨_, hpoly s⟩, rfl⟩
  have hφ0 : φ ≠ 0 := fun h0 => hf0 (by rw [← hφ, h0]; rfl)
  have hsb0 : sb ≠ 0 := fun h0 => M.not_dvd (by
    have h1 : BR E G s = 0 := by rw [← hsb, h0]; rfl
    exact Ideal.mem_span_singleton.mp (M.span ▸ (BR_eq_zero_iff (G := G) s).mp h1))
  have hdisj : ∀ Pd : PrimeDivisor q.ring, φ ∈ Pd.ideal → sb ∉ Pd.ideal :=
    M.not_mem_of_mem q hpoly hHq hφ hsb
  have hex : ∀ b : {B : LevelComponent G (RCN208.movingValue G H Gs Q A) c // q.On B.curve},
      ∃ P : PrimeDivisor q.ring, (∀ x : q.ring, x ∈ P.ideal ↔ b.1.curve.val (x : AJ E G) < 1) ∧
        P.valuation (AJ E G) = b.1.curve.val := fun b =>
    b.1.isCurve.exists_primeDivisor M.coord b.1.exists_transcendental q b.2
  choose Pb hPb1 hPb2 using hex
  have hsum : ∑ B ∈ sB, B.mult * zerosAt B.curve q (BR E B.prime s) =
      ∑ b ∈ sB.subtype (fun B => q.On B.curve),
        b.1.mult * zerosAt b.1.curve q (BR E b.1.prime s) := by
    rw [Finset.sum_subtype_eq_sum_filter (f := fun B : LevelComponent G
      (RCN208.movingValue G H Gs Q A) c => B.mult * zerosAt B.curve q (BR E B.prime s))]
    refine (Finset.sum_filter_of_ne fun B _ hB => ?_).symm
    by_contra hq
    exact hB (by rw [zerosAt_of_not_on _ _ hq, mul_zero])
  rw [hsum]
  refine local_sum_le (AJ E G) q.divisorChain hsb0 hφ0 hdisj (sB.subtype fun B => q.On B.curve) Pb ?_
    (fun b => b.1.mult) (fun b => zerosAt b.1.curve q (BR E b.1.prime s))
    (fun b _ => le_of_eq (mult_eq_div b.1 hφ0 hφ (Pb b) (hPb2 b)))
    (fun b _ => M.zerosAt_level_le q hsb b.1 b.2 (Pb b) (hPb1 b)) Finset.univ
    (fun D : AU E g s H => zerosAt (M.sectionCurve D) q
      (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c))
    (fun Pd D => Pd.valuation (AJ E G) = (M.sectionCurve D).val) ?_ ?_
  · intro b _ b' _ hbb'
    have h := hPb2 b
    rw [hbb', hPb2 b'] at h
    refine Subtype.ext (Subtype.ext ?_)
    show b.1.val = b'.1.val
    rw [← b.1.curve_val, ← b'.1.curve_val]
    exact h.symm
  · intro Pd Pd' D h1 h2
    exact PrimeDivisor.ext_ideal (Ideal.ext fun x => by
      rw [← Pd.valuation_lt_one_iff (AJ E G), ← Pd'.valuation_lt_one_iff (AJ E G), h1, h2])
  · intro Pd hsP
    obtain ⟨D, hRD, hdiv⟩ := M.exists_section_of_primeDivisor q hpoly hHq hsb hsb0 Pd hsP
    exact ⟨hdiv, D, Finset.mem_univ D, hRD,
      M.length_le_zerosAt q hφ Pd (fun h => hdisj Pd h hsP) D hRD⟩

/-- The section bound on one geometric component: the poles of the flag `W` on the components of the level
curve, with the multiplicities of the level curve, at any places, are at most the zeros of `f - c` on the
components of the section at the places `V D`, which do not depend on the components and places chosen. -/
theorem Setup.component_count (M : Setup G N p g H Gs Q A c W s) :
    ∃ V : ∀ D : AU E g s H, Finset (RCN026.Place E (AJ E D.1)),
      ∀ (sB : Finset (LevelComponent G (RCN208.movingValue G H Gs Q A) c))
        (T : ∀ B : LevelComponent G (RCN208.movingValue G H Gs Q A) c,
          Finset (RCN026.Place E (AJ E B.prime))),
        levelFlagSum sB T W ≤ ∑ D : AU E g s H, ∑ ν ∈ V D,
          RCN026.zeroOrder E (AJ E D.1) ν
            (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c) := by
  have := M.algClosed
  have := M.charP
  choose V hV using fun D : AU E g s H => exists_zero_places D.1 (M.sepD D).some
    (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c)
  refine ⟨V, fun sB T => ?_⟩
  choose Zf hZf using fun B : LevelComponent G (RCN208.movingValue G H Gs Q A) c =>
    exists_zeros_bound B.prime (M.sep B).some W (BR E B.prime s) (M.needs.ne B) (M.needs.pole B)
  have hfinB : ∀ B : LevelComponent G (RCN208.movingValue G H Gs Q A) c,
      {μ : RCN026.Place E (AJ E B.prime) |
        (RCN026.order E (AJ E B.prime) μ (BR E B.prime s)).toNat ≠ 0}.Finite := fun B => by
    obtain ⟨V', hV'⟩ := exists_zero_places B.prime (M.sep B).some (BR E B.prime s)
    exact V'.finite_toSet.subset fun μ hμ => hV' μ hμ
  have hex : ∀ (B : LevelComponent G (RCN208.movingValue G H Gs Q A) c)
      (v : RCN026.Place E (AJ E B.prime)),
      (RCN026.order E (AJ E B.prime) v (BR E B.prime s)).toNat ≠ 0 →
      ∃ q : SurfacePoint G, ((∀ B : Poly, BR E G B ∈ q.ring) ∧ (BR E G H)⁻¹ ∈ q.ring) ∧
        v ∈ placesAt B.curve q := by
    intro B v hv
    obtain ⟨h1, h2⟩ := M.needs.zero B v (val_lt_one_of_order_toNat_ne_zero v _ hv)
    obtain ⟨q, hq, hvq, hpoly, hHq⟩ :=
      exists_finite_point B.isCurve (M.noether false false false) M.char v h1 H h2
    exact ⟨q, ⟨hpoly, hHq⟩, hq, hvq⟩
  obtain ⟨Qs, hQs, hQle⟩ : ∃ Qs : Finset (SurfacePoint G),
      (∀ q ∈ Qs, (∀ B : Poly, BR E G B ∈ q.ring) ∧ (BR E G H)⁻¹ ∈ q.ring) ∧
      ∀ B : LevelComponent G (RCN208.movingValue G H Gs Q A) c, B ∈ sB →
        ∑ v ∈ Zf B, (RCN026.order E (AJ E B.prime) v (BR E B.prime s)).toNat ≤
          ∑ q ∈ Qs, zerosAt B.curve q (BR E B.prime s) := by
    by_cases hne : Nonempty (SurfacePoint G)
    · choose! pt hpt1 hpt2 using hex
      refine ⟨sB.biUnion fun B => ((Zf B).filter fun v =>
        (RCN026.order E (AJ E B.prime) v (BR E B.prime s)).toNat ≠ 0).image (pt B),
        fun q hq => ?_, fun B hB => ?_⟩
      · obtain ⟨B, -, hq⟩ := Finset.mem_biUnion.mp hq
        obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hq
        exact hpt1 B v (Finset.mem_filter.mp hv).2
      · refine le_of_eq_of_le (Finset.sum_filter_ne_zero (Zf B)).symm ?_
        exact sum_le_sum_zerosAt B.curve _ _ (hfinB B) (pt B) _ fun v hv =>
          ⟨Finset.mem_biUnion.mpr ⟨B, hB, Finset.mem_image_of_mem _ hv⟩,
            hpt2 B v (Finset.mem_filter.mp hv).2⟩
    · refine ⟨∅, fun q hq => absurd hq (Finset.notMem_empty q), fun B _ => ?_⟩
      rw [Finset.sum_empty, Nat.le_zero]
      refine Finset.sum_eq_zero fun v _ => ?_
      by_contra hv
      obtain ⟨q, -⟩ := hex B v hv
      exact hne ⟨q⟩
  have hnat : ∑ B ∈ sB, B.mult *
        ∑ v ∈ Zf B, (RCN026.order E (AJ E B.prime) v (BR E B.prime s)).toNat ≤
      ∑ D : AU E g s H, ∑ μ ∈ V D, (RCN026.order E (AJ E D.1) μ
        (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c)).toNat := by
    calc ∑ B ∈ sB, B.mult *
          ∑ v ∈ Zf B, (RCN026.order E (AJ E B.prime) v (BR E B.prime s)).toNat
        ≤ ∑ B ∈ sB, B.mult * ∑ q ∈ Qs, zerosAt B.curve q (BR E B.prime s) :=
          Finset.sum_le_sum fun B hB => Nat.mul_le_mul_left _ (hQle B hB)
      _ = ∑ q ∈ Qs, ∑ B ∈ sB, B.mult * zerosAt B.curve q (BR E B.prime s) := by
          simp_rw [Finset.mul_sum]
          exact Finset.sum_comm
      _ ≤ ∑ q ∈ Qs, ∑ D : AU E g s H, zerosAt (M.sectionCurve D) q
            (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c) :=
          Finset.sum_le_sum fun q hq => M.local_le q (hQs q hq).1 (hQs q hq).2 sB
      _ = ∑ D : AU E g s H, ∑ q ∈ Qs, zerosAt (M.sectionCurve D) q
            (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c) := Finset.sum_comm
      _ ≤ _ := Finset.sum_le_sum fun D _ =>
          sum_zerosAt_le M.coord (M.sectionCurve D) _ Qs (V D) (hV D)
  calc levelFlagSum sB T W
      = ∑ B ∈ sB, (B.mult : ℤ) *
          ∑ v ∈ T B, RCN204.flagPole v.val (coordinate E B.prime) W := rfl
    _ ≤ ∑ B ∈ sB, (B.mult : ℤ) * ∑ v ∈ Zf B,
          ((RCN026.order E (AJ E B.prime) v (BR E B.prime s)).toNat : ℤ) :=
        Finset.sum_le_sum fun B _ =>
          mul_le_mul_of_nonneg_left (hZf B (T B)) (Int.natCast_nonneg _)
    _ = ((∑ B ∈ sB, B.mult *
          ∑ v ∈ Zf B, (RCN026.order E (AJ E B.prime) v (BR E B.prime s)).toNat : ℕ) : ℤ) := by
        rw [Nat.cast_sum]
        refine Finset.sum_congr rfl fun B _ => ?_
        rw [Nat.cast_mul, Nat.cast_sum]
    _ ≤ ((∑ D : AU E g s H, ∑ μ ∈ V D, (RCN026.order E (AJ E D.1) μ
          (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c)).toNat : ℕ) : ℤ) :=
        Nat.cast_le.mpr hnat
    _ = ∑ D : AU E g s H, ∑ ν ∈ V D, RCN026.zeroOrder E (AJ E D.1) ν
          (RCN208.movingValue D.1 H Gs Q A - algebraMap E (AJ E D.1) c) := by
        rw [Nat.cast_sum]
        refine Finset.sum_congr rfl fun D _ => ?_
        rw [Nat.cast_sum]
        refine Finset.sum_congr rfl fun ν _ => ?_
        rw [RCN026.zeroOrder, Int.toNat_eq_max, max_comm]

end Component

end

end ProximityPrize.SubmissionLower.FormalR.Sec
end
section

/-!
The exchange on one geometric component over a field `E` (`component_exchange`): at each base point the
chain `sum_mul_le_toNat` for the local ring of the point, then the sum over the base points.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.Exch

open WithZero MvPolynomial HFree6812
open RCN002 RCN095 RCN204

section Generic

variable {O : Type*} [CommRing O] {L : Type*} [Field L] [Algebra O L] {F : Type*} [Field F]

theorem leastOrder_top (S : Specialization L F) (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1)
    (μ : Valuation F ℤᵐ⁰) : S.leastOrder hO ⊤ μ = 0 := by
  refine Nat.sInf_eq_zero.mpr (Or.inl ⟨1, Submodule.mem_top, ?_, ?_⟩)
  · rw [map_one, map_one]
  · rw [map_one, map_one, Nat.cast_zero, neg_zero, exp_zero]

variable {E : Type*} [Field E] [Algebra E F] [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O]
  [IsFractionRing O L] [Algebra E L]

theorem levelOrder_eq_zero (S : Specialization L F) (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1)
    (f : L) (c : E) (n : ℕ) (h : levelDivisor (O := O) L f c = 0) : S.levelOrder hO f c n = 0 := by
  unfold Specialization.levelOrder
  rw [levelIdeal, h, smul_zero, divisorIdeal_zero]
  simp only [leastOrder_top, finsum_zero]

end Generic

section Surface

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime]

attribute [local instance] SurfacePoint.isNoetherianRing SurfacePoint.isIntegrallyClosed
  SurfacePoint.isFractionRing

theorem order_eq_zero {F : Type*} [Field F] [Algebra E F] (q : SurfacePoint G)
    (S : Specialization (AJ E G) F) (f : AJ E G) (c : E) (n : ℕ) (h : q.level f c = 0) :
    q.order S f c n = 0 := by
  classical
  unfold SurfacePoint.order
  split_ifs with hq
  · exact levelOrder_eq_zero S hq f c n h
  · rfl

theorem levelNumber_eq_zero (q : SurfacePoint G) (f : AJ E G) (c : E) (g : AJ E G)
    (h : q.level f c = 0) : q.levelNumber f c g = 0 := by
  classical
  unfold SurfacePoint.levelNumber
  split_ifs
  · rw [h, localNumber, Finsupp.sum_zero_index, ENat.toNat_zero]
  · rfl

theorem finite_base {N p : ℕ} [CharP E p] (hN : ∀ sR sY sZ, SurfaceNoether G sR sY sZ N)
    (hp : 3 * N < p) (f : AJ E G) (c : E) :
    {q : SurfacePoint G | f ∉ q.ring ∧ q.level f c ≠ 0}.Finite := by
  by_cases hf : f = algebraMap E (AJ E G) c
  · refine Set.Finite.subset Set.finite_empty fun q hq => hq.1 ?_
    rw [hf]
    exact q.ring.algebraMap_mem c
  · exact finite_basePoints hN hp f c hf

variable {ι : Type*} {F : ι → Type*} [∀ a, Field (F a)] [∀ a, Algebra E (F a)]

open Classical in
/-- The chain at a base point `q` of a component. -/
theorem point_exchange (hc : ∀ j, coordinate E G j ≠ 0) (f : AJ E G) (c : E) (A₁ : AJ E G)
    (W : FlagDegree) (hdisj : LevelDisjoint f c A₁ W) (s : Finset ι)
    (S : ∀ a, Specialization (AJ E G) (F a)) (m : ι → ℕ)
    (hinj : ∀ a ∈ s, ∀ b ∈ s, (S a).val = (S b).val → a = b)
    (hcoord : ∀ a ∈ s, ∀ j, (S a).val (coordinate E G j) ≤ 1)
    (hdiv : ∀ a ∈ s, ∀ q : SurfacePoint G, q.On (S a) → ∃ P : PrimeDivisor q.ring,
      (∀ x : q.ring, x ∈ P.ideal ↔ (S a).val (x : AJ E G) < 1) ∧
        P.valuation (AJ E G) = (S a).val)
    (hord : ∀ a ∈ s, (S a).val A₁ ≤ exp (-(m a : ℤ)))
    (q : SurfacePoint G) (hreg : q.localFunction A₁ W ∈ q.ring) (hf : f ∉ q.ring)
    (hL : q.level f c ≠ 0)
    (hp1 : ∀ a ∈ s, ∀ hq : q.On (S a), PlaceSurf.Statement.LeastOrderLE E (S a) hq) (n : ℕ) :
    ∑ a ∈ s, m a * q.order (S a) f c n ≤
      n * q.levelNumber f c (q.localFunction A₁ W) + pointLoss q (q.localFunction A₁ W) +
        ∑ a ∈ s, if hq : q.On (S a) then m a * closureColength ((S a).image hq) (F a) else 0 := by
  classical
  have hO : DivisorChain q.ring := q.divisorChain
  have hD : ∀ P ∈ (q.level f c).support, (⟨_, hreg⟩ : q.ring) ∉ P.ideal := fun P hP =>
    (P.valuation_eq_one_iff (AJ E G) ⟨_, hreg⟩).mp (hdisj q hf P (Finsupp.mem_support_iff.mp hP))
  obtain ⟨P₀, hP₀⟩ : ∃ P₀, q.level f c P₀ ≠ 0 := by
    by_contra h
    exact hL (Finsupp.ext fun P => not_not.mp fun hP => h ⟨P, hP⟩)
  have hg : (⟨_, hreg⟩ : q.ring) ≠ 0 := by
    intro h0
    have h1 := hdisj q hf P₀ hP₀
    rw [show q.localFunction A₁ W = 0 from congrArg Subtype.val h0, map_zero] at h1
    exact zero_ne_one h1
  have hval : ∀ a ∈ s, q.On (S a) → (S a).val (q.localFunction A₁ W) ≤ exp (-(m a : ℤ)) := by
    intro a ha hq
    rw [SurfacePoint.localFunction, map_div₀, val_vertex_eq_one hc q (S a) hq (hcoord a ha) W,
      div_one]
    exact hord a ha
  let Pd : ι → PrimeDivisor q.ring := fun a =>
    if h : a ∈ s ∧ q.On (S a) then (hdiv a h.1 q h.2).choose else P₀
  have hPd : ∀ a (ha : a ∈ s) (hq : q.On (S a)),
      (∀ x : q.ring, x ∈ (Pd a).ideal ↔ (S a).val (x : AJ E G) < 1) ∧
        (Pd a).valuation (AJ E G) = (S a).val := by
    intro a ha hq
    simp only [Pd, dite_eq_left (And.intro ha hq)]
    exact (hdiv a ha q hq).choose_spec
  let δf : ι → ℕ := fun a =>
    if hq : q.On (S a) then closureColength ((S a).image hq) (F a) else 0
  have key := sum_mul_le_toNat (AJ E G) hO hg (q.level f c) hD
    (s.filter fun a => 0 < m a ∧ q.On (S a)) Pd ?_ m ?_ (fun a => q.order (S a) f c n) δf n ?_
  · have hlhs : ∑ a ∈ s, m a * q.order (S a) f c n =
        ∑ a ∈ s.filter (fun a => 0 < m a ∧ q.On (S a)), m a * q.order (S a) f c n := by
      refine (Finset.sum_filter_of_ne fun a _ hne => ⟨?_, ?_⟩).symm
      · exact Nat.pos_of_ne_zero fun h0 => hne (by rw [h0, zero_mul])
      · by_contra hq
        exact hne (by rw [SurfacePoint.order, dite_eq_right hq, mul_zero])
    have hnum : q.levelNumber f c (q.localFunction A₁ W) =
        ((q.level f c).sum fun Q k => (k : ℕ∞) * Module.length q.ring
          (q.ring ⧸ (Q.ideal ⊔ Ideal.span {(⟨_, hreg⟩ : q.ring)}))).toNat := by
      rw [SurfacePoint.levelNumber, dite_eq_left hreg]
      rfl
    have hloss : pointLoss q (q.localFunction A₁ W) = loss (AJ E G) (⟨_, hreg⟩ : q.ring) := by
      rw [pointLoss, dite_eq_left hreg]
    have hrhs : ∑ a ∈ s.filter (fun a => 0 < m a ∧ q.On (S a)), m a * δf a ≤
        ∑ a ∈ s, if hq : q.On (S a) then m a * closureColength ((S a).image hq) (F a) else 0 := by
      refine (Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)).trans_eq
        (Finset.sum_congr rfl fun a _ => ?_)
      simp only [δf]
      split_ifs <;> simp
    rw [hlhs, hnum, hloss]
    exact key.trans (Nat.add_le_add_left hrhs _)
  · intro a ha b hb hab
    rw [Finset.coe_filter, Set.mem_ofPred_eq] at ha hb
    refine hinj a ha.1 b hb.1 ?_
    rw [← (hPd a ha.1 ha.2.2).2, ← (hPd b hb.1 hb.2.2).2, hab]
  · intro a ha
    rw [Finset.mem_filter] at ha
    have h1 := hval a ha.1 ha.2.2
    rw [← (hPd a ha.1 ha.2.2).2] at h1
    have h2 := valuation_eq_exp_neg_div (AJ E G) hg (Pd a)
    rw [show algebraMap q.ring (AJ E G) ⟨_, hreg⟩ = q.localFunction A₁ W from rfl] at h2
    rw [h2, exp_le_exp] at h1
    omega
  · intro a ha
    rw [Finset.mem_filter] at ha
    obtain ⟨has, hma, hq⟩ := ha
    have hzero : q.level f c (Pd a) = 0 := by
      by_contra hne
      have h1 := hdisj q hf (Pd a) hne
      have h2 := hval a has hq
      rw [← (hPd a has hq).2, h1] at h2
      have h3 : exp (-(m a : ℤ)) < 1 := by
        rw [← exp_zero]
        exact exp_lt_exp.mpr (by omega)
      exact absurd h2 (not_le.mpr h3)
    have hI : ¬levelIdeal (O := q.ring) (AJ E G) f c n ≤ (Pd a).ideal :=
      divisorIdeal_not_le (AJ E G) (by
        rw [Finsupp.smul_apply]
        exact (smul_eq_zero_of_right n hzero : n • (levelDivisor (O := q.ring) (AJ E G) f c) (Pd a) = 0))
    have h4 := hp1 a has hq (Pd a).ideal (hPd a has hq).1 _ hI
    simp only [δf, dite_eq_left hq, SurfacePoint.order, Specialization.levelOrder]
    exact h4

/-- The exchange on one geometric component. -/
theorem component_exchange {N p : ℕ} [CharP E p]
    (hN : ∀ sR sY sZ, SurfaceNoether G sR sY sZ N) (hp : 3 * N < p)
    (hc : ∀ j, coordinate E G j ≠ 0) (f : AJ E G) (c : E) (A₁ : AJ E G) (W : FlagDegree)
    (hreg : ∀ q : SurfacePoint G, q.localFunction A₁ W ∈ q.ring)
    (hdisj : LevelDisjoint f c A₁ W) (s : Finset ι)
    (S : ∀ a, Specialization (AJ E G) (F a)) (m : ι → ℕ)
    (hinj : ∀ a ∈ s, ∀ b ∈ s, (S a).val = (S b).val → a = b)
    (hcoord : ∀ a ∈ s, ∀ j, (S a).val (coordinate E G j) ≤ 1)
    (hdiv : ∀ a ∈ s, ∀ q : SurfacePoint G, q.On (S a) → ∃ P : PrimeDivisor q.ring,
      (∀ x : q.ring, x ∈ P.ideal ↔ (S a).val (x : AJ E G) < 1) ∧
        P.valuation (AJ E G) = (S a).val)
    (hord : ∀ a ∈ s, (S a).val A₁ ≤ exp (-(m a : ℤ)))
    (hp1 : ∀ a ∈ s, ∀ (q : SurfacePoint G) (hq : q.On (S a)), f ∉ q.ring → q.level f c ≠ 0 →
      PlaceSurf.Statement.LeastOrderLE E (S a) hq) (n : ℕ) :
    ∑ a ∈ s, m a * curveBase (S a) f c n ≤
      n * baseNumber f c A₁ W + componentLoss f c A₁ W s S m := by
  classical
  have hfin := finite_base hN hp f c
  have hT : ∀ q, q ∈ hfin.toFinset ↔ f ∉ q.ring ∧ q.level f c ≠ 0 := fun q => hfin.mem_toFinset
  have hbase : ∀ a, curveBase (S a) f c n = ∑ q ∈ hfin.toFinset, q.order (S a) f c n := by
    intro a
    unfold curveBase
    rw [finsum_eq_sum_of_support_subset (s := hfin.toFinset)]
    · exact Finset.sum_congr rfl fun q hq => ite_eq_right ((hT q).mp hq).1
    · intro q hq
      rw [Function.mem_support] at hq
      rw [Finset.mem_coe, hT]
      by_cases h1 : f ∈ q.ring
      · exact absurd (ite_eq_left h1) hq
      · exact ⟨h1, fun h0 => hq (by rw [ite_eq_right h1, order_eq_zero q (S a) f c n h0])⟩
  have hnum : baseNumber f c A₁ W =
      ∑ q ∈ hfin.toFinset, q.levelNumber f c (q.localFunction A₁ W) := by
    unfold baseNumber
    rw [finsum_eq_sum_of_support_subset (s := hfin.toFinset)]
    · exact Finset.sum_congr rfl fun q hq => ite_eq_right ((hT q).mp hq).1
    · intro q hq
      rw [Function.mem_support] at hq
      rw [Finset.mem_coe, hT]
      by_cases h1 : f ∈ q.ring
      · exact absurd (ite_eq_left h1) hq
      · exact ⟨h1, fun h0 => hq (by rw [ite_eq_right h1, levelNumber_eq_zero q f c _ h0])⟩
  have hloss : componentLoss f c A₁ W s S m = ∑ q ∈ hfin.toFinset,
      (pointLoss q (q.localFunction A₁ W) +
        ∑ a ∈ s, if hq : q.On (S a) then m a * closureColength ((S a).image hq) (F a) else 0) := by
    unfold componentLoss
    rw [finsum_eq_sum_of_support_subset (s := hfin.toFinset)]
    · exact Finset.sum_congr rfl fun q hq => ite_eq_left ((hT q).mp hq)
    · intro q hq
      rw [Function.mem_support] at hq
      rw [Finset.mem_coe, hT]
      by_contra h
      exact hq (ite_eq_right h)
  calc ∑ a ∈ s, m a * curveBase (S a) f c n
      = ∑ q ∈ hfin.toFinset, ∑ a ∈ s, m a * q.order (S a) f c n := by
        simp only [hbase, Finset.mul_sum]
        exact Finset.sum_comm
    _ ≤ ∑ q ∈ hfin.toFinset, (n * q.levelNumber f c (q.localFunction A₁ W) +
          pointLoss q (q.localFunction A₁ W) +
          ∑ a ∈ s, if hq : q.On (S a) then m a * closureColength ((S a).image hq) (F a) else 0) :=
        Finset.sum_le_sum fun q hq =>
          point_exchange hc f c A₁ W hdisj s S m hinj hcoord hdiv hord q (hreg q)
            ((hT q).mp hq).1 ((hT q).mp hq).2
            (fun a ha hqa => hp1 a ha q hqa ((hT q).mp hq).1 ((hT q).mp hq).2) n
    _ = n * baseNumber f c A₁ W + componentLoss f c A₁ W s S m := by
        rw [hnum, hloss, Finset.mul_sum, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun q _ => add_assoc _ _ _

end Surface

end ProximityPrize.SubmissionLower.FormalR.Exch
end
section

/-!
The need `LevelDisjoint` of the exchange holds for all levels `c` outside a finite set:
`finite_not_levelDisjoint` on one geometric component, `finite_not_disjoint` for the field `disjoint` of
`ExchangeNeeds`. The excluded levels are those of the finitely many prime divisors of the eight charts
along which `A₁` or a coordinate has a zero or a pole.
-/

set_option autoImplicit false

