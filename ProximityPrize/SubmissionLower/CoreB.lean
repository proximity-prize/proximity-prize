/-!
The auxiliary polynomial of the elementary height bound for a packet, from the certificate of its cell and a
floor of the total weight of its carrier.

The existence statement `H2Sec.ExistsStatement` asks, of the carrier over the generic field, bounds of its
weights: its `R`-degree between `rlo` and `rhi`, its `(Y, R)`-degree at most `yhi`, its total degree at least
`tlo`, and the finite condition at these four numbers. For a packet of the cell `(t, y, r)` the bounds hold
with `rlo = rhi =` the `R`-degree, `yhi = y` and `tlo = T0` for every floor `T0 ≤ wt AT P.F`, and the
certificate is the finite condition at every `R`-degree from `1` to `r`.

* `tail_mem_support_surfaceMap`: for an injective map of the coefficients, the surface map keeps every
  monomial of a polynomial in four variables (it forgets the exponent of `X`). So a lower bound of a degree
  of the carrier in four variables is one of the carrier over the generic field.
* `baseCarrier_degreeOf_le`, `one_le_baseCarrier_degreeOf`, `baseCarrier_middle_le`,
  `le_baseCarrier_totalDegree`: the weights of `baseCarrier P.F`.
* `existsAux_of_certificate`: `H2Sec.ExistsAux P n ((n / qd) B) ((n / qd) C)` from a proper tail cut, the
  floor and `Certificate r y T0 B C qd n`.
-/

namespace ProximityPrize.SubmissionLower.FormalR.H2

open scoped Classical
open MvPolynomial
open RCN002 RCN072 RCN095 RCN135 RCN136 RCN156 RCN222 RCN234 RCN264 RCN313
open BD DU _Q7 AFA OT

section Surface

variable {K L : Type*} [Field K] [Field L]

/-- The surface map keeps the monomials: for an injective `φ`, the tail of a monomial of `Q` is a monomial of
`surfaceMap φ Q`. -/
theorem tail_mem_support_surfaceMap (φ : Polynomial K →+* L) (hφ : Function.Injective φ)
    (Q : MvPolynomial (Fin 4) K) {d : Fin 4 →₀ ℕ} (hd : d ∈ Q.support) :
    d.tail ∈ (surfaceMap φ Q).support := by
  rw [MvPolynomial.mem_support_iff]
  have hsum : surfaceMap φ Q = ∑ e ∈ Q.support,
      MvPolynomial.monomial e.tail (φ (Polynomial.C (Q.coeff e)) * φ Polynomial.X ^ e 0) := by
    conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff Q, map_sum]
    exact Finset.sum_congr rfl fun e _ => FHM φ e _
  have hmap : ∑ e ∈ Q.support.filter (fun e => e.tail = d.tail),
        φ (Polynomial.C (Q.coeff e)) * φ Polynomial.X ^ e 0 =
      φ (∑ e ∈ Q.support.filter (fun e => e.tail = d.tail),
        Polynomial.C (Q.coeff e) * Polynomial.X ^ e 0) := by
    simp only [map_sum, map_mul, map_pow]
  rw [hsum, MvPolynomial.coeff_sum]
  simp only [MvPolynomial.coeff_monomial]
  rw [← Finset.sum_filter, hmap]
  refine (map_ne_zero_iff φ hφ).2 fun h0 => ?_
  have hc := congrArg (fun p => Polynomial.coeff p (d 0)) h0
  simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
    Polynomial.coeff_zero] at hc
  rw [Finset.sum_eq_single_of_mem d
    (show d ∈ Q.support.filter (fun e => e.tail = d.tail) from Finset.mem_filter.2 ⟨hd, rfl⟩)] at hc
  · simp only [↓reduceIte, mul_one] at hc
    exact MvPolynomial.mem_support_iff.1 hd hc
  · intro e he hne
    have ht := (Finset.mem_filter.1 he).2
    have h0' : d 0 ≠ e 0 := fun h => hne (by rw [← Finsupp.cons_tail e, ← Finsupp.cons_tail d, ht, h])
    simp only [h0', ↓reduceIte, mul_zero]

end Surface

section Packet

local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

/-- The `R`-degree of the carrier over the generic field is at most `r`. -/
theorem baseCarrier_degreeOf_le (P : Packet x t y r) : (baseCarrier P.F).degreeOf 1 ≤ r :=
  MvPolynomial.degreeOf_le_iff.2 fun d hd => (P.parent_flag Ω (AL K) d hd).1

omit [CharP K 2130706433] in
/-- The carrier over the generic field has positive `R`-degree. -/
theorem one_le_baseCarrier_degreeOf (P : Packet x t y r) : 1 ≤ (baseCarrier P.F).degreeOf 1 := by
  have hpos := P.rdegree
  rw [MvPolynomial.degreeOf_eq_sup] at hpos
  obtain ⟨d, hd, hd2⟩ := Finset.lt_sup_iff.1 hpos
  exact (Nat.succ_le_of_lt hd2).trans
    (MvPolynomial.monomial_le_degreeOf 1 (tail_mem_support_surfaceMap (AL K) (DI K) P.F hd))

/-- The `(Y, R)`-degree of the carrier over the generic field is at most `y`. -/
theorem baseCarrier_middle_le (P : Packet x t y r) :
    ∀ d ∈ (baseCarrier P.F).support, d 0 + d 1 ≤ y := fun d hd => by
  have h := (P.parent_flag Ω (AL K) d hd).2.1
  have hy := P.ylow
  dsimp only at h
  omega

omit [CharP K 2130706433] in
/-- A floor of the total weight of the carrier is a floor of its total degree over the generic field. -/
theorem le_baseCarrier_totalDegree (P : Packet x t y r) {T0 : ℕ} (hT0 : T0 ≤ wt AT P.F) :
    T0 ≤ (baseCarrier P.F).totalDegree := by
  rcases Nat.eq_zero_or_pos T0 with rfl | hpos
  · exact Nat.zero_le _
  obtain ⟨d, hd, hdw⟩ := (Finset.le_sup_iff (by exact hpos)).1 hT0
  have hmem := tail_mem_support_surfaceMap (AL K) (DI K) P.F hd
  have hle := MvPolynomial.le_totalDegree hmem
  rw [RCN081.weight_fin4] at hdw
  rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_three] at hle
  simp only [Finsupp.tail_apply] at hle
  rw [show Fin.succ (0 : Fin 3) = 1 from rfl, show Fin.succ (1 : Fin 3) = 2 from rfl,
    show Fin.succ (2 : Fin 3) = 3 from rfl] at hle
  simp only [AT, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons] at hdw
  exact le_trans (by omega) hle

/-- The auxiliary polynomial of the height bound for the packet, from the certificate of its cell: for every
`c0 : RationalBase K` outside a finite set a polynomial of the flag `⟨0, (n / qd) B, (n / qd) C⟩`,
not divisible by the carrier, in `(F) + (Z - c0)^n` (`H2Sec.ExistsAux`). -/
theorem existsAux_of_certificate (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (T0 B C qd n : ℕ) (hT0 : T0 ≤ wt AT P.F) (hcert : Certificate r y T0 B C qd n) :
    H2Sec.ExistsAux P n (n / qd * B) (n / qd * C) :=
  H2Sec.exists_aux P t (Chart.surfaceNoether_component P hp) (Chart.packet_three_mul_lt P)
    (Chart.packet_coordinate_ne_zero P hp) n (n / qd * B) (n / qd * C) _ _ y T0 le_rfl le_rfl
    (baseCarrier_middle_le P) (le_baseCarrier_totalDegree P hT0)
    (hcert.count (one_le_baseCarrier_degreeOf P) (baseCarrier_degreeOf_le P))

end Packet

end ProximityPrize.SubmissionLower.FormalR.H2
end
