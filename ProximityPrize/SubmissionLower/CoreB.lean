/-!
The height bound on one curve: `H2Lev.curve_of_pole` and `H2Lev.curve : CurveStatement E`.

On a curve `D` with a separable coordinate the product formula holds for `BR Ga` and for `Z - c0`. At a
zero of `Z - c0` the cofactor `H` has poles at most the flag `⟨0, β, γ⟩` (hypothesis of `curve_of_pole`;
in `curve` no coordinate has a pole there, so `H` has value at most 1), hence
`ord Ga ≥ n ord (Z - c0) - flagPole`; at every other place `ord (Z - c0)` is minus the pole order of `Z`,
and `ord Ga` is at least minus the pole of the flag (`RCN204.ADJ`). Summed over a finite set of places
that carries both product formulas: `n Σ pole(Z) ≤ β Σ flagPole(0,1,0) + γ Σ flagPole(0,0,1)`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Lev

open WithZero MvPolynomial
open RCN002 RCN095 RCN187

noncomputable section

section Curve

theorem poleOrder_eq_zero {L : Type*} [Field L] (v : Valuation L ℤᵐ⁰) {y : L} (h : v y ≤ 1) :
    poleOrder v y = 0 := by
  rw [poleOrder]
  by_cases h0 : v y = 0
  · rw [h0, log_zero, max_self]
  · exact max_eq_left ((log_le_iff_le_exp h0).mpr (by rwa [exp_zero]))

variable {E : Type} [Field E] {D : Ideal (MvPolynomial (Fin 3) E)} [D.IsPrime]

omit [D.IsPrime] in
theorem BR_levelForm (c0 : E) :
    BR E D (MvPolynomial.X 2 - MvPolynomial.C c0) =
      coordinate E D 2 - algebraMap E (AJ E D) c0 := by
  rw [map_sub, algHom_C]
  rfl

/-- At a zero of `Z - c0` the coordinate `Z` has no pole. -/
theorem val_coordinate_le_one (v : RCN026.Place E (AJ E D)) (c0 : E)
    (h : v.val (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) ≤ 1) :
    v.val (coordinate E D 2) ≤ 1 := by
  by_contra hlt
  rw [BR_levelForm, Valuation.map_sub_eq_of_lt_left _
    (lt_of_le_of_lt (RCN344.NP E (AJ E D) v c0) (not_le.mp hlt))] at h
  exact hlt h

/-- At a place that is not a zero of `Z - c0`, the order of `Z - c0` is minus the pole order of `Z`. -/
theorem order_levelForm_add (v : RCN026.Place E (AJ E D)) (c0 : E)
    (h : 1 ≤ v.val (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0))) :
    RCN026.order E (AJ E D) v (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) +
      poleOrder v.val (coordinate E D 2) = 0 := by
  rw [RCN026.order]
  by_cases hlt : 1 < v.val (coordinate E D 2)
  · have h0 : v.val (coordinate E D 2) ≠ 0 := ne_of_gt (zero_lt_one.trans hlt)
    have hlog : 0 < (v.val (coordinate E D 2)).log := (lt_log_iff_exp_lt h0).mpr (by rwa [exp_zero])
    rw [BR_levelForm, Valuation.map_sub_eq_of_lt_left _
      (lt_of_le_of_lt (RCN344.NP E (AJ E D) v c0) hlt), poleOrder, max_eq_right hlog.le]
    exact neg_add_cancel _
  · have h1 : v.val (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) = 1 := by
      refine le_antisymm ?_ h
      rw [BR_levelForm]
      exact (Valuation.map_sub _ _ _).trans (max_le (not_lt.mp hlt) (RCN344.NP E (AJ E D) v c0))
    rw [h1, log_one, neg_zero, zero_add, poleOrder_eq_zero _ (not_lt.mp hlt)]

/-- At one place: `n (ord (Z - c0) + pole Z) ≤ ord Ga + flagPole ⟨0, β, γ⟩`, when the cofactor `H` has
poles at most the flag if the place is a zero of `Z - c0`. -/
theorem order_aux_ge (v : RCN026.Place E (AJ E D)) (c0 : E) (n β γ : ℕ)
    (Ga H : MvPolynomial (Fin 3) E) (hflag : BI ⟨0, β, γ⟩ Ga) (hγ0 : BR E D Ga ≠ 0)
    (hprod : BR E D Ga = BR E D (MvPolynomial.X 2 - MvPolynomial.C c0) ^ n * BR E D H)
    (hη : v.val (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) < 1 →
      v.val (BR E D H) ≤ exp ((β : ℤ) * RCN204.flagPole v.val (coordinate E D) unitYZFlag +
        (γ : ℤ) * RCN204.flagPole v.val (coordinate E D) unitAllFlag)) :
    (n : ℤ) * (RCN026.order E (AJ E D) v (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) +
        poleOrder v.val (coordinate E D 2)) ≤
      RCN026.order E (AJ E D) v (BR E D Ga) +
        ((β : ℤ) * RCN204.flagPole v.val (coordinate E D) unitYZFlag +
          (γ : ℤ) * RCN204.flagPole v.val (coordinate E D) unitAllFlag) := by
  have hv0 : v.val (BR E D Ga) ≠ 0 := (Valuation.ne_zero_iff _).mpr hγ0
  have hYZ := RCN204.ALZ v.val (coordinate E D) unitYZFlag
  have hAll := RCN204.ALZ v.val (coordinate E D) unitAllFlag
  have hβ := mul_nonneg (Nat.cast_nonneg (α := ℤ) β) hYZ
  have hγ := mul_nonneg (Nat.cast_nonneg (α := ℤ) γ) hAll
  by_cases h : v.val (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) < 1
  · have hprod0 := hv0
    rw [hprod, map_mul, map_pow] at hprod0
    have hpow0 := left_ne_zero_of_mul hprod0
    have hle : v.val (BR E D Ga) ≤
        v.val (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) ^ n *
          exp ((β : ℤ) * RCN204.flagPole v.val (coordinate E D) unitYZFlag +
            (γ : ℤ) * RCN204.flagPole v.val (coordinate E D) unitAllFlag) := by
      rw [hprod, map_mul, map_pow]
      exact mul_le_mul' le_rfl (hη h)
    have hlog := (log_le_log hv0 (mul_ne_zero hpow0 exp_ne_zero)).mpr hle
    rw [log_mul hpow0 exp_ne_zero, log_pow, nsmul_eq_mul, log_exp] at hlog
    rw [poleOrder_eq_zero _ (val_coordinate_le_one v c0 h.le), add_zero, RCN026.order, RCN026.order]
    linarith
  · have hpole : (v.val (BR E D Ga)).log ≤
        (β : ℤ) * RCN204.flagPole v.val (coordinate E D) unitYZFlag +
          (γ : ℤ) * RCN204.flagPole v.val (coordinate E D) unitAllFlag := by
      have hA := RCN204.ADJ v.val (algebraMap E (AJ E D)) (RCN344.NP E (AJ E D) v)
        (coordinate E D) ⟨0, β, γ⟩ Ga hflag
      rw [show MvPolynomial.eval₂Hom (algebraMap E (AJ E D)) (coordinate E D) Ga = BR E D Ga from by
        rw [HJ]
        exact (MvPolynomial.aeval_eq_eval₂Hom _ _).symm] at hA
      have hlog := (log_le_iff_le_exp hv0).mpr hA
      rw [RCN204.CWP, RCN204.BPD]
      simpa only [RCN204.flagPole, Nat.cast_zero, zero_mul, zero_add] using hlog
    rw [order_levelForm_add v c0 (not_lt.mp h), mul_zero, RCN026.order]
    linarith

end Curve

section Statement

variable {E : Type} [Field E] [IsAlgClosed E] {D : Ideal (MvPolynomial (Fin 3) E)} [D.IsPrime]

/-- The height bound on a curve on which the cofactor `H` has poles at most the flag at the zeros of
`Z - c0`. -/
theorem curve_of_pole (sep : RCN341.BP D) (c0 : E) (n β γ : ℕ) (Ga H : MvPolynomial (Fin 3) E)
    (hflag : BI ⟨0, β, γ⟩ Ga) (hGa : Ga ∉ D)
    (hmem : Ga - (MvPolynomial.X 2 - MvPolynomial.C c0) ^ n * H ∈ D)
    (hη : ∀ v : RCN026.Place E (AJ E D),
      v.val (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) < 1 →
      v.val (BR E D H) ≤ exp ((β : ℤ) * RCN204.flagPole v.val (coordinate E D) unitYZFlag +
        (γ : ℤ) * RCN204.flagPole v.val (coordinate E D) unitAllFlag))
    (T : Finset (RCN026.Place E (AJ E D))) :
    ∃ T' : Finset (RCN026.Place E (AJ E D)),
      (n : ℤ) * ∑ v ∈ T, RCN204.flagPole v.val (coordinate E D) unitZFlag ≤
        (β : ℤ) * ∑ v ∈ T', RCN204.flagPole v.val (coordinate E D) unitYZFlag +
          (γ : ℤ) * ∑ v ∈ T', RCN204.flagPole v.val (coordinate E D) unitAllFlag := by
  classical
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact ⟨∅, by simp⟩
  have hγ0 : BR E D Ga ≠ 0 := fun h => hGa ((Sec.BR_eq_zero_iff (G := D) Ga).mp h)
  have hprod : BR E D Ga = BR E D (MvPolynomial.X 2 - MvPolynomial.C c0) ^ n * BR E D H := by
    have h := (Sec.BR_eq_zero_iff (G := D) _).mpr hmem
    rwa [map_sub, map_mul, map_pow, sub_eq_zero] at h
  have hζ0 : BR E D (MvPolynomial.X 2 - MvPolynomial.C c0) ≠ 0 := fun h =>
    hγ0 (by rw [hprod, h, zero_pow hn.ne', zero_mul])
  obtain ⟨T1, hT1⟩ := LevelCount.exists_sum_order_eq_zero sep _ hγ0
  obtain ⟨T2, hT2⟩ := LevelCount.exists_sum_order_eq_zero sep _ hζ0
  refine ⟨T ∪ (T1 ∪ T2), ?_⟩
  have h1 := hT1 (T ∪ (T1 ∪ T2))
    (fun v hv => Finset.mem_union_right _ (Finset.mem_union_left _ hv))
  have h2 := hT2 (T ∪ (T1 ∪ T2))
    (fun v hv => Finset.mem_union_right _ (Finset.mem_union_right _ hv))
  have hkey := Finset.sum_le_sum fun v (_ : v ∈ T ∪ (T1 ∪ T2)) =>
    order_aux_ge v c0 n β γ Ga H hflag hγ0 hprod (hη v)
  rw [← Finset.mul_sum, Finset.sum_add_distrib, h2, zero_add, Finset.sum_add_distrib, h1, zero_add,
    Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum] at hkey
  refine le_trans (mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg n)) hkey
  have hZ : ∀ v : RCN026.Place E (AJ E D),
      RCN204.flagPole v.val (coordinate E D) unitZFlag = poleOrder v.val (coordinate E D 2) :=
    fun v => by simp [RCN204.flagPole, unitZFlag]
  simp only [hZ]
  exact Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_left
    fun v _ _ => le_max_left 0 _

end Statement

/-- The height bound on a curve on which no coordinate has a pole at a zero of `Z - c0`. -/
theorem curve (E : Type) [Field E] [IsAlgClosed E] : CurveStatement E := by
  intro D _ sep c0 n β γ Ga H hflag hGa hmem hfin T
  refine curve_of_pole sep c0 n β γ Ga H hflag hGa hmem (fun v hv => ?_) T
  refine (Sec.place_BR_le_one v (hfin v hv) H).trans ?_
  rw [← exp_zero, exp_le_exp]
  exact add_nonneg
    (mul_nonneg (Nat.cast_nonneg β) (RCN204.ALZ v.val (coordinate E D) unitYZFlag))
    (mul_nonneg (Nat.cast_nonneg γ) (RCN204.ALZ v.val (coordinate E D) unitAllFlag))

end

end ProximityPrize.SubmissionLower.FormalR.H2Lev
end
section

/-!
The point budget with the elementary height bound: the statements of its parts. Definitions only.

Setting. `E` is an algebraically closed field over the generic field of `K`, `E₁ = GenericField E` is the
algebraic closure of `E(T)`, and `T` is the transcendental level. For a pencil `Q`, `A` over `E` the
budget counts points of `E₁³` on the carrier, on the level cut `H (T - Q) - A G` and on a cut of flag
`W`, off the zeros of the excluded polynomial, and isolated among the common zeros of the three. The
level curves are the minimal primes of the carrier and the level cut that do not contain the excluded
polynomial; they form a finite type.

* `GoodCurve`: a level curve of height two that lies on a factor of the carrier not dividing the level
  cut and has a separable coordinate. Every level curve through a counted point is one.
* `CountedStatement`: finitely many places of finitely many good level curves, at least as many as the
  counted points; the cut is not zero on these curves and vanishes at these places.
* `CurveH2Statement`: on a curve of the carrier and the level cut with a separable coordinate on which
  the derivative of the carrier is not zero, `n` times the poles of `Z` is at most `β` times the poles of
  the flag `(0, 1, 0)` plus `γ` times the poles of the flag `(0, 0, 1)`.
* `SeparableFormStatement`: on a good level curve the function field is finite and separable over every
  polynomial of degree at most one that is not constant on the curve.
* `IsolatedStatement`: all points of a good level curve but finitely many are off the excluded
  polynomial, on no other level curve, and isolated on every cut that is not zero on the curve.
* `FibreBoundStatement`: on a good level curve a polynomial of degree at most one that is not constant
  takes all values but finitely many at no fewer points than it has poles.
* `UnitBoundStatement`: the budget for one pencil bounds the complete pole sums of the two unit flags
  over every finite family of good level curves: `scale` times the poles of the flag `(0, 1, 0)` by `u`
  and `scale` times the poles of the flag `(0, 0, 1)` by `v`.

The budget at the numbers `(n scale, min (n z) (β u + γ v), n u, n v)` follows: the number of counted
points is at most the zeros of the cut on the curves, hence at most its poles, which the flag `W` bounds
by `W₀` times the poles of `Z` plus `W₁`, `W₂` times the poles of the two unit flags; the second
statement replaces `n` times the poles of `Z`, and the last bounds the unit pole sums. The last rests on
the fibres of a separable function on an affine curve: all values but finitely many are taken at as
many points as the degree of the function field over the function.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Bud

open WithZero MvPolynomial
open RCN002 RCN084 RCN095 RCN135 RCN136 RCN264 RCN313
open BD DU LF WC _Q7

noncomputable section

section Packet

open scoped Classical

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}

/-- The level curves of the pencil `Q`, `A` at the transcendental level: the minimal primes of the
carrier and the level cut over `GenericField E` that do not contain the excluded polynomial. -/
abbrev LevelCurve (P : Packet x t y r) (SZ : Source P.F) {E : Type} [Field E]
    (f : GenericField K →+* E) (Q A : MvPolynomial (Fin 3) E) : Type :=
  AU (GenericField E) (OO f P.F) (XC f P.F Q A) (AOT f P.F A * SZ.leading ((HO E).comp (codeMap f)))

/-- A level curve of height two with a separable coordinate, on an irreducible factor of the carrier
that does not divide the level cut. -/
def GoodCurve (P : Packet x t y r) (SZ : Source P.F) {E : Type} [Field E]
    (f : GenericField K →+* E) (Q A : MvPolynomial (Fin 3) E) (V : LevelCurve P SZ f Q A) : Prop :=
  Nonempty (RCN341.BP V.1) ∧ V.1.height = 2 ∧
    ∃ g : MvPolynomial (Fin 3) (GenericField E),
      Irreducible g ∧ g ∣ OO f P.F ∧ g ∈ V.1 ∧ ¬g ∣ XC f P.F Q A

/-- The counted points on the curves. For a finite set of points on the carrier and the level cut, off
the zeros of the excluded polynomial, at which `cut` vanishes and which are isolated among the common
zeros of the three: finitely many good level curves and finitely many places of each, at least as many
in all as the points, such that `cut` is not zero on these curves and has a zero at each of these
places. -/
def CountedStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  ∀ (E : Type) [Field E] [IsAlgClosed E] [CharP E 2130706433] (f : GenericField K →+* E)
    (Q A : MvPolynomial (Fin 3) E), (2 : MvPolynomial (Fin 3) E) * A ≠ 0 →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A →
    ∀ (cut : MvPolynomial (Fin 3) (GenericField E)) (points : Finset (Fin 3 → GenericField E)),
      (∀ w ∈ points, MvPolynomial.eval w (OO f P.F) = 0) →
      (∀ w ∈ points, MvPolynomial.eval w (XC f P.F Q A) = 0) →
      (∀ w ∈ points,
        MvPolynomial.eval w (AOT f P.F A * SZ.leading ((HO E).comp (codeMap f))) ≠ 0) →
      (∀ w ∈ points, MvPolynomial.aeval w cut = 0) →
      (∀ w ∈ points, UK (OO f P.F) (XC f P.F Q A) cut w) →
      ∃ (S : Finset (LevelCurve P SZ f Q A))
        (T : ∀ V : LevelCurve P SZ f Q A,
          Finset (RCN026.Place (GenericField E) (AJ (GenericField E) V.1))),
        (∀ V ∈ S, GoodCurve P SZ f Q A V ∧ cut ∉ V.1 ∧
          ∀ μ ∈ T V, μ.val (BR (GenericField E) V.1 cut) < 1) ∧
        points.card ≤ ∑ V ∈ S, (T V).card

/-- The elementary height bound on one curve of the carrier and the level cut. The curve has a separable
coordinate, is not a point, and the derivative of the carrier is not zero on it. -/
def CurveH2Statement (P : Packet x t y r) : Prop :=
  ∀ (n β γ : ℕ), H2Sec.ExistsAux P n β γ →
  ∀ (E : Type) [Field E] [IsAlgClosed E] (f : GenericField K →+* E) (Q A : MvPolynomial (Fin 3) E)
    (D : Ideal (MvPolynomial (Fin 3) (GenericField E))) [D.IsPrime] (_sep : RCN341.BP D),
    OO f P.F ∈ D → XC f P.F Q A ∈ D →
    surfaceMap ((HO E).comp (codeMap f)) (RCN313.polyH K P.F) ∉ D →
    (∀ w : Fin 3 → GenericField E, D ≠ RingHom.ker (MvPolynomial.aeval w).toRingHom) →
    ∀ T : Finset (RCN026.Place (GenericField E) (AJ (GenericField E) D)),
      ∃ T' : Finset (RCN026.Place (GenericField E) (AJ (GenericField E) D)),
        (n : ℤ) * ∑ v ∈ T, RCN204.flagPole v.val (coordinate (GenericField E) D) unitZFlag ≤
          (β : ℤ) * ∑ v ∈ T', RCN204.flagPole v.val (coordinate (GenericField E) D) unitYZFlag +
            (γ : ℤ) * ∑ v ∈ T', RCN204.flagPole v.val (coordinate (GenericField E) D) unitAllFlag

/-- Separability of a linear form on a good level curve. Let `ℓ` be a polynomial of degree at most one,
and let the function field of the curve carry a structure of algebra over the rational functions `k(X)`,
over the constants, in which `X` is the class of `ℓ`. Then the function field is finite and separable
over `k(X)`: the degree of `ℓ` on the curve is below the characteristic. -/
def SeparableFormStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  ∀ (E : Type) [Field E] [IsAlgClosed E] [CharP E 2130706433] (f : GenericField K →+* E)
    (Q A : MvPolynomial (Fin 3) E), (2 : MvPolynomial (Fin 3) E) * A ≠ 0 →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A →
    ∀ V : LevelCurve P SZ f Q A, GoodCurve P SZ f Q A V →
    ∀ ℓ : MvPolynomial (Fin 3) (GenericField E), BI unitAllFlag ℓ →
    ∀ [Algebra (RatFunc (GenericField E)) (AJ (GenericField E) V.1)]
      [IsScalarTower (GenericField E) (RatFunc (GenericField E)) (AJ (GenericField E) V.1)],
      algebraMap (RatFunc (GenericField E)) (AJ (GenericField E) V.1) RatFunc.X =
          BR (GenericField E) V.1 ℓ →
        FiniteDimensional (RatFunc (GenericField E)) (AJ (GenericField E) V.1) ∧
          Algebra.IsSeparable (RatFunc (GenericField E)) (AJ (GenericField E) V.1)

/-- Isolation on a good level curve. There is a polynomial `h`, not zero on the curve, such that every
point `w` of the curve with `h w ≠ 0` is off the zeros of the excluded polynomial, lies on no other level
curve, and is isolated among the common zeros of the carrier, the level cut and any polynomial that is
not zero on the curve. -/
def IsolatedStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  ∀ (E : Type) [Field E] [IsAlgClosed E] [CharP E 2130706433] (f : GenericField K →+* E)
    (Q A : MvPolynomial (Fin 3) E), (2 : MvPolynomial (Fin 3) E) * A ≠ 0 →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A →
    ∀ V : LevelCurve P SZ f Q A, GoodCurve P SZ f Q A V →
    ∃ h : MvPolynomial (Fin 3) (GenericField E), h ∉ V.1 ∧
      ∀ w : Fin 3 → GenericField E, V.1 ≤ RingHom.ker (MvPolynomial.aeval w).toRingHom →
        MvPolynomial.eval w h ≠ 0 →
        MvPolynomial.eval w (AOT f P.F A * SZ.leading ((HO E).comp (codeMap f))) ≠ 0 ∧
        (∀ V' : LevelCurve P SZ f Q A,
          V'.1 ≤ RingHom.ker (MvPolynomial.aeval w).toRingHom → V' = V) ∧
        ∀ cut : MvPolynomial (Fin 3) (GenericField E), cut ∉ V.1 →
          UK (OO f P.F) (XC f P.F Q A) cut w

/-- The poles of a linear form against its general fibre. On a good level curve let `ℓ` be a polynomial
of degree at most one that is not constant on the curve and `g` a polynomial that is not zero on the
curve. For all values `a` but finitely many there are finitely many points of the curve with `ℓ = a` and
`g ≠ 0`, at least as many as the poles of `ℓ`, with multiplicity, at any finite set of places. -/
def FibreBoundStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  ∀ (E : Type) [Field E] [IsAlgClosed E] [CharP E 2130706433] (f : GenericField K →+* E)
    (Q A : MvPolynomial (Fin 3) E), (2 : MvPolynomial (Fin 3) E) * A ≠ 0 →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A →
    ∀ V : LevelCurve P SZ f Q A, GoodCurve P SZ f Q A V →
    ∀ ℓ g : MvPolynomial (Fin 3) (GenericField E), BI unitAllFlag ℓ →
      (∀ a : GenericField E, ℓ - MvPolynomial.C a ∉ V.1) → g ∉ V.1 →
      {a : GenericField E | ¬∃ pts : Finset (Fin 3 → GenericField E),
        (∀ w ∈ pts, V.1 ≤ RingHom.ker (MvPolynomial.aeval w).toRingHom ∧
          MvPolynomial.eval w ℓ = a ∧ MvPolynomial.eval w g ≠ 0) ∧
        ∀ U : Finset (RCN026.Place (GenericField E) (AJ (GenericField E) V.1)),
          ∑ v ∈ U, RCN187.poleOrder v.val (BR (GenericField E) V.1 ℓ) ≤ (pts.card : ℤ)}.Finite

/-- The unit bounds from the budget of one pencil: over every finite family of good level curves and
every choice of finitely many places on each, `scale` times the pole sum of the flag `(0, 1, 0)` is at
most `u` and `scale` times the pole sum of the flag `(0, 0, 1)` is at most `v`. -/
def UnitBoundStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  ∀ (E : Type) [Field E] [IsAlgClosed E] [CharP E 2130706433] (f : GenericField K →+* E)
    (scale z u v : ℕ) (Q A : MvPolynomial (Fin 3) E), (2 : MvPolynomial (Fin 3) E) * A ≠ 0 →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A → AGN f P.F SZ Q A scale z u v →
    ∀ S : Finset (LevelCurve P SZ f Q A), (∀ V ∈ S, GoodCurve P SZ f Q A V) →
    ∀ U : ∀ V : LevelCurve P SZ f Q A,
        Finset (RCN026.Place (GenericField E) (AJ (GenericField E) V.1)),
      (scale : ℤ) * ∑ V ∈ S, ∑ μ ∈ U V,
          RCN204.flagPole μ.val (coordinate (GenericField E) V.1) unitYZFlag ≤ u ∧
        (scale : ℤ) * ∑ V ∈ S, ∑ μ ∈ U V,
          RCN204.flagPole μ.val (coordinate (GenericField E) V.1) unitAllFlag ≤ v

end Packet

