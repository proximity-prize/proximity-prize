/-!
The packet count `P.seeds.card ≤ pairStageCostR` from budgets on the live curves.

* `exists_provider_of_R_budget`: on one stage, a number `mov C` for every live curve `C` with

    `3 * den * #seeds(C) ≤ den * [C . cutR (w + delay)] + 4 * (w + delay) * mov C`  (delay proper, any size)

  gives the provider `IB.AKI` with the cost
  `multiplicity C * (den * [C . cutR (w + 1)] + 4 * (w + 1) * mov C) / (3 * den)` on the live curves.
  `mov C / den` is the moving number of the curve; `den` is a common denominator of the local numbers.
* `regular_pair_packet_countR_asym`: for a packet, `SharedRCostAsym` gives `P.seeds.card ≤ pairStageCostR`.
-/

namespace ProximityPrize.SubmissionLower.FormalR

section Provider
open scoped Classical BigOperators
open RCN074 RCN086 RCN095 RCN135 RCN136 RCN159 RCN199 RCN237 RCN238 RCN243 RCN244 RCN264 RCN313 RCN327
open RCN334 RCN339 FA IB
noncomputable section

/-- Flag for the tail of index `m` on a cell with `Hflag = (z, v, r - 1)`:
`m (2 Hflag - 5 e_all) + 3 e_all`. -/
def cutR (m r v z : ℕ) : FlagDegree :=
  m • (⟨2 * z, 2 * v, 2 * r - 7⟩ : FlagDegree) + ⟨0, 0, 3⟩

def cellCutR (t y r : ℕ) : FlagDegree :=
  cutR (w + 1) r (y - r) (t - y)

theorem cutR_delay_le_smul (mu delay r v z : ℕ) (hmu : 1 ≤ mu) (hdelay : delay ≤ mu) :
    (cutR (w + delay) r v z).zOnly ≤ (mu • cutR (w + 1) r v z).zOnly ∧
    (cutR (w + delay) r v z).yz ≤ (mu • cutR (w + 1) r v z).yz ∧
    (cutR (w + delay) r v z).all ≤ (mu • cutR (w + 1) r v z).all := by
  have hscale : w + delay ≤ mu * (w + 1) := by nlinarith [Nat.mul_le_mul_right w hmu]
  have ha := Nat.mul_le_mul_right (2 * r - 7) hscale
  have hv := Nat.mul_le_mul_right (2 * v) hscale
  have hz := Nat.mul_le_mul_right (2 * z) hscale
  simp only [cutR, add_zOnly, add_yz, add_all, nsmul_zOnly, nsmul_yz, nsmul_all]
  refine ⟨?_, ?_, ?_⟩ <;> nlinarith

variable {K I : Type} [Field K]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {Gamma : Finset K} {x : I → K} {p : ℕ} {flag : FlagDegree}
variable [CharP (GenericField K) p]
variable {stageErrorCap : ℕ}

theorem exists_provider_of_R_budget
    (t y r : Nat)
    (S : FH (AL K) Gamma x p stageErrorCap flag w (cellSupport t y r))
    (hfirstProper : ¬ S.G ∣ _Q2 (AL K) S.F (w + 1))
    (tail1 : FlagDegree)
    (B : FE (G := S.G) (T := _Q2 (AL K) S.F (w + 1)) (H := CR (AL K) S.F) flag tail1)
    (budget : ∀ C : CM S, RD C.1 (CR (AL K) S.F) (surfaceMap (AL K) (polyG K S.F)))
    (hcost : ∀ C : CM S,
      (budget C).zCost = B.zCost C ∧ (budget C).yzCost = B.yzCost C ∧
        (budget C).allCost = B.allCost C)
    (den : ℕ) (hden : 0 < den) (mov : CM S → ℕ)
    (active : Finset (CM S))
    (hcount : ∀ C ∈ active, ∀ delay : ℕ, 1 ≤ delay →
      _Q2 (AL K) S.F (w + 1 + delay) ∉ C.1 →
      3 * den * (HF (GenericField K) S.G (_Q2 (AL K) S.F (w + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C).card ≤
        den * (budget C).weightedCost (cutR (w + delay) r (y - r) (t - y)) +
          4 * (w + delay) * mov C)
    (divisorBound : ℕ)
    (hinactive : ∀ C : CM S, C ∉ active →
      (HF (GenericField K) S.G (_Q2 (AL K) S.F (w + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C).card = 0)
    (hjoint : (∑ C ∈ active,
      FO (MU S) (DN (MU S) hfirstProper) C *
        (den * B.weightedCost (cellCutR t y r) C + 4 * (w + 1) * mov C) / (3 * den)) ≤
      divisorBound)
    (hgate : 3 * (stageErrorCap + 1) ≤ (cellCutR t y r).yz)
    (htangent : ∀ C : CM S,
      (∀ delay, _Q2 (AL K) S.F (w + 1 + delay) ∈ C.1) →
      (HF (GenericField K) S.G (_Q2 (AL K) S.F (w + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C).card ≤ (stageErrorCap + 1) * B.yzCost C) :
    Nonempty (AKI (tailFlag1 := tail1) (tailFlag2 := cellCutR t y r) S divisorBound) := by
  classical
  let S0 := MU S
  let multiplicity : CM S → ℕ := fun C => FO S0 (DN S0 hfirstProper) C
  have hone : ∀ C, 1 ≤ multiplicity C := ADP S hfirstProper
  have hwcEq : ∀ (C : CM S) (f : FlagDegree),
      (budget C).weightedCost f = B.weightedCost f C := by
    intro C f
    obtain ⟨hz, hy', ha⟩ := hcost C
    simp only [RD.weightedCost, FE.weightedCost, hz, hy', ha]
  have hscale : ∀ (m : ℕ) (f : FlagDegree) (C : CM S),
      B.weightedCost (m • f) C = m * B.weightedCost f C := by
    intro m f C
    simp only [FE.weightedCost, nsmul_zOnly, nsmul_yz, nsmul_all]
    ring
  let total : CM S → ℕ := fun C =>
    multiplicity C * (den * B.weightedCost (cellCutR t y r) C + 4 * (w + 1) * mov C)
  have hbound : ∀ C ∈ active,
      3 * den * (HF (GenericField K) S.G (_Q2 (AL K) S.F (w + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C).card ≤ total C := by
    intro C hactive
    have dichotomy := AEM S0 (DN S0 hfirstProper) C hfirstProper
    rcases dichotomy.2 with hproper | htangentBranch
    · obtain ⟨delay, hdelay, hdelayMu, htail⟩ := hproper
      have hc := hcount C hactive delay hdelay htail
      rw [hwcEq] at hc
      have hmono := cutR_delay_le_smul (multiplicity C) delay r (y - r) (t - y) (hone C) hdelayMu
      have hcostle := CUY B C hmono.1 hmono.2.1 hmono.2.2
      rw [hscale] at hcostle
      have hfactor : w + delay ≤ multiplicity C * (w + 1) := by
        nlinarith [Nat.mul_le_mul_right w (hone C), hdelayMu]
      have hmove : 4 * (w + delay) * mov C ≤ multiplicity C * (4 * (w + 1) * mov C) := by
        nlinarith [Nat.mul_le_mul_right (4 * mov C) hfactor]
      calc _ ≤ den * B.weightedCost (cutR (w + delay) r (y - r) (t - y)) C +
            4 * (w + delay) * mov C := hc
        _ ≤ den * (multiplicity C * B.weightedCost (cutR (w + 1) r (y - r) (t - y)) C) +
            multiplicity C * (4 * (w + 1) * mov C) :=
          Nat.add_le_add (Nat.mul_le_mul_left den hcostle) hmove
        _ = total C := by simp only [total, cellCutR]; ring
    · have hc := htangent C htangentBranch
      calc _ ≤ 3 * den * ((stageErrorCap + 1) * B.yzCost C) := Nat.mul_le_mul_left _ hc
        _ = den * ((3 * (stageErrorCap + 1)) * B.yzCost C) := by ring
        _ ≤ den * B.weightedCost (cellCutR t y r) C := Nat.mul_le_mul_left den
          (BIB B (cellCutR t y r) C (3 * (stageErrorCap + 1)) hgate)
        _ ≤ multiplicity C * (den * B.weightedCost (cellCutR t y r) C) := by
          simpa only [one_mul] using Nat.mul_le_mul_right
            (den * B.weightedCost (cellCutR t y r) C) (hone C)
        _ ≤ total C := Nat.mul_le_mul_left _ (Nat.le_add_right _ _)
  let cost : CM S → ℕ := fun C => if C ∈ active then total C / (3 * den) else 0
  have hcostBound : ∀ C,
      (HF (GenericField K) S.G (_Q2 (AL K) S.F (w + 1)) (CR (AL K) S.F) Gamma
        (DK (AL K) S.selected) C).card ≤ cost C := by
    intro C
    by_cases hC : C ∈ active
    · simp only [cost, hC, ite_true]
      exact (Nat.le_div_iff_mul_le (by omega : 0 < 3 * den)).mpr
        ((Nat.mul_comm _ _).trans_le (hbound C hC))
    · simp only [cost, hC, ite_false, hinactive C hC, le_refl]
  have hsum : (∑ C, cost C) ≤ divisorBound := by
    have ha : (∑ C, cost C) = ∑ C ∈ active, total C / (3 * den) := by
      simp only [cost, Finset.sum_ite_mem, Finset.univ_inter]
    rw [ha]
    simpa only [total, multiplicity, S0] using hjoint
  have providerDichotomy := AFC S hfirstProper B htangent
  exact ⟨{
    budgetFamily := B
    multiplicity := multiplicity
    cost := cost
    one_le_multiplicity := hone
    EHX := le_trans (by omega) hgate
    cost_sum_le := hsum
    CRK := hcostBound
    dichotomy := providerDichotomy }⟩

end
end Provider

section Packet
noncomputable section
open scoped Classical BigOperators
open RCN074 RCN086 RCN095 RCN135 RCN199 RCN222 RCN238 RCN243 RCN264 RCN312 RCN313 RCN334
open FA IB BD DU BOE AYR AFA TW CB HFreeDir6813 RL
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

/-- Numerator of the price, cleared of the multiplicity `d` of the fixed source:
`9 * d * scale * count ≤ pairNumeratorR`. -/
def pairNumeratorR (d scale z u v t y r : ℕ) (flag source : FlagDegree) : ℕ :=
  d * (scale * (∑ j : Fin 3, weight (cellCutR t y r) j *
        flagMixed flag (ASY t y r j) (BD.direction j)) +
      8 * (w + 1) * price (cellCutR t y r) z u v) +
    16 * (w + 1) ^ 2 * price source z u v

def pairStageCostR {F : MvPolynomial (Fin 4) K}
    (SZ SP SQ : Source F) (delta t y r : ℕ) (flag : FlagDegree) : ℕ :=
  pairNumeratorR SZ.d (stageScale SZ delta)
    (delta * flagMixed ⟨t - y, y - r, r⟩ unitZFlag SZ.flag)
    (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitYZFlag)
    (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitAllFlag)
    t y r flag SZ.flag / (9 * SZ.d * stageScale SZ delta)

/-- The packet count from cleared budgets. `loss` is an additive error of the joint budget, smaller than
the common denominator. -/
theorem packet_count_of_cleared_budget
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ SP SQ : Source P.F) (delta : ℕ) (hd : 0 < delta)
    (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F))
    (den : ℕ) (mov : Curve P → ℕ) (loss : ℕ) (hloss : loss < den)
    (hcost : ∀ a, (budget a).zCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).zCost a.2 ∧
      (budget a).yzCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).yzCost a.2 ∧
      (budget a).allCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).allCost a.2)
    (hcount : ∀ a ∈ active P SZ, ∀ delay : ℕ, 1 ≤ delay →
      _Q2 (AL K) (P.stage a.1).F (w + 1 + delay) ∉ a.2.1 →
      3 * den * (HF Ω (P.stage a.1).G
          (_Q2 (AL K) (P.stage a.1).F (w + 1))
          (CR (AL K) (P.stage a.1).F)
          (KK K P.F P.selected P.seeds a.1)
          (DK (AL K) (P.stage a.1).selected) a.2).card ≤
        den * (budget a).weightedCost (cutR (w + delay) r (y - r) (t - y)) +
          4 * (w + delay) * mov a)
    (hjoint : (3 * SZ.d * stageScale SZ delta) * (∑ a ∈ active P SZ, multiplicity P hp a *
        (den * ordinary P hp geometry a (cellCutR t y r) + 4 * (w + 1) * mov a)) ≤
      den * pairNumeratorR SZ.d (stageScale SZ delta)
        (delta * flagMixed ⟨t - y, y - r, r⟩ unitZFlag SZ.flag)
        (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitYZFlag)
        (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitAllFlag)
        t y r ⟨t - y, y - r, r⟩ SZ.flag + loss)
    (hgood : ∀ gamma ∈ P.seeds,
      MvPolynomial.eval (DK (AL K) P.selected gamma) (SZ.leading (AL K)) ≠ 0) :
    P.seeds.card ≤ pairStageCostR SZ SP SQ delta t y r ⟨t - y, y - r, r⟩ := by
  have hylo := P.ylow
  have hden : 0 < den := Nat.zero_lt_of_lt hloss
  let total (a : Curve P) := multiplicity P hp a *
    (den * ordinary P hp geometry a (cellCutR t y r) + 4 * (w + 1) * mov a)
  let live (g : EX K P.F) : Finset (CM (P.stage g)) :=
    Finset.univ.filter (fun C => SZ.leading (AL K) ∉ C.1)
  have hsingle (g : EX K P.F) :
      (KK K P.F P.selected P.seeds g).card ≤ ∑ C ∈ live g, total ⟨g, C⟩ / (3 * den) := by
    let S := P.stage g
    let B := BLJ S (P.stage_proper hp g) (geometry g)
    have hinactive : ∀ C : CM S, C ∉ live g →
        (HF Ω S.G (_Q2 (AL K) S.F (w + 1)) (CR (AL K) S.F) (KK K P.F P.selected P.seeds g)
          (DK (AL K) S.selected) C).card = 0 := by
      intro C hC
      have hmem : SZ.leading (AL K) ∈ C.1 := by
        simpa only [live, Finset.mem_filter, Finset.mem_univ, true_and, not_not] using hC
      exact AEF.BOK _ _ _ (SZ.leading (AL K)) (KK K P.F P.selected P.seeds g)
        (DK (AL K) S.selected) C hmem
        (fun gamma hg => hgood gamma (WK K P.F P.selected P.seeds g hg))
    obtain ⟨provider⟩ := exists_provider_of_R_budget t y r S (P.stage_proper hp g)
      (TX t y r) B (fun C => budget ⟨g, C⟩) (fun C => hcost ⟨g, C⟩)
      den hden (fun C => mov ⟨g, C⟩) (live g)
      (fun C hC delay hdelay htail => hcount ⟨g, C⟩
        (Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp hC).2⟩) delay hdelay htail)
      (∑ C ∈ live g, total ⟨g, C⟩ / (3 * den)) hinactive (le_refl _)
      (by dsimp [cellCutR, cutR, RCN327.w]; omega)
      (fun C hall => ALX S C (P.stage_proper hp g) (suppliedBase S (geometry g) C)
        _ P.D t r P.nodeCount (P.CVV g) (by decide) (by decide)
        P.Dlow P.Dchar P.box B (EKM S (P.stage_proper hp g) (geometry g) C) hall
        (FDD S (P.stage_proper hp g) (geometry g) C))
    exact BIF S provider
  have hsum : (∑ g, ∑ C ∈ live g, total ⟨g, C⟩ / (3 * den)) =
      ∑ a ∈ active P SZ, total a / (3 * den) := by
    simp only [live, active, Finset.sum_filter]
    rw [Fintype.sum_sigma]
  have hthird : (∑ a ∈ active P SZ, total a / (3 * den)) * (3 * den) ≤
      ∑ a ∈ active P SZ, total a := by
    rw [Finset.sum_mul]
    exact Finset.sum_le_sum (fun a _ => Nat.div_mul_le_self (total a) (3 * den))
  have hcard : P.seeds.card ≤ ∑ a ∈ active P SZ, total a / (3 * den) := by
    calc
      P.seeds.card ≤ ∑ g, (KK K P.F P.selected P.seeds g).card := P.seeds_cover
      _ ≤ ∑ g, ∑ C ∈ live g, total ⟨g, C⟩ / (3 * den) := Finset.sum_le_sum (fun g _ => hsingle g)
      _ = ∑ a ∈ active P SZ, total a / (3 * den) := hsum
  have hdZ : 0 < SZ.d := by dsimp [Source.d]; omega
  have hscale : 0 < stageScale SZ delta := Nat.mul_pos hdZ hd
  have hmain : den * (P.seeds.card * (9 * SZ.d * stageScale SZ delta)) ≤
      den * pairNumeratorR SZ.d (stageScale SZ delta)
        (delta * flagMixed ⟨t - y, y - r, r⟩ unitZFlag SZ.flag)
        (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitYZFlag)
        (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitAllFlag)
        t y r ⟨t - y, y - r, r⟩ SZ.flag + loss := by
    calc den * (P.seeds.card * (9 * SZ.d * stageScale SZ delta))
        = (3 * SZ.d * stageScale SZ delta) * (P.seeds.card * (3 * den)) := by ring
      _ ≤ (3 * SZ.d * stageScale SZ delta) *
          ((∑ a ∈ active P SZ, total a / (3 * den)) * (3 * den)) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hcard)
      _ ≤ (3 * SZ.d * stageScale SZ delta) * (∑ a ∈ active P SZ, total a) :=
        Nat.mul_le_mul_left _ hthird
      _ ≤ _ := hjoint
  refine (Nat.le_div_iff_mul_le (Nat.mul_pos (Nat.mul_pos (by decide) hdZ) hscale)).mpr ?_
  have hlt : den * (P.seeds.card * (9 * SZ.d * stageScale SZ delta)) <
      den * (pairNumeratorR SZ.d (stageScale SZ delta)
        (delta * flagMixed ⟨t - y, y - r, r⟩ unitZFlag SZ.flag)
        (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitYZFlag)
        (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitAllFlag)
        t y r ⟨t - y, y - r, r⟩ SZ.flag + 1) := by
    rw [Nat.mul_add, Nat.mul_one]
    exact Nat.lt_of_le_of_lt hmain (Nat.add_lt_add_left hloss _)
  exact Nat.lt_succ_iff.mp (Nat.lt_of_mul_lt_mul_left hlt)

/-- For one packet: budgets on the curves with the costs of
the supplied budget, and, for common denominators `den` beyond any bound, numbers `mov a`
(`mov a / den` is the moving number of the curve `a`) with the count on every live curve and the joint budget
up to a constant `loss` that does not depend on `den`. -/
def SharedRCostAsym (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ SP SQ : Source P.F) (delta : ℕ) : Prop :=
  ∃ (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F)) (loss : ℕ),
    (∀ a, (budget a).zCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).zCost a.2 ∧
      (budget a).yzCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).yzCost a.2 ∧
      (budget a).allCost =
        (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).allCost a.2) ∧
    ∀ bound : ℕ, ∃ (den : ℕ) (mov : Curve P → ℕ), bound < den ∧
    (∀ a ∈ active P SZ, ∀ delay : ℕ, 1 ≤ delay →
      _Q2 (AL K) (P.stage a.1).F (w + 1 + delay) ∉ a.2.1 →
      3 * den * (HF Ω (P.stage a.1).G
          (_Q2 (AL K) (P.stage a.1).F (w + 1))
          (CR (AL K) (P.stage a.1).F)
          (KK K P.F P.selected P.seeds a.1)
          (DK (AL K) (P.stage a.1).selected) a.2).card ≤
        den * (budget a).weightedCost (cutR (w + delay) r (y - r) (t - y)) +
          4 * (w + delay) * mov a) ∧
    (3 * SZ.d * stageScale SZ delta) * (∑ a ∈ active P SZ, multiplicity P hp a *
        (den * ordinary P hp geometry a (cellCutR t y r) + 4 * (w + 1) * mov a)) ≤
      den * pairNumeratorR SZ.d (stageScale SZ delta)
        (delta * flagMixed ⟨t - y, y - r, r⟩ unitZFlag SZ.flag)
        (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitYZFlag)
        (SZ.d * flagMixed (ordinaryFlag SP.P) (ordinaryFlag SQ.P) unitAllFlag)
        t y r ⟨t - y, y - r, r⟩ SZ.flag + loss

theorem regular_pair_packet_countR_asym
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ SP SQ : Source P.F) (delta : ℕ) (hd : 0 < delta)
    (hR : SharedRCostAsym P hp SZ SP SQ delta)
    (hgood : ∀ gamma ∈ P.seeds,
      MvPolynomial.eval (DK (AL K) P.selected gamma) (SZ.leading (AL K)) ≠ 0) :
    P.seeds.card ≤ pairStageCostR SZ SP SQ delta t y r ⟨t - y, y - r, r⟩ := by
  obtain ⟨geometry, budget, loss, hcost, hall⟩ := hR
  obtain ⟨den, mov, hden, hcount, hjoint⟩ := hall loss
  exact packet_count_of_cleared_budget P hp SZ SP SQ delta hd geometry budget den mov loss hden hcost hcount
    hjoint hgood

end
end Packet

end ProximityPrize.SubmissionLower.FormalR
