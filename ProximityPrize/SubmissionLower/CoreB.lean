/-!
Upper bounds for the cell of a `DU.Packet`: `r ≤ 16`, `y ≤ 128` and `t ≤ 5000`, from the bounds of the
structure by arithmetic.
-/

namespace ProximityPrize.SubmissionLower.FormalR

variable {K I : Type} [Field K] {x : I → K} {t y r : ℕ}

theorem packet_r_le (P : DU.Packet x t y r) : r ≤ 16 := P.rhigh.trans (by norm_num)

theorem packet_y_le (P : DU.Packet x t y r) : y ≤ 128 := P.yhigh.trans (by norm_num)

theorem packet_t_le (P : DU.Packet x t y r) : t ≤ 5000 := P.thigh.trans (by norm_num)

end ProximityPrize.SubmissionLower.FormalR
end
