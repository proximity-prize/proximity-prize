section

/-!
Linear independence modulo an ideal of a polynomial ring survives an extension of the field of
coefficients.

For fields `k ⊆ Ω`, an ideal `I` of `k[x]` and polynomials `u i` whose classes modulo `I` are linearly
independent over `k`: no nontrivial combination of the `u i` with coefficients in `Ω` lies in the
extension of `I` to `Ω[x]` (`H2Sec.eq_zero_of_sum_mem_map`). The proof applies a `k`-linear functional of
`Ω` to the coefficients (`coeffwise`): this is `k[x]`-linear, so it maps the extended ideal into `I`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Sec

open MvPolynomial

noncomputable section

section Descent

variable {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω] {σ : Type*}

/-- A `k`-linear functional of `Ω`, applied to the coefficients of a polynomial. -/
def coeffwise (μ : Ω →ₗ[k] k) : MvPolynomial σ Ω →ₗ[k] MvPolynomial σ k :=
  (AddMonoidAlgebra.coeffLinearEquiv k).symm.toLinearMap ∘ₗ Finsupp.mapRange.linearMap μ ∘ₗ
    (AddMonoidAlgebra.coeffLinearEquiv k).toLinearMap

theorem coeff_coeffwise (μ : Ω →ₗ[k] k) (p : MvPolynomial σ Ω) (d : σ →₀ ℕ) :
    (coeffwise μ p).coeff d = μ (p.coeff d) :=
  rfl

/-- `coeffwise μ` is linear over `k[x]`. -/
theorem coeffwise_mul_map (μ : Ω →ₗ[k] k) (q : MvPolynomial σ Ω) (f : MvPolynomial σ k) :
    coeffwise μ (q * MvPolynomial.map (algebraMap k Ω) f) = coeffwise μ q * f := by
  classical
  ext d
  rw [coeff_coeffwise, coeff_mul, coeff_mul, map_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [coeff_coeffwise, coeff_map, mul_comm, ← Algebra.smul_def, map_smul, smul_eq_mul, mul_comm]

theorem coeffwise_C_mul_map (μ : Ω →ₗ[k] k) (c : Ω) (f : MvPolynomial σ k) :
    coeffwise μ (C c * MvPolynomial.map (algebraMap k Ω) f) = C (μ c) * f := by
  classical
  rw [coeffwise_mul_map]
  congr 1
  ext d
  rw [coeff_coeffwise, coeff_C, coeff_C]
  split_ifs
  · rfl
  · exact map_zero μ

/-- `coeffwise μ` maps the extension of an ideal of `k[x]` into the ideal. -/
theorem coeffwise_mem (μ : Ω →ₗ[k] k) (I : Ideal (MvPolynomial σ k)) {x : MvPolynomial σ Ω}
    (hx : x ∈ I.map (MvPolynomial.map (algebraMap k Ω))) : coeffwise μ x ∈ I := by
  have h : ∀ a : MvPolynomial σ Ω, coeffwise μ (a * x) ∈ I := by
    rw [Ideal.map] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨f, hf, rfl⟩ := hy
      intro a
      rw [coeffwise_mul_map]
      exact I.mul_mem_left _ hf
    | zero =>
      intro a
      rw [mul_zero, map_zero]
      exact I.zero_mem
    | add y z _ _ hy hz =>
      intro a
      rw [mul_add, map_add]
      exact I.add_mem (hy a) (hz a)
    | smul b y _ hy =>
      intro a
      rw [smul_eq_mul, ← mul_assoc]
      exact hy (a * b)
  simpa only [one_mul] using h 1

/-- Classes that are linearly independent over `k` modulo `I` have no nontrivial combination over `Ω` in
the extension of `I`. -/
theorem eq_zero_of_sum_mem_map (I : Ideal (MvPolynomial σ k)) {ι : Type*}
    (u : ι → MvPolynomial σ k) (h : LinearIndependent k fun i => Ideal.Quotient.mk I (u i))
    (s : Finset ι) (c : ι → Ω)
    (hc : ∑ i ∈ s, C (c i) * MvPolynomial.map (algebraMap k Ω) (u i) ∈
      I.map (MvPolynomial.map (algebraMap k Ω))) : ∀ i ∈ s, c i = 0 := by
  have hμ : ∀ μ : Ω →ₗ[k] k, ∀ i ∈ s, μ (c i) = 0 := by
    intro μ
    have h1 := coeffwise_mem μ I hc
    rw [map_sum] at h1
    simp only [coeffwise_C_mul_map] at h1
    refine linearIndependent_iff'.mp h s (fun i => μ (c i)) ?_
    rw [← (Ideal.Quotient.eq_zero_iff_mem (I := I)).mpr h1, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [C_mul']
    rfl
  intro i hi
  exact (Module.forall_dual_apply_eq_zero_iff k (c i)).mp fun μ => hμ μ i hi

end Descent

end

end ProximityPrize.SubmissionLower.FormalR.H2Sec
end
section

/-!
Functions with bounded poles on finitely many complete curves.

A function field `L` of one variable over an algebraically closed field `K`, with the places
`RCN026.Place K L`: the surjective valuations of `L` that are trivial on `K`. A pole bound is a function
`D` from the places to `ℕ` that vanishes outside a finite set `T`; `deg D` stands for `∑ v ∈ T, D v`.

Over every value `c` of the parameter there is a place whose residue field is `K` (`placeAt`,
`exists_residue`), so there are infinitely many such places. A combination of functions with poles at
most `D`, whose residues combine to zero at more than `deg D` of these places, is zero, because a nonzero
function has at most as many zeros as poles, `RCN026.AUN` (`sum_smul_eq_zero`). For finitely many curves
with a separable coordinate this bounds a linearly independent family of tuples of functions by
`∑ (deg D + 1)`, the sum over the curves (`card_le_sum_degree`).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Pole

open IsDedekindDomain

noncomputable section

section Field

variable (K L : Type*) [Field K] [Field L] [Algebra K L] [IsAlgClosed K]
  [Algebra (Polynomial K) L] [Algebra (RatFunc K) L]
  [IsScalarTower K (Polynomial K) L] [IsScalarTower K (RatFunc K) L]
  [IsScalarTower (Polynomial K) (RatFunc K) L]
  [FiniteDimensional (RatFunc K) L] [Algebra.IsSeparable (RatFunc K) L]

/-- A point of the finite chart over the value `c` of the parameter. -/
def pointAt (c : K) : RCN349.ET K L →ₐ[K] K :=
  RCN354.FDV (FaithfulSMul.algebraMap_injective (Polynomial K) (RCN349.ET K L)) (Polynomial.aeval c)

omit [IsScalarTower K (RatFunc K) L] in
theorem pointAt_algebraMap (c : K) (f : Polynomial K) :
    pointAt K L c (algebraMap (Polynomial K) (RCN349.ET K L) f) = f.eval c := by
  have h := DFunLike.congr_fun (RCN354.FGG
    (FaithfulSMul.algebraMap_injective (Polynomial K) (RCN349.ET K L)) (Polynomial.aeval c)) f
  rw [← Polynomial.coe_aeval_eq_eval, ← h]
  rfl

/-- The prime of the finite chart at `pointAt K L c`. -/
def primeAt (c : K) : HeightOneSpectrum (RCN349.ET K L) where
  asIdeal := RingHom.ker (pointAt K L c).toRingHom
  isPrime := (RCN354.AWX (pointAt K L c)).isPrime
  ne_bot := fun h => by
    have hmem : algebraMap (Polynomial K) (RCN349.ET K L) (Polynomial.X - Polynomial.C c) ∈
        RingHom.ker (pointAt K L c).toRingHom := by
      change pointAt K L c _ = 0
      rw [pointAt_algebraMap, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self]
    rw [h, Ideal.mem_bot] at hmem
    exact Polynomial.X_sub_C_ne_zero c (FaithfulSMul.algebraMap_injective (Polynomial K)
      (RCN349.ET K L) (hmem.trans (map_zero _).symm))

/-- The place of `L` at `pointAt K L c`. -/
def placeAt (c : K) : RCN026.Place K L :=
  RCN345.chartMap K L (Sum.inl (primeAt K L c))

theorem placeAt_parameter_lt_one (c : K) :
    (placeAt K L c).val (algebraMap (Polynomial K) L (Polynomial.X - Polynomial.C c)) < 1 := by
  change (primeAt K L c).valuation L _ < 1
  rw [IsScalarTower.algebraMap_apply (Polynomial K) (RCN349.ET K L) L,
    HeightOneSpectrum.valuation_lt_one_iff_mem]
  change pointAt K L c _ = 0
  rw [pointAt_algebraMap, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self]

theorem placeAt_injective : Function.Injective (placeAt K L) := by
  intro c c' h
  by_contra hne
  have h1 := placeAt_parameter_lt_one K L c
  have h2 := placeAt_parameter_lt_one K L c'
  rw [← h] at h2
  have h3 : (placeAt K L c).val (algebraMap K L (c' - c)) < 1 := by
    have heq : algebraMap K L (c' - c) =
        algebraMap (Polynomial K) L (Polynomial.X - Polynomial.C c) -
          algebraMap (Polynomial K) L (Polynomial.X - Polynomial.C c') := by
      rw [← map_sub, IsScalarTower.algebraMap_apply K (Polynomial K) L]
      congr 1
      rw [Polynomial.algebraMap_eq, map_sub]
      ring
    rw [heq]
    exact (Valuation.map_sub _ _ _).trans_lt (max_lt h1 h2)
  rw [(placeAt K L c).property.2.eq_one _ (sub_ne_zero.mpr (Ne.symm hne))] at h3
  exact lt_irrefl _ h3

/-- The residue field of `placeAt K L c` is `K`: a function without pole there differs from a constant
by a function that vanishes there. -/
theorem exists_residue (c : K) (x : L) (hx : (placeAt K L c).val x ≤ 1) :
    ∃ e : K, (placeAt K L c).val (x - algebraMap K L e) < 1 := by
  change (primeAt K L c).valuation L x ≤ 1 at hx
  obtain ⟨n, d, hnd⟩ := (primeAt K L c).exists_primeCompl_mul_eq_of_integer x hx
  have hd : pointAt K L c d ≠ 0 := fun h => d.2 h
  have hd1 : (primeAt K L c).valuation L (algebraMap (RCN349.ET K L) L d) = 1 :=
    (primeAt K L c).valuation_eq_one_iff_notMem.mpr d.2
  have hmem : n - algebraMap K (RCN349.ET K L) (pointAt K L c n / pointAt K L c d) * d ∈
      (primeAt K L c).asIdeal := by
    change pointAt K L c _ = 0
    rw [map_sub, map_mul, AlgHom.commutes, Algebra.algebraMap_self_apply, div_mul_cancel₀ _ hd,
      sub_self]
  refine ⟨pointAt K L c n / pointAt K L c d, ?_⟩
  change (primeAt K L c).valuation L _ < 1
  have hlt : (primeAt K L c).valuation L (algebraMap (RCN349.ET K L) L
      (n - algebraMap K (RCN349.ET K L) (pointAt K L c n / pointAt K L c d) * d)) < 1 :=
    ((primeAt K L c).valuation_lt_one_iff_mem (K := L) _).mpr hmem
  rwa [map_sub, map_mul, ← hnd, ← IsScalarTower.algebraMap_apply K (RCN349.ET K L) L, ← sub_mul,
    map_mul, hd1, mul_one] at hlt

/-- There are as many places with residue field `K` outside a finite set as one wants. -/
theorem exists_places (T : Finset (RCN026.Place K L)) (N : ℕ) :
    ∃ U : Finset (RCN026.Place K L), U.card = N ∧ Disjoint U T ∧
      ∀ v ∈ U, ∀ x : L, v.val x ≤ 1 → ∃ e : K, v.val (x - algebraMap K L e) < 1 := by
  obtain ⟨U, hsub, hcard⟩ := ((Set.infinite_range_of_injective (placeAt_injective K L)).sdiff
    T.finite_toSet).exists_subset_card_eq N
  refine ⟨U, hcard, Finset.disjoint_left.mpr fun v hv hvT => (hsub hv).2 hvT, fun v hv x hx => ?_⟩
  obtain ⟨c, rfl⟩ := (hsub hv).1
  exact exists_residue K L c x hx

variable {K L}

theorem poleOrder_le_iff (v : Valuation L (WithZero (Multiplicative ℤ))) (y : L) (n : ℕ) :
    RCN187.poleOrder v y ≤ (n : ℤ) ↔ v y ≤ WithZero.exp (n : ℤ) := by
  rw [RCN187.poleOrder]
  rcases eq_or_ne (v y) 0 with h0 | h0
  · simp [h0]
  · rw [max_le_iff, ← WithZero.log_le_iff_le_exp h0]
    exact and_iff_right (Int.natCast_nonneg n)

/-- A nonzero function with poles at most `D` has at most `deg D` zeros. -/
theorem card_le_of_zeros {x : L} (hx : x ≠ 0) (T : Finset (RCN026.Place K L))
    (D : RCN026.Place K L → ℕ) (hD : ∀ v ∉ T, D v = 0)
    (hpole : ∀ v : RCN026.Place K L, RCN187.poleOrder v.val x ≤ (D v : ℤ))
    (U : Finset (RCN026.Place K L)) (hU : ∀ v ∈ U, v.val x < 1) : U.card ≤ ∑ v ∈ T, D v := by
  have h1 := RCN026.AUN K L x hx U fun v hv => by
    have h0 : v.val x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
    have hlt := hU v hv
    rw [← WithZero.exp_log h0, WithZero.exp_lt_one_iff] at hlt
    rw [RCN026.order]
    omega
  have h2 : ∑ v ∈ RCN026.placesFor K L x hx, RCN346.poleOrder K L v x ≤
      ((∑ v ∈ T, D v : ℕ) : ℤ) :=
    (Finset.sum_le_sum fun v _ => hpole v).trans (by
      rw [← Nat.cast_sum]
      exact_mod_cast Finset.sum_le_sum_of_ne_zero fun v _ hv => by
        by_contra hT
        exact hv (hD v hT))
  exact_mod_cast h1.trans h2

/-- A combination of functions with poles at most `D`, whose residues at more than `deg D` places
combine to zero, is zero. -/
theorem sum_smul_eq_zero (T : Finset (RCN026.Place K L)) (D : RCN026.Place K L → ℕ)
    (hD : ∀ v ∉ T, D v = 0) (U : Finset (RCN026.Place K L)) (hcard : ∑ v ∈ T, D v < U.card)
    {ι : Type*} [Fintype ι] (y : ι → L)
    (hpole : ∀ i (v : RCN026.Place K L), RCN187.poleOrder v.val (y i) ≤ (D v : ℤ))
    (r : RCN026.Place K L → ι → K)
    (hr : ∀ v ∈ U, ∀ i, v.val (y i - algebraMap K L (r v i)) < 1)
    (l : ι → K) (hl : ∀ v ∈ U, ∑ i, l i * r v i = 0) : ∑ i, l i • y i = 0 := by
  by_contra hx
  have hconst : ∀ (v : RCN026.Place K L) (c : K), v.val (algebraMap K L c) ≤ 1 := fun v c =>
    haveI := v.property.2
    RCN345.FLO K L v.val c
  refine absurd (card_le_of_zeros hx T D hD (fun v => ?_) U fun v hv => ?_) (not_le.mpr hcard)
  · rw [poleOrder_le_iff]
    refine Valuation.map_sum_le _ fun i _ => ?_
    rw [Algebra.smul_def, map_mul]
    exact mul_le_of_le_one_of_le (hconst v (l i)) ((poleOrder_le_iff _ _ _).mp (hpole i v))
  · have hsum : ∑ i, l i • algebraMap K L (r v i) = 0 := by
      simp_rw [Algebra.smul_def, ← map_mul]
      rw [← map_sum, hl v hv, map_zero]
    have hsplit : ∑ i, l i • y i = ∑ i, l i • (y i - algebraMap K L (r v i)) := by
      simp_rw [smul_sub]
      rw [Finset.sum_sub_distrib, hsum, sub_zero]
    rw [hsplit]
    refine Valuation.map_sum_lt _ one_ne_zero fun i _ => ?_
    rw [Algebra.smul_def, map_mul]
    exact mul_lt_of_le_one_of_lt (hconst v (l i)) (hr v hv i)

end Field

section Curves

open RCN002 RCN005 RCN006 RCN072 RCN341

variable {E : Type} [Field E] [IsAlgClosed E]

theorem curve_exists_places (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (sep : BP C)
    (T : Finset (RCN026.Place E (AJ E C))) (N : ℕ) :
    ∃ U : Finset (RCN026.Place E (AJ E C)), U.card = N ∧ Disjoint U T ∧
      ∀ v ∈ U, ∀ x : AJ E C, v.val x ≤ 1 → ∃ e : E, v.val (x - algebraMap E (AJ E C) e) < 1 := by
  let _ := IP E C sep.index
  let _ := DT E C sep.index sep.transcendental
  let _ := IU E C sep.index
  let _ := _Q5 E C sep.index sep.transcendental
  let _ := IS E C sep.index sep.transcendental
  let _ : FiniteDimensional (RatFunc E) (AJ E C) := sep.finite
  let _ : Algebra.IsSeparable (RatFunc E) (AJ E C) := sep.separable
  exact exists_places E (AJ E C) T N

theorem curve_sum_smul_eq_zero (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (sep : BP C)
    (T : Finset (RCN026.Place E (AJ E C))) (D : RCN026.Place E (AJ E C) → ℕ)
    (hD : ∀ v ∉ T, D v = 0) (U : Finset (RCN026.Place E (AJ E C)))
    (hcard : ∑ v ∈ T, D v < U.card) {ι : Type} [Fintype ι] (y : ι → AJ E C)
    (hpole : ∀ i (v : RCN026.Place E (AJ E C)), RCN187.poleOrder v.val (y i) ≤ (D v : ℤ))
    (r : RCN026.Place E (AJ E C) → ι → E)
    (hr : ∀ v ∈ U, ∀ i, v.val (y i - algebraMap E (AJ E C) (r v i)) < 1)
    (l : ι → E) (hl : ∀ v ∈ U, ∑ i, l i * r v i = 0) : ∑ i, l i • y i = 0 := by
  let _ := IP E C sep.index
  let _ := DT E C sep.index sep.transcendental
  let _ := IU E C sep.index
  let _ := _Q5 E C sep.index sep.transcendental
  let _ := IS E C sep.index sep.transcendental
  let _ : FiniteDimensional (RatFunc E) (AJ E C) := sep.finite
  let _ : Algebra.IsSeparable (RatFunc E) (AJ E C) := sep.separable
  exact sum_smul_eq_zero T D hD U hcard y hpole r hr l hl

/-- On finitely many curves with a separable coordinate, a linearly independent family of tuples of
functions with poles at most `D` has at most `∑ (deg D + 1)` members. -/
theorem card_le_sum_degree (A : Type) [Fintype A] (C : A → Ideal (MvPolynomial (Fin 3) E))
    [∀ a, (C a).IsPrime] (sep : ∀ a, BP (C a)) (T : ∀ a, Finset (RCN026.Place E (AJ E (C a))))
    (D : ∀ a, RCN026.Place E (AJ E (C a)) → ℕ) (hD : ∀ a, ∀ v ∉ T a, D a v = 0)
    (ι : Type) [Fintype ι] (f : ι → ∀ a, AJ E (C a)) (hf : LinearIndependent E f)
    (hpole : ∀ i a (v : RCN026.Place E (AJ E (C a))),
      RCN187.poleOrder v.val (f i a) ≤ (D a v : ℤ)) :
    Fintype.card ι ≤ ∑ a, ((∑ v ∈ T a, D a v) + 1) := by
  choose U hUcard hUdisj hUres using fun a =>
    curve_exists_places (C a) (sep a) (T a) ((∑ v ∈ T a, D a v) + 1)
  have hres : ∀ a (v : RCN026.Place E (AJ E (C a))) (i : ι), ∃ e : E,
      v ∈ U a → v.val (f i a - algebraMap E (AJ E (C a)) e) < 1 := fun a v i => by
    by_cases hv : v ∈ U a
    · have hle : v.val (f i a) ≤ 1 := by
        have h := hpole i a v
        rw [hD a v (Finset.disjoint_left.mp (hUdisj a) hv), poleOrder_le_iff] at h
        simpa using h
      obtain ⟨e, he⟩ := hUres a v hv (f i a) hle
      exact ⟨e, fun _ => he⟩
    · exact ⟨0, fun h => absurd h hv⟩
  choose r hr using hres
  let M : Matrix (Σ a, U a) ι E := fun j i => r j.1 j.2.1 i
  have hinj : Function.Injective (Matrix.mulVecLin M) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro l hl
    refine funext (Fintype.linearIndependent_iff.mp hf l (funext fun a => ?_))
    rw [Finset.sum_apply]
    refine curve_sum_smul_eq_zero (C a) (sep a) (T a) (D a) (hD a) (U a)
      (by rw [hUcard a]; exact Nat.lt_succ_self _) (fun i => f i a) (fun i v => hpole i a v) (r a)
      (fun v hv i => hr a v i hv) l fun v hv => ?_
    have h : ∑ i, r a v i * l i = 0 := congrFun hl ⟨a, ⟨v, hv⟩⟩
    rw [← h]
    exact Finset.sum_congr rfl fun i _ => mul_comm _ _
  have h := LinearMap.finrank_le_finrank_of_injective hinj
  rw [Module.finrank_fintype_fun_eq_card, Module.finrank_fintype_fun_eq_card,
    Fintype.card_sigma] at h
  simpa [hUcard] using h

end Curves

end

end ProximityPrize.SubmissionLower.FormalR.H2Pole
