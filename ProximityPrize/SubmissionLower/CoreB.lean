/-!
Statements of the height bound on level curves (definitions only).

On a curve, an auxiliary polynomial `Ga` of the flag `⟨0, β, γ⟩` that equals `(Z - c0)^n H` on the curve
and is not zero there bounds the poles of `Z`: `n` times the pole sum of `Z` is at most `β` times the
pole sum of the flag `(0, 1, 0)` plus `γ` times the pole sum of the flag `(0, 0, 1)`. `CurveStatement`
states this for one curve, `LevelH2` and `LevelStatement` for the level curves of a pencil;
`SectionBoundStatement` and `PointBudgetStatement` state the bounds on sections and on points that
follow from it.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Lev

open WithZero MvPolynomial
open RCN002 RCN095

noncomputable section

section Curve

/-- The height bound on one curve `D` with a separable coordinate: `Ga` has the flag `⟨0, β, γ⟩`, is
`(Z - c0)^n H` modulo `D` and is not zero on `D`, and every zero of `Z - c0` on `D` is at a place where
no coordinate has a pole. The set of places on the right may be larger than the one on the left. -/
def CurveStatement (E : Type) [Field E] [IsAlgClosed E] : Prop :=
  ∀ (D : Ideal (MvPolynomial (Fin 3) E)) [D.IsPrime] (_sep : RCN341.BP D) (c0 : E) (n β γ : ℕ)
    (Ga H : MvPolynomial (Fin 3) E), BI ⟨0, β, γ⟩ Ga → Ga ∉ D →
    Ga - (MvPolynomial.X 2 - MvPolynomial.C c0) ^ n * H ∈ D →
    (∀ v : RCN026.Place E (AJ E D), v.val (BR E D (MvPolynomial.X 2 - MvPolynomial.C c0)) < 1 →
      ∀ j, v.val (coordinate E D j) ≤ 1) →
    ∀ T : Finset (RCN026.Place E (AJ E D)), ∃ T' : Finset (RCN026.Place E (AJ E D)),
      (n : ℤ) * ∑ v ∈ T, RCN204.flagPole v.val (coordinate E D) unitZFlag ≤
        (β : ℤ) * ∑ v ∈ T', RCN204.flagPole v.val (coordinate E D) unitYZFlag +
          (γ : ℤ) * ∑ v ∈ T', RCN204.flagPole v.val (coordinate E D) unitAllFlag

end Curve

section Packet

open scoped Classical
open RCN074 RCN135 RCN136 RCN159 RCN222 RCN264 RCN313 RCN334
open DU BD AFA BOE HFree6812 _Q7

variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] LevelComponent.isPrime Exch.component_isPrime

/-- The height bound for the three complete degrees of the level curve `Exch.moving P Q A g = c`, summed
over the geometric components `g`. -/
def LevelH2 (P : Packet x t y r) (n β γ : ℕ) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω) : Prop :=
  ∀ (s : ∀ g, Finset (LevelComponent (Exch.component P g) (Exch.moving P Q A g) c))
    (T : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c),
      Finset (RCN026.Place Ω (AJ Ω B.prime))),
    ∃ T' : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c),
        Finset (RCN026.Place Ω (AJ Ω B.prime)),
      (n : ℤ) * (∑ g, levelFlagSum (s g) (T g) unitZFlag) ≤
        (β : ℤ) * (∑ g, levelFlagSum (s g) (T' g) unitYZFlag) +
          (γ : ℤ) * (∑ g, levelFlagSum (s g) (T' g) unitAllFlag)

/-- For the auxiliary polynomial of `H2Sec.ExistsAux` and every pencil `Q`, `A` of the two flags, the
height bound `LevelH2` holds at every level outside a finite set. -/
def LevelStatement (P : Packet x t y r) : Prop :=
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0)
    (n β γ : ℕ) (_haux : H2Sec.ExistsAux P n β γ)
    (Q A : MvPolynomial (Fin 3) Ω) (_hQ : BI (2 • unitAllFlag) Q) (_hA : BI unitYZFlag A),
    ∃ bad : Set Ω, bad.Finite ∧ ∀ c ∉ bad, LevelH2 P n β γ Q A c

/-- The height bound turns the section bound at `(scale, z, u, v)` into the section bound at
`(n scale, min (n z) (β u + γ v), n u, n v)`. -/
def SectionBoundStatement (P : Packet x t y r) : Prop :=
  ∀ (n β γ : ℕ) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω), LevelH2 P n β γ Q A c →
    ∀ scale z u v : ℕ, SectionBound P scale z u v Q A c →
      SectionBound P (n * scale) (min (n * z) (β * u + γ * v)) (n * u) (n * v) Q A c

/-- The point budget `_Q7.AGN` at `(n scale, min (n z) (β u + γ v), n u, n v)` for every pencil of the
two flags, from the budget at `(scale, z, u, v)` for all of them, over an algebraically closed field `E`
over the generic field. `AGN` counts points with coordinates in `GenericField E` on the level curve at
the transcendental level `MF E`. -/
def PointBudgetStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0)
    (n β γ : ℕ) (_haux : H2Sec.ExistsAux P n β γ)
    (E : Type) [Field E] [IsAlgClosed E] [CharP E 2130706433] (f : GenericField K →+* E)
    (scale z u v : ℕ)
    (_hold : ∀ Q A : MvPolynomial (Fin 3) E, (2 : MvPolynomial (Fin 3) E) * A ≠ 0 →
      BI (2 • unitAllFlag) Q → BI unitYZFlag A → AGN f P.F SZ Q A scale z u v)
    (Q A : MvPolynomial (Fin 3) E), (2 : MvPolynomial (Fin 3) E) * A ≠ 0 →
      BI (2 • unitAllFlag) Q → BI unitYZFlag A →
      AGN f P.F SZ Q A (n * scale) (min (n * z) (β * u + γ * v)) (n * u) (n * v)

end Packet

end

end ProximityPrize.SubmissionLower.FormalR.H2Lev
end
section

/-!
The degree of the flag `⟨0, β, γ⟩` on a section `Z = c0` of the carrier of a packet, the statement
`H2Sec.SectionDegreeStatement`: the section has at most `deg_R F` components off `∂F/∂R = 0`, and the poles
of the flag at any finite sets of places of these components add up to at most `β deg_R F + γ deg_(Y,R) F`.

* The flag sum: `AVZ.EFX` gives unit budgets for the components of the section on every factor of the
  carrier, and `AVZ.sum_cost_le` adds their costs up to the mixed number
  `flagMixed p ⟨1, 0, 0⟩ ⟨0, β, γ⟩ = β * p.all + γ * (p.yz + p.all)` for the exact flag `p` of the carrier.
  The hypotheses of `AVZ.EFX` that compare degrees with the characteristic are on the carrier and on
  `Z - c0`; the flag `⟨0, β, γ⟩` enters none of them, so `β` and `γ` may exceed the characteristic.
* The number of components: the Bezout sum `RCN004.BQE` in the order `(Y, Z, R)`: on a geometric component
  `g` the degrees over the rational functions in `Y` of the components of its section add up to at most
  `deg_R g`. It needs `Y` not constant on a component (`transcendental_coordinate_zero`): a component with
  `Y` constant lies in `∂F/∂R = 0`, and the components `RCN264.AU` of the section are those off
  `baseH = ∂F/∂R`.

Of `H2Sec.GoodValue` the proof uses only that no geometric component divides `Z - c0`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Deg

open scoped Classical BigOperators
open WithZero MvPolynomial
open RCN002 RCN013 RCN072 RCN084 RCN095 RCN114 RCN135 RCN136 RCN137 RCN222 RCN237 RCN264 RCN313 RCN340 RCN341
open BD DU _Q7 AFA OT AVZ H2Sec

noncomputable section

section Field

variable {E : Type} [Field E]

theorem levelForm_support (c : E) (d : Fin 3 →₀ ℕ) (hd : d ∈ (levelForm c).support) :
    d = Finsupp.single 2 1 ∨ d = 0 := by
  by_contra h
  rw [not_or] at h
  refine MvPolynomial.mem_support_iff.1 hd ?_
  simp [levelForm, MvPolynomial.coeff_X, MvPolynomial.coeff_C, Ne.symm h.1, Ne.symm h.2]

theorem levelForm_flag (c : E) : BI ⟨1, 0, 0⟩ (levelForm c) := by
  intro d hd
  rcases levelForm_support c d hd with rfl | rfl <;> simp [InFlag]

theorem levelForm_degreeOf_one (c : E) : (levelForm c).degreeOf 1 = 0 := by
  refine Nat.le_zero.1 ((MvPolynomial.degreeOf_le_iff).2 fun d hd => ?_)
  rcases levelForm_support c d hd with rfl | rfl <;> simp

theorem levelForm_degreeOf_two (c : E) : (levelForm c).degreeOf 2 ≤ 1 := by
  refine (MvPolynomial.degreeOf_le_iff).2 fun d hd => ?_
  rcases levelForm_support c d hd with rfl | rfl <;> simp

/-- The restriction to the line `Y = y`, `Z = c`, as a polynomial in `R`. -/
private def lineEval (y c : E) : MvPolynomial (Fin 3) E →ₐ[E] Polynomial E :=
  MvPolynomial.aeval ![Polynomial.C y, Polynomial.X, Polynomial.C c]

private theorem derivative_lineEval (y c : E) (A : MvPolynomial (Fin 3) E) :
    Polynomial.derivative (lineEval y c A) = lineEval y c (MvPolynomial.pderiv 1 A) := by
  induction A using MvPolynomial.induction_on with
  | C a => simp [lineEval]
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp =>
    rw [map_mul, Polynomial.derivative_mul, hp, MvPolynomial.pderiv_mul, map_add, map_mul, map_mul,
      MvPolynomial.pderiv_X]
    fin_cases i <;> simp [lineEval]

private theorem BR_eq_zero_iff (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime]
    (A : MvPolynomial (Fin 3) E) : BR E C A = 0 ↔ A ∈ C := by
  conv_rhs => rw [← FB E C]
  rfl

/-- On a curve `C` inside the plane `Z = c` of the surface `g = 0`, off the zero set of `∂g/∂R`, the
coordinate `Y` is not constant: a curve with `Y` and `Z` constant is a line in the direction of `R`, on
which `g` vanishes identically and so does `∂g/∂R`. -/
theorem transcendental_coordinate_zero [IsAlgClosed E] (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime]
    (D : BP C) (g : MvPolynomial (Fin 3) E) (c : E) (hg : g ∈ C) (hc : levelForm c ∈ C)
    (hd : MvPolynomial.pderiv 1 g ∉ C) : Transcendental E (coordinate E C 0) := by
  intro hY
  have hZ : coordinate E C 2 = algebraMap E (AJ E C) c := by
    have h := (BR_eq_zero_iff C _).2 hc
    rw [levelForm, map_sub, MvPolynomial.algHom_C] at h
    exact sub_eq_zero.1 h
  obtain ⟨y, hy⟩ : ∃ y : E, algebraMap E (AJ E C) y = coordinate E C 0 :=
    minpoly.mem_range_of_degree_eq_one E _
      (IsAlgClosed.degree_eq_one_of_irreducible E (minpoly.irreducible hY.isIntegral))
  have hfac : ∀ A, BR E C A = Polynomial.aeval (coordinate E C 1) (lineEval y c A) := by
    have hy' : BR E C (MvPolynomial.X 0) = algebraMap E (AJ E C) y := hy.symm
    have hZ' : BR E C (MvPolynomial.X 2) = algebraMap E (AJ E C) c := hZ
    have h : (Polynomial.aeval (coordinate E C 1)).comp (lineEval y c) = BR E C := by
      refine MvPolynomial.algHom_ext fun i => ?_
      fin_cases i
      · simp [lineEval, hy']
      · simp [lineEval, coordinate]
      · simp [lineEval, hZ']
    intro A
    rw [← h]
    rfl
  have htr : Transcendental E (coordinate E C 1) := by
    have h := D.transcendental
    rcases (by omega : D.index = 0 ∨ D.index = 1 ∨ D.index = 2) with h0 | h1 | h2
    · rw [h0] at h
      exact absurd hY h
    · rwa [h1] at h
    · rw [h2, hZ] at h
      exact absurd (isAlgebraic_algebraMap c) h
  have h0 : lineEval y c g = 0 := by
    by_contra hne
    exact htr ⟨_, hne, by rw [← hfac, (BR_eq_zero_iff C g).2 hg]⟩
  exact hd ((BR_eq_zero_iff C _).1
    (by rw [hfac, ← derivative_lineEval, h0, Polynomial.derivative_zero, map_zero]))

/-- The poles of a flag at finitely many places of a component of a section are at most the weighted unit
costs of a budget `RCN340.QZ` (as `RCN199.RD.CUE` for the budgets `RCN199.RD`). -/
theorem flagPole_le_cost [IsAlgClosed E] {G T H : MvPolynomial (Fin 3) E}
    {base : ∀ C : AU E G T H, BP C.1} {p q : FlagDegree} (U : QZ base p q) (r : FlagDegree)
    (C : AU E G T H) (W : Finset (RCN026.Place E (AJ E C.1))) :
    ∑ v ∈ W, RCN204.flagPole v.val (coordinate E C.1) r ≤ (U.toFE.weightedCost r C : ℤ) := by
  have hz : (∑ v ∈ W, RCN295.CE v.val (coordinate E C.1) (flagSupport unitZFlag)) ≤ (U.zCost C : ℤ) :=
    U.zPole C W
  have hy : (∑ v ∈ W, RCN295.CE v.val (coordinate E C.1) (flagSupport unitYZFlag)) ≤ (U.yzCost C : ℤ) :=
    U.yzPole C W
  have ha : (∑ v ∈ W, RCN295.CE v.val (coordinate E C.1) (flagSupport unitAllFlag)) ≤ (U.allCost C : ℤ) :=
    U.allPole C W
  simp only [UC] at hz
  simp only [QD] at hy
  simp only [SF] at ha
  have h := add_le_add (add_le_add
    (mul_le_mul_of_nonneg_left hz (Int.natCast_nonneg r.zOnly))
    (mul_le_mul_of_nonneg_left hy (Int.natCast_nonneg r.yz)))
    (mul_le_mul_of_nonneg_left ha (Int.natCast_nonneg r.all))
  simpa only [RCN204.flagPole, Finset.sum_add_distrib, ← Finset.mul_sum, FE.weightedCost, QZ.toFE,
    Nat.cast_add, Nat.cast_mul] using h

end Field

section Packet

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

private theorem stage_pderiv_ne_zero (P : Packet x t y r) (g : EX K P.F) :
    MvPolynomial.pderiv 1 (P.stage g).G ≠ 0 := by
  intro h
  obtain ⟨Q, hQ⟩ := (P.stage g).RR
  apply (P.stage g).BLO
  rw [← RCN267.ZO, hQ, MvPolynomial.pderiv_mul, h, zero_mul, zero_add]
  exact dvd_mul_right _ _

private theorem stage_pderiv_notMem (P : Packet x t y r) (g : EX K P.F) (s : MvPolynomial (Fin 3) Ω)
    (C : AU Ω (P.stage g).G s (baseH P.F)) : MvPolynomial.pderiv 1 (P.stage g).G ∉ C.1 := by
  intro hd
  obtain ⟨Q, hQ⟩ := (P.stage g).RR
  apply _Q6 Ω _ _ _ C
  show surfaceMap (AL K) (MvPolynomial.pderiv 2 P.F) ∈ C.1
  rw [← RCN267.ZO, show surfaceMap (AL K) P.F = (P.stage g).G * Q from hQ, MvPolynomial.pderiv_mul]
  exact C.1.add_mem (C.1.mul_mem_right Q hd) (C.1.mul_mem_right _ (EN Ω _ _ _ C))

/-- The section `Z = c0` of the carrier has at most `rhi` components off `∂F/∂R = 0`, and the poles of the
flag `⟨0, β, γ⟩` at any finite sets of places of these components add up to at most `β * rhi + γ * yhi`,
for a bound `rhi` of the `R`-degree and a bound `yhi` of the `(Y, R)`-degree of the carrier. -/
theorem section_degree (P : Packet x t y r) : H2Sec.SectionDegreeStatement P := by
  intro c0 h0 rhi yhi hr hy
  have hF : baseCarrier P.F ≠ 0 := ZL (AL K) (DI K) P.F P.irreducible.ne_zero
  have ht := packet_t_le P
  have htot : (exactFlag (baseCarrier P.F)).zOnly + (exactFlag (baseCarrier P.F)).yz +
      (exactFlag (baseCarrier P.F)).all ≤ t := by
    have h1 : MvPolynomial.weightedTotalDegree AAR (baseCarrier P.F) ≤ t - y + (y - r) + r :=
      (_Q21 _ _ (P.parent_flag Ω (AL K))).2.2
    have h2 := P.ylow
    have h3 := P.yt
    rw [(AHN _).2.2]
    omega
  have hdeg : ∀ (g : EX K P.F) (j : Fin 3), g.1.degreeOf j < 2130706433 := fun g j =>
    lt_of_le_of_lt ((YI j g.1 _ (ACQ (AL K) P.F g.1 g.2).2 hF).trans
      ((AHE _ _ (ATU (baseCarrier P.F)) j).trans htot)) (by omega)
  obtain ⟨B⟩ := EFX (baseCarrier P.F) (levelΩ c0) (baseH P.F) (exactFlag (baseCarrier P.F)) ⟨1, 0, 0⟩ hF
    (ATU _) (levelForm_flag _) 2130706433 (by omega)
    (by show 2 * (_ + _ + _) * (1 + 0 + 0) < 2130706433; omega)
  have hmem : ∀ g : EX K P.F, g.1 ∈ HR (baseCarrier P.F) (levelΩ c0) := fun g =>
    Finset.mem_filter.2 ⟨g.2, (h0.good g).1, stage_pderiv_ne_zero P g⟩
  have hinj : Function.Injective fun g : EX K P.F =>
      (⟨g.1, hmem g⟩ : ↥(HR (baseCarrier P.F) (levelΩ c0))) := fun g g' h =>
    Subtype.ext (Subtype.mk.inj h)
  have hall : (exactFlag (baseCarrier P.F)).all ≤ rhi := by
    rw [(AHN _).1]
    refine Finset.sup_le fun d hd => ?_
    rw [AKW]
    simpa [flagSWeights] using (MvPolynomial.monomial_le_degreeOf 1 hd).trans hr
  have hyz : (exactFlag (baseCarrier P.F)).yz + (exactFlag (baseCarrier P.F)).all ≤ yhi := by
    rw [(AHN _).2.1]
    refine Finset.sup_le fun d hd => ?_
    rw [AKW]
    simpa [AJD] using hy d hd
  constructor
  · have hcard : ∀ g : EX K P.F,
        Fintype.card (AU Ω (P.stage g).G (levelΩ c0) (baseH P.F)) ≤ g.1.degreeOf 1 := by
      intro g
      have ht0 : ∀ C : AU Ω (P.stage g).G (levelΩ c0) (baseH P.F),
          Transcendental Ω (coordinate Ω C.1 ((Equiv.swap (1 : Fin 3) 2) 0)) := fun C => by
        rw [Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)]
        exact transcendental_coordinate_zero C.1 (B.base ⟨g.1, hmem g⟩ C) _ _ (EN Ω _ _ _ C)
          (GV Ω _ _ _ C) (stage_pderiv_notMem P g _ C)
      have hMD : MD Ω (Equiv.swap (1 : Fin 3) 2) g.1 (levelΩ c0) ≤ g.1.degreeOf 1 := by
        unfold MD
        rw [Equiv.swap_apply_left, Equiv.swap_apply_right, levelForm_degreeOf_one, mul_zero, add_zero]
        exact (Nat.mul_le_mul_right _ (levelForm_degreeOf_two _)).trans (one_mul _).le
      obtain ⟨hfin, hsum⟩ := RCN004.BQE Ω (Equiv.swap (1 : Fin 3) 2)
        (fun C : AU Ω (P.stage g).G (levelΩ c0) (baseH P.F) => C.1) ht0 (fun _ _ h => Subtype.ext h)
        2130706433 g.1 (levelΩ c0) (ACQ (AL K) P.F g.1 g.2).1 (fun C => EN Ω _ _ _ C)
        (fun C => GV Ω _ _ _ C) (h0.good g).1 (hdeg g _) (hdeg g _)
        (lt_of_le_of_lt hMD (hdeg g 1))
      refine le_trans ?_ (hsum.trans hMD)
      rw [Fintype.card_eq_sum_ones]
      refine Finset.sum_le_sum fun C _ => ?_
      let _ : Algebra (RatFunc Ω) (AJ Ω C.1) := RCN005.DT Ω C.1 _ (ht0 C)
      have : FiniteDimensional (RatFunc Ω) (AJ Ω C.1) := (hfin C).1
      exact Module.finrank_pos
    calc Fintype.card (SectionComponent P c0)
        = ∑ g : EX K P.F, Fintype.card (AU Ω (P.stage g).G (levelΩ c0) (baseH P.F)) :=
          Fintype.card_sigma
      _ ≤ ∑ g : EX K P.F, g.1.degreeOf 1 := Finset.sum_le_sum fun g _ => hcard g
      _ = ∑ g ∈ IW (baseCarrier P.F), g.degreeOf 1 :=
          Finset.sum_coe_sort (IW (baseCarrier P.F)) fun g => g.degreeOf 1
      _ ≤ (baseCarrier P.F).degreeOf 1 := AJJ (IW (baseCarrier P.F)) id _ hF (XS _ hF) 1
      _ ≤ rhi := hr
  · intro β γ T
    have hsum : (∑ a : SectionComponent P c0,
        (B.unit ⟨a.1.1, hmem a.1⟩).toFE.weightedCost ⟨0, β, γ⟩ a.2) ≤ β * rhi + γ * yhi := by
      rw [Fintype.sum_sigma]
      calc _ = ∑ g' ∈ Finset.univ.image fun g : EX K P.F =>
              (⟨g.1, hmem g⟩ : ↥(HR (baseCarrier P.F) (levelΩ c0))),
            ∑ C : AU Ω g'.1 (levelΩ c0) (baseH P.F), (B.unit g').toFE.weightedCost ⟨0, β, γ⟩ C :=
            (Finset.sum_image fun _ _ _ _ h => hinj h).symm
        _ ≤ ∑ g' : ↥(HR (baseCarrier P.F) (levelΩ c0)),
            ∑ C : AU Ω g'.1 (levelΩ c0) (baseH P.F), (B.unit g').toFE.weightedCost ⟨0, β, γ⟩ C :=
            Finset.sum_le_sum_of_subset (Finset.subset_univ _)
        _ ≤ flagMixed (exactFlag (baseCarrier P.F)) ⟨1, 0, 0⟩ ⟨0, β, γ⟩ :=
            sum_cost_le _ _ _ _ _ _ hF (ATU _) B
        _ = β * (exactFlag (baseCarrier P.F)).all +
              γ * ((exactFlag (baseCarrier P.F)).yz + (exactFlag (baseCarrier P.F)).all) := by
            simp only [flagMixed]
            ring
        _ ≤ β * rhi + γ * yhi :=
            Nat.add_le_add (Nat.mul_le_mul_left _ hall) (Nat.mul_le_mul_left _ hyz)
    calc ∑ a, ∑ v ∈ T a, RCN204.flagPole v.val (coordinate Ω a.2.1) ⟨0, β, γ⟩
        ≤ ∑ a : SectionComponent P c0,
            (((B.unit ⟨a.1.1, hmem a.1⟩).toFE.weightedCost ⟨0, β, γ⟩ a.2 : ℕ) : ℤ) :=
          Finset.sum_le_sum fun a _ => flagPole_le_cost (B.unit ⟨a.1.1, hmem a.1⟩) ⟨0, β, γ⟩ a.2 (T a)
      _ ≤ ((β * rhi + γ * yhi : ℕ) : ℤ) := by exact_mod_cast hsum

end Packet

end

end ProximityPrize.SubmissionLower.FormalR.H2Deg
end
