/-!
The native numbers of one source `S` in the place of the pair's four expressions: scale `S.d` and the three
mixed heights of the parent flag `⟨t - y, y - r, r⟩` against the flag of the source.

* `Native.point_budget`, `Native.point_budget_of_weights`: the native point count `BD.DMO`, with the
  one source in the three directions, is the point budget `_Q7.AGN` at the native numbers, for every
  extension map `f`. No second source, no coprimality.
* `Native.exists_frame_of_budget`: the first part of the proof of `BOE.ELK` for an arbitrary point
  budget: a common frame, a geometry and a budget with `PacketFrame` at the numbers of the point budget.
* `Native.first_cut_of_budget`: the first-cut law of a frame for every flag `W`, from a point budget over
  the algebraic closure of the rational functions (`CAS.CXM` and `BBT.FGQ`; `BBT.DXA`
  is this with the pair's budget `_Q7.BSF`).
* `Native.packet_point_budget`, `Native.exists_packet_frame`, `Native.first_cut`: the three at the native
  numbers of a packet.

Numbers of the packet: `4 ≤ r`, `r + 2 ≤ y`, `y ≤ t` and the upper bounds `packet_r_le`, `packet_y_le`,
`packet_t_le`, of which the steps use `r ≤ 31`, `y ≤ 142` (`AQW.reduced_gate`) and `t ≤ 9678` (`BBT.FGQ`;
it gives `2 * t < 2130706433` and the gate `2 * t * (t + 1) < 2130706433` of the native point count).
-/

namespace ProximityPrize.SubmissionLower.FormalR.Native

section Budget
noncomputable section
open scoped BigOperators
open RCN095 RCN135 RCN136 RCN207 RCN313
open BD LF WC _Q7
variable {K E : Type} [Field K] [CharP K 2130706433] [Field E] [CharP E 2130706433]
variable (f : GenericField K →+* E)
local notation "OmegaT" => GenericField E
local notation "phi" => RingHom.comp (HO E) (codeMap f)
local notation "lift" => MvPolynomial.map (HO E)

/-- `p` is a flag of the carrier, `q` a flag of the level equation of `Q`, `A`. -/
theorem point_budget
    (F : MvPolynomial (Fin 4) K) (hF : F ≠ 0) (S : Source F) (hk : S.k < 2130706433)
    (p q : FlagDegree) (hp : BI p (OO f F))
    (hunit : 2 * (p.zOnly + p.yz + p.all) < 2130706433)
    (hmix : 2 * (p.zOnly + p.yz + p.all) * (q.zOnly + q.yz + q.all) < 2130706433)
    (Q A : MvPolynomial (Fin 3) E)
    (hQ : BI (2 • unitAllFlag) Q) (hA : BI unitYZFlag A)
    (hq : BI q (XC f F Q A)) :
    AGN f F S Q A S.d (flagMixed p unitZFlag S.flag)
      (flagMixed p unitYZFlag S.flag) (flagMixed p unitAllFlag S.flag) := by
  intro W cut hcut points hG hM hregular hzero hisolated
  have hGne : OO f F ≠ 0 := fun hh => hF (BMZ f (by simpa only [OO, map_zero] using hh))
  have h2 : (2 : OmegaT) ≠ 0 := (CharP.cast_eq_zero_iff OmegaT 2130706433 2).not.mpr (by decide)
  have hfact : (S.k.factorial : OmegaT) ≠ 0 := TI.factorial_ne S.k hk
  have hHdiv : surfaceMap phi (polyH K F) ∣ AOT f F A := by
    apply dvd_mul_of_dvd_left
    rw [map_mul]
    exact dvd_mul_left _ _
  have hpoints : ∀ x ∈ points, MvPolynomial.eval x (OO f F) = 0 ∧
      MvPolynomial.eval x (JF (surfaceMap phi (polyH K F)) (surfaceMap phi (polyG K F))
        (lift Q) (lift A) (MF E)) = 0 ∧
      MvPolynomial.eval x (surfaceMap phi (polyH K F) * ∏ _j : Fin 3, S.leading phi) ≠ 0 ∧
      MvPolynomial.aeval x cut = 0 := by
    intro x hx
    refine ⟨hG x hx, hM x hx, ?_, hzero x hx⟩
    have hr := hregular x hx
    rw [map_mul] at hr
    obtain ⟨hden, hlead⟩ := mul_ne_zero_iff.mp hr
    have hH : MvPolynomial.eval x (surfaceMap phi (polyH K F)) ≠ 0 := by
      intro hz
      have hdvd := map_dvd (MvPolynomial.eval x) hHdiv
      rw [hz, zero_dvd_iff] at hdvd
      exact hden hdvd
    rw [map_mul, map_prod]
    exact mul_ne_zero hH (Finset.prod_ne_zero_iff.mpr (fun _ _ => hlead))
  have h := DMO phi F (fun _ => S) S.d (fun _ => dvd_rfl)
    (OO f F) p q W hGne dvd_rfl hp 2130706433 hunit hmix h2 (fun _ => hfact)
    (lift Q) (lift A) (MF E) (inFlag_map _ hQ) (inFlag_map _ hA) hq cut hcut points
    hpoints hisolated
  have hd : 0 < S.d := Nat.succ_pos _
  simpa [Fin.sum_univ_three, BD.weight, BD.direction, Nat.div_self hd] using h

/-- The flag of the level equation from the weights of `F` (`RCN201.DGW`, `RCN207.FCY`). -/
theorem point_budget_of_weights
    (F : MvPolynomial (Fin 4) K) (hF : F ≠ 0) (S : Source F) (hk : S.k < 2130706433)
    (p : FlagDegree) (hp : BI p (OO f F))
    (hunit : 2 * (p.zOnly + p.yz + p.all) < 2130706433)
    (ca cb cs : ℕ) (hR : F.degreeOf 2 ≤ cs + 2) (hYR : RCN234.wt ![0, 1, 1, 0] F ≤ cb + cs + 3)
    (hAll : RCN234.wt ![0, 1, 1, 1] F ≤ ca + cb + cs + 3)
    (hmix : 2 * (p.zOnly + p.yz + p.all) * (ca + (cb + 1) + (cs + 3)) < 2130706433)
    (Q A : MvPolynomial (Fin 3) E)
    (hQ : BI (2 • unitAllFlag) Q) (hA : BI unitYZFlag A) :
    AGN f F S Q A S.d (flagMixed p unitZFlag S.flag)
      (flagMixed p unitYZFlag S.flag) (flagMixed p unitAllFlag S.flag) := by
  obtain ⟨hHflag, hGflag⟩ := RCN201.DGW phi ca cb cs F hR hYR hAll
  exact point_budget f F hF S hk p ⟨ca, cb + 1, cs + 3⟩ hp hunit hmix Q A hQ hA
    (FCY ca cb cs _ _ _ _ _ hHflag hGflag (inFlag_map _ hQ) (inFlag_map _ hA))

end
end Budget

section Packet
noncomputable section
open scoped Classical BigOperators
open RCN057 (WeightBound)
open RCN002 RCN046 RCN074 RCN086 RCN095 RCN130 RCN135 RCN156 RCN199 RCN222 RCN234 RCN237 RCN238 RCN243
open RCN264 RCN313 RCN334 RCN340 RCN344
open FA PR BD HK HFreeDir6813 DU BLL AYR BIO BBT CAS _Q7 AFA RL TW CB BOE
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K
local notation "Ext" => AlgebraicClosure (RatFunc Ω)

theorem mixed_swap (p q r : FlagDegree) : flagMixed p q r = flagMixed p r q := by
  unfold flagMixed
  ring

theorem swap_weighted_sum {A : Type} [Fintype A]
    (scale : ℕ) (weight : Fin 3 → ℕ) (mu : A → ℕ) (degree : Fin 3 → A → ℕ) :
    (∑ j : Fin 3, weight j * (scale * ∑ a, mu a * degree j a)) =
      scale * (∑ a, mu a * (∑ j : Fin 3, weight j * degree j a)) := by
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.sum_congr rfl
  intro j _
  ring

theorem sum_scaled_prices (W : FlagDegree) (scale coeff z u v : ℕ) (fixed : Fin 3 → ℕ) :
    (∑ j : Fin 3, weight W j * (scale * fixed j + coeff * price (BD.direction j) z u v)) =
      scale * (∑ j : Fin 3, weight W j * fixed j) + coeff * price W z u v := by
  simp only [Nat.mul_add, Finset.sum_add_distrib, Nat.mul_left_comm, ← Finset.mul_sum]
  rw [GEV]

theorem exists_frame_of_budget
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F) (scale z u v : ℕ)
    (hraw : ∀ Q A : MvPolynomial (Fin 3) Ω, (2 : MvPolynomial (Fin 3) Ω) * A ≠ 0 →
      BI (2 • unitAllFlag) Q → BI unitYZFlag A → AGN (RingHom.id Ω) P.F SZ Q A scale z u v) :
    ∃ (lam mu : Ω) (geometry : ∀ g, ABN (P.stage g))
      (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F)),
      PacketFrame P hp SZ scale z u v lam mu geometry budget := by
  have hrlo := P.rlow
  have hrhi : r ≤ 31 := by have := packet_r_le P; omega
  have hylo := P.ylow
  have hyhi : y ≤ 142 := by have := packet_y_le P; omega
  have hyt := P.yt
  have hthi : t ≤ 9678 := by have := packet_t_le P; omega
  have hflags (g : EX K P.F) : (CO K g).yz + (CO K g).all < 2130706433 ∧
      (CO K g).all < 2130706433 ∧
      (CO K g).zOnly + (CO K g).yz + (CO K g).all < 2130706433 := by
    have hh := P.stage_flag g
    omega
  have hmixed (g : EX K P.F) := AQW.reduced_gate
    (CO K g) t y r (by omega) hrhi hyhi (by omega) hyt
    (P.stage_flag g).1 (P.stage_flag g).2.1
  obtain ⟨lam, mu, hlam, hmu, geometry, heq⟩ := DYG
    (KK K P.F P.selected P.seeds) x (CO K) P.stage (P.stage_proper hp) hflags hmixed
  let unit := fun g => suppliedUnit (P.stage g) (P.stage_proper hp g) (geometry g)
  obtain ⟨budget, hcost, hmoving⟩ := CTF P.F SZ
    (fun a : Curve P => a.1.val) (fun a => (P.stage a.1).RR)
    (cellA t y) (cellB y r) (cellS r) w (by decide)
    P.support.IZ.2.1 P.support.ys_weight P.support.total_weight
    (fun a : Curve P => suppliedBase (P.stage a.1) (geometry a.1))
    (fun a : Curve P => CO K a.1) (TX t y r)
    (fun a : Curve P => unit a.1) (fun a : Curve P => a.2) (P.FDF hp)
    (active P SZ) (fun a ha => (Finset.mem_filter.mp ha).2) scale z u v hraw
  refine ⟨lam, mu, geometry, budget, hlam, hmu, heq, fun j a => ?_, hcost, hmoving, hraw⟩
  fin_cases j
  · exact FKV (unit a.1) a.2
  · exact GDG (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1) lam (heq a.1).1 a.2
  · exact GAA (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1) lam mu (heq a.1).1 (heq a.1).2 a.2

theorem first_cut_of_budget
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F) (scale z u v : ℕ)
    (lam mu : Ω) (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F))
    (hframe : PacketFrame P hp SZ scale z u v lam mu geometry budget)
    (hbudget : ∀ Q U : MvPolynomial (Fin 3) Ext, (2 : MvPolynomial (Fin 3) Ext) * U ≠ 0 →
      BI (2 • unitAllFlag) Q → BI unitYZFlag U → AGN (algebraMap Ω Ext) P.F SZ Q U scale z u v)
    (W : FlagDegree) :
    3 * scale * (∑ a ∈ active P SZ, multiplicity P hp a * ordinary P hp geometry a W) ≤
      scale * (∑ j : Fin 3, weight W j *
          flagMixed ⟨t - y, y - r, r⟩ (ASY t y r j) (BD.direction j)) +
        4 * (w + 1) * price W z u v := by
  have hrlo := P.rlow
  have hylo := P.ylow
  have hyt := P.yt
  have hthi : t ≤ 9678 := by have := packet_t_le P; omega
  let unit := fun g => suppliedUnit (P.stage g) (P.stage_proper hp g) (geometry g)
  let live := active P SZ
  let projection : (j : Fin 3) → (a : Curve P) → Coordinate Ω (AJ Ω a.2.1) :=
    fun j a => ![(unit a.1).zProjection a.2, (unit a.1).yzProjection a.2, (unit a.1).NV a.2] j
  have hR : WeightBound BE P.F (r : ℤ) := Or.inr (by exact_mod_cast P.r_weight)
  have hYR : WeightBound BC P.F ((r + (y - r) : ℕ) : ℤ) :=
    Or.inr (by exact_mod_cast (show wt BC P.F ≤ r + (y - r) by have := P.y_weight; omega))
  have hAll : MvPolynomial.weightedTotalDegree AT P.F ≤ r + (y - r) + (t - y) := by
    have hh : MvPolynomial.weightedTotalDegree AT P.F ≤ t := P.total_weight
    omega
  have hnormal (j : Fin 3) :
      3 * scale * (∑ a : live, multiplicity P hp a.val *
          DQ Ω (AJ Ω a.val.2.1) (projection j a.val)) ≤
        scale * flagMixed ⟨t - y, y - r, r⟩ (ASY t y r j) (BD.direction j) +
          4 * (w + 1) * price (BD.direction j) z u v := by
    have hell : BI (BD.direction j) (DSG lam mu j) := by
      fin_cases j
      · exact FFR
      · exact FDG lam
      · exact FFE mu lam
    have hq : (BD.direction j).zOnly + (BD.direction j).yz + (BD.direction j).all = 1 := by
      fin_cases j <;> rfl
    have hh := CXM (E := Ext)
      (fun a : live => KK K P.F P.selected P.seeds a.val.1)
      (fun a : live => CO K a.val.1)
      (fun a : live => MU (P.stage a.val.1))
      P.F P.irreducible.ne_zero (fun _ => rfl) ⟨t - y, y - r, r⟩ (P.parent_flag _ _)
      (fun a => P.stage_proper hp a.val.1) (fun a : live => a.val.2)
      (fun a b hh => Subtype.ext (P.FDF hp hh))
      (DSG lam mu j) (BD.direction j) hell (fun a => projection j a.val)
      (fun a => hframe.value j a.val) (by dsimp; omega) (by rw [hq, mul_one]; dsimp; omega)
      SZ (fun a => (Finset.mem_filter.mp a.property).2) j r (y - r) (t - y) (by omega) (by omega)
      hR hYR (Or.inr (by exact_mod_cast hAll)) unitAllFlag
      (FGQ P.F (r + (y - r) + (t - y)) hAll (by omega) lam mu hframe.lam_mem hframe.mu_mem j)
      scale z u v hbudget
    simpa only [BOE.multiplicity, price, ASY, mixed_swap] using hh
  change 3 * scale * (∑ a ∈ live, multiplicity P hp a * ordinary P hp geometry a W) ≤
    scale * (∑ j : Fin 3, weight W j * flagMixed ⟨t - y, y - r, r⟩ (ASY t y r j) (BD.direction j)) +
      4 * (w + 1) * price W z u v
  have hordinary (a : Curve P) : ordinary P hp geometry a W =
      ∑ j : Fin 3, weight W j * DQ Ω (AJ Ω a.2.1) (projection j a) := by
    simp only [Fin.sum_univ_three, projection, weight, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, ordinary, BLJ, FE.weightedCost, unit, EE.toFE, QZ.toFE, EE.toQZ]
    rfl
  have hh := Finset.sum_le_sum (fun j (_ : j ∈ (Finset.univ : Finset (Fin 3))) =>
    Nat.mul_le_mul_left (weight W j) (hnormal j))
  rw [swap_weighted_sum, sum_scaled_prices] at hh
  rw [← Finset.sum_coe_sort live (fun a => multiplicity P hp a * ordinary P hp geometry a W)]
  simpa only [hordinary] using hh

/-- The native point budget of a packet, over every field `E` of the characteristic with a map `f` from
the generic field. The flag of the level equation has total `t + 1`, so that the gate of `BD.DMO` is
`2 * t * (t + 1) < 2130706433`. -/
theorem packet_point_budget {E : Type} [Field E] [CharP E 2130706433] (f : Ω →+* E)
    (P : Packet x t y r) (S : Source P.F) (hk : S.k < 2130706433)
    (Q A : MvPolynomial (Fin 3) E) (hQ : BI (2 • unitAllFlag) Q) (hA : BI unitYZFlag A) :
    AGN f P.F S Q A S.d (flagMixed ⟨t - y, y - r, r⟩ unitZFlag S.flag)
      (flagMixed ⟨t - y, y - r, r⟩ unitYZFlag S.flag)
      (flagMixed ⟨t - y, y - r, r⟩ unitAllFlag S.flag) := by
  have hrlo := P.rlow
  have hylo := P.ylow
  have hyt := P.yt
  have hthi : t ≤ 9678 := by have := packet_t_le P; omega
  have hgate : 2 * ((t - y) + (y - r) + r) * (cellA t y + (cellB y r + 1) + (cellS r + 3)) <
      2130706433 := by
    have h1 : (t - y) + (y - r) + r = t := by omega
    have h2 : cellA t y + (cellB y r + 1) + (cellS r + 3) = t + 1 := by
      dsimp only [cellA, cellB, cellS]
      omega
    rw [h1, h2]
    calc 2 * t * (t + 1) ≤ 2 * 9678 * 9679 := Nat.mul_le_mul (Nat.mul_le_mul_left 2 hthi) (by omega)
      _ < 2130706433 := by decide
  exact point_budget_of_weights f P.F P.irreducible.ne_zero S hk ⟨t - y, y - r, r⟩ (P.parent_flag _ _)
    (by dsimp; omega) (cellA t y) (cellB y r) (cellS r) P.support.IZ.2.1 P.support.ys_weight
    P.support.total_weight hgate Q A hQ hA

/-- A common frame, a geometry and a budget of a packet with a proper tail cut, with `PacketFrame` at the
native numbers of the source. -/
theorem exists_packet_frame
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (S : Source P.F)
    (hk : S.k < 2130706433) :
    ∃ (lam mu : Ω) (geometry : ∀ g, ABN (P.stage g))
      (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F)),
      PacketFrame P hp S S.d (flagMixed ⟨t - y, y - r, r⟩ unitZFlag S.flag)
        (flagMixed ⟨t - y, y - r, r⟩ unitYZFlag S.flag)
        (flagMixed ⟨t - y, y - r, r⟩ unitAllFlag S.flag) lam mu geometry budget :=
  exists_frame_of_budget P hp S _ _ _ _
    (fun Q A _ hQ hA => packet_point_budget (RingHom.id Ω) P S hk Q A hQ hA)

/-- The first-cut law of a frame at the native numbers, for every flag `W`. -/
theorem first_cut
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (S : Source P.F)
    (hk : S.k < 2130706433) (lam mu : Ω) (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F))
    (hframe : PacketFrame P hp S S.d (flagMixed ⟨t - y, y - r, r⟩ unitZFlag S.flag)
      (flagMixed ⟨t - y, y - r, r⟩ unitYZFlag S.flag)
      (flagMixed ⟨t - y, y - r, r⟩ unitAllFlag S.flag) lam mu geometry budget)
    (W : FlagDegree) :
    3 * S.d * (∑ a ∈ active P S, multiplicity P hp a * ordinary P hp geometry a W) ≤
      S.d * (∑ j : Fin 3, weight W j *
          flagMixed ⟨t - y, y - r, r⟩ (ASY t y r j) (BD.direction j)) +
        4 * (w + 1) * price W (flagMixed ⟨t - y, y - r, r⟩ unitZFlag S.flag)
          (flagMixed ⟨t - y, y - r, r⟩ unitYZFlag S.flag)
          (flagMixed ⟨t - y, y - r, r⟩ unitAllFlag S.flag) :=
  first_cut_of_budget P hp S _ _ _ _ lam mu geometry budget hframe
    (fun Q U _ hQ hU => packet_point_budget (algebraMap Ω Ext) P S hk Q U hQ hU) W

end
end Packet

end ProximityPrize.SubmissionLower.FormalR.Native
end
