/-!
The common development on one chart from the hypotheses of a packet: `F₀ ∣ F`, `∂F/∂R` not zero on the
carrier, nonzero coordinates, the weight of `F` at most `N`, and `N ≤ 9678`. The place law `ChartPlaceLaw` at
the prime divisors of the chart, `ChartKrull` for the chart ring, and `PsiSIntegral` (the integrality of
`psiS` divided by its vertex monomial).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open MvPolynomial WithZero HFree6812
open RCN313 RCN095 RCN204 BD

namespace Chart

variable {K : Type} [Field K] [CharP K 2130706433]

theorem common_place_law (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (hH : sliceProj F₀ (polyH K F) ≠ 0) (N : ℕ) (hN : weightedTotalDegree ![0, 1, 1, 1] F ≤ N)
    (hN9 : N ≤ 9678) (hc : ∀ j, sliceCoord F₀ j ≠ 0) (sR sY sZ : Bool) :
    ChartPlaceLaw F F₀ hdvd sR sY sZ := by
  have hF := ne_zero_of_polyH_ne_zero F F₀ hH
  have hNp : 4 * N ^ 2 < 2130706433 := by
    have h := Nat.mul_le_mul hN9 hN9
    rw [pow_two]
    omega
  exact chartDivisor_place_law F F₀ hdvd hH N hN hNp hc sR sY sZ
    (chart_core_poly_of_dvd F F₀ hdvd hF N hN hc sR sY sZ)
    (chart_two_coord_of_dvd F F₀ hdvd hF N hN hc sR sY sZ)

theorem common_krull (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (hH : sliceProj F₀ (polyH K F) ≠ 0) (N : ℕ) (hN : weightedTotalDegree ![0, 1, 1, 1] F ≤ N)
    (hN9 : N ≤ 9678) (hc : ∀ j, sliceCoord F₀ j ≠ 0) (sR sY sZ : Bool) : ChartKrull F₀ sR sY sZ :=
  chart_krull_of_dvd F F₀ hdvd hH N hN hN9 hc sR sY sZ

theorem common_psiS_integral (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)] (hdvd : F₀ ∣ F)
    (hH : sliceProj F₀ (polyH K F) ≠ 0) (N : ℕ) (hN : weightedTotalDegree ![0, 1, 1, 1] F ≤ N)
    (hN9 : N ≤ 9678) (hc : ∀ j, sliceCoord F₀ j ≠ 0) (S : Source F)
    (hfact : (S.k.factorial : K) ≠ 0) (hlead : srcLead F F₀ S ≠ 0) (Hf : FlagDegree)
    (h5 : 5 ≤ 2 * Hf.all)
    (hHf : ∀ w : Valuation (SliceField F₀) ℤᵐ⁰,
      (∀ a : K, a ≠ 0 → w (algebraMap K (SliceField F₀) a) = 1) →
      w (sliceProj F₀ (MvPolynomial.X 0)) ≤ 1 →
      w (sliceProj F₀ (polyH K F)) ≤ exp (flagPole w (sliceCoord F₀) Hf))
    (sR sY sZ : Bool) : PsiSIntegral F F₀ hdvd S Hf sR sY sZ :=
  psiS_integral F F₀ hdvd hH (Ring.two_ne_zero (by rw [ringChar.eq K 2130706433]; norm_num)) S hfact
    hlead hc Hf h5 hHf sR sY sZ (common_krull F F₀ hdvd hH N hN hN9 hc sR sY sZ)
    (common_place_law F F₀ hdvd hH N hN hN9 hc sR sY sZ)

/-- `PsiSIntegral` for the flag `⟨z, y, r - 1⟩` of `H`, for `F` with exponents in the flag `⟨z, y, r⟩`. -/
theorem common_psiS_integral_flag (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (hdvd : F₀ ∣ F) (hH : sliceProj F₀ (polyH K F) ≠ 0) (N : ℕ)
    (hN : weightedTotalDegree ![0, 1, 1, 1] F ≤ N) (hN9 : N ≤ 9678)
    (hc : ∀ j, sliceCoord F₀ j ≠ 0) (S : Source F) (hfact : (S.k.factorial : K) ≠ 0)
    (hlead : srcLead F F₀ S ≠ 0) (z y r : ℕ) (hr : 4 ≤ r)
    (hF : ∀ e ∈ F.support, e 2 ≤ r ∧ e 1 + e 2 ≤ r + y ∧ e 1 + e 2 + e 3 ≤ r + y + z)
    (sR sY sZ : Bool) : PsiSIntegral F F₀ hdvd S ⟨z, y, r - 1⟩ sR sY sZ :=
  psiS_integral_flag F F₀ hdvd hH (Ring.two_ne_zero (by rw [ringChar.eq K 2130706433]; norm_num)) S
    hfact hlead hc z y r hr hF sR sY sZ (common_krull F F₀ hdvd hH N hN hN9 hc sR sY sZ)
    (common_place_law F F₀ hdvd hH N hN hN9 hc sR sY sZ)

/-- `PsiSIntegral` for the Euler flag `⟨z, y + 1, r - 2⟩` of `H`. -/
theorem common_psiS_integral_euler (F F₀ : MvPolynomial (Fin 4) K) [Fact (Irreducible F₀)]
    (hdvd : F₀ ∣ F) (hH : sliceProj F₀ (polyH K F) ≠ 0) (N : ℕ)
    (hN : weightedTotalDegree ![0, 1, 1, 1] F ≤ N) (hN9 : N ≤ 9678)
    (hc : ∀ j, sliceCoord F₀ j ≠ 0) (S : Source F) (hfact : (S.k.factorial : K) ≠ 0)
    (hlead : srcLead F F₀ S ≠ 0) (z y r : ℕ) (hr : 5 ≤ r)
    (hF : ∀ e ∈ F.support, e 2 ≤ r ∧ e 1 + e 2 ≤ r + y ∧ e 1 + e 2 + e 3 ≤ r + y + z)
    (sR sY sZ : Bool) : PsiSIntegral F F₀ hdvd S ⟨z, y + 1, r - 2⟩ sR sY sZ :=
  psiS_integral_euler F F₀ hdvd hH (Ring.two_ne_zero (by rw [ringChar.eq K 2130706433]; norm_num)) S
    hfact hlead hc z y r hr hF sR sY sZ (common_krull F F₀ hdvd hH N hN hN9 hc sR sY sZ)
    (common_place_law F F₀ hdvd hH N hN hN9 hc sR sY sZ)

end Chart

