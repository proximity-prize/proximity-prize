variable {K I : Type} [Field K]
variable {x : I → K} {t y r : ℕ}

/-- On a good level curve a polynomial of degree at most one that is not constant on the curve takes
all values but finitely many at no fewer points than it has poles, the points off the zeros of a given
polynomial that is not zero on the curve: from the separability of such polynomials. -/
theorem fibre_bound_of_separable (P : Packet x t y r) (SZ : Source P.F)
    (hsep : SeparableFormStatement P SZ) : FibreBoundStatement P SZ := by
  intro E _ _ _ f Q A hA2 hQ hA V hV ℓ g hℓ hnc hg
  exact fibre_of_separable V.1 ℓ g hnc hg fun hX => hsep E f Q A hA2 hQ hA V hV ℓ hℓ hX

end Packet

