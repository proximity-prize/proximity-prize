set_option autoImplicit false

/-!
The finite certificate of the elementary height bound, as natural numbers that the kernel evaluates.

The bound. A carrier `F` has weights `(r, y, t)`: degree `r` in `R`, degree at most `y` in `(Y, R)`, total
degree `t`. For rationals `b, c ≥ 0` the complete degrees of a general level curve of a pencil on the carrier
satisfy `deg_0 ≤ b deg_1 + c deg_2` as soon as some `n ≥ 1` has

  `N(n c, n (b + c)) - N(n c - r, n (b + c) - t) > n (n (b r + c y) + r)`,        (*)

where `N(ρ, θ)` is the number of monomials `Y^i R^j Z^k` with `j ≤ ρ` and `i + j + k ≤ θ`. The left side is
the dimension of the polynomials of that box modulo `F`; the right side is `n` times a bound for one layer of
the conditions that put such a polynomial into `(F) + (Z - c0)^n`, for a general value `c0`. When (*) holds,
a polynomial of the box outside `(F)` lies there; its zeros and poles on a level curve give the bound.

With `b = B / q`, `c = C / q`, `n = q * m`, so that `n c = m C` and `n (b + c) = m (B + C)`:

* `boxN ρ θ` is `N(ρ, θ)` in closed form, `C(θ + 3, 3) - C(θ - ρ + 2, 3)` with `C(k + 2, 3) = tet k`; the
  second term is zero for `θ ≤ ρ` (natural subtraction and `tet 0 = 0`). `boxN_eq` identifies it with
  `H2Count.boxCount`, which is stated with binomial coefficients. The kernel does not evaluate a binomial
  coefficient at the arguments that occur (about `10 ^ 10`); it evaluates `tet`.
* `boxNSub ρ θ r t` is `N(ρ - r, θ - t)`, zero when an argument is negative.
* `quotientDim ρ θ r t` is the left side of (*) and `layerBound B C q m r y` the right side.
* `LayerGap B C q m r y t` is (*) at the weights `(r, y, t)`.
* `Certificate r y T0 B C q n` is (*) at the weights `(r', y, T0)` for every `r'` from `1` to `r`. A carrier
  of the cell `(t, y, r)` has `R`-degree `r'` in that range and `(Y, R)`-degree at most `y`; `T0` is a floor
  of its total degree. The certificate is per `R`-degree: `Certificate.count` is (*) at one `r'`, in the form
  of the hypothesis of `H2Sec.ExistsStatement`, the existence of the auxiliary polynomial, with the lower and
  the upper bound of the `R`-degree both equal to `r'`.
* `gateNum r y T0 B C q` is `q ^ 2` times `T0 c (c + 2 b) - 2 y c - r b (2 - b)`, the coefficient of
  `n ^ 2 / 2` in the difference of the two sides of (*) at the weights `(r, y, T0)`.

`Certificate` and `LayerGap` are reducible, so that `decide` finds their decision procedures.

The last five theorems evaluate the definitions at one witness: the cell `(r, y) = (14, 66)` with the floor
`4593`, `b = 199 / 10000`, `c = 33727 / 5000000`, `n = 81920000000`; that is `B = 99500`, `C = 33727`,
`q = 5000000`, `m = 16384`. The floor is tight for this witness: at the floor `4592` the certificate fails
(at `r' = 14`), so it applies to carriers of total degree at least `4593` only.
-/

namespace ProximityPrize.SubmissionLower.FormalR.H2

/-- `m (m + 1) (m + 2) / 6`, the binomial coefficient `C(m + 2, 3)`. -/
def tet (m : ℕ) : ℕ :=
  m * (m + 1) * (m + 2) / 6

/-- `N(ρ, θ)`, the number of monomials `Y^i R^j Z^k` with `j ≤ ρ` and `i + j + k ≤ θ`:
`C(θ + 3, 3) - C(θ - ρ + 2, 3)`. -/
def boxN (ρ θ : ℕ) : ℕ :=
  tet (θ + 1) - tet (θ - ρ)

/-- `N(ρ - r, θ - t)`, zero when an argument is negative. -/
def boxNSub (ρ θ r t : ℕ) : ℕ :=
  if r ≤ ρ ∧ t ≤ θ then boxN (ρ - r) (θ - t) else 0

/-- The dimension of the polynomials of the box `(ρ, θ)` modulo a polynomial of `R`-degree `r` and total
degree `t`: the left side of (*). -/
def quotientDim (ρ θ r t : ℕ) : ℕ :=
  boxN ρ θ - boxNSub ρ θ r t

/-- The right side of (*) for `b = B / q`, `c = C / q`, `n = q * m`: `n (n (b r + c y) + r)`. -/
def layerBound (B C q m r y : ℕ) : ℕ :=
  q * m * (m * (B * r + C * y) + r)

/-- (*) at the weights `(r, y, t)` for `b = B / q`, `c = C / q`, `n = q * m`. -/
abbrev LayerGap (B C q m r y t : ℕ) : Prop :=
  layerBound B C q m r y < quotientDim (m * C) (m * (B + C)) r t

/-- The certificate of a cell `(r, y)` with floor `T0` for `b = B / q`, `c = C / q` and a positive multiple
`n` of `q`: (*) at the weights `(j + 1, y, T0)` for every `j < r`. -/
abbrev Certificate (r y T0 B C q n : ℕ) : Prop :=
  0 < q ∧ q ∣ n ∧ 0 < n ∧ ∀ j : ℕ, j < r → LayerGap B C q (n / q) (j + 1) y T0

/-- `q ^ 2` times `T0 c (c + 2 b) - 2 y c - r b (2 - b)` at `b = B / q`, `c = C / q`. -/
def gateNum (r y T0 B C q : ℕ) : ℤ :=
  (T0 : ℤ) * C * (C + 2 * B) - 2 * y * C * q - r * B * (2 * q - B)

theorem boxN_eq (ρ θ : ℕ) : boxN ρ θ = H2Count.boxCount ρ θ :=
  (H2Count.boxCount_eq ρ θ).symm

/-- (*) with the count `H2Count.boxCount` in the place of `boxN`. -/
theorem LayerGap.count {B C q m r y t : ℕ} (h : LayerGap B C q m r y t) :
    q * m * (m * (B * r + C * y) + r) <
      H2Count.boxCount (m * C) (m * (B + C)) -
        if r ≤ m * C ∧ t ≤ m * (B + C) then H2Count.boxCount (m * C - r) (m * (B + C) - t) else 0 := by
  have h' := h
  simp only [LayerGap, layerBound, quotientDim, boxNSub, boxN_eq] at h'
  exact h'

/-- The certificate at every `R`-degree `r'` from `1` to `r`, in the form of the hypothesis of the existence
of the auxiliary polynomial: `n` times the bound of a layer is below the count of the box `(γ, β + γ)` minus
that of the box `(γ - r', β + γ - T0)`, for `β = (n / q) B`, `γ = (n / q) C`. -/
theorem Certificate.count {r y T0 B C q n : ℕ} (h : Certificate r y T0 B C q n) {r' : ℕ}
    (hr1 : 1 ≤ r') (hr : r' ≤ r) :
    n * (n / q * B * r' + n / q * C * y + r') <
      H2Count.boxCount (n / q * C) (n / q * B + n / q * C) -
        if r' ≤ n / q * C ∧ T0 ≤ n / q * B + n / q * C then
          H2Count.boxCount (n / q * C - r') (n / q * B + n / q * C - T0) else 0 := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le' hr1
  have h1 := (h.2.2.2 j (Nat.lt_of_succ_le hr)).count
  have hn : n = q * (n / q) := (Nat.mul_div_cancel' h.2.1).symm
  have e1 : n * (n / q * B * (j + 1) + n / q * C * y + (j + 1)) =
      q * (n / q) * (n / q * (B * (j + 1) + C * y) + (j + 1)) := by
    rw [← hn]
    ring
  rw [e1, ← Nat.mul_add (n / q) B C]
  exact h1

/-- The left side of (*) at the corner `(14, 66, 4593)` of the witness. -/
theorem quotientDim_witness :
    quotientDim (16384 * 33727) (16384 * (99500 + 33727)) 14 4593 = 4857320696793857602400 := by
  decide +kernel

/-- The right side of (*) at the corner of the witness. -/
theorem layerBound_witness :
    layerBound 99500 33727 5000000 16384 14 66 = 4857315418275840000000 := by
  decide +kernel

/-- The gate of the witness is `83448697 / 5000000 ^ 2`. -/
theorem gateNum_witness : gateNum 14 66 4593 99500 33727 5000000 = 83448697 := by
  decide +kernel

/-- The certificate of the witness. -/
theorem certificate_witness : Certificate 14 66 4593 99500 33727 5000000 81920000000 := by
  decide +kernel

/-- The floor of the witness is tight: one unit below it the certificate fails. -/
theorem certificate_witness_floor : ¬Certificate 14 66 4592 99500 33727 5000000 81920000000 := by
  decide +kernel

end ProximityPrize.SubmissionLower.FormalR.H2
end
section

/-!
The bound for functions with bounded poles on finitely many complete curves, in the form of the statement
`H2Sec.PoleSpaceStatement`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Pole

/-- On finitely many complete curves with a separable coordinate, linearly independent tuples of
functions with pole order at most `D a v` at every place `v` of every curve `a` number at most
`∑ a, (∑ v ∈ T a, D a v + 1)`, where `D a` vanishes outside the finite set `T a`. -/
theorem poleSpace (E : Type) [Field E] [IsAlgClosed E] : H2Sec.PoleSpaceStatement E :=
  fun A _ C _ sep T D hD ι _ f hf hpole => card_le_sum_degree A C sep T D hD ι f hf hpole

end ProximityPrize.SubmissionLower.FormalR.H2Pole
end
section

/-!
The pole bound of the functions of a layer on the section `Z = c0`.

`H2Sec.BR_le_flagPole`: restriction to a curve `C` of a geometric component `G` over `E`: a polynomial
function that, divided by the vertex monomial of the flag `W`, is integral over each of the eight chart
rings of `G`, has value at most `exp (flagPole W)` at every valuation of the curve that is at most 1 on
the constants (the form of `res_le_flagPole` for the chart rings over `E`).
`H2Sec.isIntegral_of_surfaceDivisor`: a function with value at most 1 at every prime divisor of a
normalized chart of a geometric component is integral over the chart ring.
`H2Sec.poleBound : PoleBoundStatement P`: for `G = A F + (Z - c0)^j H` with `G` in the flag `W`, the
function `H` on a component of the section `Z = c0` has poles at most `flagPole W`. The quotient
`G / (Z - c0)^j` is cancelled on the surface before the restriction: at a prime divisor of a chart where
`Z - c0` has no zero the flag of `G` bounds it, and at one where `Z - c0` has a zero the coordinates are
units (`GoodValue.unit`) and `H` is a polynomial in them.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Sec

open scoped Classical
open WithZero MvPolynomial
open RCN002 RCN072 RCN095 RCN135 RCN136 RCN204 RCN222 RCN264 RCN313
open BD DU _Q7 AFA OT

noncomputable section

section Restrict

variable {E : Type} [Field E] {G C : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime] [C.IsPrime]

theorem BR_eq_zero_of_le (hGC : G ≤ C) (a : MvPolynomial (Fin 3) E)
    (ha : (BR E G).toRingHom a = 0) : (BR E C).toRingHom a = 0 :=
  (Sec.BR_eq_zero_iff (G := C) a).mpr (hGC ((Sec.BR_eq_zero_iff (G := G) a).mp ha))

theorem lmono_neg {L : Type*} [Field L] (x : Fin 3 → L) (a : Fin 3 → ℤ) :
    lmono x (fun j => -a j) = (lmono x a)⁻¹ := by
  simp only [lmono, zpow_neg, mul_inv]

theorem lmono_mem_resGraph (hGC : G ≤ C) (a : Fin 3 → ℤ)
    (ha : ∀ j, a j < 0 → coordinate E C j ≠ 0) :
    (lmono (coordinate E G) a, lmono (coordinate E C) a) ∈
      resGraph (BR E G).toRingHom (BR E C).toRingHom := by
  have hfg : ∀ z, (BR E G).toRingHom z = 0 → (BR E C).toRingHom z = 0 := BR_eq_zero_of_le hGC
  have h : ∀ j : Fin 3, (coordinate E G j ^ a j, coordinate E C j ^ a j) ∈
      resGraph (BR E G).toRingHom (BR E C).toRingHom := fun j =>
    zpow_mem_resGraph hfg (MvPolynomial.X j) (a j) (ha j)
  simpa only [lmono, Prod.mk_mul_mk] using mul_mem (mul_mem (h 0) (h 1)) (h 2)

theorem BR_mem_resGraph (hGC : G ≤ C) (A : MvPolynomial (Fin 3) E) :
    (BR E G A, BR E C A) ∈ resGraph (BR E G).toRingHom (BR E C).toRingHom := by
  have hfg : ∀ z, (BR E G).toRingHom z = 0 → (BR E C).toRingHom z = 0 := BR_eq_zero_of_le hGC
  have h := mem_resGraph hfg A 1 (by rw [map_one]; exact one_ne_zero)
  rw [map_one, map_one, div_one, div_one] at h
  exact h

/-- The elements of a chart ring of the surface restrict to the curve, with value at most 1 at a valuation
of the curve that is at most 1 on the constants and on the chart coordinates. -/
theorem chart_mem_resGraph (hGC : G ≤ C) (sR sY sZ : Bool)
    (hcoord : ∀ i j, chartExp sR sY sZ i j < 0 → coordinate E C j ≠ 0)
    (nu : Valuation (AJ E C) ℤᵐ⁰) (hnuE : ∀ a : E, nu (algebraMap E (AJ E C) a) ≤ 1)
    (hnu : ∀ i, nu (lmono (coordinate E C) (chartExp sR sY sZ i)) ≤ 1)
    (a : AJ E G) (ha : a ∈ surfaceChartRing G sR sY sZ) :
    ∃ b, (a, b) ∈ resGraph (BR E G).toRingHom (BR E C).toRingHom ∧ nu b ≤ 1 := by
  rw [surfaceChartRing] at ha
  induction ha using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ⟨_, lmono_mem_resGraph hGC _ (hcoord i), hnu i⟩
  | algebraMap e =>
    refine ⟨algebraMap E (AJ E C) e, ?_, hnuE e⟩
    have h := BR_mem_resGraph hGC (MvPolynomial.C e)
    rwa [algHom_C, algHom_C] at h
  | add x y _ _ hx hy =>
    obtain ⟨b, hb, hb1⟩ := hx
    obtain ⟨c, hc, hc1⟩ := hy
    exact ⟨b + c, add_mem hb hc, nu.map_add_le hb1 hc1⟩
  | mul x y _ _ hx hy =>
    obtain ⟨b, hb, hb1⟩ := hx
    obtain ⟨c, hc, hc1⟩ := hy
    exact ⟨b * c, mul_mem hb hc, by rw [map_mul]; exact mul_le_one' hb1 hc1⟩

/-- Restriction to a curve of the surface with the monomial multiplier of the chart, over `E`. -/
theorem BR_le_flagPole (hGC : G ≤ C) (num : MvPolynomial (Fin 3) E) (W : FlagDegree)
    (hint : ∀ sR sY sZ : Bool, IsIntegral (surfaceChartRing G sR sY sZ)
      (BR E G num / lmono (coordinate E G) (vertexExp sR sY sZ W)))
    (nu : Valuation (AJ E C) ℤᵐ⁰) (hnuE : ∀ a : E, nu (algebraMap E (AJ E C) a) ≤ 1) :
    nu (BR E C num) ≤ exp (flagPole nu (coordinate E C) W) := by
  obtain ⟨sR, sY, sZ, hR, hY, hZ, hchart, hvert⟩ := chart_select nu (coordinate E C)
  have hbit : ∀ j : Fin 3, (j = 0 ∧ sY = true) ∨ (j = 1 ∧ sR = true) ∨ (j = 2 ∧ sZ = true) →
      coordinate E C j ≠ 0 := by
    rintro j (⟨rfl, hb⟩ | ⟨rfl, hb⟩ | ⟨rfl, hb⟩)
    exacts [hY hb, hR hb, hZ hb]
  have hcoord : ∀ i j, chartExp sR sY sZ i j < 0 → coordinate E C j ≠ 0 := fun i j h =>
    hbit j (chartExp_neg sR sY sZ i j h)
  have hneg := lmono_mem_resGraph hGC (fun j => -vertexExp sR sY sZ W j) (fun j hj =>
    hbit j (vertexExp_ne_zero sR sY sZ W j (by omega)))
  rw [lmono_neg, lmono_neg] at hneg
  have hmem := mul_mem (BR_mem_resGraph hGC num) hneg
  rw [Prod.mk_mul_mk, ← div_eq_mul_inv, ← div_eq_mul_inv] at hmem
  have hfg : ∀ z, (BR E G).toRingHom z = 0 → (BR E C).toRingHom z = 0 := BR_eq_zero_of_le hGC
  have h := le_one_of_isIntegral_resGraph hfg nu
    (fun a : surfaceChartRing G sR sY sZ =>
      chart_mem_resGraph hGC sR sY sZ hcoord nu hnuE hchart a.1 a.2) hmem (hint sR sY sZ)
  rw [map_div₀, hvert W] at h
  exact (div_le_one₀ (zero_lt_iff.2 exp_ne_zero)).1 h

omit [G.IsPrime] in
/-- A valuation that is at most 1 on the constants and on the coordinates is at most 1 on the
polynomials. -/
theorem val_BR_le_one (nu : Valuation (AJ E G) ℤᵐ⁰) (hnuE : ∀ a : E, nu (algebraMap E (AJ E G) a) ≤ 1)
    (hnu : ∀ i, nu (coordinate E G i) ≤ 1) (A : MvPolynomial (Fin 3) E) : nu (BR E G A) ≤ 1 := by
  induction A using MvPolynomial.induction_on with
  | C a =>
    rw [algHom_C]
    exact hnuE a
  | add p q hp hq =>
    rw [map_add]
    exact nu.map_add_le hp hq
  | mul_X p i hp =>
    rw [map_mul, map_mul]
    exact mul_le_one' hp (hnu i)

end Restrict

section Krull

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime] {sR sY sZ : Bool}
variable {N p : ℕ} [CharP E p]

/-- Krull's theorem for a normalized chart of a geometric component: a function with value at most 1 at
every prime divisor of the normalized chart is integral over the chart ring. -/
theorem isIntegral_of_surfaceDivisor (hN : SurfaceNoether G sR sY sZ N) (hp : 3 * N < p) (x : AJ E G)
    (h : ∀ nu : Valuation (AJ E G) ℤᵐ⁰, SurfaceDivisor G sR sY sZ nu → nu x ≤ 1) :
    IsIntegral (surfaceChartRing G sR sY sZ) x := by
  have := normalChart_isFractionRing hN
  have := normalChart_isIntegrallyClosed hN
  have := normalChart_isNoetherianRing hN hp
  obtain ⟨a, rfl⟩ := mem_range_of_valuation_le_one (K := AJ E G) (O := normalChart G sR sY sZ) x
    fun P => h _ (PrimeDivisor.surfaceDivisor hN hp P)
  exact a.2

end Krull

section Packet

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] Exch.component_isPrime

/-- The carrier vanishes on each of its geometric components. -/
theorem BR_baseCarrier (P : Packet x t y r) (g : EX K P.F) :
    BR Ω (Exch.component P g) (baseCarrier P.F) = 0 := by
  obtain ⟨h, hh⟩ := (P.stage g).RR
  have hh' : baseCarrier P.F = (P.stage g).G * h := hh
  rw [Sec.BR_eq_zero_iff, hh']
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

/-- The cancelled quotient at a prime divisor of a chart: at most the vertex monomial of the flag. -/
theorem val_quotient_le (P : Packet x t y r) (hc : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0)
    (c0 : RationalBase K) (h0 : GoodValue P c0) (W : FlagDegree) (j : ℕ)
    (G A H : MvPolynomial (Fin 3) Ω) (hG : BI W G)
    (hGA : G = A * baseCarrier P.F + levelΩ c0 ^ j * H) (g : EX K P.F) (sR sY sZ : Bool)
    (nu : Valuation (AJ Ω (Exch.component P g)) ℤᵐ⁰)
    (hnu : SurfaceDivisor (Exch.component P g) sR sY sZ nu) :
    nu (BR Ω (Exch.component P g) H /
      lmono (coordinate Ω (Exch.component P g)) (vertexExp sR sY sZ W)) ≤ 1 := by
  have hchart : ∀ i, nu (lmono (coordinate Ω (Exch.component P g)) (chartExp sR sY sZ i)) ≤ 1 :=
    fun i => hnu.le_one _ (Algebra.subset_adjoin ⟨i, rfl⟩)
  have hconst : ∀ e : Ω, nu (algebraMap Ω (AJ Ω (Exch.component P g)) e) ≤ 1 := fun e =>
    hnu.le_one _ (Subalgebra.algebraMap_mem _ e)
  have hM := flagPole_eq_vertex nu _ (hc g) sR sY sZ hchart W
  rw [map_div₀, hM, div_le_one₀ (zero_lt_iff.2 exp_ne_zero)]
  by_cases hlt : nu (BR Ω (Exch.component P g) (levelΩ c0)) < 1
  · have hunit := h0.unit g sR sY sZ nu hnu hlt
    have hpole : flagPole nu (coordinate Ω (Exch.component P g)) W = 0 := by
      simp only [flagPole, RCN187.poleOrder, hunit, log_one, max_self, mul_zero, add_zero]
    rw [hpole, exp_zero]
    exact val_BR_le_one nu hconst (fun i => (hunit i).le) H
  · rw [not_lt] at hlt
    have hprod : BR Ω (Exch.component P g) G =
        BR Ω (Exch.component P g) (levelΩ c0) ^ j * BR Ω (Exch.component P g) H := by
      rw [hGA, map_add, map_mul, map_mul, map_pow, BR_baseCarrier, mul_zero, zero_add]
    have hflag : nu (BR Ω (Exch.component P g) G) ≤
        exp (flagPole nu (coordinate Ω (Exch.component P g)) W) := by
      have h := ADJ nu (algebraMap Ω (AJ Ω (Exch.component P g))) hconst
        (coordinate Ω (Exch.component P g)) W G hG
      rwa [MvPolynomial.coe_eval₂Hom, ← MvPolynomial.aeval_def, ← HJ] at h
    refine le_trans ?_ hflag
    rw [hprod, map_mul, map_pow]
    exact le_mul_of_one_le_left' (one_le_pow_of_one_le' hlt j)

theorem poleBound (P : Packet x t y r) : PoleBoundStatement P := by
  intro N hN hNp hc c0 h0 W j G A H hG hGA a v
  have hchar : CharP Ω 2130706433 := RCN135.MP K 2130706433
  have hCmem : a.2.1 ∈ AUR Ω (P.stage a.1).G (levelΩ c0) := AAS Ω _ _ _ a.2
  have hGC : Exch.component P a.1 ≤ a.2.1 :=
    (Ideal.span_singleton_le_iff_mem _).mpr
      (DVL Ω _ _ _ hCmem (Ideal.subset_span (Set.mem_insert _ _)))
  have hle := BR_le_flagPole hGC H W (fun sR sY sZ =>
    isIntegral_of_surfaceDivisor (hN a.1 sR sY sZ) hNp _ fun nu hnu =>
      val_quotient_le P hc c0 h0 W j G A H hG hGA a.1 sR sY sZ nu hnu) v.val
    (fun e => RCN344.NP Ω _ v e)
  refine max_le (ALZ v.val _ W) ?_
  by_cases hz : v.val (BR Ω a.2.1 H) = 0
  · rw [hz, log_zero]
    exact ALZ v.val _ W
  · exact (log_le_iff_le_exp hz).2 hle

end Packet

end

