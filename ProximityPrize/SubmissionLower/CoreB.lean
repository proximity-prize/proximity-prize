/-!
`ExchangeCount` for a packet with its hypotheses supplied by theorems: the nonzero
coordinates, `PsiSIntegral` and `SurfaceNoether`, the tail bridge `tail_order`
and `PlaceSurf.surfacePoint_leastOrder_le`. `exchange_count_packet` keeps the curves `S` with
`IsCurveOnSurface`, the needs `ExchangeNeeds` and the bound `SZ.k < 2130706433` of
`Chart.packet_psiS_integral`.

The needs for a packet with a proper tail cut: `disjoint` fails for finitely many levels `c` only
(`finite_not_disjoint_packet`), and it holds when the coordinates and `A₁` are units along the prime
divisors of the eight charts on which `f - c` vanishes (`disjoint_of_unit`); `closure` is
`IsCurveOnSurface.finite_integralClosure` for curves with a separable coordinate
(`exchangeNeeds_of_disjoint`). So the needs,
and with them `ExchangeCount`, fail for finitely many `c` only (`finite_not_exchangeNeeds`,
`finite_not_exchange_count`).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.Exch

open WithZero MvPolynomial HFree6812
open RCN002 RCN095

section Packet
noncomputable section
open scoped Classical
open RCN074 RCN135 RCN136 RCN159 RCN222 RCN264 RCN313 RCN334
open DU BD AFA BOE
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] component_isPrime fact_irreducible SurfacePoint.isNoetherianRing
  SurfacePoint.isIntegrallyClosed SurfacePoint.isFractionRing

/-- The tail `τ_w` is not zero on the carrier of a packet with a proper tail cut. -/
theorem tail_ne_zero (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) :
    tail P.F P.F (dvd_refl P.F) w ≠ 0 := by
  have hH := Chart.packet_polyH_ne_zero P
  rw [show w = w - 1 + 1 from rfl, tail,
    show sliceCoord P.F 1 = sliceProj P.F (MvPolynomial.X 2) from rfl,
    DJY P.F P.F (dvd_refl P.F) hH (w - 1)]
  exact div_ne_zero (fun h => hp (by
    rw [show w + 1 = w - 1 + 2 from rfl, RCN055.CAN]
    exact ((BMJ P.F _).1 h).mul_left _)) (pow_ne_zero _ hH)

/-- `A₁` is not zero on a geometric component that carries a live curve. -/
theorem function_ne_zero_of_active (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (component P a.1) a.2.1 (S a)) :
    ∀ a ∈ active P SZ, function P SZ a.1 ≠ 0 := fun a ha =>
  function_ne_zero P SZ a.1 (tail_ne_zero P hp) (Chart.packet_polyH_ne_zero P)
    (Curve.sliceProj_ne_zero_of_notMem P.F (component P a.1) (ker_sliceMap_component P a.1) a.2.1
      (hS a ha).ideal_le _ (Finset.mem_filter.mp ha).2)

/-- The need `disjoint` fails for finitely many levels `c` only. -/
theorem finite_not_disjoint_packet (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (W : FlagDegree)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (component P a.1) a.2.1 (S a)) :
    {c : Ω | ∃ a ∈ active P SZ,
      ¬LevelDisjoint (moving P Q A a.1) c (function P SZ a.1) W}.Finite :=
  finite_not_disjoint P SZ Q A W (Chart.packet_sliceCoord_ne_zero P hp) t
    (Chart.surfaceNoether_component P hp) (Chart.packet_three_mul_lt P)
    (function_ne_zero_of_active P hp SZ S hS)

/-- The need `disjoint` when the coordinates and `A₁` are units along every prime divisor of the eight
charts on which `f - c` vanishes. -/
theorem disjoint_of_unit (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω) (W : FlagDegree)
    (hunit : ∀ a ∈ active P SZ, ∀ nu : Valuation (AJ Ω (component P a.1)) ℤᵐ⁰,
      (∃ sR sY sZ, SurfaceDivisor (component P a.1) sR sY sZ nu) →
      nu (moving P Q A a.1 - algebraMap Ω (AJ Ω (component P a.1)) c) < 1 →
        (∀ j, nu (coordinate Ω (component P a.1) j) = 1) ∧ nu (function P SZ a.1) = 1) :
    ∀ a ∈ active P SZ, LevelDisjoint (moving P Q A a.1) c (function P SZ a.1) W := fun a ha =>
  levelDisjoint_of_unit (Chart.surfaceNoether_component P hp a.1) (Chart.packet_three_mul_lt P) _ c _ W
    (hunit a ha)

/-- `ExchangeCount` for a packet with a proper tail cut, with the flag of `A₁` on its cell: for curves
`S` on the surface and data with the needs. -/
theorem exchange_count_packet (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (hZd : SZ.k < 2130706433) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (component P a.1) a.2.1 (S a))
    (hneeds : ExchangeNeeds P SZ Q A c S (SZ.d • cutR w r (y - r) (t - y) + (4 * w) • SZ.flag)) :
    ExchangeCount P hp SZ (baseOrder P Q A c S)
      (lam P SZ Q A c (SZ.d • cutR w r (y - r) (t - y) + (4 * w) • SZ.flag))
      (constant P hp SZ Q A c S (SZ.d • cutR w r (y - r) (t - y) + (4 * w) • SZ.flag)) :=
  exchange_count_cell P hp SZ Q A c S hS hneeds (Chart.packet_sliceCoord_ne_zero P hp)
    (Chart.packet_psiS_integral P hp SZ hZd) t (Chart.surfaceNoether_component P hp)
    (Chart.packet_three_mul_lt P) (tail_order P hp SZ S hS)
    fun _ _ => PlaceSurf.surfacePoint_leastOrder_le

/-- The needs of the exchange from `disjoint` alone: the finite integral closure at the base points is
`IsCurveOnSurface.finite_integralClosure` for a curve with a separable coordinate. -/
theorem exchangeNeeds_of_disjoint (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω) (W : FlagDegree)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (component P a.1) a.2.1 (S a))
    (hsep : ∀ a ∈ active P SZ, Nonempty (RCN341.BP a.2.1))
    (hdisj : ∀ a ∈ active P SZ, LevelDisjoint (moving P Q A a.1) c (function P SZ a.1) W) :
    ExchangeNeeds P SZ Q A c S W where
  disjoint := hdisj
  closure := fun a ha q hq _ _ => (hsep a ha).elim fun sep =>
    (hS a ha).finite_integralClosure
      (coordinate_ne_zero P a.1 (Chart.packet_sliceCoord_ne_zero P hp)) q hq sep

/-- The needs of the exchange fail for finitely many levels `c` only. -/
theorem finite_not_exchangeNeeds (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (W : FlagDegree)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (component P a.1) a.2.1 (S a))
    (hsep : ∀ a ∈ active P SZ, Nonempty (RCN341.BP a.2.1)) :
    {c : Ω | ¬ExchangeNeeds P SZ Q A c S W}.Finite :=
  (finite_not_disjoint_packet P hp SZ Q A W S hS).subset fun c hc => by
    by_contra h
    exact hc (exchangeNeeds_of_disjoint P hp SZ Q A c W S hS hsep fun a ha =>
      by_contra fun hd => h ⟨a, ha, hd⟩)

/-- `ExchangeCount` for a packet with a proper tail cut, with the flag of `A₁` on its cell, holds for
curves `S` on the surface with separable coordinates and every level `c` outside a finite set. -/
theorem finite_not_exchange_count (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (hZd : SZ.k < 2130706433) (Q A : MvPolynomial (Fin 3) Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (component P a.1) a.2.1 (S a))
    (hsep : ∀ a ∈ active P SZ, Nonempty (RCN341.BP a.2.1)) :
    {c : Ω | ¬ExchangeCount P hp SZ (baseOrder P Q A c S)
      (lam P SZ Q A c (SZ.d • cutR w r (y - r) (t - y) + (4 * w) • SZ.flag))
      (constant P hp SZ Q A c S (SZ.d • cutR w r (y - r) (t - y) + (4 * w) • SZ.flag))}.Finite :=
  (finite_not_exchangeNeeds P hp SZ Q A _ S hS hsep).subset fun c hc hneeds =>
    hc (exchange_count_packet P hp SZ hZd Q A c S hS hneeds)

end
end Packet

end ProximityPrize.SubmissionLower.FormalR.Exch
