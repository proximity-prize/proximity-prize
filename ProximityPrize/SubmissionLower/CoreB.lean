section

/-!
The section side of the elementary height bound: statements.

For a packet with polynomial `F` in `X`, `Y`, `R`, `Z` over `K`, the carrier is `F` as a polynomial in
`Y`, `R`, `Z` over the small field `K(X)` (`carrierK P`, coefficients in `RationalBase K`). The box of the
polynomials of `R`-degree at most `γ` and total degree at most `β + γ` (`H2Count.box _ γ (β + γ)`, the
flag `⟨0, β, γ⟩`) is filtered by the powers of `Z - c0` modulo `F`; the box, its layers and the dimension
count are linear algebra over the small field. The auxiliary polynomial `G` of `ExistsAux` is given in
the four-variable ring over `K`, with denominators cleared: it is not divisible by `P.F`, and so it is
not zero on any geometric component of the carrier over the generic field. No conjugacy of the geometric
components and no weight of a single geometric component is used.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Sec

open scoped Classical
open WithZero MvPolynomial
open RCN002 RCN072 RCN095 RCN135 RCN136 RCN222 RCN264 RCN313
open BD DU _Q7 AFA OT

noncomputable section

section Field

variable {k : Type} [Field k]

/-- The level form `Z - c0`. -/
def levelForm (c0 : k) : MvPolynomial (Fin 3) k :=
  MvPolynomial.X 2 - MvPolynomial.C c0

/-- The `j`-th layer of the box along `Z = c0`, as functions on the section: the classes modulo
`(F, Z - c0)` of the cofactors `H` in `G = A F + (Z - c0)^j H` with `G` in the box. -/
def layer (F : MvPolynomial (Fin 3) k) (c0 : k) (ρ θ j : ℕ) :
    Submodule k
      (MvPolynomial (Fin 3) k ⧸ Ideal.span ({F, levelForm c0} : Set (MvPolynomial (Fin 3) k))) :=
  Submodule.map
    (Ideal.Quotient.mkₐ k
      (Ideal.span ({F, levelForm c0} : Set (MvPolynomial (Fin 3) k)))).toLinearMap
    (Submodule.comap (LinearMap.mulLeft k (levelForm c0 ^ j))
      (H2Count.box k ρ θ ⊔ (Ideal.span ({F} : Set (MvPolynomial (Fin 3) k))).restrictScalars k))

/-- Linear algebra over any field: if every layer below `n` has dimension at most `ℓ` (as a rank, so
that an infinite-dimensional layer does not pass) and `n ℓ` is below the dimension of the box modulo `F`,
then the box holds a polynomial outside `(F)` that lies in `(F) + (Z - c0)^n`. -/
def CountStatement (k : Type) [Field k] : Prop :=
  ∀ (F : MvPolynomial (Fin 3) k) (c0 : k) (ρ θ n ℓ : ℕ),
    (∀ j < n, Module.rank k (layer F c0 ρ θ j) ≤ (ℓ : Cardinal)) →
    n * ℓ < Module.finrank k
      (Submodule.map
        (Ideal.Quotient.mkₐ k (Ideal.span ({F} : Set (MvPolynomial (Fin 3) k)))).toLinearMap
        (H2Count.box k ρ θ)) →
    ∃ G ∈ H2Count.box k ρ θ, ¬F ∣ G ∧
      ∃ A H : MvPolynomial (Fin 3) k, G = A * F + levelForm c0 ^ n * H

/-- The zero and pole count on complete curves: on finitely many curves with a separable coordinate,
functions with poles at most `D` are a space of dimension at most `deg D` plus the number of curves.
Stated for a linearly independent family of tuples of functions. -/
def PoleSpaceStatement (E : Type) [Field E] [IsAlgClosed E] : Prop :=
  ∀ (A : Type) [Fintype A] (C : A → Ideal (MvPolynomial (Fin 3) E)) [∀ a, (C a).IsPrime]
    (_sep : ∀ a, RCN341.BP (C a)) (T : ∀ a, Finset (RCN026.Place E (AJ E (C a))))
    (D : ∀ a, RCN026.Place E (AJ E (C a)) → ℕ) (_hD : ∀ a, ∀ v ∉ T a, D a v = 0)
    (ι : Type) [Fintype ι] (f : ι → ∀ a, AJ E (C a)), LinearIndependent E f →
    (∀ i a (v : RCN026.Place E (AJ E (C a))), RCN187.poleOrder v.val (f i a) ≤ (D a v : ℤ)) →
    Fintype.card ι ≤ ∑ a, ((∑ v ∈ T a, D a v) + 1)

end Field

section Packet

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] Exch.component_isPrime

/-- The carrier over the small field `K(X)`. -/
def carrierK (P : Packet x t y r) : MvPolynomial (Fin 3) (RationalBase K) :=
  surfaceMap (algebraMap (Polynomial K) (RationalBase K)) P.F

/-- The level form over the generic field for a value of the small field. -/
abbrev levelΩ (c0 : RationalBase K) : MvPolynomial (Fin 3) (GenericField K) :=
  levelForm (algebraMap (RationalBase K) (GenericField K) c0)

/-- What the construction asks of the value `c0`. `good`: on every geometric component the section
`Z = c0` has multiplicity one along each of its components and no component inside `∂F/∂R = 0` (so no
component lies on two geometric components, in `∂g/∂R = 0`, or is independent of `R`). `unit`: a prime
divisor of one of the eight charts along which `Z - c0` vanishes is one along which the three coordinates
are units (no boundary prime has the constant residue `c0`, no component of the section lies in the zero
locus of a coordinate). -/
structure GoodValue (P : Packet x t y r) (c0 : RationalBase K) : Prop where
  ne_zero : c0 ≠ 0
  good : ∀ g : EX K P.F, Sec.GoodSection (P.stage g).G (levelΩ c0) (baseH P.F)
  unit : ∀ (g : EX K P.F) (sR sY sZ : Bool) (ν : Valuation (AJ Ω (Exch.component P g)) ℤᵐ⁰),
    SurfaceDivisor (Exch.component P g) sR sY sZ ν →
    ν (BR Ω (Exch.component P g) (levelΩ c0)) < 1 →
    ∀ j, ν (coordinate Ω (Exch.component P g) j) = 1

/-- The values that are not good are finitely many, when every chart of every geometric component has a
separating Noether normalization (`SurfaceNoether`) of a degree `N` with `3 N` below the characteristic and
no coordinate vanishes on a geometric component. -/
def GoodValueStatement (P : Packet x t y r) : Prop :=
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0),
    {c0 : RationalBase K | ¬GoodValue P c0}.Finite

/-- The components of the section `Z = c0` on all geometric components (for a good value these are all
the minimal primes of `(g, Z - c0)`). -/
abbrev SectionComponent (P : Packet x t y r) (c0 : RationalBase K) : Type :=
  (g : EX K P.F) × AU Ω (P.stage g).G (levelΩ c0) (baseH P.F)

/-- The embedding of the ring of the section: classes modulo `(F, Z - c0)` over the small field that are
linearly independent there stay linearly independent as tuples of functions on the components of the
section over the generic field (the section is reduced; descent from the generic field to the small
field). -/
def SectionEmbeddingStatement (P : Packet x t y r) : Prop :=
  ∀ (c0 : RationalBase K) (_h0 : GoodValue P c0) (ι : Type) [Fintype ι]
    (H : ι → MvPolynomial (Fin 3) (RationalBase K)),
    LinearIndependent (RationalBase K) (fun i =>
      Ideal.Quotient.mk (Ideal.span ({carrierK P, levelForm c0} :
        Set (MvPolynomial (Fin 3) (RationalBase K)))) (H i)) →
    LinearIndependent Ω (fun i (a : SectionComponent P c0) =>
      BR Ω a.2.1 (MvPolynomial.map (algebraMap (RationalBase K) Ω) (H i)))

/-- The pole bound after cancellation: if `G` of the flag `W` is `(Z - c0)^j H` on the carrier, the
cofactor `H` has poles at most the flag's at every place of every component of the section. The
cancellation happens in the function field of the geometric component; `H` is a polynomial, and no
quotient with a denominator that vanishes on the section is restricted to it. -/
def PoleBoundStatement (P : Packet x t y r) : Prop :=
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0)
    (c0 : RationalBase K) (_h0 : GoodValue P c0) (W : FlagDegree) (j : ℕ)
    (G A H : MvPolynomial (Fin 3) Ω), BI W G →
    G = A * baseCarrier P.F + levelΩ c0 ^ j * H →
    ∀ (a : SectionComponent P c0) (v : RCN026.Place Ω (AJ Ω a.2.1)),
      RCN187.poleOrder v.val (BR Ω a.2.1 H) ≤ RCN204.flagPole v.val (coordinate Ω a.2.1) W

/-- The degree of the flag on the section of a good value: the components are at most `rhi`, and the poles
of the flag `⟨0, β, γ⟩` at any finite sets of places of the components add up to at most `β rhi + γ yhi`,
for a bound `rhi` of the `R`-degree and a bound `yhi` of the `(Y, R)`-degree of the carrier. -/
def SectionDegreeStatement (P : Packet x t y r) : Prop :=
  ∀ (c0 : RationalBase K) (_h0 : GoodValue P c0) (rhi yhi : ℕ)
    (_hr : (baseCarrier P.F).degreeOf 1 ≤ rhi)
    (_hy : ∀ d ∈ (baseCarrier P.F).support, d 0 + d 1 ≤ yhi),
    Fintype.card (SectionComponent P c0) ≤ rhi ∧
    ∀ (β γ : ℕ) (T : ∀ a : SectionComponent P c0, Finset (RCN026.Place Ω (AJ Ω a.2.1))),
      ∑ a, ∑ v ∈ T a, RCN204.flagPole v.val (coordinate Ω a.2.1) ⟨0, β, γ⟩ ≤
        ((β * rhi + γ * yhi : ℕ) : ℤ)

/-- The dimension of every layer along the section of a good value. -/
def LayerBoundStatement (P : Packet x t y r) : Prop :=
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0)
    (c0 : RationalBase K) (_h0 : GoodValue P c0) (β γ rhi yhi : ℕ)
    (_hr : (baseCarrier P.F).degreeOf 1 ≤ rhi)
    (_hy : ∀ d ∈ (baseCarrier P.F).support, d 0 + d 1 ≤ yhi) (j : ℕ),
    Module.rank (RationalBase K) (layer (carrierK P) c0 γ (β + γ) j) ≤
      ((β * rhi + γ * yhi + rhi : ℕ) : Cardinal)

/-- The existence of the auxiliary polynomial: for every value `c0` of the small field outside a finite
set there is `G` in the four-variable ring over `K`, not divisible by `P.F` and not zero on any geometric
component, whose image over the generic field has the flag `⟨0, β, γ⟩` and lies in
`(F) + (Z - c0)^n`. -/
def ExistsAux (P : Packet x t y r) (n β γ : ℕ) : Prop :=
  ∃ bad : Set (RationalBase K), bad.Finite ∧ ∀ c0 ∉ bad, c0 ≠ 0 ∧
    ∃ G : MvPolynomial (Fin 4) K, ¬P.F ∣ G ∧
      (∀ g : EX K P.F, BR Ω (Exch.component P g) (surfaceMap (AL K) G) ≠ 0) ∧
      BI ⟨0, β, γ⟩ (surfaceMap (AL K) G) ∧
      ∃ A H : MvPolynomial (Fin 3) Ω,
        surfaceMap (AL K) G = A * baseCarrier P.F + levelΩ c0 ^ n * H

/-- The existence of the auxiliary polynomial under the finite condition. Hypotheses, in this order: a
separating Noether normalization of every chart of every geometric component (`SurfaceNoether`) with
`3 N` below the characteristic, and nonzero coordinates; the weights of the carrier:
`rlo ≤ deg_R F ≤ rhi`, the `(Y, R)`-degree at most `yhi`, `tlo ≤ deg F`; the finite condition, with every
denominator cleared: `n` times the bound `β rhi + γ yhi + rhi` of a layer stays below the dimension of
the box modulo `F`, where the count of the multiples of `F` in the box is taken as `0` when the weights
do not fit (the form of `H2.LayerGap.count`). -/
def ExistsStatement (P : Packet x t y r) : Prop :=
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0)
    (n β γ rlo rhi yhi tlo : ℕ)
    (_hr1 : rlo ≤ (baseCarrier P.F).degreeOf 1) (_hr2 : (baseCarrier P.F).degreeOf 1 ≤ rhi)
    (_hy : ∀ d ∈ (baseCarrier P.F).support, d 0 + d 1 ≤ yhi)
    (_ht : tlo ≤ (baseCarrier P.F).totalDegree)
    (_hcert : n * (β * rhi + γ * yhi + rhi) <
      H2Count.boxCount γ (β + γ) -
        if rlo ≤ γ ∧ tlo ≤ β + γ then H2Count.boxCount (γ - rlo) (β + γ - tlo) else 0),
    ExistsAux P n β γ

end Packet

end

end ProximityPrize.SubmissionLower.FormalR.H2Sec
end
