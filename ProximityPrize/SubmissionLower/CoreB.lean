/-!
The price with the Euler cap in the forms of the two leaves: the analogues of `HI.pairCost`,
`HI.stageCost_le`, `HI.AHM` (pair leaf) and `HI.nativeScalar`, `HI.BVF` (native leaf).

* `numeratorRE_eq_pairNumeratorR`: for `1 ≤ r ≤ y`, the numerator with the Euler cap at the cell `(t, y, r)`
  is `pairNumeratorR` with the cut and the first-cut flags of the cell `(t, y, r - 1)`; the
  parent flag, the numbers and the flag of the source are its other arguments, unchanged. The Euler flag
  `⟨t - y, y - r + 1, r - 2⟩` of `H` is the cell flag of `(t, y, r - 1)`.
* `pairCostRE d S delta p q t y r`: the stage cost of a pair leaf; `stageCostRE_le`; `pair_leaf_countRE`.
* `nativeRE d S t y r`: the numerator of a native leaf; `native_leaf_countRE`, with the divisor
  `9 * S.d * S.d` and one floor.

The scalars take the multiplicity `d` and the flag `S` of the source as numbers. For a source that fits a
record `z` of `HI.Degrees`, `S.d = z.d` and `S.flag = z.flag` (`HI.fits_degree`, `HI.fits_flag`).

`5 ≤ r` is a hypothesis of the two counts; the scalars and `stageCostRE_le` do not need it.
-/

namespace ProximityPrize.SubmissionLower.FormalR.Cut

section Leaf
noncomputable section
open scoped Classical BigOperators
open RCN074 RCN086 RCN095 RCN135 RCN156 RCN199 RCN222 RCN234 RCN238 RCN243 RCN264 RCN313 RCN334
open FA BD DU BOE AYR AFA TW CB HFreeDir6813 RL
local notation "w" => RCN326.w

/-- The cut with the Euler cap at the cell `(t, y, r)` is the cut of R at the cell `(t, y, r - 1)`. -/
theorem cutFlag_eulerFlag_eq_cellCutR (t y r : ℕ) (hr : 1 ≤ r) (hy : r ≤ y) :
    cutFlag (w + 1) (eulerFlag t y r) = cellCutR t y (r - 1) := by
  rw [cutFlag_eulerFlag]
  show _ = (RCN327.w + 1) • (⟨2 * (t - y), 2 * (y - (r - 1)), 2 * (r - 1) - 7⟩ : FlagDegree) + ⟨0, 0, 3⟩
  rw [show 2 * (y - (r - 1)) = 2 * (y - r) + 2 by omega, show 2 * (r - 1) - 7 = 2 * r - 9 by omega]
  rfl

/-- The numerator with the Euler cap at the cell `(t, y, r)` is the numerator of R with the cut and the
first-cut flags of the cell `(t, y, r - 1)`. -/
theorem numeratorRE_eq_pairNumeratorR (d scale z u v t y r : ℕ) (flag source : FlagDegree)
    (hr : 1 ≤ r) (hy : r ≤ y) :
    numeratorRE d scale z u v t y r flag source = pairNumeratorR d scale z u v t y (r - 1) flag source := by
  rw [numeratorRE, cutFlag_eulerFlag_eq_cellCutR t y r hr hy,
    show Euler.eulerFirst t y r = ASY t y (r - 1) from
      funext fun j => Euler.eulerFirst_eq_ASY t y r j hr hy]
  rfl

/-- The numerator of a native leaf with the Euler cap, for a source of multiplicity `d` and flag `S`:
`numeratorRE` at the scale `d` and the three mixed heights of the parent flag against `S`. -/
def nativeRE (d : ℕ) (S : FlagDegree) (t y r : ℕ) : ℕ :=
  numeratorRE d d (flagMixed ⟨t - y, y - r, r⟩ unitZFlag S) (flagMixed ⟨t - y, y - r, r⟩ unitYZFlag S)
    (flagMixed ⟨t - y, y - r, r⟩ unitAllFlag S) t y r ⟨t - y, y - r, r⟩ S

/-- The stage cost of a pair leaf with the Euler cap, for a source of multiplicity `d` and flag `S`, an
owner flag `p` and a tuple flag `q`: `HI.pairCost` with `numeratorRE`. -/
def pairCostRE (d : ℕ) (S : FlagDegree) (delta : ℕ) (p q : FlagDegree) (t y r : ℕ) : ℕ :=
  numeratorRE d (d * delta) (delta * flagMixed ⟨t - y, y - r, r⟩ unitZFlag S)
    (d * flagMixed p q unitYZFlag) (d * flagMixed p q unitAllFlag) t y r ⟨t - y, y - r, r⟩ S /
      (9 * d * (d * delta))

variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}

omit [CharP K 2130706433] in
/-- `HI.stageCost_le` with the Euler cap. -/
theorem stageCostRE_le {F : MvPolynomial (Fin 4) K} (SZ SP SQ : Source F) (delta : ℕ)
    (p q : FlagDegree) (t y r : ℕ)
    (hp : GF.CumulativeLe (ordinaryFlag SP.P) p) (hq : GF.CumulativeLe (ordinaryFlag SQ.P) q) :
    pairStageCostRE SZ SP SQ delta t y r ⟨t - y, y - r, r⟩ ≤ pairCostRE SZ.d SZ.flag delta p q t y r := by
  unfold pairStageCostRE stageScale pairCostRE
  apply Nat.div_le_div_right
  have hu := GF.CAB _ _ _ _ unitYZFlag hp hq
  have hv := GF.CAB _ _ _ _ unitAllFlag hp hq
  simp only [numeratorRE, priceNumerator, price]
  gcongr

/-- The pair leaf with the Euler cap: `HI.AHM`. -/
theorem pair_leaf_countRE
    (P : Packet x t y r) (SZ SP SQ : Source P.F)
    (hFT : SZ.T < wt AT P.F) (hk : SZ.k < 2130706433)
    (hg : ER.Gates t y r (SZ.B - 2 * SZ.n0) (SZ.U - SZ.n0) (SZ.T - SZ.n0))
    (hcop : IsRelPrime SP.P SQ.P) (delta : ℕ) (hd : 0 < delta) (hchar : delta ≤ 2130706433)
    (hSP : delta ≤ SP.d) (hSQ : delta ≤ SQ.d)
    (p q : FlagDegree) (hp : GF.CumulativeLe (ordinaryFlag SP.P) p)
    (hq : GF.CumulativeLe (ordinaryFlag SQ.P) q)
    (hz : flagMixed p q unitZFlag < 2130706433)
    (hu : flagMixed p q unitYZFlag < 2130706433)
    (hr : 5 ≤ r) :
    P.seeds.card ≤ max (EF.MG t y r)
      (pairCostRE SZ.d SZ.flag delta p q t y r + ER.leadingPrice SZ t y r) :=
  (pair_packet_countRE P SZ SP SQ hFT hk hg hcop delta hd hchar hSP hSQ
    ((GF.CAB _ _ _ _ unitZFlag hp hq).trans_lt hz) ((GF.CAB _ _ _ _ unitYZFlag hp hq).trans_lt hu)
    hr).trans
    (max_le_max le_rfl (Nat.add_le_add_right (stageCostRE_le SZ SP SQ delta p q t y r hp hq) _))

/-- The native leaf with the Euler cap: `HI.BVF`, with the divisor `9 * S.d * S.d`. -/
theorem native_leaf_countRE
    (P : Packet x t y r) (S : Source P.F) (hk : S.k < 2130706433) (hFT : S.T < wt AT P.F)
    (hgates : ER.Gates t y r (S.B - 2 * S.n0) (S.U - S.n0) (S.T - S.n0)) (hr : 5 ≤ r) :
    P.seeds.card ≤ max (EF.MG t y r)
      (nativeRE S.d S.flag t y r / (9 * S.d * S.d) + ER.leadingPrice S t y r) :=
  native_packet_countRE P S hk hFT hgates hr

end
