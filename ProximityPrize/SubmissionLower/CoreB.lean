private theorem val_le_exp_pole {L : Type} [Field L] (v : Valuation L (WithZero (Multiplicative ℤ)))
    (x : L) : v x ≤ WithZero.exp (RCN187.poleOrder v x) := by
  have hn : max 1 (v x) ≠ 0 := ne_of_gt (zero_lt_one.trans_le (le_max_left _ _))
  rw [RCN187.poleOrder, ← RCN187.log_max_one, WithZero.exp_log hn]
  exact le_max_right _ _

private theorem field_eval {E : Type} [Field E] (P : Ideal (MvPolynomial (Fin 3) E)) [P.IsPrime]
    (B : MvPolynomial (Fin 3) E) :
    MvPolynomial.eval₂Hom (algebraMap E (AJ E P)) (coordinate E P) B = BR E P B := by
  rw [HJ]
  exact (MvPolynomial.aeval_eq_eval₂Hom _ _).symm

section Curve
variable {E : Type} [Field E] [IsAlgClosed E]
local notation "Poly" => MvPolynomial (Fin 3) E

omit [IsAlgClosed E] in
/-- For every `Q`, `A` of the two flags and every constant `c`, the pole order of `Q + A G / H - c` at a
place of the curve `P` is at most `KS`, the pole order of a general moving function. -/
theorem poleOrder_level_le (P : Ideal Poly) [P.IsPrime] (H G Q A : Poly)
    (hQ : BI (2 • unitAllFlag) Q) (hA : BI unitYZFlag A) (c : E) (nu : RCN026.Place E (AJ E P)) :
    RCN187.poleOrder nu.val (movingValue P H G Q A - algebraMap E (AJ E P) c) ≤ KS P H G nu := by
  have hK : (0 : ℤ) ≤ KS P H G nu := by
    dsimp [KS, RCN187.poleOrder]
    positivity
  have hc := NP E (AJ E P) nu
  have hQv : nu.val (BR E P Q) ≤ WithZero.exp (KS P H G nu) := by
    have h := ADJ nu.val (algebraMap E (AJ E P)) hc (coordinate E P) (2 • unitAllFlag) Q hQ
    rw [field_eval, DZP, BPD] at h
    refine h.trans (WithZero.exp_le_exp.mpr ?_)
    rw [Nat.cast_ofNat]
    exact le_max_left _ _
  have hAv : nu.val (BR E P A * BR E P G / BR E P H) ≤ WithZero.exp (KS P H G nu) := by
    have h := ADJ nu.val (algebraMap E (AJ E P)) hc (coordinate E P) unitYZFlag A hA
    rw [field_eval, CWP] at h
    have hr := val_le_exp_pole nu.val (movingRatio P H G)
    rw [mul_div_assoc, map_mul]
    refine (mul_le_mul' h hr).trans ?_
    rw [← WithZero.exp_add]
    exact WithZero.exp_le_exp.mpr (le_max_right _ _)
  have hcv : nu.val (algebraMap E (AJ E P) c) ≤ WithZero.exp (KS P H G nu) :=
    (hc c).trans (by rw [← WithZero.exp_zero]; exact WithZero.exp_le_exp.mpr hK)
  apply VI.BIH nu.val _ _ hK
  refine (Valuation.map_sub _ _ _).trans (max_le ?_ hcv)
  exact (Valuation.map_add _ _ _).trans (max_le hQv hAv)

/-- On a curve with a separable literal coordinate, the zeros of `Q + A G / H - c` at any finite set of
places, with multiplicity, are at most any bound for the sums of `KS` over finite sets of places. -/
theorem levelZeros_le (P : Ideal Poly) [P.IsPrime] (base : BP P) (H G Q A : Poly)
    (hQ : BI (2 • unitAllFlag) Q) (hA : BI unitYZFlag A) (c : E) (cost : ℕ)
    (hcost : ∀ V : Finset (RCN026.Place E (AJ E P)), (∑ nu ∈ V, KS P H G nu) ≤ (cost : ℤ))
    (V : Finset (RCN026.Place E (AJ E P))) : levelZeros P H G Q A c V ≤ (cost : ℤ) := by
  by_cases hx0 : movingValue P H G Q A - algebraMap E (AJ E P) c = 0
  · simp [levelZeros, hx0, RCN026.zeroOrder, RCN026.order]
  let _ := IP E P base.index
  let _ := DT E P base.index base.transcendental
  let _ := IU E P base.index
  let _ := _Q5 E P base.index base.transcendental
  let _ := IS E P base.index base.transcendental
  let _ : FiniteDimensional (RatFunc E) (AJ E P) := base.finite
  let _ : Algebra.IsSeparable (RatFunc E) (AJ E P) := base.separable
  set x := movingValue P H G Q A - algebraMap E (AJ E P) c with hx
  calc
    levelZeros P H G Q A c V = ∑ nu ∈ V, RCN026.zeroOrder E (AJ E P) nu x := rfl
    _ ≤ ∑ nu ∈ V ∪ RCN026.placesFor E (AJ E P) x hx0, RCN026.zeroOrder E (AJ E P) nu x :=
      Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_left
        (fun nu _ _ => RCN026.AUU E (AJ E P) nu x)
    _ = ∑ nu ∈ RCN026.placesFor E (AJ E P) x hx0, RCN026.zeroOrder E (AJ E P) nu x := by
      symm
      apply Finset.sum_subset Finset.subset_union_right
      intro nu _ hnot
      have ho : RCN026.order E (AJ E P) nu x = 0 := by
        by_contra hn
        exact hnot (RCN026.ALB E (AJ E P) x hx0 nu hn)
      simp only [RCN026.zeroOrder, ho, max_self]
    _ = ∑ nu ∈ RCN026.placesFor E (AJ E P) x hx0, RCN346.poleOrder E (AJ E P) nu x :=
      RCN026.AJO E (AJ E P) x hx0
    _ ≤ ∑ nu ∈ RCN026.placesFor E (AJ E P) x hx0, KS P H G nu :=
      Finset.sum_le_sum (fun nu _ => poleOrder_level_le P H G Q A hQ hA c nu)
    _ ≤ (cost : ℤ) := hcost _

end Curve

private theorem carrier_ne_zero {K E : Type} [Field K] [Field E] (eta : GenericField K →+* E)
    (F : MvPolynomial (Fin 4) K) (hF : F ≠ 0) : BXI eta F ≠ 0 :=
  ZL (codeMap eta) (DTI eta) F hF

private theorem frozenH_mem {K E : Type} [Field K] [Field E] (eta : GenericField K →+* E)
    (F : MvPolynomial (Fin 4) K) :
    frozenH eta F ∈ Ideal.span
      ({BXI eta F, MvPolynomial.pderiv (1 : Fin 3) (BXI eta F)} : Set (MvPolynomial (Fin 3) E)) := by
  apply Ideal.subset_span
  apply Set.mem_insert_of_mem
  rw [Set.mem_singleton_iff, BXI, RCN267.ZO]
  rfl

section Budget
variable {K E : Type} [Field K] [CharP K 2130706433] [Field E] [IsAlgClosed E] [CharP E 2130706433]
local notation "Poly" => MvPolynomial (Fin 3) E

/-- Costs of the components of a section, from `APJ.EFP` for a slice budget `B`. -/
private theorem exists_cost (eta : GenericField K →+* E) (F : MvPolynomial (Fin 4) K) (SZ : Source F)
    (W : FlagDegree) (s : Poly) (scale z u v : ℕ) (hF : F ≠ 0) (hs : BI W s)
    (B : SliceBudgets (BXI eta F) s (frozenH eta F) W)
    (hbound : ∀ Q A : Poly, (2 : Poly) * A ≠ 0 →
      BI (2 • unitAllFlag) Q → BI unitYZFlag A → AGN eta F SZ Q A scale z u v)
    (active : Finset (ANR (BXI eta F) s (frozenH eta F)))
    (hlead : ∀ a ∈ active, SZ.leading (codeMap eta) ∉ a.2.1) :
    ∃ cost : ANR (BXI eta F) s (frozenH eta F) → ℕ,
      (∀ a ∈ active, ∀ V : Finset (RCN026.Place E (AJ E a.2.1)),
        (∑ nu ∈ V, KS a.2.1 (frozenH eta F) (frozenG eta F) nu) ≤ (cost a : ℤ)) ∧
      scale * (∑ a ∈ active, cost a) ≤ W.zOnly * z + W.yz * u + W.all * v := by
  obtain ⟨moving, -, hsum⟩ := APJ.EFP eta F SZ (BXI eta F) s (carrier_ne_zero eta F hF) (dvd_refl _)
    (frozenH_mem eta F) W hs B active hlead scale z u v hbound
  refine ⟨fun a => if h : a ∈ active then (moving ⟨a, h⟩).movingCost else 0, ?_, ?_⟩
  · intro a ha V
    simpa only [ha, ↓reduceDIte] using (moving ⟨a, ha⟩).movingPole V
  · rw [← Finset.sum_coe_sort active]
    simpa only [Finset.coe_mem, ↓reduceDIte, Subtype.coe_eta] using hsum

theorem sectionMovingBudget : SectionMovingBudget K E := by
  intro eta F SZ p W s scale z u v hF hp hs hdeg hmix hbound active hlead
  obtain ⟨B⟩ := EFX (BXI eta F) s (frozenH eta F) p W (carrier_ne_zero eta F hF) hp hs
    2130706433 hdeg hmix
  exact exists_cost eta F SZ W s scale z u v hF hs B hbound active hlead

theorem sectionZeroBudget : SectionZeroBudget K E := by
  intro eta F SZ p W s scale z u v hF hp hs hdeg hmix hbound Q A c hQ hA active hlead V
  obtain ⟨B⟩ := EFX (BXI eta F) s (frozenH eta F) p W (carrier_ne_zero eta F hF) hp hs
    2130706433 hdeg hmix
  obtain ⟨cost, hcost, hsum⟩ := exists_cost eta F SZ W s scale z u v hF hs B hbound active hlead
  have hle : (∑ a ∈ active, levelZeros a.2.1 (frozenH eta F) (frozenG eta F) Q A c (V a)) ≤
      ∑ a ∈ active, (cost a : ℤ) :=
    Finset.sum_le_sum fun a ha => levelZeros_le a.2.1 (B.base a.1 a.2) _ _ Q A hQ hA c
      (cost a) (hcost a ha) (V a)
  calc
    (scale : ℤ) * (∑ a ∈ active, levelZeros a.2.1 (frozenH eta F) (frozenG eta F) Q A c (V a)) ≤
        (scale : ℤ) * ∑ a ∈ active, (cost a : ℤ) :=
      mul_le_mul_of_nonneg_left hle (Int.natCast_nonneg scale)
    _ ≤ ((W.zOnly * z + W.yz * u + W.all * v : ℕ) : ℤ) := by exact_mod_cast hsum

/-- The degree of `Q + A σ` on a section, as its poles at any places of the components: at most the price
of the flag of the section. -/
theorem sectionPoleBudget (eta : GenericField K →+* E) (F : MvPolynomial (Fin 4) K) (SZ : Source F)
    (p W : FlagDegree) (s : Poly) (scale z u v : ℕ) (hF : F ≠ 0) (hp : BI p (BXI eta F)) (hs : BI W s)
    (hdeg : p.zOnly + p.yz + p.all < 2130706433)
    (hmix : 2 * (p.zOnly + p.yz + p.all) * (W.zOnly + W.yz + W.all) < 2130706433)
    (hbound : ∀ Q A : Poly, (2 : Poly) * A ≠ 0 →
      BI (2 • unitAllFlag) Q → BI unitYZFlag A → AGN eta F SZ Q A scale z u v)
    (Q A : Poly) (hQ : BI (2 • unitAllFlag) Q) (hA : BI unitYZFlag A)
    (active : Finset (ANR (BXI eta F) s (frozenH eta F)))
    (hlead : ∀ a ∈ active, SZ.leading (codeMap eta) ∉ a.2.1)
    (V : (a : ANR (BXI eta F) s (frozenH eta F)) → Finset (RCN026.Place E (AJ E a.2.1))) :
    (scale : ℤ) * (∑ a ∈ active, ∑ nu ∈ V a,
        RCN187.poleOrder nu.val (movingValue a.2.1 (frozenH eta F) (frozenG eta F) Q A)) ≤
      ((W.zOnly * z + W.yz * u + W.all * v : ℕ) : ℤ) := by
  obtain ⟨cost, hcost, hsum⟩ := sectionMovingBudget eta F SZ p W s scale z u v hF hp hs hdeg hmix hbound
    active hlead
  have hle : (∑ a ∈ active, ∑ nu ∈ V a,
      RCN187.poleOrder nu.val (movingValue a.2.1 (frozenH eta F) (frozenG eta F) Q A)) ≤
      ∑ a ∈ active, (cost a : ℤ) :=
    Finset.sum_le_sum fun a ha => (Finset.sum_le_sum fun nu _ => by
      have h := poleOrder_level_le a.2.1 (frozenH eta F) (frozenG eta F) Q A hQ hA 0 nu
      rwa [map_zero, sub_zero] at h).trans (hcost a ha (V a))
  calc
    _ ≤ (scale : ℤ) * ∑ a ∈ active, (cost a : ℤ) :=
      mul_le_mul_of_nonneg_left hle (Int.natCast_nonneg scale)
    _ ≤ ((W.zOnly * z + W.yz * u + W.all * v : ℕ) : ℤ) := by exact_mod_cast hsum

theorem choiceOrder : ChoiceOrder K E := by
  intro eta F SZ p scale z u v hF hp hdeg hbound I _ P _ base
  obtain ⟨Q, A, projection, hQ, hA, hproj⟩ := BJG P base (frozenH eta F) (frozenG eta F)
  refine ⟨Q, A, projection, hQ, hA, hproj, ?_⟩
  intro c W s hs hmix active hlead V
  exact sectionZeroBudget eta F SZ p W s scale z u v hF hp hs hdeg hmix hbound Q A c hQ hA active
    hlead V

end Budget

namespace Sec

/-- A component of a section of the factor `g` on which `H` does not vanish, as a component in the
indexing of the components of the section of `F`. -/
def sliceComponent {E : Type} [Field E] [IsAlgClosed E] (F s H g : MvPolynomial (Fin 3) E)
    (hg : g ∈ RCN137.IW F) (hs : ¬g ∣ s) (hd : MvPolynomial.pderiv (1 : Fin 3) g ≠ 0)
    (P : Ideal (MvPolynomial (Fin 3) E)) (hP : P ∈ AUR E g s) (hH : H ∉ P) : ANR F s H :=
  ⟨⟨g, Finset.mem_filter.mpr ⟨hg, hs, hd⟩⟩, ⟨P, (AJF E).mpr ⟨hP, hH⟩⟩⟩

theorem sliceComponent_prime {E : Type} [Field E] [IsAlgClosed E] (F s H g : MvPolynomial (Fin 3) E)
    (hg : g ∈ RCN137.IW F) (hs : ¬g ∣ s) (hd : MvPolynomial.pderiv (1 : Fin 3) g ≠ 0)
    (P : Ideal (MvPolynomial (Fin 3) E)) (hP : P ∈ AUR E g s) (hH : H ∉ P) :
    (sliceComponent F s H g hg hs hd P hP hH).2.1 = P :=
  rfl

end Sec

