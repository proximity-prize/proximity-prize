/-!
The elementary height bound on a curve of the generic level.

`D` is a prime over the generic field of `E` with a separable coordinate that is not the ideal of a
point, contains the carrier and the level cut of a pencil at the transcendental level, and does not
contain the coefficient of the level in the level cut. For the auxiliary polynomial of the elementary
height bound with the numbers `n`, `β`, `γ`, the bound on one curve gives: `n` times the poles of `Z` on
`D` is at most `β` times the poles of the flag `(0, 1, 0)` plus `γ` times the poles of the flag
`(0, 0, 1)`.

The auxiliary polynomial exists for every constant `c0` of the small field `K(X)` outside a finite
set, and the bound on one curve asks that `Z - c0` has no zero at a place where a coordinate has a
pole. The constant is chosen after the curve:

* `finite_pole_values`: a coordinate has finitely many poles on `D`, and at one place `Z - c` has a zero
  for at most one constant `c`, so finitely many constants are excluded;
* the small field is infinite and maps injectively to the generic field of `E`, so a constant outside
  both finite sets exists;
* the image of the auxiliary polynomial over the generic field of `E` has the same flag, is
  `(Z - c0)^n` times a polynomial modulo the carrier, and is not zero on `D` (`aux_notMem`: it is not
  divisible by the irreducible polynomial of the carrier).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Bud

open WithZero MvPolynomial
open RCN002 RCN084 RCN095 RCN135 RCN136 RCN264 RCN313
open BD DU LF WC _Q7

noncomputable section

namespace CurveH2

section Curve

variable {k : Type} [Field k] [IsAlgClosed k] {D : Ideal (MvPolynomial (Fin 3) k)} [D.IsPrime]

/-- On a curve with a separable coordinate, the constants `c` for which `Z - c` has a zero at a place
where a coordinate has a pole are finitely many: each coordinate has finitely many poles, and at one
place `Z - c` has a zero for at most one constant, because a place is trivial on the constants. -/
theorem finite_pole_values (sep : RCN341.BP D) :
    {c : k | ∃ v : RCN026.Place k (AJ k D), (∃ j, 1 < v.val (coordinate k D j)) ∧
      v.val (coordinate k D 2 - algebraMap k (AJ k D) c) < 1}.Finite := by
  have hpole : ∀ j : Fin 3,
      {v : RCN026.Place k (AJ k D) | 1 < v.val (coordinate k D j)}.Finite := by
    intro j
    by_cases hx : coordinate k D j = 0
    · refine Set.finite_empty.subset fun v (hv : 1 < v.val (coordinate k D j)) => ?_
      rw [hx, map_zero] at hv
      exact absurd hv (not_lt.mpr zero_le_one)
    · refine (Curve.finite_order_ne_zero D sep _ hx).subset
        fun v (hv : 1 < v.val (coordinate k D j)) => ?_
      have h0 : v.val (coordinate k D j) ≠ 0 := ne_of_gt (zero_lt_one.trans hv)
      have hlog : 0 < (v.val (coordinate k D j)).log :=
        (lt_log_iff_exp_lt h0).mpr (by rwa [exp_zero])
      change -(v.val (coordinate k D j)).log ≠ 0
      omega
  have hS : {v : RCN026.Place k (AJ k D) | ∃ j, 1 < v.val (coordinate k D j)}.Finite :=
    (Set.finite_iUnion hpole).subset fun v ⟨j, hj⟩ => Set.mem_iUnion.mpr ⟨j, hj⟩
  refine (finite_level_values ((fun v : RCN026.Place k (AJ k D) => v.val) '' _) (hS.image _)
    (fun ν hν => ?_) (coordinate k D 2)).subset fun c ⟨v, hv, hc⟩ => ⟨v.val, ⟨v, hv, rfl⟩, hc⟩
  obtain ⟨v, -, rfl⟩ := hν
  exact v.property.2.eq_one

end Curve

end CurveH2

section Packet

open scoped Classical

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}

/-- The elementary height bound on a curve of the generic level, for the auxiliary polynomial of a
packet. The constant `c0` is chosen for the curve, outside the finitely many constants without an
auxiliary polynomial and the finitely many for which `Z - c0` has a zero at a pole of a coordinate. -/
theorem curve_h2 (P : Packet x t y r) : CurveH2Statement P := by
  intro n β γ haux E _ _ f Q A D _ sep hOO hXC hH hpt T
  obtain ⟨bad, hbad, haux⟩ := haux
  let ι : GenericField K →+* GenericField E := (HO E).comp f
  let g : RationalBase K →+* GenericField E :=
    ι.comp (algebraMap (RationalBase K) (GenericField K))
  have hinf : Infinite (RationalBase K) := Infinite.of_injective _
    (IsFractionRing.injective (Polynomial K) (RationalBase K))
  obtain ⟨c0, hc0⟩ := (hbad.union ((CurveH2.finite_pole_values sep).preimage
    (Set.injOn_of_injective g.injective))).exists_notMem
  obtain ⟨-, G, hdiv, -, hflag, A0, H0, hid⟩ := haux c0 fun h => hc0 (Or.inl h)
  have hGa : surfaceMap ((HO E).comp (codeMap f)) G =
      MvPolynomial.map ι (surfaceMap (AL K) G) := CurveH2.surfaceMap_comp ι (AL K) G
  refine H2Lev.curve (GenericField E) D sep (g c0) n β γ
    (surfaceMap ((HO E).comp (codeMap f)) G) (MvPolynomial.map ι H0) ?_ ?_ ?_ ?_ T
  · rw [hGa]
    exact RCN207.inFlag_map ι hflag
  · exact CurveH2.aux_notMem f P.irreducible hdiv Q A D hpt hOO hXC hH
  · have hF : MvPolynomial.map ι (AFA.baseCarrier P.F) = OO f P.F :=
      (CurveH2.surfaceMap_comp ι (AL K) P.F).symm
    have hL : MvPolynomial.map ι (H2Sec.levelΩ c0) =
        MvPolynomial.X 2 - MvPolynomial.C (g c0) := by
      simp only [H2Sec.levelForm, map_sub, MvPolynomial.map_X, MvPolynomial.map_C]
      rfl
    have h1 : surfaceMap ((HO E).comp (codeMap f)) G -
        (MvPolynomial.X 2 - MvPolynomial.C (g c0)) ^ n * MvPolynomial.map ι H0 =
        MvPolynomial.map ι A0 * OO f P.F := by
      rw [hGa, hid, map_add, map_mul, map_mul, map_pow, hF, hL]
      ring
    rw [h1]
    exact D.mul_mem_left _ hOO
  · intro v hv j
    by_contra hj
    rw [H2Lev.BR_levelForm] at hv
    exact hc0 (Or.inr ⟨v, ⟨j, not_le.mp hj⟩, hv⟩)

end Packet

end

