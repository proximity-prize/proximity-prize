/-- If the tail cut of index `w + 1 + delay` is not identically zero on the live curve,
the image of the tail of index `w + delay` has value 1 along the curve. -/
theorem packet_tail_val_eq_one (hSa : IsCurveOnSurface G a.2.1 Sa) (delay : ℕ)
    (hcut : _Q2 (AL K) (P.stage a.1).F (w + 1 + delay) ∉ a.2.1) :
    Sa.val (RY G P.F hker (tail P.F P.F (dvd_refl P.F) (w + delay))) = 1 := by
  have h1 : w + delay = 131070 + delay + 1 := by
    unfold RCN326.w
    omega
  have h2 : w + 1 + delay = 131070 + delay + 2 := by
    unfold RCN326.w
    omega
  rw [h2] at hcut
  rw [h1]
  exact tail_val_eq_one P.F G hker a.2.1 hSa _ hcut

/-- The order along a live curve of the image of the tail of index `w` is at least the
multiplicity `multiplicity P hp a` of the curve. -/
theorem packet_tail_val_le_multiplicity (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (hSa : IsCurveOnSurface G a.2.1 Sa) :
    Sa.val (RY G P.F hker (tail P.F P.F (dvd_refl P.F) w)) ≤ exp (-(multiplicity P hp a : ℤ)) := by
  have hF : Fact (Irreducible (MU (P.stage a.1)).F) := ‹Fact (Irreducible P.F)›
  exact tail_val_le_multiplicity (MU (P.stage a.1)) a.2
    (DN (MU (P.stage a.1)) (P.stage_proper hp a.1)) G hker Sa hSa

omit [Fact (Irreducible P.F)] in
/-- `packet_tail_val_le_multiplicity` for the active curves of a packet: `Exch.TailOrder`. -/
theorem tail_order (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F)
    (S : ∀ a : Curve P, Specialization (AJ (GenericField K) (Exch.component P a.1))
      (AJ (GenericField K) a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a)) :
    Exch.TailOrder P hp SZ S := by
  intro a ha
  have h := @packet_tail_val_le_multiplicity K I _ _ x t y r P ⟨P.irreducible⟩ a
    (Exch.component P a.1) _ (Exch.ker_sliceMap_component P a.1) (S a) hp (hS a ha)
  unfold Exch.embedding
  exact h

end
