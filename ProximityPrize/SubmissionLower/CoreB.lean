open scoped Classical
open RCN135 RCN136 RCN313
open BD DU LF WC _Q7 FA

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}

/-- A level curve through a counted point of the point budget of a packet (an isolated zero of the
cut) is good, and the cut is not zero on it. -/
theorem good (P : Packet x t y r) (SZ : Source P.F) {E : Type} [Field E] [IsAlgClosed E]
    [CharP E 2130706433] (f : GenericField K →+* E) {Q A : MvPolynomial (Fin 3) E}
    (hQ : BI (2 • unitAllFlag) Q) (hA : BI unitYZFlag A)
    {cut : MvPolynomial (Fin 3) (GenericField E)} {v : Fin 3 → GenericField E}
    (V : LevelCurve P SZ f Q A) (hV : V.1 ≤ RingHom.ker (aeval v).toRingHom)
    (hzero : aeval v cut = 0) (hi : UK (OO f P.F) (XC f P.F Q A) cut v) :
    GoodCurve P SZ f Q A V ∧ cut ∉ V.1 := by
  have hchar : CharP (GenericField E) 2130706433 := RCN135.MP E 2130706433
  have hrlo := P.rlow
  have hylo := P.ylow
  have hyt := P.yt
  have hthi := packet_t_le P
  obtain ⟨hHf, hGf⟩ := RCN201.DGW ((HO E).comp (codeMap f)) (cellA t y) (cellB y r) (cellS r) P.F
    P.support.IZ.2.1 P.support.ys_weight P.support.total_weight
  have hT := LevelCount.levelCut_flag hHf hGf (RCN207.inFlag_map (HO E) hQ)
    (RCN207.inFlag_map (HO E) hA) (MF E)
  have hG0 : OO f P.F ≠ 0 := fun h0 =>
    P.irreducible.ne_zero (BMZ f (by simpa only [OO, map_zero] using h0))
  have hdeg : t - y + (y - r) + r < 2130706433 := by omega
  have hmix : 2 * (t - y + (y - r) + r) * (cellA t y + (cellB y r + 1) + (cellS r + 3)) <
      2130706433 := by
    have h1 : t - y + (y - r) + r = t := by omega
    have h2 : cellA t y + (cellB y r + 1) + (cellS r + 3) = t + 1 := by
      simp only [cellA, cellB, cellS]
      omega
    rw [h1, h2]
    nlinarith
  obtain ⟨g, hg, hgG, hgV, hgM⟩ := exists_factor hG0 V hV hzero hi
  have hsep := nonempty_separable (p := 2130706433) hG0 ⟨t - y, y - r, r⟩ _ (P.parent_flag _ _) hT
    hdeg hmix V hg hgG hgV hgM
  exact ⟨⟨hsep, height_eq_two V hg hgV hgM, g, hg, hgG, hgV, hgM⟩, not_mem_of_isolated V hV hi⟩

end Packet

end Counted

section Packet

open scoped Classical
open RCN135 RCN136 RCN313
open BD DU LF WC _Q7

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}

/-- The counted points of the point budget are centres of as many places of the level curves that
carry one. Each such curve is good, the cut is not zero on it, and the cut has a zero at each of the
places: a place of the curve over the point exists because the curve has a separable coordinate, and
places over different points differ. -/
theorem counted (P : Packet x t y r) (SZ : Source P.F) : CountedStatement P SZ := by
  intro E _ _ _ f Q A _ hQ hA cut points hG hM hR hzero hi
  have hgood : ∀ (V : LevelCurve P SZ f Q A), ∀ w ∈ HF (GenericField E) _ _ _ points id V,
      GoodCurve P SZ f Q A V ∧ cut ∉ V.1 := fun V w hw =>
    Counted.good P SZ f hQ hA V (MC (GenericField E) _ _ _ points id V w hw)
      (hzero w (LU (GenericField E) _ _ _ points id V hw))
      (hi w (LU (GenericField E) _ _ _ points id V hw))
  have hplaces : ∀ V : LevelCurve P SZ f Q A,
      ∃ TV : Finset (RCN026.Place (GenericField E) (AJ (GenericField E) V.1)),
        (∀ μ ∈ TV, μ.val (BR (GenericField E) V.1 cut) < 1) ∧
          (HF (GenericField E) _ _ _ points id V).card ≤ TV.card := by
    intro V
    rcases (HF (GenericField E) _ _ _ points id V).eq_empty_or_nonempty with hempty | ⟨w₀, hw₀⟩
    · exact ⟨∅, fun μ hμ => absurd hμ (Finset.notMem_empty μ), by
        rw [hempty, Finset.card_empty]
        exact Nat.zero_le _⟩
    · obtain ⟨base⟩ := (hgood V w₀ hw₀).1.1
      choose place hplace using
        fun pt : {w : Fin 3 → GenericField E // w ∈ HF (GenericField E) _ _ _ points id V} =>
          exists_placeOver base (MC (GenericField E) _ _ _ points id V pt.1 pt.2)
      have hinj : Function.Injective place := fun pt pt' hpt =>
        Subtype.ext ((hplace pt).point_eq (by rw [hpt]; exact hplace pt'))
      refine ⟨(HF (GenericField E) _ _ _ points id V).attach.image place, fun μ hμ => ?_, ?_⟩
      · obtain ⟨pt, -, rfl⟩ := Finset.mem_image.mp hμ
        exact hplace pt cut (hzero pt.1 (LU (GenericField E) _ _ _ points id V pt.2))
      · rw [Finset.card_image_of_injective _ hinj, Finset.card_attach]
  choose T hT hcard using hplaces
  refine ⟨Finset.univ.filter fun V => (HF (GenericField E) _ _ _ points id V).Nonempty, T,
    fun V hV => ?_, ?_⟩
  · obtain ⟨w₀, hw₀⟩ := (Finset.mem_filter.mp hV).2
    exact ⟨(hgood V w₀ hw₀).1, (hgood V w₀ hw₀).2, hT V⟩
  · calc points.card
        ≤ ∑ V : LevelCurve P SZ f Q A, (HF (GenericField E) _ _ _ points id V).card :=
          WX (GenericField E) _ _ _ points id hG hM hR
      _ = ∑ V ∈ Finset.univ.filter fun V => (HF (GenericField E) _ _ _ points id V).Nonempty,
            (HF (GenericField E) _ _ _ points id V).card :=
          (Finset.sum_filter_of_ne fun V _ h => Finset.card_ne_zero.mp h).symm
      _ ≤ _ := Finset.sum_le_sum fun V _ => hcard V

end Packet

end

