/-!
The existence of the auxiliary polynomial for a packet.

`H2Sec.exists_aux : ExistsStatement P`, from `H2Sec.exists_of` with `H2Deg.section_degree` (the degree of
the flag `⟨0, β, γ⟩` on the section `Z = c0`) and `H2Pole.poleSpace` (the dimension of a space of functions
with bounded poles on finitely many complete curves).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Sec

open RCN135 RCN222 DU

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}

/-- For every value `c0` of the small field outside a finite set there is a polynomial `G` of the flag
`⟨0, β, γ⟩`, not divisible by the polynomial of the packet and not zero on any geometric component, in
`(F) + (Z - c0)^n`, when `n` times the bound of a layer is below the dimension of the box modulo `F`. -/
theorem exists_aux (P : Packet x t y r) : ExistsStatement P :=
  exists_of P (H2Deg.section_degree P) (H2Pole.poleSpace (GenericField K))

end ProximityPrize.SubmissionLower.FormalR.H2Sec
end
