/-!
The point budget at the numbers with the elementary height bound, for every pencil.

Let a packet have an auxiliary polynomial of exponent `n` and flag `(0, β, γ)`, and let `E` be an
algebraically closed field over the generic field. If the budget `(scale, z, u, v)` holds for every
pencil `Q`, `A` of the two flags over `E`, then so does the budget
`(n scale, min (n z) (β u + γ v), n u, n v)`.

The parts. The counted points are zeros of the cut at places of good level curves. On each such curve
`n` times the poles of `Z` is at most `β` times the poles of the flag `(0, 1, 0)` plus `γ` times the
poles of the flag `(0, 0, 1)`. The given budget bounds the pole sums of the two unit flags over the good
level curves: a general linear form of the flag is separable on each curve, so it takes a general value
at as many points as it has poles, and these points are counted by the budget, being isolated on the
fibre and off the excluded polynomial.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.H2Bud

open BD DU

variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}

/-- The budget of one pencil bounds the complete pole sums of the two unit flags over every finite
family of good level curves: `scale` times the poles of the flag `(0, 1, 0)` by `u`, and `scale` times
the poles of the flag `(0, 0, 1)` by `v`. -/
theorem unit_bound (P : Packet x t y r) (SZ : Source P.F) : UnitBoundStatement P SZ :=
  unit_bound_of_parts P SZ (isolated P SZ) (fibre_bound_of_separable P SZ (separable_form P SZ))

/-- The budget `(n scale, min (n z) (β u + γ v), n u, n v)` for every pencil of the two flags over an
algebraically closed field over the generic field, from the budget `(scale, z, u, v)` for these pencils
and an auxiliary polynomial of exponent `n` and flag `(0, β, γ)`. -/
theorem point_budget (P : Packet x t y r) (SZ : Source P.F) : H2Lev.PointBudgetStatement P SZ :=
  point_budget_of_parts P SZ (counted P SZ) (curve_h2 P) (unit_bound P SZ)

end ProximityPrize.SubmissionLower.FormalR.H2Bud
end
