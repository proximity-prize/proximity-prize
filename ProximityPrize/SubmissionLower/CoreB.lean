section

/-!
The Euler cap for `H = ∂F/∂R` on the carrier, and the first-cut flags it gives.

* `euler_value_le`: at a valuation, on a zero of `F`, a polynomial with exponents in the flag
  `⟨z, v, r⟩`, the value of `∂F/∂R` is bounded by the flag `⟨z, v + 1, r - 2⟩`.
* `carrier_H_pole_le`: the same for `polyH` at a place of a prime that contains the carrier.
* `cuspFlagE`, `capFlagE`, `hfreeFlagDirE`: `HFreeDir6813.cuspFlag`, `capFlag`, `hfreeFlagDir`
  with `⟨z, v + 1, r - 2⟩` in the place of `⟨z, v, r - 1⟩`; `cuspE_add_capE`, `capFlagE_pole_le` are the two
  facts the pole mass uses about them.
* `eulerFirst`: the first-cut flags `HFreeDir6813.ASY` with `hfreeFlagDirE`; `eulerFirst_eq`: its
  closed form for `5 ≤ r`, `2 ≤ y - r`; `eulerFirst_eq_ASY`: it is `ASY` of the cell `(t, y, r - 1)`;
  `eulerFirst_cumulative_le`, `flagMixed_eulerFirst_le`: it lies below `ASY` of the cell `(t, y, r)` in the
  three cumulative coordinates, so every mixed degree with it is at most the one with `ASY`.
-/

namespace ProximityPrize.SubmissionLower.FormalR.Euler

section Lemma
open scoped WithZero
open MvPolynomial
open RCN095 RCN204

variable {K : Type} {L : Type*} [Field K] [Field L]

theorem euler_inFlag (z v r : ℕ) (F : MvPolynomial (Fin 3) K) (hF : BI ⟨z, v, r⟩ F) :
    BI ⟨z, v + 1, r - 1⟩ (C (r : K) * F - MvPolynomial.X 1 * pderiv 1 F) := by
  intro d hd
  rw [MvPolynomial.mem_support_iff, coeff_sub, coeff_C_mul, coeff_X_mul_pderiv, ← sub_mul] at hd
  have hne : d 1 ≠ r := fun h => hd (by rw [h, sub_self, zero_mul])
  obtain ⟨h1, h2, h3⟩ := hF d (MvPolynomial.mem_support_iff.mpr (right_ne_zero_of_mul hd))
  dsimp only at h1 h2 h3
  refine ⟨?_, ?_, ?_⟩ <;> dsimp only <;> omega

theorem pderiv_R_inFlag (z v r : ℕ) (F : MvPolynomial (Fin 3) K) (hF : BI ⟨z, v, r⟩ F) :
    BI ⟨z, v, r - 1⟩ (pderiv 1 F) := by
  intro d hd
  rw [MvPolynomial.mem_support_iff, coeff_pderiv_succ] at hd
  obtain ⟨h1, h2, h3⟩ := hF _ (MvPolynomial.mem_support_iff.mpr (right_ne_zero_of_mul hd))
  simp only [Finsupp.add_apply, Finsupp.single_apply, Fin.isValue, ↓reduceIte, add_zero,
    show ((1 : Fin 3) = 0) = False from by decide, show ((1 : Fin 3) = 2) = False from by decide]
    at h1 h2 h3
  refine ⟨?_, ?_, ?_⟩ <;> dsimp only <;> omega

/-- On a zero of `F`, the pole of `∂F/∂R` is bounded by the flag `⟨z, v + 1, r - 2⟩`: where the
pole of `R` exceeds those of `Y` and `Z`, `R * ∂F/∂R = -(r * F - R * ∂F/∂R)` on `F = 0`, and the bracket has
`R`-degree below `r`. -/
theorem euler_value_le (V : Valuation L (WithZero (Multiplicative ℤ))) (coeff : K →+* L)
    (hcoeff : ∀ a, V (coeff a) ≤ 1) (x : Fin 3 → L) (z v r : ℕ) (hr : 2 ≤ r)
    (F : MvPolynomial (Fin 3) K) (hF : BI ⟨z, v, r⟩ F)
    (h0 : MvPolynomial.eval₂Hom coeff x F = 0) :
    V (MvPolynomial.eval₂Hom coeff x (pderiv 1 F)) ≤ WithZero.exp (flagPole V x ⟨z, v + 1, r - 2⟩) := by
  have hr1 : ((r - 1 : ℕ) : ℤ) = (r : ℤ) - 1 := by omega
  have hr2 : ((r - 2 : ℕ) : ℤ) = (r : ℤ) - 2 := by omega
  by_cases hcase : RCN187.poleOrder V (x 1) ≤
      max (RCN187.poleOrder V (x 0)) (RCN187.poleOrder V (x 2))
  · refine (ADJ V coeff hcoeff x ⟨z, v, r - 1⟩ _ (pderiv_R_inFlag z v r F hF)).trans ?_
    rw [WithZero.exp_le_exp]
    simp only [flagPole, max_eq_right hcase, hr1, hr2]
    push_cast
    linarith
  · rw [not_le] at hcase
    have hbeta : 0 ≤ max (RCN187.poleOrder V (x 0)) (RCN187.poleOrder V (x 2)) :=
      le_max_of_le_left (le_max_left _ _)
    have hx1ne : V (x 1) ≠ 0 := by
      intro hz
      have : RCN187.poleOrder V (x 1) = 0 := by simp [RCN187.poleOrder, hz]
      omega
    have hx1 : V (x 1) = WithZero.exp (RCN187.poleOrder V (x 1)) := by
      rw [← WithZero.exp_log hx1ne]
      congr 1
      have : RCN187.poleOrder V (x 1) = max 0 (V (x 1)).log := rfl
      omega
    have hE := ADJ V coeff hcoeff x ⟨z, v + 1, r - 1⟩ _ (euler_inFlag z v r F hF)
    have heval : MvPolynomial.eval₂Hom coeff x (C (r : K) * F - MvPolynomial.X 1 * pderiv 1 F) =
        -(x 1 * MvPolynomial.eval₂Hom coeff x (pderiv 1 F)) := by
      rw [map_sub, map_mul, map_mul, h0, mul_zero, zero_sub, eval₂Hom_X']
    rw [heval, Valuation.map_neg, map_mul, hx1] at hE
    have hmul := mul_le_mul_right hE (WithZero.exp (-RCN187.poleOrder V (x 1)))
    rw [← mul_assoc, ← WithZero.exp_add, neg_add_cancel, WithZero.exp_zero, one_mul,
      ← WithZero.exp_add] at hmul
    refine hmul.trans ?_
    rw [WithZero.exp_le_exp]
    simp only [flagPole, max_eq_left hcase.le, hr1, hr2]
    push_cast
    linarith

end Lemma

section Carrier
open RCN057 (WeightBound)
open RCN204 (flagPole)
open RCN026 (Place)
open RCN002 RCN055 RCN095 RCN136 RCN156 RCN208 RCN234 RCN313 RCN341

variable {K E : Type} [Field K] [Field E]

/-- `euler_value_le` for `polyH` at a place of a prime that contains the carrier. -/
theorem carrier_H_pole_le (phi : Polynomial K →+* E) (F : MvPolynomial (Fin 4) K)
    (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (r v z : ℕ) (hr : 2 ≤ r)
    (hR : WeightBound BE F (r : ℤ))
    (hYR : WeightBound BC F ((r + v : ℕ) : ℤ))
    (hAll : WeightBound AT F ((r + v + z : ℕ) : ℤ))
    (hF : surfaceMap phi F ∈ C) (nu : Place E (AJ E C)) :
    RCN346.poleOrder E (AJ E C) nu (CT.GP phi C (polyH K F)) ≤
      flagPole nu.val (coordinate E C) ⟨z, v + 1, r - 2⟩ := by
  have hflag : BI ⟨z, v, r⟩ (surfaceMap phi F) := by
    apply JE.AOL
    · exact hR
    · convert hYR using 2
      dsimp only
      omega
    · convert hAll using 2
      dsimp only
      omega
  have hzero : MvPolynomial.eval₂Hom (algebraMap E (AJ E C)) (coordinate E C)
      (surfaceMap phi F) = 0 := by
    rw [JE.coordinate_eval₂]
    exact (CT.AAE C _).mpr hF
  have h := euler_value_le nu.val (algebraMap E (AJ E C)) (RCN344.NP E (AJ E C) nu)
    (coordinate E C) z v r hr (surfaceMap phi F) hflag hzero
  rw [RCN267.ZO] at h
  apply VI.BIH nu.val _ _ (RCN204.ALZ _ _ _)
  simpa only [CT.GP, HJ, MvPolynomial.aeval_eq_eval₂Hom, RingHom.comp_apply,
    AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, polyH] using h

end Carrier

section Flags
open RCN095
open RCN204 (flagPole)
open HFreeDir6813 (ASY hfreeFlagDir cuspFlag flag_eq_iff)
local notation "w" => RCN326.w

/-- `HFreeDir6813.cuspFlag` with the Euler cap: `2 • ⟨z, v + 1, r - 2⟩` minus the cap at
infinity. -/
def cuspFlagE (d : Fin 3) (r v z : ℕ) : FlagDegree :=
  ![⟨2 * z, 2 * v + 2 - 3 - (9 - 2 * r), 2 * r - 9⟩, ⟨2 * z, 2 * v + 2 - (9 - 2 * r), 2 * r - 9⟩,
    ⟨2 * z, 2 * v + 2 - 3, 2 * r - 6⟩] d

def capFlagE (d : Fin 3) (r : ℕ) : FlagDegree :=
  ![⟨0, 3 + (9 - 2 * r), 5 - (9 - 2 * r)⟩, ⟨0, 9 - 2 * r, 5 - (9 - 2 * r)⟩, ⟨0, 3, 2⟩] d

theorem cuspE_add_capE (d : Fin 3) (r v z : ℕ) (hr : 3 ≤ r) (hv : 2 ≤ v) :
    cuspFlagE d r v z + capFlagE d r = 2 • (⟨z, v + 1, r - 2⟩ : FlagDegree) := by
  rw [flag_eq_iff]
  fin_cases d <;> simp [cuspFlagE, capFlagE] <;> omega

theorem capFlagE_pole_le {L : Type*} [Field L] (V : Valuation L (WithZero (Multiplicative ℤ)))
    (x : Fin 3 → L) (d : Fin 3) (r : ℕ) (hr : 3 ≤ r) :
    flagPole V x (capFlagE d r) ≤ flagPole V x (HFree6812.infCap d) := by
  have h1 : 0 ≤ RCN187.poleOrder V (x 0) := le_max_left _ _
  have h2 := le_max_right (RCN187.poleOrder V (x 1))
    (max (RCN187.poleOrder V (x 0)) (RCN187.poleOrder V (x 2)))
  have h3 := le_max_left (RCN187.poleOrder V (x 0)) (RCN187.poleOrder V (x 2))
  rcases (show r = 3 ∨ r = 4 ∨ 9 - 2 * r = 0 by omega) with rfl | rfl | h0
  · fin_cases d <;> simp [flagPole, capFlagE, HFree6812.infCap] <;> omega
  · fin_cases d <;> simp [flagPole, capFlagE, HFree6812.infCap] <;> omega
  · fin_cases d <;> simp [flagPole, capFlagE, HFree6812.infCap, h0]

def hfreeFlagDirE (d : Fin 3) (r v z : ℕ) (C0 : FlagDegree) : FlagDegree :=
  (w + 1) • cuspFlagE d r v z + 3 • C0

/-- The flag with the Euler cap lies below `hfreeFlagDir` in the three cumulative coordinates. -/
theorem hfreeFlagDirE_cumulative_le (d : Fin 3) (r v z : ℕ) (C0 : FlagDegree) (hr : 3 ≤ r)
    (hv : 2 ≤ v) :
    (hfreeFlagDirE d r v z C0).all ≤ (hfreeFlagDir d r v z C0).all ∧
    (hfreeFlagDirE d r v z C0).yz + (hfreeFlagDirE d r v z C0).all ≤
      (hfreeFlagDir d r v z C0).yz + (hfreeFlagDir d r v z C0).all ∧
    (hfreeFlagDirE d r v z C0).zOnly + (hfreeFlagDirE d r v z C0).yz +
        (hfreeFlagDirE d r v z C0).all ≤
      (hfreeFlagDir d r v z C0).zOnly + (hfreeFlagDir d r v z C0).yz +
        (hfreeFlagDir d r v z C0).all := by
  fin_cases d <;> simp [hfreeFlagDirE, hfreeFlagDir, cuspFlagE, cuspFlag, RCN326.w] <;> omega

/-- The first-cut flags with the Euler cap: `HFreeDir6813.ASY` with `hfreeFlagDirE`. -/
def eulerFirst (t y r : ℕ) (j : Fin 3) : FlagDegree :=
  hfreeFlagDirE j r (y - r) (t - y) unitAllFlag

/-- `eulerFirst` without truncated subtraction: `(w + 1) • (2 • ⟨z, v + 1, r - 2⟩ - infCap j) + 3 • e₂`
with `z = t - y`, `v = y - r`. -/
theorem eulerFirst_eq (t y r : ℕ) (j : Fin 3) (hr : 5 ≤ r) (hv : 2 ≤ y - r) :
    eulerFirst t y r j =
      (w + 1) • (![⟨2 * (t - y), 2 * (y - r) - 1, 2 * r - 9⟩, ⟨2 * (t - y), 2 * (y - r) + 2, 2 * r - 9⟩,
        ⟨2 * (t - y), 2 * (y - r) - 1, 2 * r - 6⟩] j : FlagDegree) + 3 • unitAllFlag := by
  rw [flag_eq_iff]
  fin_cases j <;> simp [eulerFirst, hfreeFlagDirE, cuspFlagE] <;> omega

/-- The Euler first-cut flags of the cell `(t, y, r)` are the first-cut flags `ASY` of the cell
`(t, y, r - 1)`: `⟨z, v + 1, r - 2⟩` is the cell flag of `H` there. -/
theorem eulerFirst_eq_ASY (t y r : ℕ) (j : Fin 3) (hr : 1 ≤ r) (hy : r ≤ y) :
    eulerFirst t y r j = ASY t y (r - 1) j := by
  rw [flag_eq_iff]
  fin_cases j <;> simp [eulerFirst, ASY, hfreeFlagDirE, hfreeFlagDir, cuspFlagE, cuspFlag] <;> omega

theorem eulerFirst_cumulative_le (t y r : ℕ) (j : Fin 3) (hr : 3 ≤ r) (hv : 2 ≤ y - r) :
    (eulerFirst t y r j).all ≤ (ASY t y r j).all ∧
    (eulerFirst t y r j).yz + (eulerFirst t y r j).all ≤ (ASY t y r j).yz + (ASY t y r j).all ∧
    (eulerFirst t y r j).zOnly + (eulerFirst t y r j).yz + (eulerFirst t y r j).all ≤
      (ASY t y r j).zOnly + (ASY t y r j).yz + (ASY t y r j).all :=
  hfreeFlagDirE_cumulative_le j r (y - r) (t - y) unitAllFlag hr hv

/-- Every mixed degree with `eulerFirst` is at most the one with `ASY`: the first-cut term of
the price with the Euler cap is at most the one without. -/
theorem flagMixed_eulerFirst_le (t y r : ℕ) (j : Fin 3) (hr : 3 ≤ r) (hv : 2 ≤ y - r)
    (p q : FlagDegree) :
    flagMixed p (eulerFirst t y r j) q ≤ flagMixed p (ASY t y r j) q := by
  obtain ⟨hs, hm, ht⟩ := eulerFirst_cumulative_le t y r j hr hv
  have h := RCN084.TO (fun _ : Unit => eulerFirst t y r j) (ASY t y r j) p q
    (by simpa using hs) (by simpa using hm) (by simpa using ht)
  have e (a : FlagDegree) : flagMixed p a q = flagMixed a p q := by
    unfold flagMixed
    ring
  simpa [e] using h

end Flags

end ProximityPrize.SubmissionLower.FormalR.Euler
end
section

/-!
`first_pole_massE`: `AHX.DJW` (the pole mass of the first numerator on a slice curve from a
moving budget) with the Euler flag `hfreeFlagDirE` in the place of `HFreeDir6813.hfreeFlagDir`. It has one
hypothesis more than `AHX.DJW`: `hF`, the prime contains the carrier (`carrier_H_pole_le` holds on the
carrier).
-/

set_option linter.all false

namespace ProximityPrize.SubmissionLower.FormalR.Euler

section Mass
noncomputable section
open scoped Classical BigOperators WithZero
open RCN057 (WeightBound)
open RCN204 (flagPole)
open RCN026 (Place)
open RCN002 RCN005 RCN006 RCN007 RCN055 RCN074 RCN086 RCN095 RCN134 RCN135 RCN136
open RCN156 RCN208 RCN234 RCN244 RCN248 RCN313 RCN341
open VI HFreeDir6813
local notation "w" =>RCN326.w

variable {K E:Type} [Field K] [Field E] [IsAlgClosed E]

theorem first_pole_massE
    (phi:Polynomial K→+*E) (F:MvPolynomial (Fin 4) K)
    (C:Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime]
    (base:BP C)
    (hF:surfaceMap phi F∈C) (hH:surfaceMap phi (polyH K F)∉C)
    (d:Fin 3) (r v z:ℕ) (hr:3≤r) (hv:2≤v)
    (hR:WeightBound BE F (r:ℤ))
    (hYR:WeightBound BC F ((r+v:ℕ):ℤ))
    (hAll:WeightBound AT F ((r+v+z:ℕ):ℤ))
    (C0:FlagDegree) (hbudget:APH phi F C C0 (HFree6812.infCap d))
    (scale CX CV:ℕ)
    (hXbudget: ∀W:Finset (Place E (AJ E C)),
      (∑ nu∈W,flagPole nu.val (coordinate E C) (hfreeFlagDirE d r v z C0))≤(CX:ℤ))
    (hMoving: ∀W:Finset (Place E (AJ E C)),
      (scale:ℤ)*(∑ nu∈W,RCN064.KS C (surfaceMap phi (polyH K F))
        (surfaceMap phi (polyG K F)) nu)≤(CV:ℤ))
    (W:Finset (Place E (AJ E C))):
    ((3*scale:ℕ):ℤ)*(∑ nu∈W,RCN187.poleOrder nu.val
      (CT.GP phi C (MN F (w-1))/
        CT.GP phi C (polyH K F)^(2*w-1)))≤
      (scale:ℤ)*(CX:ℤ)+((4*(w+1):ℕ):ℤ)*(CV:ℤ):=by
  letI:=IP E C base.index
  letI:=DT E C base.index base.transcendental
  letI:=IU E C base.index
  letI:=_Q5 E C base.index base.transcendental
  letI:=IS E C base.index base.transcendental
  letI:FiniteDimensional (RatFunc E) (AJ E C):=base.finite
  letI:Algebra.IsSeparable (RatFunc E) (AJ E C):=base.separable
  let L:=AJ E C
  let ev:=CT.GP phi C
  let H:=ev (polyH K F)
  let sigma:=ev (polyG K F)/H
  let theta:=fun nu:Place E L=>
    max (2*flagPole nu.val (coordinate E C) unitAllFlag)
      (flagPole nu.val (coordinate E C) unitYZFlag+RCN187.poleOrder nu.val sigma)
  let Hf:FlagDegree:=⟨z,v+1,r-2⟩
  have hHne:H ≠ 0:=by
    intro hz
    apply hH
    exact (CT.AAE C _).mp hz
  let Pl:=RCN026.placesFor E L H hHne
  set W' :=W ∪ Pl with hW'
  have hsource:(scale:ℤ)*(∑ nu ∈ W',theta nu)≤(CV:ℤ):=by
    have hh:=hMoving W'
    simpa only [theta,sigma,H,ev,RCN064.KS,RCN204.BPD,
      RCN204.CWP,CT.GP,RCN064.movingRatio,
      RingHom.comp_apply,AlgHom.toRingHom_eq_coe,AlgHom.coe_toRingHom] using hh
  have htarget:(∑ nu ∈ W',RCN064.KS C (surfaceMap phi (polyH K F))
      (surfaceMap phi (polyG K F)) nu)= ∑ nu ∈ W',theta nu:=by
    apply Finset.sum_congr rfl
    intro nu _
    simp only [theta,RCN204.BPD,RCN204.CWP]
    rfl

  have hpoleH (nu:Place E L):
      RCN346.poleOrder E L nu H≤flagPole nu.val (coordinate E C) Hf:=
    carrier_H_pole_le phi F C r v z (by omega) hR hYR hAll hF nu
  have hzero:(∑ nu ∈ W',RCN026.zeroOrder E L nu H)≤
      ∑ nu ∈ W',flagPole nu.val (coordinate E C) Hf:=by
    have hout: ∀nu ∈ W'.filter (fun nu=>nu ∉ Pl),RCN026.zeroOrder E L nu H=0:=by
      intro nu hnu
      have hno:RCN026.order E L nu H=0:=by
        by_contra hne
        exact (Finset.mem_filter.mp hnu).2 (RCN026.ALB E L H hHne nu hne)
      simp only [RCN026.zeroOrder,hno,max_self]
    calc
      _=(∑ nu ∈ W'.filter (fun nu=>nu ∈ Pl),RCN026.zeroOrder E L nu H)+
          ∑ nu ∈ W'.filter (fun nu=>nu ∉ Pl),RCN026.zeroOrder E L nu H:=
        (Finset.sum_filter_add_sum_filter_not W' _ _).symm
      _= ∑ nu ∈ W'.filter (fun nu=>nu ∈ Pl),RCN026.zeroOrder E L nu H:=by
        rw [Finset.sum_eq_zero hout,add_zero]
      _≤ ∑ nu ∈ Pl,RCN026.zeroOrder E L nu H:=
        Finset.sum_le_sum_of_subset_of_nonneg
          (fun nu hnu=>(Finset.mem_filter.mp hnu).2)
          (fun nu _ _=>RCN026.AUU E L nu H)
      _= ∑ nu ∈ Pl,RCN346.poleOrder E L nu H:=RCN026.AJO E L H hHne
      _≤ ∑ nu ∈ Pl,flagPole nu.val (coordinate E C) Hf:=Finset.sum_le_sum (fun nu _=>hpoleH nu)
      _≤_:=Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_right
          (fun nu _ _=>RCN204.ALZ nu.val (coordinate E C) Hf)

  have hcusp:2*(∑ nu ∈ W',flagPole nu.val (coordinate E C) Hf)≤
      (∑ nu ∈ W',flagPole nu.val (coordinate E C) (cuspFlagE d r v z))+
        ∑ nu ∈ W',flagPole nu.val (coordinate E C) (HFree6812.infCap d):=by
    rw [Finset.mul_sum,← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun nu _=> ?_
    have e1:=congrArg (flagPole nu.val (coordinate E C)) (cuspE_add_capE d r v z hr hv)
    rw [RCN204.flagPole_add,RCN204.DZP] at e1
    have e2:=capFlagE_pole_le nu.val (coordinate E C) d r hr
    push_cast at e1
    linarith
  have hX:=hXbudget W'
  simp only [hfreeFlagDirE,RCN204.flagPole_add,RCN204.DZP,Finset.sum_add_distrib,
    ← Finset.mul_sum] at hX
  have hb:=hbudget.pole_le W'
  simp only [Finset.sum_add_distrib,Finset.sum_sub_distrib,← Finset.mul_sum] at hb
  rw [htarget] at hb
  have hWW:(∑ nu ∈ W,RCN187.poleOrder nu.val
      (CT.GP phi C (MN F (w-1))/
        CT.GP phi C (polyH K F)^(2*w-1)))≤
      ∑ nu ∈ W',RCN187.poleOrder nu.val
      (CT.GP phi C (MN F (w-1))/
        CT.GP phi C (polyH K F)^(2*w-1)):=
    Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_left
      (fun nu _ _=>le_max_left _ _)
  push_cast at hb hsource hX ⊢
  have hk:(0:ℤ)≤(scale:ℤ):=by positivity
  have hw:(0:ℤ)≤(w:ℤ)+1:=by positivity
  have e0:=mul_le_mul_of_nonneg_left (show
    2*(∑ nu ∈ W',RCN026.zeroOrder E L nu H)≤
      (∑ nu ∈ W',flagPole nu.val (coordinate E C) (cuspFlagE d r v z))+
        ∑ nu ∈ W',flagPole nu.val (coordinate E C) (HFree6812.infCap d) by linarith) hw
  have hb' :3*(∑ nu ∈ W',RCN187.poleOrder nu.val
      (CT.GP phi C (MN F (w-1))/
        CT.GP phi C (polyH K F)^(2*w-1)))≤
      4*((w:ℤ)+1)*(∑ nu ∈ W',theta nu)+(CX:ℤ):=by
    nlinarith
  have e1:=mul_le_mul_of_nonneg_left hb' hk
  have e2:=mul_le_mul_of_nonneg_left hsource (mul_nonneg (by norm_num:(0:ℤ)≤4) hw)
  have e3:=mul_le_mul_of_nonneg_left hWW (mul_nonneg (by norm_num:(0:ℤ)≤3) hk)
  nlinarith

end
end Mass

end ProximityPrize.SubmissionLower.FormalR.Euler
