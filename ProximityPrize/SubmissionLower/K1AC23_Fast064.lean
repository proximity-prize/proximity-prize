private theorem chart_boundary_has_coefficient {C₀ : ConstantSeeds} [Fact (Irreducible C₀)] {J g n}
    {R : PrimitiveRoot C₀ J g} (A : CoefficientChart R n)
    (b : Fin n → L) (hb : b ∈ zeroLocus L (boundaryIdeal (coefficientIdeal A)))
