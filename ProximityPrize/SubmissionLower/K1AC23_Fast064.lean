  let E := ConstantSeedField C₀
  let : Algebra.EssFiniteType L E :=
    Eq.mp (congrArg (fun alg => @Algebra.EssFiniteType L (ConstantSeedField C₀) _ _ alg)
      halgebra) hstandard
