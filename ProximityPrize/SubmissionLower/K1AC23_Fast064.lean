  obtain ⟨j, k, h⟩ := coefficient_representation A i
  by_cases hj : j < A.equation.natDegree + 1
  · by_cases hk : k < xBound A.equation
    · exact Or.inr ⟨(⟨j, hj⟩, ⟨k, hk⟩), h⟩
