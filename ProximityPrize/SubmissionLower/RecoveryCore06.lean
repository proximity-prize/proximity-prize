  rw [map_multiset_prod] at hp
  obtain ⟨f,hf,hfzero⟩:=Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp hp)
  have hfi:Irreducible f:=irreducible_of_normalized_factor f hf
  have hfg:=dvd_of_mem_normalizedFactors hf
