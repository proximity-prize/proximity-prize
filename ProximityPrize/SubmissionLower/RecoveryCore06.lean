include hgate in
theorem DHE (axis:Axis) (a:A)
    (W:Finset (Place Ω (AJ Ω (P a)))):
    (∑ v∈W,CE v.val (coordinate Ω (P a)) (flagSupport axis.flag))≤
      (frameCost D hz axis a:ℤ):=by
