variable (component:A→AU Ω G T H) (hinj:Function.Injective component)
variable (lam mu nu:Ω) (order:Fin 3 ≃ Fin 3)
variable (ht: ∀a,Transcendental Ω
  (BQ Ω (component a).1 lam mu nu (MvPolynomial.X (order 0))))
variable (hfinite: ∀a,
  letI:=IV Ω (component a).1 lam mu nu order (ht a)
  FiniteDimensional (RatFunc Ω) (AJ Ω (component a).1))
variable (hgen: ∀a,
  letI:=IV Ω (component a).1 lam mu nu order (ht a)
  IntermediateField.adjoin (RatFunc Ω)
    ({BQ Ω (component a).1 lam mu nu (MvPolynomial.X (order 2)),
      BQ Ω (component a).1 lam mu nu (MvPolynomial.X (order 1))}:
