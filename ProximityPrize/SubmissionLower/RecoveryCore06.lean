      cleared (P.map f) n (f h) (t-f q):=by
  change (Polynomial.eval₂RingHom f t) (PH P n h q)=_
  have hc:(Polynomial.eval₂RingHom f t).comp Polynomial.C=f:=by
    apply RingHom.ext
    intro a
    simp
  rw [PH,map_cleared,Polynomial.map_map]
  rw [hc]
  simp

