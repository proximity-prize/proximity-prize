  refine ⟨?_⟩
  intro r N hN hproper points hpointsP hpointsN
  have hpole: ∀W:Finset (Place Ω (AJ Ω (P a))),
      (∑ v∈W,CE v.val (coordinate Ω (P a)) (flagSupport r))≤
        (BET D hz a r:ℤ):=by
