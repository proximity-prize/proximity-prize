theorem frame_trans (D:GammaFrame P surface)
    (hz: ∀a,Transcendental Ω (coordinate Ω (P a) 2)) (axis:Axis) (a:A):
    Transcendental Ω (BQ Ω (P a) D.lam D.mu (D.mu*D.lam)
      (MvPolynomial.X (axis.order 0))):=by
  cases axis with
  | z=>simpa [Axis.order,zOrder] using hz a
  | u=>simpa [Axis.order,uOrder] using D.ZG a
  | v=>simpa [Axis.order,vOrder] using D.CVM a

theorem frame_gate (D:GammaFrame P surface)
    (hz: ∀a,Transcendental Ω (coordinate Ω (P a) 2))
    (hgate: ∀a,
      (letI:=(BO Ω (AJ Ω (P a)) (coordinate Ω (P a) 2)
        (hz a)).toRingHom.toAlgebra;
        FiniteDimensional (RatFunc Ω) (AJ Ω (P a)))∧
      (letI:=(BO Ω (AJ Ω (P a)) (coordinate Ω (P a) 2)
        (hz a)).toRingHom.toAlgebra;
        Algebra.IsSeparable (RatFunc Ω) (AJ Ω (P a))))
    (axis:Axis) (a:A)
    (ht:Transcendental Ω (BQ Ω (P a) D.lam D.mu (D.mu*D.lam)
      (MvPolynomial.X (axis.order 0)))):
    (letI:=(BO Ω (AJ Ω (P a))
      (BQ Ω (P a) D.lam D.mu (D.mu*D.lam) (MvPolynomial.X (axis.order 0)))
      ht).toRingHom.toAlgebra;
      FiniteDimensional (RatFunc Ω) (AJ Ω (P a)))∧
    (letI:=(BO Ω (AJ Ω (P a))
      (BQ Ω (P a) D.lam D.mu (D.mu*D.lam) (MvPolynomial.X (axis.order 0)))
      ht).toRingHom.toAlgebra;
      Algebra.IsSeparable (RatFunc Ω) (AJ Ω (P a))):=by
  cases axis with
  | z=>
    have he:=HL ht (hz a) (by simp [Axis.order,zOrder])
    rw [he]
    exact hgate a
  | u=>
    have he:=HL ht (D.ZG a) (by simp [Axis.order,uOrder])
    rw [he]
    exact ⟨D.uFinite a,D.uSeparable a⟩
  | v=>
    have he:=HL ht (D.CVM a) (by simp [Axis.order,vOrder])
    rw [he]
    exact ⟨D.vFinite a,D.vSeparable a⟩

def frameCost (D:GammaFrame P surface)
    (hz: ∀a,Transcendental Ω (coordinate Ω (P a) 2)) (axis:Axis) (a:A):ℕ:=
  letI:=(BO Ω (AJ Ω (P a))
    (BQ Ω (P a) D.lam D.mu (D.mu*D.lam) (MvPolynomial.X (axis.order 0)))
    (frame_trans D hz axis a)).toRingHom.toAlgebra
  Module.finrank (RatFunc Ω) (AJ Ω (P a))
end General

open RCN135 RCN136 RCN074 RCN086 RCN244 RCN245 RCN249 RCN313
