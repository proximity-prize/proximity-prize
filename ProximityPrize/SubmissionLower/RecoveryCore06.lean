    (BQ Ω (P a) D.lam D.mu (D.mu*D.lam) (MvPolynomial.X (axis.order 0)))
    (frame_gate D hz hgate axis a)
  have he:DQ Ω (AJ Ω (P a)) projection=frameCost D hz axis a:=
    LO _ _ (frame_trans D hz axis a)
  have hp (v:Place Ω (AJ Ω (P a))):
      CE v.val (coordinate Ω (P a)) (flagSupport axis.flag)=
        RCN346.poleOrder Ω (AJ Ω (P a)) v
          (FT Ω (AJ Ω (P a)) projection):=by
    dsimp only [projection]
    rw [MT]
    change _=RCN187.poleOrder v.val _
