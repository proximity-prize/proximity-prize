section MergedPart3
namespace BHB
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 700000
open scoped BigOperators Classical
open RCN002 RCN022 RCN032 RCN037 RCN042 RCN046 RCN093 RCN095 RCN116 RCN264 RCN338 RCN341 RCN344
open JS BJX ALP
open ANV
variable {Ω:Type} [Field Ω] [IsAlgClosed Ω]
local instance:DecidableEq Ω:=Classical.decEq Ω
variable {G H A M B C:MvPolynomial (Fin 3) Ω}

def EJC
    (base: ∀V:AU Ω G M (H*A),BP V.1)
    (hY: ∀V:AU Ω G M (H*A),GR V 0)
    (hZ: ∀V:AU Ω G M (H*A),GR V 2)
    (hderiv:MvPolynomial.pderiv (1:Fin 3) G≠0)
    (D:AOH base hY hZ hderiv)
    (hG:G≠0) (hB:B≠0) (hC:C≠0) (hcop:IsRelPrime B C)
    (d:ℕ) (hd:0<d) (thick:HasThickness G H A M B C d)
    (p q:FlagDegree) (hp:RCN095.BI p B) (hq:RCN095.BI q C):
    let unit:=BKX base hY hZ hderiv D B C hB hC hcop
      (fun V=>(thick.mem_regular hd V).1) (fun V=>(thick.mem_regular hd V).2) p q hp hq
    EY unit.toFE (fun _=>d):=by
  let x (axis:Axis) (V:AU Ω G M (H*A)):=
    BQ Ω V.1 D.lam D.mu (D.mu*D.lam) (MvPolynomial.X (axis.order 0))
  have gate (axis:Axis) (V:AU Ω G M (H*A)) (ht:Transcendental Ω (x axis V)):
      (letI:=(BO Ω (AJ Ω V.1) (x axis V) ht).toRingHom.toAlgebra;
        FiniteDimensional (RatFunc Ω) (AJ Ω V.1))∧
      (letI:=(BO Ω (AJ Ω V.1) (x axis V) ht).toRingHom.toAlgebra;
        Algebra.IsSeparable (RatFunc Ω) (AJ Ω V.1)):=by
    cases axis with
    | z=>
      have hz:Transcendental Ω (coordinate Ω V.1 2):=by simpa [x,Axis.order,RCN125.zOrder] using ht
      have he:=HL ht hz (by simp [x,Axis.order,RCN125.zOrder])
      rw [he]
      exact hZ V hz
    | u=>
      have hu:Transcendental Ω (affineU Ω V.1 D.lam):=by simpa [x,Axis.order,RCN125.uOrder] using ht
      have he:=HL ht hu (by simp [x,Axis.order,RCN125.uOrder])
      rw [he]
      exact D.uGate V hu
    | v=>
      have he:=HL ht (D.GN V) (by simp [x,Axis.order,RCN125.vOrder])
      rw [he]
      exact ⟨D.allFinite V,D.allSeparable V⟩
  have hsum (axis:Axis):
      (∑ V:AU Ω G M (H*A),d*DQ Ω (AJ Ω V.1)
        (JV (x axis V) (gate axis V)))≤flagMixed p q axis.flag:=by
    rw [BGX
      (fun V:AU Ω G M (H*A)=>AJ Ω V.1)
      (x axis) (gate axis) (fun _=>d)]
    have hh:=ECO G H A M B C hG hB hC hcop d hd thick
      (fun V:{V:AU Ω G M (H*A)//Transcendental Ω (x axis V)}=>V.1)
      Subtype.val_injective axis D.lam D.mu (D.mu*D.lam) (fun V=>V.2)
      (fun V=>gate axis V.1) p q hp hq
    simpa only [Finset.mul_sum] using hh
  exact {z:=hsum .z,yz:=hsum .u,all:=hsum .v}

theorem EAU
    (G H A M B C:MvPolynomial (Fin 3) Ω)
    (hG:G≠0) (hB:B≠0) (hC:C≠0) (hcop:IsRelPrime B C)
    (d:ℕ) (hd:0<d) (thick:HasThickness G H A M B C d)
    (p q:FlagDegree) (hp:RCN095.BI p B) (hq:RCN095.BI q C)
    (c:ℕ) [CharP Ω c]
    (hZsmall:flagMixed p q unitZFlag<c) (hYsmall:flagMixed p q unitYZFlag<c)
    (hderiv:MvPolynomial.pderiv (1:Fin 3) G≠0):
    ∃base: ∀V:AU Ω G M (H*A),BP V.1,
      ∃unit:EE base p q,
        Nonempty (EY unit.toFE (fun _=>d)):=by
  have mems (V:AU Ω G M (H*A)):=thick.mem_regular hd V
  have hY (V:AU Ω G M (H*A)):GR V 0:=by
    intro ht
    have ht' :Transcendental Ω (BQ Ω V.1 0 0 0 (MvPolynomial.X (Axis.u.order 0))):=by
      simpa [Axis.order,RCN125.uOrder,affineU] using ht
    have he:=HL ht' ht (by simp [Axis.order,RCN125.uOrder,affineU])
    have hh:=CNW V.1 .u 0 0 0 ht' B C hB hC hcop
      (mems V).1 (mems V).2 p q hp hq c hYsmall
    rw [he] at hh
    exact hh
  have hZ (V:AU Ω G M (H*A)):GR V 2:=by
    intro ht
    have ht' :Transcendental Ω (BQ Ω V.1 0 0 0 (MvPolynomial.X (Axis.z.order 0))):=by
      simpa [Axis.order,RCN125.zOrder] using ht
    have he:=HL ht' ht (by simp [Axis.order,RCN125.zOrder])
