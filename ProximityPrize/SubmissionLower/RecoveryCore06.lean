          (r.yz:ℤ)*(∑ v∈W,CE v.val (coordinate Ω (P a)) (flagSupport unitYZFlag))+
          (r.all:ℤ)*(∑ v∈W,CE v.val (coordinate Ω (P a)) (flagSupport unitAllFlag)):=by
        simp only [Finset.sum_add_distrib,Finset.mul_sum]
