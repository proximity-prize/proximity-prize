  have s:=(MvPolynomial.monomial_le_degreeOf 1 he).trans hS
  have u:=(le_weightedTotalDegree HA he).trans hu
  simp [JW,codeWeights,totalWeights,slopeWeights,HA] at c t b u
  apply AKF
