      _≤∑ v∈W,((r.zOnly:ℤ)*CE v.val (coordinate Ω (P a)) (flagSupport unitZFlag)+
          (r.yz:ℤ)*CE v.val (coordinate Ω (P a)) (flagSupport unitYZFlag)+
          (r.all:ℤ)*CE v.val (coordinate Ω (P a)) (flagSupport unitAllFlag)):=
        Finset.sum_le_sum (fun v _=>AEI v.val (coordinate Ω (P a)) r)
