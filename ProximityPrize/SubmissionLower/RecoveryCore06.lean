  have hQmem:Q ∈ (Ideal.span ({g}:Set B)).under A:=Ideal.mem_span_singleton.mpr hgQ
  rw [he] at hQmem
  exact hfi.not_isUnit (hrel ((Multiset.dvd_prod hf).trans hprod.dvd) (Ideal.mem_span_singleton.mp hQmem))

