theorem EOB (p:SourceCaps) (a:OwnerBox) (k n0 gap:ℕ)
    (P J Q:Poly (K:=K)) (hJ:J ≠ 0) (hQ:Q ≠ 0)
    (heq:P=J^a.q*Q) (hP:Bounds p P) (ha:Covers a J)
