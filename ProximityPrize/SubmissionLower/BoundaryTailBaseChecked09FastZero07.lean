theorem zero_r9_part96 : ∀ i ∈ List.range 1, ZeroCheckAt 9 (96+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 9 96 := by decide +kernel
  exact zeroAtFast_sound 9 96 hfast

