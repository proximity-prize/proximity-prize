theorem s390CoreGridSound (h : PrefixCoreChecks) :
    CoreGridSound s390PrefixCore := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro p hp
    rcases hp with ⟨hr, hr27, hrv, _⟩
    simpa [s390PrefixCore, rawFlag] using
