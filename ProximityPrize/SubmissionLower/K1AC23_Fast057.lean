      rw [map_sub, ← RingHom.comp_apply, hout, sub_eq_zero]
      change right (j (a x)) = out (scalar s)
      simpa only [out, evaluate_scalar, hx, ev, coe_eval₂RingHom, eval₂_X] using hpoly Polynomial.X
