      rw [extend_scalar, scalar_eq_algebraMap, mk.commutes]
    · change fromA (beta Polynomial.X) = algebraMap G S (ev Polynomial.X)
      rw [hx, hfromA, show ev Polynomial.X = s from eval₂_X _ _]
      have hle : Ideal.span {extendScalars f x - scalar s} ≤ cutIdeal f I x s := le_sup_right
      have hz : mk (extendScalars f x - scalar s) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hle (Ideal.mem_span_singleton_self _))
