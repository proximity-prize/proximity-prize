      algebraMap (Four k ⧸ I) E (offsetMap I x p)) :
    Module.finrank G (Four G ⧸ cutIdeal f I x s) = Module.finrank F E := by
  let A := Four k ⧸ I
  let a : Four k →+* A := Ideal.Quotient.mk I
  let beta : k[X] →+* A := offsetMap I x
  let ev : k[X] →+* G := eval₂RingHom f s
  let j : A →+* E := algebraMap A E
