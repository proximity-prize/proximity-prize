  have hAB : A ≤ B := by
    intro f hf
    exact RingHom.mem_ker.mpr ((markEval_seed z S f).symm.trans
      (RingHom.mem_ker.mp (hm hf)))
  by_contra hne
  have hD : 1 ≤ D.height := Order.one_le_iff_ne_zero.mpr
    (Ideal.height_eq_zero_iff_eq_bot.not.mpr
      (fun h => hp.ne_zero (Ideal.span_singleton_eq_bot.mp h)))
  have hA2 : 2 ≤ A.height :=
    (show (2 : ℕ∞) = 1 + 1 by decide) ▸
      (add_le_add_left hD 1).trans
        (Ideal.height_add_one_le_of_lt_of_isPrime (lt_of_le_of_ne hDA (Ne.symm hA)))
  have hB3 : 3 ≤ B.height :=
    (show (3 : ℕ∞) = 2 + 1 by decide) ▸
      (add_le_add_left hA2 1).trans
        (Ideal.height_add_one_le_of_lt_of_isPrime (lt_of_le_of_ne hAB hne))
  have hdim : ringKrullDim Seeds = 2 := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field]
