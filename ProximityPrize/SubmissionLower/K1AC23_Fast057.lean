    filter_upwards [Filter.eventually_ge_atTop N₀] with N hN
    have h := (affineHilbertFunction_comap_bidegreeMap_le J a b N).trans
      ((finrank_box_le_baseChange (E := FurtherField) J (a * N) (b * N)).trans (hlin N hN))
