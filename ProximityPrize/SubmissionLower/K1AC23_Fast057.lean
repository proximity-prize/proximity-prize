    · exact Ideal.mem_map_of_mem C

private theorem trdeg_quotient_localization {k R T : Type} [Field k]
    [CommRing R] [CommRing T] [Algebra R T] [Algebra k R] [Algebra k T]
    [IsScalarTower k R T] (M : Submonoid R) [IsLocalization M T]
    (P : Ideal R) [P.IsPrime] (hd : Disjoint (M : Set R) (P : Set R)) :
    Algebra.trdeg k (T ⧸ P.map (algebraMap R T)) = Algebra.trdeg k (R ⧸ P) := by
  let S := R ⧸ P
  let I := P.map (algebraMap R T)
  let A := T ⧸ I
  let N := Algebra.algebraMapSubmonoid S M
  let : IsLocalization N A := inferInstance
  let : I.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint M T P inferInstance hd
  let : IsDomain A := Ideal.Quotient.isDomain I
  let : Algebra.IsAlgebraic S A := IsLocalization.isAlgebraic A N
  have hN : N ≤ S⁰ := by
    rintro _ ⟨x, hx, rfl⟩
    exact mem_nonZeroDivisors_iff_ne_zero.mpr
      (fun e => Set.disjoint_left.mp hd hx (Ideal.Quotient.eq_zero_iff_mem.mp e))
