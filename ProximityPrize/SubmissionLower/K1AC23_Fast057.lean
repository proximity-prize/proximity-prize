private theorem poleOrder_mono {F K : Type} [Field F] [Field K] [Algebra F K]
    (w : Place F K) {a b : K} (h : w.val a ≤ w.val b) : poleOrder w a ≤ poleOrder w b := by
  by_cases ha : w.val a = 0
