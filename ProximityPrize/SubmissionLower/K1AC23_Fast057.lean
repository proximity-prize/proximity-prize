  let ins : Over →ₐ[SectionField] SectionJet := MvPolynomial.aeval (fun i => i.elim v t)
  have h : eliminate.comp ins = AlgHom.id _ _ := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i <;> simp [ins]
  intro f
  exact ⟨ins f, DFunLike.congr_fun h f⟩

private theorem eliminate_kernel : RingHom.ker eliminate.toRingHom = Ideal.span {lineEquation .jet} := by
  let I : Ideal SectionJet := Ideal.span {lineEquation .jet}
  let q := Ideal.Quotient.mkₐ SectionField I
  have hline : q y = algebraMap SectionField (SectionJet ⧸ I) offset -
      algebraMap SectionField (SectionJet ⧸ I) slope * q v := by
    have h : q (lineEquation .jet) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    change q (y + algebraMap SectionField SectionJet slope * v -
      algebraMap SectionField SectionJet offset) = 0 at h
    simp only [map_sub, map_add, map_mul, AlgHom.commutes, sub_eq_zero] at h
    exact eq_sub_of_add_eq h
  let recover : Over →ₐ[SectionField] (SectionJet ⧸ I) :=
    MvPolynomial.aeval (fun i => i.elim (q v) (fun j => q (t j)))
  have hrecover : recover.comp eliminate = q := by
    apply AlgHom.coe_ringHom_injective
    apply Polynomial.ringHom_ext'
    · apply Polynomial.ringHom_ext'
      · apply MvPolynomial.ringHom_ext
        · intro c
          exact ((recover.comp eliminate).commutes c).trans (q.commutes c).symm
        · intro i
          change recover (eliminate (t i)) = q (t i)
          simp [recover]
      · change recover (eliminate y) = q y
        simp [recover, hline]
    · change recover (eliminate v) = q v
      simp [recover]
  apply le_antisymm
  · intro f hf
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q f = 0
    rw [← DFunLike.congr_fun hrecover f]
    change recover (eliminate f) = 0
    rw [show eliminate f = 0 from hf, map_zero]
  · apply Ideal.span_le.mpr
    intro f hf
    obtain rfl := Set.mem_singleton_iff.mp hf
    change eliminate (y + algebraMap SectionField SectionJet slope * v -
      algebraMap SectionField SectionJet offset) = 0
    simp only [map_sub, map_add, map_mul, eliminate_y, eliminate_v, AlgHom.commutes,
      MvPolynomial.algebraMap_eq]
    ring

private theorem eliminate_sectionMap :
    eliminate.toRingHom.comp sectionMap =
      (MvPolynomial.map (algebraMap JetLineField SectionField)).comp rowOnLine := by
  apply Polynomial.ringHom_ext'
  · apply Polynomial.ringHom_ext'
    · apply MvPolynomial.ringHom_ext
      · intro c
        simp [eliminate, sectionMap, rowOnLine, seedOnLine, RingHom.comp_apply]
      · intro i
        simp [eliminate, sectionMap, rowOnLine, seedOnLine, RingHom.comp_apply]
    · simp [sectionMap, rowOnLine, yOnLine, jetIndex, RingHom.comp_apply]
  · simp [sectionMap, rowOnLine, RingHom.comp_apply]

private def eliminateQuotient (I : Ideal Jet) :
    LineSection I .jet ≃ₐ[SectionField]
      (Over ⧸ (I.map rowOnLine).map (MvPolynomial.map (algebraMap JetLineField SectionField))) := by
  let J := (I.map rowOnLine).map (MvPolynomial.map (algebraMap JetLineField SectionField))
  let f := (Ideal.Quotient.mkₐ SectionField J).comp eliminate
  have hker : RingHom.ker f = I.map sectionMap ⊔ Ideal.span {lineEquation .jet} := by
    change Ideal.comap eliminate.toRingHom (RingHom.ker (Ideal.Quotient.mk J)) = _
    rw [Ideal.mk_ker]
    have hJ : (I.map sectionMap).map eliminate.toRingHom = J := by
      rw [Ideal.map_map, eliminate_sectionMap, ← Ideal.map_map]
    rw [← hJ, Ideal.comap_map_of_surjective eliminate.toRingHom eliminate_surjective,
      ← RingHom.ker_eq_comap_bot, eliminate_kernel]
  exact (Ideal.quotientEquivAlgOfEq SectionField hker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (Ideal.Quotient.mk_surjective.comp eliminate_surjective : Function.Surjective f))

/-- Elimination of the jet equation and coefficient extension preserve the full quotient. -/
theorem lineSection_length (I : Ideal Jet)
    [Module.Finite JetLineField (CurveAmbient ⧸ I.map rowOnLine)] :
    Module.Finite SectionField (LineSection I .jet) ∧
      lineLength I .jet = Module.finrank JetLineField (CurveAmbient ⧸ I.map rowOnLine) := by
  let e := eliminateQuotient I
  obtain ⟨hfin, hlen⟩ := quotientBaseChange_length (E := SectionField) (I.map rowOnLine)
  let _ := hfin
  exact ⟨Module.Finite.of_surjective e.symm.toLinearMap e.symm.surjective,
    e.toLinearEquiv.finrank_eq.trans hlen⟩

end

