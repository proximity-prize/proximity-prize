    (hq : Parent q) (hP : P ∉ q.asIdeal) (hR : cutIdeal q P ≤ R) :
    seedIdeal R ≠ ⊥ := by
  obtain ⟨y, v, he, _, _⟩ := hq.seed_side
  let e := seedFibreEval y v
  change RingHom.ker e = q.asIdeal at he
  let Q := Jet ⧸ q.asIdeal
  let mk : Jet →+* Q := Ideal.Quotient.mk q.asIdeal
  let : Algebra Seeds Q := (mk.comp seedInclusion).toAlgebra
  let hker : ∀ a : Jet, a ∈ q.asIdeal → e a = 0 :=
    fun a ha => RingHom.mem_ker.mp (he.symm ▸ ha)
  let φ : Q →ₐ[Seeds] SeedClosure :=
    { Ideal.Quotient.lift q.asIdeal e hker with
      commutes' := fun a => by
        change e (seedInclusion a) = seedGeneric a
        simp [e, seedFibreEval, seedInclusion] }
  have hφ : Function.Injective φ :=
    RingHom.lift_injective_of_ker_le_ideal q.asIdeal hker he.le
  have hAlg : IsAlgebraic Seeds (mk P) :=
    (isAlgebraic_algHom_iff φ hφ).mp
      ((IsFractionRing.isAlgebraic_iff Seeds SeedField SeedClosure).mpr
        (Algebra.IsAlgebraic.isAlgebraic (φ (mk P))))
  let : q.asIdeal.IsPrime := q.isPrime
  have hP' : mk P ≠ 0 := fun h => hP (Ideal.Quotient.eq_zero_iff_mem.mp h)
  have hPR : P ∈ R := hR (Ideal.mem_sup_right (Ideal.mem_span_singleton_self P))
  have hqR : q.asIdeal ≤ R := le_sup_left.trans hR
  have hn := Ideal.under_ne_bot_of_algebraic_mem (I := R.map mk) hP'
    (Ideal.mem_map_of_mem mk hPR) hAlg
  change (R.map mk).comap (mk.comp seedInclusion) ≠ ⊥ at hn
  rw [← Ideal.comap_comap, Ideal.comap_map_of_surjective mk Ideal.Quotient.mk_surjective,
    show Ideal.comap mk ⊥ = q.asIdeal from Ideal.mk_ker, sup_eq_left.mpr hqR] at hn
  exact hn

