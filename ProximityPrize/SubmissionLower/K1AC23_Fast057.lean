    · simp [hc]
    · exact (w.trivial _ hc).le
  have hTpoly (p : k[X]) (hp : p ≠ 0) : w.val (p.eval₂ ι t) = 1 := by
    let j : Polynomial k →+* K :=
      (algebraMap F K).comp (algebraMap (Polynomial k) F)
