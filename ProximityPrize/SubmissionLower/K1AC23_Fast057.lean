private def reesAlg {k : Type} [Field k] (I : Ideal (MvPolynomial Coordinates k)) :
    HomAmbient k →ₐ[k] AddMonoidAlgebra (MvPolynomial Coordinates k ⧸ I) (ℕ × ℕ) where
  __ := reesMap I
  commutes' c := by
    change reesMap I (MvPolynomial.C c) =
      AddMonoidAlgebra.single 0 (Ideal.Quotient.mk I (MvPolynomial.C c))
    exact reesMap_C I c

set_option maxHeartbeats 800000 in
/-- Flat base change preserves the kernel of the bidegree-tagged evaluation. -/
private theorem rees_kernel_map {k E : Type} [Field k] [Field E] [Algebra k E]
    (I : Ideal (MvPolynomial Coordinates k)) :
    (RingHom.ker (reesMap I)).map (MvPolynomial.map (algebraMap k E)) =
      RingHom.ker (reesMap (I.map (MvPolynomial.map (algebraMap k E)))) := by
  have : Module.Free k E := Module.Free.of_divisionRing k E
  have : Module.Flat k E := Module.Flat.of_free
  let m : HomAmbient k →+* HomAmbient E := MvPolynomial.map (algebraMap k E)
  let I' : Ideal (MvPolynomial Coordinates E) := I.map (MvPolynomial.map (algebraMap k E))
  let A := MvPolynomial Coordinates k ⧸ I
  let B := MvPolynomial Coordinates E ⧸ I'
  let M := ℕ × ℕ
  let ec : E ⊗[k] A ≃ₐ[E] B := quotientBaseChange I
  let j : A →+* B :=
    ec.toRingEquiv.toRingHom.comp
      (Algebra.TensorProduct.includeRight (A := E) (R := k)).toRingHom
  have hj (p : MvPolynomial Coordinates k) :
      j (Ideal.Quotient.mk I p) = Ideal.Quotient.mk I' (MvPolynomial.map (algebraMap k E) p) := by
    change ec (1 ⊗ₜ[k] Ideal.Quotient.mk I p) = _
    simpa only [one_smul] using (quotientBaseChange_tmul I (1 : E) p)
  have hgen : (AddMonoidAlgebra.mapRingHom (M := M) j).comp (reesMap I) =
      (reesMap I').comp m := by
    apply MvPolynomial.ringHom_ext
    · intro c
      change AddMonoidAlgebra.mapRingHom M j (reesMap I (MvPolynomial.C c)) =
        reesMap I' (MvPolynomial.map (algebraMap k E) (MvPolynomial.C c))
      rw [reesMap_C I c, AddMonoidAlgebra.mapRingHom_single, hj]
      simp only [MvPolynomial.map_C, reesMap_C]
    · intro v
      have hd : MvPolynomial.map (algebraMap k E) (dehom (MvPolynomial.X v)) =
          dehom (MvPolynomial.X v : HomAmbient E) := by
        cases v <;> simp [dehom]
      change AddMonoidAlgebra.mapRingHom M j (reesMap I (MvPolynomial.X v)) =
        reesMap I' (MvPolynomial.map (algebraMap k E) (MvPolynomial.X v))
      rw [reesMap_X I v, AddMonoidAlgebra.mapRingHom_single]
      simp only [dehomClass, RingHom.comp_apply, hj, hd, MvPolynomial.map_X, reesMap_X]
  let es : E ⊗[k] HomAmbient k ≃ₐ[E] HomAmbient E :=
    MvPolynomial.algebraTensorAlgEquiv k E
  have hes_tmul (a : E) (p : HomAmbient k) : es (a ⊗ₜ[k] p) = a • m p :=
    MvPolynomial.algebraTensorAlgEquiv_tmul k E a p
  let et : E ⊗[k] AddMonoidAlgebra A M ≃ₐ[E] AddMonoidAlgebra B M :=
    (AddMonoidAlgebra.rTensorEquivAlgEquiv k E E A).trans (AddMonoidAlgebra.mapAlgEquiv E M ec)
  have het (a : E) (p : AddMonoidAlgebra A M) :
      et (a ⊗ₜ[k] p) = a • AddMonoidAlgebra.mapRingHom (M := M) j p := by
    dsimp only [et]
    rw [AlgEquiv.trans_apply, AddMonoidAlgebra.rTensorEquiv_tmulAlgEquiv, map_smul]
    refine congrArg (a • ·) ?_
    change AddMonoidAlgebra.mapAlgHom M ec.toAlgHom
        (AddMonoidAlgebra.mapAlgHom M (Algebra.TensorProduct.includeRight (A := E)) p) =
      AddMonoidAlgebra.mapRingHom M j p
    ext d
    simp only [AddMonoidAlgebra.coeff_mapAlgHom, AddMonoidAlgebra.coeff_mapRingHom,
      j, RingHom.comp_apply]
    rfl
  let tf := Algebra.TensorProduct.map (AlgHom.id k E) (reesAlg I)
  have hcomp : (reesMap I').comp es.toAlgHom.toRingHom =
      et.toAlgHom.toRingHom.comp tf.toRingHom := by
    apply RingHom.ext
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul a p =>
        change reesAlg I' (es (a ⊗ₜ[k] p)) = et (a ⊗ₜ[k] reesMap I p)
        rw [hes_tmul, map_smul, het]
        exact congrArg (a • ·) (RingHom.congr_fun hgen p).symm
    | add x y hx hy =>
        rw [map_add, map_add, hx, hy]
  let ir : HomAmbient k →+* E ⊗[k] HomAmbient k :=
    (Algebra.TensorProduct.includeRight (A := E) (R := k)).toRingHom
  have hker : (RingHom.ker (reesMap I')).comap es.toAlgHom.toRingHom =
      (RingHom.ker (reesMap I)).map ir := by
    rw [RingHom.comap_ker, hcomp]
    change RingHom.ker (et.toRingEquiv.toRingHom.comp tf.toRingHom) = _
