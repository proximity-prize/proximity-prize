set_option autoImplicit true
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 8
set_option maxHeartbeats 1000000

namespace K1A_14_3R_3_1_2_1

noncomputable section

open K1A_14_3R_3_1_2 MvPolynomial
open scoped TensorProduct nonZeroDivisors

attribute [local instance] Polynomial.algebra
attribute [local instance] MvPolynomial.algebraMvPolynomial Algebra.TensorProduct.rightAlgebra

section

variable (k A : Type) [Field k] [CommRing A] [Algebra k A]

abbrev RationalTensor := Rats k ⊗[k] A

theorem domain_of_tensor [IsDomain (RationalTensor k A)] : IsDomain A :=
  (Algebra.TensorProduct.includeRight_injective (A := Rats k) (B := A)
    (algebraMap k (Rats k)).injective).isDomain
    (Algebra.TensorProduct.includeRight : A →ₐ[k] RationalTensor k A)

local instance rationalParameters : Algebra (Params k) (Rats k) := paramAlgebra k k

local instance rationalParameterSMul : SMul (Params k) (Rats k) :=
  (rationalParameters k).toSMul

local instance constantsTower : IsScalarTower k (Params k) (Rats k) :=
  IsScalarTower.of_algebraMap_eq fun x => by
    change constants k x = algebraMap (Params k) (Rats k) (MvPolynomial.C x)
    rw [param_C, Algebra.algebraMap_self, RingHom.id_apply]

private def polynomialToTensor : Params A →+* RationalTensor k A :=
  MvPolynomial.eval₂Hom Algebra.TensorProduct.includeRight.toRingHom
    (fun i => algebraMap (Rats k) (RationalTensor k A)
      (algebraMap (Params k) (Rats k) (MvPolynomial.X i)))

local instance tensorAlgebra : Algebra (Params A) (RationalTensor k A) :=
  (polynomialToTensor k A).toAlgebra

private theorem tensor_C (a : A) :
    algebraMap (Params A) (RationalTensor k A) (MvPolynomial.C a) = 1 ⊗ₜ[k] a := by
  change polynomialToTensor k A (MvPolynomial.C a) = _
  rw [polynomialToTensor, MvPolynomial.eval₂Hom_C]
  rfl

private theorem tensor_polynomial (p : Params k) :
    algebraMap (Params A) (RationalTensor k A) (algebraMap (Params k) (Params A) p) =
      algebraMap (Rats k) (RationalTensor k A) (algebraMap (Params k) (Rats k) p) := by
  have h : (polynomialToTensor k A).comp (MvPolynomial.map (algebraMap k A)) =
      (algebraMap (Rats k) (RationalTensor k A)).comp (algebraMap (Params k) (Rats k)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply, MvPolynomial.map_C]
      rw [show polynomialToTensor k A (MvPolynomial.C (algebraMap k A r)) =
        algebraMap A (RationalTensor k A) (algebraMap k A r) from tensor_C k A _]
      rw [← IsScalarTower.algebraMap_apply k A (RationalTensor k A),
        ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply k (Params k) (Rats k),
        ← IsScalarTower.algebraMap_apply k (Rats k) (RationalTensor k A)]
    · intro i
      simp [polynomialToTensor, RingHom.comp_apply]
  exact RingHom.congr_fun h p

private theorem tensorLocalization :
    IsLocalization (Algebra.algebraMapSubmonoid (Params A) (Params k)⁰) (RationalTensor k A) := by
  let : IsFractionRing (Params k) (Rats k) := paramFraction k k
  let : Algebra (Params k) (RationalTensor k A) :=
    Algebra.compHom _ (algebraMap (Params k) (Rats k))
  let : SMul (Params k) (RationalTensor k A) := Algebra.toSMul
  let : IsScalarTower (Params k) (Rats k) (RationalTensor k A) :=
    IsScalarTower.of_algebraMap_eq' rfl
  let : IsScalarTower (Params k) (Params A) (RationalTensor k A) :=
    IsScalarTower.of_algebraMap_eq fun p => (tensor_polynomial k A p).symm
  let : IsScalarTower A (Params A) (RationalTensor k A) :=
    IsScalarTower.of_algebraMap_eq fun a => (tensor_C k A a).symm
  let : IsScalarTower k (Params A) (RationalTensor k A) :=
    IsScalarTower.of_algebraMap_eq fun r => by
      change algebraMap k (RationalTensor k A) r =
        algebraMap (Params A) (RationalTensor k A) (MvPolynomial.C (algebraMap k A r))
      rw [tensor_C]
      exact IsScalarTower.algebraMap_apply k A (RationalTensor k A) r
  apply (Algebra.isLocalization_iff_isPushout (Params k)⁰ (Rats k)).mpr
  apply Algebra.IsPushout.symm
  exact (Algebra.IsPushout.comp_iff k (Params k) A (S' := Params A)).mp
    (inferInstance : Algebra.IsPushout k (Rats k) A (RationalTensor k A))

variable [IsDomain A] [IsDomain (RationalTensor k A)]

/-- The fraction field of the scalar extension, with its two embeddings. -/
structure TensorModel where
  equiv : FractionRing (RationalTensor k A) ≃+* Rats (FractionRing A)
  left : ∀ x : Rats k, equiv (algebraMap (RationalTensor k A) _ (algebraMap (Rats k) _ x)) =
    rationalMap (rationalMap (algebraMap k (FractionRing A))) x
  right : ∀ a : A, equiv (algebraMap (RationalTensor k A) _ (1 ⊗ₜ[k] a)) =
    constants (FractionRing A) (algebraMap A (FractionRing A) a)

/-- Adjoining two independent rational constants commutes with taking fractions. -/
def tensorModel : TensorModel k A := by
  let S := Params k
  let D := RationalTensor k A
  let P := Params A
  let F := FractionRing A
  let T := Rats F
  let M := Algebra.algebraMapSubmonoid P S⁰
  let : IsFractionRing S (Rats k) := paramFraction k k
  let aPT : Algebra P T := paramAlgebra A F
  let : Algebra P T := aPT
  let : SMul P T := aPT.toSMul
  let : IsFractionRing P T := paramFraction A F
  let : IsLocalization M D := tensorLocalization k A
  have hM : M ≤ P⁰ := by
    rintro _ ⟨p, hp, rfl⟩
    rw [mem_nonZeroDivisors_iff_ne_zero]
    exact (map_ne_zero_iff _ (MvPolynomial.map_injective _ (algebraMap k A).injective)).2
      (mem_nonZeroDivisors_iff_ne_zero.mp hp)
  let : Algebra D T := IsLocalization.localizationAlgebraOfSubmonoidLe D T M P⁰ hM
  let : IsScalarTower P D T :=
    IsLocalization.localization_isScalarTower_of_submonoid_le D T M P⁰ hM
  let : IsFractionRing D T := IsFractionRing.isFractionRing_of_isLocalization M D T hM
  let e : FractionRing D ≃ₐ[D] T := IsLocalization.algEquiv D⁰ _ _
  refine ⟨e.toRingEquiv, ?_, ?_⟩
  · have h : (algebraMap D T).comp (algebraMap (Rats k) D) =
        rationalMap (rationalMap (algebraMap k F)) := by
      apply IsFractionRing.ringHom_ext (A := S)
      have hp : ((algebraMap D T).comp (algebraMap (Rats k) D)).comp
            (algebraMap S (Rats k)) =
          (rationalMap (rationalMap (algebraMap k F))).comp (algebraMap S (Rats k)) := by
        have hcomp : ((algebraMap D T).comp (algebraMap (Rats k) D)).comp
            (algebraMap S (Rats k)) = (algebraMap P T).comp (algebraMap S P) := by
          apply RingHom.ext
          intro p
          change algebraMap D T (algebraMap (Rats k) D (algebraMap S (Rats k) p)) =
            algebraMap P T (algebraMap S P p)
          rw [← tensor_polynomial k A, ← IsScalarTower.algebraMap_apply]
        rw [hcomp]
        apply MvPolynomial.ringHom_ext
        · intro r
          change algebraMap P T (MvPolynomial.map (algebraMap k A) (MvPolynomial.C r)) =
            rationalMap (rationalMap (algebraMap k F)) (algebraMap S (Rats k) (MvPolynomial.C r))
          rw [MvPolynomial.map_C, param_C A F, param_C k k, Algebra.algebraMap_self,
            RingHom.id_apply, ← IsScalarTower.algebraMap_apply k A F]
          simp only [constants, RingHom.comp_apply, rationalMap_constant]
        · intro i
          change algebraMap P T (MvPolynomial.map (algebraMap k A) (MvPolynomial.X i)) =
            rationalMap (rationalMap (algebraMap k F)) (algebraMap S (Rats k) (MvPolynomial.X i))
          rw [MvPolynomial.map_X]
          fin_cases i
          · change algebraMap P T (MvPolynomial.X 0) =
              rationalMap (rationalMap (algebraMap k F)) (algebraMap S (Rats k) (MvPolynomial.X 0))
            rw [param_X_zero A F, param_X_zero k k, rationalMap_variable]
          · change algebraMap P T (MvPolynomial.X 1) =
              rationalMap (rationalMap (algebraMap k F)) (algebraMap S (Rats k) (MvPolynomial.X 1))
            rw [param_X_one A F, param_X_one k k, rationalMap_constant, rationalMap_variable]
      exact RingHom.congr_fun hp
    intro x
    exact (e.commutes _).trans (RingHom.congr_fun h x)
  · intro a
    change e (algebraMap D (FractionRing D) (1 ⊗ₜ[k] a)) = _
    rw [e.commutes, ← tensor_C k A, ← IsScalarTower.algebraMap_apply]
    exact param_C A F a

end
end
