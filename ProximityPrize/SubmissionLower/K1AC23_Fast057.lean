attribute [local instance] Polynomial.algebra

theorem polynomial_fraction (A F : Type) [CommRing A] [IsDomain A] [Field F]
    [Algebra A F] [IsFractionRing A F] : IsFractionRing (Polynomial A) (RatFunc F) := by
  let M := (nonZeroDivisors A).map (C : A →+* Polynomial A).toMonoidHom
  let : IsLocalization M (Polynomial F) := Polynomial.isLocalization (nonZeroDivisors A) F
  have h := IsLocalization.localization_localization_isLocalization_of_has_all_units
    M (nonZeroDivisors (Polynomial F)) (RatFunc F) (fun _ hx => hx.mem_nonZeroDivisors)
  have he :
      (nonZeroDivisors (Polynomial F)).comap (algebraMap (Polynomial A) (Polynomial F)) =
        nonZeroDivisors (Polynomial A) := by
    ext x
    change algebraMap (Polynomial A) (Polynomial F) x ∈ nonZeroDivisors (Polynomial F) ↔
      x ∈ nonZeroDivisors (Polynomial A)
    rw [mem_nonZeroDivisors_iff_ne_zero, mem_nonZeroDivisors_iff_ne_zero]
    exact not_congr (map_eq_zero_iff _ (Polynomial.map_injective _ (IsFractionRing.injective A F)))
  rw [he] at h
  exact h

/-- Measure the mixed offset fibre after adjoining the slope as a free variable. -/
theorem slope_finrank (k A : Type) [Field k] [CommRing A] [IsDomain A] [Algebra k A]
    (y v : A) :
    pencilLength k A y v = jetPencilDegree k (toFunction y) (toFunction v) := by
  unfold pencilLength offsetLength
  let F := FractionRing A
  let S := SlopeRing k A
  let f := Polynomial.mapRingHom (algebraMap k A)
  let M := denominators f
  have hM : M ≤ nonZeroDivisors (Polynomial A) :=
    Submonoid.map_le_iff_le_comap.mpr
      (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective f
        (Polynomial.map_injective _ (algebraMap k A).injective))
  let : IsFractionRing (Polynomial A) (RatFunc F) := polynomial_fraction A F
  let : Algebra S (RatFunc F) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe S (RatFunc F)
      M (nonZeroDivisors (Polynomial A)) hM
  let : IsScalarTower (Polynomial A) S (RatFunc F) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le S (RatFunc F)
      M (nonZeroDivisors (Polynomial A)) hM
  let : IsFractionRing S (RatFunc F) :=
    IsFractionRing.isFractionRing_of_isLocalization M S (RatFunc F) hM
  let := pencilAlgebra k (F := F)
  let : IsScalarTower (RatFunc k) S (RatFunc F) := IsScalarTower.of_algebraMap_eq' (by
    apply IsFractionRing.ringHom_ext (A := Polynomial k)
    intro p
    change rationalMap (algebraMap k F) (algebraMap (Polynomial k) (RatFunc k) p) =
      algebraMap S (RatFunc F) (algebraMap (FractionRing (Polynomial k)) S
        ((RatFunc.toFractionRingRingEquiv k) (algebraMap (Polynomial k) (RatFunc k) p)))
    rw [show (RatFunc.toFractionRingRingEquiv k) (algebraMap (Polynomial k) (RatFunc k) p) =
        algebraMap (Polynomial k) (FractionRing (Polynomial k)) p from
      (RatFunc.toFractionRingAlgEquiv k (Polynomial k)).commutes p]
    rw [local_base f p, ← IsScalarTower.algebraMap_apply (Polynomial A) S (RatFunc F),
      rationalMap_poly, IsScalarTower.algebraMap_apply (Polynomial A) (Polynomial F) (RatFunc F)]
    congr 1
    change p.map (algebraMap k F) = (p.map (algebraMap k A)).map (algebraMap A F)
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq k A F])
  rw [offset_finrank_in (RatFunc k) (F := RatFunc F)]
  have hp : algebraMap S (RatFunc F) (slopePencil k A y v) =
      algebraMap F (RatFunc F) (toFunction y) + RatFunc.X *
        algebraMap F (RatFunc F) (toFunction v) := by
    change algebraMap S (RatFunc F)
        (algebraMap (Polynomial A) S (C y + (Polynomial.X : Polynomial A) * C v)) = _
    rw [← IsScalarTower.algebraMap_apply (Polynomial A) S (RatFunc F),
      IsScalarTower.algebraMap_apply (Polynomial A) (Polynomial F) (RatFunc F)]
    change algebraMap (Polynomial F) (RatFunc F)
      (Polynomial.mapRingHom (algebraMap A F) (C y + (Polynomial.X : Polynomial A) * C v)) = _
    simp only [map_add, map_mul, Polynomial.coe_mapRingHom, Polynomial.map_C, Polynomial.map_X,
      RatFunc.algebraMap_X, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C, toFunction]
    rfl
  rw [hp, jetPencilDegree]

end
