/-- The rectangular boundary presentation commutes with the coefficient extension. -/
def c1 : Prop :=
  ∀ (I : Ideal CurveAmbient) (seed : Bool),
    extendHom (boundaryIdeal I seed) = boundaryIdeal (extendedIdeal I) seed

/-- The kernel of the generic seed form is torsion on each seed chart. -/
def c2 : Prop :=
  ∀ (J : Ideal (HomAmbient JetLineField)) (v : HomVariables), (homWeight v).2 = 1 →
    ∀ z : HomAmbient FurtherField, homCut * z ∈ extendHom J →
      ∃ n : ℕ, MvPolynomial.X v ^ n * z ∈ extendHom J

private theorem homCut_weight : homCut.IsWeightedHomogeneous homWeight (0, 1) := by
  unfold homCut
  exact ((isWeightedHomogeneous_X FurtherField homWeight (Sum.inr (some 0))).add
    ((isWeightedHomogeneous_X FurtherField homWeight (Sum.inr (some 1))).C_mul _)).sub
    ((isWeightedHomogeneous_X FurtherField homWeight (homogenizer true)).C_mul _)

private theorem dehom_homCut : dehom homCut = seedCut := by
  simp [homCut, seedCut]

private theorem box_mono {I : Ideal CurveAmbient} {x : FurtherAmbient ⧸ extendedIdeal I}
    {a b a' b' : ℕ} (ha : a ≤ a') (hb : b ≤ b') (hx : x ∈ box I a b) :
    x ∈ box I a' b' := by
  obtain ⟨p, hp, rfl⟩ := mem_quotientBidegreeLE.mp hx
  exact mem_quotientBidegreeLE.mpr ⟨p, mem_restrictBidegree_mono hp ha hb, rfl⟩

private theorem boundary_step (I : Ideal CurveAmbient) (seed : Bool) (a b : ℕ)
    (hmap : c1) (hreg : ∀ z : HomAmbient FurtherField,
      z.IsWeightedHomogeneous homWeight (homWeight (homogenizer seed) + (a, b)) →
      homCut * z ∈ extendHom (boundaryIdeal I seed) → z ∈ extendHom (boundaryIdeal I seed))
    {x : FurtherAmbient ⧸ extendedIdeal I}
    (hx : x ∈ box I (homWeight (homogenizer seed) + (a, b)).1
      (homWeight (homogenizer seed) + (a, b)).2)
    (hmul : Ideal.Quotient.mk (extendedIdeal I) seedCut * x ∈ box I a (b + 1)) :
    x ∈ box I a b := by
  obtain ⟨z, hz, he⟩ := lift_box hx
  have hc := homCut_weight.mul hz
  have hd : (0, 1) + (homWeight (homogenizer seed) + (a, b)) =
      homWeight (homogenizer seed) + (a, b + 1) := by
    cases seed <;> simp [homWeight, homogenizer, Nat.add_comm, Nat.add_left_comm]
  rw [hd] at hc
  have hq : dehomClass (extendedIdeal I) (homCut * z) ∈ box I a (b + 1) := by
    rw [map_mul, he]
    simpa only [dehomClass, RingHom.comp_apply, dehom_homCut] using hmul
  have hmem := (boundary_mem_iff (extendedIdeal I) seed (a, b + 1) hc).mpr hq
  rw [← hmap I seed] at hmem
  have hout := hreg z hz hmem
  rw [hmap I seed] at hout
  exact he ▸ (boundary_mem_iff (extendedIdeal I) seed (a, b) hz).mp hout

/-- Use filter-regularity on the two boundaries to remove excess box degrees. -/
theorem of_children (h1 : c1) (h2 : c2) : K1A_14_3R_3_2.c3 := by
  intro q _ _ _
  let I := curveIdeal q
  obtain ⟨Na, ha⟩ := eventual_injective_of_seed_torsion
    (extendHom (boundaryIdeal I false)) homCut (h2 (boundaryIdeal I false))
  obtain ⟨Nb, hb⟩ := eventual_injective_of_seed_torsion
    (extendHom (boundaryIdeal I true)) homCut (h2 (boundaryIdeal I true))
  refine ⟨max Na Nb, ?_⟩
  intro a b hNa hNb x hqx
  have hqx' : Ideal.Quotient.mk (extendedIdeal I) seedCut * x ∈ box I a (b + 1) := by
    simpa only [Nat.add_zero] using hqx
  have shrinkJet (r s : ℕ) (hx : x ∈ box I (a + r) (b + s)) :
      x ∈ box I a (b + s) := by
    induction r with
    | zero => exact hx
    | succ r ih =>
        apply ih
        apply boundary_step I false (a + r) (b + s) h1
        · exact ha _ _ (by simp [homWeight, homogenizer]; omega)
        · simpa only [homogenizer, homWeight, Prod.mk_add_mk, Nat.one_add, Nat.zero_add,
            Nat.succ_add, Nat.add_succ] using hx
        · exact box_mono (by omega) (by omega) hqx'
  have shrinkSeed (s : ℕ) (hx : x ∈ box I a (b + s)) : x ∈ box I a b := by
    induction s with
    | zero => exact hx
    | succ s ih =>
        apply ih
        apply boundary_step I true a (b + s) h1
        · exact hb _ _ (by simp [homWeight, homogenizer]; omega)
        · simpa only [homogenizer, homWeight, Prod.mk_add_mk, Nat.one_add, Nat.zero_add,
            Nat.succ_add, Nat.add_succ] using hx
        · exact box_mono le_rfl (by omega) hqx'
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (I := extendedIdeal I) x
  let r := p.support.sup (fun m => m none)
  let s := p.support.sup (fun m => m.some.degree)
  have hpbox : p ∈ restrictBidegree (Fin 2) FurtherField (a + r) (b + s) := by
    refine mem_restrictBidegree.mpr fun m hm => ⟨?_, ?_⟩
    · exact (Finset.le_sup (f := fun m => m none) hm).trans (Nat.le_add_left _ _)
    · exact (Finset.le_sup (f := fun m => m.some.degree) hm).trans (Nat.le_add_left _ _)
  exact shrinkSeed s (shrinkJet r s (mem_quotientBidegreeLE.mpr ⟨p, hpbox, hp⟩))

end

