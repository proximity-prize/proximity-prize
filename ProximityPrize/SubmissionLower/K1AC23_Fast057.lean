section PackSource_K1A_14_3R_3_2Hilbert
set_option autoImplicit true
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000

namespace K1A_14_3R_3_2

noncomputable section

open MvPolynomial
open scoped TensorProduct Polynomial

private theorem finrank_box_le_baseChange {k E : Type} [Field k] [Field E] [Algebra k E]
    (I : Ideal (MvPolynomial Coordinates k)) (a b : ℕ) :
    Module.finrank k (quotientBidegreeLE I a b) ≤
      Module.finrank E (quotientBidegreeLE (I.map (MvPolynomial.map (algebraMap k E))) a b) := by
  let T := quotientBidegreeLE I a b
  let m : MvPolynomial Coordinates k →+* MvPolynomial Coordinates E :=
    MvPolynomial.map (algebraMap k E)
  let J := I.map m
  let e := quotientBaseChange (E := E) I
  let f : E ⊗[k] T →ₗ[E] (MvPolynomial Coordinates E ⧸ J) :=
    e.toLinearMap.comp (TensorProduct.AlgebraTensorModule.lTensor E E T.subtype)
  have hf : Function.Injective f := e.injective.comp
    (Module.Flat.lTensor_preserves_injective_linearMap (M := E) T.subtype Subtype.val_injective)
  let B := quotientBidegreeLE J a b
  have hbox (z : E ⊗[k] T) : f z ∈ B := by
    induction z using TensorProduct.inductionOn with
    | tmul c x =>
        obtain ⟨p, hp, hp'⟩ := mem_quotientBidegreeLE.mp x.property
        have hm : m p ∈ restrictBidegree (Fin 2) E a b :=
          mem_restrictBidegree.mpr fun n hn =>
            mem_restrictBidegree.mp hp n (support_map_subset _ _ hn)
        change e (c ⊗ₜ[k] (x : MvPolynomial Coordinates k ⧸ I)) ∈ B
        rw [← hp']
        rw [show e (c ⊗ₜ[k] Ideal.Quotient.mk I p) = c • Ideal.Quotient.mk J (m p)
          from quotientBaseChange_tmul I c p]
        exact B.smul_mem c (mem_quotientBidegreeLE.mpr ⟨_, hm, rfl⟩)
    | add x y hx hy =>
        rw [map_add]
        exact B.add_mem hx hy
  rw [← Module.finrank_baseChange (R := E) (S := k) (M' := T)]
