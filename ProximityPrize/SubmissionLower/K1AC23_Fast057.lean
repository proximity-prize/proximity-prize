  refine ⟨fun hP n => ?_, fun hP n _ => hP n⟩
  by_cases hn : P.coeff n = 0
  · simp [hn]
  · exact hP n (Polynomial.mem_support_iff.mpr hn)

private theorem small_iff (h : GaussAt p q) (P : F[X]) :
