  let T := G ⊗[F] E
  let left : G →+* T := algebraMap G T
  let right : E →ₐ[F] T := Algebra.TensorProduct.includeRight
  let g : Four k →+* T := right.toRingHom.comp (j.comp a)
  let mk : Four G →ₐ[G] S := Ideal.Quotient.mkₐ G _
  let image : Four k →+* S := mk.toRingHom.comp (extendScalars f)
  have hpoly (p : k[X]) : right (j (beta p)) = left (ev p) := by
    change right (algebraMap A E (beta p)) = _
    rw [← hlocal p, right.commutes]
    change left (base (algebraMap k[X] F p)) = _
    rw [IsFractionRing.lift_algebraMap]
  have hc (c : k) : beta (C c) = a (scalar c) := by
    rw [show beta (C c) = algebraMap k A c from aeval_C _ _, scalar_eq_algebraMap]
    rfl
  have hx : beta Polynomial.X = a x := aeval_X (R := k) (a x)
