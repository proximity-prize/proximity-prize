          apply IsLocalization.ringHom_ext (nonZeroDivisors k[X])
          apply RingHom.ext
          intro b
          change fromE (algebraMap F E (algebraMap k[X] F b)) =
            (algebraMap G S) (base (algebraMap k[X] F b))
          rw [hlocal b, IsFractionRing.lift_algebraMap]
          exact (hfromE (beta b)).trans (RingHom.congr_fun hpin b)
        exact RingHom.congr_fun he }
  let backward : T →ₐ[G] S := AlgHom.liftEquiv F G E S up
  have hbackward (v : E) : backward (right v) = up v :=
    AlgHom.congr_fun ((AlgHom.liftEquiv F G E S).left_inv up) v
  have hround (u : Four k) : backward (g u) = image u :=
    (hbackward (j (a u))).trans ((hfromE (a u)).trans (hfromA u))
  have h1 : forward.comp backward = AlgHom.id G T := by
    apply Algebra.TensorProduct.ext_ring
    apply AlgHom.coe_ringHom_injective
    apply IsLocalization.ringHom_ext (denominators beta)
    apply Ideal.Quotient.ringHom_ext
    exact RingHom.ext fun u => by
