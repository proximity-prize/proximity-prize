variable (k : Type) {A : Type} [Field k] [CommRing A] [IsDomain A] [Algebra k A]

theorem offset_finrank_in {F : Type} [Field F] [Algebra A F] [IsFractionRing A F]
    [Algebra k F] [IsScalarTower k A F] (x : A) :
