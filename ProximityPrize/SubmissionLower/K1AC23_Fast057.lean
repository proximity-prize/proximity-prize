    rw [transcendental_iff_injective]
    change Function.Injective (Polynomial.aeval u).toRingHom ↔ Function.Injective f
    rw [← hpoly, RingHom.coe_comp]
    exact ⟨fun h => h.of_comp, fun h => (IsFractionRing.injective A F).comp h⟩
  by_cases h : IsAlgebraic k u
  · let : Subsingleton (Localized f) := fibre_subsingleton f (fun hf => (hu.mpr hf) h)
    change Module.finrank _ (Localized f) = functionDegree k u
    rw [functionDegree, ite_eq_left h]
    exact Module.finrank_zero_of_subsingleton
  · let K := FractionRing (Polynomial k)
    let E := IntermediateField.adjoin k ({u} : Set F)
    have ht : Transcendental k u := h
    let i : K ≃+* E :=
      (RatFunc.toFractionRingRingEquiv k).symm.trans
        (RatFunc.algEquivOfTranscendental u ht).toRingEquiv
    let : Algebra K F := (E.subtype.comp i.toRingHom).toAlgebra
    have hi (b : Polynomial k) : algebraMap K F (algebraMap (Polynomial k) K b) =
        algebraMap A F (f b) := by
      change ((RatFunc.algEquivOfTranscendental u ht)
        ((RatFunc.toFractionRingRingEquiv k).symm (algebraMap (Polynomial k) K b)) : F) = _
      have hb : (RatFunc.toFractionRingRingEquiv k).symm (algebraMap (Polynomial k) K b) =
          algebraMap (Polynomial k) (RatFunc k) b := by
        rw [RatFunc.toFractionRingRingEquiv_symm_eq]
        exact (IsLocalization.algEquiv (nonZeroDivisors (Polynomial k)) K (RatFunc k)).commutes b
      rw [hb, RatFunc.algEquivOfTranscendental_algebraMap]
      rw [IntermediateField.AdjoinSimple.coe_aeval_gen_apply]
      exact (RingHom.congr_fun hpoly b).symm
    rw [fibre_finrank f (hu.mp h) hi]
    change Module.finrank K F = functionDegree k u
    rw [functionDegree, ite_eq_right h]
    exact Algebra.finrank_eq_of_equiv_equiv i (RingEquiv.refl F) rfl

theorem offset_finrank (x : A) :
    offsetLength k x = functionDegree k (toFunction x) :=
  offset_finrank_in k (F := FractionRing A) x

