    have hle : I.map (extendScalars f) ≤ cutIdeal f I x s := le_sup_left
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hle (Ideal.mem_map_of_mem _ hu))
  have hfromA (u : Four k) : fromA (a u) = image u := rfl
  have hpin : fromA.comp beta = (algebraMap G S).comp ev := by
    apply Polynomial.ringHom_ext'
