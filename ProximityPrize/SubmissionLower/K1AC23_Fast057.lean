    rw [← RingHom.comp_apply, hpin, RingHom.comp_apply]
    exact (isUnit_iff_ne_zero.mpr ((map_ne_zero_iff ev hinj).2
      (mem_nonZeroDivisors_iff_ne_zero.mp hb))).map (algebraMap G S)
  let fromE : E →+* S := IsLocalization.lift (M := denominators beta) hunits
  have hfromE (v : A) : fromE (j v) = fromA v := IsLocalization.lift_eq hunits v
  let up : E →ₐ[F] S :=
    { fromE with
