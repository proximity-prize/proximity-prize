open K1A_14_3 K1A_14_3R_3 MvPolynomial
open K1_14 hiding AdjacentChart JetSource PrefixCover ReducedEquation TerminalDivisibility TerminalMass adjacent_chart c1 c2 c3 c4 c5 c6 forcedPower of_children rawVolume rawWidth retained_price scheduled seedGain separant_certificate simplePrice singularDegree singular_count singular_degree_lt subbankDebit terminalMass_of_source terminalShape trim twist_lift
open K1A_14

/-- Localizing the surface along the generic jet line gives an integral
curve and preserves the properness of its cutters. -/
def c1 : Prop :=
  ∀ q : Surface, Parent q →
    (curveIdeal q).IsPrime ∧ (affineHilbertPolynomial (curveIdeal q)).natDegree = 1 ∧
      (curveIdeal q).comap rowOnLine = q.asIdeal

/-- The further generic seed cut and the further generic V cut have the
lengths of the parent's mixed and jets sections. -/
def c2 : Prop :=
  ∀ q : Surface, Parent q → (curveIdeal q).IsPrime →
    (affineHilbertPolynomial (curveIdeal q)).natDegree = 1 →
    Module.Finite FurtherField (FurtherSection (curveIdeal q) seedCut) ∧
    Module.finrank FurtherField (FurtherSection (curveIdeal q) seedCut) ≤ sectionDegree q .mixed ∧
    Module.Finite FurtherField (FurtherSection (curveIdeal q) vCut) ∧
    Module.finrank FurtherField (FurtherSection (curveIdeal q) vCut) ≤ sectionDegree q .jets

/-- Generic seed-line multiplication is strict at the seed-degree shift. -/
def c3 : Prop :=
  ∀ q : Surface, Parent q → (curveIdeal q).IsPrime →
    (affineHilbertPolynomial (curveIdeal q)).natDegree = 1 →
    StrictCut (curveIdeal q) seedCut 0 1

/-- Generic V-fibre multiplication is strict at the jet-degree shift. -/
def c4 : Prop :=
  ∀ q : Surface, Parent q → (curveIdeal q).IsPrime →
    (affineHilbertPolynomial (curveIdeal q)).natDegree = 1 →
    StrictCut (curveIdeal q) vCut 1 0

private theorem cutLength_le {I : Ideal CurveAmbient} {f : CurveAmbient} {a b : ℕ}
    (ha : 0 < a) (hb : 0 < b) (hI : I.IsPrime)
    (hdim : (affineHilbertPolynomial I).natDegree = 1)
    (hf : f ∉ I) (hfdeg : f ∈ restrictBidegree (Fin 2) JetLineField a b) :
    Module.Finite JetLineField (CurveAmbient ⧸ (I ⊔ Ideal.span {f})) ∧
      (Module.finrank JetLineField (CurveAmbient ⧸ (I ⊔ Ideal.span {f})) : ℚ) ≤
        affineDegree (linearIdeal I a b) := by
  let M := bidegreeMap (Fin 2) JetLineField a b
  let L := linearIdeal I a b
  let g := bidegreeLift f hfdeg
  let H := L ⊔ Ideal.span {g}
  let Q := I ⊔ Ideal.span {f}
  have hg : M g = f := bidegreeMap_bidegreeLift f hfdeg
  have hgL : g ∉ L := fun h => hf (hg ▸ (show M g ∈ I from h))
  have hL : L.IsPrime := hI.comap M.toRingHom
  have hLd : (affineHilbertPolynomial L).natDegree = 1 :=
    (natDegree_affineHilbertPolynomial_comap_bidegreeMap ha hb I).trans hdim
  have hcut := principalCut_natDegree_affineHilbertPolynomial_le_and_coeff_le_of_isPrime
    hL hgL (totalDegree_bidegreeLift_le_one f hfdeg)
  have hHd : (affineHilbertPolynomial H).natDegree = 0 := by
    exact Nat.eq_zero_of_le_zero (by simpa only [hLd, Nat.sub_self] using hcut.1)
  let _ : Module.Finite JetLineField (LinearAmbient a b ⧸ H) :=
    moduleFinite_of_natDegree_affineHilbertPolynomial_eq_zero hHd
  have hfin : (Module.finrank JetLineField (LinearAmbient a b ⧸ H) : ℚ) ≤ affineDegree L := by
    rw [← affineDegree_eq_finrank H, affineDegree_of_natDegree_eq_zero hHd]
    simpa only [H, affineDegree, hLd, Nat.sub_self, Nat.factorial_one, Nat.cast_one,
      one_mul, mul_one] using hcut.2
  have hsurj : Function.Surjective M := bidegreeMap_surjective ha hb
  have hmap : H.map M.toRingHom = Q := by
    change ((I.comap M.toRingHom) ⊔ Ideal.span {g}).map M.toRingHom = Q
    rw [Ideal.map_sup, Ideal.map_comap_of_surjective M.toRingHom hsurj,
      Ideal.map_span, Set.image_singleton, show M.toRingHom g = f from hg]
  let F := (Ideal.Quotient.mkₐ JetLineField Q).comp M
  have hker : RingHom.ker F = H := by
    change Ideal.comap M.toRingHom (RingHom.ker (Ideal.Quotient.mk Q)) = H
    rw [Ideal.mk_ker, ← hmap, Ideal.comap_map_of_surjective M.toRingHom hsurj,
      ← RingHom.ker_eq_comap_bot]
    apply sup_eq_left.mpr
    apply le_trans _ le_sup_left
    intro x hx
    change M x ∈ I
    rw [show M x = 0 from hx]
    exact I.zero_mem
  let e : (LinearAmbient a b ⧸ H) ≃ₐ[JetLineField] (CurveAmbient ⧸ Q) :=
    (Ideal.quotientEquivAlgOfEq JetLineField hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective
        (Ideal.Quotient.mk_surjective.comp hsurj : Function.Surjective F))
  exact ⟨Module.Finite.of_surjective e.toLinearMap e.surjective,
    (congrArg (fun n : ℕ => (n : ℚ)) e.toLinearEquiv.finrank_eq).symm.le.trans hfin⟩

private theorem cutShape_positive (i : Fin 5) : 0 < (cutShape i).B ∧ 0 < (cutShape i).U := by
  fin_cases i <;> decide

theorem of_children (h1 : c1) (h2 : c2) (h3 : c3) (h4 : c4) :
    K1A_14_3R_3.c2 := by
  intro i q P hq hP hproper
  let s := cutShape i
  let I := curveIdeal q
  let f := rowOnLine P
  obtain ⟨hprime, hdim, hcontraction⟩ := h1 q hq
  have hf : f ∉ I := by
    intro h
    exact hproper (hcontraction ▸ (show P ∈ I.comap rowOnLine from h))
  obtain ⟨ha, hb⟩ := cutShape_positive i
  obtain ⟨hpfin, hplen, hvfin, hvlen⟩ := h2 q hq hprime hdim
  have hdegree := linearIdeal_degree I ha hb hdim
    (h3 q hq hprime hdim) (h4 q hq hprime hdim) hpfin hplen hvfin hvlen
  obtain ⟨hfinite, hlength⟩ := cutLength_le ha hb hprime hdim hf (rowOnLine_mem P s hP)
  have hmap : (cutIdeal q P).map rowOnLine = I ⊔ Ideal.span {f} := by
    simp [cutIdeal, I, f, curveIdeal, Ideal.map_sup, Ideal.map_span, Set.image_singleton]
  have : Module.Finite JetLineField (CurveAmbient ⧸ (cutIdeal q P).map rowOnLine) :=
    by rw [hmap]; exact hfinite
  obtain ⟨hsec, hsecLen⟩ := lineSection_length (cutIdeal q P)
  refine ⟨hsec, ?_⟩
  rw [hsecLen, hmap]
  have hbound := hlength.trans hdegree
  simpa only [constantDegree, mass, Finset.sum_singleton, Nat.cast_add, Nat.cast_mul] using hbound

end

