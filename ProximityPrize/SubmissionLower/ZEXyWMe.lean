def prefixFee (b:fO) :ℕ:=b.schedule.geometryFee+historicalReserve
abbrev terminal (b:fO) :=b.schedule.terminal
abbrev stages (b:fO) :=b.schedule.stages
abbrev aKj (b:fO) :=Fin b.schedule.gw.length
abbrev cV (b:fO) (i:aKj b) :=b.schedule.gw.get i
abbrev Test (b:fO) :=Option (aKj b)
def dfG (b:fO) (i:aKj b) :Bank :=
 { terminal b with shape := { (terminal b).shape with U:=(cV b i).slots } }
def Lc (b:fO) :Test b→Bank
 | none=>terminal b
 | some i=>dfG b i
def threshold (b:fO) :Test b→ℕ
 | none=>b.schedule.gw.length+1
 | some i=>i.val+1
def apo (b:fO) :Test b→ℕ
 | none=>0
 | some i=>(cV b i).seedCap+1
def Jr (b:fO) (t:Bank) :Prop :=
  t=terminal b∨(∃ s∈stages b,t=s.free∨t=s.moving) ∨
    ∃ i:aKj b,t=dfG b i
def O2 (s :Shape) :=s.m*midAgreement - 1
def anM (h r :ℕ) (s :Shape) :=O2 s - 2*h*r
def j3 (h:ℕ) (t:Bank) :=
 triangle t.shape.U*t.ad1+2*h*(t.shape.U+1)*t.poleMoment
def bbk (h:ℕ) (t:Bank) (rows :vP) :Prop :=
  ∀ W<t.shape.m*midAgreement,
    (∀ q≤t.shape.B,∀ j≤ min q t.shape.J,q*(131071-h)≤W+1+j) →
    triangle t.shape.U*ku t.shape (fun q j=>W+1+j - q*(131071-h)) ≤
      j3 h t + ∑ w∈Finset.range (W+1),Module.finrank FX (rows t.shape w)
structure akE (h:ℕ) (rows :vP) (s :Ls) where
 free :Jet
 moving:Jet
 free_ne :free≠0
 moving_ne :moving≠0
 free_mem:free∈rows s.free.shape (anM h s.dI s.free.shape)
 moving_mem:moving∈rows s.moving.shape (anM h s.dI s.moving.shape)
 no_moving:qQ.aeH free moving
abbrev Pairs (b:fO) (h:ℕ) (rows :vP) := ∀ s∈stages b,akE h rows s
def agA (rows :vP) (s :Shape) (q:zI) :Prop :=
 ∀ P∈rows s (O2 s),P∈q.asIdeal
def Mq (h r :ℕ) (s :Shape) :ℕ :=
 s.m*midAgreement - 2*h*r
def amv (h r :ℕ) (s :Shape) (q j:ℕ) :ℕ :=
 Mq h r s+j - q*(131071-h)
def aL4 (h r :ℕ) (s :Shape) :Prop :=
 s.B*(131071-h)<Mq h r s
def O3 (h r :ℕ) (s :Shape) (mode :ℕ) :ℕ :=
 triangle s.U*ku s (fun q j=>amv h r s q j - mode*(2*h*j))
def ahs (h:ℕ) (s :Shape) (W:ℕ) :=1+(O2 s-W)/(2*h)
def ZN (h:ℕ) (s :Shape) (E v :ℕ) :ℕ :=
  ku s fun q j =>
    let g:=(q-j)/E
    let x :=s.m*midAgreement+j - q*(131071-h)
    let c:= fun a=>slots s.U (a*v)
    (∑ a∈Finset.range g,(c a - c (a+1))*(x - 2*h*(j+a))) +
      c g*(x - 2*h*(j+g))
end
