private def palette : ℕ := 

private def deltas : ℕ → ℕ → ℕ → ℕ → ℕ → List FadicGate.Entry
  | 0,_,_,_,_ => []
  | n+1,b,j,t,w =>
    let common := Nat.beq (Nat.mod w 2) 1
    let code := cond common
      (Nat.mod (Nat.shiftRight palette (27 * Nat.mod (Nat.div w 2) 64)) 134217728)
      (Nat.div w 2)
    let rest := Nat.div w (cond common 128 268435456)
    let b' := b + 123 - Nat.mod code 512
    let j' := j + 23 - Nat.mod (Nat.div code 512) 256
    let t' := t + 288 - Nat.mod (Nat.div code 131072) 1024
    some (b', j', t') :: deltas n b' j' t' rest

def unpack : ℕ → ℕ → List FadicGate.Entry
  | 0,_ => []
  | n+1,w =>
    let x := Nat.mod w 4294967296
    let b := 313 + Nat.mod x 3700
    let j := 124 + Nat.mod (Nat.div x 3700) 1527
    let t := 31 + Nat.div x 5649900
    some (b,j,t) :: deltas n b j t (Nat.div w 4294967296)

