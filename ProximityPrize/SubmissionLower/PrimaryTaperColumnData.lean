theorem sourceCount_eq : sourceCount = 406807694511 :=
  congrArg Prod.fst ((moments_eq 4013).symm.trans checked)

theorem sourceDegree_eq : sourceDegree = 962164450311967 :=
  congrArg (fun x : Moments => x.2.1) ((moments_eq 4013).symm.trans checked)

theorem sourceIndex24_eq : sourceIndex24 = 11874264712496136 :=
  congrArg (fun x : Moments => x.2.2) ((moments_eq 4013).symm.trans checked)

/-- Exact column count when the weighted cutoff is above the entire grade range. -/
def compactCount (A D : ℕ) : ℕ :=
  3000*A*406807694511 + 494761029687339 - D*962164450311967

theorem exact_columns (A D : ℕ) (hA : 0<A) (hD : 3<D) (hBudget : D*4012 ≤ 3000*A) :
    (columns A D hD).card = compactCount A D := by
  have h := scaled_columns A D hA hD hBudget
  rw [sourceCount_eq, sourceDegree_eq, sourceIndex24_eq] at h
  unfold compactCount
  push_cast at h
  omega

#print axioms exact_columns
end TaperColumns
