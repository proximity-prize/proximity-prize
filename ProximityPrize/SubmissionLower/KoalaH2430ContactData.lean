import ProximityPrize.SubmissionLower.KoalaH2430Contact
import ProximityPrize.SubmissionLower.KoalaH2430ContactPartition

set_option autoImplicit false
set_option maxHeartbeats 6000000
set_option maxRecDepth 16000

namespace KoalaH2430Contact
open K1_14 (Shape)
open P1_7_4 (pairMinSeed pairMinOrdinate sharedBound)

structure StageContact where
  free : Shape
  moving : Shape
  reserve : ℕ
  cap : Fin 4 → ℚ
  tree : Fin 4 → Tree

def leaf (S : StageContact) (k : Fin 4) (a b c d r : ℕ) : Prop :=
  0 < r ∧ r ≤ S.reserve + 1 ∧
  if k = 0 then
    d≤pairMinOrdinate S.free S.moving ∧
    (d≤min (S.free.B-S.free.J) (S.moving.B-S.moving.J) ∨
      min (S.free.B-S.free.J) (S.moving.B-S.moving.J)≤c) ∧
    sharedBound S.free S.moving 0 c r (S.reserve+1) true k≤S.cap k ∧
    sharedBound S.free S.moving 0 d r (S.reserve+1) true k≤S.cap k
  else if k = 2 then
    b≤pairMinSeed S.free S.moving ∧ d≤pairMinOrdinate S.free S.moving ∧
    sharedBound S.free S.moving a c r (S.reserve+1) true k≤S.cap k ∧
    sharedBound S.free S.moving a d r (S.reserve+1) true k≤S.cap k ∧
    sharedBound S.free S.moving b c r (S.reserve+1) true k≤S.cap k ∧
    sharedBound S.free S.moving b d r (S.reserve+1) true k≤S.cap k
  else
    b≤pairMinSeed S.free S.moving ∧
    sharedBound S.free S.moving a 0 r (S.reserve+1) true k≤S.cap k ∧
    sharedBound S.free S.moving b 0 r (S.reserve+1) true k≤S.cap k

instance (S : StageContact) (k : Fin 4) (a b c d r : ℕ) :
    Decidable (leaf S k a b c d r) := by
  unfold leaf
  infer_instance

def stageChecked (S : StageContact) : Prop :=
  S.free.J≤S.free.B ∧ S.moving.J≤S.moving.B ∧
  ∀ k : Fin 4, (S.tree k).Checked (leaf S k) 0
    (if k = 0 then 0 else pairMinSeed S.free S.moving)
    0 (if k = 0 ∨ k = 2 then pairMinOrdinate S.free S.moving else 0)

instance (S : StageContact) : Decidable (stageChecked S) := by
  unfold stageChecked
  infer_instance

theorem adapt (S : StageContact) (ok : stageChecked S) {x z : ℕ}
    (hx:x≤pairMinSeed S.free S.moving) (hz:z≤pairMinOrdinate S.free S.moving)
    (m : Fin 4 → ℚ)
    (hm : ∀ r, 0<r → r≤S.reserve+1 → ∀ k,
      m k ≤ sharedBound S.free S.moving x z r (S.reserve+1) true k) :
    ∀ k, m k≤S.cap k := by
  intro k
  obtain ⟨hs,ht,h⟩ := ok
  fin_cases k
  · obtain ⟨a,b,c,d,r,hrow,_,_,hcz,hzd⟩ :=
      (S.tree 0).locate (h 0) (x:=0) (z:=z) (Nat.zero_le _) (Nat.zero_le _) (Nat.zero_le z) (by simpa using hz)
    simp only [leaf, if_pos rfl] at hrow
    obtain ⟨hr0,hr,hdu,hside,hL,hU⟩ := hrow
    exact (hm r hr0 hr 0).trans (seed_box _ _ hcz hzd hdu hs ht hside hL hU)
  · obtain ⟨a,b,c,d,r,hrow,hax,hxb,_,_⟩ :=
      (S.tree 1).locate (h 1) (x:=x) (z:=0) (Nat.zero_le x)
        (by simpa using hx) (Nat.zero_le _) (Nat.zero_le _)
    simp only [leaf, if_neg (by decide : (1 : Fin 4) ≠ 0),
      if_neg (by decide : (1 : Fin 4) ≠ 2)] at hrow
    obtain ⟨hr0,hr,hbu,hL,hU⟩ := hrow
    exact (hm r hr0 hr 1).trans (ordinate_box _ _ hax hxb hbu hs ht hL hU)
  · obtain ⟨a,b,c,d,r,hrow,hax,hxb,hcz,hzd⟩ :=
      (S.tree 2).locate (h 2) (x:=x) (z:=z) (Nat.zero_le x)
        (by simpa using hx) (Nat.zero_le z) (by simpa using hz)
    simp only [leaf, if_neg (by decide : (2 : Fin 4) ≠ 0), if_pos rfl] at hrow
    obtain ⟨hr0,hr,hbu,hdu,hac,had,hbc,hbd⟩ := hrow
    refine (hm r hr0 hr 2).trans (P1_7_4_2.shared_mixed_box _ _ hax hxb hbu hcz hzd hdu ?_)
    intro y hy w hw
    rcases hy with rfl | rfl <;> rcases hw with rfl | rfl
    · exact hac
    · exact had
    · exact hbc
    · exact hbd
  · obtain ⟨a,b,c,d,r,hrow,hax,hxb,_,_⟩ :=
      (S.tree 3).locate (h 3) (x:=x) (z:=0) (Nat.zero_le x)
        (by simpa using hx) (Nat.zero_le _) (Nat.zero_le _)
    simp only [leaf, if_neg (by decide : (3 : Fin 4) ≠ 0),
      if_neg (by decide : (3 : Fin 4) ≠ 2)] at hrow
    obtain ⟨hr0,hr,hbu,hL,hU⟩ := hrow
    exact (hm r hr0 hr 3).trans (jet_box _ _ hax hxb hbu hL hU)

