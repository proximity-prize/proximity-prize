theorem zero_r7_part48 : ∀ i ∈ List.range 1, ZeroCheckAt 7 (48+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 7 48 := by decide +kernel
  exact zeroAtFast_sound 7 48 hfast

