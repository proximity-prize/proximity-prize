def select (x : Shape) : Option Packet :=
  ((ranges x.j x.t).find? fun a => Nat.ble a.1 x.b && Nat.ble x.b a.2.1).map (fun a => a.2.2)

def packetOK (g : Gt) (x : Shape) : Prop :=
  inR g x = true ∧
  if g.lift then thOK (rayO x) (Gt.mat g) = true
  else tfB x = true ∧ thOK (rayT x) (Gt.mat g) = true

instance (g : Gt) (x : Shape) : Decidable (packetOK g x) := by
  unfold packetOK
  infer_instance

def G (x : Shape) : ℕ :=
  match select x with
  | none => 0
  | some i => quote (data i) x

def Gated (_ : ℕ) (x : Shape) : Prop :=
  match select x with
  | none => False
  | some i => packetOK (data i) x

instance (k : ℕ) (x : Shape) : Decidable (Gated k x) := by
  unfold Gated
  split <;> infer_instance

