 apply Finset.sum_congr rfl
 intro x _
 by_cases hi: (↑x.1.1 :ℕ)=i <;> by_cases hj: (↑x.2 :ℕ)=j <;>
  by_cases hk : (↑x.1.2 :ℕ)=k <;> simp [coeff_monomial,hi,hj,hk]
private theorem coords_bijective (e h:ℕ) (b:ℕ→ℕ) :Function.Bijective (coords e h b) := by
  classical
  constructor
  · intro P Q he
    apply Subtype.ext
    ext i j k
    change coeff3 P i j k=coeff3 Q i j k
    by_cases hb:i≤e∧j≤h∧k<b i
    · exact congrFun he (⟨⟨i,by omega⟩,⟨k,hb.2.2⟩⟩,⟨j,by omega⟩)
