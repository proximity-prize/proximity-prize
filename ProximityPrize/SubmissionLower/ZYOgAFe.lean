private abbrev Index (e h:ℕ) (b:ℕ→ℕ) :=(Σ i:Fin (e+1),Fin (b i))×Fin (h+1)
private def coords (e h:ℕ) (b:ℕ→ℕ) :box e h b →ₗ[L] (Index e h b→L) where
 toFun P x :=coeff3 P x.1.1 x.2 x.1.2
