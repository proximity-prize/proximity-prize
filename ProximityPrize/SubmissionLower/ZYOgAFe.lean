open Polynomial Finset
open P5 (K p)
open cu (L FX jz)
open P5_7_7 (Dg phys embed seedDerivative)
def atPair (F:Dg) (z :K) (P Q:L[X]) :FX :=
 (embed F).eval₂ (lz (jz z)) (phys P/phys Q)
def zD (F:Dg) (z :K) (P Q:L[X]) :FX :=
 -(atPair (seedDerivative F) z P Q/atPair F.derivative z P Q)*phys Q^2
def HE (F:Dg) (s W:ℕ) :Prop :=
 ∀ i j,(F.coeff i).coeff j≠0→((F.coeff i).coeff j).natDegree+i*s≤W
structure EquationBounds (F:Dg) (l h:ℕ) :Prop where
 irreducible :Irreducible F
 jU:F.natDegree=l
 two_le :2≤l
 tame :l<p
 height : ∀ i,(F.coeff i).natDegree≤h
 moving:seedDerivative F≠0
structure Sections (F:Dg) where
 CF:Finset K
 seed :K→K
 injective :Set.InjOn seed (CF:Set K)
 P:K→ L[X]
 Q:K→ L[X]
 denominator : ∀ γ∈CF,Q γ≠0
 coprime : ∀ γ∈CF,IsCoprime (P γ) (Q γ)
 root : ∀ γ∈CF,atPair F (seed γ) (P γ) (Q γ)=0
 regular_ordinate : ∀ γ∈CF,
   ((embed F).resultant (embed F.derivative)).eval (jz (seed γ))≠0
 simple : ∀ γ∈CF,atPair F.derivative (seed γ) (P γ) (Q γ)≠0
 A:K→ L[X]
 B:K→ L[X]
 nonzero : ∀ γ∈CF,A γ≠0
 pole_denominator : ∀ γ∈CF,B γ≠0
 reduced : ∀ γ∈CF,IsCoprime (A γ) (B γ)
 formula : ∀ γ∈CF,phys (A γ)/phys (B γ)=zD F (seed γ) (P γ) (Q γ)
def pN {F:Dg} (S:Sections F) (s :ℕ) (γ:K) :ℕ :=
 s+2*max (S.Q γ).natDegree ((S.P γ).natDegree-s)
end
end qGnV2ac
