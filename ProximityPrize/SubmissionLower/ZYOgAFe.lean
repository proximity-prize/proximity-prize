    intro P Q hP hQ i j k hn
    by_cases hz :coeff3 P i j k=0
    · apply hQ i j k
      simpa only [coeff3_add,hz,zero_add] using hn
    · exact hP i j k hz
  smul_mem' := by
    intro c P hP i j k hn
    apply hP i j k
    intro hz
    exact hn (by simp only [coeff3_smul,hz,smul_zero])
theorem bI2 {e h b P} :
  P∈box e h b ↔ ∀ i j k,coeff3 P i j k≠0→i≤e∧j≤h∧k<b i :=
