      split_ifs with hm
      · rcases hm with ⟨rfl,rfl,rfl⟩
        exact (hb ⟨by omega,by omega,c.isLt⟩).elim
      · rfl
    refine ⟨⟨assemble f,hf⟩,?_⟩
    funext x
    change coeff3 (assemble f) x.1.1 x.2 x.1.2=f x
    rw [bnj,Finset.sum_eq_single x]
    · simp
    · intro y _ hy
      split_ifs with hm
      · obtain ⟨ha,hj,hk⟩:=hm
        have hi:y.1.1=x.1.1 :=Fin.ext ha
        have hs :y.1=x.1 :=
          Sigma.ext hi ((Fin.heq_ext_iff (lV (fun a :Fin (e+1)=>b a) hi)).2 hk)
        exact (hy (Prod.ext hs (Fin.ext hj))).elim
      · rfl
    · simp
instance box_group (e h:ℕ) (b:ℕ→ℕ) :AddCommGroup (box e h b) :=
 @Submodule.addCommGroup L Dg _ _ _ (box e h b)
instance box_finite (e h:ℕ) (b:ℕ→ℕ) :Module.Finite L (box e h b) :=
