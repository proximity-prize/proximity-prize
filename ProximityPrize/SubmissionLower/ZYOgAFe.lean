  funext x
  simp only [Submodule.coe_add,coeff3,coeff_add,Pi.add_apply]
 map_smul' c P:= by
  funext x
  simp only [Submodule.coe_smul,coeff3,coeff_smul,RingHom.id_apply,Pi.smul_apply]
private def assemble {e h b} (f :Index e h b→L) :Dg :=
 ∑ x,monomial (↑x.1.1) (monomial (↑x.2) (monomial (↑x.1.2) (f x)))
private theorem bnj {e h b} (f :Index e h b→L) (i j k :ℕ) :
  coeff3 (assemble f) i j k =
   ∑ x :Index e h b,if (↑x.1.1 :ℕ)=i∧(↑x.2 :ℕ)=j∧(↑x.1.2 :ℕ)=k then f x else 0:= by
 classical
