        (⊥ : Ideal A) hle
      let : P.IsPrime := hP
      let : P.LiesOver l.head.asIdeal := ⟨hPhead.symm⟩
      obtain ⟨L, hL, _, _⟩ := Ideal.exists_ltSeries_of_hasGoingUp l P
      exact Order.le_krullDim_iff.mpr ⟨L, hL.trans hlen⟩
