      have h : tripleK (r + 2) = denK (r + 2) + denK (r + 1) + denK r := by
        interval_cases r <;> decide
      change tripleK (12 * k + (r + 2)) = denK (12 * k + (r + 2)) + denK (12 * k + (r + 1)) + denK (12 * k + r)
      rw [tripleK_period, denK_period, denK_period, denK_period, h]
