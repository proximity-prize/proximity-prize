    let t := Nat.mod (Nat.div code 2048) 1024
    let c := Nat.mod (Nat.div code 2097152) 1024
    let n := runLength code
    let degreeCost := Nat.add (Nat.add v t) (Nat.mul 3 c)
    let capCost := Nat.add t c
    let loDelta := Nat.add (Nat.mul 3 t) (Nat.mul 2 c)
    let ordDelta := Nat.add (Nat.mul 2 t) (Nat.mul 3 c)
    let d := Nat.sub 1650 degreeCost
    let cap := Nat.sub 550 capCost
    let m := Nat.succ (Nat.div (Nat.sub (Nat.sub (Nat.sub 4649 s) v) (Nat.mul 4 c)) 4)
    let last := Nat.sub (Nat.add j n) 1
    if Nat.ble degreeCost 1650 && Nat.ble capCost 550 &&
       Nat.ble (Nat.add last loDelta) 1650 && Nat.ble (Nat.add (Nat.add s last) ordDelta) 4650 &&
       Nat.ble (Nat.add (Nat.add s v) (Nat.mul 4 c)) 4649 && Nat.ble m d &&
       Nat.ble (Nat.sub (Nat.sub 1650 j) loDelta) (Nat.succ (Nat.mul 3 cap)) then
      sumFrom (cellK (Nat.sub 4650 s) loDelta ordDelta d m (Nat.succ (Nat.div (Nat.sub 4649 s) 4))
        (countK d (Nat.succ (Nat.mul 3 cap)))) j n
    else runValue s j code

private def rowK (s j : ℕ) : List ℕ → ℕ
  | [] => 0
  | code :: tail => withNatK j fun u => Nat.add (runK s u code) (rowK s (Nat.add u (runLength code)) tail)

private theorem sumFrom_congrK (f g : ℕ → ℕ) (j n : ℕ)
    (h : ∀ i < n, f (j + i) = g (j + i)) : sumFrom f j n = sumFrom g j n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change sumFrom f j n + f (j + n) = sumFrom g j n + g (j + n)
    rw [ih (fun i hi => h i (by omega)), h n (by omega)]

private theorem runK_spec (s j code : ℕ) : runK s j code = runValue s j code := by
  unfold runK
  split
  · rename_i h
    rw [runValue, ite_eq_left h]
  · rename_i h
    dsimp only
    split
    · rename_i hv
      rw [runValue, ite_eq_right h]
      apply sumFrom_congrK
      intro i hi
      simp only [Bool.and_eq_true, Nat.ble_eq] at hv
      obtain ⟨⟨⟨⟨⟨⟨hd, hc⟩, hlo⟩, hord⟩, hs⟩, hm⟩, hcap⟩ := hv
      let v := code % 2048
      let t := code / 2048 % 1024
      let c := code / 2097152 % 1024
      have hlast : j + i ≤ j + runLength code - 1 := by omega
      have hl : j + runLength code - 1 + (3 * t + 2 * c) ≤ 1650 := hlo
      have ho : s + (j + runLength code - 1) + (2 * t + 3 * c) ≤ 4650 := hord
      have hlow : 1650 - j - (3 * t + 2 * c) ≤ 3 * (550 - (t + c)) + 1 := hcap
      exact cellK_spec s (j + i) v t c hd hc (by omega) (by omega) hs hm (by omega)
    · rfl

private theorem rowK_spec (s j : ℕ) (row : List ℕ) : rowK s j row = rowValue s j row := by
  induction row generalizing j with
  | nil => rfl
  | cons code tail ih =>
    rw [rowK, withNatK_eq, rowValue, runK_spec, ih]
    rfl

private theorem consValueK {s x y : ℕ} {a : List ℕ} {b : List (List ℕ)}
    (ha : rowK s (rowStart s) a = x) (hb : value (s + 1) b = y) : value s (a::b) = x + y := by
  simp only [value, ← rowK_spec, ha, hb]

