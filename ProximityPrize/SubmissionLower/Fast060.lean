  by_cases hd : d < 0
  · simp [fastCum, cumulative, hd]
  by_cases hu : u < 0
  · simp [fastCum, cumulative, hu]
  simp only [fastCum, cumulative, fastDen_eq, hd, hu, decide_false, Bool.false_or, Bool.false_eq_true,
    ite_false]
  let v := min u (3 * d)
  have hv : v ≤ 3 * d := min_le_right _ _
  rw [den_neg (show v - 3 * d - 6 < 0 by omega), sub_zero]
  by_cases h₁ : v ≤ d
  · rw [ite_eq_left h₁, den_neg (show v - d - 1 < 0 by omega),
      den_neg (show v - d - 2 < 0 by omega), den_neg (show v - d - 3 < 0 by omega),
      den_neg (show v - 2 * d - 3 < 0 by omega), den_neg (show v - 2 * d - 4 < 0 by omega),
      den_neg (show v - 2 * d - 5 < 0 by omega)]
    simp only [sub_zero, add_zero]
  · rw [ite_eq_right h₁]
    by_cases h₂ : v ≤ 2 * d + 2
    · rw [ite_eq_left h₂, den_neg (show v - 2 * d - 3 < 0 by omega),
        den_neg (show v - 2 * d - 4 < 0 by omega), den_neg (show v - 2 * d - 5 < 0 by omega)]
      simp only [add_zero]
    · rw [ite_eq_right h₂]
theorem cumulative_neg_right (d u : ℤ) (hu : u < 0) : cumulative d u = 0 := by
  simp [cumulative, hu]
theorem cap_inactive (d u : ℤ) (hu : u ≤ 1650) :
    cappedCount d u 550 = fastCum d u := by
  unfold cappedCount
  rw [ite_eq_right (by decide : ¬ (550 : ℤ) < 0), cumulative_neg_right (d - 550 - 1) _ (by omega),
    sub_zero, fastCum_eq]
private def chart (d j h : ℤ) : Flag := ⟨d, 1650 - j, 1650, 550, h + 1⟩
private theorem oldCount_eq (d j h : ℤ) (hj : 0 ≤ j) :
    oldCount (chart d j h) = fastCum d 1650 - fastCum d (1649 - j) := by
  have hl : min (1650 : ℤ) (1650 - j - 1) = 1649 - j := by
    rw [min_eq_right (by omega)]
    omega
  simp only [oldCount, chart, hl, cap_inactive _ _ (le_refl _),
    cap_inactive _ _ (show 1649 - j ≤ 1650 by omega)]
theorem fastCum_eq_den {d u : ℤ} (hu : 0 ≤ u) (hud : u ≤ d) :
    fastCum d u = denominator u := by
  simp [fastCum, show ¬ d < 0 by omega, show ¬ u < 0 by omega,
    min_eq_left (show u ≤ 3 * d by omega), hud, fastDen_eq]
private theorem kernel_eq (d j h : ℤ) (hd : 0 ≤ d) (hj : 0 ≤ j) :
    kernelLower (chart d j h) = signedKernel d j h := by
  unfold kernelLower
  simp only [chart, show ¬ d < 0 by omega, decide_false, Bool.false_or, Bool.false_eq_true,
    ite_false, show ¬ (1650 : ℤ) < 0 by decide, show ¬ (550 : ℤ) < 0 by decide]
  change oldCount (chart d j h) - targetCount (chart d j h) = _
  rw [oldCount_eq _ _ _ hj]
  unfold targetCount signedKernel
  simp only [chart, add_sub_cancel_right, show (1650 : ℤ) - j - 1 = 1649 - j by ring]
  by_cases hb : h - (1650 - j) + d < 0
  · simp only [ite_eq_left hb, sub_zero]
  · simp only [ite_eq_right hb, fastCum_eq]
    ring
private theorem initial_eq (t : Fin 499) (j : Fin 283) (i : BlockIndex)
    (hs : i.1.val = 3514 + t.val) (hj : i.2.val = j.val) :
    initialFlag i = chart 1650 j.val (1135 - (t.val : ℤ) - j.val) := by
  have hs' : (i.1.val : ℤ) = 3514 + (t.val : ℤ) := by exact_mod_cast hs
  have hj' : (i.2.val : ℤ) = (j.val : ℤ) := by exact_mod_cast hj
  unfold initialFlag chart offset
  rw [hs', hj', min_eq_right (by omega)]
  congr 1 <;> omega
private theorem residual_eq (d j h : ℤ) (v : ℕ) :
    residualFlag (chart d j h) (Powers.expand ⟨v, 0, 0⟩) = chart (d - v) j h := by
  rw [residualFlag_expand]
  simp [chart]
theorem zero_residual (F : Flag) : residualFlag F (fun _ => 0) = F := by
  cases F
  simp [residualFlag]
theorem blockBound_eq (i : BlockIndex) (p : Fin 11 → ℕ)
    (horder : 0 < (initialFlag i).order) (hu : (initialFlag i).upper ≤ 2999 - offset i) :
    blockBound i p = (oldCount (initialFlag i) -
      max 0 (max (kernelLower (initialFlag i)) (kernelLower (residualFlag (initialFlag i) p)))).toNat := by
  unfold blockBound
  rw [ite_eq_right (not_le_of_gt horder), min_eq_left hu]
  have he : { initialFlag i with upper := (initialFlag i).upper } = initialFlag i := by
    cases initialFlag i
    rfl
  rw [he]
  dsimp only
  rw [min_eq_right]
  have := le_max_left (0 : ℤ)
    (max (kernelLower (initialFlag i)) (kernelLower (residualFlag (initialFlag i) p)))
  omega
theorem entry_eq (t : Fin 499) (j : Fin 283) (i : BlockIndex)
    (hs : i.1.val = 3514 + t.val) (hj : i.2.val = j.val) :
    entry t.val j.val = if w4.Contains i then savings i (witness i) else 0 := by
  have hdiag : w4.Contains i ↔ 23 ≤ t.val + j.val ∧ t.val + j.val ≤ 656 := by
    change (3514 ≤ i.1.val ∧ i.1.val < 4013 ∧ 0 ≤ i.2.val ∧ i.2.val ≤ 282 ∧
      3537 ≤ i.1.val + i.2.val ∧ i.1.val + i.2.val ≤ 4170) ↔ _
    have ht := t.isLt
    have hh := j.isLt
    omega
  unfold entry
  by_cases hw : w4.Contains i
  · rw [ite_eq_left (hdiag.mp hw), ite_eq_left hw]
    dsimp only
    have hf := initial_eq t j i hs hj
    have ht := t.isLt
    have hh := j.isLt
    have horder : 0 < (initialFlag i).order := by
      rw [hf]
      change 0 < (1135 - (t.val : ℤ) - j.val) + 1
      omega
    have hu : (initialFlag i).upper ≤ 2999 - offset i := by
      rw [hf]
      change (1650 : ℤ) ≤ 2999 - ((i.2.val : ℤ) - 1650)
      omega
    let v := valuePower (3514 + t.val) j.val
    let h : ℤ := 1135 - (t.val : ℤ) - j.val
    have hv : v ≤ 1650 := by unfold v valuePower; omega
    have hj₀ : (0 : ℤ) ≤ j.val := Int.natCast_nonneg _
    have ho : oldCount (chart 1650 j.val h) = denominator 1650 - denominator (1649 - (j.val : ℤ)) := by
      rw [oldCount_eq _ _ _ hj₀, fastCum_eq_den (by omega) (by omega),
        fastCum_eq_den (by omega) (by omega)]
    have hwit : witness i = ⟨v,0,0⟩ := by simp [witness, hs, hj, v]
    unfold savings baseline
    rw [hwit, blockBound_eq _ _ horder hu, blockBound_eq _ _ horder hu,
      zero_residual, hf, residual_eq, ho, kernel_eq _ _ _ (by omega) hj₀,
      kernel_eq _ _ _ (by omega) hj₀, max_self, ← max_assoc]
    change (if v = 0 then 0 else _) = _
    simp only [fastDen_eq]
    by_cases hz : v = 0
    · simp [hz]
    · rw [ite_eq_right hz]
  · rw [ite_eq_right (fun h => hw (hdiag.mpr h)), ite_eq_right hw]
