-- The two fastC corrections contribute with opposite signs. Collect their positive
-- and negative summands before taking the natural part of the signed kernel.
private def auxBKernelN (d lo cap ord r : ℕ) : ℕ :=
  let hi := Nat.add (Nat.mul 3 cap) 1
  let pos := Nat.add (Nat.add (auxBDen hi) (auxBDen (Nat.sub ord (Nat.mul 3 r))))
    (auxBTripleFast (Nat.sub lo (Nat.sub d r)))
  let neg := Nat.add (Nat.add (auxBTripleFast (Nat.sub hi d)) (auxBDen ord)) (auxBDen lo)
  Nat.sub pos neg

private theorem auxBKernelN_eq (d lo cap ord r : ℕ)
    (hlo : (lo:ℤ) - 1 ≤ 3*cap)
    (hb : 0 ≤ (ord:ℤ) - 1 - lo + d)
    (hr₁ : r = ((ord:ℤ) - 1 - lo + d) / 4 + 1)
    (hr₂ : r ≤ d)
    (hhi : 3*cap ≤ 2*d+2) (hhi' : cap ≤ d)
    (ho : (ord:ℤ) - 1 ≤ d)
    (hl : (lo:ℤ) - 1 ≤ 2*((d:ℤ)-r)+2)
    (hl' : (lo:ℤ) - 1 ≤ 3*((d:ℤ)-r)) (hcap : 3*cap+1-d ≤ 650) (hlo' : lo-(d-r) ≤ 650) :
    (fastKernel d lo cap ord).toNat = auxBKernelN d lo cap ord r := by
  have hn : ¬ (ord:ℤ) - 1 - lo + d < 0 := by omega
  have hm : min (d:ℤ) (((ord:ℤ)-1-lo+d)/4) + 1 = r := by
    rw [min_eq_right (by omega)]; omega
  simp only [fastKernel, not_lt.mpr (Int.natCast_nonneg d),
    not_lt.mpr (Int.natCast_nonneg cap), decide_false, Bool.false_or, Bool.false_eq_true,
    ite_false, hn, hm, hlo, ite_true]
  rw [auxBMiddleC (d:ℤ) (3*cap) (by omega) (by omega) (by omega),
      auxBSmallC (d:ℤ) ((ord:ℤ)-1) (by omega) ho,
      auxBSmallC ((d:ℤ)-r) ((ord:ℤ)-1-3*r) (by omega) (by omega),
      auxBMiddleC ((d:ℤ)-r) ((lo:ℤ)-1) (by omega) hl' hl]
  rw [show (3*(cap:ℤ)+1).toNat = 3*cap+1 by omega,
      show (3*(cap:ℤ)+1-d).toNat = 3*cap+1-d by omega,
      show ((ord:ℤ)-1+1).toNat = ord by omega,
      show ((ord:ℤ)-1-3*r+1).toNat = ord-3*r by omega,
      show ((lo:ℤ)-1+1).toNat = lo by omega,
      show ((lo:ℤ)-1+1-((d:ℤ)-r)).toNat = lo-(d-r) by omega]
  rw [auxBTripleFast_eq (3*cap+1-d) (by omega), auxBTripleFast_eq (lo-(d-r)) (by omega)]
  change _ = auxBDen (3*cap+1) + auxBDen (ord-3*r) + auxBTripleFast (lo-(d-r)) -
    (auxBTripleFast (3*cap+1-d) + auxBDen ord + auxBDen lo)
  omega

private theorem auxBOldN_eq (lo : ℕ) (hl : lo ≤ 1650) :
    (fastOld 1650 lo 550).toNat = auxBDen 1651 - auxBDen lo := by
  unfold fastOld
  rw [min_eq_right (show (lo:ℤ)-1 ≤ 3*550 by omega),
      auxBSmallC 1650 (3*550) (by decide) (by decide),
      auxBSmallC 1650 ((lo:ℤ)-1) (by decide) (by omega),
      show ((lo:ℤ)-1+1).toNat = lo by omega]
  change ((auxBDen 1651 : ℤ) - auxBDen lo).toNat = _
  omega

-- The removed lengths for the empty and residual powers are independent of j.
private def auxBSave (s j a b c : ℕ) : ℕ :=
  let lo := Nat.sub 1650 j
  let ord := Nat.sub (Nat.sub 4650 s) j
  let bal := Nat.sub 4649 s
  let r₀ := Nat.add (Nat.div bal 4) 1
  let r := Nat.add (Nat.div (Nat.sub (Nat.sub bal a) (Nat.mul 4 c)) 4) 1
  let base := auxBKernelN 1650 lo 550 ord r₀
  let res := auxBKernelN (Nat.sub 1650 (Nat.add (Nat.add a b) (Nat.mul 3 c)))
    (Nat.sub lo (Nat.add (Nat.mul 3 b) (Nat.mul 2 c))) (Nat.sub 550 (Nat.add b c))
    (Nat.sub ord (Nat.add (Nat.mul 2 b) (Nat.mul 3 c))) r
  Nat.sub (min (Nat.sub (auxBDen 1651) (auxBDen lo)) res) base

private theorem auxBClip (old base res : ℤ) :
    (old-max 0 base).toNat - (old-max (max 0 base) res).toNat =
      min old.toNat res.toNat - base.toNat := by omega

