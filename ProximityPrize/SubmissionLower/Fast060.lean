namespace K1_13_6_1_4_3_3_1

/-- The ideal spanned by the equations other than the one at index `i`. -/
def otherIdeal {R : Type*} [CommRing R] (f : Fin 4 → R) (i : Fin 4) : Ideal R :=
  Ideal.span (f '' {j | j ≠ i})

end K1_13_6_1_4_3_3_1
