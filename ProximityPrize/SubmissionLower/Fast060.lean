/-- Equations of the total family together with its deformation parameter. -/
def specialIdeal {L : Type} [Field L] (g : Fin 4 → Total L) : Ideal (Total L) :=
  equationsIdeal g ⊔ Ideal.span {C Polynomial.X}

end

