theorem zr26p64:∀ i ∈ List.range 1,ZeroCheckAt 26 (64+i):=by
  intro i hi
  have hi0:i = 0:=by have:=List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast:ZeroAtFast 26 64:=by decide +kernel
  exact zeroAtFast_sound 26 64 hfast

