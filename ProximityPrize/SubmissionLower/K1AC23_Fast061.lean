  induction I using Finset.induction_on with
  | empty => simp [mass]
  | @insert f I hf ih =>
    rw [Finset.biUnion_insert, Finset.sum_insert hf]
    exact (mass_union (T f) (I.biUnion T) s).trans (add_le_add le_rfl ih)

/-- One factor can pay at most its own contribution to each degree budget. -/
private theorem heavy_mass {I : Finset Equation} (T : Equation → Finset Surface)
    {u b : ℚ}
