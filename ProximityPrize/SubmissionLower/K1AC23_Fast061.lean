/-- Factor both rows and retain the residual orders off the high ordinary factors. -/
def c1 : Prop :=
  ∀ (h : ℕ) (rows : Banks) (i : Fin 4) (B : BufferedPair h rows i)
    (r : ℕ), 1 ≤ r → r ≤ reserve i + 1 → Nonempty (ThresholdPair i B.cheap B.layered r)

/-- Clear the abscissa denominators and form the proper ordinary graph pair. -/
def c2 : Prop :=
  ∀ (f : Equation), Irreducible f → 0 < f.natDegree → f.natDegree < p →
    ∃ (g : ClearedEquation) (a : L[X]), IsClearing f g a ∧
      ProperPair (C f) (graphCutter g) ∧
      RowCaps (C f) ⟨0, f.natDegree, 0, ordinarySeedDegree f⟩ ∧
      RowCaps (graphCutter g) ⟨0, f.natDegree, 1, ordinarySeedDegree f⟩

/-- Two residual rows of order k have local intersection length at least k squared. -/
def c3 : Prop :=
  ∀ (P Q : Jet) (q : Surface) (k : ℕ), ProperPair P Q → Parent q → 0 < k →
    OrderAt q P k → OrderAt q Q k → (k : ℕ∞)^2 ≤ intersectionLength q P Q

/-- Slice the affine proper intersection cycle, retaining its local multiplicities. -/
def c4 : Prop :=
  ∀ (P Q : Jet), ProperPair P Q → ∀ (qs : Finset Surface) (n : ℕ), 0 < n →
