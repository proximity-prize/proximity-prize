theorem smallFactor_official {f : Row 4} (hf : K1A_13.SmallFactor f) : SmallFactor f :=
  ⟨hf.1, hf.2.1, hf.2.2.1, fun m hm => (hf.2.2.2 m hm).trans (by decide)⟩

theorem weight_official {Q : Row 4} (hQ : TrueWeightLE Q (3000 * 180255 - 1)) :
