theorem exists_view_degree_pos (F : Jet) (hf : UsesSeed F) :
    ∃ i : Fin 2, 0 < (view i F).natDegree := by
  obtain ⟨j, k, h⟩ := hf
  obtain ⟨d, hd, hp⟩ := Finset.lt_sup_iff.mp h
  obtain ⟨i, hi⟩ : ∃ i, 0 < d i := by
    by_contra! hzero
