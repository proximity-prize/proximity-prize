          eval_mul, eval_pow, eval_X] at h
        exact (mul_eq_zero.mp h).resolve_left
          (pow_ne_zero _ (sub_ne_zero.mpr (hne i)))
      have hc := FrobeniusLocator.Strata.root_nodes_card_le site hinj Q hQ0 sites hroots
