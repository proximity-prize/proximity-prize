    obtain ⟨x, hx, y, hy, hxy⟩ := hD (D + k) (Nat.le_add_right D k) w hw
    change φ w ∈ _
    rw [hxy, map_add, map_mul]
    exact add_mul_mem_powerSpan_succ _ _ _
      (ih (Submodule.mem_map_of_mem hx)) (ih (Submodule.mem_map_of_mem hy))

