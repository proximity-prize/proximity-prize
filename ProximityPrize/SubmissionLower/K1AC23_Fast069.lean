    simpa only [slopeForm, map_sum, map_mul, aeval_C, aeval_X, u] using hz
  have hs : ∑ j, b j • u j = 0 := by
    change ∑ j, ((x i)⁻¹ * x j) * u j = 0
    simp_rw [mul_assoc, mul_comm (x _) (u _)]
    rw [← Finset.mul_sum, hsum, mul_zero]
