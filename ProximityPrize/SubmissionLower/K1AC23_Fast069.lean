  rw [← Polynomial.hom_eval₂, ← Polynomial.eval₂_map, Polynomial.eval₂_C_X]

private theorem factorial_ne_zero {i : ℕ} (hi : i < p) : (i.factorial : FX) ≠ 0 := by
