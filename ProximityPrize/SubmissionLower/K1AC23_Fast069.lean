      exact taylor_term S x _ ((Nat.succ_le_of_lt (Finset.mem_range.mp hi)).trans_lt hdp)

private theorem padding {d i : ℕ} (hi : i ∈ Finset.range d) :
    taylorPower d - (2*i+1) + (2*i+1) = taylorPower d := by
