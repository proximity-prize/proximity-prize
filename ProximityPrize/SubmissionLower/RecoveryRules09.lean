namespace ProximityPrize.SubmissionLower.Codec3
open DZ ZH ASH EMC
open AIX ACI BPE BZK AQS
set_option autoImplicit false
set_option maxHeartbeats 5000000
set_option maxRecDepth 100000

def quickChild (q u slope charge lo hi start : ℕ) (p : Piece) : Bool :=
 DirectNat80909.fastCheck (ChildLineData80909.base q u 0) (ChildLineData80909.rate q u 0) charge slope lo hi start p ||
 (DirectNat80909.fastCheck (ChildLineData80909.base q u 1) (ChildLineData80909.rate q u 1) charge slope lo hi start p ||
 DirectNat80909.child slope charge lo hi start p (UD.single q u).curve)

lemma or_eq (a b : Bool) (h : a=true → b=true) : (a || b)=b := by
 cases a <;> cases b <;> simp_all

lemma quickChild_eq (q u slope charge lo hi start : ℕ) (p : Piece)
 (hq : 10≤q) (hQ : q≤19) (hu : u≤70) (hcut : hi≤7000) :
 quickChild q u slope charge lo hi start p=Codec2.child slope charge lo hi start p (UD.single q u).curve := by
 have h0 := ChildLineKernel80909.child_of_fast (ChildLineData80909.base q u 0) (ChildLineData80909.rate q u 0)
   charge slope lo hi start p (UD.single q u).curve
   (ChildLineData80909.checked q u 0 hq hQ hu (by decide))
 have h1 := ChildLineKernel80909.child_of_fast (ChildLineData80909.base q u 1) (ChildLineData80909.rate q u 1)
   charge slope lo hi start p (UD.single q u).curve
   (ChildLineData80909.checked q u 1 hq hQ hu (by decide))
 unfold quickChild
 simp only [DirectNat80909.fastCheck_eq,DirectNat80909.child_eq]
 rw [or_eq _ _ (fun hf => h1 hf hcut)]
 exact or_eq _ _ (fun hf => h0 hf hcut)

def heavy (r v code lo hi start : ℕ) (p : Piece) : Bool :=
 if r≤19 ∧ v≤70 ∧ hi≤7000 then
  Nat.blt (DirectNat80909.digit code 0) 14 && lineCheck (light_slope (DirectNat80909.digit code 0)) (LightFast80909.num (DirectNat80909.digit code 0) r v) lo hi start p &&
  allK (fun i => allK (fun u =>
   let q := i+10
   let j := DirectNat80909.choice code v q u
   Nat.blt j 14 && quickChild q u (light_slope j) (LightFast80909.num j (r-q) (v-u)) lo hi start p) (v+1)) (r-9)
 else Codec2.heavy r v code lo hi start p

lemma heavy_eq_kernel (r v code lo hi start : ℕ) (p : Piece) :
 heavy r v code lo hi start p=Codec2.heavy r v code lo hi start p := by
 by_cases h : r≤19 ∧ v≤70 ∧ hi≤7000
 · simp only [heavy,if_pos h,LightFast80909.num_eq,Codec2.heavy,DirectNat80909.choice_eq,DirectNat80909.digit_eq]
   congr 1
   apply allK_congr
   intro i hi'
   apply allK_congr
   intro u hu
   rw [quickChild_eq _ _ _ _ _ _ _ _ (by omega) (by omega) (by omega) h.2.2]
 · simp only [heavy,if_neg h]
lemma heavy_eq (r v code lo hi start : ℕ) (p : Piece) :
 heavy r v code lo hi start p=heavyC r v code lo hi start p :=
 (heavy_eq_kernel r v code lo hi start p).trans (Codec2.heavy_eq r v code lo hi start p)

def base (r v aux lo hi start : ℕ) (p : Piece) : Bool :=
 if aux<8 then lineCheck (full_slope aux) (fullNum aux r v) lo hi start p
 else decide (aux%16=15 ∧ 10≤r ∧ r≤19 ∧ v≤70 ∧ hi≤7000) && heavy r v (aux/16) lo hi start p
theorem base_eq (r v aux lo hi start : ℕ) (p : Piece) :
 base r v aux lo hi start p=baseC r v aux lo hi start p := by
 simp only [base,baseC,heavy_eq]

def rule (r v code aux lo hi start : ℕ) (p : Piece) : Bool :=
 if code=0 then base r v aux lo hi start p
 else if code≤8 then phaseCheck r v (code-1) lo hi start p
 else if code=9 then DTO r v lo hi start p
 else if code≤13 then Codec2.exact r v (code-7) lo hi start p
 else if code=14 then Codec2.exact r v aux lo hi start p else false
theorem rule_eq (r v code aux lo hi start : ℕ) (p : Piece) :
 rule r v code aux lo hi start p=ruleC r v code aux lo hi start p := by
 simp only [rule,ruleC,base_eq,Codec2.exact_eq]

def pair (r v rlo : ℕ) (item : Piece) (start : ℕ) (p : Piece) : Bool :=
 let lo := max rlo start
 let stop := min item.stop p.stop
 if lo<stop then rule r v item.base item.slope lo (stop-1) start p else true
theorem pair_eq (r v rlo : ℕ) (item : Piece) (start : ℕ) (p : Piece) :
 pair r v rlo item start p=pairC r v rlo item start p := by
 simp only [pair,pairC,rule_eq]

def index (r v : ℕ) (curve rules : List Piece) (i : ℕ) : Bool :=
 if i<rules.length then cellsK (pair r v (startAt 0 rules i) (get rules i)) curve 0 else true
theorem index_eq (r v : ℕ) (curve rules : List Piece) (i : ℕ) :
 index r v curve rules i=indexC r v curve rules i := by
 have he := funext (fun start => funext (fun p => pair_eq r v (startAt 0 rules i) (get rules i) start p))
 simp only [index,indexC,he]

def block (r v : ℕ) (curve rules : List Piece) (b : ℕ) : Bool :=
 allK (fun j => index r v curve rules (8*b+j)) 8
theorem block_eq (r v : ℕ) (curve rules : List Piece) (b : ℕ) :
 block r v curve rules b=blockC r v curve rules b := by
 simp only [block,blockC,index_eq]

lemma split (r v : ℕ) (curve rules : List Piece) (b : ℕ)
 (h0 : index r v curve rules (8*b+0)=true)
 (h1 : index r v curve rules (8*b+1)=true)
 (h2 : index r v curve rules (8*b+2)=true)
 (h3 : index r v curve rules (8*b+3)=true)
 (h4 : index r v curve rules (8*b+4)=true)
 (h5 : index r v curve rules (8*b+5)=true)
 (h6 : index r v curve rules (8*b+6)=true)
 (h7 : index r v curve rules (8*b+7)=true)
 : block r v curve rules b=true := by
 change ((((((((true && index r v curve rules (8*b+0)) && index r v curve rules (8*b+1)) && index r v curve rules (8*b+2)) && index r v curve rules (8*b+3)) && index r v curve rules (8*b+4)) && index r v curve rules (8*b+5)) && index r v curve rules (8*b+6)) && index r v curve rules (8*b+7))=true
 simp only [Bool.and_eq_true]
 tauto

theorem of_blocks (r v : ℕ) (curve rules : List Piece) (n : ℕ)
 (hR : r≤28) (hy : r+v≤117)
 (hv : validFrom (11193-r-v) 0 rules=true) (hn : rules.length≤8*n)
 (hc : ∀ b,b<n → block r v curve rules b=true) : checkRow r v curve rules=true := by
 apply ASE.AG r v curve rules n hR hy hv hn
 intro b hb
 rw [←block_eq]
 exact hc b hb

theorem one (r v : ℕ) (curve rules : List Piece)
 (hR : r≤28) (hy : r+v≤117)
 (hv : validFrom (11193-r-v) 0 rules=true) (hn : rules.length≤8)
 (hc : block r v curve rules 0=true) : checkRow r v curve rules=true := by
 apply of_blocks r v curve rules 1 hR hy hv hn
 intro b hb
 have he : b=0 := by omega
 simpa only [he] using hc

end ProximityPrize.SubmissionLower.Codec3
end
