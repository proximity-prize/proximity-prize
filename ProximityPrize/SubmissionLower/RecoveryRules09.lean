namespace ProximityPrize.SubmissionLower.DirectNat80909
open DZ ACI ASH
set_option autoImplicit false
set_option maxHeartbeats 10000000
lemma ble_cond {α : Sort _} (a b : ℕ) (x y : α) :
 (bif Nat.ble a b then x else y)=(if a≤b then x else y) := by
 by_cases h:a≤b <;> simp [h,Nat.ble_eq]
lemma blt_cond {α : Sort _} (a b : ℕ) (x y : α) :
 (bif Nat.blt a b then x else y)=(if a<b then x else y) := by
 by_cases h:a<b <;> simp [h,Nat.blt_eq]

def fastCheck (B S charge slope lo hi start : ℕ) (p : Piece) : Bool :=
 let rate := Nat.max S slope
 let z := bif Nat.ble rate p.slope then lo else hi
 Nat.ble (Nat.add (Nat.add B charge) (Nat.mul rate z))
  (Nat.add (Nat.add p.base (Nat.mul p.slope (Nat.sub lo start))) (Nat.mul p.slope (Nat.sub z lo)))
lemma fastCheck_eq (B S charge slope lo hi start : ℕ) (p : Piece) :
 fastCheck B S charge slope lo hi start p=ChildLineKernel80909.fastCheck B S charge slope lo hi start p := by
 simp only [fastCheck,ble_cond,ChildLineKernel80909.fastCheck,ChildLineKernel80909.affineCheck,ChildLineKernel80909.affine,value,Nat.sub_zero]
 rfl

def digit (code i : ℕ) : ℕ := Nat.mod (Nat.div (GSY code) (Nat.pow 16 i)) 16
lemma digit_eq (code i : ℕ) : digit code i=ACI.digit code i := rfl
def choice (code v q u : ℕ) : ℕ := digit code (Nat.add (Nat.add 1 (Nat.mul (Nat.sub q 10) (Nat.add v 1))) u)
lemma choice_eq (code v q u : ℕ) : choice code v q u=heavyChoice code v q u := rfl

def selectZ (cs slope ps lo hi chi : ℕ) : ℕ :=
 bif Nat.ble cs slope then (bif Nat.ble slope ps then lo else hi)
 else bif Nat.ble cs ps then lo else bif Nat.ble ps slope then hi else Nat.min hi (Nat.max lo chi)
def selectX (cs slope clo chi z : ℕ) : ℕ :=
 bif Nat.ble cs slope then clo else Nat.min chi z
lemma selectZ_eq (cs slope ps lo hi chi : ℕ) :
 selectZ cs slope ps lo hi chi=VertexKernel80909.selectZ cs slope ps lo hi chi := by
 simp only [selectZ,ble_cond,VertexKernel80909.selectZ]
lemma selectX_eq (cs slope clo chi z : ℕ) :
 selectX cs slope clo chi z=VertexKernel80909.selectX cs slope clo chi z := by
 simp only [selectX,ble_cond,VertexKernel80909.selectX]

def triangle (cc cs clo chi charge slope pc ps plo phi : ℕ) : Bool :=
 bif Nat.ble clo chi then
  bif Nat.ble (Nat.max plo clo) phi then
   let z:=selectZ cs slope ps (Nat.max plo clo) phi chi
   let x:=selectX cs slope clo chi z
   Nat.ble (Nat.add (Nat.add (Nat.add cc (Nat.mul cs (Nat.sub x clo))) charge) (Nat.mul slope (Nat.sub z x)))
    (Nat.add pc (Nat.mul ps (Nat.sub z plo)))
  else true
 else true
lemma triangle_eq (cc cs clo chi charge slope pc ps plo phi : ℕ) :
 triangle cc cs clo chi charge slope pc ps plo phi=VertexKernel80909.triangle cc cs clo chi charge slope pc ps plo phi := by
 simp only [triangle,ble_cond,selectZ_eq,selectX_eq,VertexKernel80909.triangle]
 by_cases h:clo≤chi <;> by_cases h':max plo clo≤phi <;> simp only [h,h',and_self,if_true,if_false,false_and,and_false]
 rfl

def cellsAux (limit : ℕ) (test : ℕ→Piece→Bool) (ps : List Piece) : ℕ→Bool :=
 List.rec (motive:=fun _=>ℕ→Bool) (fun _=>true)
  (fun p _ ih start=>bif Nat.ble limit start then true else Bool.rec false (ih p.stop) (test start p)) ps
lemma cellsAux_eq (limit : ℕ) (test : ℕ→Piece→Bool) (ps : List Piece) (start : ℕ) :
 cellsAux limit test ps start=ASH.cellsAux limit test ps start := by
 induction ps generalizing start with
 | nil => rfl
 | cons p ps ih => simp only [cellsAux,ASH.cellsAux,ble_cond,ih]
def cells (limit : ℕ) (test : ℕ→Piece→Bool) (ps : List Piece) (start : ℕ) : Bool :=
 bif Nat.ble limit start then true else cellsAux limit test ps start
lemma cells_eq (limit : ℕ) (test : ℕ→Piece→Bool) (ps : List Piece) (start : ℕ) :
 cells limit test ps start=ASH.cells limit test ps start := by
 simp only [cells,ble_cond,ASH.cells,cellsAux_eq]
def child (slope charge lo hi start : ℕ) (p : Piece) (cs : List Piece) : Bool :=
 cells (Nat.add hi 1) (fun clo c=>triangle c.base c.slope clo (Nat.sub c.stop 1) charge slope
  (Nat.add p.base (Nat.mul p.slope (Nat.sub lo start))) p.slope lo hi) cs 0
lemma child_eq (slope charge lo hi start : ℕ) (p : Piece) (cs : List Piece) :
 child slope charge lo hi start p cs=Codec2.child slope charge lo hi start p cs := by
 simp only [child,cells_eq,triangle_eq,Codec2.child,value]
 rfl
end ProximityPrize.SubmissionLower.DirectNat80909
end
