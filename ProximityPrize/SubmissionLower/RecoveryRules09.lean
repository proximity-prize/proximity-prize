namespace ProximityPrize.SubmissionLower.ExactShardGroupFast80909
open DZ ZH ASH EMC
open AIX BPE
set_option autoImplicit false
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000

def Mode (r : ℕ) (rules : List Piece) (i : ℕ) : Prop :=
 (get rules i).base=14 ∧ r ≤ 28 ∧ i < rules.length
instance (r : ℕ) (rules : List Piece) (i : ℕ) : Decidable (Mode r rules i) := by
 unfold Mode
 infer_instance

def empty (r v j lo hi start : ℕ) (p : Piece) : Bool :=
 Nat.blt j 7 && Nat.ble (fastCut r v j) lo && exactEmpty r v j lo hi start p
def children (r v j q lo hi start : ℕ) (p : Piece) : Bool :=
 allK (fun u=>ExactMultiChild6816.child r v j lo hi start p q u) (v+1)
def fragment (r v j lo hi start : ℕ) (p : Piece) (k : ℕ) : Bool :=
 if k=0 then empty r v j lo hi start p
 else allK (fun t=>let i:=2*(k-1)+t
  if i < r-1 then children r v j (i+1) lo hi start p else true) 2

def pairPart (r v rlo : ℕ) (item : Piece) (k start : ℕ) (p : Piece) : Bool :=
 let lo:=max rlo start
 let stop:=min item.stop p.stop
 if lo < stop then fragment r v item.slope lo (stop-1) start p k else true

def part (r v : ℕ) (curve rules : List Piece) (i k : ℕ) : Bool :=
 cellsK (pairPart r v (startAt 0 rules i) (get rules i) k) curve 0

lemma allK_sound (test : ℕ→Bool) (n : ℕ) (h : allK test n=true) (i : ℕ) (hi : i  <  n) : test i=true := by
 rw [allK_eq] at h
 exact CL.allN_sound test n h i hi
lemma allK_of_true (test : ℕ→Bool) (n : ℕ) (h : ∀i,i  <  n→test i=true) : allK test n=true := by
 induction n with
 | zero => rfl
 | succ n ih =>
  change Bool.rec false (test n) (allK test n)=true
  rw [ih (fun i hi=>h i (by omega)),h n (by omega)]
lemma cells_cons (test : ℕ→Piece→Bool) (p : Piece) (ps : List Piece) (start : ℕ) :
 cellsK test (p::ps) start=(test start p && cellsK test ps p.stop) := by
 change Bool.rec (motive:=fun _=>Bool) false (cellsK test ps p.stop) (test start p)=(test start p && cellsK test ps p.stop)
 cases test start p <;> rfl
lemma cells_from_tests (n : ℕ) (test : ℕ→ℕ→Piece→Bool) (f : ℕ→Piece→Bool)
 (ps : List Piece) (start : ℕ)
 (hs : ∀k,k  <  n→cellsK (test k) ps start=true)
 (hf : ∀s p,(∀k,k  <  n→test k s p=true)→f s p=true) : cellsK f ps start=true := by
 induction ps generalizing start with
 | nil => rfl
 | cons p ps ih =>
  have hh (k : ℕ) (hk : k  <  n) : test k start p=true ∧ cellsK (test k) ps p.stop=true := by
   simpa only [cells_cons,Bool.and_eq_true] using hs k hk
  rw [cells_cons,Bool.and_eq_true]
  exact ⟨hf start p (fun k hk=>(hh k hk).1),ih p.stop (fun k hk=>(hh k hk).2)⟩


lemma fragment_combine (r v j lo hi start : ℕ) (p : Piece) (hR : r ≤ 28)
 (h : ∀k,k < 15→fragment r v j lo hi start p k=true) : Codec2.exact r v j lo hi start p=true := by
 have h0:=h 0 (by decide)
 simp only [fragment,ite_true] at h0
 have hc : allK (fun i=>children r v j (i+1) lo hi start p) (r-1)=true := by
  apply allK_of_true
  intro i hi'
  let g:=1+i/2
  have hg:g < 15:=by dsimp [g];omega
  have hg0:g≠0:=by dsimp [g];omega
  have hh:=h g hg
  simp only [fragment,if_neg hg0] at hh
  have hu:=allK_sound _ 2 hh (i%2) (by omega)
  have he:2*(g-1)+i%2=i:=by dsimp [g];omega
  simpa only [he,if_pos hi'] using hu
 simp only [children,ExactMultiChild6816.child_eq,DirectExact80909.child_eq] at hc
 change (empty r v j lo hi start p && allK (fun i=>allK (fun u=>Codec2.exactChild r v j lo hi start p (i+1) u) (v+1)) (r-1))=true
 rw [Bool.and_eq_true]
 exact ⟨h0,hc⟩

lemma pair_combine (r v rlo : ℕ) (item : Piece) (start : ℕ) (p : Piece)
 (hb : item.base=14) (hR : r ≤ 28)
 (h : ∀k,k < 15→pairPart r v rlo item k start p=true) : CodecGroupFast80909.pair r v rlo item start p=true := by
 by_cases hl:max rlo start < min item.stop p.stop
 · let lo:=max rlo start
   let hi:=min item.stop p.stop-1
   have hh : ∀k,k < 15→fragment r v item.slope lo hi start p k=true := by
    intro k hk
    simpa only [pairPart,if_pos hl] using h k hk
   have he:=fragment_combine r v item.slope lo hi start p hR hh
   simpa only [CodecGroupFast80909.pair,if_pos hl,CodecGroupFast80909.rule,hb,
    show (14:ℕ)≠0 by decide,show ¬(14:ℕ) ≤ 8 by decide,
    show (14:ℕ)≠9 by decide,show ¬(14:ℕ) ≤ 13 by decide,ite_false,ite_true] using he
 · simp only [CodecGroupFast80909.pair,if_neg hl]

theorem split (r v : ℕ) (curve rules : List Piece) (i : ℕ)
 (hm : Mode r rules i)
 (h0 : part r v curve rules i 0=true)
 (h1 : part r v curve rules i 1=true)
 (h2 : part r v curve rules i 2=true)
 (h3 : part r v curve rules i 3=true)
 (h4 : part r v curve rules i 4=true)
 (h5 : part r v curve rules i 5=true)
 (h6 : part r v curve rules i 6=true)
 (h7 : part r v curve rules i 7=true)
 (h8 : part r v curve rules i 8=true)
 (h9 : part r v curve rules i 9=true)
 (h10 : part r v curve rules i 10=true)
 (h11 : part r v curve rules i 11=true)
 (h12 : part r v curve rules i 12=true)
 (h13 : part r v curve rules i 13=true)
 (h14 : part r v curve rules i 14=true)
 : CodecGroupFast80909.index r v curve rules i=true := by
 rcases hm with ⟨hb,hR,hi⟩
 simp only [CodecGroupFast80909.index,if_pos hi]
 apply cells_from_tests 15 (fun k=>pairPart r v (startAt 0 rules i) (get rules i) k)
 · intro k hk
   interval_cases k <;> assumption
 · intro start p h
   exact pair_combine r v (startAt 0 rules i) (get rules i) start p hb hR h
#print axioms split
end ProximityPrize.SubmissionLower.ExactShardGroupFast80909
end
