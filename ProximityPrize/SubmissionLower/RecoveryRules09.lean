  (Nat.add (Nat.add
   (Nat.mul (Nat.add 1 (Nat.mul 262142 y)) (Nat.add (Nat.mul r L) (Nat.mul t S)))
   (Nat.mul (Nat.mul 131071 (Nat.sub (Nat.mul 2 r) 1)) (Nat.add (Nat.mul y L) (Nat.mul t U))))
