open DZ ASH BPE AQS
set_option autoImplicit false
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000

def other(r v j lo hi start:ℕ)(p:Piece)(q u:ℕ):Bool:=
 bif ExactBoolGuard6816.other hi q u (ExactLineWordData6816.row q u) (min (fastCut q u j) (hi+1)) (fastCut q u 4) then
  ExactLineKernel6816.test (src j).totalCap (src j).middleCap (src j).slopeCap
   (r-q) (r-q+(v-u)) (ExactLineWordData6816.base q u) (ExactLineWordData6816.rate q u) lo hi start p ||
  DirectExact80909.child r v j lo hi start p q u
 else DirectExact80909.child r v j lo hi start p q u
lemma other_eq(r v j lo hi start:ℕ)(p:Piece)(q u:ℕ):
 other r v j lo hi start p q u=DirectExact80909.child r v j lo hi start p q u:=by
 unfold other
 rw [ExactBoolGuard6816.other_cond]
 split_ifs with h
 · rcases h with ⟨hcap,hq,hQ,hu,hr,hdom⟩
   apply Codec3.or_eq
   intro hf
   have hc:=ExactMultiKernel6816.child_of_fast 4800 (src j).totalCap (src j).middleCap (src j).slopeCap
    (r-q) (r-q+(v-u)) (ExactLineWordData6816.base q u) (ExactLineWordData6816.rate q u) lo hi start (fastCut q u j) (fastCut q u 4) p (UD.final q u)
    (ExactLineWordData6816.checked q u hq hQ hu hr) hf hcap hdom
   unfold DirectExact80909.child
   with_unfolding_all exact hc
 · rfl
def child(r v j lo hi start:ℕ)(p:Piece)(q u:ℕ):Bool:=
 if j=4 then ExactLineWordChild6816.child r v j lo hi start p q u else other r v j lo hi start p q u
lemma child_eq(r v j lo hi start:ℕ)(p:Piece)(q u:ℕ):
 child r v j lo hi start p q u=DirectExact80909.child r v j lo hi start p q u:=by
 unfold child
 split_ifs <;> simp only [ExactLineWordChild6816.child_eq,other_eq]
end ProximityPrize.SubmissionLower.ExactMultiChild6816
end
