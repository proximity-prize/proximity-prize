def exactPiece (L U S r y lo hi start:ℕ) (p:Piece) (cut cstart:ℕ) (c:Piece):Bool:=
 Bool.rec true
  (VertexKernel80909.triangle
   (50164*c.base+CY.num L U S r y y+1) (50164*c.slope)
   cstart (min c.stop cut-1) 0 (BND.tSlope L U S r y)
   (50164*(value p start lo+1)) (50164*p.slope) lo hi)
  (Nat.blt cstart (min c.stop cut))
theorem exactPiece_eq (L U S r y lo hi start:ℕ) (p:Piece) (cut cstart:ℕ) (c:Piece):
 exactPiece L U S r y lo hi start p cut cstart c=CAH L U S r y lo hi start p cut cstart c:=by
 by_cases h:cstart<min c.stop cut
 · have hb:Nat.blt cstart (min c.stop cut)=true:=by simpa only [Nat.blt_eq] using h
   simp only [exactPiece,hb,CAH,if_pos h,VertexKernel80909.triangle_eq]
 · have hb:Nat.blt cstart (min c.stop cut)=false:=by
    apply Bool.eq_false_iff.mpr
    intro he
    apply h
    simpa only [Nat.blt_eq] using he
   simp only [exactPiece,hb,CAH,if_neg h]

def exactChild (r v j lo hi start:ℕ) (p:Piece) (q u:ℕ):Bool:=
 cells (min (fastCut q u j) (hi+1))
  (fun cstart c=>exactPiece (src j).totalCap (src j).middleCap (src j).slopeCap (r-q) ((r-q)+(v-u))
   lo hi start p (fastCut q u j) cstart c) (UD.final q u) 0
theorem exactChild_eq (r v j lo hi start:ℕ) (p:Piece) (q u:ℕ):
 exactChild r v j lo hi start p q u=exactChildC r v j lo hi start p q u:=by
 simp only [exactChild,exactChildC,exactPiece_eq]

def exact (r v j lo hi start:ℕ) (p:Piece):Bool:=
 Nat.blt j 7 && Nat.ble (fastCut r v j) lo && exactEmpty r v j lo hi start p &&
 allK (fun i=>allK (fun u=>exactChild r v j lo hi start p (i+1) u) (v+1)) (r-1)
theorem exact_eq (r v j lo hi start:ℕ) (p:Piece):
 exact r v j lo hi start p=exactC r v j lo hi start p:=by
 simp only [exact,exactC,exactChild_eq]

def child (slope charge lo hi start:ℕ) (p:Piece) (cs:List Piece):Bool:=
 cells (hi+1) (fun clo c=>VertexKernel80909.triangle c.base c.slope clo (c.stop-1)
  charge slope (value p start lo) p.slope lo hi) cs 0
theorem child_eq (slope charge lo hi start:ℕ) (p:Piece) (cs:List Piece):
 child slope charge lo hi start p cs=childC slope charge lo hi start p cs:=by
 simp only [child,childC,childPiece,VertexKernel80909.triangle_eq]
 rfl

def heavy (r v code lo hi start:ℕ) (p:Piece):Bool:=
 Nat.blt (digit code 0) 14 && lineCheck (light_slope (digit code 0)) (lightNum (digit code 0) r v) lo hi start p &&
 allK (fun i=>allK (fun u=>
  let q:=i+10
  let j:=heavyChoice code v q u
  Nat.blt j 14 && child (light_slope j) (lightNum j (r-q) (v-u)) lo hi start p
   (UD.single q u).curve) (v+1)) (r-9)
theorem heavy_eq (r v code lo hi start:ℕ) (p:Piece):
 heavy r v code lo hi start p=heavyC r v code lo hi start p:=by
 simp only [heavy,heavyC,child_eq]

def base (r v aux lo hi start:ℕ) (p:Piece):Bool:=
 if aux<8 then lineCheck (full_slope aux) (fullNum aux r v) lo hi start p
 else decide (aux%16=15∧10≤r∧r≤19∧v≤70∧hi≤7000) && heavy r v (aux/16) lo hi start p
theorem base_eq (r v aux lo hi start:ℕ) (p:Piece):
 base r v aux lo hi start p=baseC r v aux lo hi start p:=by
 simp only [base,baseC,heavy_eq]

def rule (r v code aux lo hi start:ℕ) (p:Piece):Bool:=
 if code=0 then base r v aux lo hi start p
 else if code≤8 then phaseCheck r v (code-1) lo hi start p
 else if code=9 then DTO r v lo hi start p
 else if code≤13 then exact r v (code-7) lo hi start p
 else if code=14 then exact r v aux lo hi start p else false
theorem rule_eq (r v code aux lo hi start:ℕ) (p:Piece):
 rule r v code aux lo hi start p=ruleC r v code aux lo hi start p:=by
 simp only [rule,ruleC,base_eq,exact_eq]

def pair (r v rlo:ℕ) (item:Piece) (start:ℕ) (p:Piece):Bool:=
 let lo:=max rlo start
 let stop:=min item.stop p.stop
 if lo<stop then rule r v item.base item.slope lo (stop-1) start p else true
theorem pair_eq (r v rlo:ℕ) (item:Piece) (start:ℕ) (p:Piece):
 pair r v rlo item start p=pairC r v rlo item start p:=by
 simp only [pair,pairC,rule_eq]

def index (r v:ℕ) (curve rules:List Piece) (i:ℕ):Bool:=
 if i<rules.length then cellsK (pair r v (startAt 0 rules i) (get rules i)) curve 0 else true
theorem index_eq (r v:ℕ) (curve rules:List Piece) (i:ℕ):
 index r v curve rules i=indexC r v curve rules i:=by
 have he:=funext (fun start=>funext (fun p=>pair_eq r v (startAt 0 rules i) (get rules i) start p))
 simp only [index,indexC,he]

def block (r v:ℕ) (curve rules:List Piece) (b:ℕ):Bool:=
 allK (fun j=>index r v curve rules (8*b+j)) 8
theorem block_eq (r v:ℕ) (curve rules:List Piece) (b:ℕ):
 block r v curve rules b=blockC r v curve rules b:=by
 simp only [block,blockC,index_eq]

lemma split (r v:ℕ) (curve rules:List Piece) (b:ℕ)
 (h0:index r v curve rules (8*b+0)=true)
 (h1:index r v curve rules (8*b+1)=true)
 (h2:index r v curve rules (8*b+2)=true)
 (h3:index r v curve rules (8*b+3)=true)
 (h4:index r v curve rules (8*b+4)=true)
 (h5:index r v curve rules (8*b+5)=true)
 (h6:index r v curve rules (8*b+6)=true)
 (h7:index r v curve rules (8*b+7)=true)
 :block r v curve rules b=true:=by
