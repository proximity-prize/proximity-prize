  (Nat.mul (Nat.add 1 (Nat.mul 262142 y)) S)
  (Nat.mul (Nat.mul 131071 (Nat.sub (Nat.mul 2 r) 1)) U))
  (Nat.mul 262142 (Nat.add (Nat.mul y S) (Nat.mul r U))))
