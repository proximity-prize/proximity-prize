lemma decreasing (A B c lo z:ℤ) (ha:0≤A) (hab:A+B≤0) (hz:lo≤z):
    A*min c z+B*z≤A*min c lo+B*lo:=by
  have hm:min c z-min c lo≤z-lo:=by omega
  have h1:=mul_le_mul_of_nonneg_left hm ha
  have h2:=mul_nonpos_of_nonpos_of_nonneg hab (sub_nonneg.mpr hz)
  nlinarith

lemma increasing (A B c z hi:ℤ) (ha:0≤A) (hb:0≤B) (hz:z≤hi):
    A*min c z+B*z≤A*min c hi+B*hi:=by
  have hm:min c z≤min c hi:=by omega
  have h1:=mul_le_mul_of_nonneg_left hm ha
  have h2:=mul_le_mul_of_nonneg_left hz hb
  nlinarith

lemma peak (A B c lo hi z:ℤ) (ha:0≤A) (hb:B≤0) (hab:0≤A+B)
    (hz:lo≤z) (hzh:z≤hi):
    A*min c z+B*z≤A*min c (min hi (max lo c))+B*(min hi (max lo c)):=by
  by_cases hc:c≤lo
  · have hm:min hi (max lo c)=lo:=by omega
    rw [hm,min_eq_left (hc.trans hz),min_eq_left hc]
    have h:=mul_le_mul_of_nonpos_left hz hb
    linarith
  by_cases hhc:hi≤c
  · have hm:min hi (max lo c)=hi:=by omega
    rw [hm,min_eq_right (hzh.trans hhc),min_eq_right hhc]
    have h:=mul_le_mul_of_nonneg_left hzh hab
    nlinarith
  have hm:min hi (max lo c)=c:=by omega
  rw [hm,min_self]
  by_cases hzc:z≤c
  · rw [min_eq_right hzc]
    have h:=mul_le_mul_of_nonneg_left hzc hab
    nlinarith
  · rw [min_eq_left (by omega:c≤z)]
    have h:=mul_le_mul_of_nonpos_left (show c≤z by omega) hb
    linarith


def selectZ (cs slope ps lo hi chi:ℕ):ℕ:=
  if cs≤slope then (if slope≤ps then lo else hi)
  else if cs≤ps then lo else if ps≤slope then hi else min hi (max lo chi)

def selectX (cs slope clo chi z:ℕ):ℕ:=
  if cs≤slope then clo else min chi z

lemma dominate (cs slope ps clo chi lo hi x z:ℕ)
    (hc:clo≤chi) (hlc:clo≤lo) (hlh:lo≤hi)
    (hx:clo≤x) (hxh:x≤chi) (hxz:x≤z) (hlz:lo≤z) (hzh:z≤hi):
    ((cs:ℤ)-slope)*x+((slope:ℤ)-ps)*z≤
      ((cs:ℤ)-slope)*(selectX cs slope clo chi (selectZ cs slope ps lo hi chi))+
        ((slope:ℤ)-ps)*(selectZ cs slope ps lo hi chi):=by
  by_cases hcs:cs≤slope
  · simp only [selectX,selectZ,if_pos hcs]
    have hA:(cs:ℤ)-slope≤0:=by omega
    have hX:=mul_le_mul_of_nonpos_left (show (clo:ℤ)≤x by omega) hA
    by_cases hs:slope≤ps
    · rw [if_pos hs]
      have hZ:=mul_le_mul_of_nonpos_left (show (lo:ℤ)≤z by omega)
        (show (slope:ℤ)-ps≤0 by omega)
      linarith
    · rw [if_neg hs]
      have hZ:=mul_le_mul_of_nonneg_left (show (z:ℤ)≤hi by omega)
        (show 0≤(slope:ℤ)-ps by omega)
      linarith
  · simp only [selectX,selectZ,if_neg hcs]
    have hA:0≤(cs:ℤ)-slope:=by omega
    have hX:=mul_le_mul_of_nonneg_left (show (x:ℤ)≤min (chi:ℤ) z by omega) hA
    by_cases hcp:cs≤ps
    · rw [if_pos hcp]
      have h:=decreasing ((cs:ℤ)-slope) ((slope:ℤ)-ps) chi lo z hA (by omega) (by omega)
      push_cast
      push_cast at hX h
      linarith
    · rw [if_neg hcp]
      by_cases hps:ps≤slope
      · rw [if_pos hps]
        have h:=increasing ((cs:ℤ)-slope) ((slope:ℤ)-ps) chi z hi hA (by omega) (by omega)
        push_cast
        push_cast at hX h
        linarith
      · rw [if_neg hps]
        have h:=peak ((cs:ℤ)-slope) ((slope:ℤ)-ps) chi lo hi z hA (by omega) (by omega) (by omega) (by omega)
        push_cast
        push_cast at hX h
        linarith


open TP
lemma selected_bounds (cs slope ps clo chi lo hi:ℕ)
    (hc:clo≤chi) (hlc:clo≤lo) (hlh:lo≤hi):
    let z:=selectZ cs slope ps lo hi chi
    let x:=selectX cs slope clo chi z
    clo≤x∧x≤chi∧x≤z∧lo≤z∧z≤hi:=by
  dsimp only
  unfold selectZ selectX
  split_ifs<;>omega

lemma affine (cc cs clo charge slope pc ps plo x z:ℕ)
    (hx:clo≤x) (hxz:x≤z) (hp:plo≤z):
    (left cc cs clo charge slope x z:ℤ)-(right pc ps plo z:ℤ)=
      (cc:ℤ)+charge-pc-(cs:ℤ)*clo+(ps:ℤ)*plo+
        ((cs:ℤ)-slope)*x+((slope:ℤ)-ps)*z:=by
  simp only [left,right,Nat.cast_add,Nat.cast_mul,Nat.cast_sub hx,Nat.cast_sub hxz,Nat.cast_sub hp]
  ring

def triangle (cc cs clo chi charge slope pc ps plo phi:ℕ):Bool:=
  if clo≤chi∧max plo clo≤phi then
    let z:=selectZ cs slope ps (max plo clo) phi chi
    let x:=selectX cs slope clo chi z
    Nat.ble (left cc cs clo charge slope x z) (right pc ps plo z)
  else true

lemma triangle_sound (cc cs clo chi charge slope pc ps plo phi x z:ℕ)
    (h:triangle cc cs clo chi charge slope pc ps plo phi=true)
    (hx:clo≤x) (hxh:x≤chi) (hxz:x≤z) (hz:plo≤z) (hzh:z≤phi):
    left cc cs clo charge slope x z≤right pc ps plo z:=by
  have hc:clo≤chi∧max plo clo≤phi:=by omega
  let q:=selectZ cs slope ps (max plo clo) phi chi
  let p:=selectX cs slope clo chi q
  have hb:=selected_bounds cs slope ps clo chi (max plo clo) phi hc.1 (by omega) hc.2
  change clo≤p∧p≤chi∧p≤q∧max plo clo≤q∧q≤phi at hb
  simp only [triangle,if_pos hc,Nat.ble_eq] at h
  change left cc cs clo charge slope p q≤right pc ps plo q at h
  have hd:=dominate cs slope ps clo chi (max plo clo) phi x z hc.1 (by omega) hc.2 hx hxh hxz (by omega) hzh
  change ((cs:ℤ)-slope)*x+((slope:ℤ)-ps)*z≤((cs:ℤ)-slope)*p+((slope:ℤ)-ps)*q at hd
  have he:=affine cc cs clo charge slope pc ps plo x z hx hxz hz
  have hf:=affine cc cs clo charge slope pc ps plo p q hb.1 hb.2.2.1 (by omega)
  have hh:(left cc cs clo charge slope p q:ℤ)≤right pc ps plo q:=by exact_mod_cast h
  have hout:(left cc cs clo charge slope x z:ℤ)≤right pc ps plo z:=by linarith
  exact_mod_cast hout

lemma triangle_iff (cc cs clo chi charge slope pc ps plo phi:ℕ):
    triangle cc cs clo chi charge slope pc ps plo phi=true ↔
      check cc cs clo chi charge slope pc ps plo phi=true:=by
  by_cases hc:clo≤chi∧max plo clo≤phi
  · constructor
    · intro h
      simp only [check,if_pos hc]
      apply decide_eq_true
      simp only [EndAt]
      refine ⟨⟨?_,?_⟩,⟨?_,?_⟩,⟨?_,?_⟩⟩<;>
        apply triangle_sound cc cs clo chi charge slope pc ps plo phi _ _ h<;>omega
    · intro h
      have hb:=selected_bounds cs slope ps clo chi (max plo clo) phi hc.1 (by omega) hc.2
      simp only [triangle,if_pos hc,Nat.ble_eq]
      exact check_sound cc cs clo chi charge slope pc ps plo phi _ _ h hb.1 hb.2.1 hb.2.2.1 (by omega) hb.2.2.2.2
  · simp only [triangle,check,if_neg hc]

lemma triangle_eq (cc cs clo chi charge slope pc ps plo phi:ℕ):
    triangle cc cs clo chi charge slope pc ps plo phi=check cc cs clo chi charge slope pc ps plo phi:=by
  have h:=triangle_iff cc cs clo chi charge slope pc ps plo phi
  cases h1:triangle cc cs clo chi charge slope pc ps plo phi<;>
    cases h2:check cc cs clo chi charge slope pc ps plo phi<;>simp_all

