   · rcases hline with h0|h1
     · have hh:GroupKernel80909.boundTest r v code q k 0 lo hi start p=true:=by
        rw [←test_eq_old]
        exact h0
       have hp:=GroupKernel80909.bound_sound r v code q k 0 lo hi start p hq hQ hv hfull (by decide) hcut hlo hj0 hj1 hh
       rw [originalPair_full r v code q k lo hi start p hfull] at hp
       simpa only [GroupKernel80909.per,GroupKernel80909.jAt,GroupKernel80909.slopeAt,GroupKernel80909.charge,Bool.and_eq_true,Nat.blt_eq] using hp
     · have hh:GroupKernel80909.boundTest r v code q k 1 lo hi start p=true:=by
        rw [←test_eq_old]
        exact h1
       have hp:=GroupKernel80909.bound_sound r v code q k 1 lo hi start p hq hQ hv hfull (by decide) hcut hlo hj0 hj1 hh
       rw [originalPair_full r v code q k lo hi start p hfull] at hp
       simpa only [GroupKernel80909.per,GroupKernel80909.jAt,GroupKernel80909.slopeAt,GroupKernel80909.charge,Bool.and_eq_true,Nat.blt_eq] using hp
   · exact ⟨⟨hj0,hchildren.1⟩,⟨hj1,hchildren.2⟩⟩
 · rintro ⟨⟨hj0,hc0⟩,⟨hj1,hc1⟩⟩
   exact ⟨hj0,hj1,Or.inr ⟨hc0,hc1⟩⟩

lemma allK_succ(test:ℕ→Bool)(n:ℕ):allK test (n+1)=(allK test n && test n):=by rfl
lemma allK_pairs(test:ℕ→Bool)(k:ℕ):
 allK (fun j=>test (2*j) && test (2*j+1)) k=allK test (2*k):=by
 induction k with
 | zero=>rfl
 | succ k ih=>
  rw [allK_succ,ih,show 2*(k+1)=2*k+1+1 by omega,allK_succ,allK_succ]
  exact (Bool.and_assoc _ _ _).symm
lemma allK_pairs_tail(test:ℕ→Bool)(n:ℕ):
 (allK (fun j=>test (2*j) && test (2*j+1)) (n/2) &&
 (if n%2=0 then true else test (2*(n/2))))=allK test n:=by
 rw [allK_pairs]
 by_cases he:n%2=0
 · rw [if_pos he,Bool.and_true]
   congr 1
   omega
 · rw [if_neg he]
   have ho:n%2=1:=by omega
   have hn:n=2*(n/2)+1:=by omega
   conv_rhs => rw [hn,allK_succ]

