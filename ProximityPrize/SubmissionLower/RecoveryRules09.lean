     simp only [TP.left,TP.right]
     dsimp [cc,cs,pc,ps]
     change 50164*c.base+N+1+50164*c.slope*(x-clo)+0+T*(z-x)≤50164*(p.base+p.slope*(lo-start)+1)+50164*p.slope*(z-lo)
     nlinarith [hleft,hright,hrate,hstep]
   · simp only [VertexKernel80909.triangle,if_neg hd]
 · simp only [DirectExact80909.exactPiece,DirectNat80909.blt_cond,if_neg he]

