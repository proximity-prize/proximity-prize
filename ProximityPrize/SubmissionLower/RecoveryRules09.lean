   cstart (Nat.sub (Nat.min c.stop cut) 1) 0 (slope L U S r y)
   (Nat.mul 50164 (Nat.add (Nat.add p.base (Nat.mul p.slope (Nat.sub lo start))) 1))
   (Nat.mul 50164 p.slope) lo hi
