namespace ProximityPrize.SubmissionLower.SplitChild80909
open DZ ZH ASH EMC AIX ACI BPE BZK AQS
set_option autoImplicit false

def point(cc cs clo charge slope z pc:ℕ)(x:ℕ):Bool:=
 Nat.ble (cc+cs*(x-clo)+charge+slope*(z-x)) pc
def before(cc cs clo chi charge slope pc lo:ℕ):Bool:=
 bif Nat.ble clo chi then
  let x:=bif Nat.ble cs slope then clo else chi
  point cc cs clo charge slope lo pc x
 else true
def after(cc cs clo chi charge pc ps lo hi:ℕ):Bool:=
 bif Nat.ble clo chi then
  let x:=bif Nat.ble cs ps then clo else Nat.min hi chi
  Nat.ble (cc+cs*(x-clo)+charge) (pc+ps*(x-lo))
 else true
def fixedHi(cc cs clo chi charge slope pc hi:ℕ):Bool:=
 bif Nat.ble clo chi then
  let x:=bif Nat.ble cs slope then clo else Nat.min chi hi
  point cc cs clo charge slope hi pc x
 else true
def splitPiece(slope charge pc ps lo hi clo:ℕ)(c:Piece):Bool:=
 bif Nat.ble (c.stop-1) lo then before c.base c.slope clo (c.stop-1) charge slope pc lo
 else bif Nat.ble lo clo then after c.base c.slope clo (c.stop-1) charge pc ps lo hi
 else DirectNat80909.triangle c.base c.slope clo (c.stop-1) charge slope pc ps lo hi
def child(slope charge lo hi start:ℕ)(p:Piece)(cs:List Piece):Bool:=
 if lo≤hi then
  let pc:=p.base+p.slope*(lo-start)
  bif Nat.blt p.slope slope then
   DirectNat80909.cells (hi+1) (fun clo c=>fixedHi c.base c.slope clo (c.stop-1) charge slope (pc+p.slope*(hi-lo)) hi) cs 0
  else bif Nat.blt slope p.slope then
   DirectNat80909.cells (hi+1) (splitPiece slope charge pc p.slope lo hi) cs 0
  else DirectNat80909.child slope charge lo hi start p cs
 else DirectNat80909.child slope charge lo hi start p cs

def quickChild(q u slope charge lo hi start:ℕ)(p:Piece):Bool:=
 DirectNat80909.fastCheck (ChildLineData80909.base q u 0) (ChildLineData80909.rate q u 0) charge slope lo hi start p ||
 (DirectNat80909.fastCheck (ChildLineData80909.base q u 1) (ChildLineData80909.rate q u 1) charge slope lo hi start p ||
 child slope charge lo hi start p (UD.single q u).curve)

set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
lemma before_eq(cc cs clo chi charge slope pc ps lo hi:ℕ)
 (h:lo≤hi)(hs:slope<ps)(hc:chi≤lo):
 before cc cs clo chi charge slope pc lo=DirectNat80909.triangle cc cs clo chi charge slope pc ps lo hi:=by
 by_cases he:clo≤chi
 · have hclo:clo≤lo:=by omega
   have hsp:slope≤ps:=by omega
   by_cases hcs:cs≤slope
