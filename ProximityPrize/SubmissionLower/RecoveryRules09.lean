 simp only [block,blockC,index_eq]

lemma split (r v : ℕ) (curve rules : List Piece) (b : ℕ)
 (h0 : index r v curve rules (8*b+0)=true)
 (h1 : index r v curve rules (8*b+1)=true)
 (h2 : index r v curve rules (8*b+2)=true)
 (h3 : index r v curve rules (8*b+3)=true)
 (h4 : index r v curve rules (8*b+4)=true)
 (h5 : index r v curve rules (8*b+5)=true)
 (h6 : index r v curve rules (8*b+6)=true)
 (h7 : index r v curve rules (8*b+7)=true)
 : block r v curve rules b=true := by
 change ((((((((true && index r v curve rules (8*b+0)) && index r v curve rules (8*b+1)) && index r v curve rules (8*b+2)) && index r v curve rules (8*b+3)) && index r v curve rules (8*b+4)) && index r v curve rules (8*b+5)) && index r v curve rules (8*b+6)) && index r v curve rules (8*b+7))=true
 simp only [Bool.and_eq_true]
 tauto

theorem of_blocks (r v : ℕ) (curve rules : List Piece) (n : ℕ)
 (hR : r≤28) (hy : r+v≤117)
 (hv : validFrom (11193-r-v) 0 rules=true) (hn : rules.length≤8*n)
 (hc : ∀ b,b<n → block r v curve rules b=true) : checkRow r v curve rules=true := by
 apply ASE.AG r v curve rules n hR hy hv hn
 intro b hb
 rw [←block_eq]
 exact hc b hb

theorem one (r v : ℕ) (curve rules : List Piece)
 (hR : r≤28) (hy : r+v≤117)
 (hv : validFrom (11193-r-v) 0 rules=true) (hn : rules.length≤8)
 (hc : block r v curve rules 0=true) : checkRow r v curve rules=true := by
 apply of_blocks r v curve rules 1 hR hy hv hn
 intro b hb
 have he : b=0 := by omega
 simpa only [he] using hc

