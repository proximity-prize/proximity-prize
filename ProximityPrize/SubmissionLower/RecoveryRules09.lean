set_option maxRecDepth 100000

lemma allK_of_true(test:ℕ→Bool)(n:ℕ)(h:∀i,i<n→test i=true):allK test n=true:=by
 induction n with
 | zero=>rfl
 | succ n ih=>
  change Bool.rec false (test n) (allK test n)=true
  rw [ih (fun i hi=>h i (by omega)),h n (by omega)]

lemma fast_of_bound(B S C slope bigB bigR lo hi start:ℕ)(p:Piece)
 (hlo:lo≤hi)(hb:B+C≤bigB)(hr:max S slope≤bigR)
 (hf:DirectNat80909.fastCheck bigB bigR 0 0 lo hi start p=true):
 DirectNat80909.fastCheck B S C slope lo hi start p=true:=by
 let z:=if max S slope≤p.slope then lo else hi
 have hzl:lo≤z:=by dsimp [z];split <;> omega
 have hzh:z≤hi:=by dsimp [z];split <;> omega
 have hg:ChildLineKernel80909.affineCheck bigB bigR 0 (value p start lo) p.slope lo lo hi=true:=by
  simpa [DirectNat80909.fastCheck_eq,ChildLineKernel80909.fastCheck] using hf
 have hh:=ChildLineKernel80909.ETD bigB bigR 0 (value p start lo) p.slope lo lo hi z hg (by omega) (by omega) hzl hzh
 have hm:=Nat.mul_le_mul_right z hr
 simp only [ChildLineKernel80909.affine,Nat.sub_zero] at hh
 rw [DirectNat80909.fastCheck_eq]
 change Nat.ble (B+C+max S slope*z) (value p start lo+p.slope*(z-lo))=true
 apply Nat.ble_eq.mpr
 omega

def jAt(code v q u:ℕ):ℕ:=DirectNat80909.choice code v q u
def charge(r v code q u:ℕ):ℕ:=LightFast80909.num (jAt code v q u) (r-q) (v-u)
def slopeAt(code v q u:ℕ):ℕ:=light_slope (jAt code v q u)
def per(r v code q lo hi start:ℕ)(p:Piece)(u:ℕ):Bool:=
 Nat.blt (jAt code v q u) 14 &&
 Codec3.quickChild q u (slopeAt code v q u) (charge r v code q u) lo hi start p

def boundB(r v code q k line:ℕ):ℕ:=
 max (GroupBoundData80909.base q k 0 line+charge r v code q (2*k))
     (GroupBoundData80909.base q k 1 line+charge r v code q (2*k+1))
def boundR(v code q k line:ℕ):ℕ:=
 max (GroupBoundData80909.rate q k line) (max (slopeAt code v q (2*k)) (slopeAt code v q (2*k+1)))
def boundTest(r v code q k line lo hi start:ℕ)(p:Piece):Bool:=
 DirectNat80909.fastCheck (boundB r v code q k line) (boundR v code q k line) 0 0 lo hi start p
def originalPair(r v code q k lo hi start:ℕ)(p:Piece):Bool:=
 allK (fun t=>if 2*k+t≤v then per r v code q lo hi start p (2*k+t) else true) 2
lemma bound_sound(r v code q k line lo hi start:ℕ)(p:Piece)
 (hq:10≤q)(hQ:q≤19)(hv:v≤70)(hfull:2*k+1≤v)(hl:line<2)
 (hcut:hi≤4000)(hlo:lo≤hi)
 (hj0:jAt code v q (2*k)<14)(hj1:jAt code v q (2*k+1)<14)
 (hf:boundTest r v code q k line lo hi start p=true):
 originalPair r v code q k lo hi start p=true:=by
 unfold originalPair
 apply allK_of_true
 intro t ht
 have hu:2*k+t≤v:=by omega
 simp only [if_pos hu]
 let u:=2*k+t
 have hj:jAt code v q u<14:=by
  dsimp [u]
  interval_cases t
  · simpa only [Nat.add_zero] using hj0
  · exact hj1
 have hb:GroupBoundData80909.base q k t line+charge r v code q u≤boundB r v code q k line:=by
  dsimp [u]
  unfold boundB
  interval_cases t
  · simpa only [Nat.add_zero] using Nat.le_max_left (GroupBoundData80909.base q k 0 line+charge r v code q (2*k)) (GroupBoundData80909.base q k 1 line+charge r v code q (2*k+1))
  · exact Nat.le_max_right _ _
 have hr:max (GroupBoundData80909.rate q k line) (slopeAt code v q u)≤boundR v code q k line:=by
  unfold boundR
  apply max_le
  · exact le_max_left _ _
  · apply le_trans _ (le_max_right _ _)
    dsimp [u]
    interval_cases t
    · simpa only [Nat.add_zero] using (le_max_left (slopeAt code v q (2*k)) (slopeAt code v q (2*k+1)))
    · exact le_max_right _ _
 have hfast:=fast_of_bound (GroupBoundData80909.base q k t line) (GroupBoundData80909.rate q k line)
   (charge r v code q u) (slopeAt code v q u) (boundB r v code q k line) (boundR v code q k line) lo hi start p hlo hb hr hf
 have hdata:=GroupBoundData80909.checked q k t line hq hQ (by omega) ht hl
 have hc:=PrefixLineKernel80909.child_of_fast (GroupBoundData80909.base q k t line) (GroupBoundData80909.rate q k line)
   (charge r v code q u) (slopeAt code v q u) lo hi start p (UD.single q u).curve hdata
 have hfc:PrefixLineKernel80909.fastCheck (GroupBoundData80909.base q k t line) (GroupBoundData80909.rate q k line)
   (charge r v code q u) (slopeAt code v q u) lo hi start p=true:=by
  rw [DirectNat80909.fastCheck_eq] at hfast
  exact hfast
 have hchild:=hc hfc hcut
 unfold per
 rw [Bool.and_eq_true]
 refine ⟨Nat.blt_eq.mpr hj,?_⟩
 rw [Codec3.quickChild_eq q u _ _ _ _ _ _ hq hQ (by omega) (by omega)]
 exact hchild

#print axioms bound_sound
end ProximityPrize.SubmissionLower.GroupKernel80909
