   allK (fun k=>GroupKernel80909.per r v code q lo hi start p (2*k) && GroupKernel80909.per r v code q lo hi start p (2*k+1)) ((v+1)/2):=by
  apply allK_congr
  intro k hk
  exact pair_eq r v code q k lo hi start p hq hQ hv (by omega) hcut hlo
 unfold inner
 rw [hp]
