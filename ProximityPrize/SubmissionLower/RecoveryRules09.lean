def affine (cap:ℕ) (a s o z : ℕ) := a+s*(z-o)
def affineCheck (cap:ℕ) (a s o b t p lo hi : ℕ) : Bool :=
 let z := if s≤t then lo else hi
 Nat.ble (affine cap a s o z) (affine cap b t p z)

lemma affine_add (cap:ℕ) (a s o lo z : ℕ) (ho : o≤lo) (hz : lo≤z) :
 affine cap a s o z=affine cap a s o lo+s*(z-lo) := by
 have he : z-o=(lo-o)+(z-lo) := by omega
 simp only [affine,he,Nat.mul_add]
 omega

lemma ETD (cap:ℕ) (a s o b t p lo hi z : ℕ)
 (hc : affineCheck cap a s o b t p lo hi=true)
 (ho : o≤lo) (hp : p≤lo) (hz : lo≤z) (hzh : z≤hi) :
 affine cap a s o z≤affine cap b t p z := by
 by_cases hs : s≤t
 · simp only [affineCheck,if_pos hs,Nat.ble_eq] at hc
   have ha := affine_add cap a s o lo z ho hz
   have hb := affine_add cap b t p lo z hp hz
   have hm := Nat.mul_le_mul_right (z-lo) hs
   omega
 · simp only [affineCheck,if_neg hs,Nat.ble_eq] at hc
   have ha := affine_add cap a s o z hi (by omega) hzh
   have hb := affine_add cap b t p z hi (by omega) hzh
   have hm := Nat.mul_le_mul_right (hi-z) (show t≤s by omega)
   omega

def cellCheck (cap:ℕ) (B S start : ℕ) (c : Piece) : Bool :=
 affineCheck cap c.base c.slope start B S 0 start (max start (min cap (c.stop-1)))
def curveCheck (cap:ℕ) (B S : ℕ) (ps : List Piece) : Bool :=
 cells (cap+1) (cellCheck cap B S) ps 0

lemma cellCheck_sound (cap:ℕ) (B S start x : ℕ) (c : Piece)
 (hc : cellCheck cap B S start c=true) (hx : start≤x) (hxe : x≤c.stop-1) (hxcut : x≤cap) :
 value c start x≤B+S*x := by
 have h := ETD cap c.base c.slope start B S 0 start
