 DirectNat80909.cells (Nat.min (fastCut q u j) (Nat.add hi 1))
  (fun cstart c=>exactPiece (src j).totalCap (src j).middleCap (src j).slopeCap
   (Nat.sub r q) (Nat.add (Nat.sub r q) (Nat.sub v u)) lo hi start p (fastCut q u j) cstart c)
  (UD.final q u) 0
