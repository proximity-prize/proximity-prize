 apply cells_transfer cap (hi+1) (cap+1) (cellCheck cap B S)
   (fun clo c => VertexKernel80909.triangle c.base c.slope clo (c.stop-1) charge slope
     (value p start lo) p.slope lo hi) ps 0 (by omega) hcurve
