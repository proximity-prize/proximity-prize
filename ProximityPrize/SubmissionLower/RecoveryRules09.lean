open DZ ZH ASH
set_option autoImplicit false
theorem one (r v:ℕ) (curve rules:List Piece)
 (hR:r≤28) (hy:r+v≤117)
 (hv:validFrom (11193-r-v) 0 rules=true) (hn:rules.length≤8)
 (hc:blockC r v curve rules 0=true):checkRow r v curve rules=true:=by
 apply ASE.AG r v curve rules 1 hR hy hv hn
 intro b hb
 have he:b=0:=by omega
 simpa only [he] using hc
def readRules:ℕ→ℕ→ℕ→List Piece
 | 0,_,_=>[]
 | n+1,code,previous=>
  let digits:=code/262144%1024
  let payload:=code/268435456
  let aux:=payload%(16^digits)
  let tag:=code/16384%16
  let tail:=payload/(16^digits)
  if tag=0∧8≤aux then
   let value:=ACI.GSY (aux/16)
   let raw:=if aux%16=14 then Nat.xor previous value else value
   ⟨code%16384,tag,15+16*raw⟩::readRules n tail raw
  else ⟨code%16384,tag,aux⟩::readRules n tail previous

def rules (code:ℕ):List Piece:=readRules (code%65536) (code/65536) 0
end Codec1

end SubmissionLower
end ProximityPrize
