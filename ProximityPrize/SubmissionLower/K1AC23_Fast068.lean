    obtain ⟨G, R, hR, hstrip⟩ := ih Q hlt hQ0
    refine ⟨D * G, R, ?_, hstrip⟩
    rw [map_mul, mul_assoc, ← hR, ← hQ]
  · refine ⟨1, P, by rw [map_one, one_mul], ?_⟩
    exact fun D hD hdiv => h ⟨D, hD, hdiv⟩

