private theorem mem_cap {p : Plane F} {B J : ℕ} :
    p ∈ cap F B J ↔ p.totalDegree ≤ B ∧ p.degreeOf 1 ≤ J := by
  rw [mem_restrictCappedDegree, degreeOf_le_iff, totalDegree, Finset.sup_le_iff]
