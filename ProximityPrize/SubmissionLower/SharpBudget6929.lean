abbrev FlagFits (s : ℕ) (v : FactorPowers) : Prop :=
  v.degree ≤ residualDegree s ∧ v.maxIndex ≤ 48 ∧ v.maxTop ≤ 10

def witnessBound (s : ℕ) (g : ℤ) : SharpWitness → ℕ
  | .single v => flagBound s g v
  | .pair v w =>
    if FlagFits s v ∧ FlagFits s w then
      bandCount (residualDegree s) (-g) 48 10 + lcmBand s g v w -
        (flagKernel s g v + flagKernel s g w)
    else bandCount (residualDegree s) (-g) 48 10

theorem rank_le_witnessBound (s : ℕ) (g : ℤ) (W : SharpWitness) :
    Module.finrank Geom (LinearMap.range (blockMap s g)) ≤ witnessBound s g W := by
  cases W with
  | single v => exact rank_block_le_flag s g v
  | pair v w =>
    have hB : Module.Finite Geom (bandSpace (residualDegree s) (-g) 48 10) :=
      bandSpace_finite _ _ _ _
    simp only [witnessBound]
    split_ifs with h
    · have h2 := rank_block_le_twoFlag_proved s g v w h.1 h.2
      omega
    · rw [← finrank_bandSpace]
      exact LinearMap.finrank_range_le (blockMap s g)

