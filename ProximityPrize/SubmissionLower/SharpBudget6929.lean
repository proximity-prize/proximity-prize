def fastF (s : Fin 121) (r : Fin 138) : ℕ := fastBlock s r
def sharpG (s : Fin 121) (r : Fin 138) : ℕ := sharpBlock s r

theorem G_le_F (s : Fin 121) (r : Fin 138) : sharpG s r ≤ fastF s r := by
  unfold sharpG fastF sharpBlock
  split
  · exact le_rfl
  · exact min_le_left _ _

theorem key_of_find {s : Fin 121} {r : Fin 138} {W : SharpWitness}
    (h : sharpFind s r sharpData = some W) : (s, r) ∈ sharpKeys := by
  have hm := sharpFind_mem (s : ℕ) (r : ℕ) sharpData (by rw [h]; exact Option.some_ne_none W)
  obtain ⟨e, he, hee⟩ := List.mem_map.mp hm
  apply List.mem_map.mpr
  refine ⟨e, he, ?_⟩
  simp only [Prod.mk.injEq] at hee
  rw [hee.1, hee.2, Fin.cast_val_eq_self, Fin.cast_val_eq_self]

theorem G_off (s : Fin 121) (r : Fin 138) (h : (s, r) ∉ sharpKeys) : sharpG s r = fastF s r := by
  unfold sharpG fastF sharpBlock
  split
  · rfl
  · next W hW => exact absurd (key_of_find hW) h

theorem rank_block_le_sharp (s : Fin 121) (r : Fin 138) :
    Module.finrank Geom (LinearMap.range (blockMap s (offset r))) ≤ sharpG s r := by
  have hold : Module.finrank Geom (LinearMap.range (blockMap s (offset r))) ≤ fastBlock s r := by
    rw [fastBlock_eq]
    exact rank_block_le_budget K1_13_1_1_1.proof K1_13_1_1_2.proof K1_13_1_1_3.proof s (offset r)
      (Nat.le_of_lt_succ s.isLt) (by unfold offset; omega)
  unfold sharpG sharpBlock
  split
  · exact hold
  · exact le_min hold (rank_le_witnessBound _ _ _)

/-- One witness per block: Σ sharpG + Σ_keys (fastF - sharpG) = Σ fastF. -/
theorem sum_override (f g : Fin 121 → Fin 138 → ℕ) (keys : List (Fin 121 × Fin 138))
    (hnd : keys.Nodup) (hle : ∀ s r, g s r ≤ f s r)
    (heq : ∀ s r, (s, r) ∉ keys → g s r = f s r) :
    (∑ s, ∑ r, g s r) + (keys.map fun p => f p.1 p.2 - g p.1 p.2).sum = ∑ s, ∑ r, f s r := by
  have hF : (∑ s, ∑ r, (f s r - g s r)) = (keys.map fun p => f p.1 p.2 - g p.1 p.2).sum := by
    rw [← List.sum_toFinset _ hnd, ← Fintype.sum_prod_type']
    symm
    apply Finset.sum_subset (Finset.subset_univ _)
    intro p _ hp
    have hp' : (p.1, p.2) ∉ keys := by simpa using hp
    show f p.1 p.2 - g p.1 p.2 = 0
    rw [heq p.1 p.2 hp', Nat.sub_self]
  rw [← hF, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro s _
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro r _
  exact Nat.add_sub_cancel' (hle s r)

theorem fastTotal : (∑ s : Fin 121, ∑ r : Fin 138, fastF s r) = 9199626 := by
  rw [← totalBudget_eq, totalBudget_eq_sum]
  apply Finset.sum_congr rfl
  intro s _
  apply Finset.sum_congr rfl
  intro r _
  exact fastBlock_eq s r

