def sharpFind (s r : ℕ) : List (ℕ × ℕ × SharpWitness) → Option SharpWitness
  | [] => none
  | e :: l => if e.1 = s ∧ e.2.1 = r then some e.2.2 else sharpFind s r l

theorem sharpFind_mem (s r : ℕ) :
    ∀ l : List (ℕ × ℕ × SharpWitness), sharpFind s r l ≠ none →
      (s, r) ∈ l.map (fun e => (e.1, e.2.1))
  | [], h => absurd rfl h
  | e :: l, h => by
    simp only [List.map_cons, List.mem_cons]
    by_cases he : e.1 = s ∧ e.2.1 = r
    · left
      rw [he.1, he.2]
    · right
      simp only [sharpFind, if_neg he] at h
      exact sharpFind_mem s r l h

def sharpBlock (s r : ℕ) : ℕ :=
  match sharpFind s r sharpData with
  | none => fastBlock s r
  | some W => min (fastBlock s r) (witnessBound s (offset r) W)

