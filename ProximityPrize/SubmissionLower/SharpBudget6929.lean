theorem sharpTotal : (∑ s : Fin 121, ∑ r : Fin 138, sharpG s r) = 9198441 := by
  have h := sum_override fastF sharpG sharpKeys sharpKeys_nodup G_le_F G_off
  rw [fastTotal, sharpDelta] at h
  omega

/-- Per-node local rank with the sharpened budget (was 9199626). -/
theorem sharpRank (x y : Geom) :
    Module.finrank Geom (LinearMap.range (K1_13_1.anchorLocal x y)) ≤ 9198441 := by
  calc
    _ ≤ Module.finrank Geom (LinearMap.range (K1_13_1.anchorLocal 0 0)) := rank_local_le_origin x y
    _ ≤ ∑ s : Fin 121, ∑ r : Fin 138,
          Module.finrank Geom (LinearMap.range (blockMap s (offset r))) := rank_origin_le_blocks
    _ ≤ ∑ s : Fin 121, ∑ r : Fin 138, sharpG s r :=
      Finset.sum_le_sum fun s _ => Finset.sum_le_sum fun r _ => rank_block_le_sharp s r
    _ = 9198441 := sharpTotal

