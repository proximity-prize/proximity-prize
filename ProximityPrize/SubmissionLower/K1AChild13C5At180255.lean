theorem lowerRow_official {g : Row 3} (hg : K1A_13.LowerRow g) : K1_13.LowerRow g :=
  ⟨hg.1, hg.2.1, hg.2.2.1, fun m hm => (hg.2.2.2 m hm).trans (by decide)⟩

theorem of_children (h1 : c1) (h2 : c2) (h3 : c3) (h4 : c4) (h5 : c5) : K1A_13.c5 := by
  classical
  intro w Γ s h g hg hr
