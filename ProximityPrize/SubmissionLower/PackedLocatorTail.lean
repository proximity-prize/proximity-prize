    (reconstruct K D 131071 L S v.1) Dlow 131071 L S hDlow).mpr
  refine ⟨hsource.1, hsource.2.1, ?_⟩
  rw [heq]
  have hmul := wt_mul_le (contactWeights 131071) (F ^ j) Q
  have hp := wt_pow_le (contactWeights 131071) F j
