        (MvPolynomial.pderiv (2 : Fin 4)
          (MvPolynomial.pderiv (2 : Fin 4)
            (MvPolynomial.pderiv (2 : Fin 4) H)))))
    P gamma nodes u0 u1 support (m - 5) hcontact hvalues hdegreeStrict
