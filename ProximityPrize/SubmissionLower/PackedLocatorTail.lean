theorem coordinateShape_of_cached (h : CachedShapeAll) :
    CoordinateShape zeroDirect := by
  constructor
  · intro v z n hn28 hnv
    have cell := h (n + 1) (List.mem_range.mpr (by omega)) (by omega)
      v (List.mem_range.mpr (by omega))
