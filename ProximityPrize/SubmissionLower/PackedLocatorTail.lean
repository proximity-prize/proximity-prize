/-- Monotonicity restricted to the finite prefix `0, ..., N`. -/
def StepMonotone (f : ℕ → ℕ) (N : ℕ) : Prop :=
  ∀ n, n < N → f n ≤ f (n + 1)

/-- Midpoint convexity restricted to the finite prefix `0, ..., N`. -/
