      _ ≤ _:=Nat.mul_le_mul_right (total p) hk
  · by_cases ht64:total p ≤ 64
    · have hb:=below_cap_of_bounds p 64 64 7 (by decide) (by decide) hs hy ht64
      have hc:paddedCost 131072 131073 p ≤
