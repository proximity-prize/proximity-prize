    (q * w + r) w L s (q + 1) hcutoff hweight]
  rw [Finset.sum_comm]
  have hrows :
      (∑ j ∈ Finset.range (s + 1),
        ∑ i ∈ Finset.range (q + 1),
          (L + 1 - i - j) *
            (q * w + r - w * i - (w - 1) * j)) =
      ∑ j ∈ Finset.range (s + 1),
        oneResidueCoefficientRow q r w L j := by
    apply Finset.sum_congr rfl
    intro j hj
    have hjs : j ≤ s := by
      have := Finset.mem_range.mp hj
      omega
