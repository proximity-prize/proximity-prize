    (f g : ℕ → ℕ) (hf : Monotone f) (hg : Monotone g)
    (hcf : ∀ n, 2 * f (n + 1) ≤ f n + f (n + 2))
    (hcg : ∀ n, 2 * g (n + 1) ≤ g n + g (n + 2))
    (a b : ℕ) :
    f a + g b ≤ max (f (a + b) + g 0) (f 0 + g (a + b)) := by
