theorem sum_chainLength_sub_one_le (Q : MvPolynomial (Fin 4) K) (hQ : Q ≠ 0)
    (D w L s : ℕ) (hw : 0 < w) (hs : 1 ≤ s)
    (hbox : Q ∈ globalCoefficientBox K D w L s) :
    (∑ F ∈ positiveRFactors Q, (chainLength F - 1)) ≤ s - 1 ∧
      (positiveRFactors Q).card ≤ s := by
