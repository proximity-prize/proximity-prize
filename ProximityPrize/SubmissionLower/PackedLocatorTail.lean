theorem mem_low_of_highBandMap_eq_zero
    (Dhigh Dlow w delta T YS S:ℕ)
    (hwidth:Dhigh ≤ Dlow + delta) (P:MvPolynomial (Fin 4) K)
    (hP:P ∈ nestedCoefficientBox K Dhigh w T YS S)
