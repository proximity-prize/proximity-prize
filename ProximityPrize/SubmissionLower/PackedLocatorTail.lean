        (wt residualSWeights F.1)
        (L - wt residualTotalWeights F.1)
        (YS - wt residualYSWeights F.1) (S - wt residualSWeights F.1)
        b.tLo b.yLo b.rLo (L - b.tLo) (YS - b.yLo) (S - b.rLo)
        (steps + 1) hTstart hYstart hRstart hFT.1 hFY.1 hFR.1
