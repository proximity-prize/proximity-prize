        exact ⟨liftF, liftG⟩
      · rcases honeF with ⟨hdivF, ⟨vG, hvG⟩⟩
        let qF := quotientLinear qOne F hF hdivF
        have hdataF := quotientLinear_nested_data Dlow w T YS S qOne hqOne
