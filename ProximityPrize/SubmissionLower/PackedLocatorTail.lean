      have hjle : j ≤ Nat.succ steps := by
        simp only [j]
        omega
      have heqOriginal : reconstruct K D 131071 L S v.1 = F.1 ^ j * J := by
        calc
          reconstruct K D 131071 L S v.1 = F.1 * q v := hproduct v
          _ = F.1 * (F.1 ^ j0.val * J) := by rw [heq]
