  intro ι _ s p hpositive hslope hmiddle htotal
  classical
  by_cases hs : s.Nonempty
  · obtain ⟨i, hi⟩ := hs
    have hiSum : (p i).all ≤ ∑ j ∈ s, (p j).all := by
      exact Finset.single_le_sum
