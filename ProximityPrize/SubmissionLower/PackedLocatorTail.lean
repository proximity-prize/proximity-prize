    (Nat.mul_le_mul_right t hbound)
private theorem large_rate64 (t:ℕ) (hlo:64 ≤ t) (hhi:t ≤ 1698) :
    1698 * paddedCost 131072 131073 (cap t 64 7) ≤ lowCap6751 * t:=by
