    (MvPolynomial.pderiv (2:Fin 4) Q)
  have hmulS:=wt_mul_le residualSWeights (locator nodes)
    (MvPolynomial.pderiv (2:Fin 4) Q)
  have hmulC:=wt_mul_le (contactWeights w) (locator nodes)
    (MvPolynomial.pderiv (2:Fin 4) Q)
