    (hD : 0 < D) (hDa : D ≤ m * 181392)
    (hshape : D + S ≤ 131071 * (YS + 1))
    (hk : 1 ≤ k) (hkchar : k < 2130706433)
    (hband : powerBandBudget delta b.tLo b.yLo b.rLo
