    (∑ j ∈ Finset.range (s + 1),
      (L + 1 - i - j) * (D - w * i - (w - 1) * j)) =
        ∑ j ∈ Finset.range (J + 1),
          (L + 1 - i - j) * (D - w * i - (w - 1) * j) := htrim.symm
