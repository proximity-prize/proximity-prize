  intro hthreshold
  rcases hsufficient with hout | hroute
  · have hz : p.zOnly ≤ 5964 - (p.all + p.yz) := by
      simp only [total] at ht
      omega
    omega
  · have hcap : p.all + p.yz + p.zOnly ≤ s.totalCap := by
      simpa only [total, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using
        ht.trans hsourceCap
