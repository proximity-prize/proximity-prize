theorem sum_mixed_le {I:Type*} [Fintype I]
    (p:I → FlagDegree) (P q r:FlagDegree)
    (hs:(∑ i, (p i).all) ≤ P.all)
    (hy:(∑ i, middle (p i)) ≤ middle P)
