/-- Express the variables as the two centered coordinates of the geometric point. -/
private theorem centered_coordinates (y v : SeedClosure) :
    ∃ e : MvPolynomial (Fin 2) SeedClosure ≃ₐ[SeedClosure] FibreJet,
