  have : IsScalarTower K R B := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    rfl
  let q (j : ℕ) := (IsLocalization.AtPrime.equivQuotMaximalIdealPow m B j).restrictScalars K
  let q1 : (R ⧸ m) ≃ₐ[K] ResidueField B :=
    (Ideal.quotientEquivAlgOfEq K (pow_one m).symm).trans
      ((q 1).trans (Ideal.quotientEquivAlgOfEq K (pow_one (maximalIdeal B))))
  let r : K ≃ₐ[K] ResidueField B := e.symm.trans q1
  have hs : Function.Surjective (algebraMap K (ResidueField B)) := by
    intro z
    obtain ⟨x, rfl⟩ := r.surjective z
    exact ⟨x, (r.commutes x).symm⟩
  have hrs : Function.Surjective (algebraMap (ResidueField K) (ResidueField B)) := by
    intro z
    obtain ⟨x, rfl⟩ := hs z
    exact ⟨algebraMap K (ResidueField K) x, (IsScalarTower.algebraMap_apply _ _ _ x).symm⟩
  have hl : Module.length (ResidueField K) (ResidueField B) = 1 := by
    rw [Module.length_eq_of_surjective (R := ResidueField B) hrs, Module.length_eq_one]
  change Module.length B (B ⧸ maximalIdeal B ^ n) = _
  calc
    Module.length B (B ⧸ maximalIdeal B ^ n) =
        Module.length K (B ⧸ maximalIdeal B ^ n) := by
      rw [IsLocalRing.length_restrictScalars K B, hl, mul_one]
    _ = Module.length K (R ⧸ m ^ n) := (q n).toLinearEquiv.length_eq.symm

private theorem fibrePoint_isMaximal (y v : SeedClosure) : (fibrePoint y v).IsMaximal := by
  rw [fibrePoint_eq_ker]
  refine RingHom.ker_isMaximal_of_surjective _ fun z => ⟨C (C z), ?_⟩
  simp only [fibreEvaluation, RingHom.comp_apply, coe_evalRingHom, eval_C]

theorem geometric_power_colength : K1A_14_3_4_3.c2 := by
  intro y v n
  let K := SeedClosure
  let m := fibrePoint y v
  have : m.IsMaximal := fibrePoint_isMaximal y v
