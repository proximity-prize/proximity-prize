private theorem flat_polynomial_map {R S : Type} [CommRing R] [CommRing S]
    (f : R →+* S) (hf : f.Flat) : (mapRingHom f).Flat := by
  let : Algebra R S := f.toAlgebra
  let : Algebra R[X] S[X] := Polynomial.algebra R S
  exact RingHom.Flat.isStableUnderBaseChange R S R[X] S[X] hf

private theorem flat_fibreMap : fibreMap.Flat := by
  have hseed : (algebraMap Seeds SeedField).Flat :=
    RingHom.flat_algebraMap_iff.mpr
      (IsLocalization.flat SeedField (nonZeroDivisors Seeds))
  have hclosure : (algebraMap SeedField SeedClosure).Flat :=
    RingHom.flat_algebraMap_iff.mpr inferInstance
  exact flat_polynomial_map _ (flat_polynomial_map _ (hseed.comp hclosure))

/-- Clear the denominators of a minimal polynomial while preserving its simple root. -/
private theorem cleared_simple_root {x : SeedClosure} (hx : IsSeparable SeedField x) :
    ∃ P : Equation, ∃ H : Polynomial SeedClosure,
      P.map seedGeneric = (Polynomial.X (R := SeedClosure) - C x) * H ∧ H.eval x ≠ 0 := by
  let m := minpoly SeedField x
  let toClosure := algebraMap SeedField SeedClosure
  let p := m.map toClosure
  have hroot : p.IsRoot x := by
    change (m.map toClosure).eval x = 0
    rw [eval_map, ← aeval_def]
    exact minpoly.aeval SeedField x
  obtain ⟨H, hH⟩ := dvd_iff_isRoot.mpr hroot
  have hsep : p.Separable := Polynomial.Separable.map hx
  have hHeval : H.eval x ≠ 0 := by
    intro hzero
    apply hsep.eval₂_derivative_ne_zero (RingHom.id SeedClosure) hroot
    rw [eval₂_id, hH, derivative_mul]
    simp [hzero]
  let P : Equation := IsLocalization.integerNormalization (nonZeroDivisors Seeds) m
  obtain ⟨a, ha, hP⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors Seeds) m
  have hscale : P.map (algebraMap Seeds SeedField) = C (algebraMap Seeds SeedField a) * m := by
    simpa only [Algebra.smul_def, Polynomial.algebraMap_apply] using hP
  have ha0 : seedGeneric a ≠ 0 := by
    simpa only [seedGeneric, RingHom.comp_apply, map_zero] using
      (algebraMap SeedField SeedClosure).injective.ne
        ((IsFractionRing.injective Seeds SeedField).ne (nonZeroDivisors.ne_zero ha))
  refine ⟨P, C (seedGeneric a) * H, ?_, ?_⟩
  · calc
      P.map seedGeneric = (P.map (algebraMap Seeds SeedField)).map toClosure := by
        rw [Polynomial.map_map]
        rfl
      _ = C (seedGeneric a) * p := by
        rw [hscale, Polynomial.map_mul, Polynomial.map_C]
        rfl
      _ = (Polynomial.X (R := SeedClosure) - C x) * (C (seedGeneric a) * H) := by
        rw [hH, mul_left_comm]
  · rw [eval_mul, eval_C]
    exact mul_ne_zero ha0 hHeval

private theorem fibreMap_inner (P : Equation) :
    fibreMap (C P) = C (P.map seedGeneric) :=
  Polynomial.map_C _

private theorem fibreMap_outer (P : Equation) :
    fibreMap (P.map (C : Seeds →+* Equation)) =
      (P.map seedGeneric).map (C : SeedClosure →+* Polynomial SeedClosure) := by
  change (P.map (C : Seeds →+* Equation)).map (mapRingHom seedGeneric) = _
  rw [Polynomial.map_map, Polynomial.map_map]
  congr 1
  apply RingHom.ext
  intro a
  exact Polynomial.map_C _

private theorem fibreEvaluation_inner (y v : SeedClosure) (H : Polynomial SeedClosure) :
    fibreEvaluation y v (C H) = H.eval y := by
  change ((C H).eval (C v)).eval y = H.eval y
  rw [eval_C]

private theorem fibreEvaluation_outer (y v : SeedClosure) (H : Polynomial SeedClosure) :
    fibreEvaluation y v (H.map (C : SeedClosure →+* Polynomial SeedClosure)) = H.eval v := by
  change ((H.map (C : SeedClosure →+* Polynomial SeedClosure)).eval (C v)).eval y = H.eval v
  rw [eval_map_apply, eval_C]

/-- A factor of a polynomial from the parent ideal gives the same local generator
if the other factor has nonzero value at the geometric point. -/
private theorem local_factor_mem {q : Surface} {y v : SeedClosure}
    (h : OnSeedFibre q y v) {P : Jet} {g u : FibreJet}
    (hfac : fibreMap P = g * u)
    (hg : fibreEvaluation y v g = 0) (hu : fibreEvaluation y v u ≠ 0) :
    algebraMap FibreJet (FibreLocalRing y v) g ∈
      (q.asIdeal.map fibreMap).map (algebraMap FibreJet (FibreLocalRing y v)) := by
  let ψ := algebraMap FibreJet (FibreLocalRing y v)
  have hP : P ∈ q.asIdeal := by
    rw [fibrePoint_comap h, Ideal.mem_comap, fibrePoint_eq_ker, RingHom.mem_ker,
      hfac, map_mul, hg, zero_mul]
  have hmem := Ideal.mem_map_of_mem ψ (Ideal.mem_map_of_mem fibreMap hP)
  rw [hfac, map_mul, mul_comm (ψ g)] at hmem
  have hunit : IsUnit (ψ u) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff (FibreLocalRing y v) (fibrePoint y v) u).mpr (by
      change u ∉ fibrePoint y v
      rwa [fibrePoint_eq_ker, RingHom.mem_ker])
  exact (Ideal.unit_mul_mem_iff_mem _ hunit).mp hmem

private theorem map_maximalIdeal (q : Surface) (y v : SeedClosure)
    (h : OnSeedFibre q y v) (hy : IsSeparable SeedField y) (hv : IsSeparable SeedField v) :
    (maximalIdeal (ParentLocalRing q)).map (fibreLocalMap q y v h) =
      maximalIdeal (FibreLocalRing y v) := by
  let ψ := algebraMap FibreJet (FibreLocalRing y v)
  have hcomp :
      (fibreLocalMap q y v h).comp (algebraMap Jet (ParentLocalRing q)) = ψ.comp fibreMap :=
    RingHom.ext fun G ↦
      Localization.localRingHom_to_map q.asIdeal (fibrePoint y v) fibreMap (fibrePoint_comap h) G
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal (ParentLocalRing q),
    ← IsLocalization.AtPrime.map_eq_maximalIdeal (fibrePoint y v) (FibreLocalRing y v),
    Ideal.map_map, hcomp, ← Ideal.map_map]
  apply le_antisymm
  · exact Ideal.map_mono (Ideal.map_le_iff_le_comap.mpr (fibrePoint_comap h).le)
  · change (Ideal.span {C (Polynomial.X (R := SeedClosure) - C y),
      Polynomial.X (R := Polynomial SeedClosure) - C (C v)} : Ideal FibreJet).map ψ ≤ _
    rw [Ideal.map_span, Set.image_insert_eq, Set.image_singleton, Ideal.span_le,
      Set.insert_subset_iff, Set.singleton_subset_iff]
    constructor
    · obtain ⟨P, H, hP, hH⟩ := cleared_simple_root hy
      refine local_factor_mem h (P := C P) (u := C H) ?_ ?_ ?_
      · rw [fibreMap_inner, hP, map_mul]
      · rw [fibreEvaluation_inner]
        simp
      · rwa [fibreEvaluation_inner]
    · obtain ⟨P, H, hP, hH⟩ := cleared_simple_root hv
      have hfac := fibreMap_outer P
      rw [hP, Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C] at hfac
      refine local_factor_mem h hfac ?_ ?_
      · change ((Polynomial.X (R := Polynomial SeedClosure) - C (C v)).eval (C v)).eval y = 0
        simp
      · rwa [fibreEvaluation_outer]

theorem proof : K1A_14_3_4_3.c1 := by
  intro q y v h hy hv
  exact ⟨flat_fibreMap.localRingHom (fibrePoint y v) q.asIdeal (fibrePoint_comap h),
    map_maximalIdeal q y v h hy hv⟩

