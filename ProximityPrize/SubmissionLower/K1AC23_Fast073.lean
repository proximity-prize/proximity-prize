private theorem span_seed_change {R : Type} [CommRing R] (u w a c d : R) :
    Ideal.span {u + a * w - (c + a * d), w - d} = Ideal.span {u - c, w - d} := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · let I : Ideal R := Ideal.span {u - c, w - d}
      have h₁ : u - c ∈ I := Ideal.subset_span (by simp)
      have h₂ : w - d ∈ I := Ideal.subset_span (by simp)
      change u + a * w - (c + a * d) ∈ I
      rw [show u + a * w - (c + a * d) = (u - c) + a * (w - d) by ring]
      exact I.add_mem h₁ (I.mul_mem_left a h₂)
    · exact Ideal.subset_span (by simp)
  · apply Ideal.span_le.mpr
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · let I : Ideal R := Ideal.span {u + a * w - (c + a * d), w - d}
      have h₁ : u + a * w - (c + a * d) ∈ I := Ideal.subset_span (by simp)
      have h₂ : w - d ∈ I := Ideal.subset_span (by simp)
      change u - c ∈ I
      rw [show u - c = (u + a * w - (c + a * d)) - a * (w - d) by ring]
      exact I.sub_mem h₁ (I.mul_mem_left a h₂)
    · exact Ideal.subset_span (by simp)

