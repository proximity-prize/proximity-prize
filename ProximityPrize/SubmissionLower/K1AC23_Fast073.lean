    change (MvPolynomial.finSuccEquiv K 1 (MvPolynomial.X (Fin.succ 0))).map u.toRingHom = _
    rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.map_C]
    congr 1
    change MvPolynomial.eval₂ Polynomial.C (fun _ : Fin 1 => Polynomial.X)
      (MvPolynomial.X 0) = _
    rw [MvPolynomial.eval₂_X]
