      simp only [fibreIdeal, fibreEquation, MvPolynomial.map_X, map_zero, mul_zero, add_zero]
    have h := (fibre_finrank H (MvPolynomial.X 3) 0).trans (vertical_finrank H (MvPolynomial.X 3))
    rw [hi] at h
