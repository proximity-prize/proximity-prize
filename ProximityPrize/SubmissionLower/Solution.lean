    (hhiB : branch c w mode u v hi ≤ bound) :
    branch c w mode u v z ≤ bound := by
  have h1 := branch_affine c w mode lo hi z u v hw hc hz hhi
  have h2 := branch_affine c w mode lo hi hi u v hw hc (hz.trans hhi) le_rfl
