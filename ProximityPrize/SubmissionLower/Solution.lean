section Compact_SecondJetStrictCore
namespace ProximityPrize.SubmissionLower.SecondJetStrictCore
open RCN095 LocatorFactorAggregate LocatorPhase6800Oracle LocatorOrdinaryZConvex
open Lower80788.BaseDirectAudit Lower80788.BaseSparseBridge Lower80788.BaseSparseCore
set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000
def StrictCandidateCheck (rows : Array BaseRow) (R V r v : ℕ) : Prop :=
  let q := SecondJetStrictData.lookup R V
  let zero := baseZeroCap rows (R - r) (V - v)
  LocatorOrdinaryZConvex.rawCost r v 0 + zero ≤ q.z0 ∧
  LocatorOrdinaryZConvex.rawCost r v 1 + zero ≤ q.z1 ∧
  LocatorOrdinaryZConvex.rawCost r v 2 + zero ≤ q.z2 ∧
  match q.segments with
  | [s] =>
      s.start = 3 ∧ candidateLine rows R V r v s.start ≤ s.valueAtStart ∧
        candidateSlope r v ≤ s.slope
  | [s₁, s₂] =>
      s₁.start = 3 ∧ s₁.start < s₂.start ∧
        candidateLine rows R V r v s₁.start ≤ s₁.valueAtStart ∧
        candidateLine rows R V r v (s₂.start - 1) ≤
          s₁.evalAt (s₂.start - 1) ∧
        candidateLine rows R V r v s₂.start ≤ s₂.valueAtStart ∧
        candidateSlope r v ≤ s₂.slope
  | _ => False

instance (rows : Array BaseRow) (R V r v : ℕ) :
    Decidable (StrictCandidateCheck rows R V r v) := by
  unfold StrictCandidateCheck
  dsimp only
  generalize hq : SecondJetStrictData.lookup R V = q
  cases hs : q.segments with
  | nil =>
      simp only [hs]
      infer_instance
  | cons s tail =>
      cases ht : tail with
      | nil =>
          simp only [hs, ht]
          infer_instance
      | cons s₂ rest =>
          cases hu : rest with
          | nil =>
              simp only [hs, ht, hu]
              infer_instance
          | cons s₃ rest₃ =>
              simp only [hs, ht, hu]
              infer_instance

theorem strictCandidateCheck_sound
    (rows : Array BaseRow) (R V r v z : ℕ) (hr : 1 ≤ r)
    (hcheck : StrictCandidateCheck rows R V r v) :
    LocatorOrdinaryZConvex.rawCost r v z +
        baseZeroCap rows (R - r) (V - v) ≤
      SecondJetStrictData.cap (rawFlag R V z) := by
  let q := SecondJetStrictData.lookup R V
  change LocatorOrdinaryZConvex.rawCost r v z +
      baseZeroCap rows (R - r) (V - v) ≤ q.evalAt z
  change
    LocatorOrdinaryZConvex.rawCost r v 0 +
          baseZeroCap rows (R - r) (V - v) ≤ q.z0 ∧
      LocatorOrdinaryZConvex.rawCost r v 1 +
          baseZeroCap rows (R - r) (V - v) ≤ q.z1 ∧
      LocatorOrdinaryZConvex.rawCost r v 2 +
          baseZeroCap rows (R - r) (V - v) ≤ q.z2 ∧
      (match q.segments with
      | [s] =>
          s.start = 3 ∧
            candidateLine rows R V r v s.start ≤ s.valueAtStart ∧
            candidateSlope r v ≤ s.slope
      | [s₁, s₂] =>
          s₁.start = 3 ∧ s₁.start < s₂.start ∧
            candidateLine rows R V r v s₁.start ≤ s₁.valueAtStart ∧
            candidateLine rows R V r v (s₂.start - 1) ≤
              s₁.evalAt (s₂.start - 1) ∧
            candidateLine rows R V r v s₂.start ≤ s₂.valueAtStart ∧
            candidateSlope r v ≤ s₂.slope
      | _ => False) at hcheck
  rcases hcheck with ⟨hzero, hone, htwo, hsegmentsSound⟩
  by_cases hz0 : z = 0
  · subst z
    simpa [BaseRow.evalAt] using hzero
  by_cases hz1 : z = 1
  · subst z
    simpa [BaseRow.evalAt] using hone
  by_cases hz2 : z = 2
  · subst z
    simpa [BaseRow.evalAt] using htwo
  have hz3 : 3 ≤ z := by omega
  rw [carrierCost_eq_candidateLine rows R V r v z hr hz3]
  cases hsegments : q.segments with
  | nil =>
      simp only [hsegments] at hsegmentsSound
  | cons s₁ tail =>
      cases htail : tail with
      | nil =>
          have hsound :
              s₁.start = 3 ∧
                candidateLine rows R V r v s₁.start ≤ s₁.valueAtStart ∧
                candidateSlope r v ≤ s₁.slope := by
            simpa only [hsegments, htail] using hsegmentsSound
          rcases hsound with ⟨hs₁Start, hlineStart, hslope⟩
          have hline := candidateLine_le_segment_of_start_and_slope
            rows R V r v z s₁ (by omega) (by omega) hlineStart hslope
          have heval : q.evalAt z = s₁.evalAt z := by
            simp [BaseRow.evalAt, evalBaseSegments, hsegments, htail,
              hz0, hz1, hz2]
          rw [heval]
          exact hline
      | cons s₂ rest =>
          cases hrest : rest with
          | nil =>
              have hsound :
                  s₁.start = 3 ∧ s₁.start < s₂.start ∧
                    candidateLine rows R V r v s₁.start ≤ s₁.valueAtStart ∧
                    candidateLine rows R V r v (s₂.start - 1) ≤
                      s₁.evalAt (s₂.start - 1) ∧
                    candidateLine rows R V r v s₂.start ≤ s₂.valueAtStart ∧
                    candidateSlope r v ≤ s₂.slope := by
                simpa only [hsegments, htail, hrest] using hsegmentsSound
              rcases hsound with
                ⟨hs₁Start, hs₁₂, hlineStart, hlineFinish,
                  hlineSecond, hslopeSecond⟩
              by_cases hs₂z : s₂.start ≤ z
              · have hline := candidateLine_le_segment_of_start_and_slope
                  rows R V r v z s₂ (by omega) hs₂z hlineSecond
                    hslopeSecond
                have heval : q.evalAt z = s₂.evalAt z := by
                  simp [BaseRow.evalAt, evalBaseSegments, hsegments, htail, hrest,
                    hz0, hz1, hz2, hs₂z]
                rw [heval]
                exact hline
              · have hzf : z ≤ s₂.start - 1 := by omega
                have hline := candidateLine_le_segment_between
                  rows R V r v z (s₂.start - 1) s₁
                    (by omega) (by omega) hzf hlineStart hlineFinish
                have heval : q.evalAt z = s₁.evalAt z := by
                  simp [BaseRow.evalAt, evalBaseSegments, hsegments, htail, hrest,
                    hz0, hz1, hz2, hs₂z]
                rw [heval]
                exact hline
          | cons s₃ rest₃ =>
              simp only [hsegments, htail, hrest] at hsegmentsSound

def CachedStrictCheck (R V r v : ℕ) : Prop :=
  let q := SecondJetStrictData.lookup R V
  let c := carrierCosts r v
  let zero := zeroDirect (R - r) (V - v)
  c.c0 + zero ≤ q.z0 ∧
  c.c1 + zero ≤ q.z1 ∧
  c.c2 + zero ≤ q.z2 ∧
  match q.segments with
  | [s] =>
      s.start = 3 ∧ cachedLine R V r v s.start ≤ s.valueAtStart ∧
        cachedSlope r v ≤ s.slope
  | [s₁, s₂] =>
      s₁.start = 3 ∧ s₁.start < s₂.start ∧
        cachedLine R V r v s₁.start ≤ s₁.valueAtStart ∧
        cachedLine R V r v (s₂.start - 1) ≤ s₁.evalAt (s₂.start - 1) ∧
        cachedLine R V r v s₂.start ≤ s₂.valueAtStart ∧
        cachedSlope r v ≤ s₂.slope
  | _ => False

instance (R V r v : ℕ) : Decidable (CachedStrictCheck R V r v) := by
  unfold CachedStrictCheck
  dsimp only
  generalize hq : SecondJetStrictData.lookup R V = q
  cases hs : q.segments with
  | nil => simp only [hs]; infer_instance
  | cons s tail =>
      cases ht : tail with
      | nil => simp only [hs, ht]; infer_instance
      | cons s₂ rest =>
          cases hu : rest with
          | nil => simp only [hs, ht, hu]; infer_instance
          | cons s₃ rest₃ => simp only [hs, ht, hu]; infer_instance

theorem strictCandidateCheck_of_cached (rows : Array BaseRow)
    (R V r v : ℕ) (hc : CarrierCorrect r v)
    (h : CachedStrictCheck R V r v) :
    StrictCandidateCheck rows R V r v := by
  dsimp [CarrierCorrect, Lower80788.CarrierCostDirectData.Correct,
    carrierCosts] at hc
  rcases hc with ⟨h0, h1, h2, h3, h4⟩
  unfold CachedStrictCheck at h
  unfold StrictCandidateCheck
  dsimp only
  simp only [Lower80788.BaseDirectAudit.lookupBaseRow,
    zeroDirect_eq_baseZeroCap] at h ⊢
  unfold cachedLine cachedSlope at h
  dsimp only [carrierCosts] at h
  rw [h0, h1, h2, h3, h4] at h
  exact h



def Cell (R V : ℕ) : Prop :=
  ∀ r ∈ rBoundaryValues R, ∀ v ∈ vBoundaryValues V,
    1 ≤ r → r < R → v ≤ V → CachedStrictCheck R V r v
instance (R V : ℕ) : Decidable (Cell R V) := by unfold Cell; infer_instance

def Layer (R : ℕ) : Prop := ∀ V ∈ List.range (137-R), Cell R V
instance (R : ℕ) : Decidable (Layer R) := by unfold Layer; infer_instance

def AllChecks : Prop := ∀ R ∈ List.range 31, 1 ≤ R → Layer R

theorem strictRows (checks : AllChecks) : SecondJetAggregateBase.StrictRows SecondJetStrictData.cap := by
  intro R V r v z hr hrlt hv hR hRV ht
  rw [←zeroDirect_eq_baseZeroCap]
