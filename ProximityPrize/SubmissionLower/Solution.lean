    omega
  have hZ:F.degreeOf (3:Fin 4) ≤ P.total:=by
    apply MvPolynomial.degreeOf_le_iff.mpr
    intro e he
    have hw:=(MvPolynomial.le_weightedTotalDegree residualTotalWeights he).trans
