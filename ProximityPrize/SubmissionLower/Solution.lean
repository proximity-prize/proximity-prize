  have he:e=d+Finsupp.single (2:Fin 4) 1:=rfl
  change e∈F.support at hs
  change e 0+w*e 1+(w-1)*e 2 < D at hc
  have h0:e (0:Fin 4)=d 0:=by simp [he]
  have h1:e (1:Fin 4)=d 1:=by simp [he]
  have h2:e (2:Fin 4)=d 2+1:=by simp [he]
  rw [h0,h1,h2] at hc
