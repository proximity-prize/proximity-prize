  rw [smul_eq_mul]
  refine Ideal.mul_homogeneous_element_mem_of_mem 𝒜 (s z) z ?_ ?_ i
  · rcases z with ⟨z,hz2⟩
    apply h _ hz2
  · exact Ideal.subset_span z.2
