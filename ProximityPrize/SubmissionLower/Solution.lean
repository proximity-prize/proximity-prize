    simp_rw [←(FaithfulSMul.algebraMap_injective B C).eq_iff, ←IsScalarTower.algebraMap_apply]
    apply hG.isInvariant.isInvariant (algebraMap B C x)
    intro g
    have:=(FaithfulSMul.algebraMap_injective B C).eq_iff.mpr <| h g
