theorem induction_on_prime_power {P:α → Prop} (s:Finset α) (i:α → ℕ)
    (is_prime:∀ p∈s,Prime p) (is_coprime:∀ᵉ (p∈s) (q∈s),p∣q → p=q)
    (h1:∀ {x},IsUnit x → P x) (hpr:∀ {p} (i:ℕ),Prime p → P (p^i))
