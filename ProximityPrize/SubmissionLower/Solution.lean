    nlinarith
  · have hm := mul_nonpos_of_nonpos_of_nonneg hs (show 0 ≤ (z : ℤ)-lo by omega)
    nlinarith

theorem ledger_le_of_branches (c : PhaseRowContext) (w mode z : ℕ)
