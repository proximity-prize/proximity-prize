/-- The ordinary node incidence bound fits two copies of the second-cut quota
    for a repeated first-cut component. The common sites shorten its node curves. -/
theorem repeated_tariff {s ell k L : ℕ} (hs : s ≤ 133606) (he₀ : 128536 ≤ ell)
    (he₁ : ell ≤ L) (he₂ : L ≤ 128657) (hk : k ≤ 5070) :
    (262144-s)*(ell-s+k) ≤ (179886-s)*(2*(L+2+k)) := by
  have ha : s ≤ 179886 := by omega
