  by_cases hu : 6000000000000 ≤ unitSlope (c.R+c.V) c.R*(c.R+c.V+z)+unitConstant (c.R+c.V) c.R
  · rw [max_eq_right hu]
    by_cases hv : 6000000000000 ≤ unitSlope (153-(c.R+c.V)) (33-c.R)*(17570-(c.R+c.V+z))+unitConstant (153-(c.R+c.V)) (33-c.R)
    · rw [max_eq_right hv]
      have hh := hb true true
      simp only [branch, Bool.true_eq, ↓reduceIte] at hh
      norm_cast at hs
