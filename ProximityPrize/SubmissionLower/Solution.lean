  · ext x
    rw [H]
    apply e₁.injective
    simp only [LinearMap.coe_comp,LinearEquiv.coe_coe,LinearMap.coe_restrictScalars,
      Function.comp_apply,LinearEquiv.symm_apply_apply,LinearMap.id_coe,id_eq,
