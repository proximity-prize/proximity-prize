noncomputable
def Hom.toExtensionHom [Algebra R S'] [IsScalarTower R R' S'] [IsScalarTower R S S']
    (f:P.Hom P'):P.toExtension.Hom P'.toExtension where
  toRingHom:=f.toAlgHom.toRingHom
