theorem originalAlgHom_eq_residualAlgHom_inverse
    (aY v bY aS bS cS:Omega):
    originalAlgHom aY v bY aS bS cS=
      residualAlgHom (-v⁻¹*aY) v⁻¹ (-v⁻¹*bY)
        (-v⁻¹*aS+v⁻¹*v⁻¹*bS*aY)
        (-v⁻¹*v⁻¹*bS)
        (v⁻¹*v⁻¹*bS*bY-v⁻¹*cS):=by
