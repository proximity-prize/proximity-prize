  rw [LinearMap.mem_range] at hr
  obtain ⟨s,rfl⟩:=hr
  rw [Finsupp.linearCombination_apply,Finsupp.sum,decompose_sum,DFinsupp.finsetSum_apply,
    AddSubmonoidClass.coe_finsetSum]
  refine Ideal.sum_mem _ ?_
