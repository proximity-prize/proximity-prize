namespace ProximityPrize.SubmissionLower.GroupFast80909
open DZ ZH ASH EMC
open AIX ACI BPE BZK AQS
set_option autoImplicit false
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000

def checkBound(B R lo hi start:ℕ)(p:Piece):Bool:=
 let z:=bif Nat.ble R p.slope then lo else hi
 Nat.ble (Nat.add B (Nat.mul R z))
  (Nat.add (Nat.add p.base (Nat.mul p.slope (Nat.sub lo start))) (Nat.mul p.slope (Nat.sub z lo)))
lemma checkBound_eq(B R lo hi start:ℕ)(p:Piece):
 checkBound B R lo hi start p=DirectNat80909.fastCheck B R 0 0 lo hi start p:=by
 simp only [checkBound,DirectNat80909.fastCheck,show Nat.max R 0=R from max_eq_left (Nat.zero_le R)]
 all_goals rfl
def test(q k line s0 s1 c0 c1 lo hi start:ℕ)(p:Piece):Bool:=
 checkBound
  (max (GroupBoundData80909.base q k 0 line+c0) (GroupBoundData80909.base q k 1 line+c1))
  (max (GroupBoundData80909.rate q k line) (max s0 s1)) lo hi start p
lemma test_eq_old(r v code q k line lo hi start:ℕ)(p:Piece):
 test q k line (GroupKernel80909.slopeAt code v q (2*k)) (GroupKernel80909.slopeAt code v q (2*k+1))
  (GroupKernel80909.charge r v code q (2*k)) (GroupKernel80909.charge r v code q (2*k+1)) lo hi start p=
 GroupKernel80909.boundTest r v code q k line lo hi start p:=by
 rw [test,checkBound_eq]
 rfl

def pair(r v code q k lo hi start:ℕ)(p:Piece):Bool:=
 let u0:=2*k
 let u1:=2*k+1
 let j0:=DirectNat80909.choice code v q u0
 let j1:=DirectNat80909.choice code v q u1
 let s0:=light_slope j0
 let s1:=light_slope j1
 let c0:=LightFast80909.num j0 (r-q) (v-u0)
 let c1:=LightFast80909.num j1 (r-q) (v-u1)
 Nat.blt j0 14 &&
 (Nat.blt j1 14 &&
 ((test q k 0 s0 s1 c0 c1 lo hi start p || test q k 1 s0 s1 c0 c1 lo hi start p) ||
 (SplitChild80909.quickChild q u0 s0 c0 lo hi start p && SplitChild80909.quickChild q u1 s1 c1 lo hi start p)))

lemma originalPair_full(r v code q k lo hi start:ℕ)(p:Piece)(hfull:2*k+1≤v):
 GroupKernel80909.originalPair r v code q k lo hi start p=
 (GroupKernel80909.per r v code q lo hi start p (2*k) && GroupKernel80909.per r v code q lo hi start p (2*k+1)):=by
 unfold GroupKernel80909.originalPair
 change ((if 2*k≤v then GroupKernel80909.per r v code q lo hi start p (2*k) else true) &&
  (if 2*k+1≤v then GroupKernel80909.per r v code q lo hi start p (2*k+1) else true))=_
 simp only [if_pos (show 2*k≤v by omega),if_pos hfull]

lemma pair_eq(r v code q k lo hi start:ℕ)(p:Piece)
 (hq:10≤q)(hQ:q≤19)(hv:v≤70)(hfull:2*k+1≤v)(hcut:hi≤4000)(hlo:lo≤hi):
 pair r v code q k lo hi start p=
 (GroupKernel80909.per r v code q lo hi start p (2*k) && GroupKernel80909.per r v code q lo hi start p (2*k+1)):=by
 apply Bool.eq_iff_iff.mpr
 simp only [pair,SplitChild80909.quickChild_eq,GroupKernel80909.per,GroupKernel80909.jAt,GroupKernel80909.slopeAt,GroupKernel80909.charge,
  Bool.and_eq_true,Bool.or_eq_true,Nat.blt_eq]
 constructor
 · intro h
   rcases h with ⟨hj0,hj1,hline⟩
   rcases hline with hline|hchildren
   · rcases hline with h0|h1
     · have hh:GroupKernel80909.boundTest r v code q k 0 lo hi start p=true:=by
        rw [←test_eq_old]
        exact h0
       have hp:=GroupKernel80909.bound_sound r v code q k 0 lo hi start p hq hQ hv hfull (by decide) hcut hlo hj0 hj1 hh
       rw [originalPair_full r v code q k lo hi start p hfull] at hp
       simpa only [GroupKernel80909.per,GroupKernel80909.jAt,GroupKernel80909.slopeAt,GroupKernel80909.charge,Bool.and_eq_true,Nat.blt_eq] using hp
     · have hh:GroupKernel80909.boundTest r v code q k 1 lo hi start p=true:=by
        rw [←test_eq_old]
        exact h1
       have hp:=GroupKernel80909.bound_sound r v code q k 1 lo hi start p hq hQ hv hfull (by decide) hcut hlo hj0 hj1 hh
       rw [originalPair_full r v code q k lo hi start p hfull] at hp
       simpa only [GroupKernel80909.per,GroupKernel80909.jAt,GroupKernel80909.slopeAt,GroupKernel80909.charge,Bool.and_eq_true,Nat.blt_eq] using hp
   · exact ⟨⟨hj0,hchildren.1⟩,⟨hj1,hchildren.2⟩⟩
 · rintro ⟨⟨hj0,hc0⟩,⟨hj1,hc1⟩⟩
   exact ⟨hj0,hj1,Or.inr ⟨hc0,hc1⟩⟩

lemma allK_succ(test:ℕ→Bool)(n:ℕ):allK test (n+1)=(allK test n && test n):=by rfl
lemma allK_pairs(test:ℕ→Bool)(k:ℕ):
 allK (fun j=>test (2*j) && test (2*j+1)) k=allK test (2*k):=by
 induction k with
 | zero=>rfl
 | succ k ih=>
  rw [allK_succ,ih,show 2*(k+1)=2*k+1+1 by omega,allK_succ,allK_succ]
  exact (Bool.and_assoc _ _ _).symm
lemma allK_pairs_tail(test:ℕ→Bool)(n:ℕ):
 (allK (fun j=>test (2*j) && test (2*j+1)) (n/2) &&
 (if n%2=0 then true else test (2*(n/2))))=allK test n:=by
 rw [allK_pairs]
 by_cases he:n%2=0
 · rw [if_pos he,Bool.and_true]
   congr 1
   omega
 · rw [if_neg he]
   have ho:n%2=1:=by omega
   have hn:n=2*(n/2)+1:=by omega
   conv_rhs => rw [hn,allK_succ]

def inner(r v code q lo hi start:ℕ)(p:Piece):Bool:=
 allK (fun k=>pair r v code q k lo hi start p) ((v+1)/2) &&
 (if (v+1)%2=0 then true else GroupKernel80909.per r v code q lo hi start p (2*((v+1)/2)))
lemma inner_eq(r v code q lo hi start:ℕ)(p:Piece)
 (hq:10≤q)(hQ:q≤19)(hv:v≤70)(hcut:hi≤4000)(hlo:lo≤hi):
 inner r v code q lo hi start p=allK (GroupKernel80909.per r v code q lo hi start p) (v+1):=by
 have hp:allK (fun k=>pair r v code q k lo hi start p) ((v+1)/2)=
   allK (fun k=>GroupKernel80909.per r v code q lo hi start p (2*k) && GroupKernel80909.per r v code q lo hi start p (2*k+1)) ((v+1)/2):=by
  apply allK_congr
  intro k hk
  exact pair_eq r v code q k lo hi start p hq hQ hv (by omega) hcut hlo
 unfold inner
 rw [hp]
 exact allK_pairs_tail _ _
#print axioms inner_eq
end ProximityPrize.SubmissionLower.GroupFast80909
end
