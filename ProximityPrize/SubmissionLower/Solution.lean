theorem GIE (a:ℕ) (ys zs:List ℕ) (ha:a<2^62) (hys: ∀y ∈ ys,y<2^62)
    (hzs: ∀z ∈ zs,z<2^63) (h:laneCheck a (enc ys) ys.length (enc zs) zs.length=true):
