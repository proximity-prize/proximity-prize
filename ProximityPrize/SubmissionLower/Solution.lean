def num (L U S r y t : ℕ) : ℕ :=
 let z:=Nat.add (Nat.mul y S) (Nat.mul r U)
 Nat.add (Nat.mul 131073
  (Nat.add (Nat.add
   (Nat.mul (Nat.add 1 (Nat.mul 262142 y)) (Nat.add (Nat.mul r L) (Nat.mul t S)))
   (Nat.mul (Nat.mul 131071 (Nat.sub (Nat.mul 2 r) 1)) (Nat.add (Nat.mul y L) (Nat.mul t U))))
   (Nat.mul (Nat.add 1 (Nat.mul 262142 t)) z))) (Nat.mul 4057845960 z)
lemma num_eq (L U S r y t : ℕ) : num L U S r y t=CY.num L U S r y t := by
 rw [CY.num_formula]
