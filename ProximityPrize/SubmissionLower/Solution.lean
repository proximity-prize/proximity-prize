theorem polyH_Y_degree_pred_of_mem_box
    (F:Poly4 K) (D w L s c:ℕ) (hw:0 < w)
    (hD:D ≤ w*c+(w-1))
    (hbox:F∈globalCoefficientBox K D w L s):
    (polyH K F).degreeOf (1:Fin 4) ≤ c-1:=by
