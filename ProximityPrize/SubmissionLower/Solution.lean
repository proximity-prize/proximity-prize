section
namespace ProximityPrize.SubmissionLower
namespace AYX
open ProximityPrize.Benchmark RCN095 RCN266
open DY MM
set_option autoImplicit false
set_option maxHeartbeats 5000000
set_option maxRecDepth 100000
noncomputable section
abbrev P4:=NI.P4
local instance (p:FlagDegree):Decidable (WM.Critical p):=by
 unfold WM.Critical;infer_instance

def Policy:Prop:= ∀(p:FlagDegree),1≤p.all→p.all≤28→middle p≤117→total p≤8499→
 ¬TG.terminal.Routeable p→
 ABM.combined (MX.fee p.all (middle p) p.zOnly)
  (NI.finalCap p) p.all (middle p) p.zOnly≤MX.budget

theorem fee_critical (p:FlagDegree):MX.fee p.all (middle p) p.zOnly=
 (if WM.Critical p then 0 else 1):=by
 unfold MX.fee MX.CoreRow WM.Critical
 have ht:middle p+p.zOnly=total p:=by unfold middle total;omega
 rw [ht]
 congr 1
