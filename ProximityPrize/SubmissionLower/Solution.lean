lemma kerCotangentToTensor_injective_iff
    [Algebra P A] [IsScalarTower R P A] (hf:Function.Surjective (algebraMap P A)):
    Function.Injective (kerCotangentToTensor R P A) ↔ Subsingleton (Algebra.H1Cotangent R A):=
