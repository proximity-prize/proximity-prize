  induction F using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp [hP,hQ]
  | mul_X P i hP =>
      fin_cases i <;>
        simp [flagImage,hP,MvPolynomial.pderiv_mul,
          Derivation.leibniz] <;> ring
