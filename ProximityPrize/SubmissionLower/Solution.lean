theorem Ideal.mul_homogeneous_element_mem_of_mem
    {I:Ideal A} (r x:A) (hx₁:SetLike.IsHomogeneousElem 𝒜 x)
    (hx₂:x∈I) (j:ι):GradedRing.proj 𝒜 j (r*x)∈I:=by
  classical
  rw [←DirectSum.sum_support_decompose 𝒜 r,Finset.sum_mul,map_sum]
  apply Ideal.sum_mem
  intro k _
