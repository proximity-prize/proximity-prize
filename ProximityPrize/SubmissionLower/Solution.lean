    selected gamma-(P0+Polynomial.C gamma*P1)
  have hpredw:I.card-1 ≤ w:=(Nat.sub_le I.card 1).trans hIw
  have hP0:P0.natDegree ≤ w:=by
    apply Polynomial.natDegree_le_of_degree_le
