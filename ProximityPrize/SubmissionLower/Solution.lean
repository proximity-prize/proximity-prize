theorem neg_beq_zero (row : Nat) : (!(Nat.beq row 0)) = true ↔ row≠0 := by
 by_cases hz : row=0
 · subst row
   decide
 · have hb : Nat.beq row 0 = false := by
    apply Bool.eq_false_iff.mpr
    intro ht
    exact hz (Nat.eq_of_beq_eq_true ht)
   rw [hb]
   constructor
   · intro _
     exact hz
   · intro _
     rfl
def line (j hi q u row : Nat) : Bool :=
 Nat.beq j 4 && Nat.ble hi 4800 && Nat.ble 1 q && Nat.ble q 16 && Nat.ble u 61 && !(Nat.beq row 0)
theorem line_true_iff (j hi q u row : Nat) :
 line j hi q u row = true ↔ j=4 ∧ hi≤4800 ∧ 1≤q ∧ q≤16 ∧ u≤61 ∧ row≠0 := by
 simp only [line, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq, neg_beq_zero, and_assoc]
theorem line_cond {α : Sort _} (j hi q u row : Nat) (x y : α) :
 (bif line j hi q u row then x else y) =
 (if j=4 ∧ hi≤4800 ∧ 1≤q ∧ q≤16 ∧ u≤61 ∧ row≠0 then x else y) := by
 by_cases h : j=4 ∧ hi≤4800 ∧ 1≤q ∧ q≤16 ∧ u≤61 ∧ row≠0
 · have hg : line j hi q u row = true := (line_true_iff _ _ _ _ _).mpr h
   rw [hg, if_pos h]
   rfl
 · have hg : line j hi q u row = false := by
    apply Bool.eq_false_iff.mpr
    intro ht
    exact h ((line_true_iff _ _ _ _ _).mp ht)
   rw [hg, if_neg h]
   rfl
def other (hi q u row a b : Nat) : Bool :=
 Nat.ble hi 4800 && Nat.ble 1 q && Nat.ble q 16 && Nat.ble u 61 && !(Nat.beq row 0) && Nat.ble a b
theorem other_true_iff (hi q u row a b : Nat) :
 other hi q u row a b = true ↔ hi≤4800 ∧ 1≤q ∧ q≤16 ∧ u≤61 ∧ row≠0 ∧ a≤b := by
 simp only [other, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq, neg_beq_zero, and_assoc]
theorem other_cond {α : Sort _} (hi q u row a b : Nat) (x y : α) :
 (bif other hi q u row a b then x else y) =
 (if hi≤4800 ∧ 1≤q ∧ q≤16 ∧ u≤61 ∧ row≠0 ∧ a≤b then x else y) := by
 by_cases h : hi≤4800 ∧ 1≤q ∧ q≤16 ∧ u≤61 ∧ row≠0 ∧ a≤b
 · have hg : other hi q u row a b = true := (other_true_iff _ _ _ _ _ _).mpr h
   rw [hg, if_pos h]
   rfl
 · have hg : other hi q u row a b = false := by
    apply Bool.eq_false_iff.mpr
    intro ht
    exact h ((other_true_iff _ _ _ _ _ _).mp ht)
   rw [hg, if_neg h]
   rfl
end ProximityPrize.SubmissionLower.ExactBoolGuard6816

