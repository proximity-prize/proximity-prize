  have h:=residualAlgHom_wt_le_pulled
    (Pi.single (1:Fin 3) 1) aY v bY aS bS cS F
  have hp:flagPullWeights (Pi.single (1:Fin 3) 1)=
      Pi.single (1:Fin 3) 1:=by
    funext i
