def tensorKaehlerQuotKerSqEquiv:
    S ⊗[P ⧸ (RingHom.ker (algebraMap P S)^2)] Ω[(P ⧸ (RingHom.ker (algebraMap P S)^2))⁄R] ≃ₗ[S]
      S ⊗[P] Ω[P⁄R]:=
