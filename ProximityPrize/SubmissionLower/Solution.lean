section FiniteFamily
variable {I:Type*} [Fintype I]
variable (E:I → Type*) [∀ i,Field (E i)] [∀ i,Algebra K (E i)]
variable (r z:∀ i,E i)
theorem exists_common_nonzero_shear_coefficient
    [Infinite K] (hdz:∀ i,D K (E i) (z i)≠0):
    ∃ a:K,a≠0∧∀ i,
      D K (E i) (r i)+a • D K (E i) (z i)≠0:=by
