    have hr:(w-1)*1 ≤ (w-1)*(d 2+1):=
      Nat.mul_le_mul_left (w-1) (by omega)
    calc
      w*d 1+(w-1) ≤
          d 0+w*d 1+(w-1)*(d 2+1):=by omega
      _ < D:=hc
  have hadd:w*d 1+(w-1) < w*c+(w-1):=
    hcontact.trans_le hD
  have hmul:w*d 1 < w*c:=Nat.add_lt_add_iff_right.mp hadd
