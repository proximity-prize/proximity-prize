      (WithBot.coe_le_coe.mpr hpredw)
  have hP1:P1.natDegree ≤ w:=by
    apply Polynomial.natDegree_le_of_degree_le
    exact (Lagrange.degree_interpolate_le u1 hinj).trans
      (WithBot.coe_le_coe.mpr hpredw)
  have hDdegree:∀ gamma∈Gamma,(D gamma).natDegree ≤ w:=by
    intro gamma hgamma
