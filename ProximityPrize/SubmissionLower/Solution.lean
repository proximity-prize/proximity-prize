theorem specialization_monomial_natDegree_le
    (P:Polynomial K) (γ:K) (w:ℕ) (hP:P.natDegree ≤ w)
    (d:Fin 4 →₀ ℕ) (a:K):
    (specialization K P γ (MvPolynomial.monomial d a)).natDegree ≤
      d 0+w*d 1+(w-1)*d 2:=by
