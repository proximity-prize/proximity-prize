namespace ProximityPrize.SubmissionLower.SplitChild80909
open DZ ZH ASH EMC AIX ACI BPE BZK AQS
set_option autoImplicit false

def point(cc cs clo charge slope z pc:ℕ)(x:ℕ):Bool:=
 Nat.ble (cc+cs*(x-clo)+charge+slope*(z-x)) pc
def before(cc cs clo chi charge slope pc lo:ℕ):Bool:=
 bif Nat.ble clo chi then
  let x:=bif Nat.ble cs slope then clo else chi
  point cc cs clo charge slope lo pc x
 else true
def after(cc cs clo chi charge pc ps lo hi:ℕ):Bool:=
 bif Nat.ble clo chi then
  let x:=bif Nat.ble cs ps then clo else Nat.min hi chi
  Nat.ble (cc+cs*(x-clo)+charge) (pc+ps*(x-lo))
 else true
def fixedHi(cc cs clo chi charge slope pc hi:ℕ):Bool:=
 bif Nat.ble clo chi then
  let x:=bif Nat.ble cs slope then clo else Nat.min chi hi
  point cc cs clo charge slope hi pc x
 else true
def splitPiece(slope charge pc ps lo hi clo:ℕ)(c:Piece):Bool:=
 bif Nat.ble (c.stop-1) lo then before c.base c.slope clo (c.stop-1) charge slope pc lo
 else bif Nat.ble lo clo then after c.base c.slope clo (c.stop-1) charge pc ps lo hi
 else DirectNat80909.triangle c.base c.slope clo (c.stop-1) charge slope pc ps lo hi
def child(slope charge lo hi start:ℕ)(p:Piece)(cs:List Piece):Bool:=
 if lo≤hi then
  let pc:=p.base+p.slope*(lo-start)
  bif Nat.blt p.slope slope then
   DirectNat80909.cells (hi+1) (fun clo c=>fixedHi c.base c.slope clo (c.stop-1) charge slope (pc+p.slope*(hi-lo)) hi) cs 0
  else bif Nat.blt slope p.slope then
   DirectNat80909.cells (hi+1) (splitPiece slope charge pc p.slope lo hi) cs 0
  else DirectNat80909.child slope charge lo hi start p cs
 else DirectNat80909.child slope charge lo hi start p cs

def quickChild(q u slope charge lo hi start:ℕ)(p:Piece):Bool:=
 DirectNat80909.fastCheck (ChildLineData80909.base q u 0) (ChildLineData80909.rate q u 0) charge slope lo hi start p ||
 (DirectNat80909.fastCheck (ChildLineData80909.base q u 1) (ChildLineData80909.rate q u 1) charge slope lo hi start p ||
 child slope charge lo hi start p (UD.single q u).curve)

set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
lemma before_eq(cc cs clo chi charge slope pc ps lo hi:ℕ)
 (h:lo≤hi)(hs:slope<ps)(hc:chi≤lo):
 before cc cs clo chi charge slope pc lo=DirectNat80909.triangle cc cs clo chi charge slope pc ps lo hi:=by
 by_cases he:clo≤chi
 · have hclo:clo≤lo:=by omega
   have hsp:slope≤ps:=by omega
   by_cases hcs:cs≤slope
   · simp [before,point,DirectNat80909.triangle,DirectNat80909.selectZ,DirectNat80909.selectX,DirectNat80909.ble_cond,he,hclo,h,hcs,hsp]
   · by_cases hcp:cs≤ps
     · simp [before,point,DirectNat80909.triangle,DirectNat80909.selectZ,DirectNat80909.selectX,DirectNat80909.ble_cond,he,hclo,h,hcs,hcp,hc]
     · simp [before,point,DirectNat80909.triangle,DirectNat80909.selectZ,DirectNat80909.selectX,DirectNat80909.ble_cond,he,hclo,h,hcs,hcp,hc,show ¬ps≤slope by omega]
 · simp [before,DirectNat80909.triangle,DirectNat80909.ble_cond,he]
lemma after_eq(cc cs clo chi charge slope pc ps lo hi:ℕ)
 (h:lo≤clo)(hl:clo≤hi)(hs:slope<ps):
 after cc cs clo chi charge pc ps lo hi=DirectNat80909.triangle cc cs clo chi charge slope pc ps lo hi:=by
 by_cases he:clo≤chi
 · have hsp:slope≤ps:=by omega
   by_cases hcs:cs≤slope
   · have hcp:cs≤ps:=by omega
     simp [after,DirectNat80909.triangle,DirectNat80909.selectZ,DirectNat80909.selectX,DirectNat80909.ble_cond,he,h,hl,hcs,hcp,hsp]
   · by_cases hcp:cs≤ps
     · simp [after,DirectNat80909.triangle,DirectNat80909.selectZ,DirectNat80909.selectX,DirectNat80909.ble_cond,he,h,hl,hcs,hcp]
     · simp [after,DirectNat80909.triangle,DirectNat80909.selectZ,DirectNat80909.selectX,DirectNat80909.ble_cond,he,h,hl,hcs,hcp,show ¬ps≤slope by omega,Nat.min_le_right hi chi]
 · simp [after,DirectNat80909.triangle,DirectNat80909.ble_cond,he]
lemma fixedHi_eq(cc cs clo chi charge slope pc ps lo hi:ℕ)
 (h:lo≤hi)(hl:clo≤hi)(hs:ps<slope):
 fixedHi cc cs clo chi charge slope (pc+ps*(hi-lo)) hi=DirectNat80909.triangle cc cs clo chi charge slope pc ps lo hi:=by
 by_cases he:clo≤chi
 · have hsp:ps≤slope:=by omega
   have hm:max lo clo≤hi:=by omega
   by_cases hcs:cs≤slope
   · simp [fixedHi,point,DirectNat80909.triangle,DirectNat80909.selectZ,DirectNat80909.selectX,DirectNat80909.ble_cond,he,hm,hcs,hsp,show ¬slope≤ps by omega]
   · have hcp:¬cs≤ps:=by omega
     simp [fixedHi,point,DirectNat80909.triangle,DirectNat80909.selectZ,DirectNat80909.selectX,DirectNat80909.ble_cond,he,hm,hcs,hcp,hsp]
 · simp [fixedHi,DirectNat80909.triangle,DirectNat80909.ble_cond,he]

lemma cellsAux_congr(limit:ℕ)(f g:ℕ→Piece→Bool)(cs:List Piece)
 (h:∀start c,start<limit→f start c=g start c):∀start,
 DirectNat80909.cellsAux limit f cs start=DirectNat80909.cellsAux limit g cs start:=by
 induction cs with
 | nil=>intro start;rfl
 | cons c cs ih=>
  intro start
  change (bif Nat.ble limit start then true else Bool.rec false (DirectNat80909.cellsAux limit f cs c.stop) (f start c))=
   (bif Nat.ble limit start then true else Bool.rec false (DirectNat80909.cellsAux limit g cs c.stop) (g start c))
  by_cases hh:limit≤start
  · simp only [DirectNat80909.ble_cond,if_pos hh]
  · rw [h start c (by omega),ih]
lemma cells_congr(limit:ℕ)(f g:ℕ→Piece→Bool)(cs:List Piece)(start:ℕ)
 (h:∀start c,start<limit→f start c=g start c):
 DirectNat80909.cells limit f cs start=DirectNat80909.cells limit g cs start:=by
 unfold DirectNat80909.cells
 rw [cellsAux_congr limit f g cs h]
lemma child_eq(slope charge lo hi start:ℕ)(p:Piece)(cs:List Piece):
 child slope charge lo hi start p cs=DirectNat80909.child slope charge lo hi start p cs:=by
 by_cases hh:lo≤hi
 · unfold child
   rw [if_pos hh]
   by_cases h1:p.slope<slope
   · simp only [DirectNat80909.blt_cond,if_pos h1]
     unfold DirectNat80909.child
     apply cells_congr
     intro clo c hc
     exact fixedHi_eq c.base c.slope clo (c.stop-1) charge slope
      (p.base+p.slope*(lo-start)) p.slope lo hi hh (by omega) h1
   · simp only [DirectNat80909.blt_cond,if_neg h1]
     by_cases h2:slope<p.slope
     · simp only [DirectNat80909.blt_cond,if_pos h2]
       unfold DirectNat80909.child
       apply cells_congr
       intro clo c hc
       unfold splitPiece
       by_cases hb:c.stop-1≤lo
       · simp only [DirectNat80909.ble_cond,if_pos hb]
         exact before_eq c.base c.slope clo (c.stop-1) charge slope
          (p.base+p.slope*(lo-start)) p.slope lo hi hh h2 hb
       · simp only [DirectNat80909.ble_cond,if_neg hb]
         by_cases ha:lo≤clo
         · simp only [DirectNat80909.ble_cond,if_pos ha]
           exact after_eq c.base c.slope clo (c.stop-1) charge slope
            (p.base+p.slope*(lo-start)) p.slope lo hi ha (by omega) h2
         · simp only [DirectNat80909.ble_cond,if_neg ha]
           rfl
     · simp only [DirectNat80909.blt_cond,if_neg h2]
 · simp only [child,if_neg hh]
lemma quickChild_eq(q u slope charge lo hi start:ℕ)(p:Piece):
 quickChild q u slope charge lo hi start p=Codec3.quickChild q u slope charge lo hi start p:=by
 unfold quickChild Codec3.quickChild
 rw [child_eq]
#print axioms child_eq
#print axioms quickChild_eq
end ProximityPrize.SubmissionLower.SplitChild80909
