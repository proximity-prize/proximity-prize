  rfl

theorem graph_saturation {J : Input} {B : ResidueLift J} (D : Factors J B) (p : Ring FX) :
    p ∈ rectIdeal (graphIdeal J B D) ↔
      ∃ n : ℕ, (jetToRect (openFactor J B))^n*p ∈ graphCut D := by
