    hGdivF0.trans (map_dvd (surfaceMap φ)
      (factor_dvd_agreement_sub_power F0 Q w c x0 u0 u1))
  apply hproper
  simpa only [map_sub,map_mul,map_pow,sub_add_cancel] using dvd_add hdiff hscaled
end
