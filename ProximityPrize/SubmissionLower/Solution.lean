lemma localRingHom_injective_of_primesOver_eq_singleton
    [Algebra.IsIntegral R S] [FaithfulSMul R S]:
    Function.Injective (localRingHom p q (algebraMap R S) (hq.ge rfl).2.1):=by
  rw [injective_iff_map_eq_zero]
