    (hsepZ:∀ i,
      letI:Algebra (RatFunc K) (E i):=
        (embeddingZ i).toRingHom.toAlgebra
      Algebra.IsSeparable (RatFunc K) (E i)):
    ∃ a:K,a≠0∧∀ i,
      ∃ hs:Transcendental K (r i+a • z i),
