    (algebraMap (RatFunc K) L
      (algebraMap (Polynomial K) (RatFunc K) Polynomial.X))=0 at hzero
  have htensor:=congrArg
    (tensorKaehlerEquivOfFormallyEtale K (RatFunc K) L).symm hzero
