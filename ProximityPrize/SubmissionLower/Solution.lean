def curveCheck(cap cut B S:ℕ)(ps:List Piece):Bool:=
 cells (min cut (cap+1)) (fun clo c=>PrefixRangeKernel6816.cellCheck cap B S clo {c with stop:=min c.stop cut}) ps 0

def test(L U S r y B rate lo hi start:ℕ)(p:Piece):Bool:=
 DirectNat80909.fastCheck B rate (ceil (DirectExact80909.num L U S r y y+1))
  (ceil (DirectExact80909.slope L U S r y)) lo hi start {p with base:=p.base+1}

lemma piece_of_fast(cap cut boundCut L U S r y B rate lo hi start clo:ℕ)(p c:Piece)
 (hc:PrefixRangeKernel6816.cellCheck cap B rate clo {c with stop:=min c.stop boundCut}=true)
 (hf:test L U S r y B rate lo hi start p=true)(hcap:hi≤cap)(hdom:min cut (hi+1)≤boundCut):
 DirectExact80909.exactPiece L U S r y lo hi start p cut clo c=true:=by
 by_cases he:clo<min c.stop cut
 · simp only [DirectExact80909.exactPiece,DirectNat80909.blt_cond,if_pos he]
   rw [DirectNat80909.triangle_eq]
   let pc:=50164*(p.base+p.slope*(lo-start)+1)
   let ps:=50164*p.slope
   let cc:=50164*c.base+DirectExact80909.num L U S r y y+1
   let cs:=50164*c.slope
   let T:=DirectExact80909.slope L U S r y
   let chi:=Nat.sub (Nat.min c.stop cut) 1
   change VertexKernel80909.triangle cc cs clo chi 0 T pc ps lo hi=true
   by_cases hd:clo≤chi ∧ max lo clo≤hi
   · skip
     let z:=VertexKernel80909.selectZ cs T ps (max lo clo) hi chi
     let x:=VertexKernel80909.selectX cs T clo chi z
     have hb:=VertexKernel80909.selected_bounds cs T ps clo chi (max lo clo) hi hd.1 (by omega) hd.2
     change clo≤x ∧ x≤chi ∧ x≤z ∧ max lo clo≤z ∧ z≤hi at hb
     have hx:x<min c.stop cut:=by
      have hh:=hb.2.1
      change x≤min c.stop cut-1 at hh
      omega
     have hv:=PrefixRangeKernel6816.cellCheck_sound cap B rate clo x {c with stop:=min c.stop boundCut} hc hb.1 (by change x≤min c.stop boundCut-1; omega) (by omega)
     let N:=DirectExact80909.num L U S r y y
     let charge:=ceil (N+1)
     let slope:=ceil T
     have hN:N+1≤50164*charge:=ceil_bound (N+1)
     have hT:T≤50164*slope:=ceil_bound T
     have hfast:PrefixRangeKernel6816.fastCheck cap B rate charge slope lo hi start {p with base:=p.base+1}=true:=by
      rw [←PrefixRangeKernel6816.directCheck_eq]
      exact hf
     have hp:=PrefixRangeKernel6816.ETD cap (B+charge) (max rate slope) 0
      (value {p with base:=p.base+1} start lo) p.slope lo lo hi z hfast (by omega) (by omega) (by omega) hb.2.2.2.2
     have hM0:=Nat.mul_le_mul_right x (le_max_left rate slope)
     have hM1:=Nat.mul_le_mul_right (z-x) (le_max_right rate slope)
     have hz:x+(z-x)=z:=by omega
     have hM:rate*x+slope*(z-x)≤max rate slope*z:=by
      calc
       _≤max rate slope*x+max rate slope*(z-x):=Nat.add_le_add hM0 hM1
       _=max rate slope*z:=by rw [←Nat.mul_add,hz]
     have hleft:=Nat.mul_le_mul_left 50164 hv
     have hright:=Nat.mul_le_mul_left 50164 hp
     have hrate:=Nat.mul_le_mul_left 50164 hM
     have hstep:=Nat.mul_le_mul_right (z-x) hT
     change value c clo x≤B+rate*x at hv
     simp only [PrefixRangeKernel6816.affine,value,Nat.sub_zero] at hp
     change 50164*(c.base+c.slope*(x-clo))≤50164*(B+rate*x) at hleft
     change 50164*(B+charge+max rate slope*z)≤50164*(p.base+1+p.slope*(lo-start)+p.slope*(z-lo)) at hright
     simp only [VertexKernel80909.triangle,if_pos hd,Nat.ble_eq]
     change TP.left cc cs clo 0 T x z≤TP.right pc ps lo z
     simp only [TP.left,TP.right]
     dsimp [cc,cs,pc,ps]
     change 50164*c.base+N+1+50164*c.slope*(x-clo)+0+T*(z-x)≤50164*(p.base+p.slope*(lo-start)+1)+50164*p.slope*(z-lo)
     nlinarith [hleft,hright,hrate,hstep]
   · simp only [VertexKernel80909.triangle,if_neg hd]
 · simp only [DirectExact80909.exactPiece,DirectNat80909.blt_cond,if_neg he]

lemma child_of_fast(cap L U S r y B rate lo hi start cut boundCut:ℕ)(p:Piece)(ps:List Piece)
 (hc:curveCheck cap boundCut B rate ps=true)(hf:test L U S r y B rate lo hi start p=true)(hcap:hi≤cap)(hdom:min cut (hi+1)≤boundCut):
 DirectNat80909.cells (min cut (hi+1))
  (fun clo c=>DirectExact80909.exactPiece L U S r y lo hi start p cut clo c) ps 0=true:=by
 rw [DirectNat80909.cells_eq]
 apply PrefixRangeKernel6816.cells_transfer cap (min cut (hi+1)) (min boundCut (cap+1))
  (fun clo c=>PrefixRangeKernel6816.cellCheck cap B rate clo {c with stop:=min c.stop boundCut}) _ ps 0
 · omega
 · exact hc
 · intro clo c hclo hcell
   exact piece_of_fast cap cut boundCut L U S r y B rate lo hi start clo p c hcell hf hcap hdom
end ProximityPrize.SubmissionLower.ExactMultiKernel6816
