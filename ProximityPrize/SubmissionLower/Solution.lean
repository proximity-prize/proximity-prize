private lemma prv_m100_aux_ker:
    RingHom.ker (Q.prv_m100_aux P)=Ideal.map (rename Sum.inr) (RingHom.ker (aeval P.val)):=by
  rw [prv_m100_aux_eq_comp, ←AlgHom.comap_ker,MvPolynomial.ker_mapAlgHom]
  change Ideal.comap _ (Ideal.map (IsScalarTower.toAlgHom R (MvPolynomial ι R) _) _)=_
