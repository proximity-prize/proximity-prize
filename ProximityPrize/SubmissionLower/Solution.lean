      simp [Fin.sum_univ_succ,agreementCap,hm0,hm1,hm2]
    rw [hnodes,hcost] at hraw
    change (geometricPolynomials K F Gamma g).card*(agreements-w) ≤
      (n-w)*(capY*g.1.degreeOf 1+capR*g.1.degreeOf 0)
    exact hraw
  calc
