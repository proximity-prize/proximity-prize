set_option maxRecDepth 100000
noncomputable section
abbrev P4:=NI.P4
local instance (p:FlagDegree):Decidable (WM.Critical p):=by
 unfold WM.Critical;infer_instance

def Policy:Prop:= ∀(p:FlagDegree),1≤p.all→p.all≤28→middle p≤117→total p≤8499→
 ¬TG.terminal.Routeable p→
 ABM.combined (MX.fee p.all (middle p) p.zOnly)
  (NI.finalCap p) p.all (middle p) p.zOnly≤MX.budget

theorem fee_critical (p:FlagDegree):MX.fee p.all (middle p) p.zOnly=
 (if WM.Critical p then 0 else 1):=by
 unfold MX.fee MX.CoreRow WM.Critical
 have ht:middle p+p.zOnly=total p:=by unfold middle total;omega
 rw [ht]
 congr 1
 apply propext
 tauto

theorem GAJ [eqP:DecidableEq P4] (hp:Policy):NI.Budget:=by
 have heq:eqP=Classical.decEq P4:=Subsingleton.elim _ _
 cases heq
 intro H V U hUV hR hY hT hstop hterm hr hy ht
 classical
 let p:=BF H U
 have hn:ABM.combined (MX.fee p.all (middle p) p.zOnly)
   (NI.finalCap p) p.all (middle p) p.zOnly≤MX.budget:=by
  by_cases hpos:1≤p.all
  · exact hp p hpos hr hy ht hterm
  · have hz:p.all=0:=by omega
    have he:=WM.FQW H U hz
    have hpzero:p=⟨0,0,0⟩:=by simp [p,he,BF,FV.sumFlag]
    rw [hpzero]
    decide+kernel
 have htotal:middle p+p.zOnly=total p:=by unfold middle total;omega
 unfold NI.combined
 change NI.finalCap p+_+_+_+_+_+_≤_
 rw [fee_critical] at hn
 by_cases hc:WM.Critical p
 · have hf:=WM.FEG H V U hUV hR hY hT hstop hc
   simp only [if_pos hc] at hn
   simp only [ABM.combined,Nat.zero_mul,Nat.add_zero,htotal] at hn
   change _≤MX.budget at hn
   change _≤NI.budget
   change CY.cost _ _ _ _ _ _+CY.cost _ _ _ _ _ _+_≤_ at hf
   unfold NI.charge
   change _≤274980718450187492 at hn ⊢
   dsimp only [p] at hn hf ⊢
   omega
 · have hf:=WM.FKO H V U hUV hR hY hT
   simp only [if_neg hc] at hn
   simp only [ABM.combined,Nat.one_mul,htotal] at hn
   have hcharge:ABM.feeNum p.all (middle p) p.zOnly/50164=
     CY.cost 88902 1382 308 (50-p.all) (229-middle p) (11784-total p):=by
    have he:11784-middle p-p.zOnly=11784-total p:=by omega
    unfold ABM.feeNum
    rw [he,CY.cost_eq]
   rw [hcharge] at hn
   change CY.cost _ _ _ _ _ _+CY.cost _ _ _ _ _ _+_≤_ at hf
   unfold NI.charge
   change _≤274980718450187492 at hn ⊢
   dsimp only [p] at hn hf ⊢
   omega
end
