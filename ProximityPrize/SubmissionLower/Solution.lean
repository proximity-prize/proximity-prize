def exactPiece (L U S r y lo hi start : ℕ) (p : Piece) (cut cstart : ℕ) (c : Piece) : Bool :=
 bif Nat.blt cstart (Nat.min c.stop cut) then
  DirectNat80909.triangle
   (Nat.add (Nat.add (Nat.mul 50134 c.base) (num L U S r y y)) 1) (Nat.mul 50134 c.slope)
   cstart (Nat.sub (Nat.min c.stop cut) 1) 0 (slope L U S r y)
   (Nat.mul 50134 (Nat.add (Nat.add p.base (Nat.mul p.slope (Nat.sub lo start))) 1))
   (Nat.mul 50134 p.slope) lo hi
 else true
lemma piece_eq (L U S r y lo hi start : ℕ) (p : Piece) (cut cstart : ℕ) (c : Piece) :
 exactPiece L U S r y lo hi start p cut cstart c=Codec2.exactPiece L U S r y lo hi start p cut cstart c := by
 simp only [exactPiece,DirectNat80909.triangle_eq,num_eq,slope_eq,Codec2.exactPiece,value]
 cases Nat.blt cstart (Nat.min c.stop cut) <;> rfl

def child (r v j lo hi start : ℕ) (p : Piece) (q u : ℕ) : Bool :=
 DirectNat80909.cells (Nat.min (fastCut q u j) (Nat.add hi 1))
  (fun cstart c=>exactPiece (src j).totalCap (src j).middleCap (src j).slopeCap
   (Nat.sub r q) (Nat.add (Nat.sub r q) (Nat.sub v u)) lo hi start p (fastCut q u j) cstart c)
  (UD.final q u) 0
lemma child_eq (r v j lo hi start : ℕ) (p : Piece) (q u : ℕ) :
 child r v j lo hi start p q u=Codec2.exactChild r v j lo hi start p q u := by
