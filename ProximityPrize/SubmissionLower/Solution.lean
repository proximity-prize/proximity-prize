      Polynomial.eval_mul,Polynomial.eval_C]
    rw [Lagrange.eval_interpolate_at_node u0 hinj hi,
      Lagrange.eval_interpolate_at_node u1 hinj hi,
      hvalues gamma hgamma i hi]
    ring
