    (Rₚ) [CommRing Rₚ] [Algebra R Rₚ] [IsLocalization.AtPrime Rₚ p.asIdeal]:
    p∈freeLocus R M ↔ Module.Free Rₚ (Rₚ ⊗[R] M):=by
  exact mem_freeLocus_of_isLocalization p Rₚ (f:=TensorProduct.mk R Rₚ M 1)
