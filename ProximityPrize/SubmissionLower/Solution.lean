    (hproper:¬G∣surfaceMap φ (agreementNumerator (F0*Q) w c x0 u0 u1)):
    ¬F0∣agreementNumerator F0 w c x0 u0 u1:=by
  intro hF0cut
  have hcut:G∣surfaceMap φ (agreementNumerator F0 w c x0 u0 u1):=
    hGdivF0.trans (map_dvd (surfaceMap φ) hF0cut)
