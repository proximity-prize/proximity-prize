    rw [←hspanZ]
    apply Submodule.span_le.mpr
    intro x hx
    rw [Set.mem_singleton_iff.mp hx]
    have hS_mem:D K L r+a • D K L z∈
        Submodule.span L ({D K L z}:Set Ω[L⁄K]):=by
      rw [hspanZ]
      trivial
    obtain ⟨b,hb⟩:=Submodule.mem_span_singleton.mp hS_mem
    have hb0:b≠0:=by
