theorem monomial_eq (d:Fin 4 →₀ ℕ) (a:K):
    MvPolynomial.monomial d a=
      MvPolynomial.C a*MvPolynomial.X 0^d 0*MvPolynomial.X 1^d 1*
        MvPolynomial.X 2^d 2*MvPolynomial.X 3^d 3:=by
