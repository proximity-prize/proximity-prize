    axisDegree f 0 + axisDegree f 1 ≤ paidCap f.natDegree → ∀ T : Finset K1.K, T ⊆ Γ →
    (∀ γ ∈ T, atMark f (M.label γ) (F.scalar γ) = 0) →
    T.card ≤ retainedCap .h2367

