theorem count {ι:Type*} [DecidableEq ι]
    (s:Finset ι) (r v z count:ι→ℕ) (cap:ℕ)
    (hr: ∀i∈s,1≤r i)
    (hR:(∑ i∈s,r i)≤29) (hy:(∑ i∈s,r i)+(∑ i∈s,v i)≤122)
    (ht:(∑ i∈s,r i)+(∑ i∈s,v i)+(∑ i∈s,z i)≤11192)
    (hsingle: ∀i∈s,count i≤AF.cap (r i) (v i) (z i))
    (hb:BaseBound (∑ i∈s,r i) (∑ i∈s,v i) (∑ i∈s,z i) cap):
    (∑ i∈s,count i)≤cap:=by
  have individual (i:ι) (hi:i∈s):
      r i≤29∧r i+v i≤122∧r i+v i+z i≤11192:=by
    have hri:=Finset.single_le_sum (fun k _=>Nat.zero_le (r k)) hi
    have hvi:=Finset.single_le_sum (fun k _=>Nat.zero_le (v k)) hi
    have hzi:=Finset.single_le_sum (fun k _=>Nat.zero_le (z k)) hi
    omega
  rcases hb with ⟨j,hj,hbudget⟩ | ⟨hr10,hr19,hv70,hzero,hheavy⟩
  · apply (PV.sum_count_le 29 122 (full_slope j)
      (lookup (full_own j)) (lookup (full_packed j)) (full_bellman j hj)
      s r v z count hr hR hy ?_).trans hbudget
    intro i hi
    have h:=individual i hi
    exact (hsingle i hi).trans (ACV.full_sound (r i) (v i) (z i)
      (hr i hi) h.1 h.2.1 h.2.2 (CMP.checked _ _ (hr i hi) h.1 h.2.1) j hj)
  · apply NK.one_heavy 10 19 70 cap s r v z count
      (fun j:Fin 14=>light_slope j.val)
      (fun j:Fin 14=>lookup (light_own j.val))
      (fun j:Fin 14=>lookup (light_packed j.val)) AF.cap
      hr hr19 hv70 (by omega) (fun j=>GTD j.val j.isLt) ?_ hsingle ?_ ?_
    · intro i hi hlight j
      have h:=individual i hi
      have hvi:=Finset.single_le_sum (fun k _=>Nat.zero_le (v k)) hi
      exact (hsingle i hi).trans (ACV.light_sound (r i) (v i) (z i)
        (hr i hi) hlight (by omega) h.2.2 (CMP.checked _ _ (hr i hi) h.1 h.2.1) j.val j.isLt)
    · obtain ⟨j,hj,hbudget⟩:=hzero
      exact ⟨⟨j,hj⟩,hbudget⟩
    · intro q u hq hqr hu
      obtain ⟨j,hj,hbudget⟩:=hheavy q u hq hqr hu
      exact ⟨⟨j,hj⟩,hbudget⟩

end DNJ

