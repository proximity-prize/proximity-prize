 (hr:r<50) (ht:y+z≤12442):
 50154*combined fee (base+slope*(z-start)) r y z≤cleared fee r y start base slope z:=by
 have hp:=pair_le r y (y+z) ht
 have hd:=Nat.div_mul_le_self (feeNum r y z) 50154
 have hd' :=Nat.mul_le_mul_left fee hd
 unfold combined cleared others
 rw [QQ.cap,if_pos hr]
 nlinarith only [hp,hd']

