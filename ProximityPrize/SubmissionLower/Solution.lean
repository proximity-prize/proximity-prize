theorem GGC (ys:List ℕ) (hys: ∀y ∈ ys,y<2^62) (xs:List ℕ) (hxs: ∀x ∈ xs,x<2^62)
    (zs:List ℕ) (hzs: ∀z ∈ zs,z<2^63)
