theorem baseSound : StateLocalBaseOracleSound (cap 0) := by
  intro ι _ A p hpos hs hy ht
  classical
  by_cases hA : A.Nonempty
  · obtain ⟨i, hi⟩ := hA
    have hp : 1 ≤ (sumFlag A p).all := by
      rw [sumFlag_all]
      exact (hpos i hi).trans (Finset.single_le_sum (f := fun j => (p j).all) (fun _ _ => Nat.zero_le _) hi)
    have hb := LocatorPhase6800BaseSparseChecked.stateLocalSound A p hpos hs hy ht
    simpa only [cap, if_neg (show (sumFlag A p).all ≠ 0 by omega), capBefore,
      baseAt, context, LocatorPhase6800BaseDirectData.cap] using hb
  · have he : A = ∅ := Finset.not_nonempty_iff_eq_empty.mp hA
    subst A
    simp

variable (checked : ∀ r v : ℕ, 1 ≤ r → r ≤ 29 → r+v ≤ 135 → CellCheck r v)

include checked

theorem pref_mono_r (h r s v : ℕ) (hh : h < 6) (hr : 1 ≤ r) (hrs : r ≤ s)
    (hs : s ≤ 29) (hy : s+v ≤ 135) : pref h r v ≤ pref h s v := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hrs
  induction d with
  | zero => simp
  | succ d ih =>
      have hi := ih (by omega) (by omega) (by omega)
      have hc := (checked (r+d) v (by omega) (by omega) (by omega)).2.2 h
        (List.mem_range.mpr hh)
      exact hi.trans (by simpa only [Nat.add_assoc] using hc.1 (by omega) (by omega))

theorem pref_mono_v (h r v w : ℕ) (hh : h < 6) (hr : 1 ≤ r) (hr29 : r ≤ 29)
    (hvw : v ≤ w) (hy : r+w ≤ 135) : pref h r v ≤ pref h r w := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hvw
  induction d with
  | zero => simp
  | succ d ih =>
      have hi := ih (by omega) (by omega)
      have hc := (checked r (v+d) hr hr29 (by omega)).2.2 h (List.mem_range.mpr hh)
      exact hi.trans (by simpa only [Nat.add_assoc] using hc.2 (by omega))

theorem phaseDefect (h : ℕ) (hh : h < 6) :
    PhaseDefectSound (cap h) (phaseSource h) (phasePotential h) (defect h) := by
  intro p q hpS hpY hpT hbelow hno
  rcases hbelow with ⟨⟨hr, hv, hz⟩, hstrict⟩
  by_cases hq0 : q.all = 0
  · rw [cap_zero h q hq0]
    exact Nat.zero_le _
  have hq1 : 1 ≤ q.all := by omega
  have hqS : q.all ≤ 29 := by omega
  have hqY : q.all+q.yz ≤ 135 := by simp only [middle] at hpY; omega
  have hqT : q.all+q.yz+q.zOnly ≤ 6677 := by simp only [total] at hpT; omega
  have hc := checked q.all q.yz hq1 hqS hqY
  have ht : ¬ threshold h q.all q.yz ≤ q.zOnly := by
    intro hth
    have he := route_of_threshold (hc.2.1 h (List.mem_range.mpr hh)) hqT hth
    exact hno (by cases q; exact he)
  have htgt := phaseTerminal_of_runs (context q.all q.yz) h (runs q.all q.yz h)
    (hc.1 h (List.mem_range.mpr hh)) q.zOnly (by dsimp [context]; omega)
  have hterm : cap h q ≤ (phasePotential h).eval q + pref h q.all q.yz := by
    have he := htgt.resolve_left ht
    simpa only [cap, if_neg hq0, hereCharge, context, rawFlag] using he
  have hpref : pref h q.all q.yz ≤ defect h p := by
    unfold defect
    exact (pref_mono_r checked h q.all (p.all-1) q.yz hh hq1 (by omega)
      (by omega) (by simp only [middle] at hpY; omega)).trans
      (pref_mono_v checked h (p.all-1) q.yz p.yz hh (by omega) (by omega) hv
        (by simp only [middle] at hpY; omega))
  exact hterm.trans (Nat.add_le_add_left hpref _)


theorem nextCap_le (h : ℕ) (hh : h < 6) (p : FlagDegree)
    (hs : p.all ≤ 29) (hy : middle p ≤ 135) (ht : total p ≤ 6677) :
    (if (phaseSource h).Routeable p then
      min (cap h p) ((phasePotential h).eval p + defect h p) else cap h p) ≤ cap (h+1) p := by
  by_cases hp0 : p.all = 0
  · rw [cap_zero h p hp0, cap_zero (h+1) p hp0]
    split <;> simp
  have hr : 1 ≤ p.all := by omega
  have hc := checked p.all p.yz hr hs (by simp only [middle] at hy; omega)
  by_cases hth : threshold h p.all p.yz ≤ p.zOnly
  · have hroute : (phaseSource h).Routeable p := by
      have he := route_of_threshold (hc.2.1 h (List.mem_range.mpr hh))
        (by simp only [total] at ht; omega) hth
      cases p
      exact he
    simp only [if_pos hroute, cap, if_neg hp0, capBefore, context, if_pos hth,
      parentCharge, defect, rawFlag]
    exact le_rfl
  · have hstep : cap (h+1) p = cap h p := by
      simp only [cap, if_neg hp0, capBefore, context, if_neg hth]
    rw [hstep]
    split
    · exact min_le_left _ _
    · exact le_rfl

theorem phaseStep (h : ℕ) (hh : h < 6)
    (u0 u1 : I → K) (H : P4) (selected : K → Polynomial K) (Gamma : Finset K)
    (ambient : Finset (RegularIndex H))
    (hdegree : ∀ gamma ∈ Gamma, (selected gamma).natDegree ≤ 131071)
    (hagreement : ∀ gamma ∈ Gamma, 181363 ≤
      ((Finset.univ : Finset I).filter (fun i =>
        (selected gamma).eval (IRSProfile.domain i) = u0 i + gamma*u1 i)).card)
    (hno : NoLargeSelectedPencil selected Gamma 131071 80781)
    (hprevious : StateLocalRegularBoundOn H selected Gamma ambient (cap h)) :
    StateLocalRegularBoundOn H selected Gamma ambient (cap (h+1)) := by
  let next : FlagDegree → ℕ := fun p =>
    if (phaseSource h).Routeable p then
      min (cap h p) ((phasePotential h).eval p + defect h p) else cap h p
  have hd : PhaseDefectSound (cap h) (sourceSound h).source
      (sourceSound h).potential (defect h) := by
    rw [sourceSound_source, sourceSound_potential]
    exact phaseDefect checked h hh
  have he : PhaseCapEquation (cap h) next (sourceSound h).source
      (sourceSound h).potential (defect h) := by
    rw [sourceSound_source, sourceSound_potential]
    intro p _ _ _
    rfl
  have hn := stateLocalRegularBoundOn_onePhase (sourceSound h) u0 u1 (sourceKernel h u0 u1)
    H selected Gamma ambient hdegree hagreement hno (cap h) next (defect h) hprevious hd he
  intro A hA hs hy ht
  exact (hn A hA hs hy ht).trans (nextCap_le checked h hh _ hs hy ht)

