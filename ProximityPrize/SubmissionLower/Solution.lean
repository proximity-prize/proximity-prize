        (MvPolynomial.pderiv (0:Fin 3) F-
          MvPolynomial.C mu*MvPolynomial.pderiv (1:Fin 3) F):=by
  induction F using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ =>
