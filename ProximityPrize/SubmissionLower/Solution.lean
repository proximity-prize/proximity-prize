    [IsNoetherianRing R] [IsJacobsonRing R] (x:PrimeSpectrum R):
    List.TFAE [IsOpen {x},IsClopen {x},IsClosed {x}∧StableUnderGeneralization {x}]:=by
  tfae_have 1 → 2
  | h => by
