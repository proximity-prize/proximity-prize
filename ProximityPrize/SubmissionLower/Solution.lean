variable {R:Type*} [CommRing R] [IsDedekindDomain R]
lemma Ideal.finprod_heightOneSpectrum_pow_multiplicity {I:Ideal R} (hI:I≠⊥):
    ∏ᶠ p:HeightOneSpectrum R,p.asIdeal^multiplicity p.asIdeal I=I:=by
