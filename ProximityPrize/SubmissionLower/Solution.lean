  map_one:=Subtype.ext <| (algebraMap S R).map_one
  map_mul _x _y:=Sigma.subtype_ext (add_zero 0).symm <| (algebraMap S R).map_mul _ _
  commutes:=fun _r ⟨i,_xi⟩ =>
