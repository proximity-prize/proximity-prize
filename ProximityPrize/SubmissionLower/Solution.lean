theorem EWW
    (hrules:ADF.Rules) (hbudget:Budget)
    (u0 u1:I→K) (S:SelectedPair u0 u1)
    (selected:K→Polynomial K) (Gamma:Finset K) (inp:Input u0 u1 selected Gamma):
    Gamma.card≤budget:=by
  let H:P4:=gcd12 S.QA S.QB
  let Q:P4:=quotientB S.QA S.QB
  let T:P4:=quotientA S.QA S.QB
  let phi:K→P4→+*Polynomial K:=fun g=>(BM K (selected g) g).toRingHom
  let D:=LocatorCover.fixed phi Gamma S.QA S.QB
  let E:=LocatorCover.residual phi Gamma S.QA S.QB
  have hH:H ≠ 0:=gcd_ne_zero_of_left S.QA_ne
  have hQeq:S.QB=H*Q:=DAP S.QA S.QB
  have hTeq:S.QA=H*T:=DBH S.QA S.QB
  have hQ:Q ≠ 0:=by
    intro hz
    exact S.QB_ne (by rw [hQeq,hz,mul_zero])
  have hT:T ≠ 0:=by
    intro hz
    exact S.QA_ne (by rw [hTeq,hz,mul_zero])
  have hb:=DZF K 30085010 131071 17230 50 S.QB S.QB_flag
  have hHbox:H ∈ RCN174.BA K 30085010 131071 17230 50:=
    QS H S.QB 30085010 131071 17230 50 S.QB_ne
      (gcd_dvd_right S.QA S.QB) hb
  have hQbox:Q ∈ RCN174.BA K 30085010 131071 17230 50:=
    QS Q S.QB 30085010 131071 17230 50 S.QB_ne
      ⟨H,hQeq.trans (mul_comm H Q)⟩ hb
  have hsubD:D ⊆ Gamma:=by
    intro g hg
    have hm:g ∈ Gamma∧(phi g) H=0:=by
      simpa only [D,H,LocatorCover.fixed,Finset.mem_filter] using hg
    exact hm.1
  have hsubE:E ⊆ Gamma:=by
    intro g hg
    have hm:g ∈ Gamma∧(phi g) H ≠ 0:=by
      simpa only [E,H,LocatorCover.residual,Finset.mem_filter] using hg
    exact hm.1
  have inpD:=inp.restrict D hsubD
  have inpE:=inp.restrict E hsubE
  have hparents (g:K) (hg:g ∈ Gamma):
      BM K (selected g) g S.QA=0∧BM K (selected g) g S.QB=0:=
    S.EEM g (selected g)
      ((Finset.univ:Finset I).filter (fun i=>
        (selected g).eval (IRSProfile.domain i)=u0 i+g*u1 i))
      (inp.degree g hg) (inp.agreement g hg) (fun _ hi=>(Finset.mem_filter.mp hi).2)
  have hsolD: ∀g ∈ D,BM K (selected g) g H=0:=
    LocatorCover.fixed_vanish phi Gamma S.QA S.QB
  have hsolE: ∀g ∈ E,BM K (selected g) g T=0∧BM K (selected g) g Q=0:=
    LocatorCover.GGN phi Gamma S.QA S.QB
      (fun g hg=>(hparents g hg).1) (fun g hg=>(hparents g hg).2)
  have hcD:=FoldGeometry.cover_count' H H hH selected D hsolD hsolD
  have hcE:=FoldGeometry.cover_count' Q T hQ selected E
    (fun g hg=>(hsolE g hg).2) (fun g hg=>(hsolE g hg).1)
  have hrD:(∑ F:RegularIndex H,(RCN052.NQ H H selected D F).card)≤
      (∑ F:RegularIndex H,(regularSeeds H selected D F).card):=
    Finset.sum_le_sum (fun F _=>Finset.card_le_card
      (ESN.DXJ H selected D F))
  have hfreeD:=FJZ inpD H hH hHbox
  have hfreeE:=FJZ inpE Q hQ hQbox
  have hwhole:=CMW.EMI u0 u1 S
  change (BF H Finset.univ).all≤50∧
    middle (BF H Finset.univ)≤229∧
    total (BF H Finset.univ)≤11784 at hwhole
  let support:RCN275.BT:=
    ⟨50,229,17230,by decide,by decide,by decide,by decide⟩
  obtain ⟨V,U,hVA,hUV,hVstop,hUstop,hr,hy,ht,hreg⟩:=
    ADF.FMR 30085010 support (by decide) (by decide)
      H hH hHbox selected D u0 u1 inpD.degree inpD.agreement inpD.noPencil
      Finset.univ hwhole.1 hwhole.2.1 hwhole.2.2 hrules
  let p:=BF H U
  have hreg' :(∑ F:RegularIndex H,(regularSeeds H selected D F).card)≤
      finalCap p+charge 18000 348 78 (BF H (Finset.univ\V))+
        charge 88902 1382 308 (BF H (V\U)):=by
    simpa only [finalCap,charge,ADF.charge] using hreg
  have hprod:H*Q ∈ RCN100.BA K 30085010 131071 17230 50:=by
    rw [← hQeq]
    exact S.QB_flag
  have hprodA:H*T ∈ RCN100.BA K 45671220 131071 11785 78:=by
    rw [← hTeq]
    exact S.QA_flag
  have hrE:=QQ.pair_count inpE H Q T hH hQ hT
    (EIQ S.QA_ne).symm hprod hprodA Finset.univ
  change (∑ F:RCN052.RegularIndex Q,(RCN052.NQ Q T selected E F).card)≤
    QQ.cap (BF H Finset.univ).all (middle (BF H Finset.univ)) (total (BF H Finset.univ)) at hrE
  have hcharge:=FoldBudgets.joint_charge' H Q hH hQ hprod hHbox hQbox U
    u0 u1 selected D E inpD inpE (hr.trans (by decide)) (hy.trans (by decide)) (ht.trans (by decide))
  have hbound:=hbudget H V U hUV hwhole.1 hwhole.2.1 hwhole.2.2 hVstop hUstop hr hy ht
  change (∑ F:RegularIndex H,factorCharge' F.1 selected D)+
    (∑ F:RegularIndex Q,factorCharge' F.1 selected E)≤
      p.all*foldUnit (middle p) (total p) p.all+
      (50-p.all)*foldUnit (229-middle p) (17230-total p) (50-p.all)+50*0 at hcharge
  have hpart:D.card+E.card=Gamma.card:=LocatorCover.GNT phi Gamma S.QA S.QB
  have hcfixed:D.card≤(∑ F:RegularIndex H,(RCN052.NQ H H selected D F).card)+
      (∑ F:RegularIndex H,factorCharge' F.1 selected D)+(rfreeSeeds H selected D).card:=by
    simpa only [RCN052.RegularIndex,RCN266.RegularIndex] using hcD
  have hcresidual:E.card≤(∑ F:RegularIndex Q,(RCN052.NQ Q T selected E F).card)+
      (∑ F:RegularIndex Q,factorCharge' F.1 selected E)+(rfreeSeeds Q selected E).card:=by
    simpa only [RCN052.RegularIndex,RCN266.RegularIndex] using hcE
  have hrresidual:(∑ F:RegularIndex Q,(RCN052.NQ Q T selected E F).card)≤
      QQ.cap (BF H Finset.univ).all (middle (BF H Finset.univ)) (total (BF H Finset.univ)):=by
    simpa only [RCN052.RegularIndex,RCN266.RegularIndex] using hrE
  change finalCap p+charge 18000 348 78 (BF H (Finset.univ\V))+
    charge 88902 1382 308 (BF H (V\U))+
    p.all*foldUnit (middle p) (total p) p.all+
    (50-p.all)*foldUnit (229-middle p) (17230-total p) (50-p.all)+
    16220000000000+QQ.cap (BF H Finset.univ).all
     (middle (BF H Finset.univ)) (total (BF H Finset.univ))≤budget at hbound
  exact join_counts hpart hcfixed hcresidual hrD hreg' hrresidual hcharge hfreeD hfreeE hbound

