theorem FKG {α:Type*} [Preorder α] (f:ℕ→ℕ→α) (Rcap Ycap:ℕ)
    (hR: ∀r v,r+1≤Rcap→ r+1+v≤Ycap→f r v≤f (r+1) v)
    (hV: ∀r v,r≤Rcap→ r+v+1≤Ycap→f r v≤f r (v+1))
