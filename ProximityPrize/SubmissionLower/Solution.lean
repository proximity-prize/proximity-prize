     dsimp [cc,cs,pc,ps]
     change 50134*c.base+N+1+50134*c.slope*(x-clo)+0+T*(z-x)≤50134*(p.base+p.slope*(lo-start)+1)+50134*p.slope*(z-lo)
     nlinarith [hleft,hright,hrate,hstep]
