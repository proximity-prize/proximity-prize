def packetOffer:Fin 3→Band:= ![⟨13,62,2986,4116,265416000000000000⟩,⟨14,60,2986,3969,263030000000000000⟩,⟨14,62,2443,2985,235644000000000000⟩]
theorem packet_count (i:Fin 3) {D L s:ℕ} {H:MvPolynomial (Fin 4) K}
