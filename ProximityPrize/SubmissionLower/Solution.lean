theorem rect_price (incidence : TwoCutIncidence) : RectPrice := by
  classical
  intro u del M Γ F hw hshift H hH _ _ _ f hf _ hel heu hvpos haxes T hT hr
  let e := f.natDegree
  let v := paidCap e
  let v₀ := axisDegree f 0
