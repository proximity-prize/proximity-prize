def Cotangent.map (f:Hom P P'):P.Cotangent →ₗ[S] P'.Cotangent where
  toFun x:=.of (Ideal.mapCotangent (R:=R) _ _ f.toAlgHom
    (fun x hx↦by simpa using RingHom.congr_arg (algebraMap S S') hx) x.val)
