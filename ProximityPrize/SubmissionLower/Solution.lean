  · have hsmall : 179886*(ell-s+k) ≤ (179886-s)*(ell+k) := by
      zify [hse, ha]
      nlinarith only [mul_nonneg (show (0 : ℤ) ≤ s by positivity)
        (show (0 : ℤ) ≤ 179886-ell-k by omega)]
    refine Nat.le_of_mul_le_mul_left ?_ (by decide : 0 < 179886)
    calc
