noncomputable def liftOfSurjective [FormallySmooth R A] (f:A →ₐ[R] C)
    (g:B →ₐ[R] C) (hg:Function.Surjective g) (hg':IsNilpotent <| RingHom.ker (g:B →+*C)):
    A →ₐ[R] B:=
