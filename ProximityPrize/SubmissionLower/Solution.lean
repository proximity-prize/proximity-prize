def fullNum (j r v:ℕ):=lookup (full_packed j) r v
def lightNum (j r v:ℕ):=lookup (light_packed j) r v

def BaseBound (r v z cap:ℕ):Prop:=
  (∃j,j<8∧full_slope j*z+fullNum j r v≤cap)∨
  (10≤r∧r≤19∧v≤70∧
    (∃j,j<14∧light_slope j*z+lightNum j r v≤cap)∧
    ∀q u,10≤q→q≤r→u≤v→ ∃j,j<14∧ ∀x,x≤z→
      AF.cap q u x+light_slope j*(z-x)+lightNum j (r-q) (v-u)≤cap)

def lineCheck (slope base lo hi start:ℕ) (p:Piece):Bool:=
  if lo≤hi then Nat.ble (slope*lo+base) (value p start lo) &&
    Nat.ble (slope*hi+base) (value p start hi) else true

theorem DQO (slope base lo hi start:ℕ) (p:Piece)
    (h:lineCheck slope base lo hi start p=true) (z:ℕ)
    (hz:lo≤z) (hh:z≤hi) (hs:start≤lo):slope*z+base≤value p start z:=by
  simp only [lineCheck,if_pos (hz.trans hh),Bool.and_eq_true,Nat.ble_eq] at h
  have hm:=TP.BCJ lo hi z 0 start base p.base slope p.slope
    (Nat.zero_le _) hs hz hh
    (by simpa only [value,Nat.sub_zero,Nat.add_comm] using h.1)
    (by simpa only [value,Nat.sub_zero,Nat.add_comm] using h.2)
  simpa only [value,Nat.sub_zero,Nat.add_comm] using hm

def childPiece (slope charge lo hi start:ℕ) (p:Piece) (cstart:ℕ) (c:Piece):Bool:=
  TP.check c.base c.slope cstart (c.stop-1) charge slope
    (value p start lo) p.slope lo hi
def childCheck (slope charge lo hi start:ℕ) (p:Piece) (child:List Piece):Bool:=
  allCells (childPiece slope charge lo hi start p) 0 child

theorem GEW (slope charge lo hi start:ℕ) (p:Piece) (finish:ℕ) (child:List Piece)
    (hv:validFrom finish 0 child=true) (hc:childCheck slope charge lo hi start p child=true)
    (x z:ℕ) (hxf:x<finish) (hxz:x≤z) (hz:lo≤z) (hh:z≤hi) (hs:start≤lo):
    eval child x+slope*(z-x)+charge≤value p start z:=by
  obtain ⟨clo,c,hclo,hchi,he,hc⟩:=cell_at _ 0 finish child hv (ANC _ 0 child hc) x (Nat.zero_le _) hxf
  have h:=TP.check_sound _ _ _ _ _ _ _ _ _ _ x z hc hclo (by omega) hxz hz hh
  have hp:value p start lo+p.slope*(z-lo)=value p start z:=by
    unfold value
    rw [show z-start=(lo-start)+(z-lo) by omega,Nat.mul_add]
    omega
  change value c clo x+charge+slope*(z-x)≤value p start lo+p.slope*(z-lo) at h
  rw [hp] at h
  simpa only [eval,he,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using h

def ETZ:ℕ→ℕ→ℕ
 | 0,_=>0
 | n+1,code=>
   let count:=code%1024
   let value:=code/1024%16
   value*((16^count-1)/15)+16^count*ETZ n (code/16384)
def GSY (code:ℕ):=
 if code%16=14 then ETZ (code/16%1024) (code/16384) else code
def digit (code i:ℕ):=GSY code/(16^i)%16
def heavyChoice (code v q u:ℕ):=digit code (1+(q-10)*(v+1)+u)
def heavyCheck (r v code lo hi start:ℕ) (p:Piece):Bool:=
  Nat.blt (digit code 0) 14 && lineCheck (light_slope (digit code 0)) (lightNum (digit code 0) r v) lo hi start p &&
  allN (fun i=>allN (fun u=>
    let q:=i+10
    let j:=heavyChoice code v q u
    Nat.blt j 14 && childCheck (light_slope j) (lightNum j (r-q) (v-u)) lo hi start p
      (UD.single q u).curve) (v+1)) (r-9)

def check (r v aux lo hi start:ℕ) (p:Piece):Bool:=
  if aux<8 then lineCheck (full_slope aux) (fullNum aux r v) lo hi start p
  else decide (aux%16=15∧10≤r∧r≤19∧v≤70∧hi≤7000) &&
    heavyCheck r v (aux/16) lo hi start p

theorem check_sound (r v aux lo hi start:ℕ) (p:Piece)
    (h:check r v aux lo hi start p=true) (z:ℕ)
    (hz:lo≤z) (hh:z≤hi) (hs:start≤lo) (ht:r+v+z≤11192):
    BaseBound r v z (value p start z):=by
  by_cases ha:aux<8
  · left
    simp only [check,if_pos ha] at h
    exact ⟨aux,ha,DQO _ _ _ _ _ p h z hz hh hs⟩
  · right
    simp only [check,if_neg ha,Bool.and_eq_true,decide_eq_true_eq] at h
    obtain ⟨hg,hc⟩:=h
    simp only [heavyCheck,Bool.and_eq_true,Nat.blt_eq] at hc
    refine ⟨hg.2.1,hg.2.2.1,hg.2.2.2.1,?_,?_⟩
    · exact ⟨digit (aux/16) 0,hc.1.1,DQO _ _ _ _ _ p hc.1.2 z hz hh hs⟩
    · intro q u hq hqr hu
      have hhq:=allN_sound _ (r-9) hc.2 (q-10) (by omega)
      have hhu:=allN_sound _ (v+1) hhq u (by omega)
      simp only [show q-10+10=q by omega,Bool.and_eq_true,Nat.blt_eq] at hhu
      refine ⟨heavyChoice (aux/16) v q u,hhu.1,?_⟩
      intro x hx
      have hq39:q≤28:=by omega
      have hqu:q+u≤117:=by omega
      have he:(UD.single q u).curve=AF.curve q u:=
        congrArg CL.Row.curve (UD.single_eq q u (by omega) hq39)
      have hv:validFrom (11193-q-u) 0 (UD.single q u).curve=true:=by
        rw [he]
        exact ACV.curve_valid q u (by omega) hq39 hqu
      have hb:=GEW _ _ lo hi start p (11193-q-u) _ hv hhu.2 x z (by omega) hx hz hh hs
      simpa only [he,AF.cap] using hb

end ACI
end MergedPart2
section MergedPart3
namespace AQS
open DZ ARU
open RCN095 DY FV
open Lower80899.Oracle Lower80899.PowerRoute Lower80899.FactorSwitch
set_option autoImplicit false
set_option maxHeartbeats 3000000
set_option maxRecDepth 100000

def phaseSound (j:ℕ):YF:=
  if j<7 then Lower80899.TenPhase.sound j else Lower80899.SourceSound.PhaseFinal.sound

theorem phase_source (j:ℕ):(phaseSound j).source=(Lower80899.TenPhase.sound (sourceIndex j)).source:=by
  unfold phaseSound sourceIndex
  split_ifs<;>rfl

theorem GVG (j r v z:ℕ) (hr:1≤r) (hR:r≤28) (hy:r+v≤117) (ht:r+v+z≤11192):
    CY.cost (phaseSound j).source.totalCap (phaseSound j).source.middleCap
      (phaseSound j).source.slopeCap r (r+v) (r+v+z)≤affine (phase j) r v z:=by
  by_cases hj:j<7
  · interval_cases j
    · change CY.cost 3840000 88497 19840 r (r+v) (r+v+z)≤3256892485539*(r+v+z)+224424369372269*(r+v)+986153322461098*r
      exact AHU.cost0 r (r+v) (r+v+z) hr hR hy ht
    · change CY.cost 3200000 44249 9888 r (r+v) (r+v+z)≤1625891214897*(r+v+z)+136077046468709*(r+v)+595658330646683*r
      exact AHU.cost1 r (r+v) (r+v+z) hr hR hy ht
    · change CY.cost 2880000 44249 9888 r (r+v) (r+v+z)≤1625891214897*(r+v+z)+130049502859332*(r+v)+570013871545208*r
      exact AHU.cost2 r (r+v) (r+v+z) hr hR hy ht
    · change CY.cost 1062000 22124 4940 r (r+v) (r+v+z)≤812615633673*(r+v+z)+57874051459222*(r+v)+254710585448753*r
      exact AHU.cost3 r (r+v) (r+v+z) hr hR hy ht
    · change CY.cost 531000 11062 2470 r (r+v) (r+v+z)≤406307816837*(r+v+z)+28937025729611*(r+v)+127355292724377*r
      exact AHU.cost4 r (r+v) (r+v+z) hr hR hy ht
    · change CY.cost 88902 1382 308 r (r+v) (r+v+z)≤50714245849*(r+v+z)+4035698934878*(r+v)+17718951857007*r
      exact AHU.cost5 r (r+v) (r+v+z) hr hR hy ht
    · change CY.cost 3640000 19359 4267 r (r+v) (r+v+z)≤706600386625*(r+v+z)+101274217888165*(r+v)+440112212494530*r
      exact AHU.cost6 r (r+v) (r+v+z) hr hR hy ht
  · have h:=(phaseSound j).stageCost_le (rawFlag r v z) 0 hr (by change r≤40;omega)
      (by simp only [rawFlag,middle];omega)
      (by simp only [rawFlag,total];omega) (Nat.zero_le _)
    have hp:(phaseSound j).potential=phase j:=by simp only [phaseSound,phase,if_neg hj,dif_neg hj];rfl
    simpa only [hp,stageCost,stagePair,LP,helperPair,CY.cost,
      PI.pair,rawFlag,Potential.eval,affine,middle,total,Nat.zero_mul,Nat.sub_zero,
      Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using h

theorem EZP (k r y t:ℕ) (hk:k<5) (hr:1≤r)
    (hR:r≤28-floorR k) (hy:y≤117-floorY k) (ht:t≤11192-floorT k):
    CY.cost 88902 1382 308 r y t≤
      (terminal k).totalCoeff*t+(terminal k).middleCoeff*y+(terminal k).slopeCoeff*r:=by
  interval_cases k
  · exact ANB.count0 r y t hr (by simp only [floorR] at hR;omega) (by simp only [floorY] at hy;omega) (by simp only [floorT] at ht;omega)
  · exact ANB.count1 r y t hr (by simp only [floorR] at hR;omega) (by simp only [floorY] at hy;omega) (by simp only [floorT] at ht;omega)
  · exact ANB.count2 r y t hr (by simp only [floorR] at hR;omega) (by simp only [floorY] at hy;omega) (by simp only [floorT] at ht;omega)
  · exact ANB.count3 r y t hr (by simp only [floorR] at hR;omega) (by simp only [floorY] at hy;omega) (by simp only [floorT] at ht;omega)
  · exact ANB.count4 r y t hr (by simp only [floorR] at hR;omega) (by simp only [floorY] at hy;omega) (by simp only [floorT] at ht;omega)

def CAH (L U S r y plo phi pstart:ℕ) (p:Piece) (cut cstart:ℕ) (c:Piece):Bool:=
  if cstart<min c.stop cut then TP.check
    (50164*c.base+CY.num L U S r y y+1) (50164*c.slope)
    cstart (min c.stop cut-1) 0 (BND.tSlope L U S r y)
    (50164*(value p pstart plo+1)) (50164*p.slope) plo phi else true

def DRA (L U S r y plo phi pstart:ℕ) (p:Piece) (cut:ℕ) (child:List Piece):Bool:=
  allCells (CAH L U S r y plo phi pstart p cut) 0 child

theorem FAZ (L U S r y plo phi pstart:ℕ) (p:Piece) (cut cstart:ℕ) (c:Piece)
    (h:CAH L U S r y plo phi pstart p cut cstart c=true)
    (x z:ℕ) (hx0:cstart≤x) (hxc:x<c.stop) (hxcut:x<cut) (hxz:x≤z)
    (hz0:plo≤z) (hz1:z≤phi) (hstart:pstart≤plo):
    value c cstart x+CY.cost L U S r y (y+(z-x))≤value p pstart z:=by
  have hn:cstart<min c.stop cut:=by omega
  simp only [CAH,if_pos hn] at h
  have htri:=TP.check_sound _ _ _ _ _ _ _ _ _ _ x z h hx0 (by omega) hxz hz0 hz1
  have hp:value p pstart plo+p.slope*(z-plo)=value p pstart z:=by
    unfold value
    rw [show z-pstart=(plo-pstart)+(z-plo) by omega,Nat.mul_add]
    omega
  have hn:=BND.num_shift L U S r y (z-x)
  have ha:CY.num L U S r y (y+(z-x))+50164*value c cstart x<
      50164*(value p pstart z+1):=by
    unfold TP.left TP.right at htri
    rw [hn,←hp]
    dsimp only [value] at*
    nlinarith only [htri]
  have hd:(CY.num L U S r y (y+(z-x))+50164*value c cstart x)/50164<value p pstart z+1:=by
    exact (Nat.div_lt_iff_lt_mul (by decide)).mpr (by simpa only [Nat.mul_comm] using ha)
  rw [Nat.add_mul_div_left _ _ (by decide),←CY.cost_eq] at hd
  omega

theorem DTD (L U S r y plo phi pstart:ℕ) (p:Piece)
    (cut finish:ℕ) (child:List Piece)
    (hv:validFrom finish 0 child=true)
    (hc:DRA L U S r y plo phi pstart p cut child=true)
    (x z:ℕ) (hxf:x<finish) (hxc:x<cut) (hxz:x≤z)
    (hz0:plo≤z) (hz1:z≤phi) (hstart:pstart≤plo):
    eval child x+CY.cost L U S r y (y+(z-x))≤value p pstart z:=by
  obtain ⟨lo,c,hlo,hhi,he,hc⟩:=cell_at _ 0 finish child hv (ANC _ 0 child hc) x (Nat.zero_le _) hxf
  simpa only [eval,he] using FAZ L U S r y plo phi pstart p cut lo c hc x z hlo hhi hxc hxz hz0 hz1 hstart

end AQS
end MergedPart3
section MergedPart4
namespace BPE
open DZ ARU AMJ AQS
open FM ACI
open FV
set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option maxRecDepth 100000

def src (j:ℕ):=(Lower80899.TenPhase.sound j).source
def cost (j r v z:ℕ):=CY.cost (src j).totalCap (src j).middleCap
  (src j).slopeCap r (r+v) (r+v+z)
def Payment (j r v z cap:ℕ):Prop:=
  ∀q u x,q<r→u≤v→x≤z→(q=0→u=0∧x=0)→
    (1≤q→x<cut q u j)→
    AA.cap q u x+cost j (r-q) (v-u) (z-x)≤cap

def fastCut (r v j:ℕ):=threshold (CL.thresholds (UD.single r v)) j
def fastPrefix (r v j:ℕ):=coeff (UD.pref r v) j
def fastSeen (r v k:ℕ):=present (UD.pref r v) k

theorem fastCut_eq (r v j:ℕ) (hr:1≤r) (hR:r≤28):fastCut r v j=cut r v j:=by
  unfold fastCut cut
  rw [UD.single_eq r v hr hR]

theorem FVD (r v j:ℕ) (hR:r≤28):fastPrefix r v j=prefixCap r v j:=by
  unfold fastPrefix prefixCap
  by_cases h:r=0
  · subst r;rfl
  · rw [UD.pref_eq r v (by omega) hR]

theorem fastSeen_eq (r v k:ℕ) (hR:r≤28):fastSeen r v k=seen r v k:=by
  unfold fastSeen seen
  by_cases h:r=0
  · subst r;rfl
  · rw [UD.pref_eq r v (by omega) hR]

theorem EMW (p:Potential) (r v z q u x:ℕ) (hq:q≤r) (hu:u≤v) (hx:x≤z):
    affine p q u x+affine p (r-q) (v-u) (z-x)=affine p r v z:=by
  unfold affine
  calc
    _=p.totalCoeff*(q+u+x+((r-q)+(v-u)+(z-x)))+
      p.middleCoeff*(q+u+((r-q)+(v-u)))+p.slopeCoeff*(q+(r-q)):=by ring
    _=_:=by
      rw [show q+u+x+((r-q)+(v-u)+(z-x))=r+v+z by omega,
        show q+u+((r-q)+(v-u))=r+v by omega,show q+(r-q)=r by omega]

theorem cost_phase (j r v z:ℕ) (hr:1≤r) (hR:r≤28) (hy:r+v≤117) (ht:r+v+z≤11192):
    cost (sourceIndex j) r v z≤affine (phase j) r v z:=by
  have h:=GVG j r v z hr hR hy ht
  simpa only [cost,src,phase_source] using h

theorem GUE (j r v z cap:ℕ) (hj:j<8) (hr:1≤r) (hR:r≤28)
    (hy:r+v≤117) (ht:r+v+z≤11192)
    (hbudget:affine (phase j) r v z+prefixCap (r-1) v j≤cap):
    Payment (sourceIndex j) r v z cap:=by
  intro q u x hq hu hx hzero hcut
  by_cases hq0:q=0
  · obtain ⟨rfl,rfl⟩:=hzero hq0
    subst q
    have h:=cost_phase j r v z hr hR hy ht
    simpa only [AA.cap,AA.row,DZ.eval,
      DZ.evalFrom,Nat.sub_zero,Nat.zero_add] using h.trans (Nat.le_add_right _ _ |>.trans hbudget)
  · have hq1:1≤q:=by omega
    have hc:=phase_prefix q u x j hq1 (by omega) (by omega) (by omega) hj (hcut hq1)
    have hp:=prefix_mono j q u (r-1) v (by omega) (by omega) hu (by omega) (by omega)
    have hm:=cost_phase j (r-q) (v-u) (z-x) (by omega) (by omega) (by omega) (by omega)
    have he:=EMW (phase j) r v z q u x (by omega) hu hx
    omega

theorem GER (r v z cap:ℕ) (hr:1≤r) (hR:r≤28)
    (hy:r+v≤117) (ht:r+v+z≤11192)
    (hbudget: ∀k,k<5→(k=0∨(seen (r-1) v k=true∧floorR k<r∧floorY k<r+v∧floorT k<r+v+z))→
      affine (terminal k) r v z+prefixCap (r-1) v (k+8)≤cap):
    Payment 5 r v z cap:=by
  intro q u x hq hu hx hzero hcut
  by_cases hq0:q=0
  · obtain ⟨rfl,rfl⟩:=hzero hq0
    subst q
    have hc:=EZP 0 r (r+v) (r+v+z) (by decide) hr hR hy ht
    have hb:=hbudget 0 (by decide) (Or.inl rfl)
    change cost 5 r v z≤affine (terminal 0) r v z at hc
    simpa only [AA.cap,AA.row,DZ.eval,
      DZ.evalFrom,Nat.sub_zero,Nat.zero_add] using hc.trans (Nat.le_add_right _ _ |>.trans hb)
  · have hq1:1≤q:=by omega
    let k:=classify q u x
    have hk:k<5:=FOQ _ _ _
    have hc:=GFM q u x hq1 (by omega) (by omega) (by omega) (hcut hq1)
    have hs:=seen_mono k q u (r-1) v hk (by omega) hu (by omega) (by omega) hc.2
    have hp:=prefix_mono (k+8) q u (r-1) v (by omega) (by omega) hu (by omega) (by omega)
    have hf:=FKX q u x (by omega)
    change (floorR k≤q∧floorY k≤q+u)∧lower k q u≤x∧_ at hf
    have htFloor:floorT k≤q+u+x:=by have h:=hf.2.1;unfold lower at h;omega
    have hm:=EZP k (r-q) ((r-q)+(v-u)) ((r-q)+(v-u)+(z-x)) hk
      (by omega) (by omega) (by omega) (by omega)
    change cost 5 (r-q) (v-u) (z-x)≤affine (terminal k) (r-q) (v-u) (z-x) at hm
    have he:=EMW (terminal k) r v z q u x (by omega) hu hx
    have hb:=hbudget k hk (Or.inr ⟨hs,by omega,by omega,by omega⟩)
    dsimp only [k] at hp hm he hb
    omega

end BPE
end MergedPart4
section MergedPart5
namespace AIX
open DZ ARU AMJ AQS
open FM ACI BPE CL
set_option autoImplicit false
set_option maxHeartbeats 5000000
set_option maxRecDepth 100000

def RuleBound (r v z cap:ℕ):Prop:=BaseBound r v z cap∨
  ∃j,j<7∧cut r v j≤z∧Payment j r v z cap

def phaseCheck (r v j lo hi start:ℕ) (p:Piece):Bool:=
  Nat.blt j 8 && Nat.ble (fastCut r v (sourceIndex j)) lo &&
    lineCheck (phase j).totalCoeff (affine (phase j) r v 0+fastPrefix (r-1) v j) lo hi start p

theorem EDJ (r v j lo hi start:ℕ) (p:Piece)
    (h:phaseCheck r v j lo hi start p=true) (z:ℕ)
    (hz:lo≤z) (hh:z≤hi) (hs:start≤lo)
    (hr:1≤r) (hR:r≤28) (hy:r+v≤117) (ht:r+v+z≤11192):
    RuleBound r v z (value p start z):=by
  simp only [phaseCheck,Bool.and_eq_true,Nat.blt_eq,Nat.ble_eq,fastCut_eq r v _ hr hR] at h
  have hj:sourceIndex j<7:=by unfold sourceIndex;split_ifs<;>omega
  have hb:=DQO _ _ lo hi start p h.2 z hz hh hs
  rw [FVD (r-1) v j (by omega)] at hb
  have hb' :affine (phase j) r v z+prefixCap (r-1) v j≤value p start z:=by
    rw [affine_shift (phase j) r v 0 z (Nat.zero_le _)]
    simpa only [Nat.sub_zero,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using hb
  exact Or.inr ⟨sourceIndex j,hj,h.1.2.trans hz,GUE j r v z _ h.1.1 hr hR hy ht hb'⟩

def DWG (r v k:ℕ):Prop:=
  k=0∨(fastSeen (r-1) v k=true∧floorR k<r∧floorY k<r+v)
instance (r v k:ℕ):Decidable (DWG r v k):=by unfold DWG;infer_instance
def terminalLow (r v k lo:ℕ):=if k=0 then lo else max lo (floorT k+1-(r+v))
def FWH (r v k lo hi start:ℕ) (p:Piece):Bool:=
  if DWG r v k then
    lineCheck (terminal k).totalCoeff (affine (terminal k) r v 0+fastPrefix (r-1) v (k+8))
      (terminalLow r v k lo) hi start p
  else true
def DTO (r v lo hi start:ℕ) (p:Piece):Bool:=
  Nat.ble (fastCut r v 5) lo && allN (fun k=>FWH r v k lo hi start p) 5

theorem FIV (r v lo hi start:ℕ) (p:Piece)
    (h:DTO r v lo hi start p=true) (z:ℕ)
    (hz:lo≤z) (hh:z≤hi) (hs:start≤lo)
    (hr:1≤r) (hR:r≤28) (hy:r+v≤117) (ht:r+v+z≤11192):
    RuleBound r v z (value p start z):=by
  simp only [DTO,Bool.and_eq_true,Nat.ble_eq,fastCut_eq r v 5 hr hR] at h
  refine Or.inr ⟨5,by decide,h.1.trans hz,?_⟩
  apply GER r v z _ hr hR hy ht
  intro k hk hg
  have hguard:DWG r v k:=by
    unfold DWG
    rw [fastSeen_eq (r-1) v k (by omega)]
    rcases hg with he | he
    · exact Or.inl he
    · exact Or.inr ⟨he.1,he.2.1,he.2.2.1⟩
  have hl:terminalLow r v k lo≤z:=by
    unfold terminalLow
    split_ifs with he
    · exact hz
    · rcases hg with hg | hg
      · exact (he hg).elim
      · exact max_le hz (by omega)
  have hstart:start≤terminalLow r v k lo:=by
    unfold terminalLow
    split_ifs
    · exact hs
    · exact hs.trans (le_max_left _ _)
  have hc:=allN_sound _ 5 h.2 k hk
  simp only [FWH,if_pos hguard] at hc
  have hb:=DQO _ _ _ hi start p hc z hl hh hstart
  rw [FVD (r-1) v (k+8) (by omega)] at hb
  rw [affine_shift (terminal k) r v 0 z (Nat.zero_le _)]
  simpa only [Nat.sub_zero,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using hb

def emptyCurve:List Piece:=[⟨1,0,0⟩]
def exactEmpty (r v j lo hi start:ℕ) (p:Piece):Bool:=
  DRA (src j).totalCap (src j).middleCap (src j).slopeCap r (r+v)
    lo hi start p 1 emptyCurve
def exactChild (r v j lo hi start:ℕ) (p:Piece) (q u:ℕ):Bool:=
  DRA (src j).totalCap (src j).middleCap (src j).slopeCap (r-q) ((r-q)+(v-u))
    lo hi start p (fastCut q u j) (UD.final q u)
def exactCheck (r v j lo hi start:ℕ) (p:Piece):Bool:=
  Nat.blt j 7 && Nat.ble (fastCut r v j) lo && exactEmpty r v j lo hi start p &&
    allN (fun i=>allN (fun u=>exactChild r v j lo hi start p (i+1) u) (v+1)) (r-1)

theorem EYI (r v j lo hi start:ℕ) (p:Piece)
    (h:exactCheck r v j lo hi start p=true) (z:ℕ)
    (hz:lo≤z) (hh:z≤hi) (hs:start≤lo)
    (hr:1≤r) (hR:r≤28) (hy:r+v≤117) (ht:r+v+z≤11192):
    RuleBound r v z (value p start z):=by
  simp only [exactCheck,Bool.and_eq_true,Nat.blt_eq,Nat.ble_eq,fastCut_eq r v j hr hR] at h
  refine Or.inr ⟨j,h.1.1.1,h.1.1.2.trans hz,?_⟩
  intro q u x hq hu hx hzero hcut
  by_cases hq0:q=0
  · obtain ⟨rfl,rfl⟩:=hzero hq0
    subst q
    have hb:=DTD (src j).totalCap (src j).middleCap (src j).slopeCap r (r+v)
      lo hi start p 1 1 emptyCurve (by decide) h.1.2 0 z (by decide) (by decide) (Nat.zero_le _) hz hh hs
    simpa only [emptyCurve,eval,evalFrom,value,show 0<1 by decide,if_pos,Nat.zero_mul,Nat.add_zero,
      Nat.zero_add,Nat.sub_zero,AA.cap,AA.row,cost] using hb
  · have hq1:1≤q:=by omega
    have hc:=allN_sound _ (r-1) h.2 (q-1) (by omega)
    have hc:=allN_sound _ (v+1) hc u (by omega)
    simp only [show q-1+1=q by omega] at hc
    have he:=UD.final_eq q u hq1 (by omega)
    have hv:validFrom (11193-q-u) 0 (UD.final q u)=true:=by
      rw [he]
      exact AMJ.curve_valid q u hq1 (by omega) (by omega)
    have hxcut:x<fastCut q u j:=by rw [fastCut_eq q u j hq1 (by omega)];exact hcut hq1
    have hb:=DTD (src j).totalCap (src j).middleCap (src j).slopeCap (r-q) ((r-q)+(v-u))
      lo hi start p (fastCut q u j) (11193-q-u) (UD.final q u) hv hc x z (by omega) hxcut hx hz hh hs
    simpa only [he,AA.cap,cost] using hb

def check (r v code aux lo hi start:ℕ) (p:Piece):Bool:=
  if code=0 then ACI.check r v aux lo hi start p
  else if code≤8 then phaseCheck r v (code-1) lo hi start p
  else if code=9 then DTO r v lo hi start p
  else if code≤13 then exactCheck r v (code-7) lo hi start p
  else if code=14 then exactCheck r v aux lo hi start p else false

theorem check_sound (r v code aux lo hi start:ℕ) (p:Piece)
    (h:check r v code aux lo hi start p=true) (z:ℕ)
    (hz:lo≤z) (hh:z≤hi) (hs:start≤lo)
    (hr:1≤r) (hR:r≤28) (hy:r+v≤117) (ht:r+v+z≤11192):
    RuleBound r v z (value p start z):=by
  unfold check at h
  split_ifs at h with h0 h8 h9 h13 h14
  · exact Or.inl (ACI.check_sound _ _ _ _ _ _ p h z hz hh hs ht)
  · exact EDJ _ _ _ _ _ _ p h z hz hh hs hr hR hy ht
  · exact FIV _ _ _ _ _ p h z hz hh hs hr hR hy ht
  · exact EYI _ _ _ _ _ _ p h z hz hh hs hr hR hy ht
  · exact EYI _ _ _ _ _ _ p h z hz hh hs hr hR hy ht

end AIX
