def fastThin (s : SourceNumbers) (p : FlagDegree) : ℕ :=
  ThresholdFastProof.evalPowerBandBudgetThin 131071 (s.contactCap p) 50293 (contactDec p)
    (total p) (middle p) p.all (s.totalCap - total p) (s.middleCap - middle p)
    (s.slopeCap - p.all) (s.fuel p)

theorem fastThin_eq (s : SourceNumbers) (p : FlagDegree) : fastThin s p = s.bandThin p :=
  ThresholdFastProof.evalPowerBandBudgetThin_eq _ _ _ _ _ _ _ _ _ _ _

def ThresholdCheck (h r v : ℕ) : Prop :=
  let s := phaseSource h
  let t := threshold h r v
  let p := rawFlag r v t
  6677 - (r + v) < t ∨
    (1 ≤ r ∧ total p ≤ s.totalCap ∧ middle p ≤ s.middleCap ∧
      r ≤ s.slopeCap ∧ fastThin s p < s.gap)
instance (h r v : ℕ) : Decidable (ThresholdCheck h r v) := by
  unfold ThresholdCheck; infer_instance

theorem sourceTotal (h : ℕ) : 6677 ≤ (phaseSource h).totalCap := by
  unfold phaseSource
  split <;> norm_num

theorem route_of_threshold {h r v z : ℕ} (hc : ThresholdCheck h r v)
    (hz : r + v + z ≤ 6677) (ht : threshold h r v ≤ z) :
    (phaseSource h).Routeable (rawFlag r v z) := by
  rcases hc with hbad | ⟨hr, htotal, hy, hs, hb⟩
  · omega
  · apply routeable_raw_mono_z (phaseSource h) ht (hz.trans (sourceTotal h))
    exact ⟨hr, htotal, hy, hs, Or.inr ((fastThin_eq _ _) ▸ hb)⟩

def CellCheck (r v : ℕ) : Prop :=
  RowRunsValid (context r v) (runs r v) ∧
  (∀ h ∈ List.range 6, ThresholdCheck h r v) ∧
  (∀ h ∈ List.range 6,
    (r + 1 ≤ 29 → r + 1 + v ≤ 135 → pref h r v ≤ pref h (r+1) v) ∧
    (r + v + 1 ≤ 135 → pref h r v ≤ pref h r (v+1)))
instance (r v : ℕ) : Decidable (CellCheck r v) := by unfold CellCheck; infer_instance

def LayerCheck (r : ℕ) : Prop := ∀ v ∈ List.range (136-r), CellCheck r v
instance (r : ℕ) : Decidable (LayerCheck r) := by unfold LayerCheck; infer_instance

