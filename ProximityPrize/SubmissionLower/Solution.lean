    intro x
    obtain ⟨x,⟨s,hs⟩,rfl⟩:=IsLocalization.exists_mk'_eq M x
    obtain ⟨x,rfl⟩:=P.algebraMap_surjective x
    obtain ⟨s,rfl⟩:=P.algebraMap_surjective s
