 let hi:=min (p.stop-1) (limit-1)
 part r y start p start (min hi (3620-y-1)) 1 &&
 part r y start p (max start (3620-y)) (min hi (5179-y)) (if CoreRow r y then 0 else 1) &&
 part r y start p (max start (5180-y)) hi 1

