  have hcut:EK.thresholdAt
   (CL.thresholds (AF.row p.all p.yz)) 5≤p.zOnly:=by omega
  have hh:=Lower80899.AMY.DHC (Lower80899.TenPhase.sound 5).source
   p.all p.yz _ p.zOnly (AHV.source_total 5 (by decide)) hT hcut hc
  apply hstop
  have he:FV.rawFlag p.all p.yz p.zOnly=p:=by cases p;rfl
  rw [he] at hh
  exact hh
 have hl:p.zOnly<limit p.all p.yz:=by
  unfold limit
  unfold total at ht
  omega
 have hb:=MX.row_sound (limit p.all p.yz) p.all p.yz _
  (checked p.all p.yz hr hR hY) p.zOnly (by omega) hl hY
