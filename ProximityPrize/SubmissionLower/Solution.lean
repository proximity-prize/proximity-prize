section Compact_SecondJetBaseChecked
namespace ProximityPrize.SubmissionLower.SecondJetBaseChecked
open RCN095 LocatorFactorAggregate LocatorPhase6800Oracle
open SecondJetBaseCore SecondJetBaseChecksData
open scoped BigOperators
set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 5000000
set_option Elab.async false

theorem sound (p : FlagDegree) (hp : 1 ≤ p.all) (hr : p.all ≤ 30)
    (hy : middle p ≤ 136) (ht : total p ≤ 6917) :
    max (SecondJetSingleCap.cap p) (SecondJetStrictData.cap p) ≤ SecondJetBaseData.cap p := by
  have h := layers p.all (List.mem_range.mpr (by omega)) hp p.yz
    (List.mem_range.mpr (by unfold middle at hy; omega))
  exact RowValid.sound p.all p.yz (SecondJetBaseData.lookup p.all p.yz)
    (SecondJetBaseChecksData.lookup p.all p.yz) hp h p.zOnly (by unfold total at ht; omega)

theorem sum_count_le {ι : Type} [DecidableEq ι] (s : Finset ι) (p : ι → FlagDegree) (count : ι → ℕ)
    (hpositive : ∀ i ∈ s, 1 ≤ (p i).all)
    (hrCap : (sumFlag s p).all ≤ 30) (hyCap : middle (sumFlag s p) ≤ 136)
    (htCap : total (sumFlag s p) ≤ 6917)
    (hold : ∀ i ∈ s, count i ≤ LocatorOrdinaryZConvex.rawCost (p i).all (p i).yz (p i).zOnly)
    (hnew : ∀ i ∈ s, count i ≤ SecondJetSingleCap.cap (p i)) :
    (∑ i ∈ s, count i) ≤ SecondJetBaseData.cap (sumFlag s p) := by
  classical
  by_cases hs : s.Nonempty
  · obtain ⟨i,hi⟩ := hs
    have hpos : 1 ≤ (sumFlag s p).all := (hpositive i hi).trans
      (Finset.single_le_sum (f := fun j => (p j).all) (fun _ _ => Nat.zero_le _) hi)
    exact (SecondJetAggregateBase.sum_count_le SecondJetSingleCap.cap SecondJetStrictData.cap
      SecondJetStrictChecked.sound s p count hpositive hrCap hyCap htCap hold hnew).trans
      (sound (sumFlag s p) hpos hrCap hyCap htCap)
  · have he : s=∅ := Finset.not_nonempty_iff_eq_empty.mp hs
    subst s
    simp

