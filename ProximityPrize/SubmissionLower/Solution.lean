def CommutatorRing (L:Type v):Type v:=L
instance:NonUnitalNonAssocRing (CommutatorRing L):=
  have:=LieRing.toNonUnitalNonAssocRing L
  inferInstanceAs <| NonUnitalNonAssocRing L
