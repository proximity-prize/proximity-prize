noncomputable def ramificationIdx':ℕ:=sSup {n | map f p ≤ P^n}
variable {p P}
theorem ramificationIdx'_eq_find [DecidablePred fun n↦∀ (k:ℕ),map f p ≤ P^k → k ≤ n]
    (h:∃ n,∀ k,map f p ≤ P^k → k ≤ n):
    ramificationIdx' p P=Nat.find h:=by
