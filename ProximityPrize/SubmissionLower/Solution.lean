private theorem persistent_at_cap {b : Band} {u del} (M : AnchorModel u del)
    {Γ} (F : AnchoredFamily M Γ) (hband : InBand b M.overhead)
    {H} (hH : AdjacentChart M F H) {f : Equation} (hf : Reduced f) {v : ℕ}
