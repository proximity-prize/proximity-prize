def affineCheck (cap:ℕ) (a s o b t p lo hi : ℕ) : Bool :=
 let z := if s≤t then lo else hi
 Nat.ble (affine cap a s o z) (affine cap b t p z)

lemma affine_add (cap:ℕ) (a s o lo z : ℕ) (ho : o≤lo) (hz : lo≤z) :
 affine cap a s o z=affine cap a s o lo+s*(z-lo) := by
 have he : z-o=(lo-o)+(z-lo) := by omega
 simp only [affine,he,Nat.mul_add]
 omega

lemma ETD (cap:ℕ) (a s o b t p lo hi z : ℕ)
 (hc : affineCheck cap a s o b t p lo hi=true)
 (ho : o≤lo) (hp : p≤lo) (hz : lo≤z) (hzh : z≤hi) :
 affine cap a s o z≤affine cap b t p z := by
 by_cases hs : s≤t
 · simp only [affineCheck,if_pos hs,Nat.ble_eq] at hc
   have ha := affine_add cap a s o lo z ho hz
   have hb := affine_add cap b t p lo z hp hz
   have hm := Nat.mul_le_mul_right (z-lo) hs
   omega
 · simp only [affineCheck,if_neg hs,Nat.ble_eq] at hc
   have ha := affine_add cap a s o z hi (by omega) hzh
   have hb := affine_add cap b t p z hi (by omega) hzh
   have hm := Nat.mul_le_mul_right (hi-z) (show t≤s by omega)
   omega

def cellCheck (cap:ℕ) (B S start : ℕ) (c : Piece) : Bool :=
 affineCheck cap c.base c.slope start B S 0 start (max start (min cap (c.stop-1)))
def curveCheck (cap:ℕ) (B S : ℕ) (ps : List Piece) : Bool :=
 cells (cap+1) (cellCheck cap B S) ps 0

lemma cellCheck_sound (cap:ℕ) (B S start x : ℕ) (c : Piece)
 (hc : cellCheck cap B S start c=true) (hx : start≤x) (hxe : x≤c.stop-1) (hxcut : x≤cap) :
 value c start x≤B+S*x := by
 have h := ETD cap c.base c.slope start B S 0 start
   (max start (min cap (c.stop-1))) x hc (by omega) (by omega) hx (by omega)
 simpa only [affine,value,Nat.sub_zero] using h

def fastCheck (cap:ℕ) (B S charge slope lo hi start : ℕ) (p : Piece) : Bool :=
 affineCheck cap (B+charge) (max S slope) 0 (value p start lo) p.slope lo lo hi

lemma triangle_of_fast (cap:ℕ) (B S charge slope lo hi start clo : ℕ) (p c : Piece)
 (hcell : cellCheck cap B S clo c=true) (hfast : fastCheck cap B S charge slope lo hi start p=true)
 (hcut : hi≤cap) :
 VertexKernel80909.triangle c.base c.slope clo (c.stop-1) charge slope
   (value p start lo) p.slope lo hi=true := by
 by_cases hd : clo≤c.stop-1 ∧ max lo clo≤hi
 · let z := VertexKernel80909.selectZ c.slope slope p.slope (max lo clo) hi (c.stop-1)
   let x := VertexKernel80909.selectX c.slope slope clo (c.stop-1) z
   have hb := VertexKernel80909.selected_bounds c.slope slope p.slope clo (c.stop-1)
     (max lo clo) hi hd.1 (by omega) hd.2
   change clo≤x ∧ x≤c.stop-1 ∧ x≤z ∧ max lo clo≤z ∧ z≤hi at hb
   have hc := cellCheck_sound cap B S clo x c hcell hb.1 hb.2.1 (by omega)
   have hf := ETD cap (B+charge) (max S slope) 0 (value p start lo) p.slope lo lo hi z
     hfast (by omega) (by omega) (by omega) hb.2.2.2.2
   have hS := Nat.mul_le_mul_right x (le_max_left S slope)
   have ht := Nat.mul_le_mul_right (z-x) (le_max_right S slope)
   have he : x+(z-x)=z := by omega
   have hm := congrArg (fun n => max S slope*n) he
   rw [Nat.mul_add] at hm
   simp only [VertexKernel80909.triangle,if_pos hd,Nat.ble_eq]
   change TP.left c.base c.slope clo charge slope x z≤
     TP.right (value p start lo) p.slope lo z
   simp only [TP.left,TP.right,affine,value,Nat.sub_zero] at hc hf ⊢
   omega
 · simp only [VertexKernel80909.triangle,if_neg hd]

lemma rec_and (cap:ℕ) (a b : Bool) : Bool.rec false b a=(a && b) := by cases a <;> rfl

lemma aux_transfer (cap:ℕ) (cut stop : ℕ) (f g : ℕ → Piece → Bool) (ps : List Piece) (start : ℕ)
 (hle : cut≤stop) (h : cellsAux stop f ps start=true)
 (himp : ∀ lo c,lo<cut → f lo c=true → g lo c=true) : cellsAux cut g ps start=true := by
 induction ps generalizing start with
 | nil => rfl
 | cons c cs ih =>
   change (if cut≤start then true else Bool.rec false (cellsAux cut g cs c.stop) (g start c))=true
   by_cases hs : cut≤start
   · simp only [if_pos hs]
   · have ht : ¬stop≤start := by omega
     change (if stop≤start then true else Bool.rec false (cellsAux stop f cs c.stop) (f start c))=true at h
     simp only [if_neg ht,rec_and cap,Bool.and_eq_true] at h
     simp only [if_neg hs,rec_and cap,Bool.and_eq_true]
     exact ⟨himp start c (by omega) h.1,ih c.stop h.2⟩

lemma cells_transfer (cap:ℕ) (cut stop : ℕ) (f g : ℕ → Piece → Bool) (ps : List Piece) (start : ℕ)
 (hle : cut≤stop) (h : cells stop f ps start=true)
 (himp : ∀ lo c,lo<cut → f lo c=true → g lo c=true) : cells cut g ps start=true := by
 unfold cells at h ⊢
 by_cases hs : cut≤start
 · simp only [if_pos hs]
 · have ht : ¬stop≤start := by omega
   simp only [if_neg hs]
   simp only [if_neg ht] at h
   exact aux_transfer cap cut stop f g ps start hle h himp

lemma child_of_fast (cap:ℕ) (B S charge slope lo hi start : ℕ) (p : Piece) (ps : List Piece)
 (hcurve : curveCheck cap B S ps=true) (hfast : fastCheck cap B S charge slope lo hi start p=true)
 (hcut : hi≤cap) : Codec2.child slope charge lo hi start p ps=true := by
 apply cells_transfer cap (hi+1) (cap+1) (cellCheck cap B S)
   (fun clo c => VertexKernel80909.triangle c.base c.slope clo (c.stop-1) charge slope
     (value p start lo) p.slope lo hi) ps 0 (by omega) hcurve
 intro clo c hc hb
 exact triangle_of_fast cap B S charge slope lo hi start clo p c hb hfast hcut

lemma directCheck_eq(cap B S charge slope lo hi start:ℕ)(p:Piece):
 DirectNat80909.fastCheck B S charge slope lo hi start p=fastCheck cap B S charge slope lo hi start p:=by
 simp only [DirectNat80909.fastCheck,fastCheck,affineCheck,affine,DirectNat80909.ble_cond,DZ.value,Nat.sub_zero]
 rfl
end ProximityPrize.SubmissionLower.PrefixRangeKernel6816
