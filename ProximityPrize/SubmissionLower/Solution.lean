def LedgerReceiptSound : Prop := ∀ r v z : ℕ, 1 ≤ r → r ≤ 30 → r+v ≤ 136 →
  r+v+z ≤ 6917 → LedgerAudit.ledger (PhaseData.rowContext r v) z ≤ LedgerAudit.bound

theorem combined_bound (hledger : LedgerReceiptSound) (H : P4) (U : Finset (RegularIndex H))
    (hr : (regularAggregateFlag H U).all ≤ 30)
    (hy : middle (regularAggregateFlag H U) ≤ 136)
    (ht : total (regularAggregateFlag H U) ≤ 6917) :
    combined (regularAggregateFlag H U) ≤ LedgerAudit.bound := by
  let p := regularAggregateFlag H U
  by_cases hp : p.all = 0
  · have hu : U = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro F hF
      have hd := (Budgets.factor_coordinates H U F hF).2.1
      have hpos := (positiveRFactors_spec H F.1 F.2).2.2
      change (regularAggregateFlag H U).all = 0 at hp
      omega
    subst U
    change combined ⟨0,0,0⟩ ≤ LedgerAudit.bound
    decide +kernel
  · have hc := hledger p.all p.yz p.zOnly (by omega) hr
      (by simpa only [p,middle,Nat.add_comm] using hy)
      (by simpa only [p,total,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using ht)
    have he : combined p = LedgerAudit.ledger (PhaseData.rowContext p.all p.yz) p.zOnly := by
      unfold combined PhaseSemantics.phaseCap
      simp only [LedgerAudit.ledger,PhaseData.rowContext,middle,total,rawFlag,
        Nat.add_assoc,Nat.add_comm,Nat.add_left_comm]
