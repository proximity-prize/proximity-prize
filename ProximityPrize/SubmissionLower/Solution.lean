    · exact hnum
  have hbase:F0∣numerator K F0 (w+1):=
    (geometric_factor_dvd_iff K (Ω K) F0 (numerator K F0 (w+1))
      hF0spec.1 hF0spec.2.2 S.G S.irreducible_G
