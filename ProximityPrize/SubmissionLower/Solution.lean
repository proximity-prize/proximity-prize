    (fun C↦(hUdata C).1),(fun C↦(hUdata C).2.1),
    (fun C↦(hUdata C).2.2),
    mu,hmu0,hV,
    (fun C↦(hVdata C).1),(fun C↦(hVdata C).2.1),
    (fun C↦(hVdata C).2.2)⟩⟩
