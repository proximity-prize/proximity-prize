    refine ⟨b⁻¹,?_⟩
    rw [←hb,smul_smul,inv_mul_cancel₀ hb0,one_smul]
  apply hcriterionS.mpr
  have hdS:dS=dR+dZ:=by
    unfold dS dR dZ parameterDifferential
    rw [hshear,map_add]
  change Submodule.span L ({dS}:Set Ω[L⁄K])=⊤
  rw [hdS,hdR,zero_add]
  exact hspanZ
end ProjectionCriterion
end
