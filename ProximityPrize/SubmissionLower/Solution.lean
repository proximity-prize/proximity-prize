theorem shear_transcendental_finite_separable_of_differential_ne_zero
    [IsAlgClosed K]
    (embeddingZ:RatFunc K →ₐ[K] L) (r z:L) (a:K)
    (hvalueZ:embeddingZ
      (algebraMap (Polynomial K) (RatFunc K) Polynomial.X)=z)
    (hfiniteZ:
