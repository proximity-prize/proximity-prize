    have hU:poleOrder v.val (affineU Omega C.1 D.lam)=0:=
      CoordinatePoleMass.poleOrder_eq_zero_of_le_one
        Omega (CoordinateField Omega C.1) v _ hUle
    rw [hU,hY,hZ]
    simp
