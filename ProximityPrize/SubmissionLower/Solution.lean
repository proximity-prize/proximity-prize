    {A B I:Type*} [CommRing A] [CommRing B]
    (f:A →+*B) (relation:I → Ideal A)
    (surface:B) (multiplicity:I → ℕ) (i:I):Ideal B:=
  Ideal.span {surface} ⊔ (Ideal.map f (relation i))^multiplicity i
