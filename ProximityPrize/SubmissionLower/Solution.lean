  isInvariant x hx:=by
    obtain ⟨y,hy⟩:=Algebra.IsInvariant.isInvariant (A:=A) (G:=G) x.1
      (fun g↦congr_arg Subtype.val (hx g))
    exact ⟨y,Subtype.ext hy⟩
