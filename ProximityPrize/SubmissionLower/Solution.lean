  have H (x:P.Ring):↑(aeval (σ ∘ f) x)=f (algebraMap _ A x):=by
    rw [←Ideal.Quotient.algebraMap_eq, ←aeval_algebraMap_apply,P.algebraMap_eq,
      AlgHom.coe_toRingHom,comp_aeval_apply, ←Function.comp_assoc,Function.comp_surjInv,]
    simp [P]
