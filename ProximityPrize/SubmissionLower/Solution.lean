        (algebraMap (Polynomial K) (RatFunc K) Polynomial.X)=0:=by
    simpa only [map_zero,
      tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap] using htensor
  have hsource:D K (RatFunc K)
      (algebraMap (Polynomial K) (RatFunc K) Polynomial.X)=0:=by
    rw [Module.FaithfullyFlat.one_tmul_eq_zero_iff] at htensor'
