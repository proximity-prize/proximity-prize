    (fun j i=>cost j.val (r i) (v i) (z i))
  · intro s hs hb
    rcases hb with rfl | hb
    · simp
    · have hn:=narrow s hs
      exact DNJ.count s r v z count (cap s)
        (fun i hi=>hr i (hs hi)) hn.1 hn.2.1 hn.2.2 (fun i hi=>hsingle i (hs hi)) hb
  · intro j s hs hroute
    exact hsplit j s hs hroute.1 hroute.2
