  refine ⟨P0,P1,residual,hP0,hP1,hresdeg,hnores,hnormal,
    ?_,?_,?_⟩
  · intro gamma hgamma j hj hagreement
    apply hagree gamma hgamma j
    · simpa only [Finset.mem_sdiff] using hj
