    rw [map_mul, map_pow, AlgEquiv.symm_apply_apply]
  rw [← hcut]
  change (∃ n : ℕ, s^n * jetToRect.symm p ∈ I) ↔
    ∃ n : ℕ, jetToRect.symm ((jetToRect s)^n * p) ∈ I
  simp only [hpow]

