theorem X_pow_dvd_taylor_specialization
    (Q:MvPolynomial (Fin 4) K) (P:Polynomial K)
    (x u₀ u₁ γ:K) (m:ℕ)
    (hvalue:P.eval x=u₀+γ*u₁)
    (hcoeff:∀ r:ℕ,slopeDifference K^(m-r)∣
