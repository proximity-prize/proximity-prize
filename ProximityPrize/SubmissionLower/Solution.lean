  have:IsScalarTower (Localization.Away f) Rₚ Mₚ:=
    ⟨fun r r' m↦show _=algebraMap _ Rₚ r • r' • m by rw [←mul_smul, ←Algebra.smul_def]⟩
  let l:=(IsLocalizedModule.liftOfLE _ _ hp' (LocalizedModule.mkLinearMap (.powers f) M)
