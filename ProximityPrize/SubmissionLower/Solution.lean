    (hnew : ∀ i ∈ s, count i ≤ single (p i)) :
    (∑ i ∈ s, count i) ≤ max (single (sumFlag s p)) (split (sumFlag s p)) := by
  classical
  have hrows := Lower80788.BaseSparseCore.baseCandidatesSound_of_cached #[]
    Lower80788.BaseChecked.shape Lower80788.BaseChecked.sparse
