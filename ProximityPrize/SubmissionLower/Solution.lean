theorem stateLocalRegularBoundOn_of_base
    (H : P4) (selected : K → Polynomial K) (Gamma : Finset K)
    (ambient : Finset (RegularIndex H))
    (hown : ∀ F ∈ ambient, LocatorHybridCost.OwnBound
      (regularSeeds H selected Gamma F).card (regularCumulativeFlag H F))
    (hsingle : ∀ F ∈ ambient, (regularSeeds H selected Gamma F).card ≤
      SecondJetSingleCap.cap (regularCumulativeFlag H F)) :
    StateLocalRegularBoundOn H selected Gamma ambient (phaseCap 0) := by
  classical
  intro A hAambient hs hy ht
  exact SecondJetBaseChecked.sum_count_le A (regularCumulativeFlag H)
    (fun F => (regularSeeds H selected Gamma F).card)
    (fun F _ => Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt (regularCumulativeFlag_positive H F)))
    hs hy ht
    (fun F hF => LocatorHybridCost.ownBound_le_ordinaryCostOf (hown F (hAambient hF)))
    (fun F hF => hsingle F (hAambient hF))

theorem sixPhases
    (hpref : PrefixReceiptSound) (hth : ThresholdReceiptSound) (hruns : RunReceiptSound)
    (u0 u1 : I → K) (H : P4) (selected : K → Polynomial K) (Gamma : Finset K)
    (ambient : Finset (RegularIndex H))
    (hdegree : ∀ gamma ∈ Gamma, (selected gamma).natDegree ≤ 131071)
    (hagreement : ∀ gamma ∈ Gamma, 181353 ≤
      ((Finset.univ : Finset I).filter (fun i =>
        (selected gamma).eval (IRSProfile.domain i) = u0 i + gamma*u1 i)).card)
    (hno : NoLargeSelectedPencil selected Gamma 131071 80791)
    (hown : ∀ F ∈ ambient, LocatorHybridCost.OwnBound
      (regularSeeds H selected Gamma F).card (regularCumulativeFlag H F))
    (hsingle : ∀ F ∈ ambient, (regularSeeds H selected Gamma F).card ≤
      SecondJetSingleCap.cap (regularCumulativeFlag H F)) :
    StateLocalRegularBoundOn H selected Gamma ambient (phaseCap 6) := by
  exact bound_all hpref hth hruns u0 u1 H selected Gamma ambient hdegree hagreement hno
    (stateLocalRegularBoundOn_of_base H selected Gamma ambient hown hsingle)
    6 le_rfl

