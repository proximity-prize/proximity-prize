    enter [1,1,I]
    rw [←absNorm_ne_zero_iff_mem_nonZeroDivisors,ne_eq,not_not,and_iff_left_iff_imp.mpr
      (fun h↦by rw [h];exact Nat.zero_le n),absNorm_eq_zero_iff]
  rw [Nat.card_unique]
