section Packed6803_ChainPolynomial6803

namespace ProximityPrize.SubmissionLower.ChainPolynomial6803
open scoped BigOperators
open RCN238 RCN223 RCN260 RCN313 RCN294 SharedDegreeBudget
set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 5000000

def kTerm (y z : ℕ) : ℕ :=
  131073 * (z + y + 524284*y*z) + 50292*80782*y
def mTerm (y z : ℕ) : ℕ := 131073*131071*y*z

theorem stageNumerator (y z d j : ℕ) (hj : j ≤ d) :
    (stage y z d j).regularNumerator =
      (2*d-j)*kTerm y z + (2*d-1)*2*mTerm y z := by
  have hr : 131071 * (2*(d-j)-1) ≤ 131071 * (2*d-1) := by omega
  simp only [stage, UnequalParameters.regularNumerator, UnequalParameters.gap,
    UnequalParameters.errors, UnequalParameters.agreement,
    UnequalParameters.leftAgreement, UnequalParameters.rightAgreement,
    UnequalParameters.mixedCost, dot]
  norm_num only
  rw [max_eq_right hr]
  simp only [max_self]
  have hsub : (d-j)+d = 2*d-j := by omega
  dsimp [kTerm, mTerm]
  calc
    _ = ((d-j)+d) * (131073*(z+y+524284*y*z)+50292*80782*y) +
        (2*d-1)*2*(131073*131071*y*z) := by ring
    _ = _ := by rw [hsub]

def numerator (y z d : ℕ) : ℕ :=
  (d-1)*(3*d*kTerm y z + 4*mTerm y z*(2*d-1)) + 2*50292*5000000000000

theorem sum_stage_numerators (y z d : ℕ) (hd : d ≤ 33) :
    2 * (∑ j ∈ Finset.Ico 1 d, (stage y z d j).regularNumerator) =
      (d-1)*(3*d*kTerm y z + 4*mTerm y z*(2*d-1)) := by
  have heq : (∑ j ∈ Finset.Ico 1 d, (stage y z d j).regularNumerator) =
      ∑ j ∈ Finset.Ico 1 d, ((2*d-j)*kTerm y z + (2*d-1)*2*mTerm y z) := by
    apply Finset.sum_congr rfl
    intro j hj
    exact stageNumerator y z d j (Finset.mem_Ico.mp hj).2.le
  rw [heq, Finset.sum_add_distrib, ← Finset.sum_mul]
  simp only [Finset.sum_const, Nat.card_Ico, nsmul_eq_mul]
  have hsum : 2 * (∑ j ∈ Finset.Ico 1 d, (2*d-j)) = 3*d*(d-1) := by
    interval_cases d <;> decide +kernel
  nlinarith [congrArg (fun x => x * kTerm y z) hsum]

theorem charge_mul_le (y z d : ℕ) (hd : d ≤ 33) :
    charge y z d * (2*50292) ≤ numerator y z d := by
  have hsum : (∑ j ∈ Finset.Ico 1 d, (stage y z d j).regularCountCap)*50292 ≤
      ∑ j ∈ Finset.Ico 1 d, (stage y z d j).regularNumerator := by
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro j _
    simp only [UnequalParameters.regularCountCap, UnequalParameters.gap, stage, Nat.reduceSub]
    exact Nat.div_mul_le_self _ _
  have heq := sum_stage_numerators y z d hd
  dsimp [charge, numerator]
  nlinarith


/-- Endpoint domination for a convex quadratic after division by its positive index. -/
theorem quadratic_between (A C W r d : ℤ)
    (hA : 0 ≤ A) (hd : 1 ≤ d) (hdr : d ≤ r)
    (h1 : A + C ≤ W) (hr : A*r*r+C ≤ W*r) :
    A*d*d+C ≤ W*d := by
  by_cases hreq : r = 1
  · have hdeq : d = 1 := by omega
    simpa [hdeq] using h1
  have hr1 : 0 < r-1 := by omega
  have hp := mul_le_mul_of_nonneg_right h1 (show 0 ≤ r-d by omega)
  have hq := mul_le_mul_of_nonneg_right hr (show 0 ≤ d-1 by omega)
  have hc : 0 ≤ A*(r-1)*(d-1)*(r-d) :=
    mul_nonneg (mul_nonneg (mul_nonneg hA (by omega)) (by omega)) (by omega)
  have hm : (r-1)*(A*d*d+C) ≤ (r-1)*(W*d) := by nlinarith
  exact (mul_le_mul_iff_right₀ hr1).mp hm

theorem numerator_identity (y z d : ℕ) (hd : 1 ≤ d) :
    (numerator y z d : ℤ) + d*(3*(kTerm y z : ℤ)+12*(mTerm y z : ℤ)) =
      (3*(kTerm y z : ℤ)+8*(mTerm y z : ℤ))*d*d +
        4*(mTerm y z : ℤ)+2*50292*5000000000000 := by
  unfold numerator
  have h2 : 1 ≤ 2*d := by omega
  push_cast [Nat.cast_sub hd, Nat.cast_sub h2]
  ring

theorem charge_le_of_endpoints (y z d r u : ℕ)
    (hd : 1 ≤ d) (hdr : d ≤ r) (hr : r ≤ 33)
    (htail : 5000000000000 ≤ u)
    (hend : numerator y z r ≤ r*(2*50292)*u) :
    charge y z d ≤ d*u := by
  have hn1 := numerator_identity y z 1 (by decide +kernel)
  have hnr := numerator_identity y z r (by omega)
  have hnd := numerator_identity y z d hd
  have he : (numerator y z d : ℤ) ≤ d*(2*50292)*(u : ℤ) := by
    have htc : (5000000000000 : ℤ) ≤ u := by exact_mod_cast htail
    have hec : (numerator y z r : ℤ) ≤ r*(2*50292)*(u : ℤ) := by exact_mod_cast hend
    have h := quadratic_between
      (3*(kTerm y z : ℤ)+8*(mTerm y z : ℤ))
      (4*(mTerm y z : ℤ)+2*50292*5000000000000)
      ((2*50292)*(u : ℤ)+3*(kTerm y z : ℤ)+12*(mTerm y z : ℤ))
      r d (by positivity) (by exact_mod_cast hd) (by exact_mod_cast hdr)
      (by nlinarith) (by nlinarith)
    nlinarith
  have hn : numerator y z d ≤ d*(2*50292)*u := by exact_mod_cast he
  have hcharge := (charge_mul_le y z d (hdr.trans hr)).trans hn
  nlinarith


def zCoeff (y d : ℕ) : ℕ :=
  (d-1)*(3*d*131073*(1+524284*y)+4*131073*131071*y*(2*d-1))
def constant (y d : ℕ) : ℕ :=
  (d-1)*3*d*(131073+50292*80782)*y + 2*50292*5000000000000

theorem numerator_linear (y z d : ℕ) :
    numerator y z d = zCoeff y d*z + constant y d := by
  unfold numerator kTerm mTerm zCoeff constant
  ring

def unitSlope (y d : ℕ) : ℕ := zCoeff y d / (2*50292*d) + 1
def unitConstant (y d : ℕ) : ℕ := constant y d / (2*50292*d) + 1
def unit (y z d : ℕ) : ℕ :=
  max 5000000000000 (unitSlope y d*z + unitConstant y d)

private theorem le_roundUp_mul (a b : ℕ) (hb : 0 < b) : a ≤ (a/b+1)*b := by
  have hm := Nat.mod_lt a hb
