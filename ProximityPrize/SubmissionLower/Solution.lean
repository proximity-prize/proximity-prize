theorem exists_original_factor_with_first_tail
    {Γ:Finset K} {x:I → K} {p e:ℕ} [CharP (Ω K) p]
    {flag:FlagDegree} {w:ℕ} {support:ResidualSupportParameters}
    (S:ResidualStage (polynomialEmbedding K) Γ x p e flag w support)
