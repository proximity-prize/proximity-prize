    (hroute: ∀j s,s⊆ambient→ routeable j s→
      ∃U,U⊂s∧ ∀i∈s\U,count i≤charge j i)
    (hrules: ∀s,s⊆ambient→base s∨ ∃j,routeable j s∧
      ∀U,U⊂s→ ¬routeable j U→cap U+(∑ i∈s\U,charge j i)≤cap s):
