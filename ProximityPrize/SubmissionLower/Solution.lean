    absNorm (I.map (algebraMap R S))=
      (absNorm I)^Module.finrank (FractionRing R) (FractionRing S):=by
  rw [←absNorm_relNorm ℤ, ←relNorm_relNorm ℤ R,relNorm_algebraMap,absNorm_relNorm,map_pow]
