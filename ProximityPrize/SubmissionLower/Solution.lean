    (b.det (N.subtype ∘ bN)).natAbs=(LinearMap.det (N.subtype ∘ₗ (e:M →ₗ[ℤ] N))).natAbs:=by
      rw [Basis.det_comp_basis]
    _=_:=natAbs_det_equiv N e
end Submodule
