  have hh:=Polynomial.natDegree_sum_le_of_forall_le Q.support
    (fun d => specialization K P γ (MvPolynomial.monomial d (MvPolynomial.coeff d Q))) hterms
  exact lt_of_le_of_lt hh (by omega)
