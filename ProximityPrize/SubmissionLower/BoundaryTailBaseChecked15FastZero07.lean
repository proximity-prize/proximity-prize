theorem zero_r15_part96 : ∀ i ∈ List.range 1, ZeroCheckAt 15 (96+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 15 96 := by decide +kernel
  exact zeroAtFast_sound 15 96 hfast

