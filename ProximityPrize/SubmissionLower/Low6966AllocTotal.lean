theorem cover_at {k : Band} {cells : List (MassCell k)} {t maxWidth maxIndex : ℕ}
    {batches : List (PaidBatch cells t)}
    (hcover : Low6966Encoding.checks (tilesOf batches) maxWidth (3*t) (maxIndex+1-3*t) = true)
