theorem zero_r12_part64 : ∀ i ∈ List.range 1, ZeroCheckAt 12 (64+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 12 64 := by decide +kernel
  exact zeroAtFast_sound 12 64 hfast

