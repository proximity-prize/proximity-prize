open Polynomial
variable {E :Type} [Field E] [Algebra L E]
instance rootAlgebra (A:Equation E) :Algebra L (EC A) :=
 ((seed A).comp (algebraMap L E)).toAlgebra
abbrev Chart (A:Equation E) (w:CurvePlace L E) (r :Bool) :=
 Algebra.adjoin L (Set.range (fun a :w.value.valuationSubring=>seed A a) ∪
  {amm A,jU A r,jet A r})
def aee (A:Equation E) (w:CurvePlace L E) (r :Bool)
    (a :w.value.valuationSubring) :Chart A w r :=
  ⟨seed A a,Algebra.subset_adjoin (Or.inl ⟨a,rfl⟩)⟩
def xAt (A:Equation E) (w:CurvePlace L E) (r :Bool) :Chart A w r :=
 ⟨amm A,Algebra.subset_adjoin (Or.inr (Set.mem_insert _ _))⟩
def xSub (A:Equation E) (w:CurvePlace L E) (r :Bool) (x :L) :Chart A w r :=
 xAt A w r-algebraMap L _ x
theorem coe_xSub (A:Equation E) (w:CurvePlace L E) (r :Bool) (x :L) :
 (xSub A w r x :EC A)=amm A - constant A x :=rfl
def LocalDerivation (a :E →ₐ[L] LaurentSeries L) (w:CurvePlace L E)
    (δ:Derivation L E E) :Prop :=
  ∀ c,w.value c≤1→w.value (δ c)≤1∧(a (δ c)).coeff 0=(a c).coeff 1
structure MarkChart (A:Equation E) (S:Sections A) (γ:K) (hγ:γ∈S.marks)
  (δ:Derivation L E E) (x :L) (r :Bool) where
 map :Chart A (S.place γ) r →ₐ[L] FX
 regular : ∀ a,pointVal x (map a)≤1
 seed_eq : ∀ a,map (aee A (S.place γ) r a) =
  algebraMap L FX ((S.atPlace γ hγ a).coeff 0)
 physical_eq :map (xAt A (S.place γ) r)=phys Polynomial.X
 sep:Chart A (S.place γ) r
 num :Chart A (S.place γ) r
 sep_eq : (sep:EC A)=polar A r
 num_eq : (num :EC A) = -(KM A r (seedDerivative δ (chartEq A r)))
 simple :map sep≠0
 gK6 : ∃ u:FX,pointVal x u=1 ∧
  map num/map sep=u*(phys (S.num γ)/phys (S.den γ))
abbrev Normal (A:Equation E) (w:CurvePlace L E) (r :Bool) :=
 integralClosure (Chart A w r) (EC A)
def NormalRegular {A:Equation E} {w:CurvePlace L E} {r :Bool}
    (P:Ideal (Normal A w r)) (u:EC A) :Prop :=
  ∃ a :Normal A w r,a∉P ∧ ∃ b:Normal A w r,(a :EC A)*u=b
def SeedScale {A:Equation E} {r :Bool} (v :GraphVal A r) (w:CurvePlace L E) :Prop :=
 ∃ n:ℕ,0<n ∧ ∀ a,v.val (seed A a)=w.value a^n
end
