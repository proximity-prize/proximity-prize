        · exact Or.inl (Finset.mem_union_left _ h)
        · exact Or.inr (by rw [fixedAt_mul, h, zero_mul])
      · rcases hcover r hr hs hj z S hm with h | h
        · exact Or.inl (Finset.mem_union_right _ h)
        · exact Or.inr (by rw [fixedAt_mul, h, mul_zero])

