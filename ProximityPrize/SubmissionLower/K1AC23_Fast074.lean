  obtain ⟨k, hk⟩ := hm
  have heq : pderiv i v = v * seedView k := by simpa only [hk, map_mul] using hg.symm
  have hkn : seedView k ≠ 0 := fun hz => hn (by rw [heq, hz, mul_zero])
  rw [heq, degreeOf_mul_eq hv hkn] at hb
