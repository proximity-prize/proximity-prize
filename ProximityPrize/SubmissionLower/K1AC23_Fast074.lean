        intoF (parameterMap y v q) := IsFractionRing.lift_algebraMap hparam q
  let e : SectionJet →+* F :=
    jetEval f (fun i => inc (mk (C (C (MvPolynomial.X i))))) (inc y) (inc v)
  have hcomp : e.comp sectionMap = inc.comp mk := by
    apply jetHom_ext
    · intro b
