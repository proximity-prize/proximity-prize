    (eval₂RingHom (C.comp (algebraMap k D)) (C y + Polynomial.X * C v)) Polynomial.X

@[simp] private theorem lineSubstitution_C {k D : Type*} [Field k] [CommRing D] [Algebra k D]
    (y v : D) (p : Polynomial k) :
