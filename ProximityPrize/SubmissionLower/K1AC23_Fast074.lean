        apply Polynomial.ringHom_ext
        · intro b
          simp [RingHom.comp_apply, g]
        · simp [RingHom.comp_apply, g, mul_comm v (algebraMap k D a)]
      simpa [RingHom.comp_apply] using DFunLike.congr_fun hcomp p
    · simp [RingHom.comp_apply, hga]

