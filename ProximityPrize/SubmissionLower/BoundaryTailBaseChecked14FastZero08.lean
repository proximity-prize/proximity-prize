theorem zr14p112:∀ i ∈ List.range 1,ZeroCheckAt 14 (112+i):=by
  intro i hi
  have hi0:i = 0:=by have:=List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast:ZeroAtFast 14 112:=by decide +kernel
  exact zeroAtFast_sound 14 112 hfast

