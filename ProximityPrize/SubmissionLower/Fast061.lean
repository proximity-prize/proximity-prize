    (common + S (622-2*t-7*j) + S (620-2*t-7*j))
  let original := D 1651 + D (b-3*r-j) + S (r-j) - common
  Nat.min (D 1651 - D z) chosen - original
private theorem kernelOfParts {d j h r a b c e f g k l : ℕ}
