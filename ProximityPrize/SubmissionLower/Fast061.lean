private theorem digits_congr {f g : ℕ → ℕ} {n : ℕ} (h : ∀ i < n, f i = g i) :
    digits f n = digits g n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [digits, digits, ih (fun i hi => h i (by omega)), h n (by omega)]
private theorem digits_add (f g : ℕ → ℕ) (n : ℕ) :
    digits (fun i => f i + g i) n = digits f n + digits g n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [digits, ih, Nat.add_mul]; omega
private theorem digits_mul (c : ℕ) (f : ℕ → ℕ) (n : ℕ) :
    digits (fun i => c * f i) n = c * digits f n := by
  induction n with
  | zero => simp [digits]
  | succ n ih => simp [digits, ih, Nat.mul_add, Nat.mul_assoc]
private theorem digits_sub {f g : ℕ → ℕ} {n : ℕ} (h : ∀ i < n, g i ≤ f i) :
    digits (fun i => f i - g i) n = digits f n - digits g n := by
