private structure Checked (n : ℕ) (f : ℕ → ℕ) (value bound : ℕ) : Prop where
  val_eq : digits f n = value
  bounded : ∀ i < n, f i ≤ bound
private theorem constChecked (n x : ℕ) : Checked n (fun _ => x) (x*units n) x :=
  ⟨digits_const x n, fun _ _ => le_rfl⟩
private theorem addChecked {n a b A B : ℕ} {f g : ℕ → ℕ}
    (x : Checked n f a A) (y : Checked n g b B) :
    Checked n (fun i => f i+g i) (a+b) (A+B) := by
  refine ⟨?_, fun i hi => Nat.add_le_add (x.bounded i hi) (y.bounded i hi)⟩
  rw [digits_add, x.val_eq, y.val_eq]
private theorem subChecked {n a b A B : ℕ} {f g : ℕ → ℕ}
    (x : Checked n f a A) (y : Checked n g b B) (hA : A < guardBit) (hB : B < guardBit) :
    Checked n (fun i => f i-g i) (laneSub n a b) A := by
  refine ⟨?_, fun i hi => le_trans (Nat.sub_le _ _) (x.bounded i hi)⟩
  rw [laneSub_digits (fun i hi => lt_of_le_of_lt (x.bounded i hi) hA)
    (fun i hi => lt_of_le_of_lt (y.bounded i hi) hB), x.val_eq, y.val_eq]
private theorem minChecked {n a b A B : ℕ} {f g : ℕ → ℕ}
    (x : Checked n f a A) (y : Checked n g b B) (hA : A < guardBit) (hB : B < guardBit) :
    Checked n (fun i => Nat.min (f i) (g i)) (a - laneSub n a b) A := by
  have hd := subChecked x y hA hB
  refine ⟨?_, fun i hi => le_trans (min_le_left _ _) (x.bounded i hi)⟩
  calc
    _ = digits (fun i => f i-(f i-g i)) n := digits_congr (fun i _ => by
      change min (f i) (g i) = _; omega)
    _ = _ := by rw [digits_sub (fun _ _ => Nat.sub_le _ _), hd.val_eq, x.val_eq]
private theorem sum_bound {n bound : ℕ} {f : ℕ → ℕ} (h : ∀ i < n, f i ≤ bound) :
    rangeSum f n ≤ n*bound := by
