private def threeDen (x : ℕ) := natDen (x-1) + natDen (x-2) + natDen (x-3)
private theorem threeDen_zero : threeDen 0 = 0 := rfl
private theorem threeDen_small {x : ℕ} (hx : x ≤ 1) : threeDen x = 0 := by
