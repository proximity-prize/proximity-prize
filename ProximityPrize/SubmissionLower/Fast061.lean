-- The unsigned index n represents signed index n - 1. Its zero entry covers negative indices.
private def auxLDen (n : ℕ) : ℕ := (n * (n * (2 * n + 15) + 30) + 25) / 72

private theorem auxLDen_correct (n : ℕ) : auxLDen n = denFast n := by
  apply Int.ofNat_inj.mp
  rw [denFast_correct, ← fastDen_eq]
  cases n with
  | zero => decide
  | succ n =>
    simp only [auxLDen, Nat.cast_succ, Nat.cast_mul,
      Int.natCast_ediv, add_sub_cancel_right, fastDen, Int.natCast_nonneg,
      not_lt_of_ge, ite_false]
    congr 1; ring

-- Three adjacent shifted denominators share a single cubic and floor division.
private def auxLTriple (x : ℕ) : ℕ := (x * (2*x+5) * (x+2) + 3) / 24

private theorem auxLDen_period (n : ℕ) :
    auxLDen (n+12) = auxLDen n + (n*n + 17*n + 83) := by
  unfold auxLDen
  rw [show (n+12) * ((n+12) * (2*(n+12)+15)+30)+25 =
    (n*(n*(2*n+15)+30)+25) + 72*(n*n+17*n+83) by ring]
  exact Nat.add_mul_div_left _ _ (by decide)

private theorem auxLTriple_period (n : ℕ) :
    auxLTriple (n+12) = auxLTriple n + (3*n*n + 45*n + 203) := by
  unfold auxLTriple
  rw [show (n+12)*(2*(n+12)+5)*(n+12+2)+3 =
    (n*(2*n+5)*(n+2)+3) + 24*(3*n*n+45*n+203) by ring]
  exact Nat.add_mul_div_left _ _ (by decide)

private theorem auxLTriple_correct (x : ℕ) :
    auxLTriple x = auxLDen x + auxLDen (x-1) + auxLDen (x-2) := by
  have step (k : ℕ) : auxLTriple (k+2) = auxLDen (k+2) + auxLDen (k+1) + auxLDen k := by
    induction k using Nat.strong_induction_on with
    | h k ih =>
      by_cases hk : k < 12
      · interval_cases k <;> decide
      · let n := k-12
        have hn : n < k := by dsimp [n]; omega
        have he : k = n+12 := by dsimp [n]; omega
        have h := ih n hn
        rw [he, show n+12+2 = (n+2)+12 by omega, show n+12+1 = (n+1)+12 by omega,
          auxLTriple_period, auxLDen_period, auxLDen_period, auxLDen_period, h]
        ring
  match x with
  | 0 | 1 => decide
  | k+2 => simpa using step k

private def auxLCum (d n : ℕ) : ℕ :=
  if n ≤ d+1 then auxLDen n else
    let v := min n (3*d+1)
    (auxLDen v + auxLTriple (v-(2*d+3))) - auxLTriple (v-(d+1))

private theorem auxLCum_correct (d n : ℕ) : auxLCum d n = cumFast d n := by
  unfold auxLCum cumFast
  split
  · apply auxLDen_correct
  · simp only [auxLTriple_correct, auxLDen_correct, Nat.sub_sub, Nat.add_assoc]

private def auxLKernel (d lo hi ord r : ℕ) : ℕ :=
  let cut := fun n => if d < r then 0 else auxLCum (d-r) n
  (auxLCum d hi + cut (ord-3*r)) - (auxLCum d ord + cut lo)

private theorem auxLKernel_eq (d lo hi ord r : ℕ) :
    auxLKernel d lo hi ord r = kFast d lo hi ord r := by
  simp only [auxLKernel, kFast, cutFast, auxLCum_correct]

private def auxLPoint (s j a b c : ℕ) : ℕ :=
  let d := 1650-(a+b+3*c)
  auxLKernel d (1650-(j+3*b+2*c)) (1651-3*(b+c)) (4650-(s+j+2*b+3*c))
    (min d ((4649-(s+a+4*c))/4)+1)

private theorem auxLPoint_correct (s j a b c : ℕ)
    (hd : a+b+3*c ≤ 1650) (hc : b+c ≤ 550) (hl : c ≤ j+1) (hb : s+a+4*c ≤ 4649) :
    auxLPoint s j a b c = (fastKernel
      (1650 - ((a : ℤ)+b+3*c)) (1650-j-(3*(b : ℤ)+2*c))
      (550-((b : ℤ)+c)) (4650-s-j-(2*(b : ℤ)+3*c))).toNat := by
  let F : Flag := ⟨1650 - ((a : ℤ)+b+3*c), 1650-j-(3*(b : ℤ)+2*c),
    3*(550-((b : ℤ)+c)), 550-((b : ℤ)+c), 4650-s-j-(2*(b : ℤ)+3*c)⟩
  rw [fastKernel_eq]
  change auxLPoint s j a b c = (kernelLower F).toNat
  unfold auxLPoint
  rw [auxLKernel_eq]
  have hlo : 1650-(j+3*b+2*c) = F.lower.toNat := by dsimp [F]; omega
  have ho : 4650-(s+j+2*b+3*c) = F.order.toNat := by dsimp [F]; omega
  rw [hlo, ho]
  apply kFast_correct
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [balance,F]; omega
  · have hbal : balance F = 4649 - ((s : ℤ)+a+4*c) := by dsimp [balance,F]; ring
    rw [hbal]
    simp only [Nat.cast_add, Nat.cast_one, Nat.cast_min, Int.natCast_ediv, Nat.cast_ofNat,
      Int.ofNat_sub hd, Int.ofNat_sub hb, Nat.cast_mul, F]

private theorem auxLFull (j : ℕ) :
    (fastOld 1650 (1650-j) 550).toNat = 125576826 - auxLDen (1650-j) := by
  have hu : min (3*(550 : ℤ)) (1650 - j - 1) = 1650-j-1 := min_eq_right (by omega)
  have hC := cumFast_clipped 1650 (1650-j)
  have hN : ((1650 : ℤ)-j).toNat = 1650-j := by omega
  rw [hN, cumFast, ite_eq_left (by omega)] at hC
  have hLo : fastC 1650 (min (3*550) (1650-j-1)) = (denFast (1650-j) : ℤ) := by
    rw [hu, fastC_eq]
    exact hC.symm
  have hHi : fastC 1650 (3*550) = 125576826 := by decide
  rw [fastOld, hLo, hHi, auxLDen_correct]
  exact Int.toNat_sub 125576826 _

private theorem auxLArithmetic (full initial residual : ℤ) :
    min full.toNat residual.toNat - initial.toNat =
      (full-max 0 initial).toNat - (full-max (max 0 initial) residual).toNat := by
  omega

private theorem auxLSaving_at (s j a b c : ℕ)
    (hd : a+b+3*c ≤ 1650) (hc : b+c ≤ 550) (hl : c ≤ j+1) (hb : s+a+4*c ≤ 4649) :
    min (125576826 - auxLDen (1650-j)) (auxLPoint s j a b c) - auxLPoint s j 0 0 0 =
      blockSaving s j ⟨a,b,c⟩ := by
  have h0 := auxLPoint_correct s j 0 0 0 (by decide) (by decide) (by omega) (by omega)
  simp only [Nat.cast_zero, add_zero, mul_zero, sub_zero] at h0
  rw [auxLPoint_correct s j a b c hd hc hl hb, h0, ← auxLFull, auxLArithmetic]
  rfl

-- The primitives act directly on natural literals in the kernel.
private def auxLDenPrim (n : ℕ) : ℕ :=
  Nat.div (Nat.add (Nat.mul n (Nat.add (Nat.mul n (Nat.add (Nat.mul 2 n) 15)) 30)) 25) 72

private def auxLTriplePrim (x : ℕ) : ℕ :=
  Nat.div (Nat.add (Nat.mul (Nat.mul x (Nat.add (Nat.mul 2 x) 5)) (Nat.add x 2)) 3) 24

-- A constructor match first gives the continuation a numeral-sized argument.
private def auxLBind {α : Type} (n : ℕ) (f : ℕ → α) : α :=
  match n with
  | 0 => f 0
  | k+1 => f (k+1)

private theorem auxLBind_eq {α : Type} (n : ℕ) (f : ℕ → α) : auxLBind n f = f n := by
  cases n <;> rfl

private def auxLMin (a b : ℕ) : ℕ := Nat.sub a (Nat.sub a b)

private theorem auxLMin_eq (a b : ℕ) : auxLMin a b = min a b := by
  change a - (a-b) = min a b
  omega

private def auxLCumOpt (d n : ℕ) : ℕ :=
  auxLBind n fun n =>
    bif Nat.ble n (Nat.add d 1) then auxLDenPrim n else
    auxLBind (auxLMin n (Nat.add (Nat.mul 3 d) 1)) fun v =>
      Nat.sub (Nat.add (auxLDenPrim v) (auxLTriplePrim (Nat.sub v (Nat.add (Nat.mul 2 d) 3))))
        (auxLTriplePrim (Nat.sub v (Nat.add d 1)))

private theorem auxLCumOpt_eq (d n : ℕ) : auxLCumOpt d n = auxLCum d n := by
  simp only [auxLCumOpt, auxLBind_eq, auxLMin_eq]
  unfold auxLCum
  cases h : Nat.ble n (Nat.add d 1) with
  | true =>
    rw [Bool.cond_true, ite_eq_left (Nat.le_of_ble_eq_true h)]
    rfl
  | false =>
    have hn : ¬n ≤ d+1 := fun hp => Bool.noConfusion (h.symm.trans (Nat.ble_eq_true_of_le hp))
    rw [Bool.cond_false, ite_eq_right hn]
    rfl

-- Decode the residual kernel parameters and evaluate its upper count once per run.
private def auxLWithBound {α : Type} (s a b c : ℕ) (use : (ℕ → ℕ) → α) : α :=
  auxLBind (Nat.sub 1650 (Nat.add (Nat.add a b) (Nat.mul 3 c))) fun d =>
  auxLBind (Nat.add (min d (Nat.div (Nat.sub 4649 (Nat.add (Nat.add s a) (Nat.mul 4 c))) 4)) 1) fun r =>
  auxLBind (auxLCumOpt d (Nat.sub 1651 (Nat.mul 3 (Nat.add b c)))) fun hi =>
  auxLBind (Nat.sub 4650 (Nat.add (Nat.add s (Nat.mul 2 b)) (Nat.mul 3 c))) fun ord =>
  auxLBind (Nat.sub 1650 (Nat.add (Nat.mul 3 b) (Nat.mul 2 c))) fun lo =>
  if d < r then use (fun j => Nat.sub hi (auxLCumOpt d (Nat.sub ord j))) else
    auxLBind (Nat.sub d r) fun dr =>
    auxLBind (Nat.mul 3 r) fun r3 =>
    use fun j =>
      let o := Nat.sub ord j
      Nat.sub (Nat.add hi (auxLCumOpt dr (Nat.sub o r3)))
        (Nat.add (auxLCumOpt d o) (auxLCumOpt dr (Nat.sub lo j)))

private def auxLBoundFn (s a b c : ℕ) : ℕ → ℕ := auxLWithBound s a b c id

private theorem auxLWithBound_eq {α : Type} (s a b c : ℕ) (use : (ℕ → ℕ) → α) :
    auxLWithBound s a b c use = use (auxLBoundFn s a b c) := by
  simp only [auxLBoundFn, auxLWithBound, auxLBind_eq, id_eq]
  split <;> rfl

private theorem auxLBoundFn_eq (s a b c j : ℕ) :
    auxLBoundFn s a b c j = auxLPoint s j a b c := by
  simp only [auxLBoundFn, auxLWithBound, auxLBind_eq, id_eq]
  have h₁ : 4650 - (s + 2*b + 3*c) - j = 4650 - (s+j+2*b+3*c) := by omega
  have h₂ : 1650 - (3*b + 2*c) - j = 1650 - (j+3*b+2*c) := by omega
  simp only [auxLCumOpt_eq]
  unfold auxLPoint auxLKernel
  split <;> rename_i h
  · change 1650-(a+b+3*c) < min (1650-(a+b+3*c)) ((4649-(s+a+4*c))/4)+1 at h
    simp only [h, ite_true, Nat.add_zero]
    rw [← h₁]
    rfl
  · change ¬ (1650-(a+b+3*c) < min (1650-(a+b+3*c)) ((4649-(s+a+4*c))/4)+1) at h
    simp only [h, ite_false]
    rw [← h₁, ← h₂]
    rfl

-- For these grades the unshifted kernel has a simpler formula. Share its constants across a row.
private def auxLWithBase {α : Type} (s : ℕ) (use : (ℕ → ℕ → ℕ) → α) : α :=
  if 3000 ≤ s then
    auxLBind (Nat.add (Nat.div (Nat.sub 4649 s) 4) 1) fun r =>
    auxLBind (Nat.sub 4650 s) fun ord =>
    auxLBind (Nat.mul 3 r) fun r3 =>
    use fun j residual =>
      auxLBind (Nat.sub ord j) fun o =>
      auxLBind (auxLDenPrim (Nat.sub 1650 j)) fun denLo =>
      let init := Nat.sub (Nat.add 125576826 (auxLDenPrim (Nat.sub o r3)))
        (Nat.add (auxLDenPrim o) (Nat.sub denLo (auxLTriplePrim (Nat.sub r (Nat.add j 1)))))
      Nat.sub (auxLMin (Nat.sub 125576826 denLo) residual) init
  else use fun j residual =>
    Nat.sub (auxLMin (Nat.sub 125576826 (auxLDenPrim (Nat.sub 1650 j))) residual)
      (auxLBoundFn s 0 0 0 j)

private def auxLBaseDiscount (s : ℕ) : ℕ → ℕ → ℕ := auxLWithBase s id

private theorem auxLWithBase_eq {α : Type} (s : ℕ) (use : (ℕ → ℕ → ℕ) → α) :
    auxLWithBase s use = use (auxLBaseDiscount s) := by
  simp only [auxLBaseDiscount, auxLWithBase, auxLBind_eq, id_eq]
  split <;> rfl

private theorem auxLInitial_eq (s j : ℕ) (hs : 3000 ≤ s) :
    auxLPoint s j 0 0 0 =
      let r := (4649-s)/4+1
      let o := 4650-s-j
      (125576826 + auxLDen (o-3*r)) -
        (auxLDen o + (auxLDen (1650-j) - auxLTriple (r-(j+1)))) := by
  let r := (4649-s)/4+1
  let o := 4650-s-j
  have hr : r ≤ 413 := by dsimp [r]; omega
  have ho : o ≤ 1650 := by dsimp [o]; omega
  have hmin : min 1650 ((4649-s)/4) = (4649-s)/4 := min_eq_right (by omega)
  have hc (d n : ℕ) (h : n ≤ d+1) : auxLCum d n = auxLDen n := by
    rw [auxLCum, ite_eq_left h]
  have hl : auxLCum (1650-r) (1650-j) = auxLDen (1650-j) - auxLTriple (r-(j+1)) := by
    unfold auxLCum
    split
    · have hz : r-(j+1) = 0 := by omega
      rw [hz, show auxLTriple 0 = 0 by decide, Nat.sub_zero]
    · rw [min_eq_left (by omega)]
      dsimp only
      rw [show (1650-j)-(2*(1650-r)+3) = 0 by omega,
        show auxLTriple 0 = 0 by decide, Nat.add_zero,
        show (1650-j)-((1650-r)+1) = r-(j+1) by omega]
  change auxLKernel 1650 (1650-j) 1651 (4650-(s+j)) (min 1650 ((4649-s)/4)+1) =
    (125576826 + auxLDen (o-3*r)) - (auxLDen o + (auxLDen (1650-j) - auxLTriple (r-(j+1))))
  rw [hmin, show 4650-(s+j) = o by dsimp [o]; omega]
  change auxLKernel 1650 (1650-j) 1651 o r = _
  simp only [auxLKernel, ite_eq_right (show ¬1650 < r by omega)]
  rw [hc _ _ (show o ≤ 1650+1 by omega), hc _ _ (show o-3*r ≤ 1650-r+1 by omega),
    hl, show auxLCum 1650 1651 = 125576826 by decide]

private theorem auxLBaseDiscount_eq (s j residual : ℕ) :
    auxLBaseDiscount s j residual =
      min (125576826 - auxLDen (1650-j)) residual - auxLPoint s j 0 0 0 := by
  simp only [auxLBaseDiscount, auxLWithBase, auxLBind_eq, id_eq]
  split <;> rename_i h
  · dsimp only
    rw [auxLInitial_eq s j h, auxLMin_eq]
    rfl
  · dsimp only
    rw [auxLBoundFn_eq, auxLMin_eq]
    rfl

-- The first offset suffices for the lower offset guard throughout this increasing run.
private def auxLFastRun (s j code : ℕ) (base : ℕ → ℕ → ℕ) : ℕ :=
  if code % 2147483648 = 0 then 0 else
  let a := Nat.mod code 2048
  let b := Nat.mod (Nat.div code 2048) 1024
  let c := Nat.mod (Nat.div code 2097152) 1024
  let n := runLength code
  if 1650 < a+b+3*c || 550 < b+c || j+1 < c || 4649 < s+a+4*c then
    sumFrom (fun u => blockSaving s u (decode code)) j n
  else
    auxLWithBound s a b c fun residual => sumFrom (fun u => base u (residual u)) j n

private def auxLRowCore (s : ℕ) (base : ℕ → ℕ → ℕ) (j : ℕ) : List ℕ → ℕ
  | [] => 0
  | code :: tail =>
    auxLBind j fun j =>
    Nat.add (auxLFastRun s j code base) (auxLRowCore s base (Nat.add j (runLength code)) tail)

private theorem auxLSumCong (f g : ℕ → ℕ) (j n : ℕ)
    (h : ∀ u, j ≤ u → f u = g u) : sumFrom f j n = sumFrom g j n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [sumFrom, ih, h (j+n) (by omega)]

private theorem auxLFastRun_eq (s j code : ℕ) :
    auxLFastRun s j code (auxLBaseDiscount s) = runValue s j code := by
  unfold auxLFastRun runValue
  split
  · rfl
  · dsimp only
    split
    · rfl
    · rename_i h
      simp only [Bool.or_eq_true, decide_eq_true_eq, not_or, not_lt] at h
      obtain ⟨⟨⟨hd,hc⟩,hl⟩,hb⟩ := h
      rw [auxLWithBound_eq]
      apply auxLSumCong
      intro u hu
      rw [auxLBaseDiscount_eq, auxLBoundFn_eq]
      exact auxLSaving_at s u _ _ _ hd hc (hl.trans (Nat.add_le_add_right hu 1)) hb

private def auxLFastRow (s j : ℕ) (row : List ℕ) : ℕ :=
  auxLWithBase s fun base => auxLRowCore s base j row

private theorem auxLFastRow_eq (s j : ℕ) (row : List ℕ) :
    rowValue s j row = auxLFastRow s j row := by
  rw [auxLFastRow, auxLWithBase_eq]
  induction row generalizing j with
  | nil => rfl
  | cons code tail ih =>
    simp only [rowValue, auxLRowCore, auxLBind_eq, auxLFastRun_eq, ih]
    rfl


private theorem auxLCons {s n m : ℕ} {row : List ℕ} {rest : List (List ℕ)}
    (hrow : auxLFastRow s (rowStart s) row = n) (hrest : value (s+1) rest = m) :
    value s (row :: rest) = n+m := by
  rw [value, auxLFastRow_eq, hrow, hrest]

