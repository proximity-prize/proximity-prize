private def packedSum (t start n : ℕ) :=
  let c := 125576826 * units n
  let z := sliceTable tabD1 1 ((1650)-1*start) n
  let h := sliceTable tabD1 1 ((1136-t)-1*start) n
  let v := sliceTable tabD4 4 ((1136-t-3)-4*start) n
  let hc := sliceTable tabD1 1 ((1136-t-3*((1139-t)/4))-1*start) n
  let r := sliceTable tabS1 1 (((1139-t)/4)-1*start) n
  let p := sliceTable tabS8 8 ((621-2*t)-8*start) n
  let q := sliceTable tabS5 5 ((622-2*t)-5*start) n
  let x := sliceTable tabS7 7 ((622-2*t)-7*start) n
  let y := sliceTable tabS7 7 ((620-2*t)-7*start) n
  let common := h + z
  let ac := c + p
  let bc := ac + q
  let cc := bc + v
  let dc := common + x
  let ec := dc + y
  let chosen := laneSub n cc ec
  let ao := c + hc
  let bo := ao + r
  let orig := laneSub n bo common
  let old := laneSub n c z
  let clipped := old - laneSub n old chosen
  let result := laneSub n clipped orig
