  let q := a/step
  let lo := top-q
  let g := fun i => f (r+step*top-step*i)
  have hr : r < step := Nat.mod_lt a hs
  have hq : r+step*q = a := Nat.mod_add_div a step
  have hg i : g i < radix := hb _ (by omega)
  have hz : digits (fun i => g (top+1+i)) 283 = 0 := by
    have hEq : digits (fun i => g (top+1+i)) 283 = digits (fun _ => 0) 283 := by
      apply digits_congr
      intro i _
      dsimp [g]
      rw [Nat.mul_add, Nat.mul_add, Nat.mul_one, show r+step*top-(step*top+step+step*i) = 0 by omega, h0]
    rw [hEq, digits_const, Nat.zero_mul]
  have hval : digits g (top+1+283) = table r * radix^283 := by
    rw [digits_append, hz, Nat.add_zero, he r hr]
  have hl : lo+q=top := by dsimp [lo,q]; omega
  have hm : step*lo+step*q=step*top := by rw [← Nat.mul_add, hl]
  have hoff (i : ℕ) : r+step*top-step*(lo+i) = a-step*i := by
    rw [Nat.mul_add]
    omega
  have hpad : n ≤ 283+q+1 := Nat.le_add_right_of_le (Nat.le_add_right_of_le hn)
  have hsize : lo+n+(283+q+1-n) = top+1+283 := by
    rw [Nat.add_assoc lo n, Nat.add_sub_of_le hpad, ← hl]
    ac_rfl
  have hw := digits_window g lo n (283+q+1-n) hg
  rw [hsize, hval] at hw
  rw [slice_arith]
  change _ = (table r * radix^283 / radix^(283+q+1-n)) % radix^n
  rw [hw]
  exact digits_congr (fun i _ => by dsimp [g]; rw [hoff])
