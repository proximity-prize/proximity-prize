private theorem ordinary_caps (f : Equation) (j : ℕ) :
    RowCaps (C f) ⟨0, f.natDegree, j, ordinarySeedDegree f⟩ := by
  intro v y hv
  cases v with
  | zero =>
    rw [coeff_C_zero] at hv
