-- Horner form for the denominator at u-1, with its three consecutive terms below.
-- The kernel checks both formulas on every input from 0 through 1651.
private def jDenPoly (u : ℕ) : ℕ := Nat.div (Nat.add (Nat.mul u (Nat.add (Nat.mul u (Nat.add (Nat.mul 2 u) 15)) 30)) 25) 72

private def jThreePoly (u : ℕ) : ℕ := Nat.div (Nat.add (Nat.mul u (Nat.add (Nat.mul u (Nat.add (Nat.mul 2 u) 9)) 10)) 3) 24

private def jAll (test : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n+1 => test n && jAll test n

private theorem jAll_at {test : ℕ → Bool} {n i : ℕ} (h : jAll test n = true)
    (hi : i < n) : test i = true := by
  induction n with
  | zero => omega
  | succ n ih =>
    have h' := Bool.and_eq_true_iff.mp h
    by_cases he : i = n
    · exact he ▸ h'.1
    · exact ih h'.2 (by omega)

private def jThreeSlow (u : ℕ) : ℕ := denFast u + denFast (u-1) + denFast (u-2)

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
private theorem jTablesOk : jAll (fun i =>
    (jDenPoly i == denFast i) && (jThreePoly i == jThreeSlow i)) 1652 = true := by
  decide +kernel

private theorem jDenBound (u : ℕ) (h : u < 1652) : jDenPoly u = denFast u :=
  eq_of_beq (Bool.and_eq_true_iff.mp (jAll_at jTablesOk h)).1

private theorem jThreeBound (u : ℕ) (h : u < 1652) : jThreePoly u = jThreeSlow u :=
  eq_of_beq (Bool.and_eq_true_iff.mp (jAll_at jTablesOk h)).2

private theorem jKernelNat (d l c o : ℤ) (hd : 0 ≤ d) (hc : 0 ≤ c)
    (hl : l - 1 ≤ 3*c) (hb : 0 ≤ o-1-l+d) :
    (fastKernel d l c o).toNat =
      kFast d.toNat l.toNat (3*c+1).toNat o.toNat (min d ((o-1-l+d)/4)+1).toNat := by
  rw [fastKernel_eq]
  symm
  apply kFast_correct (⟨d,l,3*c,c,o⟩ : Flag)
  all_goals dsimp only [balance]
  all_goals omega

private def jSignedKernel (s j a b c : ℕ) : ℕ :=
  (fastKernel (1650-((a : ℤ)+b+3*c)) (1650-(j : ℤ)-(3*b+2*c))
    (550-((b : ℤ)+c)) (4650-(s : ℤ)-j-(2*b+3*c))).toNat

private theorem jSignedKernel_eq (s j a b c : ℕ) (hd : a+b+3*c ≤ 1650) (hc : b+c ≤ 550)
    (hl : c ≤ j+1) (hb : s+a+4*c ≤ 4649) :
    jSignedKernel s j a b c =
      let d := 1650 - (a+b+3*c)
      let r := min d ((4649 - (s+a+4*c)) / 4) + 1
      kFast d (1650 - (j+3*b+2*c)) (1651 - 3*(b+c)) (4650 - (s+j+2*b+3*c)) r := by
  unfold jSignedKernel
  rw [jKernelNat _ _ _ _ (by omega) (by omega) (by omega) (by omega)]
  dsimp only
  congr 1 <;> omega

private theorem jBaseOld (j : ℕ) :
    (fastOld 1650 (1650-(j : ℤ)) 550).toNat = 125576826 - denFast (1650-j) := by
  unfold fastOld
  rw [min_eq_right (show (1650 : ℤ) - j - 1 ≤ 3*550 by omega)]
  rw [show fastC 1650 (3*550) = 125576826 by decide, fastC_eq]
  have he := cumFast_clipped 1650 (1650-(j : ℤ))
  have ht : ((1650 : ℤ)-j).toNat = 1650-j := by omega
  rw [ht, cumFast, ite_eq_left (by omega)] at he
  simp only [Nat.cast_ofNat] at he
  rw [← he]
  omega

private theorem jSavingNat (old k r : ℤ) :
    (old - max 0 k).toNat - (old - max (max 0 k) r).toNat =
      min old.toNat r.toNat - k.toNat := by omega

private theorem jSaving_eq (s j code : ℕ) :
    blockSaving s j (decode code) =
      min (125576826 - jDenPoly (1650-j))
        (jSignedKernel s j (code % 2048) (code / 2048 % 1024) (code / 2097152 % 1024)) -
      jSignedKernel s j 0 0 0 := by
  unfold blockSaving jSignedKernel
  dsimp only [decode]
  rw [jSavingNat, jBaseOld, jDenBound _ (by omega)]
  simp only [Nat.cast_zero, mul_zero, add_zero, sub_zero]

-- The cubic formulas only need inputs in the range certified above.
private def jSmall (d u : ℕ) : ℕ :=
  if u ≤ d+1 then jDenPoly u else
    let v := min u (3*d+1)
    (jDenPoly v + jThreePoly (v-(2*d+3))) - jThreePoly (v-(d+1))

private theorem jSmall_eq (d u : ℕ) (hu : u < 1652) : jSmall d u = cumFast d u := by
  have hv := Nat.min_le_left u (3*d+1)
  simp (disch := omega) only [jSmall, cumFast, jDenBound, jThreeBound, jThreeSlow,
    Nat.sub_sub, Nat.add_assoc]

-- Match on each run invariant before passing its numerical value into the inner sum.
private def jForce {α : Type} (n : ℕ) (f : ℕ → α) : α :=
  match n with
  | 0 => f 0
  | k+1 => f (k+1)

private theorem jForce_eq {α : Type} (n : ℕ) (f : ℕ → α) : jForce n f = f n := by
  cases n <;> rfl

-- The degree, cut, upper cumulative count, and two origins are constant within a run.
private def jOnRun (s j a b c : ℕ) (next : (ℕ → ℕ) → ℕ) : ℕ :=
  let d := 1650 - (a+b+3*c)
  let r := min d ((4649 - (s+a+4*c)) / 4) + 1
  if a+b+3*c ≤ 1650 ∧ b+c ≤ 550 ∧ c ≤ j+1 ∧ s+a+4*c ≤ 4649 ∧
      2999 ≤ s ∧ r ≤ d then
    jForce d fun degree =>
    jForce (d-r) fun reduced =>
    jForce (3*r) fun cut =>
    jForce (jSmall d (1651 - 3*(b+c))) fun high =>
    jForce (1650 - (j+3*b+2*c)) fun lower =>
    jForce (4650 - (s+j+2*b+3*c)) fun order =>
      next (fun i =>
        let o := order-i
        (high + jSmall reduced (o-cut)) - (jSmall degree o + jSmall reduced (lower-i)))
  else next (fun i => jSignedKernel s (j+i) a b c)

private theorem jOnRun_eq (s j a b c : ℕ) (next : (ℕ → ℕ) → ℕ) :
    jOnRun s j a b c next = next (fun i => jSignedKernel s (j+i) a b c) := by
  unfold jOnRun
  dsimp only
  split
  · rename_i h
    obtain ⟨hd,hc,hl,hb,hs,hr⟩ := h
    simp only [jForce_eq]
    congr 1
    funext i
    rw [jSignedKernel_eq _ _ _ _ _ hd hc (by omega) hb]
    dsimp only
    simp (disch := omega) only [kFast, cutFast, ite_eq_right, jSmall_eq]
    rw [show 1650-(j+i+3*b+2*c) = 1650-(j+3*b+2*c)-i by omega,
        show 4650-(s+(j+i)+2*b+3*c) = 4650-(s+j+2*b+3*c)-i by omega]
  · rfl

private def jWalk (f : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => Nat.add (jWalk f n) (f n)

private theorem jCumLow (d u : ℕ) (h : u ≤ d+1) (hu : u < 1652) :
    cumFast d u = jDenPoly u := by rw [cumFast, ite_eq_left h, jDenBound _ hu]

private theorem jCumMid (d u : ℕ) (h₂ : u ≤ 2*d+3) (h₃ : u ≤ 3*d+1) (hu : u < 1652) :
    cumFast d u = jDenPoly u - jThreePoly (u-(d+1)) := by
  rw [← jSmall_eq _ _ hu]
  unfold jSmall
  split
  · rename_i h
    rw [Nat.sub_eq_zero_of_le h, show jThreePoly 0 = 0 by decide, Nat.sub_zero]
  · rw [min_eq_left h₃]
    dsimp only
    rw [Nat.sub_eq_zero_of_le h₂, show jThreePoly 0 = 0 by decide, Nat.add_zero]

private theorem jInitial (s t : ℕ) (h₁ : 3300 ≤ s) (h₂ : s ≤ 3513) :
    jSignedKernel s t 0 0 0 =
      let r := (4649-s)/4+1
      (125576826 + jDenPoly (4650-(s+t)-3*r)) -
        (jDenPoly (4650-(s+t)) + (jDenPoly (1650-t) - jThreePoly (r-1-t))) := by
  rw [jSignedKernel_eq _ _ _ _ _ (by omega) (by omega) (by omega) (by omega)]
  simp only [Nat.add_zero, Nat.mul_zero, Nat.sub_zero]
  rw [min_eq_right (by omega)]
  let r := (4649-s)/4+1
  change kFast 1650 (1650-t) 1651 (4650-(s+t)) r = _
  have hr : r ≤ 1650 := by dsimp [r]; omega
  rw [kFast, show cumFast 1650 1651 = 125576826 by decide]
  simp only [cutFast, ite_eq_right (Nat.not_lt.mpr hr)]
  rw [jCumLow (1650-r) _ (by dsimp [r]; omega) (by omega),
      jCumLow 1650 _ (by omega) (by omega),
      jCumMid (1650-r) _ (by dsimp [r]; omega) (by dsimp [r]; omega) (by omega)]
  rw [show 1650-t-(1650-r+1) = r-1-t by omega]

private def jBaseFinish (l o om delta i residual : ℕ) : ℕ :=
  let z := jDenPoly (Nat.sub l i)
  let base := Nat.sub (Nat.add 125576826 (jDenPoly (Nat.sub om i)))
    (Nat.add (jDenPoly (Nat.sub o i)) (Nat.sub z (jThreePoly (Nat.sub delta i))))
  Nat.sub (min (Nat.sub 125576826 z) residual) base

private theorem jBaseFinish_eq (l o om delta i residual : ℕ) :
    jBaseFinish l o om delta i residual = min (125576826-jDenPoly (l-i)) residual -
      (125576826+jDenPoly (om-i) -
        (jDenPoly (o-i) + (jDenPoly (l-i)-jThreePoly (delta-i)))) := rfl

private def jRunTotal (s j code n : ℕ) : ℕ :=
  if 3300 ≤ s ∧ s ≤ 3513 then
    jOnRun s j (code % 2048) (code / 2048 % 1024) (code / 2097152 % 1024) fun residual =>
      let r := (4649-s)/4+1
      jForce (1650-j) fun l =>
      jForce (4650-(s+j)) fun o =>
      jForce (o-3*r) fun om =>
      jForce (r-1-j) fun delta =>
        jWalk (fun i => jBaseFinish l o om delta i (residual i)) n
  else sumFrom (fun t => blockSaving s t (decode code)) j n

private theorem jRunTotal_eq (s j code n : ℕ) :
    jRunTotal s j code n = sumFrom (fun t => blockSaving s t (decode code)) j n := by
  unfold jRunTotal
  split
  · rename_i hs
    rcases hs with ⟨hs₁, hs₂⟩
    simp only [jOnRun_eq, jForce_eq]
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [jWalk, sumFrom, ih, jSaving_eq, jInitial _ _ hs₁ hs₂]
      rw [jBaseFinish_eq]
      dsimp only
      simp only [Nat.sub_sub]
      rw [show s + (j+n) = s+j+n by omega,
          show s+j+3*((4649-s)/4+1)+n = s+j+n+3*((4649-s)/4+1) by omega]
      try simp only [Nat.add_assoc]
      try rfl
  · rfl

private def jRowRun (s j : ℕ) : List ℕ → ℕ
  | [] => 0
  | code :: tail =>
    Nat.add (if code % 2147483648 = 0 then 0 else jRunTotal s j code (runLength code))
      (jForce (j + runLength code) fun next => jRowRun s next tail)

private theorem jRowRun_eq (s j : ℕ) (row : List ℕ) : jRowRun s j row = rowValue s j row := by
  induction row generalizing j with
  | nil => rfl
  | cons code tail ih =>
    simp only [jRowRun, rowValue, runValue, jForce_eq, jRunTotal_eq, ih]
    rfl

private theorem jOneRun (s : ℕ) (row : List ℕ) (v : ℕ) (h : jRowRun s (rowStart s) row = v) :
    value s [row] = v := by simpa only [value, Nat.add_zero, ← jRowRun_eq] using h

-- Each paired literal is the check for one row of the original certificate.
private def jCheckRows (s : ℕ) : List (List ℕ) → List ℕ → Bool
  | [], [] => true
  | row :: rs, v :: vs =>
    (jRowRun s (rowStart s) row == v) && (fits s [row] && jCheckRows (s+1) rs vs)
  | _, _ => false

private theorem jCheckRows_eq {s : ℕ} {rs : List (List ℕ)} {vs : List ℕ}
    (h : jCheckRows s rs vs = true) :
    rs.length = vs.length ∧ fits s rs = true ∧ value s rs = vs.sum := by
  induction rs generalizing s vs with
  | nil =>
    cases vs with
    | nil => exact ⟨rfl, rfl, rfl⟩
    | cons v vs => contradiction
  | cons row rs ih =>
    cases vs with
    | nil => contradiction
    | cons v vs =>
      have h₁ := Bool.and_eq_true_iff.mp h
      have h₂ := Bool.and_eq_true_iff.mp h₁.2
      obtain ⟨hlen,hfit,hval⟩ := ih h₂.2
      have hv := jOneRun s row v (eq_of_beq h₁.1)
      refine ⟨congrArg Nat.succ hlen, ?_, ?_⟩
      · change fits s ([row] ++ rs) = true
        rw [fits_append, h₂.1, Bool.true_and]
        exact hfit
      · change value s ([row] ++ rs) = v + vs.sum
        rw [value_append, hv]
        exact congrArg (v + ·) hval

