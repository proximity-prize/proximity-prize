private def loopF (s : Nat) : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | n+1, j, p => bindNatF j fun j => bindNatF p fun p =>
    Nat.add (savingF s j p) (loopF s n (Nat.add j (nat_lit 1)) (Nat.div p (nat_lit 268435456)))

private theorem loopF_eq (s n j p : Nat) : loopF s n j p = rowLoop s n j p := by
  induction n generalizing j p with
  | zero => rfl
  | succ n ih =>
    simp only [loopF, rowLoop, bindNatF_eq, savingF_eq, ih]
    rfl

private def scoreF (s : Nat) (r : Row) : Nat :=
  if 2008 ≤ s ∧ s < 3012 ∧ 322 ≤ r.first ∧ r.first + r.count ≤ 1063 ∧
    3000 ≤ s + r.first ∧ s + r.first + r.count ≤ 3420
  then loopF s r.count r.first r.packed else 0

private theorem scoreF_eq (s : Nat) (r : Row) : scoreF s r = rowScore s r := by
  simp only [scoreF, rowScore, loopF_eq]

private def batchF : Nat → List Row → Nat
  | _, [] => 0
  | s, r :: rs => scoreF s r + batchF (s+1) rs

private theorem batchF_eq (s : Nat) (rs : List Row) : batchF s rs = batchScore s rs := by
  induction rs generalizing s with
  | nil => rfl
  | cons r rs ih => simp only [batchF, batchScore, scoreF_eq, ih]


