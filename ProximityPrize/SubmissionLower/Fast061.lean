      Finset.le_sup (f := fun i => (f.coeff i).totalDegree)
        (Polynomial.mem_support_iff.mpr hv)⟩
  | succ v =>
    rw [coeff_C_succ, coeff_zero] at hv
    exact (hv rfl).elim
