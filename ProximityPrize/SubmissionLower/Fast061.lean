private def gCubicRaw (n a b c d : ℕ) : ℕ :=
  let linear := Nat.add (Nat.mul 2 n) a
  let quadratic := Nat.add (Nat.mul n linear) b
  Nat.div (Nat.add (Nat.mul n quadratic) c) d

-- Expose the numeric argument before evaluating the polynomial so repeated
-- indices in different cells have the same kernel reduction.
private def gCubic (n a b c d : ℕ) : ℕ :=
  match n with
  | 0 => Nat.div c d
  | k+1 => gCubicRaw (Nat.succ k) a b c d

/-- The argument is one more than the index so a truncated index gives zero. -/
private def gDen (n : ℕ) : ℕ := gCubic n 15 30 25 72

private theorem gDen_formula (n : ℕ) : gDen n = (n * (n * (2 * n + 15) + 30) + 25) / 72 := by cases n <;> rfl

private theorem gDen_spec (u : ℤ) : fastDen u = (gDen (u + 1).toNat : ℤ) := by
  by_cases h : u < 0
  · have hzero : (u + 1).toNat = 0 := by omega
    rw [fastDen, ite_eq_left h, hzero]
    rfl
  · rw [fastDen, ite_eq_right h, gDen_formula, Int.natCast_ediv]
    push_cast
    rw [Int.toNat_of_nonneg (by omega : 0 ≤ u + 1)]
    congr 1
    ring

private def gTriple (n : ℕ) : ℕ := gDen n + gDen (n - 1) + gDen (n - 2)

/-- Sum of the three shifted cubic counts in the middle branch of fastC. -/
private def gPoly (n : ℕ) : ℕ := gCubic n 9 10 3 24

private theorem gPoly_formula (n : ℕ) : gPoly n = (n * (n * (2 * n + 9) + 10) + 3) / 24 := by cases n <;> rfl

private theorem gDen_period (n : ℕ) :
    gDen (n + 12) = gDen n + (n * n + 17*n + 83) := by
  simp only [gDen_formula]
  rw [show (n+12)*((n+12)*(2*(n+12)+15)+30)+25 =
    n*(n*(2*n+15)+30)+25 + (n*n+17*n+83)*72 by ring]
  exact Nat.add_mul_div_right _ _ (by decide)

private theorem gPoly_period (n : ℕ) :
    gPoly (n + 12) = gPoly n + (3*n*n + 45*n + 203) := by
  simp only [gPoly_formula]
  rw [show (n+12)*((n+12)*(2*(n+12)+9)+10)+3 =
    n*(n*(2*n+9)+10)+3 + (3*n*n+45*n+203)*24 by ring]
  exact Nat.add_mul_div_right _ _ (by decide)

private theorem gTriple_poly (n : ℕ) : gTriple n = gPoly n := by
  cases n with
  | zero => rfl
  | succ n =>
    cases n with
    | zero => rfl
    | succ k =>
      change gDen (k+2) + gDen (k+1) + gDen k = gPoly (k+2)
      have small : ∀ i : Fin 12, gDen (i.val+2) + gDen (i.val+1) + gDen i.val =
          gPoly (i.val+2) := by decide
      induction k using Nat.strong_induction_on with
      | h k ih =>
        by_cases hk : k < 12
        · exact small ⟨k,hk⟩
        · obtain ⟨q,rfl⟩ : ∃ q, k = q+12 := ⟨k-12, by omega⟩
          have prev := ih q (by omega)
          rw [show q+12+2 = (q+2)+12 by omega, show q+12+1=(q+1)+12 by omega,
            gDen_period (q+2), gDen_period (q+1), gDen_period q, gPoly_period (q+2)]
          rw [← prev]
          ring

private theorem gTriple_spec (x : ℤ) :
    fastDen (x - 1) + fastDen (x - 2) + fastDen (x - 3) = (gTriple x.toNat : ℤ) := by
  simp only [gDen_spec, gTriple, Nat.cast_add]
  rw [show (x-1+1).toNat = x.toNat by omega,
    show (x-2+1).toNat = x.toNat - 1 by omega,
    show (x-3+1).toNat = x.toNat - 2 by omega]

private theorem gC_small (d u : ℤ) (hd : 0 ≤ d) (hu : u ≤ d) :
    fastC d u = fastDen u := by
  by_cases hn : u < 0
  · simp [fastC, fastDen, hn]
  · simp [fastC, show ¬ d < 0 by omega, hn, min_eq_left (by omega : u ≤ 3 * d), hu]

private theorem gC_mid (d u : ℤ) (hd : 0 ≤ d) (hu : u ≤ 3 * d) (hu' : u ≤ 2 * d + 2) :
    fastC d u = fastDen u - (gTriple (u - d).toNat : ℤ) := by
  by_cases h : u ≤ d
  · rw [gC_small d u hd h, show (u - d).toNat = 0 by omega]
    change fastDen u = fastDen u - 0
    omega
  · have hn : ¬ u < 0 := by omega
    simp only [fastC, show ¬ d < 0 by omega, hn, decide_false, Bool.or_false,
      Bool.false_eq_true, ite_false, min_eq_left hu, h,
      show u - d ≤ d + 2 by omega, ite_true, ← gTriple_spec]
    ring

/-- Region shared by the nonzero runs. The last inequality puts the order
in the first branch of the cumulative count. -/
private def gGood (s j x t v : ℕ) : Prop :=
  3303 ≤ s ∧ s ≤ 3341 ∧ 120 ≤ j ∧ j ≤ 340 ∧ x + 4 * v ≤ 512 ∧
  t ≤ 384 ∧ v ≤ 48 ∧ x + 2999 ≤ s + j + t

/-- The two order counts are in the first branch of fastC. The high and
lower counts need at most its middle branch. Group the positive terms
before truncated subtraction to recover the signed kernel's positive part. -/
private def gK (s j x t v : ℕ) : ℕ :=
  let top2 := Nat.mul 2 t
  let top3 := Nat.mul 3 t
  let cubic3 := Nat.mul 3 v
  let removed := Nat.add (Nat.div (Nat.sub (Nat.sub (Nat.sub 4649 s) x) (Nat.mul 4 v)) 4) 1
  let order := Nat.sub (Nat.sub (Nat.sub (Nat.sub 4650 s) j) top2) cubic3
  let lower := Nat.sub (Nat.sub (Nat.sub 1650 j) top3) (Nat.mul 2 v)
  let upperCount := gDen (Nat.sub (Nat.sub 1651 top3) cubic3)
  let reducedOrderCount := gDen (Nat.sub order (Nat.mul 3 removed))
  let lowerCorrection := gPoly (Nat.sub (Nat.add (Nat.add x v) removed) (Nat.add (Nat.add top2 j) 1))
  let penalty := gPoly (Nat.sub x top2)
  Nat.sub (Nat.add (Nat.add upperCount reducedOrderCount) lowerCorrection)
    (Nat.add (Nat.add penalty (gDen order)) (gDen lower))

private theorem gSplit (a b c d e f : ℕ) :
    ((a : ℤ) - b - c + d - (e - (f : ℤ))).toNat = a + d + f - (b + c + e) := by
  omega

private theorem gK_spec (s j x t v : ℕ) (good : gGood s j x t v) :
    (fastKernel (1650 - ((x : ℤ) + t + 3 * v))
      (1650 - j - (3 * (t : ℤ) + 2 * v)) (550 - ((t : ℤ) + v))
      (4650 - s - j - (2 * (t : ℤ) + 3 * v))).toNat = gK s j x t v := by
  obtain ⟨hs, hs', hj, hj', hx, ht, hv, he⟩ := good
  let d : ℤ := 1650 - ((x : ℤ) + t + 3 * v)
  let l : ℤ := 1650 - j - (3 * (t : ℤ) + 2 * v)
  let c : ℤ := 550 - ((t : ℤ) + v)
  let o : ℤ := 4650 - s - j - (2 * (t : ℤ) + 3 * v)
  let r : ℤ := (o - 1 - l + d) / 4 + 1
  change (fastKernel d l c o).toNat = _
  have hd : 0 ≤ d := by dsimp [d]; omega
  have hc : 0 ≤ c := by dsimp [c]; omega
  have hb : 0 ≤ o - 1 - l + d := by dsimp [o,l,d]; omega
  have hr : (o - 1 - l + d) / 4 ≤ d := by dsimp [o,l,d]; omega
  have hrem : 0 ≤ d - r := by dsimp [r,o,l,d]; omega
  have hadj : l - 1 ≤ 3 * c := by dsimp [l,c]; omega
  have hO : o - 1 ≤ d := by dsimp [o,d]; omega
  have hOR : o - 1 - 3 * r ≤ d - r := by dsimp [r,o,l,d]; omega
  have hH : 3 * c ≤ 3 * d := by dsimp [c,d]; omega
  have hH' : 3 * c ≤ 2 * d + 2 := by dsimp [c,d]; omega
  have hL : l - 1 ≤ 3 * (d - r) := by dsimp [r,o,l,d]; omega
  have hL' : l - 1 ≤ 2 * (d - r) + 2 := by dsimp [r,o,l,d]; omega
  simp only [fastKernel, not_lt.mpr hd, not_lt.mpr hc, decide_false,
    Bool.or_false, Bool.false_eq_true, ite_false, not_lt.mpr hb, min_eq_right hr,
    hadj, ite_true]
  change (fastC d (3*c) - fastC d (o-1) + fastC (d-r) (o-1-3*r) -
    fastC (d-r) (l-1)).toNat = _
  rw [gC_mid _ _ hd hH hH', gC_small _ _ hd hO, gC_small _ _ hrem hOR,
    gC_mid _ _ hrem hL hL']
  simp only [gDen_spec]
  let rn := (4649 - s - x - 4 * v) / 4 + 1
  have er : r = (rn : ℤ) := by dsimp [rn,r,o,l,d]; omega
  have e1 : (3*c+1).toNat = 1651-3*t-3*v := by dsimp [c]; omega
  have e2 : (3*c-d).toNat = x-2*t := by dsimp [c,d]; omega
  have e3 : (o-1+1).toNat = 4650-s-j-2*t-3*v := by dsimp [o]; omega
  have e4 : (o-1-3*r+1).toNat = (4650-s-j-2*t-3*v)-3*rn := by rw [er]; dsimp [o]; omega
  have e5 : (l-1+1).toNat = 1650-j-3*t-2*v := by dsimp [l]; omega
  have e6 : (l-1-(d-r)).toNat = x+v+rn-(2*t+j+1) := by rw [er]; dsimp [l,d]; omega
  rw [e1,e2,e3,e4,e5,e6]
  unfold gK
  simp only [← gTriple_poly]
  change _ = gDen (1651-3*t-3*v) + gDen (4650-s-j-2*t-3*v-3*rn) +
    gTriple (x+v+rn-(2*t+j+1)) - (gTriple (x-2*t) + gDen (4650-s-j-2*t-3*v) + gDen (1650-j-3*t-2*v))
  exact gSplit _ _ _ _ _ _

private def gBlock (s j x t v : ℕ) : ℕ :=
  let old := gDen 1651 - gDen (1650 - j)
  let initial := gK s j 0 0 0
  let residual := gK s j x t v
  min old residual - initial

private theorem gClip (old initial residual : ℤ) :
    (old - max 0 initial).toNat - (old - max (max 0 initial) residual).toNat =
      min old.toNat residual.toNat - initial.toNat := by
  omega

private theorem gBlock_spec (s j x t v : ℕ) (h : gGood s j x t v) :
    blockSaving s j ⟨x,t,v⟩ = gBlock s j x t v := by
  have h0 : gGood s j 0 0 0 := by
    unfold gGood at *
    omega
  have e0 := gK_spec s j 0 0 0 h0
  simp only [Nat.cast_zero, mul_zero, add_zero, sub_zero] at e0
  have er := gK_spec s j x t v h
  have hj := h.2.2.2.1
  have eo : (fastOld 1650 (1650-j) 550).toNat = gDen 1651 - gDen (1650-j) := by
    simp only [fastOld]
    rw [min_eq_right (by omega : (1650 : ℤ) - j - 1 ≤ 3 * 550),
      gC_small _ _ (by decide) (by decide), gC_small _ _ (by decide) (by omega)]
    rw [gDen_spec, gDen_spec, show ((1650 : ℤ) - j - 1 + 1).toNat = 1650-j by omega]
    change ((gDen 1651 : ℤ) - _).toNat = _
    omega
  unfold blockSaving gBlock
  dsimp only
  rw [← eo, ← e0, ← er]
  exact gClip _ _ _

private def gRunAllowed (s j x t v n : ℕ) : Bool :=
  Nat.ble 3303 s && Nat.ble s 3341 && Nat.ble 120 j && Nat.ble j 340 &&
  Nat.ble (x + 4*v) 512 && Nat.ble t 384 && Nat.ble v 48 &&
  Nat.ble (x + 2999) (s+j+t) && Nat.ble (j+n) 341

private theorem gAllowed_spec (s j x t v n : ℕ) (h : gRunAllowed s j x t v n = true) :
    gGood s j x t v ∧ j + n ≤ 341 := by
  simpa only [gRunAllowed, gGood, Bool.and_eq_true_iff, Nat.ble_eq, and_assoc] using h

private def gIndex (n : ℕ) (f : ℕ → ℕ) : ℕ :=
  match n with
  | 0 => f 0
  | k+1 => f (Nat.succ k)

private theorem gIndex_eq (n : ℕ) (f : ℕ → ℕ) : gIndex n f = f n := by
  cases n <;> rfl

private def gRun (s j code : ℕ) : ℕ :=
  gIndex (code % 2048) fun x =>
  gIndex (code / 2048 % 1024) fun t =>
  gIndex (code / 2097152 % 1024) fun v =>
  let n := runLength code
  if code % 2147483648 = 0 then 0
  else if gRunAllowed s j x t v n then
    sumFrom (fun u => gBlock s u x t v) j n
  else runValue s j code

private theorem gSum_congr {a b : ℕ → ℕ} {j n : ℕ}
    (h : ∀ k < n, a (j+k) = b (j+k)) :
    sumFrom a j n = sumFrom b j n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change sumFrom a j n + a (j+n) = sumFrom b j n + b (j+n)
    rw [h n (by omega), ih (fun k hk => h k (by omega))]

private theorem gRun_spec (s j code : ℕ) : runValue s j code = gRun s j code := by
  unfold gRun
  simp only [gIndex_eq]
  split
  · rename_i h
    simp only [runValue, h, ite_true]
  · rename_i hn
    split
    · rename_i hg
      simp only [runValue, hn, ite_false]
      apply gSum_congr
      intro k hk
      apply gBlock_spec
      obtain ⟨hg, hlim⟩ := gAllowed_spec _ _ _ _ _ _ hg
      unfold gGood at *
      omega
    · rfl

private def gRow (s j : ℕ) : List ℕ → ℕ
  | [] => 0
  | code :: tail => gIndex j fun u =>
    Nat.add (gRun s u code) (gRow s (Nat.add u (runLength code)) tail)

private theorem gRow_spec (s j : ℕ) (row : List ℕ) :
    rowValue s j row = gRow s j row := by
  induction row generalizing j with
  | nil => rfl
  | cons code tail ih =>
    change _ = gIndex j _
    rw [gIndex_eq]
    exact congrArg₂ Nat.add (gRun_spec s j code) (ih _)

private def gValue (s : ℕ) : List (List ℕ) → ℕ
  | [] => 0
  | row :: rows => gIndex s fun u =>
    Nat.add (gRow u (rowStart u) row) (gValue (Nat.succ u) rows)

private theorem gValue_spec (s : ℕ) (rows : List (List ℕ)) :
    value s rows = gValue s rows := by
  induction rows generalizing s with
  | nil => rfl
  | cons row tail ih =>
    change _ = gIndex s _
    rw [gIndex_eq]
    exact congrArg₂ Nat.add (gRow_spec _ _ row) (ih _)

