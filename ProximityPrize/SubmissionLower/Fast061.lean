private theorem tableChecked (f table : ℕ → ℕ) (step top base start n : ℕ)
    (hs : 0 < step) (ha : (base-step*start)/step ≤ top) (hn : n ≤ 283)
    (hbase : base < 1664) (htop : step-1+step*top < 1664) (h0 : f 0 = 0)
    (hb : ∀ {x}, x < 1664 → f x ≤ 2000000000)
    (he : ∀ r < step, table r = digits (fun i => f (r+step*top-step*i)) (top+1)) :
    Checked n (fun i => f (base-step*(start+i))) (sliceTable table step (base-step*start) n) 2000000000 := by
  refine ⟨?_, fun i _ => hb (by omega)⟩
  calc
    _ = digits (fun i => f ((base-step*start)-step*i)) n :=
      digits_congr (fun i _ => by rw [Nat.mul_add, Nat.sub_sub])
