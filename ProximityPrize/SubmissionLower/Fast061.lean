private theorem sum_split (f : ℕ → ℕ) (a b : ℕ) :
    rangeSum f (a+b) = rangeSum f a + rangeSum (fun k => f (a+k)) b := by
  induction b with
  | zero => simp [rangeSum]
  | succ b ih =>
    change rangeSum f (a+b) + f (a+b) = _
    rw [ih]
    simp [rangeSum, Nat.add_assoc]
private theorem sum_ext {n : ℕ} {f g : ℕ → ℕ} (h : ∀ k < n, f k = g k) :
    rangeSum f n = rangeSum g n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [rangeSum, rangeSum, ih (fun k hk => h k (by omega)), h n (by omega)]
private theorem sum_zero {n : ℕ} {f : ℕ → ℕ} (h : ∀ k < n, f k = 0) :
    rangeSum f n = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => rw [rangeSum, ih (fun k hk => h k (by omega)), h n (by omega), Nat.add_zero]
private def shortGrade (t : ℕ) :=
