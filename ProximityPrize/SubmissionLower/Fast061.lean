    add_bounds .ordinate (by intro e; cases e) _ _ high.ordinate hord,
    add_bounds .mixed (by intro e; cases e) _ _ high.mixed hmix⟩

theorem of_children (h1 : c1) (h2 : c2) (h3 : c3) (h4 : c4) (h5 : c5) :
