private def threeDen (x : ℕ) := natDen (x-1) + natDen (x-2) + natDen (x-3)

private theorem threeDen_zero : threeDen 0 = 0 := rfl

private theorem threeDen_small {x : ℕ} (hx : x ≤ 1) : threeDen x = 0 := by
  simp [threeDen, show x-1 = 0 by omega, show x-2 = 0 by omega, show x-3 = 0 by omega, natDen]

private theorem parts_formula (d n p q : ℕ) (hc : n ≤ 3*d+1)
    (hp : n-2*d-2 = p) (hq : n-d = q) :
    countParts d n = (natDen n + threeDen p, threeDen q) := by
  subst p q
  unfold countParts
  rw [show Nat.min n (3*d+1) = n from min_eq_left hc]
  by_cases h : n ≤ d+1
  · simp only [ite_eq_left h, threeDen_small (show n-d ≤ 1 by omega),
      threeDen_small (show n-2*d-2 ≤ 1 by omega), Nat.add_zero]
  · simp only [ite_eq_right h]
    by_cases hh : n ≤ 2*d+3
    · rw [ite_eq_left hh, threeDen_small (show n-2*d-2 ≤ 1 by omega), Nat.add_zero]
      rfl
    · simp only [ite_eq_right hh, threeDen, Nat.sub_sub, Nat.add_assoc]

private def activeEnd (t : ℕ) := min 283 (min ((1139 - t) / 4) (657-t))

-- Below this offset the diagonal lower bound or the chosen cap may cut the row.
private def firstOffset (t : ℕ) := max (23-t) ((38-t)/3)

-- On the active offsets the four chosen countParts calls share the two main
-- denominator terms. The adjacent triples telescope to natDen (v-3).
private def formula (D S : ℕ → ℕ) (t j : ℕ) :=
  let b := 1136-t
  let h := b-j
  let z := 1650-j
  let v := b-4*j
  let r := (1139-t)/4
  let common := D h + D z
  let chosen := D 1651 + S (621-2*t-8*j) + S (622-2*t-5*j) + D (v-3) -
    (common + S (622-2*t-7*j) + S (620-2*t-7*j))
  let original := D 1651 + D (b-3*r-j) + S (r-j) - common
  Nat.min (D 1651 - D z) chosen - original

private theorem kernelOfParts {d j h r a b c e f g k l : ℕ}
    (pa : countParts d 1651 = (a,b)) (pc : countParts d h = (c,e))
    (pf : countParts (d-r) (h-3*r) = (f,g)) (pk : countParts (d-r) (1650-j) = (k,l)) :
    natKernel d j h r = a+e+f+l-(b+c+g+k) := by
  unfold natKernel
  rw [pa]
  by_cases hr : r = 0
  · subst r
    simp only [Nat.sub_zero, Nat.mul_zero] at pf pk
    rw [pc] at pf
    obtain ⟨rfl,rfl⟩ := Prod.mk.inj pf
    simp only [ite_true, pk]
    omega
  · simp only [ite_eq_right hr, pc, pf, pk]

-- The offsets enter the counts only through these affine coordinates.
private theorem chosenFormula (t j h v d e z : ℕ)
    (hcap : 36 ≤ t+3*j) (hh : h+j+t=1136) (hv : v+4*j+t=1136)
    (hd : d=514+t+4*j) (he : e=514+t+3*j) (hz : z+j=1650) :
    natKernel d j h j =
      natDen 1651 + threeDen (621-2*t-8*j) + threeDen (622-2*t-5*j) + natDen (v-3) -
      ((natDen h + natDen z) + threeDen (622-2*t-7*j) + threeDen (620-2*t-7*j)) := by
  have ca : countParts d 1651 = (natDen 1651 + threeDen (621-2*t-8*j), threeDen (v+1)) := by
    apply parts_formula <;> omega
  have ch : countParts d h = (natDen h + threeDen (0), threeDen (622-2*t-5*j)) := by
    apply parts_formula <;> omega
  have cf : countParts e v = (natDen v + threeDen (0), threeDen (622-2*t-7*j)) := by
    apply parts_formula <;> omega
  have ck : countParts e z = (natDen z + threeDen (620-2*t-7*j), threeDen (v)) := by
    apply parts_formula <;> omega
  have htel : natDen v + threeDen v = threeDen (v+1) + natDen (v-3) := by
    simp only [threeDen, show v+1-1 = v by omega, show v+1-2 = v-1 by omega,
      show v+1-3 = v-2 by omega]
    omega
  have hF : countParts (d-j) (h-3*j) = (natDen v + threeDen 0, threeDen (622-2*t-7*j)) := by
    rw [show d-j=e by omega, show h-3*j=v by omega]
    exact cf
  have hK : countParts (d-j) (1650-j) = (natDen z + threeDen (620-2*t-7*j), threeDen v) := by
    rw [show d-j=e by omega, show 1650-j=z by omega]
    exact ck
  rw [kernelOfParts ca ch hF hK]
  simp only [threeDen_zero, Nat.add_zero]
  omega

private theorem originalFormula (j h b r z : ℕ) (hb : b ≤ 1136) (hh : h+j=b)
    (hr : r ≤ 285) (hrpos : 0 < r) (hz : z+j=1650) :
    natKernel 1650 j h r =
      natDen 1651 + natDen (b-3*r-j) + threeDen (r-j) - (natDen h + natDen z) := by
  have hhr : h-3*r = b-3*r-j := by omega
  have oa : countParts 1650 1651 = (natDen 1651 + threeDen (0), threeDen (1)) := by
    apply parts_formula <;> omega
  have oh : countParts 1650 h = (natDen h + threeDen (0), threeDen (0)) := by
    apply parts_formula <;> omega
  have ofr : countParts (1650-r) (h-3*r) = (natDen (h-3*r) + threeDen (0), threeDen (0)) := by
    apply parts_formula <;> omega
  have ok : countParts (1650-r) z = (natDen z + threeDen (0), threeDen (r-j)) := by
    apply parts_formula <;> omega
  rw [hhr] at ofr
  simp only [natKernel, oa, ite_eq_right (Nat.ne_of_gt hrpos), oh, ofr, show 1650-j = z by omega, ok, threeDen_zero,
      threeDen_small (show 1 ≤ 1 by decide), Nat.add_zero, Nat.zero_add, hhr]

private theorem entry_formula {t j : ℕ} (ht : t < 499) (hl : firstOffset t ≤ j)
    (hu : j < activeEnd t) : natEntry t j = formula natDen threeDen t j := by
  have hfirst : 36 ≤ t+3*j ∧ 23 ≤ t+j := by unfold firstOffset at hl; omega
  have hbound : j < 283 ∧ j < (1139-t)/4 ∧ j < 657-t := by
    simpa [activeEnd, lt_min_iff] using hu
  let b := 1136-t
  let r := (1139-t)/4
  let h := b-j
  let v := b-4*j
  let d := 514+t+4*j
  let e := 514+t+3*j
  let z := 1650-j
  have hb : b+t = 1136 := by dsimp [b]; omega
  have hr : r = (b+3)/4 := by unfold r; congr 1; omega
  have hrpos : 0 < r := by omega
  have hh : h+j=b := by dsimp [h]; omega
  have hv : v+4*j=b := by dsimp [v]; omega
  have hd : d+v=1650 := by dsimp [d]; omega
  have hz : z+j=1650 := by dsimp [z]; omega
  have hd' : 1650-v = d := by omega
  have hchosen := chosenFormula t j h v d e z hfirst.1 (by omega) (by omega) rfl rfl hz
  have horig := originalFormula j h b r z (by omega) hh (by omega) hrpos hz
  have hdiag : 23 ≤ t+j ∧ t+j ≤ 656 := by omega
  have hpow : 4*j < b := by omega
  simp only [natEntry, ite_eq_left hdiag]
  change (if 4*j < b then _ else _) = _
  rw [ite_eq_left hpow]
  change Nat.min (natDen 1651 - natDen z) (natKernel (1650-v) j h j) - natKernel 1650 j h ((b+3)/4) = _
  rw [hd', ← hr, hchosen, horig]
  rfl

private theorem sum_split (f : ℕ → ℕ) (a b : ℕ) :
    rangeSum f (a+b) = rangeSum f a + rangeSum (fun k => f (a+k)) b := by
  induction b with
  | zero => simp [rangeSum]
  | succ b ih =>
    change rangeSum f (a+b) + f (a+b) = _
    rw [ih]
    simp [rangeSum, Nat.add_assoc]

private theorem sum_ext {n : ℕ} {f g : ℕ → ℕ} (h : ∀ k < n, f k = g k) :
    rangeSum f n = rangeSum g n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [rangeSum, rangeSum, ih (fun k hk => h k (by omega)), h n (by omega)]

private theorem sum_zero {n : ℕ} {f : ℕ → ℕ} (h : ∀ k < n, f k = 0) :
    rangeSum f n = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => rw [rangeSum, ih (fun k hk => h k (by omega)), h n (by omega), Nat.add_zero]

private def shortGrade (t : ℕ) :=
  rangeSum (natEntry t) (firstOffset t) +
    rangeSum (fun k => formula natDen threeDen t (firstOffset t + k)) (activeEnd t - firstOffset t)

private theorem grade_formula {t : ℕ} (ht : t < 499) : natGrade t = shortGrade t := by
  let a := firstOffset t
  let b := activeEnd t
  have ha : a ≤ b := by
    dsimp [a,b,activeEnd,firstOffset]
    omega
  have hb : b ≤ 283 := min_le_left _ _
  have hz : ∀ k < 283-b, natEntry t (b+k) = 0 := by
    intro k hk
    unfold natEntry
    split
    · rename_i h
      rw [ite_eq_right]
      dsimp [b,activeEnd] at *
      omega
    · rfl
  change rangeSum (natEntry t) 283 = _
  calc
    _ = rangeSum (natEntry t) b + rangeSum (fun k => natEntry t (b+k)) (283-b) := by
      rw [← sum_split, show b+(283-b)=283 by omega]
    _ = rangeSum (natEntry t) b := by rw [sum_zero hz, Nat.add_zero]
    _ = rangeSum (natEntry t) a + rangeSum (fun k => natEntry t (a+k)) (b-a) := by
      rw [← sum_split, show a+(b-a)=b by omega]
    _ = _ := by
      apply congrArg (rangeSum (natEntry t) a + ·)
      apply sum_ext
      intro k hk
      apply entry_formula ht
      · change a ≤ a+k
        omega
      · change a+k < b
        omega

-- Each coefficient occupies one 40-bit digit. Its high bit is used as a
-- guard for pointwise subtraction. The remaining bits hold the counts.
private abbrev radix : ℕ := 1099511627776
private abbrev guardBit : ℕ := 549755813888

private def digits (f : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => digits f n * radix + f n

private theorem digits_congr {f g : ℕ → ℕ} {n : ℕ} (h : ∀ i < n, f i = g i) :
    digits f n = digits g n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [digits, digits, ih (fun i hi => h i (by omega)), h n (by omega)]

private theorem digits_add (f g : ℕ → ℕ) (n : ℕ) :
    digits (fun i => f i + g i) n = digits f n + digits g n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [digits, ih, Nat.add_mul]; omega

private theorem digits_mul (c : ℕ) (f : ℕ → ℕ) (n : ℕ) :
    digits (fun i => c * f i) n = c * digits f n := by
  induction n with
  | zero => simp [digits]
  | succ n ih => simp [digits, ih, Nat.mul_add, Nat.mul_assoc]

private theorem digits_sub {f g : ℕ → ℕ} {n : ℕ} (h : ∀ i < n, g i ≤ f i) :
    digits (fun i => f i - g i) n = digits f n - digits g n := by
  have he : digits (fun i => (f i - g i) + g i) n = digits f n :=
    digits_congr (fun i hi => Nat.sub_add_cancel (h i hi))
  rw [digits_add] at he
  omega

private theorem and_digit {a b x y : ℕ} (hx : x < radix) (hy : y < radix) :
    (a*radix+x) &&& (b*radix+y) = (a &&& b)*radix + (x &&& y) := by
  have hd (u v : ℕ) (hv : v < radix) : (u*radix+v)/radix = u := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by decide), Nat.div_eq_of_lt hv, Nat.zero_add]
  have hm (u v : ℕ) (hv : v < radix) : (u*radix+v)%radix = v := by
    rw [Nat.mul_add_mod', Nat.mod_eq_of_lt hv]
  have divE := Nat.and_div_two_pow (a := a*radix+x) (b := b*radix+y) (n := 40)
  have modE := Nat.and_mod_two_pow (a := a*radix+x) (b := b*radix+y) (n := 40)
  change _ / radix = (_ / radix &&& (_ / radix)) at divE
  change _ % radix = (_ % radix &&& (_ % radix)) at modE
  rw [hd a x hx, hd b y hy] at divE
  rw [hm a x hx, hm b y hy] at modE
  have hrec := Nat.div_add_mod ((a*radix+x) &&& (b*radix+y)) radix
  rw [divE, modE, Nat.mul_comm radix] at hrec
  exact hrec.symm

private theorem digits_and {f g : ℕ → ℕ} {n : ℕ}
    (hf : ∀ i < n, f i < radix) (hg : ∀ i < n, g i < radix) :
    digits (fun i => f i &&& g i) n = digits f n &&& digits g n := by
  induction n with
  | zero => simp [digits]
  | succ n ih =>
    simp only [digits, and_digit (hf n (by omega)) (hg n (by omega))]
    rw [ih (fun i hi => hf i (by omega)) (fun i hi => hg i (by omega))]

private def units (n : ℕ) := (radix ^ n - 1)/(radix-1)

private theorem digits_const (c n : ℕ) : digits (fun _ => c) n = c * units n := by
  have h : (radix-1) * digits (fun _ => 1) n + 1 = radix^n := by
    induction n with
    | zero => rfl
    | succ n ih => rw [digits, pow_succ, ← ih]; simp only [radix] at *; omega
  have hu : digits (fun _ => 1) n = units n := by unfold units; simp only [radix] at *; omega
  simpa only [Nat.mul_one, hu] using digits_mul c (fun _ => 1) n

-- Guard bits prevent borrows across digits. A surviving guard expands to
-- a mask of 39 low bits, retaining exactly the nonnegative differences.
private def laneSub (n x y : ℕ) :=
  let hi := guardBit * units n
  let d := hi+x-y
  let flags := d &&& hi
  d &&& (flags-flags/guardBit)

private theorem guarded_bit {x y : ℕ} (hx : x < guardBit) (hy : y < guardBit) :
    ((guardBit+x-y) &&& guardBit) = guardBit * (if y ≤ x then 1 else 0) := by
  let d := guardBit+x-y
  have hd : (d &&& guardBit)/guardBit = (d/guardBit) % 2 := by
    change (d &&& (2^39))/2^39 = _
    rw [Nat.and_div_two_pow, Nat.div_self (by decide : 0 < 2^39), Nat.and_one_is_mod]
  have hm : (d &&& guardBit)%guardBit = 0 := by
    change (d &&& (2^39)) % 2^39 = 0
    rw [Nat.and_mod_two_pow, Nat.mod_self, Nat.and_zero]
  change d &&& guardBit = _
  dsimp [d] at hd hm ⊢
  split <;> simp only [guardBit] at * <;> omega

private theorem laneSub_digits {f g : ℕ → ℕ} {n : ℕ}
    (hf : ∀ i < n, f i < guardBit) (hg : ∀ i < n, g i < guardBit) :
    digits (fun i => f i-g i) n = laneSub n (digits f n) (digits g n) := by
  let d := fun i => guardBit+f i-g i
  let flag := fun i => if g i ≤ f i then 1 else 0
  have hv i (hi : i < n) : d i < radix := by dsimp only [d]; have := hf i hi; simp only [radix, guardBit] at *; omega
  have hD : digits d n = guardBit*units n + digits f n - digits g n := by
    unfold d
    rw [digits_sub (f := fun i => guardBit+f i) (g := g) (n := n) (fun i hi => by have := hg i hi; omega), digits_add, digits_const]
  have hF : (digits d n &&& (guardBit*units n)) = guardBit*digits flag n := by
    rw [← digits_const, ← digits_and (g := fun _ => guardBit) hv (fun _ _ => by decide), ← digits_mul]
    exact digits_congr (fun i hi => guarded_bit (hf i hi) (hg i hi))
  have hM : digits (fun i => (guardBit-1)*flag i) n = (guardBit-1)*digits flag n :=
    digits_mul _ _ _
  simp only [laneSub, ← hD, hF]
  change _ = digits d n &&& ((guardBit*digits flag n) - (guardBit*digits flag n)/guardBit)
  rw [show guardBit*digits flag n - guardBit*digits flag n/guardBit =
    (guardBit-1)*digits flag n by simp only [guardBit]; omega, ← hM, ← digits_and (g := fun i => (guardBit-1)*flag i) hv (by
      intro i hi
      dsimp [flag]
      split <;> decide)]
  apply digits_congr
  intro i hi
  have hfi := hf i hi
  dsimp [flag,d]
  split
  · simp only [Nat.mul_one]
    change _ = _ &&& (2^39-1)
    rw [Nat.and_two_pow_sub_one_eq_mod]
    change _ = _ % guardBit
    simp only [guardBit] at *
    omega
  · simp only [Nat.mul_zero, Nat.and_zero]
    omega

-- Since the radix is 1 modulo radix-1, this remainder adds the digits.
-- sumChecked proves that the scalar total fits below the modulus.
private theorem digits_mod (f : ℕ → ℕ) (n : ℕ) :
    digits f n % (radix-1) = rangeSum f n % (radix-1) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [digits, rangeSum]
    rw [Nat.add_mod, Nat.mul_mod, ih]
    change ((rangeSum f n % (radix-1) * 1) % (radix-1) + f n % (radix-1)) % (radix-1) = _
    simp only [Nat.mul_one, Nat.mod_mod]
    rw [← Nat.add_mod]

private theorem digits_append (f : ℕ → ℕ) (a b : ℕ) :
    digits f (a+b) = digits f a * radix^b + digits (fun i => f (a+i)) b := by
  induction b with
  | zero => simp [digits]
  | succ b ih =>
    change digits f (a+b)*radix + f (a+b) = _
    rw [ih, pow_succ, digits]
    ring

private theorem digits_lt {f : ℕ → ℕ} {n : ℕ} (h : ∀ i < n, f i < radix) :
    digits f n < radix^n := by
  induction n with
  | zero => simp [digits]
  | succ n ih =>
    rw [digits, pow_succ]
    have := ih (fun i hi => h i (by omega))
    have := h n (by omega)
    simp only [radix] at *
    omega

private theorem digits_window (f : ℕ → ℕ) (lo n pad : ℕ) (h : ∀ i, f i < radix) :
    (digits f (lo+n+pad) / radix^pad) % radix^n = digits (fun i => f (lo+i)) n := by
  rw [digits_append f (lo+n) pad, Nat.mul_comm (digits f (lo+n)), Nat.mul_add_div (by positivity),
    Nat.div_eq_of_lt (digits_lt (fun i _ => h ((lo+n)+i))), Nat.add_zero,
    digits_append, Nat.mul_add_mod', Nat.mod_eq_of_lt (digits_lt (fun i _ => h (lo+i)))]

-- In a residue table, the last (least significant) digit is f(residue).
-- Multiplication appends zero digits for values below the origin.
private def sliceTable (table : ℕ → ℕ) (step a n : ℕ) :=
  let data := table (a%step) <<< (40*283)
  (data >>> (40*(283+a/step+1-n))) &&& ((1 <<< (40*n))-1)

private theorem slice_arith (table : ℕ → ℕ) (step a n : ℕ) :
    sliceTable table step a n = (table (a%step)*radix^283 / radix^(283+a/step+1-n)) % radix^n := by
  have powers (i : ℕ) : (2 : ℕ)^(40*i) = radix^i := (pow_mul 2 40 i).trans (congrArg (· ^ i) (by decide : (2 : ℕ)^40 = radix))
  simp only [sliceTable, Nat.shiftLeft_eq, Nat.one_mul, Nat.shiftRight_eq_div_pow,
    Nat.and_two_pow_sub_one_eq_mod]
  simp only [powers]

private theorem sliceTable_spec (f table : ℕ → ℕ) (step top a n : ℕ)
    (hs : 0 < step) (ha : a/step ≤ top) (hn : n ≤ 283) (h0 : f 0 = 0)
    (hb : ∀ x ≤ (step-1)+step*top, f x < radix)
    (he : ∀ r < step, table r = digits (fun i => f (r+step*top-step*i)) (top+1)) :
    digits (fun i => f (a-step*i)) n = sliceTable table step a n := by
  let r := a%step
  let q := a/step
  let lo := top-q
  let g := fun i => f (r+step*top-step*i)
  have hr : r < step := Nat.mod_lt a hs
  have hq : r+step*q = a := Nat.mod_add_div a step
  have hg i : g i < radix := hb _ (by omega)
  have hz : digits (fun i => g (top+1+i)) 283 = 0 := by
    have hEq : digits (fun i => g (top+1+i)) 283 = digits (fun _ => 0) 283 := by
      apply digits_congr
      intro i _
      dsimp [g]
      rw [Nat.mul_add, Nat.mul_add, Nat.mul_one, show r+step*top-(step*top+step+step*i) = 0 by omega, h0]
    rw [hEq, digits_const, Nat.zero_mul]
  have hval : digits g (top+1+283) = table r * radix^283 := by
    rw [digits_append, hz, Nat.add_zero, he r hr]
  have hl : lo+q=top := by dsimp [lo,q]; omega
  have hm : step*lo+step*q=step*top := by rw [← Nat.mul_add, hl]
  have hoff (i : ℕ) : r+step*top-step*(lo+i) = a-step*i := by
    rw [Nat.mul_add]
    omega
  have hpad : n ≤ 283+q+1 := Nat.le_add_right_of_le (Nat.le_add_right_of_le hn)
  have hsize : lo+n+(283+q+1-n) = top+1+283 := by
    rw [Nat.add_assoc lo n, Nat.add_sub_of_le hpad, ← hl]
    ac_rfl
  have hw := digits_window g lo n (283+q+1-n) hg
  rw [hsize, hval] at hw
  rw [slice_arith]
  change _ = (table r * radix^283 / radix^(283+q+1-n)) % radix^n
  rw [hw]
  exact digits_congr (fun i _ => by dsimp [g]; rw [hoff])

