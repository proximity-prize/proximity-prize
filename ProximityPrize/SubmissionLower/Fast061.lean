    rangeSum (fun k => formula natDen threeDen t (start+k)) n = packedSum t start n := by
  have c := constChecked n (natDen 1651)
  have z := tableChecked natDen tabD1 1 1651 (1650) start n (by decide) (by omega) hn (by omega) (by decide) rfl @den_bound tabD1_correct
  have h := tableChecked natDen tabD1 1 1651 (1136-t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @den_bound tabD1_correct
  have v := tableChecked natDen tabD4 4 284 (1136-t-3) start n (by decide) (by omega) hn (by omega) (by decide) rfl @den_bound tabD4_correct
  have hc := tableChecked natDen tabD1 1 1651 (1136-t-3*((1139-t)/4)) start n (by decide) (by omega) hn (by omega) (by decide) rfl @den_bound tabD1_correct
  have r := tableChecked threeDen tabS1 1 284 ((1139-t)/4) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS1_correct
  have p := tableChecked threeDen tabS8 8 78 (621-2*t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS8_correct
  have q := tableChecked threeDen tabS5 5 125 (622-2*t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS5_correct
  have x := tableChecked threeDen tabS7 7 89 (622-2*t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS7_correct
  have y := tableChecked threeDen tabS7 7 89 (620-2*t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS7_correct
  have common := addChecked h z
  have ac := addChecked c p
  have bc := addChecked ac q
  have cc := addChecked bc v
  have dc := addChecked common x
  have ec := addChecked dc y
  have chosen := subChecked cc ec (by decide) (by decide)
  have ao := addChecked c hc
  have bo := addChecked ao r
  have orig := subChecked bo common (by decide) (by decide)
  have old := subChecked c z (by decide) (by decide)
  have clipped := minChecked old chosen (by decide) (by decide)
  have result := subChecked clipped orig (by decide) (by decide)
  have hh := sumChecked result (by change n * 125576826 < 1099511627775; omega)
  have align (k : ℕ) : 1136-t-4*(start+k)-3 = 1136-t-3-4*(start+k) := Nat.sub_right_comm _ _ _
  simpa only [formula, packedSum, Nat.one_mul, align, show natDen 1651 = 125576826 by decide +kernel] using hh
