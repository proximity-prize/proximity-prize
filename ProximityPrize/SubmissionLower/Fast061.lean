/-- Factor both rows and retain the residual orders off the high ordinary factors. -/
def c1 : Prop :=
  ∀ (h : ℕ) (rows : Banks) (i : Fin 4) (B : BufferedPair h rows i)
    (r : ℕ), 1 ≤ r → r ≤ reserve i + 1 → Nonempty (ThresholdPair i B.cheap B.layered r)

/-- Clear the abscissa denominators and form the proper ordinary graph pair. -/
def c2 : Prop :=
  ∀ (f : Equation), Irreducible f → 0 < f.natDegree → f.natDegree < p →
    ∃ (g : ClearedEquation) (a : L[X]), IsClearing f g a ∧
      ProperPair (C f) (graphCutter g) ∧
      RowCaps (C f) ⟨0, f.natDegree, 0, ordinarySeedDegree f⟩ ∧
      RowCaps (graphCutter g) ⟨0, f.natDegree, 1, ordinarySeedDegree f⟩

/-- Two residual rows of order k have local intersection length at least k squared. -/
def c3 : Prop :=
  ∀ (P Q : Jet) (q : Surface) (k : ℕ), ProperPair P Q → Parent q → 0 < k →
    OrderAt q P k → OrderAt q Q k → (k : ℕ∞)^2 ≤ intersectionLength q P Q

/-- Slice the affine proper intersection cycle, retaining its local multiplicities. -/
def c4 : Prop :=
  ∀ (P Q : Jet), ProperPair P Q → ∀ (qs : Finset Surface) (n : ℕ), 0 < n →
    (∀ q ∈ qs, Parent q ∧ (n : ℕ∞) ≤ intersectionLength q P Q) →
    ∀ s : Slice, s ≠ .jets → (n : ℚ) * mass qs s ≤ pairSectionDegree P Q s

/-- Affine section lengths of any proper pair with the two given row shapes. -/
def c5 : Prop :=
  ∀ (s t : Shape) (P Q : Jet), ProperPair P Q →
    RowCaps P s → RowCaps Q t → s.J ≤ s.B → t.J ≤ t.B →
    (pairSectionDegree P Q .seed : ℚ) ≤ residualSeed s t ∧
    (pairSectionDegree P Q .ordinate : ℚ) ≤ residualOrdinate s t ∧
    (pairSectionDegree P Q .mixed : ℚ) ≤ residualMixed s t

private theorem mass_mono {A B : Finset Surface} (h : A ⊆ B) (s : Slice) :
    mass A s ≤ mass B s :=
  Finset.sum_le_sum_of_subset_of_nonneg h (fun _ _ _ => Nat.cast_nonneg _)

private theorem mass_union (A B : Finset Surface) (s : Slice) :
    mass (A ∪ B) s ≤ mass A s + mass B s := by
  have hs : (A ∪ B) \ A ⊆ B := by
    intro q hq
    obtain ⟨hq, hqA⟩ := Finset.mem_sdiff.mp hq
    exact (Finset.mem_union.mp hq).resolve_left hqA
  linarith only [mass_sdiff (Finset.subset_union_left (s₁ := A) (s₂ := B)) s, mass_mono hs s]

private theorem mass_biUnion {ι : Type*} (I : Finset ι) (T : ι → Finset Surface) (s : Slice) :
    mass (I.biUnion T) s ≤ ∑ f ∈ I, mass (T f) s := by
  classical
  induction I using Finset.induction_on with
  | empty => simp [mass]
  | @insert f I hf ih =>
    rw [Finset.biUnion_insert, Finset.sum_insert hf]
    exact (mass_union (T f) (I.biUnion T) s).trans (add_le_add le_rfl ih)

/-- One factor can pay at most its own contribution to each degree budget. -/
private theorem heavy_mass {I : Finset Equation} (T : Equation → Finset Surface)
    {u b : ℚ}
    (hu : (∑ f ∈ I, (ordinarySeedDegree f : ℚ)) ≤ u)
    (hb : (∑ f ∈ I, (f.natDegree : ℚ)) ≤ b)
    (h : ∀ f ∈ I, MassCap (T f) f.natDegree (ordinarySeedDegree f)
      (2 * (ordinarySeedDegree f : ℚ) * f.natDegree)) :
    MassCap (I.biUnion T) b u (2*b*u) := by
  have hb₀ : 0 ≤ b := (Finset.sum_nonneg (fun _ _ => Nat.cast_nonneg _)).trans hb
  refine ⟨(mass_biUnion I T .seed).trans
    ((Finset.sum_le_sum (fun f hf => (h f hf).seed)).trans hb),
    (mass_biUnion I T .ordinate).trans
    ((Finset.sum_le_sum (fun f hf => (h f hf).ordinate)).trans hu), ?_⟩
  calc
    mass _ .mixed ≤ ∑ f ∈ I, mass (T f) .mixed := mass_biUnion I T .mixed
    _ ≤ ∑ f ∈ I, (2*b) * ordinarySeedDegree f := by
      apply Finset.sum_le_sum
      intro f hf
      have hb' : (f.natDegree : ℚ) ≤ b :=
        (Finset.single_le_sum (fun g _ => Nat.cast_nonneg g.natDegree) hf).trans hb
      exact (h f hf).mixed.trans (by
        calc
          2 * (ordinarySeedDegree f : ℚ) * f.natDegree ≤
              2 * (ordinarySeedDegree f : ℚ) * b := by gcongr
          _ = _ := by ring)
    _ = (2*b) * (∑ f ∈ I, (ordinarySeedDegree f : ℚ)) := (Finset.mul_sum ..).symm
    _ ≤ 2*b*u := by gcongr

private theorem threshold_cap (h1 : c1) (h2 : c2) (h3 : c3) (h4 : c4) (h5 : c5)
    {h : ℕ} {rows : Banks} {i : Fin 4} (B : BufferedPair h rows i) (qs : Finset Surface)
    (hall : ∀ q ∈ qs, Parent q ∧ Compatible B.cheap B.layered q ∧
      OrderAt q B.cheap (reserve i + 1) ∧ OrderAt q B.layered (reserve i + 1))
