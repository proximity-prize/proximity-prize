-- Matching forces the kernel to put a reused arithmetic argument in numeral form.
private def bindNatF (x : Nat) (f : Nat → Nat) : Nat :=
  match x with
  | 0 => f (nat_lit 0)
  | n + 1 => f (Nat.succ n)

private theorem bindNatF_eq (x : Nat) (f : Nat → Nat) : bindNatF x f = f x := by
  cases x <;> rfl

private def clippedF (a b : Nat) := Nat.sub a (Nat.sub a b)

private theorem clippedF_eq (a b : Nat) : clippedF a b = min a b := by
  change a - (a - b) = min a b
  omega

private theorem bltF_eq (a b : Nat) : Nat.blt a b = decide (a < b) := by
  apply Bool.eq_iff_iff.mpr
  simp

private def threeDenF (u : Nat) := denFast u + denFast (u-1) + denFast (u-2)

-- Each base-2^32 digit stores the corresponding denFast value.
private def denPackedF : Nat := 

private def denEntryF (u : Nat) : Nat :=
  Nat.land (Nat.shiftRight denPackedF (Nat.mul u 32)) 0xffffffff

private theorem denCheckF :
    (List.range 1652).all (fun u => denEntryF u == denFast u) = true := by decide +kernel

private def denLookupF (u : Nat) : Nat :=
  bif Nat.blt u (nat_lit 1652) then denEntryF u else denFast u

private theorem denLookupF_eq (u : Nat) : denLookupF u = denFast u := by
  unfold denLookupF
  simp only [cond_eq_ite, Nat.blt_eq]
  split
  · rename_i h
    exact eq_of_beq (List.all_eq_true.mp denCheckF u (List.mem_range.mpr h))
  · rfl

-- Each digit stores the sum of three consecutive denFast values.
private def threePackedF : Nat := 

private def threeEntryF (u : Nat) : Nat :=
  Nat.land (Nat.shiftRight threePackedF (Nat.mul u 32)) 0xffffffff

private theorem threeCheckF :
    (List.range 271).all (fun u => threeEntryF u == threeDenF u) = true := by decide +kernel

private def threeLookupF (u : Nat) : Nat :=
  bif Nat.blt u (nat_lit 271) then threeEntryF u else threeDenF u

private theorem threeLookupF_eq (u : Nat) : threeLookupF u = threeDenF u := by
  unfold threeLookupF
  simp only [cond_eq_ite, Nat.blt_eq]
  split
  · rename_i h
    exact eq_of_beq (List.all_eq_true.mp threeCheckF u (List.mem_range.mpr h))
  · rfl

-- For u ≤ 2*d+1 the three positive correction terms in cumFast vanish.
private def cumF (d u : Nat) : Nat :=
  bif Nat.ble u (Nat.add d (nat_lit 1)) then denLookupF u
  else bif Nat.ble u (Nat.add (Nat.mul (nat_lit 2) d) (nat_lit 1)) then
    Nat.sub (denLookupF u) (threeLookupF (Nat.sub u (Nat.add d (nat_lit 1))))
  else cumFast d u

private theorem cumF_eq (d u : Nat) : cumF d u = cumFast d u := by
  unfold cumF
  simp only [cond_eq_ite, Nat.ble_eq]
  change (if u ≤ d+1 then _ else if u ≤ 2*d+1 then _ else _) = _
  by_cases h : u ≤ d+1
  · simp [cumFast, h, denLookupF_eq]
  rw [ite_eq_right h]
  split
  · rename_i h'
    have h₀ : min u (3*d+1) = u := min_eq_left (by omega)
    have h₁ : u-(2*d+3) = 0 := by omega
    have h₂ : u-(2*d+4) = 0 := by omega
    have h₃ : u-(2*d+5) = 0 := by omega
    have h₄ : u-(d+2) = u-(d+1)-1 := by omega
    have h₅ : u-(d+3) = u-(d+1)-2 := by omega
    simp [cumFast, h, h₀, h₁, h₂, h₃, h₄, h₅, denLookupF_eq, threeLookupF_eq,
      threeDenF, show denFast 0 = 0 by rfl]
  · rfl

private def cutF (d u r : Nat) : Nat :=
  bif Nat.blt d r then 0 else cumF (Nat.sub d r) u

private theorem cutF_eq (d u r : Nat) : cutF d u r = cutFast d u r := by
  simp [cutF, cutFast, cumF_eq, cond_eq_ite]

-- This follows certifiedSaving with primitive natural-number operations.
private def savingF (s j packed : Nat) : Nat :=
  bindNatF (Nat.mod packed (nat_lit 512)) fun a =>
  bindNatF (Nat.mod (Nat.div packed (nat_lit 512)) (nat_lit 512)) fun b =>
  bindNatF (Nat.mod (Nat.div packed (nat_lit 262144)) (nat_lit 1024)) fun c =>
  bif (Nat.blt (nat_lit 1650) (Nat.add (Nat.add a b) (Nat.mul (nat_lit 3) c))) ||
      (Nat.blt (nat_lit 550) (Nat.add b c)) ||
      (Nat.blt (Nat.add j (nat_lit 1)) c) ||
      (Nat.blt (nat_lit 4649) (Nat.add (Nat.add s a) (Nat.mul (nat_lit 4) c))) then 0 else
  bindNatF (Nat.sub (nat_lit 1650) (Nat.add (Nat.add a b) (Nat.mul (nat_lit 3) c))) fun d =>
  bindNatF (Nat.sub (nat_lit 1650) (Nat.add (Nat.add j (Nat.mul (nat_lit 3) b)) (Nat.mul (nat_lit 2) c))) fun l =>
  bindNatF (Nat.sub (nat_lit 1651) (Nat.mul (nat_lit 3) (Nat.add b c))) fun u =>
  bindNatF (Nat.sub (nat_lit 4650) (Nat.add (Nat.add (Nat.add s j) (Nat.mul (nat_lit 2) b)) (Nat.mul (nat_lit 3) c))) fun o =>
  bindNatF (Nat.add (clippedF d (Nat.div (Nat.sub (nat_lit 4649) (Nat.add (Nat.add s a) (Nat.mul (nat_lit 4) c))) (nat_lit 4))) (nat_lit 1)) fun r =>
  let k := Nat.sub
    (Nat.add (cumF d u) (cutF d (Nat.sub o (Nat.mul (nat_lit 3) r)) r))
    (Nat.add (cumF d o) (cutF d l r))
  bindNatF (Nat.sub (nat_lit 4650) (Nat.add s j)) fun io =>
  bindNatF (Nat.add (Nat.div (Nat.sub (nat_lit 4649) s) (nat_lit 4)) (nat_lit 1)) fun ir =>
  let ik := Nat.sub
    (Nat.add (nat_lit 125576826) (cutF (nat_lit 1650) (Nat.sub io (Nat.mul (nat_lit 3) ir)) ir))
    (Nat.add (denLookupF io) (cutF (nat_lit 1650) (Nat.sub (nat_lit 1650) j) ir))
