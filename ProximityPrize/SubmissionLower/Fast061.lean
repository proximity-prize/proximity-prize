private def auxLDen (n : ℕ) : ℕ := (n * (n * (2 * n + 15) + 30) + 25) / 72
private theorem auxLDen_correct (n : ℕ) : auxLDen n = denFast n := by
  apply Int.ofNat_inj.mp
  rw [denFast_correct, ← fastDen_eq]
  cases n with
  | zero => decide
  | succ n =>
    simp only [auxLDen, Nat.cast_succ, Nat.cast_mul,
      Int.natCast_ediv, add_sub_cancel_right, fastDen, Int.natCast_nonneg,
      not_lt_of_ge, ite_false]
    congr 1; ring
private def auxLTriple (x : ℕ) : ℕ := (x * (2*x+5) * (x+2) + 3) / 24
private theorem auxLDen_period (n : ℕ) :
    auxLDen (n+12) = auxLDen n + (n*n + 17*n + 83) := by
  unfold auxLDen
  rw [show (n+12) * ((n+12) * (2*(n+12)+15)+30)+25 =
    (n*(n*(2*n+15)+30)+25) + 72*(n*n+17*n+83) by ring]
  exact Nat.add_mul_div_left _ _ (by decide)
private theorem auxLTriple_period (n : ℕ) :
    auxLTriple (n+12) = auxLTriple n + (3*n*n + 45*n + 203) := by
  unfold auxLTriple
  rw [show (n+12)*(2*(n+12)+5)*(n+12+2)+3 =
    (n*(2*n+5)*(n+2)+3) + 24*(3*n*n+45*n+203) by ring]
  exact Nat.add_mul_div_left _ _ (by decide)
private theorem auxLTriple_correct (x : ℕ) :
    auxLTriple x = auxLDen x + auxLDen (x-1) + auxLDen (x-2) := by
  have step (k : ℕ) : auxLTriple (k+2) = auxLDen (k+2) + auxLDen (k+1) + auxLDen k := by
    induction k using Nat.strong_induction_on with
    | h k ih =>
      by_cases hk : k < 12
      · interval_cases k <;> decide
      · let n := k-12
        have hn : n < k := by dsimp [n]; omega
        have he : k = n+12 := by dsimp [n]; omega
        have h := ih n hn
        rw [he, show n+12+2 = (n+2)+12 by omega, show n+12+1 = (n+1)+12 by omega,
          auxLTriple_period, auxLDen_period, auxLDen_period, auxLDen_period, h]
        ring
  match x with
  | 0 | 1 => decide
  | k+2 => simpa using step k
private def auxLCum (d n : ℕ) : ℕ :=
  if n ≤ d+1 then auxLDen n else
    let v := min n (3*d+1)
    (auxLDen v + auxLTriple (v-(2*d+3))) - auxLTriple (v-(d+1))
private theorem auxLCum_correct (d n : ℕ) : auxLCum d n = cumFast d n := by
  unfold auxLCum cumFast
  split
  · apply auxLDen_correct
  · simp only [auxLTriple_correct, auxLDen_correct, Nat.sub_sub, Nat.add_assoc]
private def auxLKernel (d lo hi ord r : ℕ) : ℕ :=
  let cut := fun n => if d < r then 0 else auxLCum (d-r) n
  (auxLCum d hi + cut (ord-3*r)) - (auxLCum d ord + cut lo)
private theorem auxLKernel_eq (d lo hi ord r : ℕ) :
    auxLKernel d lo hi ord r = kFast d lo hi ord r := by
  simp only [auxLKernel, kFast, cutFast, auxLCum_correct]
private def auxLPoint (s j a b c : ℕ) : ℕ :=
  let d := 1650-(a+b+3*c)
  auxLKernel d (1650-(j+3*b+2*c)) (1651-3*(b+c)) (4650-(s+j+2*b+3*c))
    (min d ((4649-(s+a+4*c))/4)+1)
private theorem auxLPoint_correct (s j a b c : ℕ)
    (hd : a+b+3*c ≤ 1650) (hc : b+c ≤ 550) (hl : c ≤ j+1) (hb : s+a+4*c ≤ 4649) :
    auxLPoint s j a b c = (fastKernel
      (1650 - ((a : ℤ)+b+3*c)) (1650-j-(3*(b : ℤ)+2*c))
      (550-((b : ℤ)+c)) (4650-s-j-(2*(b : ℤ)+3*c))).toNat := by
  let F : Flag := ⟨1650 - ((a : ℤ)+b+3*c),1650-j-(3*(b : ℤ)+2*c),
    3*(550-((b : ℤ)+c)),550-((b : ℤ)+c),4650-s-j-(2*(b : ℤ)+3*c)⟩
  rw [fastKernel_eq]
  change auxLPoint s j a b c = (kernelLower F).toNat
  unfold auxLPoint
  rw [auxLKernel_eq]
  have hlo : 1650-(j+3*b+2*c) = F.lower.toNat := by dsimp [F]; omega
  have ho : 4650-(s+j+2*b+3*c) = F.order.toNat := by dsimp [F]; omega
  rw [hlo, ho]
  apply kFast_correct
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [F]; omega
  · dsimp [balance,F]; omega
  · have hbal : balance F = 4649 - ((s : ℤ)+a+4*c) := by dsimp [balance,F]; ring
    rw [hbal]
    simp only [Nat.cast_add, Nat.cast_one, Nat.cast_min, Int.natCast_ediv, Nat.cast_ofNat,
      Int.ofNat_sub hd, Int.ofNat_sub hb, Nat.cast_mul, F]
private theorem auxLFull (j : ℕ) :
    (fastOld 1650 (1650-j) 550).toNat = 125576826 - auxLDen (1650-j) := by
  have hu : min (3*(550 : ℤ)) (1650 - j - 1) = 1650-j-1 := min_eq_right (by omega)
  have hC := cumFast_clipped 1650 (1650-j)
  have hN : ((1650 : ℤ)-j).toNat = 1650-j := by omega
  rw [hN, cumFast, ite_eq_left (by omega)] at hC
  have hLo : fastC 1650 (min (3*550) (1650-j-1)) = (denFast (1650-j) : ℤ) := by
    rw [hu, fastC_eq]
    exact hC.symm
  have hHi : fastC 1650 (3*550) = 125576826 := by decide
  rw [fastOld, hLo, hHi, auxLDen_correct]
  exact Int.toNat_sub 125576826 _
private theorem auxLArithmetic (full initial residual : ℤ) :
    min full.toNat residual.toNat - initial.toNat =
      (full-max 0 initial).toNat - (full-max (max 0 initial) residual).toNat := by
  omega
private theorem auxLSaving_at (s j a b c : ℕ)
    (hd : a+b+3*c ≤ 1650) (hc : b+c ≤ 550) (hl : c ≤ j+1) (hb : s+a+4*c ≤ 4649) :
    min (125576826 - auxLDen (1650-j)) (auxLPoint s j a b c) - auxLPoint s j 0 0 0 =
      blockSaving s j ⟨a,b,c⟩ := by
  have h0 := auxLPoint_correct s j 0 0 0 (by decide) (by decide) (by omega) (by omega)
  simp only [Nat.cast_zero, add_zero, mul_zero, sub_zero] at h0
  rw [auxLPoint_correct s j a b c hd hc hl hb, h0, ← auxLFull, auxLArithmetic]
  rfl
