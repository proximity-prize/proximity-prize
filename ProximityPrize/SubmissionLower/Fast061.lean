private structure Checked (n : ℕ) (f : ℕ → ℕ) (value bound : ℕ) : Prop where
  val_eq : digits f n = value
  bounded : ∀ i < n, f i ≤ bound

private theorem constChecked (n x : ℕ) : Checked n (fun _ => x) (x*units n) x :=
  ⟨digits_const x n, fun _ _ => le_rfl⟩

private theorem addChecked {n a b A B : ℕ} {f g : ℕ → ℕ}
    (x : Checked n f a A) (y : Checked n g b B) :
    Checked n (fun i => f i+g i) (a+b) (A+B) := by
  refine ⟨?_, fun i hi => Nat.add_le_add (x.bounded i hi) (y.bounded i hi)⟩
  rw [digits_add, x.val_eq, y.val_eq]

private theorem subChecked {n a b A B : ℕ} {f g : ℕ → ℕ}
    (x : Checked n f a A) (y : Checked n g b B) (hA : A < guardBit) (hB : B < guardBit) :
    Checked n (fun i => f i-g i) (laneSub n a b) A := by
  refine ⟨?_, fun i hi => le_trans (Nat.sub_le _ _) (x.bounded i hi)⟩
  rw [laneSub_digits (fun i hi => lt_of_le_of_lt (x.bounded i hi) hA)
    (fun i hi => lt_of_le_of_lt (y.bounded i hi) hB), x.val_eq, y.val_eq]

private theorem minChecked {n a b A B : ℕ} {f g : ℕ → ℕ}
    (x : Checked n f a A) (y : Checked n g b B) (hA : A < guardBit) (hB : B < guardBit) :
    Checked n (fun i => Nat.min (f i) (g i)) (a - laneSub n a b) A := by
  have hd := subChecked x y hA hB
  refine ⟨?_, fun i hi => le_trans (min_le_left _ _) (x.bounded i hi)⟩
  calc
    _ = digits (fun i => f i-(f i-g i)) n := digits_congr (fun i _ => by
      change min (f i) (g i) = _; omega)
    _ = _ := by rw [digits_sub (fun _ _ => Nat.sub_le _ _), hd.val_eq, x.val_eq]

private theorem sum_bound {n bound : ℕ} {f : ℕ → ℕ} (h : ∀ i < n, f i ≤ bound) :
    rangeSum f n ≤ n*bound := by
  induction n with
  | zero => simp [rangeSum]
  | succ n ih =>
    rw [rangeSum, Nat.succ_mul]
    exact Nat.add_le_add (ih (fun i hi => h i (by omega))) (h n (by omega))

private theorem sumChecked {n a A : ℕ} {f : ℕ → ℕ} (x : Checked n f a A)
    (h : n*A < radix-1) : rangeSum f n = a % (radix-1) := by
  rw [← x.val_eq, digits_mod, Nat.mod_eq_of_lt (lt_of_le_of_lt (sum_bound x.bounded) h)]

private theorem denBoundSmall {x : ℕ} (hx : x < 1664) : natDen x ≤ 200000000 := by
  cases x with
  | zero => decide
  | succ u =>
    change u*(u*(2*u+21)+66)/72+1 ≤ _
    calc
      _ ≤ 1664*(1664*(2*1664+21)+66)/72+1 := by gcongr <;> omega
      _ ≤ _ := by decide

private theorem den_bound {x : ℕ} (hx : x < 1664) : natDen x ≤ 2000000000 :=
  le_trans (denBoundSmall hx) (by decide)

private theorem triple_bound {x : ℕ} (hx : x < 1664) : threeDen x ≤ 2000000000 := by
  have h1 := denBoundSmall (x := x-1) (by omega)
  have h2 := denBoundSmall (x := x-2) (by omega)
  have h3 := denBoundSmall (x := x-3) (by omega)
  unfold threeDen
  omega

private theorem tableChecked (f table : ℕ → ℕ) (step top base start n : ℕ)
    (hs : 0 < step) (ha : (base-step*start)/step ≤ top) (hn : n ≤ 283)
    (hbase : base < 1664) (htop : step-1+step*top < 1664) (h0 : f 0 = 0)
    (hb : ∀ {x}, x < 1664 → f x ≤ 2000000000)
    (he : ∀ r < step, table r = digits (fun i => f (r+step*top-step*i)) (top+1)) :
    Checked n (fun i => f (base-step*(start+i))) (sliceTable table step (base-step*start) n) 2000000000 := by
  refine ⟨?_, fun i _ => hb (by omega)⟩
  calc
    _ = digits (fun i => f ((base-step*start)-step*i)) n :=
      digits_congr (fun i _ => by rw [Nat.mul_add, Nat.sub_sub])
    _ = _ := sliceTable_spec f table step top _ n hs ha hn h0 (fun x hx => by have := hb (lt_of_le_of_lt hx htop); unfold radix; omega) he

-- Apply the same formula to all active offsets in the row. Each lookup
-- returns consecutive radix digits of one of the certified residue tables.
private def packedSum (t start n : ℕ) :=
  let c := 125576826 * units n
  let z := sliceTable tabD1 1 ((1650)-1*start) n
  let h := sliceTable tabD1 1 ((1136-t)-1*start) n
  let v := sliceTable tabD4 4 ((1136-t-3)-4*start) n
  let hc := sliceTable tabD1 1 ((1136-t-3*((1139-t)/4))-1*start) n
  let r := sliceTable tabS1 1 (((1139-t)/4)-1*start) n
  let p := sliceTable tabS8 8 ((621-2*t)-8*start) n
  let q := sliceTable tabS5 5 ((622-2*t)-5*start) n
  let x := sliceTable tabS7 7 ((622-2*t)-7*start) n
  let y := sliceTable tabS7 7 ((620-2*t)-7*start) n
  let common := h + z
  let ac := c + p
  let bc := ac + q
  let cc := bc + v
  let dc := common + x
  let ec := dc + y
  let chosen := laneSub n cc ec
  let ao := c + hc
  let bo := ao + r
  let orig := laneSub n bo common
  let old := laneSub n c z
  let clipped := old - laneSub n old chosen
  let result := laneSub n clipped orig
  result % (radix-1)

private theorem packedSum_spec (t start n : ℕ) (hn : n ≤ 283) :
    rangeSum (fun k => formula natDen threeDen t (start+k)) n = packedSum t start n := by
  have c := constChecked n (natDen 1651)
  have z := tableChecked natDen tabD1 1 1651 (1650) start n (by decide) (by omega) hn (by omega) (by decide) rfl @den_bound tabD1_correct
  have h := tableChecked natDen tabD1 1 1651 (1136-t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @den_bound tabD1_correct
  have v := tableChecked natDen tabD4 4 284 (1136-t-3) start n (by decide) (by omega) hn (by omega) (by decide) rfl @den_bound tabD4_correct
  have hc := tableChecked natDen tabD1 1 1651 (1136-t-3*((1139-t)/4)) start n (by decide) (by omega) hn (by omega) (by decide) rfl @den_bound tabD1_correct
  have r := tableChecked threeDen tabS1 1 284 ((1139-t)/4) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS1_correct
  have p := tableChecked threeDen tabS8 8 78 (621-2*t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS8_correct
  have q := tableChecked threeDen tabS5 5 125 (622-2*t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS5_correct
  have x := tableChecked threeDen tabS7 7 89 (622-2*t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS7_correct
  have y := tableChecked threeDen tabS7 7 89 (620-2*t) start n (by decide) (by omega) hn (by omega) (by decide) rfl @triple_bound tabS7_correct
  have common := addChecked h z
  have ac := addChecked c p
  have bc := addChecked ac q
  have cc := addChecked bc v
  have dc := addChecked common x
  have ec := addChecked dc y
  have chosen := subChecked cc ec (by decide) (by decide)
  have ao := addChecked c hc
  have bo := addChecked ao r
  have orig := subChecked bo common (by decide) (by decide)
  have old := subChecked c z (by decide) (by decide)
  have clipped := minChecked old chosen (by decide) (by decide)
  have result := subChecked clipped orig (by decide) (by decide)
  have hh := sumChecked result (by change n * 125576826 < 1099511627775; omega)
  have align (k : ℕ) : 1136-t-4*(start+k)-3 = 1136-t-3-4*(start+k) := Nat.sub_right_comm _ _ _
  simpa only [formula, packedSum, Nat.one_mul, align, show natDen 1651 = 125576826 by decide +kernel] using hh

private def packedGrade (t : ℕ) :=
  rangeSum (natEntry t) (firstOffset t) + packedSum t (firstOffset t) (activeEnd t - firstOffset t)

private theorem packedChunk {lo len : ℕ} (h : lo+len ≤ 499) :
    natChunk lo len = rangeSum (fun k => packedGrade (lo+k)) len := by
  apply sum_ext
  intro k hk
  rw [grade_formula (show lo+k < 499 by omega)]
  unfold shortGrade packedGrade
