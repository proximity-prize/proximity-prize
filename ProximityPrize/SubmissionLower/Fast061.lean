    intro k hk
    unfold natEntry
    split
    · rename_i h
      rw [ite_eq_right]
      dsimp [b,activeEnd] at *
      omega
    · rfl
  change rangeSum (natEntry t) 283 = _
  calc
    _ = rangeSum (natEntry t) b + rangeSum (fun k => natEntry t (b+k)) (283-b) := by
      rw [← sum_split, show b+(283-b)=283 by omega]
    _ = rangeSum (natEntry t) b := by rw [sum_zero hz, Nat.add_zero]
    _ = rangeSum (natEntry t) a + rangeSum (fun k => natEntry t (a+k)) (b-a) := by
      rw [← sum_split, show a+(b-a)=b by omega]
