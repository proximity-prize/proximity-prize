private theorem savingF_eq (s j p : Nat) : savingF s j p = certifiedSaving s j (unpack p) := by
  unfold savingF certifiedSaving
  simp only [bindNatF_eq]
  dsimp only [unpack]
  simp only [originalK, kFast, cutF_eq, cumF_eq, denLookupF_eq,
    bltF_eq, cond_eq_ite, clippedF_eq]
