private theorem slice_arith (table : ℕ → ℕ) (step a n : ℕ) :
    sliceTable table step a n = (table (a%step)*radix^283 / radix^(283+a/step+1-n)) % radix^n := by
  have powers (i : ℕ) : (2 : ℕ)^(40*i) = radix^i := (pow_mul 2 40 i).trans (congrArg (· ^ i) (by decide : (2 : ℕ)^40 = radix))
  simp only [sliceTable, Nat.shiftLeft_eq, Nat.one_mul, Nat.shiftRight_eq_div_pow,
    Nat.and_two_pow_sub_one_eq_mod]
  simp only [powers]
private theorem sliceTable_spec (f table : ℕ → ℕ) (step top a n : ℕ)
    (hs : 0 < step) (ha : a/step ≤ top) (hn : n ≤ 283) (h0 : f 0 = 0)
    (hb : ∀ x ≤ (step-1)+step*top, f x < radix)
    (he : ∀ r < step, table r = digits (fun i => f (r+step*top-step*i)) (top+1)) :
    digits (fun i => f (a-step*i)) n = sliceTable table step a n := by
