private def auxLCumOpt (d n : ℕ) : ℕ :=
  auxLBind n fun n =>
    bif Nat.ble n (Nat.add d 1) then auxLDenPrim n else
    auxLBind (auxLMin n (Nat.add (Nat.mul 3 d) 1)) fun v =>
      Nat.sub (Nat.add (auxLDenPrim v) (auxLTriplePrim (Nat.sub v (Nat.add (Nat.mul 2 d) 3))))
        (auxLTriplePrim (Nat.sub v (Nat.add d 1)))
private theorem auxLCumOpt_eq (d n : ℕ) : auxLCumOpt d n = auxLCum d n := by
  simp only [auxLCumOpt, auxLBind_eq, auxLMin_eq]
  unfold auxLCum
  cases h : Nat.ble n (Nat.add d 1) with
  | true =>
    rw [Bool.cond_true, ite_eq_left (Nat.le_of_ble_eq_true h)]
    rfl
  | false =>
    have hn : ¬n ≤ d+1 := fun hp => Bool.noConfusion (h.symm.trans (Nat.ble_eq_true_of_le hp))
    rw [Bool.cond_false, ite_eq_right hn]
    rfl
private def auxLWithBound {α : Type} (s a b c : ℕ) (use : (ℕ → ℕ) → α) : α :=
  auxLBind (Nat.sub 1650 (Nat.add (Nat.add a b) (Nat.mul 3 c))) fun d =>
  auxLBind (Nat.add (min d (Nat.div (Nat.sub 4649 (Nat.add (Nat.add s a) (Nat.mul 4 c))) 4)) 1) fun r =>
  auxLBind (auxLCumOpt d (Nat.sub 1651 (Nat.mul 3 (Nat.add b c)))) fun hi =>
  auxLBind (Nat.sub 4650 (Nat.add (Nat.add s (Nat.mul 2 b)) (Nat.mul 3 c))) fun ord =>
  auxLBind (Nat.sub 1650 (Nat.add (Nat.mul 3 b) (Nat.mul 2 c))) fun lo =>
  if d < r then use (fun j => Nat.sub hi (auxLCumOpt d (Nat.sub ord j))) else
    auxLBind (Nat.sub d r) fun dr =>
    auxLBind (Nat.mul 3 r) fun r3 =>
    use fun j =>
      let o := Nat.sub ord j
      Nat.sub (Nat.add hi (auxLCumOpt dr (Nat.sub o r3)))
        (Nat.add (auxLCumOpt d o) (auxLCumOpt dr (Nat.sub lo j)))
private def auxLBoundFn (s a b c : ℕ) : ℕ → ℕ := auxLWithBound s a b c id
private theorem auxLWithBound_eq {α : Type} (s a b c : ℕ) (use : (ℕ → ℕ) → α) :
    auxLWithBound s a b c use = use (auxLBoundFn s a b c) := by
  simp only [auxLBoundFn, auxLWithBound, auxLBind_eq, id_eq]
  split <;> rfl
private theorem auxLBoundFn_eq (s a b c j : ℕ) :
    auxLBoundFn s a b c j = auxLPoint s j a b c := by
  simp only [auxLBoundFn, auxLWithBound, auxLBind_eq, id_eq]
  have h₁ : 4650 - (s + 2*b + 3*c) - j = 4650 - (s+j+2*b+3*c) := by omega
  have h₂ : 1650 - (3*b + 2*c) - j = 1650 - (j+3*b+2*c) := by omega
  simp only [auxLCumOpt_eq]
  unfold auxLPoint auxLKernel
  split <;> rename_i h
  · change 1650-(a+b+3*c) < min (1650-(a+b+3*c)) ((4649-(s+a+4*c))/4)+1 at h
    simp only [h, ite_true, Nat.add_zero]
    rw [← h₁]
    rfl
  · change ¬ (1650-(a+b+3*c) < min (1650-(a+b+3*c)) ((4649-(s+a+4*c))/4)+1) at h
    simp only [h, ite_false]
    rw [← h₁, ← h₂]
    rfl
private def auxLWithBase {α : Type} (s : ℕ) (use : (ℕ → ℕ → ℕ) → α) : α :=
  if 3000 ≤ s then
    auxLBind (Nat.add (Nat.div (Nat.sub 4649 s) 4) 1) fun r =>
    auxLBind (Nat.sub 4650 s) fun ord =>
    auxLBind (Nat.mul 3 r) fun r3 =>
    use fun j residual =>
      auxLBind (Nat.sub ord j) fun o =>
      auxLBind (auxLDenPrim (Nat.sub 1650 j)) fun denLo =>
      let init := Nat.sub (Nat.add 125576826 (auxLDenPrim (Nat.sub o r3)))
        (Nat.add (auxLDenPrim o) (Nat.sub denLo (auxLTriplePrim (Nat.sub r (Nat.add j 1)))))
      Nat.sub (auxLMin (Nat.sub 125576826 denLo) residual) init
  else use fun j residual =>
    Nat.sub (auxLMin (Nat.sub 125576826 (auxLDenPrim (Nat.sub 1650 j))) residual)
      (auxLBoundFn s 0 0 0 j)
private def auxLBaseDiscount (s : ℕ) : ℕ → ℕ → ℕ := auxLWithBase s id
private theorem auxLWithBase_eq {α : Type} (s : ℕ) (use : (ℕ → ℕ → ℕ) → α) :
    auxLWithBase s use = use (auxLBaseDiscount s) := by
  simp only [auxLBaseDiscount, auxLWithBase, auxLBind_eq, id_eq]
  split <;> rfl
private theorem auxLInitial_eq (s j : ℕ) (hs : 3000 ≤ s) :
    auxLPoint s j 0 0 0 =
      let r := (4649-s)/4+1
      let o := 4650-s-j
      (125576826 + auxLDen (o-3*r)) -
        (auxLDen o + (auxLDen (1650-j) - auxLTriple (r-(j+1)))) := by
  let r := (4649-s)/4+1
  let o := 4650-s-j
  have hr : r ≤ 413 := by dsimp [r]; omega
  have ho : o ≤ 1650 := by dsimp [o]; omega
  have hmin : min 1650 ((4649-s)/4) = (4649-s)/4 := min_eq_right (by omega)
  have hc (d n : ℕ) (h : n ≤ d+1) : auxLCum d n = auxLDen n := by
    rw [auxLCum, ite_eq_left h]
  have hl : auxLCum (1650-r) (1650-j) = auxLDen (1650-j) - auxLTriple (r-(j+1)) := by
    unfold auxLCum
    split
    · have hz : r-(j+1) = 0 := by omega
      rw [hz, show auxLTriple 0 = 0 by decide, Nat.sub_zero]
    · rw [min_eq_left (by omega)]
      dsimp only
      rw [show (1650-j)-(2*(1650-r)+3) = 0 by omega,
        show auxLTriple 0 = 0 by decide, Nat.add_zero,
        show (1650-j)-((1650-r)+1) = r-(j+1) by omega]
  change auxLKernel 1650 (1650-j) 1651 (4650-(s+j)) (min 1650 ((4649-s)/4)+1) =
    (125576826 + auxLDen (o-3*r)) - (auxLDen o + (auxLDen (1650-j) - auxLTriple (r-(j+1))))
  rw [hmin, show 4650-(s+j) = o by dsimp [o]; omega]
  change auxLKernel 1650 (1650-j) 1651 o r = _
  simp only [auxLKernel, ite_eq_right (show ¬1650 < r by omega)]
  rw [hc _ _ (show o ≤ 1650+1 by omega), hc _ _ (show o-3*r ≤ 1650-r+1 by omega),
    hl, show auxLCum 1650 1651 = 125576826 by decide]
private theorem auxLBaseDiscount_eq (s j residual : ℕ) :
    auxLBaseDiscount s j residual =
      min (125576826 - auxLDen (1650-j)) residual - auxLPoint s j 0 0 0 := by
  simp only [auxLBaseDiscount, auxLWithBase, auxLBind_eq, id_eq]
  split <;> rename_i h
  · dsimp only
    rw [auxLInitial_eq s j h, auxLMin_eq]
    rfl
  · dsimp only
    rw [auxLBoundFn_eq, auxLMin_eq]
    rfl
private def auxLFastRun (s j code : ℕ) (base : ℕ → ℕ → ℕ) : ℕ :=
  if code % 2147483648 = 0 then 0 else
  let a := Nat.mod code 2048
  let b := Nat.mod (Nat.div code 2048) 1024
  let c := Nat.mod (Nat.div code 2097152) 1024
  let n := runLength code
  if 1650 < a+b+3*c || 550 < b+c || j+1 < c || 4649 < s+a+4*c then
    sumFrom (fun u => blockSaving s u (decode code)) j n
  else
    auxLWithBound s a b c fun residual => sumFrom (fun u => base u (residual u)) j n
private def auxLRowCore (s : ℕ) (base : ℕ → ℕ → ℕ) (j : ℕ) : List ℕ → ℕ
  | [] => 0
  | code :: tail =>
    auxLBind j fun j =>
    Nat.add (auxLFastRun s j code base) (auxLRowCore s base (Nat.add j (runLength code)) tail)
private theorem auxLSumCong (f g : ℕ → ℕ) (j n : ℕ)
    (h : ∀ u, j ≤ u → f u = g u) : sumFrom f j n = sumFrom g j n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [sumFrom, ih, h (j+n) (by omega)]
private theorem auxLFastRun_eq (s j code : ℕ) :
    auxLFastRun s j code (auxLBaseDiscount s) = runValue s j code := by
  unfold auxLFastRun runValue
  split
  · rfl
  · dsimp only
    split
    · rfl
    · rename_i h
      simp only [Bool.or_eq_true, decide_eq_true_eq, not_or, not_lt] at h
      obtain ⟨⟨⟨hd,hc⟩,hl⟩,hb⟩ := h
      rw [auxLWithBound_eq]
      apply auxLSumCong
      intro u hu
      rw [auxLBaseDiscount_eq, auxLBoundFn_eq]
      exact auxLSaving_at s u _ _ _ hd hc (hl.trans (Nat.add_le_add_right hu 1)) hb
private def auxLFastRow (s j : ℕ) (row : List ℕ) : ℕ :=
  auxLWithBase s fun base => auxLRowCore s base j row
private theorem auxLFastRow_eq (s j : ℕ) (row : List ℕ) :
    rowValue s j row = auxLFastRow s j row := by
  rw [auxLFastRow, auxLWithBase_eq]
  induction row generalizing j with
  | nil => rfl
  | cons code tail ih =>
    simp only [rowValue, auxLRowCore, auxLBind_eq, auxLFastRun_eq, ih]
    rfl
private theorem auxLCons {s n m : ℕ} {row : List ℕ} {rest : List (List ℕ)}
    (hrow : auxLFastRow s (rowStart s) row = n) (hrest : value (s+1) rest = m) :
    value s (row :: rest) = n+m := by
  rw [value, auxLFastRow_eq, hrow, hrest]
