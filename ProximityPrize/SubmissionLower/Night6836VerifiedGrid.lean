set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
def Good (r e:ℕ) := (dataOK r e=true ∧ checks r e=true) ∧ rounded r e=true
private theorem unpackBlock (r start count e:ℕ) (hb:block r start count=true)
     (lo:start≤e) (hi:e<start+count) : Good r e := by
   have h := List.all_eq_true.mp hb (e-start) (List.mem_range.mpr (by omega))
   simpa only [Good,Nat.add_sub_of_le lo,Bool.and_eq_true_iff] using h
private theorem grid1 (e:ℕ) (ub:e<76) : Good 1 e := by
  by_cases h0:e<9
  · exact unpackBlock _ _ _ _ receiptR1B0 (by omega) (by omega)
  by_cases h9:e<18
  · exact unpackBlock _ _ _ _ receiptR1B9 (by omega) (by omega)
  by_cases h18:e<27
  · exact unpackBlock _ _ _ _ receiptR1B18 (by omega) (by omega)
  by_cases h27:e<36
  · exact unpackBlock _ _ _ _ receiptR1B27 (by omega) (by omega)
  by_cases h36:e<45
  · exact unpackBlock _ _ _ _ receiptR1B36 (by omega) (by omega)
  by_cases h45:e<54
  · exact unpackBlock _ _ _ _ receiptR1B45 (by omega) (by omega)
  by_cases h54:e<63
  · exact unpackBlock _ _ _ _ receiptR1B54 (by omega) (by omega)
  by_cases h63:e<72
  · exact unpackBlock _ _ _ _ receiptR1B63 (by omega) (by omega)
  exact unpackBlock _ _ _ _ receiptR1B72 (by omega) (by omega)
