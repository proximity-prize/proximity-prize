def choose2 (n : Nat) := n*(n-1)/2
def choose3 (n : Nat) := n*(n-1)*(n-2)/6
def channel (t y s : Nat) : Nat :=
  let u:=min t y
  let b:=t+1-u
  let k:=min s u
  let n:=u-k
  let c:=(s+1)*(b+s+1)-(s+1)*s/2
  b*choose2 (k+2)+choose3 (k+2)+n*c+(s+1)*(n*(n-1)/2)
def power (gain dt dy ds t y s : Nat) : Nat → Nat
  | 0 => 0
  | fuel+1 => gain*channel t y s + power gain dt dy ds (t-dt) (y-dy) (s-ds) fuel

def gate (i : Id) (r y t : Nat) : Bool :=
  let b:=numbers i
  decide (power 19228 t y r (b.t-t) (b.y-y) (b.r-r)
    (min (b.t/t) (min (b.y/y) (b.r/r))) < b.gap)
