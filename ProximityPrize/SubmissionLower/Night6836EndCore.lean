def endEntry (r y : Nat) := (entries r)[y-r]?.getD (0,Id.primary)
def endCap (r y : Nat) := (endEntry r y).1

def checkEnd (r y : Nat) : Bool :=
  let e := endEntry r y
  decide (r≤y ∧ y≤e.1+1 ∧ (y=maxY r+1 → e.1+1=y) ∧ sourceGroup e.2<5) &&
    gate e.2 r y (e.1+1)
def checkedRank (r : Nat) : Bool :=
  (List.range (maxY r + 2-r)).all fun k => checkEnd r (k+r)

