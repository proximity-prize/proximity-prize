   (RCN136.VO φ _ he)
 exact DVD F a b s hb hs hR hYR hAll d hd c x u₀ u₁ j hj q hq
theorem BHM {Ω:Type*} [Field Ω]
   (φ:Polynomial K→+*Ω) (F:Poly K) (d:ℕ) (hd:2≤d)
   (c:ℕ→K) (x u₀ u₁:K):
   RCN136.surfaceMap φ (GS F d c x u₀ u₁)=
