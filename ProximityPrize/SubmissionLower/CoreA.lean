  unfold paddedCost
  rw [ACZ z 131072 hz,
    ACZ z 131073 hz,
    ACZ (z+1) 131072 (by omega),
    ACZ (z+1) 131073 (by omega),
    ACZ (z+2) 131072 (by omega),
    ACZ (z+2) 131073 (by omega)]
  have h1:z+1-2=z-1:=by omega
  have h2:z+2-2=z:=by omega
  rw [h1,h2]
  have hzsplit:z=(z-2)+2:=by omega
  rw [hzsplit]
  norm_num
