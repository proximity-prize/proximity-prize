abbrev P4 (K:Type*) [Field K]:=MvPolynomial (Fin 4) K
theorem EWS (weights:Fin 4→ℕ) (Q:P4 K)
    (hder:MvPolynomial.pderiv (2:Fin 4) Q ≠ 0):
    wt weights (MvPolynomial.pderiv (2:Fin 4) Q)+weights 2≤wt weights Q:=by
