theorem chain_at_point (O : Type*) [CommRing O] [IsDomain O] [IsNoetherianRing O]
    [IsIntegrallyClosed O] (K : Type*) [Field K] [Algebra O K] [IsFractionRing O K] :
    Statement.chain_at_point O K :=
  fun hO _ hg D hD _ s P hP m hm ord δ n hord =>
    sum_mul_le_toNat K hO hg D hD s P hP m hm ord δ n hord

theorem component_exchange (E : Type) [Field E] (G : Ideal (MvPolynomial (Fin 3) E)) [G.IsPrime] :
    Statement.component_exchange E G :=
  fun _ _ _ hN hp hc f c A₁ W hreg hdisj _ s _ _ _ S m hinj hcoord hdiv hord hp1 n =>
    Exch.component_exchange hN hp hc f c A₁ W hreg hdisj s S m hinj hcoord hdiv hord hp1 n

