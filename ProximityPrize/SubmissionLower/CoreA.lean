/-!
Package X4a, the count on the live curves of the X shape for a packet.

* `Curve.count_flag`: for a flag `Hf` of `H` with `5 ≤ 2 * Hf.all` (`hHf`: the pole of `H` is at most the pole
  of `Hf` at the prime divisors of the charts of the carrier), the count with the cut
  `cutFlag (w + delay) Hf`, for `moving a = curveMoving (S a) f c` and `o = Exch.baseOrder P Q A c S`.
* `Curve.count`: the statement `Curve.CountStatement` of `FRCurveStatement`, that is `CurveCount` of `FRGlue`:
  the instance at the flag `⟨t - y, y - r, r - 1⟩` of the cell (`polyH_flag_le`), whose cut is `cutR`.

For an active curve `a` and a delay with nonvanishing tail cut, `m + 1 = w + delay`: Step 1 on the
component of `a` (the place law of the common development, W9, the need `pole`), (L1') at every place of `a`
over the point chosen under it, and the count of zeros against poles on `a` for `Ψ_c^n` with the allowance
`4 (m + 1) o_μ(n)`.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

section Packet
noncomputable section
open scoped Classical BigOperators
open WithZero HFree6812
open RCN002 RCN055 RCN074 RCN086 RCN095 RCN135 RCN136 RCN156 RCN187 RCN199 RCN204 RCN222 RCN238
open RCN243 RCN264 RCN313
open DU AFA BOE BD BX
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] Exch.component_isPrime SurfacePoint.isNoetherianRing
  SurfacePoint.isIntegrallyClosed SurfacePoint.isFractionRing

omit [CharP K 2130706433] in
/-- (L1') as the pole side of the count: at a place of the curve over a point, the order of `Ψ_c^n`
restricted to the curve is at least `-flagPole (n • cutFlag (m + 1) Hf) - 4 (m + 1) o_μ(n)`. -/
private theorem Curve.order_of_levelRestrict (F : MvPolynomial (Fin 4) K)
    (G C : Ideal (MvPolynomial (Fin 3) Ω)) [G.IsPrime] [C.IsPrime]
    (S : Specialization (AJ Ω G) (AJ Ω C)) (Hf : FlagDegree) (f : AJ Ω G) (fC : AJ Ω C) (c : Ω) (m : ℕ)
    (hlev : LevelRestrict F G C S Hf f fC c m) (n : ℕ)
    (hpsi0 : tailCubeOn (AL K) F C m ^ n * ((fC - algebraMap Ω (AJ Ω C) c) ^ (4 * (m + 1)))⁻¹ ^ n ≠ 0)
    (q : SurfacePoint G) (hq : q.On S) (μ : RCN026.Place Ω (AJ Ω C)) (hμ : μ ∈ S.placesOn Ω hq) :
    -flagPole μ.val (coordinate Ω C) (n • cutFlag (m + 1) Hf) -
        ((4 * (m + 1) * placeOrder q S f c n μ : ℕ) : ℤ) ≤
      RCN026.order Ω (AJ Ω C) μ
        (tailCubeOn (AL K) F C m ^ n * ((fC - algebraMap Ω (AJ Ω C) c) ^ (4 * (m + 1)))⁻¹ ^ n) := by
  have h1 := hlev q hq μ hμ n
  rw [← map_pow, show psiCOn F C fC c m ^ n = tailCubeOn (AL K) F C m ^ n *
      ((fC - algebraMap Ω (AJ Ω C) c) ^ (4 * (m + 1)))⁻¹ ^ n by
    rw [psiCOn, div_eq_mul_inv, mul_pow]] at h1
  have h2 := (log_le_iff_le_exp ((Valuation.ne_zero_iff _).2 hpsi0)).2 h1
  rw [DZP, placeOrder_of_on hq]
  show _ ≤ -(μ.val (tailCubeOn (AL K) F C m ^ n * _)).log
  push_cast
  linarith

/-- At a place of a curve over a point at which `H` is a unit and `H (Q - c) + U G` does not vanish, the
moving function `Q + U G / H` minus `c` is a unit, and so is the inverse of each of its powers. -/
private theorem Curve.moving_unit {E : Type} [Field E] {C : Ideal (MvPolynomial (Fin 3) E)} [C.IsPrime]
    {v : Fin 3 → E} {mu : RCN026.Place E (AJ E C)} (hmu : PlaceOver C v mu)
    (H Gs Q U : MvPolynomial (Fin 3) E) (c : E) (hH : mu.val (BR E C H) = 1)
    (hv : MvPolynomial.aeval v (H * (Q - MvPolynomial.C c) + U * Gs) ≠ 0) (k n : ℕ) :
    mu.val (((RCN208.movingValue C H Gs Q U - algebraMap E (AJ E C) c) ^ k)⁻¹ ^ n) = 1 := by
  have hH0 : BR E C H ≠ 0 := fun h => by
    rw [h, map_zero] at hH
    exact zero_ne_one hH
  have h2 := hmu.eq_one _ hv
  have h3 : BR E C (H * (Q - MvPolynomial.C c) + U * Gs) =
      BR E C H * (RCN208.movingValue C H Gs Q U - algebraMap E (AJ E C) c) := by
    rw [RCN208.movingValue, map_add, map_mul, map_mul, map_sub,
      show BR E C (MvPolynomial.C c) = algebraMap E (AJ E C) c from (BR E C).commutes c, div_eq_mul_inv]
    linear_combination (-(BR E C U * BR E C Gs)) * mul_inv_cancel₀ hH0
  rw [h3, map_mul, hH, one_mul] at h2
  rw [map_pow, map_inv₀, map_pow, h2, one_pow, inv_one, one_pow]

/-- The count on the live curves of the X shape for a flag `Hf` of `H`: `hHf` bounds the pole of `H` by the
pole of the flag at the prime divisors of the charts of the carrier. The cut of the tail of index
`w + delay` is `cutFlag (w + delay) Hf`. -/
theorem Curve.count_flag (P : Packet x t y r) (SZ : Source P.F) (Hf : FlagDegree) (h5 : 5 ≤ 2 * Hf.all)
    (hHf : haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
      ∀ (sR sY sZ : Bool) (v : Valuation (SliceField P.F) ℤᵐ⁰), ChartDivisor P.F sR sY sZ v →
        v (sliceProj P.F (polyH K P.F)) ≤ exp (flagPole v (sliceCoord P.F) Hf))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F)) (base : ∀ a : Curve P, RCN341.BP a.2.1)
    (N : ℕ) (hN : ∀ (g : EX K P.F) (sR sY sZ : Bool), SurfaceNoether (Exch.component P g) sR sY sZ N)
    (hp : 3 * N < 2130706433) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a))
    (needs : CurveNeeds P SZ Q A c S) :
    ∀ n : ℕ, ∀ a ∈ active P SZ, ∀ delay : ℕ, 1 ≤ delay →
      _Q2 (AL K) (P.stage a.1).F (w + 1 + delay) ∉ a.2.1 →
      3 * n * (HF Ω (P.stage a.1).G (_Q2 (AL K) (P.stage a.1).F (w + 1)) (CR (AL K) (P.stage a.1).F)
          (KK K P.F P.selected P.seeds a.1) (DK (AL K) (P.stage a.1).selected) a.2).card ≤
        n * (budget a).weightedCost (cutFlag (w + delay) Hf) +
          4 * (w + delay) * (n * curveMoving (S a) (Exch.moving P Q A a.1) c +
            Exch.baseOrder P Q A c S n a) := by
  intro n a ha delay _ hcut
  have hFact : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  have hker := Exch.ker_sliceMap_component P a.1
  have hSa := hS a ha
  have hSfc := needs.off_level a ha
  obtain ⟨m, hm1, hm2⟩ : ∃ m, w + delay = m + 1 ∧ w + 1 + delay = m + 2 :=
    ⟨131070 + delay, by unfold RCN326.w; omega, by unfold RCN326.w; omega⟩
  have hcut' : _Q2 (AL K) P.F (m + 2) ∉ a.2.1 := hm2 ▸ hcut
  have hHC : surfaceMap (AL K) (polyH K P.F) ∉ a.2.1 := fun h => hcut' (by
    rw [tailCut_eq]
    exact a.2.1.mul_mem_right _ (a.2.1.mul_mem_right _ (a.2.1.pow_mem_of_mem h 3 (by norm_num))))
  have hNC : surfaceMap (AL K) (MN P.F m) ∉ a.2.1 := fun h => hcut' (by
    rw [tailCut_eq]
    exact a.2.1.mul_mem_right _ (a.2.1.mul_mem_left _ h))
  have hH : sliceProj P.F (polyH K P.F) ≠ 0 :=
    sliceProj_ne_zero_of_notMem P.F _ hker a.2.1 hSa.ideal_le _ hHC
  have hc : ∀ j, sliceCoord P.F j ≠ 0 := sliceCoord_ne_zero P.F P.F (dvd_refl P.F) hH m
    (sliceProj_ne_zero_of_notMem P.F _ hker a.2.1 hSa.ideal_le _ hNC)
  have hcG : ∀ j, coordinate Ω (Exch.component P a.1) j ≠ 0 := fun j => by
    rw [← sliceEmbedding_coord P.F _ hker j]
    exact (map_ne_zero _).mpr (hc j)
  have htr : ∃ j, Transcendental Ω (coordinate Ω a.2.1 j) :=
    ⟨(base a).index, (base a).transcendental⟩
  have hfR : (S a).Restricts (Exch.moving P Q A a.1)
      (RCN208.movingValue a.2.1 (baseH P.F) (baseG P.F) Q A) :=
    hSa.restricts_movingValue _ _ Q A hHC
  have hfC0 := (hfR.sub (hSa.restricts_algebraMap c)).ne_zero hSfc
  have hstep := Curve.step_one P.F (Exch.component P a.1) hker hH hcG Hf h5 hHf
    (fun sR sY sZ => Chart.common_place_law P.F P.F (dvd_refl P.F) hH t P.total_weight
      (by have := packet_t_le P; omega) hc sR sY sZ)
    (hN a.1) hp (Exch.moving P Q A a.1) c
    (fun h => by rw [h, map_zero] at hSfc; exact zero_ne_one hSfc) (needs.pole a ha)
  have hlev := Curve.level_restrict P.F (Exch.component P a.1) a.2.1 hker (S a) hSa hcG htr hHC
    Hf _ _ c hfR hSfc hstep m
  choose pt hpt using fun μ : RCN026.Place Ω (AJ Ω a.2.1) =>
    hSa.exists_point (hN a.1) hp hcG htr μ
  have hpsi0 : tailCubeOn (AL K) P.F a.2.1 m ^ n *
      ((RCN208.movingValue a.2.1 (baseH P.F) (baseG P.F) Q A - algebraMap Ω (AJ Ω a.2.1) c) ^
        (4 * (m + 1)))⁻¹ ^ n ≠ 0 := by
    refine mul_ne_zero (pow_ne_zero _ ?_) (pow_ne_zero _ (inv_ne_zero (pow_ne_zero _ hfC0)))
    rw [tailCubeOn, map_pow, map_pow]
    exact div_ne_zero (pow_ne_zero _ fun h => hNC ((CT.AAE a.2.1 _).1 h))
      (pow_ne_zero _ fun h => hHC ((CT.AAE a.2.1 _).1 h))
  have hcount := tail_curve_count_of_bound (P.stage a.1) a.2 (base a) (budget a) m n
    (by unfold RCN326.w at hm1 ⊢; omega) _
    (fun γ hγ mu hmu => moving_unit hmu (baseH P.F) (baseG P.F) Q A c
      (seed_place (P.stage a.1) a.2 γ hγ mu hmu).1 (needs.seed a ha γ hγ) (4 * (m + 1)) n)
    hpsi0 (n • cutFlag (m + 1) Hf)
    (fun μ => 4 * (m + 1) * placeOrder (pt μ) (S a) (Exch.moving P Q A a.1) c n μ)
    (4 * (m + 1) * (n * curveMoving (S a) (Exch.moving P Q A a.1) c +
      curveBase (S a) (Exch.moving P Q A a.1) c n))
    (fun T => by
      rw [← Finset.mul_sum]
      exact Nat.mul_le_mul_left _ (sum_placeOrder_le (base a) hSa hcG htr _ c hSfc (hN a.1) hp
        n pt hpt T))
    (fun μ => (hpt μ).elim fun hq hμ =>
      order_of_levelRestrict P.F _ a.2.1 (S a) Hf _ _ c m hlev n hpsi0 (pt μ) hq μ hμ)
  have hw : (budget a).weightedCost (n • cutFlag (m + 1) Hf) =
      n * (budget a).weightedCost (cutFlag (w + delay) Hf) := by
    rw [hm1]
    simp only [RD.weightedCost, nsmul_zOnly, nsmul_yz, nsmul_all]
    ring
  rw [hw, ← hm1] at hcount
  exact hcount

/-- The count on the live curves of the X shape: `Curve.count_flag` at the flag `⟨t - y, y - r, r - 1⟩` of
`H` on the cell. -/
theorem Curve.count (P : Packet x t y r) (SZ : Source P.F) : Curve.CountStatement P SZ := by
  intro budget base N hN hp Q A c S hS needs n a ha delay hdelay hcut
  have hFact : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  have hrlo := P.rlow
  have hylo := P.ylow
  have h := Curve.count_flag P SZ ⟨t - y, y - r, r - 1⟩ (by show 5 ≤ 2 * (r - 1); omega)
    (fun sR sY sZ v hv => polyH_flag_le P.F P.F v hv.trivial_on_K hv.x0_le_one (t - y) (y - r) r
      (cell_support t y r (by omega) (by omega) P.F P.support))
    budget base N hN hp Q A c S hS needs n a ha delay hdelay hcut
  rwa [cutFlag_cell] at h

end
