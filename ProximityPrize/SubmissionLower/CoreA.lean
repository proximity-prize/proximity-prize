  (∀i,MvPolynomial.X 0^m ∣ substitute (K:=K)
    (localize (nodes i) (u0 i) (u1 i) P))∧
  ∀d≤k,∀f:Polynomial K,f.natDegree≤131071→ ∀z:K,∀S:Finset N,
    181225≤S.card→(∀i ∈ S,f.eval (nodes i)=u0 i+u1 i*z)→
      specialize f z ((pderiv 1)^[d] P)=0

