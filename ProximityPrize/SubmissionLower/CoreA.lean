def base (D s:ℕ):Diff:=
 let q:=D/131071
 let r:=D%131071
 if r+s≤131071 then intercept q r 131071 s else
 sub (add (intercept q r 131071 (131071-r-1)) (intercept (q+1-(131071-r)) 0 131071 (s-(131071-r))))
  ⟨oneSlope (q+1-(131071-r)) 0 131071 (s-(131071-r))*(131071-r),0⟩
