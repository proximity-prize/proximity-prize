   Delta.card*P.gap≤
       (∑ g:EX K F.1,
         (KK K F.1 selected Delta g).card)*P.gap:=
     Nat.mul_le_mul_right P.gap hcover
   _=∑ g:EX K F.1,
       (KK K F.1 selected Delta g).card*P.gap:=by
     rw [Finset.sum_mul]
   _≤ ∑ g:EX K F.1,
       ((P.n-P.w)*(∑ i:Fin 3,regularCapAt P.KO i*
         EB (GenericField K) g.1 (surfaceMap phi T) i)+
         (P.errors+1)*P.gap*
