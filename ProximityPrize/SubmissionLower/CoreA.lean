    have hb:gb.1∈Ca.1:=by rw [he];exact EN E gb.1 N R Cb
    have hF:F∈Ca.1:=Ca.1.mem_of_dvd hga.2.1 ha
    have hd:=BSI F ga.1 gb.1 Ca.1 hprod ha hb
    have hspan:Ideal.span ({F,pderiv (1:Fin 3) F}:Set Poly)≤Ca.1:=by
