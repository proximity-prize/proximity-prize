    set θ:=max s (max 0 (max P pσ-2*((P.toNat:ℕ):ℤ))+((P.toNat:ℕ):ℤ)) with hθdef
    have hPn:((P.toNat:ℕ):ℤ)=P:=Int.toNat_of_nonneg hP0
