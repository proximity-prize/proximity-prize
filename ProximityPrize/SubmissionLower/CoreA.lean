    CD Ω E (surfaceMap (AL K) F)=
      surfaceMap ((algebraMap Ω E).comp (AL K)) F:=by
  simp only [RCN208.CD,RCN136.surfaceMap,
    RingHom.comp_apply,MvPolynomial.map_map]

