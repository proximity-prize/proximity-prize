        Ideal.span {surface} ⊔ J^d∧
    ev (RCN259.BPA (PH P n h q) (PH Q m h q))∈
        Ideal.span {surface} ⊔ J^d:=by
  let B:=PH P n h q
  let C:=PH Q m h q
  let I:=Ideal.span {surface} ⊔ J^d
  let red:=Ideal.Quotient.mk I
  let evJ:=(Ideal.Quotient.mk J).comp ev
