noncomputable section
open scoped Classical BigOperators
open RCN002 RCN095 RCN135 RCN222
open BD DU _Q7 AFA
variable {K I : Type} [Field K] [CharP K 2130706433]
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] LevelComponent.isPrime Exch.component_isPrime

/-- All that the section bound for the flag `W` asks of the section `s`, for a packet, the moving function
of `Q`, `A` and the level `c`: its flag; on every geometric component it is a good section for the leading
coefficient of the source (`GoodSection`: no component of the section lies in the zero set of the leading
coefficient, and the section has multiplicity one along each of its components); and the conditions
`ComponentNeeds` on the components of the level curve. -/
structure Needs (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (W : FlagDegree) (s : MvPolynomial (Fin 3) Ω) : Prop where
  flag : BI W s
  good : ∀ g : EX K P.F, GoodSection (P.stage g).G s (SZ.leading (AL K))
  component : ∀ g, ComponentNeeds (Exch.component P g) (baseH P.F) (Exch.moving P Q A g) c W s

/-- `scale * [L_c . W] ≤ W.zOnly * z + W.yz * u + W.all * v`, in the form of lane L's `SectionBound`: for
every finite set of components of the level curves and every finite set of places of each. -/
def FlagBound (P : Packet x t y r) (scale z u v : ℕ) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (W : FlagDegree) : Prop :=
  ∀ (s : ∀ g, Finset (LevelComponent (Exch.component P g) (Exch.moving P Q A g) c))
    (T : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c),
      Finset (RCN026.Place Ω (AJ Ω B.prime))),
    (scale : ℤ) * (∑ g, levelFlagSum (s g) (T g) W) ≤
      ((W.zOnly * z + W.yz * u + W.all * v : ℕ) : ℤ)

/-- The section bound for one flag, as a statement. Hypotheses, in this order: the point budget with free
numbers; the model (`SurfaceNoether` on every geometric component, nonzero coordinates); the flags of `Q`,
`A`; lane E2's conversion (p2) at the points of the surface (kept in the statement as the assembly passes
it; the proof applies lane E2's theorem and does not use the hypothesis); a separable literal coordinate
on every component of the level curve; the gate of the flag; the needs. -/
def FlagBoundStatement (P : Packet x t y r) (SZ : Source P.F) (scale z u v : ℕ) : Prop :=
  (∀ Q A : MvPolynomial (Fin 3) Ω, (2 : MvPolynomial (Fin 3) Ω) * A ≠ 0 →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A → AGN (RingHom.id Ω) P.F SZ Q A scale z u v) →
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hcoord : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0)
    (Q A : MvPolynomial (Fin 3) Ω) (_hQ : BI (2 • unitAllFlag) Q) (_hA : BI unitYZFlag A) (c : Ω)
    (_hlen : ∀ g (C : Ideal (MvPolynomial (Fin 3) Ω)) [C.IsPrime],
      PlaceSurf.Statement.surfacePoint_length_eq_zeros Ω (Exch.component P g) (AJ Ω C))
    (_hsep : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c),
      Nonempty (RCN341.BP B.prime))
    (W : FlagDegree) (s : MvPolynomial (Fin 3) Ω)
    (_hgate : 2 * t * (W.zOnly + W.yz + W.all) < 2130706433)
    (_hneeds : Needs P SZ Q A c W s),
    FlagBound P scale z u v Q A c W

/-- Lane L's `SectionBound` from three sections with the needs, under the hypotheses of
`FlagBoundStatement`. -/
def SectionBoundStatement (P : Packet x t y r) (SZ : Source P.F) (scale z u v : ℕ) : Prop :=
  (∀ Q A : MvPolynomial (Fin 3) Ω, (2 : MvPolynomial (Fin 3) Ω) * A ≠ 0 →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A → AGN (RingHom.id Ω) P.F SZ Q A scale z u v) →
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hcoord : ∀ g j, coordinate Ω (Exch.component P g) j ≠ 0)
    (Q A : MvPolynomial (Fin 3) Ω) (_hQ : BI (2 • unitAllFlag) Q) (_hA : BI unitYZFlag A) (c : Ω)
    (_hlen : ∀ g (C : Ideal (MvPolynomial (Fin 3) Ω)) [C.IsPrime],
      PlaceSurf.Statement.surfacePoint_length_eq_zeros Ω (Exch.component P g) (AJ Ω C))
    (_hsep : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c),
      Nonempty (RCN341.BP B.prime))
    (s₀ s₁ s₂ : MvPolynomial (Fin 3) Ω)
    (_h₀ : Needs P SZ Q A c unitZFlag s₀) (_h₁ : Needs P SZ Q A c unitYZFlag s₁)
    (_h₂ : Needs P SZ Q A c unitAllFlag s₂),
    SectionBound P scale z u v Q A c

end
end Packet

end ProximityPrize.SubmissionLower.FormalR.Sec
