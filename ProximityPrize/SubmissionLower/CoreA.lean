noncomputable abbrev kField (q:Fin 3→Polynomial K):IntermediateField K (SliceField F₀):=
  IntermediateField.adjoin K (Set.range ![sliceLinearL F₀ q,sliceProj F₀ (MvPolynomial.X 0)])

