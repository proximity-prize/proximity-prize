theorem EOZ
    (D:ℕ) (P:BT)
    (hDlow:131072≤D) (hDhigh:D<2130706433)
    (hS:P.s≤32) (hY:P.ys≤149) (hT:P.total≤8121)
    (Q:P4) (hQ:Q ≠ 0)
    (hbox:Q ∈ RCN174.BA K D 131071 P.total P.s)
    (HQ:KW P Q)
    (selected:K→Polynomial K) (Gamma:Finset K) (u0 u1:I→K)
