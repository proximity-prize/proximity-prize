theorem EYS (x:L):v x≤exp (max 0 (v x).log):=by
  by_cases hx:v x=0
  · rw [hx];exact zero_le
  · calc v x=exp (v x).log:=(exp_log hx).symm
      _≤exp (max 0 (v x).log):=by rw [exp_le_exp];exact le_max_right _ _

