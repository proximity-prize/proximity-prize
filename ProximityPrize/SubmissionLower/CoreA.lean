        rw [hTa]
        rcases hdich' with h1 | h1
        · have:n₁=1:=by omega
          have:pσ ≠ 0:=fun h0=>hA ⟨h0,by omega⟩
          omega
        · omega
      have hit:=CNO v Dd (pσ+n₁) (by omega) hθ m (sliceCoord F₀ 1)
      have:=hmθ (pσ+n₁) (by omega) hlaw
      have hc1:vpole v (sliceCoord F₀ 1)=0:=hq1
      rw [hc1,zero_add] at hit
