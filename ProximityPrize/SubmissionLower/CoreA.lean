    YN r (z+1) 131073 hr (by omega),
    YN r (z+2) 131072 hr (by omega),
    YN r (z+2) 131073 hr (by omega)]
  have h1:z+1-1=z:=by omega
  have h2:z+2-1=z+1:=by omega
