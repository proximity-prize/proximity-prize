theorem EXA {E:Type*} [CommRing E] [IsDomain E]
    (P Q:Polynomial R) (n m:ℕ) (h q:R)
    (hP:P≠0) (hn:P.natDegree≤n) (hm:Q.natDegree≤m) (hh:h≠0)
