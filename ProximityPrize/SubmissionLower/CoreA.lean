theorem FPG
    (F:MvPolynomial (Fin 4) K) (G:MvPolynomial (Fin 3) (GenericField K))
    (hG:Irreducible G) (hdiv:G ∣ surfaceMap (AL K) F)
    (hproper: ¬G ∣ surfaceMap (AL K) (dR 1 F))
    (p:ℕ) [CharP K p]
