      rw [←VB (EW S)]
      exact C.2⟩
  change 1≤DQ Ω (AJ Ω C.1) ((suppliedUnit S hp geometry).yzProjection C)
  apply RO
  rw [ETQ (suppliedUnit S hp geometry) (DKL S hp geometry) C,
    DNI,eval_linearU]
  exact geometry.data.ZG C'

