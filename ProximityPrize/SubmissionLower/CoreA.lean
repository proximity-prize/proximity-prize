    apply (asS (K:=K)).injective
    simpa only [map_zero] using hz
  have hc:=Polynomial.leadingCoeff_ne_zero.mpr hn
  exact ⟨hc,FHJ P F L (asS P).natDegree hPL hF hc⟩

