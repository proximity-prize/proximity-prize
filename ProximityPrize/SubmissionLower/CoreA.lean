  ⟨v0,v1,v2,v3,⟨v4,v5,v5+v6⟩,⟨v4,v7,v7+v8⟩⟩::aux layout n (Nat.shiftRight code o9)
def data(layout n code:ℕ):List WideEntry:=aux layout n code
