theorem sliceForm_eq (c:Fin 3→Ω):
    sliceForm (E:=E) c=
      C (sliceValue Ω E)- ∑ m,C (algebraMap Ω E (c m))*MvPolynomial.X m:=by
  simp [CD]

theorem GHQ (c:Fin 3→Ω) (i:Fin 3) (hci:c i=1):
