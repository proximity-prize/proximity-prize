  apply (RCN081.KN _ _ _).mpr
  intro e he
  have hh:=hP _ (AJU P j e he)
  obtain ⟨h0,h1,h2,h3,h4⟩:=_Q17 j e
  rw [h1,h2,h3,h4] at hh
