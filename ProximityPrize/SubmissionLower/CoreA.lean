 | cons e es ih =>
  simp only [check,Bool.and_eq_true,decide_eq_true_eq] at hc
  by_cases he:nu≤e.hi
  · exact ⟨wideRect b profiles start e,EGR b _ hc.1,hlo,he⟩
  · exact ih  (e.hi+1) hc.2  (by omega)
#print axioms block_sound
