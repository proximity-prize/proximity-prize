    (hu:e 1+e 2+e 3≤U):e∈Set.range (exponent C T B S U d):=by
  obtain ⟨i,hi⟩:=RB.AKF d T B S U e hc ht hb hs hu
  exact ⟨Sum.inr i,hi⟩

