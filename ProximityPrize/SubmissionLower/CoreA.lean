      intro v hn
      obtain ⟨i,hi⟩:=EOB p a k n0 gap v.val J (f v) hJ hn
        (RV V J a.q hv v) (hb v.val v.property) ha (hsource v.val v.property)
      exact ⟨i,hi.symm⟩
