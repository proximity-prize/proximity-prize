  rw [MvPolynomial.as_sum P,map_sum]
  have hh:=Polynomial.natDegree_sum_le_of_forall_le P.support
    (fun e=>FL f z (MvPolynomial.monomial e (AddMonoidAlgebra.coeff P e))) ht
  omega

