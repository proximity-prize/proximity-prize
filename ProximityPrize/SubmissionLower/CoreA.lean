  · omega
  · exact GKO p a b x (by exact_mod_cast ha) (by exact_mod_cast hb) h0 h3 h1 h2

def AVK (base rate L s:ℤ):Cubic:=
  let a0:=s*(s+1)*((4*s+2)*L-s*s+5*s+2)
  let a1:= -2*(s+1)*(3*L*s-3*L+6*s-4)
  let a2:=6*(L+1)*(s+1)
  let a3:= -2*(s+1)
