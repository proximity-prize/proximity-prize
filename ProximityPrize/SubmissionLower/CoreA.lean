    (algebraMap C L).codRestrict v.valuationSubring fun c=>(Valuation.mem_valuationSubring_iff _ _).2 (hCv c)
  set 𝔓:Ideal C:=(IsLocalRing.maximalIdeal v.valuationSubring).comap ρ
