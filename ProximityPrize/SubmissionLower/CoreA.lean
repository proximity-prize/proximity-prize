    exact hinj (congrArg Subtype.val hs)
  have hmu: ∀i,1≤mu i:=fun i=>YW S hproper (old i)
  have ha: ∀i,a ∈ (RingHom.ker (evalPoint i).toRingHom)^(mu i):=by
    intro i
