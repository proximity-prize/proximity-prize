/-- The facts of the tree's proof of `BOE.ELK` about its common frame `(lam, mu)`, its geometry and its
budget, with numbers `scale`, `z`, `u`, `v` in the place of the pair's scale and three heights:

* `lam_mem`, `mu_mem`, `frame`: the frame of `BLL.DYG`, common to all stages;
* `value`: the three projections of the supplied unit family of a curve are the residues of the three
  linear forms `DSG lam mu j` (`PR.FKV`, `AYR.GDG`, `AYR.GAA`); their degrees are the three ordinary costs
  (`ordinary P hp geometry a W` is the sum of `weight W j` times the degree of the projection `j`);
* `cost`: the budget has the supplied ordinary costs;
* `moving`: the bound for the moving costs of the budget (the tree's `BIO.CTF`, from `point_budget`);
* `point_budget`: the count of the isolated points of a level curve of `Q + A σ` on a cut, for all
  admissible `Q`, `A` (for the pair: the tree's `_Q7.BSF`). -/
structure PacketFrame (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) (lam mu : Ω)
    (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F)) : Prop where
  lam_mem : lam ∈ Set.range (AL K)
  mu_mem : mu ∈ Set.range (AL K)
  frame : ∀ g, (geometry g).data.lam = lam ∧ (geometry g).data.mu = mu
  value : ∀ (j : Fin 3) (a : Curve P),
    FT Ω (AJ Ω a.2.1)
      (![(suppliedUnit (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).zProjection a.2,
        (suppliedUnit (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).yzProjection a.2,
        (suppliedUnit (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).NV a.2] j) =
      BR Ω a.2.1 (DSG lam mu j)
  cost : ∀ a, (budget a).zCost =
      (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).zCost a.2 ∧
    (budget a).yzCost =
      (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).yzCost a.2 ∧
    (budget a).allCost =
      (BLJ (P.stage a.1) (P.stage_proper hp a.1) (geometry a.1)).allCost a.2
  moving : scale * (∑ a ∈ active P SZ, (budget a).movingCost) ≤ price (rawFirstFlag t y r) z u v
  point_budget : ∀ Q A : MvPolynomial (Fin 3) Ω, (2 : MvPolynomial (Fin 3) Ω) * A ≠ 0 →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A → AGN (RingHom.id Ω) P.F SZ Q A scale z u v

/-- The count on a live curve: for every `n`, three times the `n`-fold number of seeds is at most `n` times
the cost of the flag `cutR (w + delay)` plus `4 (w + delay)` times `n moving a + o n a` (`moving a`: the
number of points of `a` on the level curve away from the base points, with multiplicity; `o n a`: the sum
over the base places of `a` of the least order of an element of `O(-n L_c)`). -/
def CurveCount (P : Packet x t y r) (SZ : Source P.F)
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F))
    (moving : Curve P → ℕ) (o : ℕ → Curve P → ℕ) : Prop :=
  ∀ n : ℕ, ∀ a ∈ active P SZ, ∀ delay : ℕ, 1 ≤ delay →
    _Q2 (AL K) (P.stage a.1).F (w + 1 + delay) ∉ a.2.1 →
    3 * n * (HF Ω (P.stage a.1).G
        (_Q2 (AL K) (P.stage a.1).F (w + 1))
        (CR (AL K) (P.stage a.1).F)
        (KK K P.F P.selected P.seeds a.1)
        (DK (AL K) (P.stage a.1).selected) a.2).card ≤
      n * (budget a).weightedCost (cutR (w + delay) r (y - r) (t - y)) +
        4 * (w + delay) * (n * moving a + o n a)

/-- The count of `A_1` on the level curve: its zeros at the moving points of the live curves and its zeros
`Lam` at the base points against its poles, priced with the heights of the moving class. -/
def LevelCount (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) (moving : Curve P → ℕ) (Lam : ℕ) : Prop :=
  3 * SZ.d * scale * (∑ a ∈ active P SZ, multiplicity P hp a * moving a) + scale * Lam ≤
    SZ.d * price (cellCutR t y r) z u v + 4 * (w + 1) * price SZ.flag z u v

/-- The exchange at the base points summed over the live curves, with a constant `Kc` that does not depend
on `n`. -/
def ExchangeCount (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F)
    (o : ℕ → Curve P → ℕ) (Lam Kc : ℕ) : Prop :=
  ∀ n : ℕ, 3 * SZ.d * (∑ a ∈ active P SZ, multiplicity P hp a * o n a) ≤ n * Lam + Kc

/-- The contract for one packet at the numbers: whatever common frame, geometry and budget have
`PacketFrame` at them, there are moving numbers, base orders and the two constants with the three counts. -/
def XContracts (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) : Prop :=
  ∀ (lam mu : Ω) (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F)),
    PacketFrame P hp SZ scale z u v lam mu geometry budget →
    ∃ (moving : Curve P → ℕ) (o : ℕ → Curve P → ℕ) (Lam Kc : ℕ),
      CurveCount P SZ budget moving o ∧ LevelCount P hp SZ scale z u v moving Lam ∧
        ExchangeCount P hp SZ o Lam Kc

/-- `SharedRCostAt` from a frame at the numbers, the first-cut law with the weights of `cellCutR` at the
numbers, and the contract. -/
theorem shared_R_cost_at_of_contracts
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) (lam mu : Ω)
    (geometry : ∀ g, ABN (P.stage g))
    (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F))
    (hframe : PacketFrame P hp SZ scale z u v lam mu geometry budget)
    (hfirst : 3 * scale *
        (∑ a ∈ active P SZ, multiplicity P hp a * ordinary P hp geometry a (cellCutR t y r)) ≤
      scale * (∑ j : Fin 3, weight (cellCutR t y r) j *
          flagMixed ⟨t - y, y - r, r⟩ (ASY t y r j) (BD.direction j)) +
        4 * (w + 1) * price (cellCutR t y r) z u v)
    (hX : XContracts P hp SZ scale z u v) :
    SharedRCostAt P hp SZ scale z u v := by
  obtain ⟨moving, o, Lam, Kc, hcurve, hlevel, hexch⟩ := hX lam mu geometry budget hframe
  exact shared_R_cost_at_of_counts P hp SZ scale z u v geometry budget hframe.cost hfirst
    moving o Lam Kc hcurve hlevel hexch

