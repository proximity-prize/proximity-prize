theorem DMM
    (Gamma:A→Finset K) (flag:A→FlagDegree)
    (S: ∀a,Stage K I (Gamma a) x 2130706433 (flag a) errorCap stageSupport)
    (F:MvPolynomial (Fin 4) K) (hF:F≠0) (hSF: ∀a,(S a).F=F)
    (parent:FlagDegree) (hparent:BI parent (BXI eta F))
    (hproper: ∀a,¬(S a).G∣_Q2 (AL K) (S a).F (w+1))
    (old: ∀a,CM (S a)) (hold:Function.Injective (fun a=>(old a).1))
    (ell:MvPolynomial (Fin 3) Ω) (q:FlagDegree) (hell:BI q ell)
    (projection: ∀a,DB Ω (AJ Ω (old a).1))
    (hvalue: ∀a,DB.value Ω (AJ Ω (old a).1) (projection a)=
      BR Ω (old a).1 ell)
    (hdeg:parent.zOnly+parent.yz+parent.all<2130706433)
    (hmix:2*(parent.zOnly+parent.yz+parent.all)*(q.zOnly+q.yz+q.all)<2130706433)
    (SZ:Source F) (hleading: ∀a,SZ.leading (AL K)∉(old a).1)
    (d:Fin 3) (r v z:ℕ) (hr:3≤r) (hv:2≤v)
    (hR:WeightBound BE F (r:ℤ))
    (hYR:WeightBound BC F ((r+v:ℕ):ℤ))
    (hAll:WeightBound AT F ((r+v+z:ℕ):ℤ))
    (C0:FlagDegree) (hfree:CTP (E:=E) F ell C0 d)
    (scale zCap uCap vCap:ℕ)
    (hbound: ∀Q U:PE,(2:PE)*U≠0→
      BI (2 • unitAllFlag) Q→BI unitYZFlag U→
      AGN eta F SZ Q U scale zCap uCap vCap):
    3*scale*(∑ a,FO (S a) (DN (S a) (hproper a)) (old a)*
      DB.degree Ω (AJ Ω (old a).1) (projection a))≤
      scale*flagMixed parent q (hfreeFlagDir d r v z C0)+
        4*(w+1)*(q.zOnly*zCap+q.yz*uCap+q.all*vCap):=by
  classical
  let oldPrime:=fun a=>(old a).1
  letI: ∀a:A,Algebra (RatFunc Ω) (AJ Ω (oldPrime a)):=
    fun a=>(projection a).embedding.toRingHom.toAlgebra
  letI: ∀a:A,IsScalarTower Ω (RatFunc Ω) (AJ Ω (oldPrime a)):=
    fun a=>IsScalarTower.of_algebraMap_eq fun c=>((projection a).embedding.commutes c).symm
  letI: ∀a:A,FiniteDimensional (RatFunc Ω) (AJ Ω (oldPrime a)):=fun a=>(projection a).finite
  letI: ∀a:A,Algebra.IsSeparable (RatFunc Ω) (AJ Ω (oldPrime a)):=fun a=>(projection a).separable
  let T:=(a:A) × (AJ Ω (oldPrime a)→ₐ[RatFunc Ω] E)
  let oldT:=fun i:T=>old i.1
  let embT:=fun i:T=>i.2.restrictScalars Ω
  let N:=AWE (E:=E) ell
  have hpoints:Function.Injective (fun i:T=>GM (oldT i).1 (embT i)):=
    ANW oldPrime hold
  have hcert (i:T):=OP.VX (S i.1).G
    (_Q2 (AL K) (S i.1).F (w+1))
    (RCN243.CR (AL K) (S i.1).F) ell (old i.1) (hvalue i.1) i.2
  have hNq:BI q N:=BBP (inFlag_const q _) (inFlag_map _ hell)
  have hmass:=EGZ (fun i:T=>Gamma i.1) (fun i:T=>flag i.1)
    (fun i:T=>S i.1) F hF (fun i=>hSF i.1) parent hparent (fun i=>hproper i.1)
    oldT embT hpoints N q hNq (fun i=>(hcert i).2.1) (fun i=>(hcert i).2.2.2.2)
    hdeg hmix SZ (fun i=>hleading i.1) d r v z hr hv hR hYR hAll C0
    (fun D _ sep hFD hND hHD=>hfree D sep hFD hND hHD) scale zCap uCap vCap hbound
  have hsum:=OP.DOP (E:=E) oldPrime
    (fun a=>FO (S a) (DN (S a) (hproper a)) (old a))
  simpa only [oldT,embT,T,DB.degree,oldPrime,hsum] using hmass

theorem CXM
    (Gamma:A→Finset K) (flag:A→FlagDegree)
    (S: ∀a,Stage K I (Gamma a) x 2130706433 (flag a) errorCap stageSupport)
    (F:MvPolynomial (Fin 4) K) (hF:F≠0) (hSF: ∀a,(S a).F=F)
    (parent:FlagDegree) (hparent:BI parent (BXI eta F))
    (hproper: ∀a,¬(S a).G∣_Q2 (AL K) (S a).F (w+1))
    (old: ∀a,CM (S a)) (hold:Function.Injective (fun a=>(old a).1))
    (ell:MvPolynomial (Fin 3) Ω) (q:FlagDegree) (hell:BI q ell)
    (projection: ∀a,Coordinate Ω (AJ Ω (old a).1))
    (hvalue: ∀a,FT Ω (AJ Ω (old a).1) (projection a)=
      BR Ω (old a).1 ell)
    (hdeg:parent.zOnly+parent.yz+parent.all<2130706433)
    (hmix:2*(parent.zOnly+parent.yz+parent.all)*(q.zOnly+q.yz+q.all)<2130706433)
    (SZ:Source F) (hleading: ∀a,SZ.leading (AL K)∉(old a).1)
    (d:Fin 3) (r v z:ℕ) (hr:3≤r) (hv:2≤v)
    (hR:WeightBound BE F (r:ℤ))
    (hYR:WeightBound BC F ((r+v:ℕ):ℤ))
    (hAll:WeightBound AT F ((r+v+z:ℕ):ℤ))
    (C0:FlagDegree) (hfree:CTP (E:=E) F ell C0 d)
    (scale zCap uCap vCap:ℕ)
    (hbound: ∀Q U:PE,(2:PE)*U≠0→
      BI (2 • unitAllFlag) Q→BI unitYZFlag U→
      AGN eta F SZ Q U scale zCap uCap vCap):
    3*scale*(∑ a,FO (S a) (DN (S a) (hproper a)) (old a)*
      DQ Ω (AJ Ω (old a).1) (projection a))≤
      scale*flagMixed parent q (hfreeFlagDir d r v z C0)+
        4*(w+1)*(q.zOnly*zCap+q.yz*uCap+q.all*vCap):=by
  classical
  let Alive:Set A:={a | ∃c,projection a=Sum.inr c}
  let sep:=fun a:Alive=>Classical.choose a.2
  have hsep (a:Alive):projection a.1=Sum.inr (sep a):=Classical.choose_spec a.2
  let old0:=fun a:Alive=>old a.1
  have hi0:Function.Injective (fun a:Alive=>(old0 a).1):=by
    intro a b hh
    exact Subtype.ext (hold hh)
  have hv0 (a:Alive):DB.value Ω (AJ Ω (old0 a).1) (sep a)=
      BR Ω (old0 a).1 ell:=by
    have hh:=hvalue a.1
    rw [hsep a] at hh
    exact hh
  let weight:=fun a=>FO (S a) (DN (S a) (hproper a)) (old a)
  have hsum:(∑ a,weight a*DQ Ω (AJ Ω (old a).1) (projection a))=
      ∑ a:Alive,weight a.1*DB.degree Ω (AJ Ω (old0 a).1) (sep a):=by
    apply Finset.sum_congr_set Alive
      (fun a=>weight a*DQ Ω (AJ Ω (old a).1) (projection a))
      (fun a=>weight a.1*DB.degree Ω (AJ Ω (old0 a).1) (sep a))
    · intro a ha
      simp only [hsep ⟨a,ha⟩,DQ,Sum.elim_inr,old0]
    · intro a ha
      cases hpj:projection a with
      | inl c=>simp only [hpj,DQ,Sum.elim_inl,Nat.mul_zero]
      | inr c=>exact (ha ⟨c,hpj⟩).elim
  have hb:=DMM (E:=E)
    (fun a:Alive=>Gamma a.1) (fun a:Alive=>flag a.1) (fun a:Alive=>S a.1)
    F hF (fun a=>hSF a.1) parent hparent (fun a=>hproper a.1) old0 hi0 ell q hell
    sep hv0 hdeg hmix SZ (fun a=>hleading a.1) d r v z hr hv hR hYR hAll C0 hfree
    scale zCap uCap vCap hbound
  change 3*scale*(∑ a,weight a*DQ Ω (AJ Ω (old a).1) (projection a))≤_
  rw [hsum]
  exact hb

end
