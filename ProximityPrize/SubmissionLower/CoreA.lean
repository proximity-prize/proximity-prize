theorem DFN
    {R:Type*} [CommRing R] (J:Ideal R) [J.IsMaximal]
    (surface A B:R) (d n m:ℕ) (P:Polynomial R)
    (hn:P.natDegree≤n) (hm:P.natDegree≤m) (hA:A∉J)
    (hmem:cleared P n A B∈Ideal.span {surface} ⊔ J^d):
