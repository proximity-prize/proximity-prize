  intro gamma hgamma
  let support:=(Finset.univ:Finset I).filter
    (fun i=>(selected gamma).eval (nodes i)=u0 i+gamma*u1 i)
  have hv: ∀i ∈ support,(selected gamma).eval (nodes i)=u0 i+gamma*u1 i:=by
