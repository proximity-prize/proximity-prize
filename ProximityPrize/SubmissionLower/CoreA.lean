  let p:=AVK ((d.alpha:ℤ)+d.beta) d.beta L d.s
  let q:=AVK ((d.alpha:ℤ)+d.beta) ((d.beta:ℤ)+1) ((L:ℤ)-T) ((d.s:ℤ)-b.R)
