     unfold middle total at*
     omega
   have htotal:p.all+(middle p-p.all)+p.zOnly≤TG.cheap.totalCap:=by
     dsimp only [TG.cheap]
     unfold middle total at*
     omega
   have hm:=Lower80899.PhaseRows.DZI TG.cheap hz htotal
     ((EUB _ _).mp hf)
