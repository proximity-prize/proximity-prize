    intro hmem
    exact BJN.EXA P Q n m h q hP hn hm hh hrel evJ hnz
      (Ideal.Quotient.eq_zero_iff_mem.mpr hmem)
  have hu:IsUnit (red (ev (gcd B C))):=AKH J surface d _ hg
