  refine ⟨lam, mu, geometry, budget, ⟨hlam, hmu, heq, hvalue, hcost, hmoving, hraw⟩, ?_⟩
  have hR : WeightBound BE P.F (r : ℤ) := Or.inr (by exact_mod_cast P.r_weight)
