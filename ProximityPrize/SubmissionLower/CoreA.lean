  let o7:=o6+b6
  let o8:=o7+b7
  let o9:=o8+b8
  let v0:=field code o0 b0
  let v1:=field code o1 b1
  let v2:=field code o2 b2
  let v3:=field code o3 b3
  let v4:=field code o4 b4
  let v5:=field code o5 b5
