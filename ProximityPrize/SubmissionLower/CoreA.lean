def NatCheck (p:Poly) (a b:ℕ):Prop:=b<a ∨
  (eval p a).neg< (eval p a).pos ∧  (eval p b).neg< (eval p b).pos ∧
  (mid1 p a b).neg≤ (mid1 p a b).pos ∧  (mid2 p a b).neg≤ (mid2 p a b).pos
