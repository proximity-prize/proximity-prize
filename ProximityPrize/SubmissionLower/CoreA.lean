theorem FIN {t y r:ℕ}
    (nodes:I ↪ K) (P:Packet (nodes:I→K) t y r) [Fact (Irreducible P.F)]
    (J T Q:Poly (K:=K)) (hJ:J≠0) (q m n nu D:ℕ)
    (heq:T=J^q*Q)
    (hjet: ∀i,MvPolynomial.X 0^n∣substitute (K:=K) (localize (nodes i) (P.u0 i) (P.u1 i) T))
