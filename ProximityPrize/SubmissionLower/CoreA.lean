variable {K A L:Type*} [CommRing K] [CommRing A] [Algebra K A] [Field L]
noncomputable def DPG (L:Type*) [Field L] (bound:ℕ):Ideal (Polynomial L):=
 Ideal.span ({(Polynomial.X:Polynomial L)^bound}:Set (Polynomial L))
abbrev FFC (L:Type*) [Field L] (bound:ℕ):=
 Polynomial L ⧸ DPG L bound
noncomputable def taylorHom
   (D:Derivation K A A) (value:A→+*L) (bound:ℕ)
   (hbound:0<bound)
   (hfactorial:∀j<bound,(j.factorial:L)≠0):
   A→+*FFC L bound where
 toFun a:=Ideal.Quotient.mk (DPG L bound)
   (RS D value bound a)
 map_zero':=by rw [FMG,map_zero]
 map_one':=by rw [FOM D value bound hbound,map_one]
 map_add' a b:=by rw [FTI,map_add]
 map_mul' a b:=by
   rw [←map_mul]
   apply Ideal.Quotient.eq.mpr
   apply Ideal.mem_span_singleton.mpr
   exact CPK D value bound a b hfactorial
theorem CPR
   (D:Derivation K A A) (a:A) (ha:D a=0) (n:ℕ) (hn:n≠0):
   D^[n] a=0:=by
 cases n with
 | zero=>exact (hn rfl).elim
 | succ n=>
   rw [Function.iterate_succ_apply,ha]
   exact iterate_zero D n
theorem BCV
   (D:Derivation K A A) (value:A→+*L) (bound:ℕ)
   (hbound:0<bound) (a:A) (ha:D a=0):
   RS D value bound a=Polynomial.C (value a):=by
 ext j
 by_cases hj:j=0
 · subst j
   simp [NM,LS,hbound]
 · have hiter:=CPR D a ha j hj
   simp [NM,LS,hiter,Polynomial.coeff_C,hj]
theorem EOR
   (D:Derivation K A A) (value:A→+*L) (bound:ℕ)
   (hbound:0<bound) (c:K):
   RS D value bound (algebraMap K A c)=
     Polynomial.C (value (algebraMap K A c)):=
 BCV D value bound hbound _ (D.map_algebraMap c)
theorem EKR
   (D:Derivation K A A) (value:A→+*L) (a:A) (n:ℕ)
   (hn:(n.factorial:L)≠0)
   (hsucc:((n+1).factorial:L)≠0):
   LS D value (D a) n=
     LS D value a (n+1)*(n+1:L):=by
 have hcast:(n+1:L)≠0:=by
   have hmul:(n+1:L)*(n.factorial:L)≠0:=by
     simpa only [Nat.factorial_succ,Nat.cast_mul,Nat.cast_add,Nat.cast_one] using hsucc
   exact (mul_ne_zero_iff.mp hmul).1
 simp only [LS,Function.iterate_succ_apply,
   Nat.factorial_succ,Nat.cast_mul,Nat.cast_add,Nat.cast_one]
 field_simp
theorem CKF
   (D:Derivation K A A) (value:A→+*L) (bound:ℕ) (a:A)
   (hfactorial:∀j≤bound,(j.factorial:L)≠0)
   (hlast:LS D value a bound=0):
   RS D value bound (D a)=
     (RS D value bound a).derivative:=by
 ext j
 rw [Polynomial.coeff_derivative,NM,NM]
 by_cases hj:j<bound
 · rw [if_pos hj,EKR D value a j
     (hfactorial j hj.le) (hfactorial (j+1) (by omega))]
   by_cases hnext:j+1<bound
   · rw [if_pos hnext]
   · have heq:j+1=bound:=by omega
     simp [heq,hlast]
 · have hnext:¬j+1<bound:=by omega
   rw [if_neg hj,if_neg hnext,zero_mul]
theorem BKM
   (D:Derivation K A A) (value:A→+*L) (p bound:ℕ) [CharP L p]
   (hbound:bound<p) (a:A)
   (hlast:LS D value a bound=0):
   RS D value bound (D a)=
     (RS D value bound a).derivative:=by
 apply CKF D value bound a
 · intro j hj
   exact TJ p j (lt_of_le_of_lt hj hbound)
 · exact hlast
theorem CLJ
   (D:Derivation K A A) (value:A→+*L) (small bound:ℕ) (a:A)
   (hsmall:small≤bound)
   (htails:∀j,small≤j→j<bound→LS D value a j=0):
   RS D value bound a=RS D value small a:=by
 ext j
 rw [NM,NM]
 by_cases hj:j<small
 · rw [if_pos hj,if_pos (lt_of_lt_of_le hj hsmall)]
 · rw [if_neg hj]
   by_cases hb:j<bound
   · rw [if_pos hb,htails j (by omega) hb]
   · rw [if_neg hb]
theorem BPO
   (bound:ℕ) (Q:Polynomial L) (hdegree:Q.natDegree<bound)
   (hzero:Ideal.Quotient.mk (DPG L bound) Q=0):Q=0:=by
 have hmem:=Ideal.Quotient.eq_zero_iff_mem.mp hzero
 have hdvd:(Polynomial.X:Polynomial L)^bound∣Q:=
   Ideal.mem_span_singleton.mp hmem
 have hcoeff:=Polynomial.X_pow_dvd_iff.mp hdvd
 ext j
 rw [Polynomial.coeff_zero]
 by_cases hj:j<bound
 · exact hcoeff j hj
 · exact Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_lt_of_le hdegree (by omega))
end TaylorMap
