/-- When a curve of the packet is active, the leading coefficient of the source is not zero on the
carrier: a curve of a stage contains the polynomial of its geometric component. -/
theorem srcLead_ne_zero (P : Packet x t y r) (SZ : Source P.F) (a : Curve P) (ha : a ∈ active P SZ) :
    srcLead P.F P.F SZ ≠ 0 :=
  Curve.sliceProj_ne_zero_of_notMem P.F (Exch.component P a.1) (Exch.ker_sliceMap_component P a.1) a.2.1
    ((Ideal.span_singleton_le_iff_mem _).mpr (RCN072.DVL Ω (P.stage a.1).G _ a.2.1
      (RCN264.AAS Ω _ _ _ a.2) (Ideal.subset_span (Set.mem_insert _ _)))) _ (Finset.mem_filter.mp ha).2

theorem xContracts
    (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (hZd : SZ.k < 2130706433) (scale z u v : ℕ)
    (hcurve : Curve.CountStatement P SZ)
    (hexch : Exch.Statement.exchange_count P hp SZ)
    (hlevel : LevelCount.Statement P hp SZ scale z u v)
    (hsec : Sec.SectionBoundStatement P SZ scale z u v)
    (hchoice : Sec.ChoiceStatement P SZ) :
    XContracts P hp SZ scale z u v := by
  intro lam mu geometry budget hframe
  by_cases hlead : srcLead P.F P.F SZ = 0
  · have hempty : active P SZ = ∅ :=
      Finset.eq_empty_of_forall_notMem fun a ha => srcLead_ne_zero P SZ a ha hlead
    refine ⟨fun _ => 0, fun _ _ => 0, 0, 0, ?_, ?_, ?_⟩
    · intro n a ha
      exact absurd (hempty ▸ ha) (Finset.notMem_empty a)
    · simp [LevelCount]
    · intro n
      simp
  have hc := Chart.packet_sliceCoord_ne_zero P hp
  have hI := Chart.packet_psiS_integral P hp SZ hZd
  have hN := Chart.surfaceNoether_component P hp
  have hNp := Chart.packet_three_mul_lt P
  have hsep := LevelCount.separable P
  obtain ⟨Q, A, c, S, s₀, s₁, s₂, hQ, hA, -, hS, hCn, hXn, hLn, h₀, h₁, h₂⟩ :=
    hchoice t hN hNp hc (Exch.tail_ne_zero P hp) hlead
      (fun a => suppliedBase (P.stage a.1) (geometry a.1) a.2) hsep
      (fun g _ _ _ h q hq sep =>
        h.finite_integralClosure (Chart.packet_coordinate_ne_zero P hp g) q hq sep)
  have htail := tail_order P hp SZ S hS
  have hbound : SectionBound P scale z u v Q A c :=
    hsec hframe.point_budget t hN hNp (Chart.packet_coordinate_ne_zero P hp) Q A hQ hA c
      (fun _ _ _ => PlaceSurf.surfacePoint_length_eq_zeros)
      (fun g B => hsep Q A hQ hA c g (hLn.component g).ne B) s₀ s₁ s₂ h₀ h₁ h₂
  have hflag : (Exch.flag SZ ⟨t - y, y - r, r - 1⟩).zOnly ≤
        SZ.d * (cellCutR t y r).zOnly + 4 * (w + 1) * SZ.flag.zOnly ∧
      (Exch.flag SZ ⟨t - y, y - r, r - 1⟩).yz ≤
        SZ.d * (cellCutR t y r).yz + 4 * (w + 1) * SZ.flag.yz ∧
      (Exch.flag SZ ⟨t - y, y - r, r - 1⟩).all ≤
        SZ.d * (cellCutR t y r).all + 4 * (w + 1) * SZ.flag.all := by
    rw [Exch.flag_cell, cellCutR, show RCN327.w = w from rfl]
    simp only [cutR, add_zOnly, add_yz, add_all, nsmul_zOnly, nsmul_yz, nsmul_all]
    refine ⟨?_, ?_, ?_⟩ <;> nlinarith [Nat.zero_le (SZ.d * (2 * (t - y))),
      Nat.zero_le (SZ.d * (2 * (y - r))), Nat.zero_le (SZ.d * (2 * r - 7)), Nat.zero_le SZ.flag.zOnly,
      Nat.zero_le SZ.flag.yz, Nat.zero_le SZ.flag.all]
  exact ⟨fun a => curveMoving (S a) (Exch.moving P Q A a.1) c, Exch.baseOrder P Q A c S,
    Exch.lam P SZ Q A c (Exch.flag SZ ⟨t - y, y - r, r - 1⟩),
    Exch.constant P hp SZ Q A c S (Exch.flag SZ ⟨t - y, y - r, r - 1⟩),
    hcurve budget (fun a => suppliedBase (P.stage a.1) (geometry a.1) a.2) t hN hNp Q A c S hS hCn,
    hlevel ⟨t - y, y - r, r - 1⟩ Q A c S hS hflag hLn hbound hc hI t hN hNp htail hQ hA,
    hexch ⟨t - y, y - r, r - 1⟩ Q A c S hS hXn hc hI t hN hNp htail
      (fun _ _ => PlaceSurf.surfacePoint_leastOrder_le)⟩

end
