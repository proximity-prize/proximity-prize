 rw [CBS K M L s hML] at hsum
 omega
theorem ABG (M L s:ℕ) (hML:M≤L):
   Module.finrank K (IN K M L s)=
     ∑ i∈Finset.range (M+1),
       ∑ j∈Finset.range (s+1),(L+1-i-j):=by
 rw [CBS K M L s hML]
 rw [Finset.sum_range]
 apply Finset.sum_congr rfl
 intro i hi
 rw [Finset.sum_range]
def ALC (M L s:ℕ):ℕ:=
 ∑ i∈Finset.range (M+1),
   ∑ j∈Finset.range (s+1),(L+1-i-j)
def TS (M L s h:ℕ):ℕ:=
 ∑ i∈Finset.range (M+1-h),
   ∑ j∈Finset.range (s+1-h),(L+1-h-i-j)
def AAT (M L s h:ℕ):ℕ:=
 ALC M L s-TS M L s h
theorem DFF (M L s h:ℕ) (hML:M≤L):
   Module.finrank K (LinearMap.range (blockJet K M L s h))≤
     AAT M L s h:=by
 by_cases hM:h≤M
 · by_cases hs:h≤s
   · have hL:h≤L:=hM.trans hML
     have hineq:=CPA K hM hL hs
     rw [ABG K M L s hML,
       ABG K (M-h) (L-h) (s-h)
         (Nat.sub_le_sub_right hML h)] at hineq
     have hMeq:M-h+1=M+1-h:=by omega
     have hLeq:L-h+1=L+1-h:=by omega
     have hseq:s-h+1=s+1-h:=by omega
     rw [hMeq,hLeq,hseq] at hineq
     unfold AAT ALC TS
     omega
   · have hzero:s+1-h=0:=by omega
     have hinput:=DOA K M L s h hML
     simpa [AAT,TS,ALC,
       hzero,Finset.sum_range] using hinput
 · have hzero:M+1-h=0:=by omega
   have hinput:=DOA K M L s h hML
   simpa [AAT,TS,ALC,
     hzero,Finset.sum_range] using hinput
def ES (m L s:ℕ):ℕ:=
 ∑ r∈Finset.range m,
   AAT (min r L) L s (min (r+1) (m-r))
end
end ProximityPrize.SubmissionLower.RCN119
end PackedLegacy_BC

section PackedLegacy_C1
namespace ProximityPrize.SubmissionLower.RCN100
open RCN119 ProximityPrize.Benchmark
open scoped BigOperators
noncomputable section
variable (K:Type*) [Field K]
theorem DFT {M L s M' L' s':ℕ}
   (hM:M≤M') (hL:L≤L') (hs:s≤s'):
   IN K M L s≤IN K M' L' s':=by
 apply MvPolynomial.restrictSupport_mono
 intro d hd
 exact ⟨hd.1.trans hM,hd.2.1.trans hL,hd.2.2.trans hs⟩
def AOZ (f j z:ℕ):Poly K:=
 MvPolynomial.monomial
   (Finsupp.single 0 f+Finsupp.single 1 j+Finsupp.single 2 z) 1
theorem BSJ (f j z:ℕ):
   AOZ K f j z∈IN K f (f+j+z) j:=by
 apply (MvPolynomial.monomial_mem_restrictSupport (R:=K)).mpr
 left
 simp [boxExponents]
def seedAffine (u₀ u₁:K):Poly K:=
 MvPolynomial.C u₀+MvPolynomial.monomial (Finsupp.single 2 1) u₁
theorem ERH (u₀ u₁:K):
   seedAffine K u₀ u₁∈IN K 0 1 0:=by
 apply (IN K 0 1 0).add_mem
 · change MvPolynomial.monomial 0 u₀∈_
   apply (MvPolynomial.monomial_mem_restrictSupport (R:=K)).mpr
   left
   simp [boxExponents]
 · apply (MvPolynomial.monomial_mem_restrictSupport (R:=K)).mpr
   left
   simp [boxExponents]
theorem DMC (u₀ u₁:K) (t:ℕ):
   seedAffine K u₀ u₁^t∈IN K 0 t 0:=by
 induction t with
 | zero=>
     simp only [pow_zero]
     change MvPolynomial.monomial 0 (1:K)∈_
     apply (MvPolynomial.monomial_mem_restrictSupport (R:=K)).mpr
     left
     simp [boxExponents]
 | succ t ih=>
     simpa only [pow_succ,Nat.zero_add] using
       ASV K ih (ERH K u₀ u₁)
abbrev ED (D w L s:ℕ):=
 (i:Fin (L+1)) × (j:Fin (s+1)) ×
   (Fin (L+1-i.val-j.val) ×
     Fin (D-w*i.val-(w-1)*j.val))
def _Q8 {D w L s:ℕ} (c:ED D w L s):Fin 4→₀ ℕ:=
 Finsupp.single 0 c.2.2.2.val+Finsupp.single 1 c.1.val+
   Finsupp.single 2 c.2.1.val+Finsupp.single 3 c.2.2.1.val
@[simp] theorem CLW {D w L s:ℕ} (c:ED D w L s):
   _Q8 c 0=c.2.2.2.val:=by simp [_Q8]
@[simp] theorem CLD {D w L s:ℕ} (c:ED D w L s):
   _Q8 c 1=c.1.val:=by simp [_Q8]
@[simp] theorem CKG {D w L s:ℕ} (c:ED D w L s):
   _Q8 c 2=c.2.1.val:=by simp [_Q8]
@[simp] theorem DHK {D w L s:ℕ} (c:ED D w L s):
   _Q8 c 3=c.2.2.1.val:=by simp [_Q8]
theorem BPS (D w L s:ℕ):
   Function.Injective (_Q8 (D:=D) (w:=w) (L:=L) (s:=s)):=by
 intro c d h
 have hx:=congrArg (fun e:Fin 4→₀ ℕ=>e 0) h
 have hy:=congrArg (fun e:Fin 4→₀ ℕ=>e 1) h
 have hr:=congrArg (fun e:Fin 4→₀ ℕ=>e 2) h
 have hz:=congrArg (fun e:Fin 4→₀ ℕ=>e 3) h
 rcases c with ⟨⟨ci,hci⟩,⟨⟨cj,hcj⟩,⟨⟨cz,hcz⟩,⟨ce,hce⟩⟩⟩⟩
 rcases d with ⟨⟨di,hdi⟩,⟨⟨dj,hdj⟩,⟨⟨dz,hdz⟩,⟨de,hde⟩⟩⟩⟩
 simp only [CLW] at hx
 simp only [CLD] at hy
 simp only [CKG] at hr
 simp only [DHK] at hz
 subst di
 subst dj
 subst dz
 subst de
 rfl
def AEC (D w L s:ℕ):Set (Fin 4→₀ ℕ):=
 {d | d 1+d 2+d 3≤L∧d 2≤s∧
   d 0+w*d 1+(w-1)*d 2<D}
def BA (D w L s:ℕ):
   Submodule K (MvPolynomial (Fin 4) K):=
 MvPolynomial.restrictSupport K (AEC D w L s)
theorem DNB (D w L s:ℕ)
   (c:ED D w L s) (a:K):
   MvPolynomial.monomial (_Q8 c) a∈
     BA K D w L s:=by
 apply (MvPolynomial.monomial_mem_restrictSupport (R:=K)).mpr
 left
 have hi:=c.1.isLt
 have hj:=c.2.1.isLt
 have hz:=c.2.2.1.isLt
 have he:=c.2.2.2.isLt
 simp only [AEC,Set.mem_setOf_eq,CLW,
   CLD,CKG,DHK]
 omega
def reconstruct (D w L s:ℕ) (θ:ED D w L s→K):
   MvPolynomial (Fin 4) K:=
 ∑ c:ED D w L s,
   MvPolynomial.monomial (_Q8 c) (θ c)
theorem CTU (D w L s:ℕ)
   (θ:ED D w L s→K) (c:ED D w L s):
   AddMonoidAlgebra.coeff (reconstruct K D w L s θ) (_Q8 c)=θ c:=by
 classical
 simp [reconstruct,MvPolynomial.coeff_sum,
   (BPS D w L s).eq_iff]
@[simp] theorem ECW (D w L s:ℕ):
   reconstruct K D w L s (0:ED D w L s→K)=0:=by
 simp [reconstruct]
theorem ABR (D w L s:ℕ):
   Function.Injective (reconstruct K D w L s):=by
 intro θ η h
 funext c
 have hh:=congrArg (AddMonoidAlgebra.coeff · (_Q8 c)) h
 simpa only [CTU] using hh
theorem AVT (D w L s:ℕ)
   (θ:ED D w L s→K) (hθ:θ≠0):
   reconstruct K D w L s θ≠0:=by
 intro hzero
 apply hθ
 apply ABR K D w L s
 simpa only [ECW] using hzero
theorem LG (D w L s:ℕ)
   (θ:ED D w L s→K):
   reconstruct K D w L s θ∈BA K D w L s:=by
 classical
 unfold reconstruct
 apply Submodule.sum_mem
 intro c hc
 exact DNB K D w L s c (θ c)
def AW (D w L s:ℕ):ℕ:=
 ∑ i∈Finset.range (L+1),
   ∑ j∈Finset.range (s+1),
     (L+1-i-j)*(D-w*i-(w-1)*j)
theorem AUC (D w L s:ℕ):
   Fintype.card (ED D w L s)=AW D w L s:=by
 simp [ED,AW,Fintype.card_sigma,Finset.sum_range]
def blockEntry (D w L s:ℕ) (x u₀ u₁:K)
   (c:ED D w L s) (r:ℕ):Poly K:=
 ∑ f:Fin (c.1.val+1),
   if f.val≤r then
     (((c.2.2.2.val.choose (r-f.val):ℕ):K)*
       x^(c.2.2.2.val-(r-f.val))*
       ((c.1.val.choose f.val:ℕ):K)) •
         (seedAffine K u₀ u₁^(c.1.val-f.val)*
           AOZ K f.val c.2.1.val c.2.2.1.val)
   else 0
theorem DIP (D w L s:ℕ) (x u₀ u₁:K)
   (c:ED D w L s) (r:ℕ):
   blockEntry K D w L s x u₀ u₁ c r∈
     IN K (min r L) L s:=by
 classical
 unfold blockEntry
 apply Submodule.sum_mem
 intro f hf
 split_ifs with hfr
 · apply (IN K (min r L) L s).smul_mem
   have hi:=c.1.isLt
   have hj:=c.2.1.isLt
   have hz:=c.2.2.1.isLt
   have hfi:=f.isLt
   have hmul:=ASV K
     (DMC K u₀ u₁ (c.1.val-f.val))
     (BSJ K f.val c.2.1.val c.2.2.1.val)
   apply DFT K (show 0+f.val≤min r L by omega)
     (show c.1.val-f.val+
         (f.val+c.2.1.val+c.2.2.1.val)≤L by omega)
     (show 0+c.2.1.val≤s by omega)
   exact hmul
 · exact (IN K (min r L) L s).zero_mem
def ALR (D w L s:ℕ) (x u₀ u₁:K)
   (c:ED D w L s) (r:ℕ):
   IN K (min r L) L s:=
 ⟨blockEntry K D w L s x u₀ u₁ c r,
   DIP K D w L s x u₀ u₁ c r⟩
def extractBlock (D w L s:ℕ) (x u₀ u₁:K) (r:ℕ):
   (ED D w L s→K)→ₗ[K]
     IN K (min r L) L s where
 toFun θ:=∑ c:ED D w L s,
   θ c • ALR K D w L s x u₀ u₁ c r
 map_add' θ η:=by
   simp only [Pi.add_apply,add_smul,Finset.sum_add_distrib]
 map_smul' a θ:=by
   simp only [Pi.smul_apply,Finset.smul_sum,smul_smul,smul_eq_mul,RingHom.id_apply]
theorem CYX (r m L s:ℕ):
   AAT (min r L) L s (m-r)=
     AAT (min r L) L s (min (r+1) (m-r)):=by
 by_cases h:r+1≤m-r
 · have hM:min r L≤r:=min_le_left r L
   have hzero:min r L+1-(m-r)=0:=by omega
   have hzero':min r L+1-(r+1)=0:=by omega
   simp only [Nat.min_eq_left h,AAT,TS,
     hzero,hzero',Finset.range_zero,Finset.sum_empty,mul_zero,Nat.sub_zero]
 · have h':m-r≤r+1:=by omega
   rw [Nat.min_eq_right h']
abbrev LocalTarget (m L s:ℕ):=
 (r:Fin m)→LinearMap.range
   (blockJet K (min r.val L) L s (m-r.val))
theorem CID (m L s:ℕ):
   Module.finrank K (LocalTarget K m L s)≤ES m L s:=by
 change Module.finrank K ((r:Fin m)→LinearMap.range
   (blockJet K (min r.val L) L s (m-r.val)))≤_
 rw [Module.finrank_pi_fintype]
 unfold ES
 rw [Finset.sum_range]
 apply Finset.sum_le_sum
 intro r hr
 have hh:=DFF K (min r.val L) L s (m-r.val)
   (min_le_right r.val L)
 rw [CYX] at hh
 exact hh
abbrev GlobalTarget (I:Type*) (m L s:ℕ):=I→LocalTarget K m L s
theorem DJJ {I:Type*} [Fintype I] (m L s:ℕ):
   Module.finrank K (GlobalTarget K I m L s)≤
     Fintype.card I*ES m L s:=by
 change Module.finrank K (I→LocalTarget K m L s)≤_
 rw [Module.finrank_pi_fintype]
 calc
   (∑ _i:I,Module.finrank K (LocalTarget K m L s))≤
       ∑ _i:I,ES m L s:=by
     apply Finset.sum_le_sum
     intro i hi
     exact CID K m L s
   _=Fintype.card I*ES m L s:=by simp
def AMB {I:Type*} [Fintype I]
   (D w L s m:ℕ) (nodes u₀ u₁:I→K):
   (ED D w L s→K)→ₗ[K] GlobalTarget K I m L s:=
 LinearMap.pi fun i=>LinearMap.pi fun r=>
   (blockJet K (min r.val L) L s (m-r.val)).rangeRestrict.comp
     (extractBlock K D w L s (nodes i) (u₀ i) (u₁ i) r.val)
theorem ACY {I:Type*} [Fintype I]
   (D w L s m:ℕ) (nodes u₀ u₁:I→K)
   (hgate:Fintype.card I*ES m L s<AW D w L s):
   ∃θ:ED D w L s→K,
     θ≠0∧AMB K D w L s m nodes u₀ u₁ θ=0:=by
 classical
 by_contra hnone
 have hinj:Function.Injective (AMB K D w L s m nodes u₀ u₁):=by
   intro θ η heq
   by_contra hne
   apply hnone
   refine ⟨θ-η,sub_ne_zero.mpr hne,?_⟩
   rw [map_sub,heq,sub_self]
 have hdim:=LinearMap.finrank_le_finrank_of_injective hinj
 rw [Module.finrank_fintype_fun_eq_card,AUC] at hdim
 have hupper:=DJJ K (I:=I) m L s
 exact (Nat.not_le_of_gt hgate) (hdim.trans hupper)
theorem DGO
   (D w L s m:ℕ) (x u₀ u₁:K)
   (θ:ED D w L s→K)
   (h:∀r:Fin m,contactJet K (m-r.val)
     ((extractBlock K D w L s x u₀ u₁ r.val θ):Poly K)=0):
   ∀r:ℕ,IA K^(m-r)∣
     ((extractBlock K D w L s x u₀ u₁ r θ):Poly K):=by
 intro r
 by_cases hr:r<m
 · exact (XA K (m-r) _).mp (h ⟨r,hr⟩)
 · have hm:m-r=0:=by omega
   simp only [hm,pow_zero,one_dvd]
end
end ProximityPrize.SubmissionLower.RCN100
end PackedLegacy_C1

section PackedLegacy_BD
namespace ProximityPrize.SubmissionLower.RCN122
open RCN119 RCN100 ProximityPrize.Benchmark
open scoped BigOperators
noncomputable section
variable (K:Type*) [Field K]
abbrev AUF:=Polynomial (Poly K)
def AAP (x u₀ u₁:K):Fin 4→AUF K:=
 ![Polynomial.X+Polynomial.C (MvPolynomial.C x),
   Polynomial.X*Polynomial.C (MvPolynomial.X 0)+
     Polynomial.C (seedAffine K u₀ u₁),
   Polynomial.C (MvPolynomial.X 1),
   Polynomial.C (MvPolynomial.X 2)]
def EM (x u₀ u₁:K):
   MvPolynomial (Fin 4) K→ₐ[K] AUF K:=
 MvPolynomial.aeval (AAP K x u₀ u₁)
theorem DSE (D w L s:ℕ)
   (c:ED D w L s) (a:K):
   MvPolynomial.monomial (_Q8 c) a=
     MvPolynomial.C a*MvPolynomial.X 0^c.2.2.2.val*
       MvPolynomial.X 1^c.1.val*MvPolynomial.X 2^c.2.1.val*
       MvPolynomial.X 3^c.2.2.1.val:=by
 rw [_Q8,MvPolynomial.monomial_add_single,
   MvPolynomial.monomial_add_single,MvPolynomial.monomial_add_single,
   ←MvPolynomial.C_mul_X_pow_eq_monomial]
theorem EDQ (f j z:ℕ):
   AOZ K f j z=
     MvPolynomial.X 0^f*MvPolynomial.X 1^j*MvPolynomial.X 2^z:=by
 rw [AOZ,MvPolynomial.monomial_add_single,
   MvPolynomial.monomial_add_single,←MvPolynomial.X_pow_eq_monomial]
theorem CBO
   {A:Type*} [CommRing A] (x a y b:A) (e i r:ℕ):
   (((Polynomial.X+Polynomial.C x)^e*
       (Polynomial.X*Polynomial.C y+Polynomial.C a)^i*
       Polynomial.C b):Polynomial A).coeff r=
     ∑ f:Fin (i+1),if f.val≤r then
       (x^(e-(r-f.val))*(e.choose (r-f.val):A))*
         (y^f.val*a^(i-f.val)*(i.choose f.val:A)*b)
     else 0:=by
 rw [add_pow (Polynomial.X*Polynomial.C y) (Polynomial.C a) i,
   Finset.mul_sum,Finset.sum_mul,Polynomial.finsetSum_coeff]
 rw [Finset.sum_range]
 apply Finset.sum_congr rfl
 intro f hf
 have hfactor:
     (((Polynomial.X+Polynomial.C x)^e*
       ((Polynomial.X*Polynomial.C y)^f.val*
         Polynomial.C a^(i-f.val)*(i.choose f.val:Polynomial A)))*
         Polynomial.C b)=
       (((Polynomial.X+Polynomial.C x)^e*
         Polynomial.C (y^f.val*a^(i-f.val)*(i.choose f.val:A)*b))*
         Polynomial.X^f.val):=by
   simp only [mul_pow,map_mul,map_pow,map_natCast]
   ring
 rw [hfactor,Polynomial.coeff_mul_X_pow']
 split_ifs with hfr
 · rw [Polynomial.coeff_mul_C,Polynomial.coeff_X_add_C_pow]
 · rfl
theorem FNZ (D w L s:ℕ) (x u₀ u₁:K)
   (c:ED D w L s) (a:K):
   EM K x u₀ u₁ (MvPolynomial.monomial (_Q8 c) a)=
     Polynomial.C (MvPolynomial.C a)*
       (Polynomial.X+Polynomial.C (MvPolynomial.C x))^c.2.2.2.val*
       (Polynomial.X*Polynomial.C (MvPolynomial.X 0)+
         Polynomial.C (seedAffine K u₀ u₁))^c.1.val*
       Polynomial.C (MvPolynomial.X 1)^c.2.1.val*
       Polynomial.C (MvPolynomial.X 2)^c.2.2.1.val:=by
 rw [DSE K D w L s c a]
 simp [EM,AAP,
   Polynomial.algebraMap_apply,MvPolynomial.algebraMap_eq]
theorem BPP (D w L s:ℕ) (x u₀ u₁:K)
   (c:ED D w L s) (a:K) (r:ℕ):
   (EM K x u₀ u₁
     (MvPolynomial.monomial (_Q8 c) a)).coeff r=
       a • blockEntry K D w L s x u₀ u₁ c r:=by
 have hfactor:
     EM K x u₀ u₁
       (MvPolynomial.monomial (_Q8 c) a)=
     Polynomial.C (MvPolynomial.C a)*
       ((Polynomial.X+Polynomial.C (MvPolynomial.C x))^c.2.2.2.val*
         (Polynomial.X*Polynomial.C (MvPolynomial.X 0)+
           Polynomial.C (seedAffine K u₀ u₁))^c.1.val*
         Polynomial.C (MvPolynomial.X 1^c.2.1.val*
           MvPolynomial.X 2^c.2.2.1.val)):=by
   rw [FNZ K D w L s x u₀ u₁ c a]
   simp only [map_mul,map_pow]
   ring
 rw [hfactor,Polynomial.coeff_C_mul,CBO]
 unfold blockEntry
 rw [Finset.mul_sum,Finset.smul_sum]
 apply Finset.sum_congr rfl
 intro f hf
 split_ifs with hfr
 · simp only [EDQ,MvPolynomial.smul_eq_C_mul,
     map_mul,map_pow,map_natCast]
   ring
 · simp
theorem AMG (D w L s:ℕ) (x u₀ u₁:K)
   (θ:ED D w L s→K) (r:ℕ):
   (EM K x u₀ u₁ (reconstruct K D w L s θ)).coeff r=
     ((extractBlock K D w L s x u₀ u₁ r θ):Poly K):=by
 rw [reconstruct,map_sum,Polynomial.finsetSum_coeff]
 simp only [BPP]
 change (∑ c:ED D w L s,
   θ c • blockEntry K D w L s x u₀ u₁ c r)=
     (((∑ c:ED D w L s,
       θ c • ALR K D w L s x u₀ u₁ c r):
         IN K (min r L) L s):Poly K)
 simp [ALR]
def QL (R B:Polynomial K) (γ:K):Poly K→ₐ[K] Polynomial K:=
 MvPolynomial.aeval ![R+Polynomial.X*B,R,Polynomial.C γ]
def AMF (R B:Polynomial K) (γ:K):
   AUF K→+*Polynomial K:=
 Polynomial.eval₂RingHom (QL K R B γ).toRingHom Polynomial.X
@[simp] theorem AOW (R B:Polynomial K) (γ:K):
   QL K R B γ (IA K)=Polynomial.X*B:=by
 simp [QL,IA]
theorem BFT
   (H:AUF K) (m:ℕ) (R B:Polynomial K) (γ:K)
   (hcoeff:∀r:ℕ,IA K^(m-r)∣H.coeff r):
   (Polynomial.X:Polynomial K)^m∣AMF K R B γ H:=by
 classical
 change (Polynomial.X:Polynomial K)^m∣
   H.eval₂ (QL K R B γ).toRingHom Polynomial.X
 rw [Polynomial.eval₂_eq_sum]
 change (Polynomial.X:Polynomial K)^m∣
   ∑ r∈H.support,QL K R B γ (H.coeff r)*Polynomial.X^r
 apply Finset.dvd_sum
 intro r hr
 have hlocal:(Polynomial.X:Polynomial K)^(m-r)∣
     QL K R B γ (H.coeff r):=by
   obtain ⟨q,hq⟩:=hcoeff r
   refine ⟨B^(m-r)*QL K R B γ q,?_⟩
   simp only [hq,map_mul,map_pow,AOW,
     mul_pow,mul_assoc]
 have hprod:=mul_dvd_mul hlocal
   (dvd_refl ((Polynomial.X:Polynomial K)^r))
 have htotal:(Polynomial.X:Polynomial K)^((m-r)+r)∣
     QL K R B γ (H.coeff r)*Polynomial.X^r:=by
   simpa only [pow_add] using hprod
 exact (pow_dvd_pow Polynomial.X (show m≤(m-r)+r by omega)).trans htotal
def BM (P:Polynomial K) (γ:K):
   MvPolynomial (Fin 4) K→ₐ[K] Polynomial K:=
 MvPolynomial.aeval ![Polynomial.X,P,P.derivative,Polynomial.C γ]
