/-- The field `disjoint` of `ExchangeNeeds` fails for finitely many levels `c` only, when `A₁` is not
zero on the geometric components that carry a live curve. -/
theorem finite_not_disjoint (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω)
    (W : FlagDegree) (hc : ∀ j, sliceCoord P.F j ≠ 0) (N : ℕ)
    (hN : ∀ g sR sY sZ, SurfaceNoether (component P g) sR sY sZ N) (hNp : 3 * N < 2130706433)
    (hA : ∀ a ∈ active P SZ, function P SZ a.1 ≠ 0) :
    {c : Ω | ∃ a ∈ active P SZ,
      ¬LevelDisjoint (moving P Q A a.1) c (function P SZ a.1) W}.Finite :=
  (Set.Finite.biUnion (active P SZ).finite_toSet fun a ha =>
    finite_not_levelDisjoint (hN a.1) hNp (coordinate_ne_zero P a.1 hc) (moving P Q A a.1)
      (function P SZ a.1) (hA a ha) W).subset fun _ ⟨_, ha, h⟩ => Set.mem_biUnion ha h

end
