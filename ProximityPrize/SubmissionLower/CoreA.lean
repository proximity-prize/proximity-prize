def rankSlopeN (m s:ℕ):Diff:=
 let u:=min s (m/2)
 let K:=(s+1)*m*(m+1)
 let p0:=(m+1)*(s+1)
 let P:=m+2*s+3
 ⟨6*K+6*P*u*(u+1),12*p0*u+4*u*(u+1)*(2*u+1)⟩
def rankBaseN (m s:ℕ):Diff:=
 let u:=min s (m/2)
 let K:=(s+1)*m*(m+1)
 let p0:=(m+1)*(s+1)
 let P:=m+2*s+3
 let C:Diff:=⟨2,m+s⟩
 sub ⟨8*K,K*(2*m+3*s)⟩
  (add (add (scale (6*p0*u) C) (scale (3*u*(u+1)) (sub ⟨p0,0⟩ (scale P C))))
   (add (scale (u*(u+1)*(2*u+1)) (sub (scale 2 C) ⟨P,0⟩)) ⟨3*u*u*(u+1)*(u+1),0⟩))
