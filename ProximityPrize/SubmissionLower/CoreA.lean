    if m=i then MvPolynomial.X i- ∑ m' ∈ Finset.univ.erase i,C (c m')*MvPolynomial.X m' else MvPolynomial.X m
  let g:Fin 3→MvPolynomial (Fin 3) Ω:=fun m=>
