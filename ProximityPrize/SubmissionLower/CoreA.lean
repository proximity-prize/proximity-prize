    rw [AlgEquiv.apply_symm_apply,MvPolynomial.finSuccEquiv_X_zero]
  change surfaceMap (AL E) ((MvPolynomial.finSuccEquiv E 3).symm _)=_
  rw [hx,CSU]
  rfl

theorem ENL:
    VY E=Polynomial.eval₂RingHom (MvPolynomial.map (HO E))
      (MvPolynomial.C (MF E)):=by
