  have hh:=MvPolynomial.degreeOf_add_le (2:Fin 4)
    (MvPolynomial.X 0:Poly4 K) (MvPolynomial.C (-x))
  have hh0:(MvPolynomial.X 0+MvPolynomial.C (-x):Poly4 K).degreeOf 2≤0:=by
    simpa [MvPolynomial.degreeOf_X] using hh
