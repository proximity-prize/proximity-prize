  have hm:psi (2*polyH K F)*ev (MvPolynomial.C target-Q)-ev (2*A)*psi (polyG K F)∈J:=by
    have he:psi (2*polyH K F)*ev (MvPolynomial.C target-Q)-ev (2*A)*psi (polyG K F)=
