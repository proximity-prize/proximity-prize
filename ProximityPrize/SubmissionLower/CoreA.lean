 simp [FI.num]

theorem FKP (L U S r y t:ℕ)
 (hr:1≤r∨r=0∧y=0∧t=0):(NN L U S r y t:ℤ)=NZ L U S r y t:=by
 rcases hr with hr | ⟨rfl,rfl,rfl⟩
