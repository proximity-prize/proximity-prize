        by_cases hiV:i ∈ V
        · exact hrest i (Finset.mem_sdiff.mpr ⟨hiV,hiU⟩)
        · exact hexit i (Finset.mem_sdiff.mpr ⟨hiB,hiV⟩)
      · exact ⟨B,Finset.Subset.refl _,hr,by simp⟩
