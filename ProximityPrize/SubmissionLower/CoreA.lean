theorem CTQ:Module.Flat (MvPolynomial σ R) (MvPolynomial σ S):=by
  exact Module.Flat.of_linearEquiv
    (Algebra.IsPushout.equiv R (MvPolynomial σ R) S (MvPolynomial σ S)).symm.toLinearEquiv

