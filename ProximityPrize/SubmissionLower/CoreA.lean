  [Algebra (GenericField K) E] [Algebra (RatFunc (GenericField K)) E]
  [IsScalarTower (GenericField K) (RatFunc (GenericField K)) E]
  [Fintype A]
local instance:DecidableEq K:=Classical.decEq K
