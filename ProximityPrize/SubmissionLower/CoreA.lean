def rawCost (r v z:ℕ):ℕ:=ANG ⟨z,v,r⟩

theorem DRY (r v z:ℕ) (hr:3≤r) (hv:2≤v):
    UG (⟨z,v,r⟩:FlagDegree):=by
  change 3≤r∧r+2≤v+r
  omega

theorem DQJ (r v z:ℕ) (hr:2≤r):
    padS (⟨z,v,r⟩:FlagDegree)=r:=by
  simp only [padS]
  omega

theorem DRD (r v z:ℕ) (hr:2≤r) (hv:2≤v):
    padY (⟨z,v,r⟩:FlagDegree)=r+v:=by
