noncomputable section
open scoped Classical BigOperators
open WithZero
open RCN002 RCN046 RCN074 RCN086 RCN095 RCN130 RCN135 RCN156 RCN199 RCN222 RCN234 RCN237 RCN238 RCN243
open RCN264 RCN313 RCN334 RCN340 RCN344
open FA PR BD HK HFreeDir6813 HFree6812 DU BLL AYR BIO BBT _Q7 AFA RL TW CB BOE
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] LevelComponent.isPrime Exch.component_isPrime

/-- All that the count on the level curve asks of `Q`, `A`, `c` and of the curves `S a`:

* `component`: on every geometric component the conditions `LevelCount.Needs` for `c`;
* `live`: no live curve is a component of the level curve;
* `closure`: the local ring of a live curve at a point of the level curve where the moving function is
  regular has a finite integral closure;
* `levelClosure`: the local ring of a component of the level curve at each of its points, the points at
  infinity included, has a finite integral closure. -/
structure LevelNeeds (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1)) : Prop where
  component : ∀ g, LevelCount.Needs (Exch.component P g) (P.stage g).G (baseH P.F)
    (Exch.moving P Q A g) c (Exch.function P SZ g)
  live : ∀ a ∈ active P SZ, (S a).val (Exch.moving P Q A a.1 -
    algebraMap Ω (AJ Ω (Exch.component P a.1)) c) = 1
  closure : ∀ a ∈ active P SZ, ∀ (q : SurfacePoint (Exch.component P a.1)) (hq : q.On (S a)),
    Exch.moving P Q A a.1 ∈ q.ring → q.level (Exch.moving P Q A a.1) c ≠ 0 →
      Module.Finite ((S a).image hq) (integralClosure ((S a).image hq) (AJ Ω a.2.1))
  levelClosure : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c)
    (q : SurfacePoint (Exch.component P g)) (hq : q.On B.curve),
    Module.Finite (B.curve.image hq) (integralClosure (B.curve.image hq) (AJ Ω B.prime))

/-- The section bound (package M2 of lane M): `scale * [L_c . e_j] ≤ (z, u, v)_j` for the three unit
flags, for every finite set of components of the level curves of the geometric components and every
finite set of places of each. For the pair of the tree `scale = stageScale SZ delta` and `z`, `u`, `v`
are the three heights of `PacketFrame.point_budget`. -/
def SectionBound (P : Packet x t y r) (scale z u v : ℕ) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω) : Prop :=
  ∀ (s : ∀ g, Finset (LevelComponent (Exch.component P g) (Exch.moving P Q A g) c))
    (T : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c),
      Finset (RCN026.Place Ω (AJ Ω B.prime))),
    (scale : ℤ) * (∑ g, levelFlagSum (s g) (T g) unitZFlag) ≤ (z : ℤ) ∧
      (scale : ℤ) * (∑ g, levelFlagSum (s g) (T g) unitYZFlag) ≤ (u : ℤ) ∧
      (scale : ℤ) * (∑ g, levelFlagSum (s g) (T g) unitAllFlag) ≤ (v : ℤ)

/-- The count of `A₁` on the level curve for one packet, as a statement: for a flag `Hf` of `H` for which
the flag `Exch.flag SZ Hf` of `A₁` is below `d • cellCutR + 4 (w + 1) • SZ.flag`, and free numbers
`scale`, `z`, `u`, `v`, lane G's `LevelCount` for `moving a = curveMoving (S a) f c` and
`Lam = Exch.lam P SZ Q A c (Exch.flag SZ Hf)`. Hypotheses, in this order: the curves; the flag; the needs;
lane M (the section bound); lanes A, C, X as in `Exch.Statement.exchange_count` (nonzero coordinates,
`PsiSIntegral`, `SurfaceNoether`, the tail bridge); the flags of `Q` and `A` (they bound the degree of
the level cut, which gives the separable coordinate of the components of the level curve:
`LevelCount.separable`). -/
def LevelCount.Statement (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) (scale z u v : ℕ) : Prop :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  ∀ (Hf : FlagDegree) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1)),
    (∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a)) →
    ((Exch.flag SZ Hf).zOnly ≤ SZ.d * (cellCutR t y r).zOnly + 4 * (w + 1) * SZ.flag.zOnly ∧
      (Exch.flag SZ Hf).yz ≤ SZ.d * (cellCutR t y r).yz + 4 * (w + 1) * SZ.flag.yz ∧
      (Exch.flag SZ Hf).all ≤ SZ.d * (cellCutR t y r).all + 4 * (w + 1) * SZ.flag.all) →
    LevelNeeds P SZ Q A c S →
    SectionBound P scale z u v Q A c →
    (∀ j, sliceCoord P.F j ≠ 0) →
    (∀ sR sY sZ, PsiSIntegral P.F P.F (dvd_refl P.F) SZ Hf sR sY sZ) →
    ∀ N : ℕ, (∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N) → 3 * N < 2130706433 →
    Exch.TailOrder P hp SZ S →
    BI (2 • unitAllFlag) Q → BI unitYZFlag A →
    LevelCount P hp SZ scale z u v (fun a => curveMoving (S a) (Exch.moving P Q A a.1) c)
      (Exch.lam P SZ Q A c (Exch.flag SZ Hf))

end
end Packet

