theorem CXI {I:Type*} [Fintype I]
    (phi:I→(A→ₐ[K] K)) (hinj:Function.Injective phi)
    (mu:I→ℕ) (hmu: ∀i,1≤mu i) (a b:A)
    (ha: ∀i,a ∈ (RingHom.ker (phi i).toRingHom)^(mu i))
    (hb: ∀i,phi i b ≠ 0)
    (hx:algebraMap A L a/algebraMap A L b ≠ 0):
