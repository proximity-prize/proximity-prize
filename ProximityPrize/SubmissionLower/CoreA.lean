theorem GYM (D x c:ℕ) (h:D≤x):
    (D-c)+((D+1-c)-(D-c))*(x-D)≤x-c:=by
  by_cases hc:c≤D
  · have h1:(D+1-c)-(D-c)=1:=by omega
    rw [h1,one_mul]
    omega
  · have h1:(D+1-c)-(D-c)=0:=by omega
    rw [h1,zero_mul]
