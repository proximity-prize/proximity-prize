/-!
The objects of level E (package E0 of lane E): every definition that the packages X1, X3 and X4 and the three
counts share. No statement with an open proof is in this file; the statements about these objects are in
`FRSurfLocal`, `FRSurfClosure`, `FRSurfLevel`, `FRSurfCurve`.

Level E: `E` is the constant field (the tree's `GenericField K`), `G` the prime of a geometric component of
the carrier in `E[Y, R, Z]`, `AJ E G` its function field, `surfaceChartRing G sR sY sZ` a chart ring.
Design and the paper statement behind each item: `design.md` beside this file.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero MvPolynomial HFree6812
open RCN002 RCN095

noncomputable section

/-! ## Local rings inside the function field (Mathlib only) -/

section Local

/-- Every prime ideal that strictly contains a nonzero prime ideal is maximal. -/
def PrimeChain (A : Type*) [CommRing A] : Prop :=
  ∀ p p' : Ideal A, p.IsPrime → p'.IsPrime → p ≠ ⊥ → p < p' → p'.IsMaximal

/-- `λ_D(g) = Σ_P D(P) · length O/(P + gO)`: the local number of the divisor `D` and the function `g`,
in the form of the lemmas of `FRLemmaX`. -/
def localNumber {O : Type*} [CommRing O] (D : Divisor O) (g : O) : ℕ∞ :=
  D.sum fun P m => (m : ℕ∞) * Module.length O (O ⧸ (P.ideal ⊔ Ideal.span {g}))

variable {A : Type*} [CommRing A] [IsDomain A] (L : Type*) [Field L] [Algebra A L]
  [IsFractionRing A L]

/-- The local ring of `A` at the prime `q`, inside the fraction field `L`. -/
abbrev pointRing (q : Ideal A) [q.IsPrime] : Subalgebra A L :=
  Localization.subalgebra.ofField L q.primeCompl q.primeCompl_le_nonZeroDivisors

/-- The centre on `A` of a valuation of `L` that is at most 1 on `A`. -/
def centre (v : Valuation L ℤᵐ⁰) (h : ∀ a : A, v (algebraMap A L a) ≤ 1) : Ideal A where
  carrier := {a | v (algebraMap A L a) < 1}
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq, map_add] at ha hb ⊢
    exact (v.map_add _ _).trans_lt (max_lt ha hb)
  zero_mem' := by simp
  smul_mem' := by
    intro c x hx
    simp only [Set.mem_ofPred_eq, smul_eq_mul, map_mul] at hx ⊢
    exact lt_of_le_of_lt (mul_le_of_le_one_left' (h c)) hx

end Local

/-! ## The level curve of a function at a normal ring -/

section Level

variable {O : Type*} [CommRing O] [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O]
  (L : Type*) [Field L] [Algebra O L] [IsFractionRing O L]

open Classical in
/-- The zero divisor of a function: `P ↦ max 0 (ord_P x)`. -/
def zeroDivisor (x : L) : Divisor O :=
  if h : (Function.support fun P : PrimeDivisor O => (-(P.valuation L x).log).toNat).Finite then
    Finsupp.ofSupportFinite _ h else 0

variable {E : Type*} [Field E] [Algebra E L]

/-- The level curve `L_c` of `f` on `O`: the zero divisor of `f - c`, with its multiplicities. -/
def levelDivisor (f : L) (c : E) : Divisor O := zeroDivisor L (f - algebraMap E L c)

/-- `O(-n L_c)`. -/
def levelIdeal (f : L) (c : E) (n : ℕ) : Ideal O :=
  divisorIdeal L (n • levelDivisor (O := O) L f c)

end Level

/-! ## Prime divisors with a residue map: curves (generic part) -/

section Specialization

/-- A prime divisor of a function field `L` together with its residue map: a normalized valuation of `L`
and a surjective ring homomorphism from its valuation ring onto the field `F` (the function field of the
curve) whose kernel is the maximal ideal. -/
structure Specialization (L F : Type*) [Field L] [Field F] where
  val : Valuation L ℤᵐ⁰
  surjective : Function.Surjective val
  res : val.valuationSubring →+* F
  res_surjective : Function.Surjective res
  res_eq_zero_iff : ∀ x, res x = 0 ↔ val (x : L) < 1

variable {O : Type*} [CommRing O] {L : Type*} [Field L] [Algebra O L] {F : Type*} [Field F]

/-- The restriction to the curve of the functions of a ring `O` all of whose elements are regular along
the curve (`O` is the local ring of a point of the curve). -/
def Specialization.resOn (S : Specialization L F) (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1) :
    O →+* F :=
  S.res.comp ((algebraMap O L).codRestrict S.val.valuationSubring fun a =>
    (Valuation.mem_valuationSubring_iff S.val _).mpr (hO a))

/-- The local ring of the curve at the point, inside the function field of the curve: `O / P`. -/
def Specialization.image (S : Specialization L F) (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1) :
    Subring F :=
  (S.resOn hO).range

variable (E : Type*) [Field E] [Algebra E F]

/-- The places of the curve over the point, as places of the tree: the normalized valuations of the
function field of the curve, trivial on `E`, that are at most 1 on its local ring `O / P`. -/
def Specialization.placesOn (S : Specialization L F) (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1) :
    Set (RCN026.Place E F) :=
  {μ | ∀ b ∈ S.image hO, μ.val b ≤ 1}

variable {E}

/-- `o_μ`: the least order at the place `μ` of the restriction to the curve of an element of the ideal
`I` of `O` that does not vanish along the curve. -/
def Specialization.leastOrder (S : Specialization L F) (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1)
    (I : Ideal O) (μ : Valuation F ℤᵐ⁰) : ℕ :=
  sInf {k : ℕ | ∃ x ∈ I, S.val (algebraMap O L x) = 1 ∧ μ (S.resOn hO x) = exp (-(k : ℤ))}

/-- The sum over the places `μ` of the curve over the point of `o_μ(n)`, the least order of
`O(-n L_c)`. -/
def Specialization.levelOrder [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O]
    [IsFractionRing O L] [Algebra E L] (S : Specialization L F)
    (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1) (f : L) (c : E) (n : ℕ) : ℕ :=
  ∑ᶠ μ ∈ S.placesOn E hO, S.leastOrder hO (levelIdeal L f c n) μ.val

end Specialization

/-! ## The normalized charts of a geometric component over `E` and the points of the model -/

section Surface

variable {E : Type} [Field E] (G : Ideal (MvPolynomial (Fin 3) E)) [G.IsPrime] (sR sY sZ : Bool)

/-- The normalized chart: the integral closure of the chart ring in the function field. -/
abbrev normalChart : Subalgebra E (AJ E G) :=
  (integralClosure (surfaceChartRing G sR sY sZ) (AJ E G)).restrictScalars E

/-- The valuations of the prime divisors of the normalized chart of `G` over `E`: normalized, at most 1
on the chart ring, with a transcendental residue. -/
structure SurfaceDivisor (nu : Valuation (AJ E G) ℤᵐ⁰) : Prop where
  surjective : Function.Surjective nu
  le_one : ∀ a ∈ surfaceChartRing G sR sY sZ, nu a ≤ 1
  nonconst : ∃ t ∈ surfaceChartRing G sR sY sZ, Transcendental E t ∧
    ∀ a ∈ IntermediateField.adjoin E {t}, a ≠ 0 → nu a = 1

/-- Assumed from package W2 over `E` (lane A): separating Noether normalization of the chart ring of `G`,
in the shape of `ChartNoether`. -/
def SurfaceNoether (N : ℕ) : Prop :=
  ∃ s₁ ∈ surfaceChartRing G sR sY sZ, ∃ s₂ ∈ surfaceChartRing G sR sY sZ,
    AlgebraicIndependent E ![s₁, s₂] ∧
    (∀ a ∈ surfaceChartRing G sR sY sZ, IsIntegral (Algebra.adjoin E {s₁, s₂}) a) ∧
    ∀ a : AJ E G, ∃ Q : Polynomial (IntermediateField.adjoin E {s₁, s₂}),
      Q ≠ 0 ∧ Q.natDegree ≤ 3 * N ∧ Polynomial.aeval a Q = 0

/-- A closed point of the normalized model of the surface (the normalization of its closure in the flag
toric threefold), as its local ring inside the function field: the local ring of a normalized chart at a
closed point, with the properties that Lemma X uses. Two charts give the same point exactly when they
give the same local ring. -/
structure SurfacePoint where
  ring : Subalgebra E (AJ E G)
  isNoetherianRing : IsNoetherianRing ring
  isIntegrallyClosed : IsIntegrallyClosed ring
  isFractionRing : IsFractionRing ring (AJ E G)
  primeChain : PrimeChain ring
  residue : ∃ φ : ring →ₐ[E] E, ∀ x, φ x = 0 ↔ ¬IsUnit x
  chart : ∃ sR sY sZ, normalChart G sR sY sZ ≤ ring ∧
    ∀ x ∈ ring, ∃ s ∈ normalChart G sR sY sZ, s ≠ 0 ∧ s⁻¹ ∈ ring ∧ x * s ∈ normalChart G sR sY sZ

attribute [local instance] SurfacePoint.isNoetherianRing SurfacePoint.isIntegrallyClosed
  SurfacePoint.isFractionRing

variable {G}

namespace SurfacePoint

theorem ext_ring {q q' : SurfacePoint G} (h : q.ring = q'.ring) : q = q' := by
  cases q
  cases q'
  cases h
  rfl

variable (q : SurfacePoint G)

/-- A chart whose normalized ring has `q` as the local ring of a closed point. -/
def chartOf : Bool × Bool × Bool :=
  (q.chart.choose, q.chart.choose_spec.choose, q.chart.choose_spec.choose_spec.choose)

theorem chartOf_spec : normalChart G q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2 ≤ q.ring ∧
    ∀ x ∈ q.ring, ∃ s ∈ normalChart G q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2,
      s ≠ 0 ∧ s⁻¹ ∈ q.ring ∧ x * s ∈ normalChart G q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2 :=
  q.chart.choose_spec.choose_spec.choose_spec

/-- `g_u = A₁ · χ^(-u(W))` for the chart `u` of the point: the function `A₁` times the monomial of the
flag `W` that clears its poles along the boundary of that chart. -/
def localFunction (A₁ : AJ E G) (W : FlagDegree) : AJ E G :=
  A₁ / lmono (coordinate E G) (vertexExp q.chartOf.1 q.chartOf.2.1 q.chartOf.2.2 W)

/-- The level curve `L_c` of `f` at the point, with its multiplicities; the point lies on `L_c` when it
is not `0`. The point is a moving point when moreover `f ∈ q.ring`, a base point when `f ∉ q.ring`. -/
def level (f : AJ E G) (c : E) : Divisor q.ring :=
  levelDivisor (AJ E G) f c

open Classical in
/-- `λ_(L_c, q)(g)` for a function `g` that is regular at the point. -/
def levelNumber (f : AJ E G) (c : E) (g : AJ E G) : ℕ :=
  if h : g ∈ q.ring then (localNumber (q.level f c) ⟨g, h⟩).toNat else 0

variable {F : Type*} [Field F]

/-- The curve passes through the point: the functions that are regular at the point are regular along
the curve. -/
abbrev On (S : Specialization (AJ E G) F) : Prop :=
  ∀ a : q.ring, S.val (algebraMap q.ring (AJ E G) a) ≤ 1

variable [Algebra E F]

open Classical in
/-- The sum over the places `μ` of the curve over the point of `o_μ(n)`, the least order at `μ` of an
element of `O_q(-n L_c)` outside the prime of the curve; `0` when the curve does not pass through the
point. -/
def order (S : Specialization (AJ E G) F) (f : AJ E G) (c : E) (n : ℕ) : ℕ :=
  if h : q.On S then S.levelOrder h f c n else 0

end SurfacePoint

variable {F : Type*} [Field F] [Algebra E F]

open Classical in
/-- `moving a`: the sum over the moving points of `L_c` on the curve (points where `f` is regular) and
over the places `μ` of the curve over them of `o_μ(1) = ord_μ((f - c) restricted to the curve)`. -/
def curveMoving (S : Specialization (AJ E G) F) (f : AJ E G) (c : E) : ℕ :=
  ∑ᶠ q : SurfacePoint G, if f ∈ q.ring then q.order S f c 1 else 0

open Classical in
/-- `o n a`: the sum over the base points of `L_c` on the curve (points where `f` is not regular) and
over the places `μ` of the curve over them of `o_μ(n)`. -/
def curveBase (S : Specialization (AJ E G) F) (f : AJ E G) (c : E) (n : ℕ) : ℕ :=
  ∑ᶠ q : SurfacePoint G, if f ∈ q.ring then 0 else q.order S f c n

open Classical in
/-- `Lam` on one geometric component: the sum over the base points `q` of `L_c` of
`λ_(L_c, q)(g_u)`. -/
def baseNumber (f : AJ E G) (c : E) (A₁ : AJ E G) (W : FlagDegree) : ℕ :=
  ∑ᶠ q : SurfacePoint G, if f ∈ q.ring then 0 else q.levelNumber f c (q.localFunction A₁ W)

end Surface

/-! ## Curves of the tree on the surface: live curves, components of a level curve and of sections -/

section Curve

variable {E : Type} [Field E] (G C : Ideal (MvPolynomial (Fin 3) E)) [G.IsPrime] [C.IsPrime]

/-- `S` is the curve `C` of the surface `G` as a prime divisor: polynomials are regular along it and
their residues are their restrictions to `C`, in the tree's function field `AJ E C` of the curve. -/
def IsCurveOnSurface (S : Specialization (AJ E G) (AJ E C)) : Prop :=
  ∀ A : MvPolynomial (Fin 3) E, ∃ h : BR E G A ∈ S.val.valuationSubring,
    S.res ⟨BR E G A, h⟩ = BR E C A

/-- `[C . W] ≤ d`: the poles of the flag `W` on the curve `C`, summed over any set of its places, are at
most `d` (the form of the tree's budgets). -/
def FlagDegreeLE (C : Ideal (MvPolynomial (Fin 3) E)) [C.IsPrime] (W : FlagDegree) (d : ℕ) : Prop :=
  ∀ T : Finset (RCN026.Place E (AJ E C)),
    ∑ v ∈ T, RCN204.flagPole v.val (coordinate E C) W ≤ (d : ℤ)

end Curve

end

end ProximityPrize.SubmissionLower.FormalR
