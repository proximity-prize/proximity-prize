  letI:CharP (GenericField K) 2130706433:=MP K 2130706433
  set p:=BG Q R with hp
  have hRdata:=ALY Q R.1 hQ D 131071 P.total P.s hbox R.2
  have hRsmall:R.1.degreeOf (2:Fin 4)<2130706433:=
