/-!
Checkpoint P2-0 of lane E2: the two conversions between lengths and places at a point of the surface, as
`Prop`-valued definitions (statements only; the proofs are in `FRPlaceSurf`).

`O` is the local ring of a point, `S` a curve through it whose local ring `S.image hO` (`O / P` inside the
function field `F` of the curve) has a finite integral closure, `P` the prime of the curve in `O`. The
statements are written for an abstract ring and instantiated at `q.ring`: lengths over `q.ring` do not
elaborate when written directly (design of lane E, decision 5).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.PlaceSurf.Statement

open WithZero MvPolynomial
open RCN002

section Generic

variable {O : Type*} [CommRing O] {L : Type*} [Field L] [Algebra O L] {F : Type*} [Field F]
  (E : Type*) [Field E] [Algebra E F] (S : Specialization L F)
  (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1)

/-- (p2) at the ring `O`: for `h` outside the prime `P` of the curve, the length of `O / (P + hO)` is the
number of zeros of the restriction of `h` to the curve at the places over the point. -/
def LengthEqZeros : Prop :=
  ∀ P : Ideal O, (∀ x : O, x ∈ P ↔ S.val (algebraMap O L x) < 1) → ∀ h : O, h ∉ P →
    Module.length O (O ⧸ (P ⊔ Ideal.span {h})) =
      ((∑ᶠ μ ∈ S.placesOn E hO, (RCN026.order E F μ (S.resOn hO h)).toNat : ℕ) : ℕ∞)

/-- (p1) at the ring `O`: the least orders of an ideal `I` outside the prime `P` of the curve, summed over
the places over the point, are at most the length of `O / (P + I)` plus a constant that does not depend
on `I`. -/
def LeastOrderLE : Prop :=
  ∀ P : Ideal O, (∀ x : O, x ∈ P ↔ S.val (algebraMap O L x) < 1) → ∀ I : Ideal O, ¬I ≤ P →
    ((∑ᶠ μ ∈ S.placesOn E hO, S.leastOrder hO I μ.val : ℕ) : ℕ∞) ≤
      Module.length O (O ⧸ (P ⊔ I)) + closureColength (S.image hO) F

/-- The places over the point are finitely many when the prime of the curve is not the closed point. -/
def FinitePlaces : Prop :=
  ∀ P : Ideal O, (∀ x : O, x ∈ P ↔ S.val (algebraMap O L x) < 1) → ¬P.IsMaximal →
    (S.placesOn E hO).Finite

end Generic

section Ring

variable (O : Type*) [CommRing O] [IsDomain O] [IsNoetherianRing O] [IsIntegrallyClosed O]
  [IsLocalRing O] (L : Type*) [Field L] [Algebra O L] [IsFractionRing O L] (F : Type*) [Field F]
  (E : Type*) [Field E] [IsAlgClosed E] [Algebra E F]

/-- The three statements for a Noetherian integrally closed local domain `O` in which a prime that
strictly contains a nonzero prime is maximal, with a residue map onto the algebraically closed field `E`. -/
def generic (C : ∀ (S : Specialization L F), (∀ a : O, S.val (algebraMap O L a) ≤ 1) → Prop) : Prop :=
  PrimeChain O → ∀ φ : O →+* E, Function.Surjective φ →
    ∀ (S : Specialization L F) (hO : ∀ a : O, S.val (algebraMap O L a) ≤ 1),
      Module.Finite (S.image hO) (integralClosure (S.image hO) F) → C S hO

def length_eq_zeros : Prop := generic O L F E fun S hO => LengthEqZeros E S hO

def leastOrder_le : Prop := generic O L F E fun S hO => LeastOrderLE E S hO

def finite_places : Prop := generic O L F E fun S hO => FinitePlaces E S hO

end Ring

section Surface

variable (E : Type) [Field E] [IsAlgClosed E] (G : Ideal (MvPolynomial (Fin 3) E)) [G.IsPrime]
  (F : Type*) [Field F] [Algebra E F]

/-- The three statements at a point of the model. -/
def surface (C : ∀ (q : SurfacePoint G) (S : Specialization (AJ E G) F), q.On S → Prop) : Prop :=
  ∀ (q : SurfacePoint G) (S : Specialization (AJ E G) F) (hq : q.On S),
    Module.Finite (S.image hq) (integralClosure (S.image hq) F) → C q S hq

def surfacePoint_length_eq_zeros : Prop := surface E G F fun _ S hq => LengthEqZeros E S hq

def surfacePoint_leastOrder_le : Prop := surface E G F fun _ S hq => LeastOrderLE E S hq

def surfacePoint_finite_places : Prop := surface E G F fun _ S hq => FinitePlaces E S hq

end Surface

end ProximityPrize.SubmissionLower.FormalR.PlaceSurf.Statement
end
