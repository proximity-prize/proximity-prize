theorem ACZ (z d:ℕ) (hz:2≤z):
    paddedTail (⟨z,0,1⟩:FlagDegree) d=
      ⟨2*(z-2)*d,1+2*d,2*d⟩:=by
  unfold paddedTail padT padY padS middle total
  norm_num
  have hm:max (z+1) 3=z+1:=by omega
