    (Nat.le_add_right _ _) (by have:=Nat.mul_le_mul_left (beta+1) ht;omega)
  have e1:Ehi+(beta+1)*H-Ehi=(beta+1)*H:=by omega
  have e2:Ehi+(beta+1)*H-(Ehi+(beta+1)*t)=(beta+1)*(H-t):=by
    rw [Nat.mul_sub];omega
