theorem DUA (r z:ℕ) (hr:2≤r):
    2*rawCost r 1 (z+1)=rawCost r 1 z+rawCost r 1 (z+2):=by
  have hn (x:ℕ): ¬UG (⟨x,1,r⟩:FlagDegree):=by
