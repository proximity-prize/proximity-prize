variable {K:Type*} [CommRing K]

theorem EXT (q:Polynomial K):
    (Polynomial.X:Polynomial K)^3 ∣
      q-C (q.coeff 0)-Polynomial.X*q.derivative+Polynomial.X^2*hasseDeriv 2 q:=by
  rw [X_pow_dvd_iff]
  intro d hd
  interval_cases d<;>
