/-!
The curves of a packet as prime divisors of the geometric components, and the finite exclusions of the
level `c` of the data of the three counts.

Every condition on `c` fails for at most one `c` per object: per active curve (`off_level`), per seed
(`seed`), per geometric component (`component_ne`), and per prime divisor of the eight charts along which
one of six functions, none zero on the component, has a zero or a pole (`component_unit`; finitely many
such divisors by `finite_surfaceDivisor_ne_one`).
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.Data

open WithZero MvPolynomial HFree6812
open RCN002 RCN095

section Surface

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime]

/-- The levels `c` for which `f - c` vanishes along a prime divisor of the eight charts on which a
nonzero function `x` has a zero or a pole are finitely many. -/
theorem finite_level_ne_one {N p : ℕ} [CharP E p] (hN : ∀ sR sY sZ, SurfaceNoether G sR sY sZ N)
    (hp : 3 * N < p) (f x : AJ E G) (hx : x ≠ 0) :
    {c : E | ∃ nu : Valuation (AJ E G) ℤᵐ⁰, (∃ sR sY sZ, SurfaceDivisor G sR sY sZ nu) ∧
      nu (f - algebraMap E (AJ E G) c) < 1 ∧ nu x ≠ 1}.Finite :=
  (finite_level_values _ (finite_surfaceDivisor_ne_one hN hp x hx)
    (fun _ hnu a ha => by
      obtain ⟨⟨sR, sY, sZ, hsd⟩, -⟩ := hnu
      exact Exch.SurfaceDivisor.trivial_on_constants hsd a ha) f).subset
    fun _ ⟨nu, h, hlt, hne⟩ => ⟨nu, ⟨h, hne⟩, hlt⟩

end Surface

section Packet
noncomputable section
open scoped Classical
open RCN074 RCN086 RCN135 RCN136 RCN159 RCN222 RCN238 RCN243 RCN264 RCN313 RCN334
open DU BD AFA BOE
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] Exch.component_isPrime Exch.fact_irreducible

/-- `H = ∂F/∂R` lies in every ideal that contains the polynomial `g` of a geometric component and its
`R`-derivative: `F = g h` on the surface, so `H = ∂g/∂R h + g ∂h/∂R`. -/
theorem baseH_mem (P : Packet x t y r) (g : EX K P.F) (J : Ideal (MvPolynomial (Fin 3) Ω))
    (hg : (P.stage g).G ∈ J) (hd : pderiv 1 (P.stage g).G ∈ J) : baseH P.F ∈ J := by
  obtain ⟨h, hh⟩ := (P.stage g).RR
  rw [baseH, polyH, ← RCN267.ZO, show surfaceMap (AL K) P.F = (P.stage g).G * h from hh,
    Derivation.leibniz, smul_eq_mul, smul_eq_mul]
  exact J.add_mem (J.mul_mem_right _ hg) (J.mul_mem_left _ hd)

theorem baseH_ne_zero (P : Packet x t y r) (g : EX K P.F) :
    BR Ω (Exch.component P g) (baseH P.F) ≠ 0 := fun h =>
  (P.stage g).BLO (Ideal.mem_span_singleton.mp ((Sec.BR_eq_zero_iff _).mp h))

theorem pderiv_ne_zero (P : Packet x t y r) (g : EX K P.F) :
    BR Ω (Exch.component P g) (pderiv 1 (P.stage g).G) ≠ 0 := fun h =>
  baseH_ne_zero P g ((Sec.BR_eq_zero_iff _).mpr (baseH_mem P g _
    (Ideal.mem_span_singleton_self _) ((Sec.BR_eq_zero_iff _).mp h)))

/-- Every curve of the packet is a prime divisor of its geometric component: `H` does not vanish on it,
so the `R`-derivative of the component does not, and the surface is regular along the curve. -/
theorem curves (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) :
    ∃ S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1),
      ∀ a : Curve P, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a) := by
  have h : ∀ a : Curve P, ∃ S : Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1),
      IsCurveOnSurface (Exch.component P a.1) a.2.1 S := fun a =>
    Sec.exists_curve (P.stage a.1).G (_Q2 (AL K) (P.stage a.1).F (w + 1)) (P.stage a.1).MW rfl
      (P.stage_proper hp a.1) a.2.1 (AAS Ω _ _ _ a.2) fun hd =>
        _Q6 Ω _ _ _ a.2 (baseH_mem P a.1 a.2.1 (EN Ω _ _ _ a.2) hd)
  exact ⟨fun a => (h a).choose, fun a => (h a).choose_spec⟩

/-- An active curve is a component of the level curve `L_c` for finitely many `c` only. Along the curve
`f` is regular (`H` is a unit there), so `f - c` vanishes along it for at most one `c`. -/
theorem off_level (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a)) :
    {c : Ω | ∃ a ∈ active P SZ, (S a).val (Exch.moving P Q A a.1 -
      algebraMap Ω (AJ Ω (Exch.component P a.1)) c) ≠ 1}.Finite := by
  refine (Set.Finite.biUnion (active P SZ).finite_toSet fun a ha =>
    (show {c : Ω | (S a).val (Exch.moving P Q A a.1 -
        algebraMap Ω (AJ Ω (Exch.component P a.1)) c) < 1}.Subsingleton from
      fun c hc c' hc' =>
        level_value_unique (S a).val (hS a ha).trivial_on_constants _ hc hc').finite).subset ?_
  rintro c ⟨a, ha, hne⟩
  refine Set.mem_biUnion ha (lt_of_le_of_ne (((S a).val.map_sub _ _).trans (max_le ?_ ?_)) hne)
  · exact (Valuation.mem_valuationSubring_iff _ _).mp
      ((hS a ha).res_movingValue (baseH P.F) (baseG P.F) Q A (_Q6 Ω _ _ _ a.2)).1
  · rw [← (BR Ω (Exch.component P a.1)).commutes c]
    exact Sec.curve_val_le_one (hS a ha) _

/-- `f - c`, written without the denominator `H`, vanishes at a seed of an active curve for finitely
many `c` only. `H` is not zero at a seed, so `H (Q - c) + A G` vanishes there for at most one `c`. -/
theorem seed (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) :
    {c : Ω | ∃ a ∈ active P SZ, ∃ γ ∈ HF Ω (P.stage a.1).G (_Q2 (AL K) (P.stage a.1).F (w + 1))
      (CR (AL K) (P.stage a.1).F) (KK K P.F P.selected P.seeds a.1)
      (DK (AL K) (P.stage a.1).selected) a.2,
      MvPolynomial.eval (DK (AL K) (P.stage a.1).selected γ)
        (baseH P.F * (Q - MvPolynomial.C c) + A * baseG P.F) = 0}.Finite := by
  refine (Set.Finite.biUnion (active P SZ).finite_toSet fun a _ =>
    Set.Finite.biUnion (Finset.finite_toSet _) fun γ hγ =>
      (show {c : Ω | MvPolynomial.eval (DK (AL K) (P.stage a.1).selected γ)
          (baseH P.F * (Q - MvPolynomial.C c) + A * baseG P.F) = 0}.Subsingleton from
        fun c hc c' hc' => ?_).finite).subset
    fun c ⟨a, ha, γ, hγ, h⟩ => Set.mem_biUnion ha (Set.mem_biUnion hγ h)
  have hH : MvPolynomial.eval (DK (AL K) (P.stage a.1).selected γ) (baseH P.F) ≠ 0 := by
    rw [baseH, polyH, WQ]
    exact (P.stage a.1).regular γ (LU Ω _ _ _ _ _ a.2 hγ)
  simp only [Set.mem_ofPred_eq, map_add, map_mul, map_sub, eval_C] at hc hc'
  exact (sub_eq_zero.mp ((mul_eq_zero.mp (show MvPolynomial.eval (DK (AL K) (P.stage a.1).selected γ)
    (baseH P.F) * (c' - c) = 0 by linear_combination hc - hc')).resolve_left hH)).symm

/-- The moving function is the constant `c` on a geometric component for finitely many `c` only. -/
theorem component_ne (P : Packet x t y r) (Q A : MvPolynomial (Fin 3) Ω) :
    {c : Ω | ∃ g, Exch.moving P Q A g = algebraMap Ω (AJ Ω (Exch.component P g)) c}.Finite :=
  (Set.finite_iUnion fun g : EX K P.F =>
    (show {c : Ω | Exch.moving P Q A g =
        algebraMap Ω (AJ Ω (Exch.component P g)) c}.Subsingleton from
      fun _ hc _ hc' => (algebraMap Ω (AJ Ω (Exch.component P g))).injective
        (hc.symm.trans hc')).finite).subset fun _ ⟨g, hg⟩ => Set.mem_iUnion.mpr ⟨g, hg⟩

/-- For finitely many `c` only, `f - c` vanishes along a prime divisor of the eight charts of a geometric
component on which a coordinate, the `R`-derivative of the component, `H` or `A₁` is not a unit. None of
the six functions is zero on a geometric component. -/
theorem component_unit (P : Packet x t y r) (SZ : Source P.F) (N : ℕ)
    (hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N) (hNp : 3 * N < 2130706433)
    (hc : ∀ j, sliceCoord P.F j ≠ 0) (htail : tail P.F P.F (dvd_refl P.F) w ≠ 0)
    (hlead : srcLead P.F P.F SZ ≠ 0) (Q A : MvPolynomial (Fin 3) Ω) :
    {c : Ω | ∃ (g : EX K P.F) (nu : Valuation (AJ Ω (Exch.component P g)) ℤᵐ⁰),
      (∃ sR sY sZ, SurfaceDivisor (Exch.component P g) sR sY sZ nu) ∧
      nu (Exch.moving P Q A g - algebraMap Ω (AJ Ω (Exch.component P g)) c) < 1 ∧
      ¬((∀ j, nu (coordinate Ω (Exch.component P g) j) = 1) ∧
        nu (BR Ω (Exch.component P g) (pderiv 1 (P.stage g).G)) = 1 ∧
        nu (BR Ω (Exch.component P g) (baseH P.F)) = 1 ∧ nu (Exch.function P SZ g) = 1)}.Finite := by
  have hfin : ∀ (g : EX K P.F) (z : AJ Ω (Exch.component P g)), z ≠ 0 →
      {c : Ω | ∃ nu : Valuation (AJ Ω (Exch.component P g)) ℤᵐ⁰,
        (∃ sR sY sZ, SurfaceDivisor (Exch.component P g) sR sY sZ nu) ∧
        nu (Exch.moving P Q A g - algebraMap Ω (AJ Ω (Exch.component P g)) c) < 1 ∧
        nu z ≠ 1}.Finite := fun g z hz => finite_level_ne_one (hN g) hNp _ z hz
  have hA : ∀ g, Exch.function P SZ g ≠ 0 := fun g =>
    Exch.function_ne_zero P SZ g htail (fun h0 => baseH_ne_zero P g (by
      rw [baseH, ← Exch.embedding_sliceProj, h0, map_zero])) hlead
  refine (Set.finite_iUnion fun g : EX K P.F =>
    ((Set.finite_iUnion fun j => hfin g _ (Exch.coordinate_ne_zero P g hc j)).union
      (hfin g _ (pderiv_ne_zero P g))).union
      ((hfin g _ (baseH_ne_zero P g)).union (hfin g _ (hA g)))).subset ?_
  rintro c ⟨g, nu, hnu, hlt, hbad⟩
  refine Set.mem_iUnion.mpr ⟨g, ?_⟩
  by_contra hno
  simp only [Set.mem_union, Set.mem_iUnion, Set.mem_ofPred_eq, not_or, not_exists, not_and,
    not_not] at hno
  exact hbad ⟨fun j => hno.1.1 j nu hnu hlt, hno.1.2 nu hnu hlt, hno.2.1 nu hnu hlt,
    hno.2.2 nu hnu hlt⟩

end
end Packet

end ProximityPrize.SubmissionLower.FormalR.Data
end
