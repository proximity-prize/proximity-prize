/-!
Package M3 of lane M, statement: the data of the three counts exist with every need.

`Sec.ChoiceStatement P SZ`: for a packet there are polynomials `Q`, `A` of the two flags of the point
budget, a level `c`, the live curves as prime divisors with their residue maps, and three sections of the
three unit flags, with lane C's `CurveNeeds`, lane X's `Exch.ExchangeNeeds` for the flag of `A₁` on the
cell, lane L's `LevelNeeds` and the three `Sec.Needs`.

It is split in two (`Sec.choice_of_data_of_section`): `Sec.DataStatement P SZ` (`Q`, `A`, `c` and the
curves with the needs of lanes C, X, L) and `Sec.SectionStatement P SZ` (the three sections, for given
`Q`, `A`, `c`).

Order of the choices (`design.md`, sections 3 and 8): `Q`, `A` outside finitely many proper subspaces of
the space of the two flags; then `c` outside a finite set; then the directions of the two free pencils
outside finitely many proper subspaces and the three constants outside finite sets.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.Sec

open WithZero MvPolynomial HFree6812
open RCN002 RCN095

section Packet
noncomputable section
open scoped Classical
open RCN074 RCN135 RCN136 RCN159 RCN222 RCN264 RCN313 RCN334
open DU BD AFA BOE
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] LevelComponent.isPrime Exch.component_isPrime

/-- The existence of the data with every need of the three counts and of the section bound.

Hypotheses, in this order:
* the model of lane A (step 0' of the assembly): `SurfaceNoether` on every geometric component with
  `3 * N` below the characteristic, and nonzero coordinates on the carrier;
* the tail `τ_w` and the leading coefficient of the source are not zero on the carrier (then `A₁` is not
  zero on any geometric component);
* a separable literal coordinate on every live curve, and on every component of a level curve of a moving
  function of the two flags that is not constant equal to the level (lane L's `LevelCount.separable`);
* lane E2's finite integral closure of the local ring of a curve of the surface at each of its points. -/
def ChoiceStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ j, sliceCoord P.F j ≠ 0)
    (_htail : tail P.F P.F (dvd_refl P.F) w ≠ 0) (_hlead : srcLead P.F P.F SZ ≠ 0)
    (_hbase : ∀ a : Curve P, RCN341.BP a.2.1)
    (_hsep : ∀ Q A : MvPolynomial (Fin 3) Ω, BI (2 • unitAllFlag) Q → BI unitYZFlag A →
      ∀ (c : Ω) (g : EX K P.F),
        Exch.moving P Q A g ≠ algebraMap Ω (AJ Ω (Exch.component P g)) c →
        ∀ B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c,
          Nonempty (RCN341.BP B.prime))
    (_hclosure : ∀ (g : EX K P.F) (C : Ideal (MvPolynomial (Fin 3) Ω)) [C.IsPrime]
      (S : Specialization (AJ Ω (Exch.component P g)) (AJ Ω C)),
      IsCurveOnSurface (Exch.component P g) C S →
      ∀ (q : SurfacePoint (Exch.component P g)) (hq : q.On S), RCN341.BP C →
        Module.Finite (S.image hq) (integralClosure (S.image hq) (AJ Ω C))),
    ∃ (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
      (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1))
      (s₀ s₁ s₂ : MvPolynomial (Fin 3) Ω),
      BI (2 • unitAllFlag) Q ∧ BI unitYZFlag A ∧ (2 : MvPolynomial (Fin 3) Ω) * A ≠ 0 ∧
      (∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a)) ∧
      CurveNeeds P SZ Q A c S ∧
      Exch.ExchangeNeeds P SZ Q A c S (Exch.flag SZ ⟨t - y, y - r, r - 1⟩) ∧
      LevelNeeds P SZ Q A c S ∧
      Needs P SZ Q A c unitZFlag s₀ ∧ Needs P SZ Q A c unitYZFlag s₁ ∧
      Needs P SZ Q A c unitAllFlag s₂

/-- The data part of `ChoiceStatement`: `Q`, `A`, `c` and the live curves with the needs of the three
counts (lanes C, X, L), under the hypotheses of `ChoiceStatement`. -/
def DataStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ j, sliceCoord P.F j ≠ 0)
    (_htail : tail P.F P.F (dvd_refl P.F) w ≠ 0) (_hlead : srcLead P.F P.F SZ ≠ 0)
    (_hbase : ∀ a : Curve P, RCN341.BP a.2.1)
    (_hsep : ∀ Q A : MvPolynomial (Fin 3) Ω, BI (2 • unitAllFlag) Q → BI unitYZFlag A →
      ∀ (c : Ω) (g : EX K P.F),
        Exch.moving P Q A g ≠ algebraMap Ω (AJ Ω (Exch.component P g)) c →
        ∀ B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c,
          Nonempty (RCN341.BP B.prime))
    (_hclosure : ∀ (g : EX K P.F) (C : Ideal (MvPolynomial (Fin 3) Ω)) [C.IsPrime]
      (S : Specialization (AJ Ω (Exch.component P g)) (AJ Ω C)),
      IsCurveOnSurface (Exch.component P g) C S →
      ∀ (q : SurfacePoint (Exch.component P g)) (hq : q.On S), RCN341.BP C →
        Module.Finite (S.image hq) (integralClosure (S.image hq) (AJ Ω C))),
    ∃ (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
      (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1)),
      BI (2 • unitAllFlag) Q ∧ BI unitYZFlag A ∧ (2 : MvPolynomial (Fin 3) Ω) * A ≠ 0 ∧
      (∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a)) ∧
      CurveNeeds P SZ Q A c S ∧
      Exch.ExchangeNeeds P SZ Q A c S (Exch.flag SZ ⟨t - y, y - r, r - 1⟩) ∧
      LevelNeeds P SZ Q A c S

/-- The section part of `ChoiceStatement`: for given `Q`, `A`, `c` with the conditions of lane L on every
geometric component (`LevelNeeds.component`: `f` is not the constant `c`, and the coordinates, the
`R`-derivative, `H` and `A₁` are units along the components of the level curve) and a separable literal
coordinate on every component of the level curve, three sections of the three unit flags with the needs
of the section bound. -/
def SectionStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  ∀ (N : ℕ) (_hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_hNp : 3 * N < 2130706433) (_hc : ∀ j, sliceCoord P.F j ≠ 0)
    (_hlead : srcLead P.F P.F SZ ≠ 0) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (_hcomp : ∀ g, LevelCount.Needs (Exch.component P g) (P.stage g).G (baseH P.F)
      (Exch.moving P Q A g) c (Exch.function P SZ g))
    (_hsep : ∀ g (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c),
      Nonempty (RCN341.BP B.prime)),
    ∃ s₀ s₁ s₂ : MvPolynomial (Fin 3) Ω,
      Needs P SZ Q A c unitZFlag s₀ ∧ Needs P SZ Q A c unitYZFlag s₁ ∧
      Needs P SZ Q A c unitAllFlag s₂

/-- The data and the sections together. -/
theorem choice_of_data_of_section (P : Packet x t y r) (SZ : Source P.F)
    (hdata : DataStatement P SZ) (hsection : SectionStatement P SZ) : ChoiceStatement P SZ := by
  intro N hN hNp hc htail hlead hbase hsep hclosure
  obtain ⟨Q, A, c, S, hQ, hA, h2, hS, hcurve, hexch, hlevel⟩ :=
    hdata N hN hNp hc htail hlead hbase hsep hclosure
  obtain ⟨s₀, s₁, s₂, h₀, h₁, h₂⟩ := hsection N hN hNp hc hlead Q A c hlevel.component
    fun g B => hsep Q A hQ hA c g (hlevel.component g).ne B
  exact ⟨Q, A, c, S, s₀, s₁, s₂, hQ, hA, h2, hS, hcurve, hexch, hlevel, h₀, h₁, h₂⟩


end
end Packet

end ProximityPrize.SubmissionLower.FormalR.Sec
end
