private theorem GSB (C:Ideal (MvPolynomial (Fin 3) Ω)) [C.IsPrime]
    (f:AJ Ω C→ₐ[Ω] E) (F:MvPolynomial (Fin 3) Ω):
    MvPolynomial.eval (GM C f) (CD Ω E F)=f (BR Ω C F):=by
  have h:=AlgHom.congr_fun (ALG C f) F
