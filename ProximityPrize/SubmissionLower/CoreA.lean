  unfold paddedCost
  rw [AEN z 131072 hz,
    AEN z 131073 hz,
    AEN (z+1) 131072 (by omega),
    AEN (z+1) 131073 (by omega),
    AEN (z+2) 131072 (by omega),
    AEN (z+2) 131073 (by omega)]
  have h1:z+1-1=z:=by omega
  have h2:z+2-1=z+1:=by omega
  rw [h1,h2]
  have hzsplit:z=(z-1)+1:=by omega
