theorem EDR (z:ℕ) (hz:2≤z):
    2*rawCost 1 0 (z+1)=rawCost 1 0 z+rawCost 1 0 (z+2):=by
  have hn (x:ℕ): ¬UG (⟨x,0,1⟩:FlagDegree):=by
