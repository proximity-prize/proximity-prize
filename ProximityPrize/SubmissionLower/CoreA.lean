theorem FCG (F:Poly4 K) (d:Fin 4→₀ ℕ):
    AddMonoidAlgebra.coeff ((EM K 0 0 0 F).coeff (d 0+d 1)) d.tail=AddMonoidAlgebra.coeff F d:=by
