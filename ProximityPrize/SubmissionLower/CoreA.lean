          AW E 131071 (L-T) (s-R))-
        262144*(12*(RCN119.ES m L s:ℤ)-
          12*RCN119.ES (m-mu) (L-T) (s-R)):=by
  have hL0:Dh/131071+1≤L:=le_trans (Nat.add_le_add_right (Nat.div_le_div_right (Nat.le_succ Dh)) 1) hL
