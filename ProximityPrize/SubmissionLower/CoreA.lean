/-!
Statement checkpoint X0 of lane X (the exchange at the base points, `ExchangeCount`): the definitions of
the package and its three statements as `Prop`-valued definitions.

* `Statement.chain_at_point`: the chain at one point for an abstract ring (proved: `Exch.sum_mul_le_toNat`).
* `Statement.component_exchange`: the exchange on one geometric component over a field `E`, for a finite
  family of curves with weights.
* `Statement.exchange_count`: `ExchangeCount` for a packet, with `o = baseOrder`, `Lam = lam` and
  `Kc = constant`.

Taken from other lanes as hypotheses of their `Prop` types: (p1) of lane E2
(`PlaceSurf.Statement.surfacePoint_leastOrder_le`), the tail bridge of lane C (`TailOrder`, defined in
`FRExchData`), the contracts `PsiSIntegral` and `SurfaceNoether` of lane A.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.Exch

open WithZero MvPolynomial HFree6812
open RCN002 RCN095

section Surface
noncomputable section

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime]

attribute [local instance] SurfacePoint.isNoetherianRing SurfacePoint.isIntegrallyClosed
  SurfacePoint.isFractionRing

/-- (c1) at the base points: no component of the level curve `L_c` through a base point `q` is a
component of the divisor of `g_u = q.localFunction A₁ W`. -/
def LevelDisjoint (f : AJ E G) (c : E) (A₁ : AJ E G) (W : FlagDegree) : Prop :=
  ∀ q : SurfacePoint G, f ∉ q.ring → ∀ P : PrimeDivisor q.ring, q.level f c P ≠ 0 →
    P.valuation (AJ E G) (q.localFunction A₁ W) = 1

open Classical in
/-- The constant of (b') of Lemma X at the point `q` for a function `g` that is regular at `q`. -/
def pointLoss (q : SurfacePoint G) (g : AJ E G) : ℕ :=
  if h : g ∈ q.ring then loss (AJ E G) (⟨g, h⟩ : q.ring) else 0

open Classical in
/-- The constant of the exchange on one geometric component, for curves `S a` with weights `m a`: the sum
over the base points `q` of the constant of Lemma X for `g_u` and of `m a` times the colength of the local
ring of the curve `S a` at `q` in its integral closure. -/
def componentLoss (f : AJ E G) (c : E) (A₁ : AJ E G) (W : FlagDegree) {ι : Type*} (s : Finset ι)
    {F : ι → Type*} [∀ a, Field (F a)] (S : ∀ a, Specialization (AJ E G) (F a)) (m : ι → ℕ) : ℕ :=
  ∑ᶠ q : SurfacePoint G, if f ∉ q.ring ∧ q.level f c ≠ 0 then
    pointLoss q (q.localFunction A₁ W) +
      ∑ a ∈ s, if hq : q.On (S a) then m a * closureColength ((S a).image hq) (F a) else 0
  else 0

end
end Surface

namespace Statement

/-- The chain at a point (referee 6.3), for a Noetherian integrally closed domain `O` with the chain
condition, `g ≠ 0`, a divisor `D` without common component with `div g`, and prime divisors `P a` with
weights `m a ≤ ord_(P a) g` and place bounds `ord a ≤ length O/(P a + O(-n D)) + δ a`. -/
def chain_at_point (O : Type*) [CommRing O] (K : Type*) [Field K] [Algebra O K] : Prop :=
  DivisorChain O → ∀ g : O, g ≠ 0 → ∀ D : Divisor O, (∀ P ∈ D.support, g ∉ P.ideal) →
    ∀ (ι : Type) (s : Finset ι) (P : ι → PrimeDivisor O), Set.InjOn P s →
    ∀ m : ι → ℕ, (∀ a ∈ s, m a ≤ div K g (P a)) → ∀ (ord δ : ι → ℕ) (n : ℕ),
    (∀ a ∈ s, (ord a : ℕ∞) ≤
      Module.length O (O ⧸ ((P a).ideal ⊔ divisorIdeal K (n • D))) + δ a) →
    ∑ a ∈ s, m a * ord a ≤
      n * (D.sum fun Q k => (k : ℕ∞) * Module.length O (O ⧸ (Q.ideal ⊔ Ideal.span {g}))).toNat +
        loss K g + ∑ a ∈ s, m a * δ a

section Surface

variable (E : Type) [Field E] (G : Ideal (MvPolynomial (Fin 3) E)) [G.IsPrime]

attribute [local instance] SurfacePoint.isNoetherianRing SurfacePoint.isIntegrallyClosed
  SurfacePoint.isFractionRing

/-- The exchange on one geometric component `G` over `E`: for a function `A₁` whose local functions
`g_u` are regular, a level `c` with (c1), and finitely many curves `S a` that are prime divisors at the
points they pass through, without pole of a coordinate, with `ord_(S a) A₁ ≥ m a` and with (p1) at the
base points. -/
def component_exchange : Prop :=
  ∀ (N p : ℕ) [CharP E p], (∀ sR sY sZ, SurfaceNoether G sR sY sZ N) → 3 * N < p →
    (∀ j, coordinate E G j ≠ 0) →
    ∀ (f : AJ E G) (c : E) (A₁ : AJ E G) (W : FlagDegree),
    (∀ q : SurfacePoint G, q.localFunction A₁ W ∈ q.ring) → LevelDisjoint f c A₁ W →
    ∀ (ι : Type) (s : Finset ι) (F : ι → Type) [∀ a, Field (F a)] [∀ a, Algebra E (F a)]
      (S : ∀ a, Specialization (AJ E G) (F a)) (m : ι → ℕ),
    (∀ a ∈ s, ∀ b ∈ s, (S a).val = (S b).val → a = b) →
    (∀ a ∈ s, ∀ j, (S a).val (coordinate E G j) ≤ 1) →
    (∀ a ∈ s, ∀ q : SurfacePoint G, q.On (S a) → ∃ P : PrimeDivisor q.ring,
      (∀ x : q.ring, x ∈ P.ideal ↔ (S a).val (x : AJ E G) < 1) ∧
        P.valuation (AJ E G) = (S a).val) →
    (∀ a ∈ s, (S a).val A₁ ≤ exp (-(m a : ℤ))) →
    (∀ a ∈ s, ∀ (q : SurfacePoint G) (hq : q.On (S a)), f ∉ q.ring → q.level f c ≠ 0 →
      PlaceSurf.Statement.LeastOrderLE E (S a) hq) →
    ∀ n : ℕ, ∑ a ∈ s, m a * curveBase (S a) f c n ≤
      n * baseNumber f c A₁ W + componentLoss f c A₁ W s S m

end Surface

end Statement

section Packet
noncomputable section
open scoped Classical
open RCN074 RCN135 RCN136 RCN159 RCN222 RCN264 RCN313 RCN334
open DU BD AFA BOE
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] component_isPrime SurfacePoint.isNoetherianRing
  SurfacePoint.isIntegrallyClosed SurfacePoint.isFractionRing

/-- What the exchange asks of the data `Q`, `A`, `c` and of the curves `S`, for the flag `W` of `A₁`:

* `disjoint`: (c1) of the referee's 2.5 on every geometric component that carries a live curve: no
  component of `L_c` through a base point is a component of the divisor of `g_u`;
* `closure`: the local ring of a live curve at a base point has a finite integral closure. -/
structure ExchangeNeeds (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1)) (W : FlagDegree) :
    Prop where
  disjoint : ∀ a ∈ active P SZ, LevelDisjoint (moving P Q A a.1) c (function P SZ a.1) W
  closure : ∀ a ∈ active P SZ, ∀ (q : SurfacePoint (component P a.1)) (hq : q.On (S a)),
    moving P Q A a.1 ∉ q.ring → q.level (moving P Q A a.1) c ≠ 0 →
      Module.Finite ((S a).image hq) (integralClosure ((S a).image hq) (AJ Ω a.2.1))

/-- `Kc`: the sum over the geometric components of the constants of the exchange for the live curves
with the weights `3 d μ_a`. -/
def constant (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F)
    (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1)) (W : FlagDegree) : ℕ :=
  ∑ g : EX K P.F, componentLoss (moving P Q A g) c (function P SZ g) W
    (Finset.univ.filter fun C : CM (P.stage g) => (⟨g, C⟩ : Curve P) ∈ active P SZ)
    (fun C : CM (P.stage g) => S ⟨g, C⟩) (fun C => 3 * SZ.d * multiplicity P hp ⟨g, C⟩)

/-- `ExchangeCount` for a packet, for a flag `Hf` of `H`. -/
def Statement.exchange_count (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1))
    (SZ : Source P.F) : Prop :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  ∀ (Hf : FlagDegree) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1)),
    (∀ a ∈ active P SZ, IsCurveOnSurface (component P a.1) a.2.1 (S a)) →
    ExchangeNeeds P SZ Q A c S (flag SZ Hf) →
    (∀ j, sliceCoord P.F j ≠ 0) →
    (∀ sR sY sZ, PsiSIntegral P.F P.F (dvd_refl P.F) SZ Hf sR sY sZ) →
    ∀ N : ℕ, (∀ g sR sY sZ, SurfaceNoether (component P g) sR sY sZ N) → 3 * N < 2130706433 →
    TailOrder P hp SZ S →
    (∀ a ∈ active P SZ,
      PlaceSurf.Statement.surfacePoint_leastOrder_le Ω (component P a.1) (AJ Ω a.2.1)) →
    ExchangeCount P hp SZ (baseOrder P Q A c S) (lam P SZ Q A c (flag SZ Hf))
      (constant P hp SZ Q A c S (flag SZ Hf))

end
end Packet

end ProximityPrize.SubmissionLower.FormalR.Exch
