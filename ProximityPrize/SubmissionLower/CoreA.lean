    have hcj:v (sliceCoord F₀ j)=exp ((P.toNat:ℕ):ℤ):=by
      rw [← exp_log hcj0]
      congr 1
      have:vpole v (sliceCoord F₀ j)=max 0 (v (sliceCoord F₀ j)).log:=rfl
