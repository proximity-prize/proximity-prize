  [Algebra (RatFunc (GenericField K)) E]
  [IsScalarTower (GenericField K) (RatFunc (GenericField K)) E]
  (D:Ideal (MvPolynomial (Fin 3) E)) [D.IsPrime] (F₀:MvPolynomial (Fin 4) K)
