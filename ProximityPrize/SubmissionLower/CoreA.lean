/-!
The live curves of a stage against the tree's local multiplicity (owner: lane E). For a live curve `C` of a
stage (a `RCN074.CM`), seen as a prime divisor `Sa` of a geometric component `G` over `GenericField K`, the
value of `Sa` at the image of a polynomial `A` over `K` is `exp (-e · ord A)`, where `ord A` is the order of
`A` in the tree's discrete valuation ring `RCN244.LocalRing S C` and `e ≥ 1` does not depend on `A` (the
ramification index of the curve over the prime divisor of the carrier over `K`). With `A` the tail numerator
this is `e` times the tree's `RCN244.FO` (localMultiplicity).

Every proof is closed; a statement changes only with a message to the orchestrator.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR

open WithZero MvPolynomial
open RCN002 RCN095 RCN135 RCN136 RCN244 RCN313

noncomputable section

namespace Surf

/-- A ring map from a discrete valuation ring to a field with a valuation that is at most 1 on the image
and less than 1 on the image of the non-units: the valuation is `exp (-e · ord)` on the nonzero
images. -/
theorem val_eq_exp_addVal {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {L : Type*} [Field L] (g : R →+* L) (ν : Valuation L ℤᵐ⁰) (hle : ∀ z, ν (g z) ≤ 1)
    (hlt : ∀ z, ¬IsUnit z → ν (g z) < 1) :
    ∃ e : ℕ, 1 ≤ e ∧ ∀ z, g z ≠ 0 →
      ν (g z) = exp (-((e * (IsDiscreteValuationRing.addVal R z).toNat : ℕ) : ℤ)) := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hunit : ∀ u : Rˣ, ν (g u) = 1 := fun u => by
    have h1 : ν (g u) * ν (g ↑u⁻¹) = 1 := by
      rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one]
    refine le_antisymm (hle _) ?_
    by_contra hlt'
    rw [not_le] at hlt'
    exact (lt_of_le_of_lt (mul_le_of_le_one_right' (hle _)) hlt').ne h1
  have hc := hlt ϖ hϖ.not_isUnit
  have hval : ∀ z, g z ≠ 0 →
      ν (g z) = ν (g ϖ) ^ (IsDiscreteValuationRing.addVal R z).toNat := by
    intro z hz
    have hz0 : z ≠ 0 := fun h => hz (by rw [h, map_zero])
    obtain ⟨n, u, hzu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hz0 hϖ
    rw [IsDiscreteValuationRing.addVal_def z u hϖ n hzu, ENat.toNat_natCast]
    rw [hzu, map_mul, map_mul, map_pow, map_pow, hunit u, one_mul]
  by_cases hc0 : ν (g ϖ) = 0
  · refine ⟨1, le_rfl, fun z hz => ?_⟩
    have h1 := hval z hz
    have hn : (IsDiscreteValuationRing.addVal R z).toNat = 0 := by
      by_contra hn
      rw [hc0, zero_pow hn] at h1
      exact hz ((Valuation.zero_iff _).mp h1)
    rw [h1, hn, pow_zero, mul_zero, Nat.cast_zero, neg_zero, exp_zero]
  · have hlog : log (ν (g ϖ)) < 0 := by
      have h1 := hc
      rwa [← exp_log hc0, exp_lt_one_iff] at h1
    have h2 : ((-log (ν (g ϖ))).toNat : ℤ) = -log (ν (g ϖ)) := Int.toNat_of_nonneg (by omega)
    refine ⟨(-log (ν (g ϖ))).toNat, by omega, fun z hz => ?_⟩
    rw [hval z hz]
    conv_lhs => rw [← exp_log hc0]
    rw [← exp_nsmul, exp_inj, Nat.cast_mul, h2, nsmul_eq_mul]
    ring

/-- A ring map `g` to a field that kills `I`, with a valuation that is at most 1 on its image and less
than 1 exactly on the image of a prime `p`, extends to the local ring of `P ⧸ I` at the prime `Q` cut out
by `p`. -/
theorem exists_lift_localization {P : Type*} [CommRing P] (I p : Ideal P) (Q : Ideal (P ⧸ I))
    [Q.IsPrime] (hQ : ∀ a, Ideal.Quotient.mk I a ∈ Q ↔ a ∈ p) {L : Type*} [Field L] (g : P →+* L)
    (hI : ∀ a ∈ I, g a = 0) (ν : Valuation L ℤᵐ⁰) (hle : ∀ a, ν (g a) ≤ 1)
    (hlt : ∀ a, ν (g a) < 1 ↔ a ∈ p) :
    ∃ g' : Localization.AtPrime Q →+* L,
      (∀ a, g' (algebraMap (P ⧸ I) (Localization.AtPrime Q) (Ideal.Quotient.mk I a)) = g a) ∧
      (∀ z, ν (g' z) ≤ 1) ∧ ∀ z, ¬IsUnit z → ν (g' z) < 1 := by
  have hone : ∀ a, a ∉ p → ν (g a) = 1 := fun a ha =>
    le_antisymm (hle a) (not_lt.mp fun h => ha ((hlt a).mp h))
  have hunit : ∀ y : Q.primeCompl, IsUnit (Ideal.Quotient.lift I g hI y) := fun y => by
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (y : P ⧸ I)
    have hap : a ∉ p := fun h => y.2 (ha ▸ (hQ a).mpr h)
    rw [← ha, Ideal.Quotient.lift_mk]
    refine isUnit_iff_ne_zero.mpr fun h0 => ?_
    have h1 := hone a hap
    rw [h0, map_zero] at h1
    exact zero_ne_one h1
  have key : ∀ z : Localization.AtPrime Q, ∃ a, (a ∉ p → IsUnit z) ∧
      ν (IsLocalization.lift hunit z) = ν (g a) := by
    intro z
    obtain ⟨xy, hxy⟩ := IsLocalization.surj Q.primeCompl z
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective xy.1
    obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (xy.2 : P ⧸ I)
    have hsp : s ∉ p := fun h => xy.2.2 (hs ▸ (hQ s).mpr h)
    refine ⟨a, fun hap => ?_, ?_⟩
    · have hu : IsUnit (algebraMap (P ⧸ I) (Localization.AtPrime Q) xy.1) :=
        IsLocalization.map_units _ (⟨xy.1, fun h => hap ((hQ a).mp (ha ▸ h))⟩ : Q.primeCompl)
      rw [← hxy] at hu
      exact isUnit_of_mul_isUnit_left hu
    · have h1 := congrArg (IsLocalization.lift hunit) hxy
      rw [map_mul, IsLocalization.lift_eq, IsLocalization.lift_eq, ← ha, ← hs,
        Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk] at h1
      rw [← h1, map_mul, hone s hsp, mul_one]
  refine ⟨IsLocalization.lift hunit, fun a => ?_, fun z => ?_, fun z hz => ?_⟩
  · rw [IsLocalization.lift_eq, Ideal.Quotient.lift_mk]
  · obtain ⟨a, -, h⟩ := key z
    rw [h]
    exact hle a
  · obtain ⟨a, hu, h⟩ := key z
    rw [h]
    exact (hlt a).mpr (not_not.mp fun hap => hz (hu hap))

end Surf

variable {K I : Type} [Field K] {Gamma : Finset K} {x : I → K} {p : ℕ} {flag : FlagDegree}
  [CharP (GenericField K) p] {errorCap : ℕ} {stageSupport : RCN275.BT}

/-- The value of a live curve at the image of a polynomial over `K` is `exp (-e · ord)` for the order in
the tree's local ring of the curve, with one `e ≥ 1` for all polynomials. -/
theorem liveCurve_val_eq (S : Stage K I Gamma x p flag errorCap stageSupport) (C : RCN074.CM S)
    (Lf : ERB S) (G : Ideal (MvPolynomial (Fin 3) (GenericField K))) [G.IsPrime]
    (hG : surfaceMap (AL K) (originalData S C).factor ∈ G)
    (Sa : Specialization (AJ (GenericField K) G) (AJ (GenericField K) C.1))
    (hSa : IsCurveOnSurface G C.1 Sa) :
    ∃ e : ℕ, 1 ≤ e ∧ ∀ A : MvPolynomial (Fin 4) K, CT.GP (AL K) G A ≠ 0 →
      Sa.val (CT.GP (AL K) G A) =
        exp (-((e * (@IsDiscreteValuationRing.addVal (LocalRing S C) _ (Lf.domain C) (Lf.dvr C)
          (localImage S C A)).toNat : ℕ) : ℤ)) := by
  have hdom := Lf.domain C
  have hdvr := Lf.dvr C
  have hQV : (RCN186.QV (RCN218.factorIdeal (originalData S C).factor) (QP S C)).IsPrime :=
    RCN186.CNA _ _ (factorLe S C)
  have hle : ∀ A, Sa.val (CT.GP (AL K) G A) ≤ 1 := fun A =>
    (Valuation.mem_valuationSubring_iff _ _).mp (hSa (surfaceMap (AL K) A)).1
  have hlt : ∀ A, Sa.val (CT.GP (AL K) G A) < 1 ↔ A ∈ QP S C := fun A => by
    obtain ⟨h, hres⟩ := hSa (surfaceMap (AL K) A)
    have h1 := Sa.res_eq_zero_iff ⟨_, h⟩
    rw [hres] at h1
    exact h1.symm.trans (CT.AAE C.1 _)
  have hI : ∀ a ∈ RCN218.factorIdeal (originalData S C).factor, CT.GP (AL K) G a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    have hF : CT.GP (AL K) G (originalData S C).factor = 0 := (CT.AAE G _).mpr hG
    rw [map_mul, hF, mul_zero]
  obtain ⟨g', hg', hg'le, hg'lt⟩ := Surf.exists_lift_localization _ (QP S C)
    (RCN186.QV (RCN218.factorIdeal (originalData S C).factor) (QP S C))
    (fun a => by rw [← Ideal.mem_comap, RCN186.ADW _ _ (factorLe S C)]) (CT.GP (AL K) G) hI
    Sa.val hle hlt
  obtain ⟨e, he, h⟩ := Surf.val_eq_exp_addVal (R := LocalRing S C) g' Sa.val hg'le hg'lt
  refine ⟨e, he, fun A hA => ?_⟩
  have h2 : g' (localImage S C A) = CT.GP (AL K) G A := hg' A
  have h1 := h (localImage S C A) (by rw [h2]; exact hA)
  rwa [h2] at h1

/-- The order along a live curve of the image of the tail numerator is `e` times the tree's local
multiplicity, `e ≥ 1`. -/
theorem liveCurve_val_tail (S : Stage K I Gamma x p flag errorCap stageSupport) (C : RCN074.CM S)
    (Lf : ERB S) (G : Ideal (MvPolynomial (Fin 3) (GenericField K))) [G.IsPrime]
    (hG : surfaceMap (AL K) (originalData S C).factor ∈ G)
    (Sa : Specialization (AJ (GenericField K) G) (AJ (GenericField K) C.1))
    (hSa : IsCurveOnSurface G C.1 Sa)
    (hN : CT.GP (AL K) G (numerator K (originalData S C).factor (RCN326.w + 1)) ≠ 0) :
    ∃ e : ℕ, 1 ≤ e ∧
      Sa.val (CT.GP (AL K) G (numerator K (originalData S C).factor (RCN326.w + 1))) =
        exp (-((e * FO S Lf C : ℕ) : ℤ)) := by
  obtain ⟨e, he, h⟩ := liveCurve_val_eq S C Lf G hG Sa hSa
  exact ⟨e, he, h _ hN⟩

/-- The image of the tail numerator of the factor is not zero on the component `S.G` of a stage whose
first tail is proper (the argument of the tree's `RCN312.AQV`, over `GenericField K`). -/
theorem liveCurve_tail_ne_zero (S : Stage K I Gamma x p flag errorCap stageSupport) (C : RCN074.CM S)
    (hfirst : ¬S.G ∣ RCN086._Q2 (AL K) S.F (RCN326.w + 1))
    (G : Ideal (MvPolynomial (Fin 3) (GenericField K))) [G.IsPrime] (hG : G = Ideal.span {S.G}) :
    CT.GP (AL K) G (numerator K (originalData S C).factor (RCN326.w + 1)) ≠ 0 := by
  intro h0
  have hmem : surfaceMap (AL K) (numerator K (originalData S C).factor (RCN326.w + 1)) ∈ G :=
    (CT.AAE G _).mp h0
  rw [hG, Ideal.mem_span_singleton] at hmem
  have hscaled : S.G ∣ surfaceMap (AL K) ((originalData S C).cofactor ^ (2 * (RCN326.w + 1)) *
      numerator K (originalData S C).factor (RCN326.w + 1)) := by
    rw [map_mul]
    exact dvd_mul_of_dvd_right hmem _
  have hdiff : S.G ∣ surfaceMap (AL K) (numerator K S.F (RCN326.w + 1) -
      (originalData S C).cofactor ^ (2 * (RCN326.w + 1)) *
        numerator K (originalData S C).factor (RCN326.w + 1)) :=
    (originalData S C).factor_dvd.trans (map_dvd (surfaceMap (AL K))
      (RCN217.AKR _ _ S.F (originalData S C).product (RCN326.w + 1)))
  have hwhole : S.G ∣ surfaceMap (AL K) (numerator K S.F (RCN326.w + 1)) := by
    have h1 := dvd_add hdiff hscaled
    rwa [← map_add, sub_add_cancel] at h1
  exact hfirst ((RCN086.AWJ (AL K) (DI K) S.F (RCN326.w + 1) S.G).mpr hwhole)

/-- The order along a live curve of the image of the tail numerator is `e` times the tree's local
multiplicity with the canonical family, on the component `S.G` of a stage whose first tail is proper. -/
theorem liveCurve_val_tail_of_proper (S : Stage K I Gamma x p flag errorCap stageSupport)
    (C : RCN074.CM S) (hfirst : ¬S.G ∣ RCN086._Q2 (AL K) S.F (RCN326.w + 1))
    (G : Ideal (MvPolynomial (Fin 3) (GenericField K))) [G.IsPrime] (hG : G = Ideal.span {S.G})
    (Sa : Specialization (AJ (GenericField K) G) (AJ (GenericField K) C.1))
    (hSa : IsCurveOnSurface G C.1 Sa) :
    ∃ e : ℕ, 1 ≤ e ∧
      Sa.val (CT.GP (AL K) G (numerator K (originalData S C).factor (RCN326.w + 1))) =
        exp (-((e * FO S (DN S hfirst) C : ℕ) : ℤ)) :=
  liveCurve_val_tail S C (DN S hfirst) G
    (by rw [hG]; exact Ideal.mem_span_singleton.mpr (originalData S C).factor_dvd) Sa hSa
    (liveCurve_tail_ne_zero S C hfirst G hG)

end

end ProximityPrize.SubmissionLower.FormalR
end
