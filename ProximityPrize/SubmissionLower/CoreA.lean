    have hπ0:π ≠ 0:=by rintro rfl;rw [v.map_zero] at hπ;exact exp_ne_zero hπ.symm
    have h1:=DJT v hkle' hπ0 (mem_algebraicClosure_iff.1 (hA π))
    rw [hπ,← exp_zero,exp_inj] at h1
