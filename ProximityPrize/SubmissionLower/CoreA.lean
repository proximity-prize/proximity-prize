theorem num_cast (L U S r y t:ℕ) (hr:1≤r):
 (NN L U S r y t:ℤ)=NZ L U S r y t:=by
 have hs:((2*r-1:ℕ):ℤ)=2*(r:ℤ)-1:=by omega
 unfold BU.num FI.num
 simp only [Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,Nat.cast_one,hs]

