      have h2' :x 2 ∈ A:=mem_algebraicClosure_iff.2 (not_not.1 ht2)
      refine slice_gen F₀ A (fun r=>hkA _ (k.algebraMap_mem r)) (hkA _ hX0k) fun j=> ?_
