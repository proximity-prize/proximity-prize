  have h:=fixed_nonneg rv yv 0 k r y t hR hY (by decide) hk hg
    hrl hrh hrv hyl hyh hyv htl hth (htv.trans hcut)
  simpa [f,aw,bw,pw,fixedCase,FI.fixedMargin,
