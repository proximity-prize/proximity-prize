    (y r z:ℕ) (hr:1≤r) (hY:F.degreeOf 1≤y) (hR:F.degreeOf 2-1≤r)
    (hZ:F.degreeOf 3≤z)
    (selected:K→Polynomial K) (Γ:Finset K)
