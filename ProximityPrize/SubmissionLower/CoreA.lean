  have hfull:=EWD phi ev F S Q A target J surface d hd hchar hF hH hA hM
  have hn' :((coefficients phi S.P).map ev).natDegree≤n:=
    Polynomial.natDegree_map_le.trans (Polynomial.natDegree_map_le.trans
