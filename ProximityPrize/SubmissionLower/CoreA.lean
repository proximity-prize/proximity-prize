theorem ERT (r v z:ℕ) (hr:3≤r) (hv:2≤v):
    2*hybridCostC2 (⟨z+1,v,r⟩:FlagDegree)=
      hybridCostC2 ⟨z,v,r⟩+hybridCostC2 ⟨z+2,v,r⟩:=by
  have hr2:2≤r:=by omega
