  GB.FU (pair t y r (S.B-2*S.n0) (S.U-S.n0) (S.T-S.n0))

theorem DOU (P:Packet x t y r) (S:Source P.F)
    (hFT:S.T<wt AT P.F)
    (hgates:Gates t y r (S.B-2*S.n0) (S.U-S.n0) (S.T-S.n0)):
