/-- What the count on the live curves asks of the data `Q`, `A`, `c` and of the curves `S a`:

* `pole`: on the component of an active curve, `f = Q + A σ` attains the generic pole `placeT` along every
  prime divisor of the eight charts (Lemma R3 of the referee's inputs; trivial where no coordinate and
  not `σ` has a pole);
* `off_level`: an active curve is not a component of the level curve `L_c`;
* `seed`: `f - c` does not vanish at a seed of an active curve, written without the denominator `H`. -/
structure CurveNeeds (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1)) : Prop where
  pole : ∀ a ∈ active P SZ, ∀ (sR sY sZ : Bool)
    (nu : Valuation (AJ Ω (Exch.component P a.1)) (WithZero (Multiplicative ℤ))),
    SurfaceDivisor (Exch.component P a.1) sR sY sZ nu →
      placeTOn nu (coordinate Ω (Exch.component P a.1))
        (BR Ω (Exch.component P a.1) (baseG P.F) / BR Ω (Exch.component P a.1) (baseH P.F)) ≤
        poleOrder nu (Exch.moving P Q A a.1)
  off_level : ∀ a ∈ active P SZ,
    (S a).val (Exch.moving P Q A a.1 - algebraMap Ω (AJ Ω (Exch.component P a.1)) c) = 1
  seed : ∀ a ∈ active P SZ, ∀ γ ∈ HF Ω (P.stage a.1).G (_Q2 (AL K) (P.stage a.1).F (w + 1))
      (CR (AL K) (P.stage a.1).F) (KK K P.F P.selected P.seeds a.1)
      (DK (AL K) (P.stage a.1).selected) a.2,
    MvPolynomial.eval (DK (AL K) (P.stage a.1).selected γ)
      (baseH P.F * (Q - MvPolynomial.C c) + A * baseG P.F) ≠ 0

/-- The count on the live curves of the X shape: `CurveCount` for the numbers of lane E's objects. -/
def Curve.CountStatement (P : Packet x t y r) (SZ : Source P.F) : Prop :=
  ∀ (budget : ∀ a : Curve P, RD a.2.1 (baseH P.F) (baseG P.F))
    (_ : ∀ a : Curve P, RCN341.BP a.2.1) (N : ℕ)
    (_ : ∀ (g : EX K P.F) (sR sY sZ : Bool), SurfaceNoether (Exch.component P g) sR sY sZ N)
    (_ : 3 * N < 2130706433) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1))
    (_ : ∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a)),
    CurveNeeds P SZ Q A c S →
    CurveCount P SZ budget (fun a => curveMoving (S a) (Exch.moving P Q A a.1) c)
      (Exch.baseOrder P Q A c S)

end
end Packet

