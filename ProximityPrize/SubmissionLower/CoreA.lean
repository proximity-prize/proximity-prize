  apply Finset.sum_le_sum
  intro i _
  rw [Finset.mul_sum,Finset.mul_sum,Finset.mul_sum,← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro j _
  have hc:=hinge_chord a x b (w*i+(w-1)*j) hax hxb
