      exact absurd hz (not_le.2 this)
    · have ha0:(a:L) ≠ 0:=by
        intro h;have:=hunit a ha;rw [h,v.map_zero] at this;exact zero_ne_one this
      refine ⟨s,a,s.2,a.2,hunit a ha,?_⟩
      rw [← inv_inv z,hyz,inv_div]

