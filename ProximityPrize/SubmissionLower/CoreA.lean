   (NN 18000 348 78 (wr-rv) (wy-yv) (wt-tv):ℤ)-(PN wr wy wt:ℤ):=by
 have hb:1≤rv-r∨rv-r=0∧yv-y=0∧tv-t=0:=by
  rcases hB with hb | ⟨rfl,rfl,rfl⟩<;>omega
