      apply DFunLike.ext
      intro Q
      change center K x u0 u1 (center K (-x) (-u0) (-u1) Q)=Q
      simpa using DIB K (-x) (-u0) (-u1) Q)
    (by
      apply DFunLike.ext
      intro Q
