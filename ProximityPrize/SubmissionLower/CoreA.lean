/-!
The count of `A₁` on the level curve for a packet (package X3b, lane L; brief steps 5 and 6).

* `separable`: a separable literal coordinate on every component of the level curve of a packet, from the
  tree's `RCN003.RH`: a component lies on the stage surface and on the level cut `H (c - Q) - A G`, whose
  flag `⟨t - y, y - r, r + 1⟩` is within the degree gates because `t ≤ 5000`.
* `level_count`: the sum of `component_count` over the geometric components, the section bound of lane M
  for the three unit flags and the arithmetic of the price.
* `level_count_cell`: the same for the flag `⟨t - y, y - r, r - 1⟩` of `H` on the cell of the packet.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.LevelCount

section Flag

open RCN002 RCN095 RCN204

theorem flagPole_eq_units {L : Type*} [Field L] (v : Valuation L (WithZero (Multiplicative ℤ)))
    (x : Fin 3 → L) (W : FlagDegree) :
    flagPole v x W = (W.zOnly : ℤ) * flagPole v x unitZFlag + (W.yz : ℤ) * flagPole v x unitYZFlag +
      (W.all : ℤ) * flagPole v x unitAllFlag := by
  simp only [flagPole, unitZFlag, unitYZFlag, unitAllFlag, Nat.cast_one, Nat.cast_zero, one_mul,
    zero_mul, add_zero, zero_add]

/-- The flag of the level cut `H (c - Q) - A Gs`. -/
theorem levelCut_flag {E : Type*} [Field E] {a b s : ℕ} {H Gs Q A : MvPolynomial (Fin 3) E}
    (hH : BI ⟨a, b + 1, s + 1⟩ H) (hGs : BI ⟨a, b, s + 3⟩ Gs) (hQ : BI (2 • unitAllFlag) Q)
    (hA : BI unitYZFlag A) (c : E) : BI ⟨a, b + 1, s + 3⟩ (RCN207.JF H Gs Q A c) := by
  have h1 : BI (⟨a, b + 1, s + 1⟩ + 2 • unitAllFlag) (H * (MvPolynomial.C c - Q)) :=
    RCN207.CUL hH (RCN207.BBP (RCN207.inFlag_const _ c) hQ)
  have h2 : BI (⟨a, b, s + 3⟩ + unitYZFlag) (Gs * A) := RCN207.CUL hGs hA
  rw [RCN207.JF, mul_comm A Gs]
  exact RCN207.BBP h1 h2

variable {E : Type} [Field E] {G : Ideal (MvPolynomial (Fin 3) E)} [G.IsPrime]

attribute [local instance] LevelComponent.isPrime

/-- `[L_c . W]` is linear in the flag. -/
theorem levelFlagSum_eq_units {f : AJ E G} {c : E} (s : Finset (LevelComponent G f c))
    (T : ∀ B : LevelComponent G f c, Finset (RCN026.Place E (AJ E B.prime))) (W : FlagDegree) :
    levelFlagSum s T W = (W.zOnly : ℤ) * levelFlagSum s T unitZFlag +
      (W.yz : ℤ) * levelFlagSum s T unitYZFlag + (W.all : ℤ) * levelFlagSum s T unitAllFlag := by
  simp only [levelFlagSum, Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun B _ => Finset.sum_congr rfl fun v _ => ?_
  rw [flagPole_eq_units v.val (coordinate E B.prime) W]
  ring

end Flag

section Packet
noncomputable section
open scoped Classical BigOperators
open WithZero
open RCN002 RCN074 RCN095 RCN135 RCN136 RCN159 RCN222 RCN264 RCN313 RCN334
open DU BD AFA RL BOE HFree6812 FA
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

attribute [local instance] LevelComponent.isPrime Exch.component_isPrime Exch.fact_irreducible

/-- `H = ∂F/∂R` is not zero on a geometric component of the carrier of a packet. -/
theorem baseH_ne_zero (P : Packet x t y r) (g : EX K P.F) :
    BR Ω (Exch.component P g) (baseH P.F) ≠ 0 := by
  rw [baseH, ← Exch.embedding_sliceProj]
  refine (map_ne_zero _).mpr fun h => ?_
  exact RCN267.AYK P.F 2130706433 P.rdegree (P.IZ.2.1.trans_lt (by have := packet_r_le P; omega))
    ((BMJ P.F _).1 h)

/-- A separable literal coordinate on every component of the level curve of a packet, for `Q`, `A` of
the two flags and a constant `c` that is not the value of the moving function on the component. -/
theorem separable (P : Packet x t y r) (Q A : MvPolynomial (Fin 3) Ω) (hQ : BI (2 • unitAllFlag) Q)
    (hA : BI unitYZFlag A) (c : Ω) (g : EX K P.F)
    (hne : Exch.moving P Q A g ≠ algebraMap Ω (AJ Ω (Exch.component P g)) c)
    (B : LevelComponent (Exch.component P g) (Exch.moving P Q A g) c) :
    Nonempty (RCN341.BP B.prime) := by
  have hchar : CharP Ω 2130706433 := RCN135.MP K 2130706433
  have hrlo := P.rlow
  have hylo := P.ylow
  have hyt := P.yt
  have hthi := packet_t_le P
  obtain ⟨hHf, hGf⟩ := RCN201.DGW (AL K) (cellA t y) (cellB y r) (cellS r) P.F P.support.IZ.2.1
    P.support.ys_weight P.support.total_weight
  have hT := levelCut_flag hHf hGf hQ hA c
  refine nonempty_separable_levelComponent (p := 2130706433) rfl (P.stage g).MW
    (Gs := baseG P.F) (Q := Q) (A := A) (baseH_ne_zero P g) hne (surfaceMap (AL K) P.F)
    (RCN136.ZL (AL K) (RCN135.DI K) P.F P.irreducible.ne_zero) (P.stage g).RR ⟨t - y, y - r, r⟩ _
    (P.parent_flag Ω (AL K)) hT ?_ ?_ B
  · show t - y + (y - r) + r < 2130706433
    omega
  · show 2 * (t - y + (y - r) + r) * (cellA t y + (cellB y r + 1) + (cellS r + 3)) < 2130706433
    have h1 : t - y + (y - r) + r = t := by omega
    have h2 : cellA t y + (cellB y r + 1) + (cellS r + 3) = t + 1 := by
      simp only [cellA, cellB, cellS]
      omega
    rw [h1, h2]
    nlinarith

/-- The count of `A₁` on the level curve of a packet. -/
theorem level_count (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F)
    (scale z u v : ℕ) : Statement P hp SZ scale z u v := by
  intro Hf Q A c S hS hW hneeds hsec hc hI N hN hNp htail hQ hA
  have hchar : CharP Ω 2130706433 := RCN135.MP K 2130706433
  let live : ∀ g : EX K P.F, Finset (CM (P.stage g)) := fun g =>
    Finset.univ.filter fun C => SZ.leading (AL K) ∉ C.1
  have hmem : ∀ (g : EX K P.F) (C : CM (P.stage g)), C ∈ live g → (⟨g, C⟩ : Curve P) ∈ active P SZ :=
    fun g C hC => Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp hC).2⟩
  have hcomp : ∀ g : EX K P.F, ∃ (s : Finset (LevelComponent (Exch.component P g)
      (Exch.moving P Q A g) c)) (T : ∀ B : LevelComponent (Exch.component P g)
        (Exch.moving P Q A g) c, Finset (RCN026.Place Ω (AJ Ω B.prime))),
      ((∑ C ∈ live g, 3 * SZ.d * multiplicity P hp ⟨g, C⟩ *
          curveMoving (S ⟨g, C⟩) (Exch.moving P Q A g) c +
        baseNumber (Exch.moving P Q A g) c (Exch.function P SZ g) (Exch.flag SZ Hf) : ℕ) : ℤ) ≤
        levelFlagSum s T (Exch.flag SZ Hf) := by
    intro g
    have M : Setup (Exch.component P g) N 2130706433 (P.stage g).G (baseH P.F)
        (Exch.moving P Q A g) c (Exch.function P SZ g) (Exch.flag SZ Hf) :=
      { algClosed := inferInstance
        charP := hchar
        noether := hN g
        char := hNp
        coord := Exch.coordinate_ne_zero P g hc
        irreducible := (P.stage g).MW
        span := rfl
        needs := hneeds.component g
        regular := Exch.localFunction_function_mem P SZ Hf hI g
        sep := separable P Q A hQ hA c g (hneeds.component g).ne
        closure := hneeds.levelClosure g }
    exact component_count M (live g) (fun C => S ⟨g, C⟩)
      (fun C hC => hS ⟨g, C⟩ (hmem g C hC))
      (fun C _ => TE Ω C.1 fun pt => PU Ω _ _ _ C pt)
      (fun C _ C' _ h => Subtype.ext h)
      (fun C hC => hneeds.live ⟨g, C⟩ (hmem g C hC))
      (fun C => 3 * SZ.d * multiplicity P hp ⟨g, C⟩)
      (fun C hC => Exch.val_function_le P hp SZ ⟨g, C⟩ (S ⟨g, C⟩) (hS ⟨g, C⟩ (hmem g C hC))
        (htail ⟨g, C⟩ (hmem g C hC)))
      (fun C hC => hneeds.closure ⟨g, C⟩ (hmem g C hC))
  choose s T hsT using hcomp
  obtain ⟨hz, hu, hv⟩ := hsec s T
  have hsum : ∑ a ∈ active P SZ, multiplicity P hp a *
      curveMoving (S a) (Exch.moving P Q A a.1) c =
      ∑ g, ∑ C ∈ live g, multiplicity P hp ⟨g, C⟩ *
        curveMoving (S ⟨g, C⟩) (Exch.moving P Q A g) c := by
    simp only [live, active, Finset.sum_filter]
    rw [Fintype.sum_sigma]
  have htotal : ((3 * SZ.d * scale * (∑ a ∈ active P SZ, multiplicity P hp a *
        curveMoving (S a) (Exch.moving P Q A a.1) c) +
      scale * Exch.lam P SZ Q A c (Exch.flag SZ Hf) : ℕ) : ℤ) ≤
      (scale : ℤ) * ∑ g, levelFlagSum (s g) (T g) (Exch.flag SZ Hf) := by
    have h1 : 3 * SZ.d * scale * (∑ a ∈ active P SZ, multiplicity P hp a *
          curveMoving (S a) (Exch.moving P Q A a.1) c) +
        scale * Exch.lam P SZ Q A c (Exch.flag SZ Hf) =
        scale * ∑ g, (∑ C ∈ live g, 3 * SZ.d * multiplicity P hp ⟨g, C⟩ *
            curveMoving (S ⟨g, C⟩) (Exch.moving P Q A g) c +
          baseNumber (Exch.moving P Q A g) c (Exch.function P SZ g) (Exch.flag SZ Hf)) := by
      rw [hsum, Exch.lam, Finset.sum_add_distrib, Nat.mul_add]
      congr 1
      simp only [Finset.mul_sum]
      refine Finset.sum_congr rfl fun g _ => Finset.sum_congr rfl fun C _ => ?_
      ring
    rw [h1, Nat.cast_mul, Nat.cast_sum]
    exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun g _ => hsT g) (Int.natCast_nonneg _)
  have hlin : (scale : ℤ) * ∑ g, levelFlagSum (s g) (T g) (Exch.flag SZ Hf) ≤
      ((price (Exch.flag SZ Hf) z u v : ℕ) : ℤ) := by
    simp only [levelFlagSum_eq_units _ _ (Exch.flag SZ Hf), Finset.sum_add_distrib,
      ← Finset.mul_sum]
    rw [price]
    push_cast
    nlinarith [mul_le_mul_of_nonneg_left hz (Int.natCast_nonneg (Exch.flag SZ Hf).zOnly),
      mul_le_mul_of_nonneg_left hu (Int.natCast_nonneg (Exch.flag SZ Hf).yz),
      mul_le_mul_of_nonneg_left hv (Int.natCast_nonneg (Exch.flag SZ Hf).all)]
  have hprice : price (Exch.flag SZ Hf) z u v ≤
      SZ.d * price (cellCutR t y r) z u v + 4 * (w + 1) * price SZ.flag z u v := by
    simp only [price]
    nlinarith [Nat.mul_le_mul_right z hW.1, Nat.mul_le_mul_right u hW.2.1,
      Nat.mul_le_mul_right v hW.2.2]
  exact (Int.ofNat_le.mp (htotal.trans hlin)).trans hprice

/-- The count of `A₁` on the level curve of a packet for the flag `⟨t - y, y - r, r - 1⟩` of `H` on its
cell: the flag `d • cutR w + (4 w) • S.flag` of `A₁` is below `d • cellCutR + 4 (w + 1) • S.flag`. -/
theorem level_count_cell (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F)
    (scale z u v : ℕ) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (Exch.component P a.1)) (AJ Ω a.2.1))
    (hS : ∀ a ∈ active P SZ, IsCurveOnSurface (Exch.component P a.1) a.2.1 (S a))
    (hneeds : LevelNeeds P SZ Q A c S) (hsec : SectionBound P scale z u v Q A c)
    (hc : ∀ j, sliceCoord P.F j ≠ 0)
    (hI : ∀ sR sY sZ, PsiSIntegral P.F P.F (dvd_refl P.F) SZ ⟨t - y, y - r, r - 1⟩ sR sY sZ)
    (N : ℕ) (hN : ∀ g sR sY sZ, SurfaceNoether (Exch.component P g) sR sY sZ N)
    (hNp : 3 * N < 2130706433) (htail : Exch.TailOrder P hp SZ S)
    (hQ : BI (2 • unitAllFlag) Q) (hA : BI unitYZFlag A) :
    LevelCount P hp SZ scale z u v (fun a => curveMoving (S a) (Exch.moving P Q A a.1) c)
      (Exch.lam P SZ Q A c (Exch.flag SZ ⟨t - y, y - r, r - 1⟩)) := by
  refine level_count P hp SZ scale z u v ⟨t - y, y - r, r - 1⟩ Q A c S hS ?_ hneeds hsec hc hI N hN
    hNp htail hQ hA
  rw [Exch.flag_cell, cellCutR, show RCN327.w = w from rfl]
  simp only [cutR, add_zOnly, add_yz, add_all, nsmul_zOnly, nsmul_yz, nsmul_all]
  refine ⟨?_, ?_, ?_⟩ <;> nlinarith [Nat.zero_le (SZ.d * (2 * (t - y))),
    Nat.zero_le (SZ.d * (2 * (y - r))), Nat.zero_le (SZ.d * (2 * r - 7)), Nat.zero_le SZ.flag.zOnly,
    Nat.zero_le SZ.flag.yz, Nat.zero_le SZ.flag.all]

end
end Packet

end ProximityPrize.SubmissionLower.FormalR.LevelCount
end
