  c1:ℤ
  c2:ℤ
  c3:ℤ

def Cubic.eval (p:Cubic) (x:ℤ):ℤ:=((p.c3*x+p.c2)*x+p.c1)*x+p.c0
def Cubic.deriv (p:Cubic) (x:ℤ):ℤ:=(3*p.c3*x+2*p.c2)*x+p.c1

theorem EOO (p:Cubic) (a b x:ℤ):
    (b-a)^3*p.eval x=p.eval a*(b-x)^3+
