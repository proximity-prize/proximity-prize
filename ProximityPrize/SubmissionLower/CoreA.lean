      _≤ ∑ nu ∈ Pl,flagPole nu.val (coordinate E C) Hf:=Finset.sum_le_sum (fun nu _=>hpoleH nu)
      _≤_:=Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_right
