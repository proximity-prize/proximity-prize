  (EGI S hp geometry) (suppliedBase S geometry)

def DKL:AND (suppliedUnit S hp geometry):=
  EZN (EW S) (EGI S hp geometry)
    (suppliedBase S geometry)
    (EYJ geometry.base geometry.hactive geometry.hZ
      (RCN315.EH S) geometry.data
