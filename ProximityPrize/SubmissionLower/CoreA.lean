     rcases hc with hc|hc
     · have hh:=middle_of_positive p a b hab ((pos_iff _).mpr ha) ((pos_iff _).mpr hb) hc
       exact ⟨(nonneg_iff _).mp hh.1,(nonneg_iff _).mp hh.2⟩
     · exact hc
   · rintro ⟨ha,hb,hc⟩
     exact ⟨ha,hb,Or.inr hc⟩
