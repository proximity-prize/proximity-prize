/-!
The data of the exchange for a packet, in the objects of level E: the prime of a geometric component, the
embedding of the function field of the carrier, the function `A₁`, its flag, the moving function, the base
orders `o` and the number `Lam` of `ExchangeCount` and `LevelCount`, and the tail bridge `TailOrder` as a
statement.
-/

set_option autoImplicit false

namespace ProximityPrize.SubmissionLower.FormalR.Exch

section
noncomputable section
open scoped Classical
open WithZero
open RCN002 RCN074 RCN095 RCN135 RCN136 RCN159 RCN222 RCN264 RCN313 RCN334
open DU BD AFA BOE HFree6812
local notation "w" => RCN326.w
variable {K I : Type} [Field K] [CharP K 2130706433]
local instance : DecidableEq K := Classical.decEq K
local instance : DecidableEq I := Classical.decEq I
variable {x : I → K} {t y r : ℕ}
local notation "Ω" => GenericField K

/-- The prime of the geometric component `g` of the carrier of a packet. -/
abbrev component (P : Packet x t y r) (g : EX K P.F) : Ideal (MvPolynomial (Fin 3) Ω) :=
  Ideal.span {(P.stage g).G}

theorem component_isPrime (P : Packet x t y r) (g : EX K P.F) : (component P g).IsPrime :=
  (Ideal.span_singleton_prime (P.stage g).MW.ne_zero).mpr
    (UniqueFactorizationMonoid.irreducible_iff_prime.mp (P.stage g).MW)

attribute [local instance] component_isPrime

omit [CharP K 2130706433] in
theorem fact_irreducible (P : Packet x t y r) : Fact (Irreducible P.F) :=
  ⟨P.irreducible⟩

theorem sliceMap_component (P : Packet x t y r) (g : EX K P.F) (A : MvPolynomial (Fin 4) K) :
    sliceMap (K := K) (component P g) A = BR Ω (component P g) (surfaceMap (AL K) A) :=
  rfl

/-- The polynomials that vanish on a geometric component of the carrier of a packet are the multiples
of the polynomial of the packet. -/
theorem ker_sliceMap_component (P : Packet x t y r) (g : EX K P.F) :
    RingHom.ker (sliceMap (K := K) (component P g)) = Ideal.span {P.F} := by
  have hG : Irreducible (P.stage g).G := (P.stage g).MW
  have hF : Irreducible P.F := P.irreducible
  have hker : RingHom.ker (sliceMap (K := K) (component P g)) = RCN219.AWO (component P g) := by
    ext A
    rw [RingHom.mem_ker, RCN219.AOX, sliceMap_component]
    exact ABU (component P g) _
  have hGheight : (component P g).height = 1 :=
    Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero hG.ne_zero) hG.not_isUnit
  have hQprime : (RingHom.ker (sliceMap (K := K) (component P g))).IsPrime := RingHom.ker_isPrime _
  have hQheight : (RingHom.ker (sliceMap (K := K) (component P g))).height ≤ 1 := by
    rw [hker, ← hGheight]
    exact RCN219.BCQ _
  have hFprime : (Ideal.span {P.F}).IsPrime :=
    (Ideal.span_singleton_prime hF.ne_zero).mpr (UniqueFactorizationMonoid.irreducible_iff_prime.mp hF)
  have hFheight : (Ideal.span {P.F}).height = 1 :=
    Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero hF.ne_zero) hF.not_isUnit
  have hle : Ideal.span {P.F} ≤ RingHom.ker (sliceMap (K := K) (component P g)) := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, hker, RCN219.AOX]
    exact Ideal.mem_span_singleton.mpr (P.stage g).RR
  by_contra hne
  have hlt := Ideal.height_add_one_le_of_lt_of_isPrime (lt_of_le_of_ne hle (Ne.symm hne))
  rw [hFheight] at hlt
  exact absurd (hlt.trans hQheight) (by decide)

/-- The embedding of the function field of the carrier into the function field of the geometric
component `g` (the tree's `RY`). -/
def embedding (P : Packet x t y r) (g : EX K P.F) :
    haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
    SliceField P.F →+* AJ Ω (component P g) :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  RY (component P g) P.F (ker_sliceMap_component P g)

/-- The tail bridge (T-b): along a live curve the image of the slice tail `τ_w` has order at least the
tree's local multiplicity. -/
def TailOrder (P : Packet x t y r) (hp : ¬P.F ∣ numerator K P.F (w + 1)) (SZ : Source P.F)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1)) : Prop :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  ∀ a ∈ active P SZ, (S a).val (embedding P a.1 (tail P.F P.F (dvd_refl P.F) w)) ≤
    exp (-(multiplicity P hp a : ℤ))

/-- The moving function `f = Q + A σ` on the geometric component `g`. -/
def moving (P : Packet x t y r) (Q A : MvPolynomial (Fin 3) Ω) (g : EX K P.F) :
    AJ Ω (component P g) :=
  RCN208.movingValue (component P g) (baseH P.F) (baseG P.F) Q A

/-- `A₁ = Ψ_S(w)` for the source `SZ` on the geometric component `g`:
`τ_w ^ (3 d) * H ^ (2 w d) * c_N ^ (4 w)`. -/
def function (P : Packet x t y r) (SZ : Source P.F) (g : EX K P.F) : AJ Ω (component P g) :=
  haveI : Fact (Irreducible P.F) := ⟨P.irreducible⟩
  embedding P g (psiS P.F P.F (dvd_refl P.F) SZ w)

/-- The flag of `A₁` for a flag `Hf` of `H`: `d • cutFlag w Hf + (4 w) • S.flag`. -/
def flag {F : MvPolynomial (Fin 4) K} (SZ : Source F) (Hf : FlagDegree) : FlagDegree :=
  SZ.d • cutFlag w Hf + (4 * w) • SZ.flag

omit [CharP K 2130706433] in
/-- For the flag `⟨t - y, y - r, r - 1⟩` of `H` on a cell, the flag of `A₁` is
`d • cutR w + (4 w) • S.flag`. -/
theorem flag_cell {F : MvPolynomial (Fin 4) K} (SZ : Source F) (t y r : ℕ) :
    flag SZ ⟨t - y, y - r, r - 1⟩ = SZ.d • cutR w r (y - r) (t - y) + (4 * w) • SZ.flag := by
  rw [flag, cutFlag, cutR, show 2 * (r - 1) - 5 = 2 * r - 7 by omega]

/-- The base orders of `ExchangeCount` and `CurveCount` for the data `Q`, `A`, `c` and the curves `S`. -/
def baseOrder (P : Packet x t y r) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (S : ∀ a : Curve P, Specialization (AJ Ω (component P a.1)) (AJ Ω a.2.1)) (n : ℕ)
    (a : Curve P) : ℕ :=
  curveBase (S a) (moving P Q A a.1) c n

/-- `Lam` of `ExchangeCount` and `LevelCount`: the sum over the geometric components of the base
numbers of `A₁` with the flag `W`. -/
def lam (P : Packet x t y r) (SZ : Source P.F) (Q A : MvPolynomial (Fin 3) Ω) (c : Ω)
    (W : FlagDegree) : ℕ :=
  ∑ g : EX K P.F, baseNumber (moving P Q A g) c (function P SZ g) W

end
end

end ProximityPrize.SubmissionLower.FormalR.Exch
end
