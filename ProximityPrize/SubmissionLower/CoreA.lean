    (hJne:(asS J).map (carrierMap P.F)≠0)
    (hroot:((asS J).map (carrierMap P.F)).rootMultiplicity (ratio (carrierMap P.F) P.F)=m)
    (hnu:weightedTotalDegree CW.codeWeights J=nu)
