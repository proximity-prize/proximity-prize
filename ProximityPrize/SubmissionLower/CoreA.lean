  have hsc:=Nat.mul_le_mul_left a.q hs0
  have huc:=Nat.mul_le_mul_left a.q hu0
  have htc:=Nat.mul_le_mul_left a.q ht0
  have hcc:=Nat.mul_le_mul_left a.q hcode
  simp only [Impossible,remC,remT,remB]
