 (hr:r<50) (hRR:r≤rv) (hRW:rv≤wr)
 (hYV:y≤yv) (hYW:yv≤wy) (hY:wy≤229)
 (hTV:t≤tv) (hTW:tv≤wt) (hT:wt≤11784)
