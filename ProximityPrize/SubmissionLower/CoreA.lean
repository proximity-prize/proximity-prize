      ⟨2*z*d,1+2*v*d,2*(r-1)*d⟩:=by
  unfold paddedTail
  have hs:padS (⟨z,v,r⟩:FlagDegree)=r:=by
    simp only [padS]
    omega
  have hy:padY (⟨z,v,r⟩:FlagDegree)=r+v:=by
    simp only [padY,middle,hs]
    omega
  have ht:padT (⟨z,v,r⟩:FlagDegree)=r+v+z:=by
