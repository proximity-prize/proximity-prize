  classical
  let m:=B+R+1
  have hz (n:ℕ) (hn:n≤B):(EM K 0 0 0 F).coeff n=0:=by
    have hnm:n<m:=by dsimp [m];omega
    let p:=blocksOf K m (⟨F,hbox⟩:BA K DF 1 T R) ⟨n,hnm⟩
    have hp:(blockJet K (min n T) T R (m-n)) p=0:=by
      change contactJet K (m-n) p.val=0
