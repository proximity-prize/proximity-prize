      ∀ γ ∈ Γ, (P γ).degree < 131072 ∧ (errorSet u (D \ F) γ (P γ)).card = d ∧
        ¬ JointOn u (goodSet u (D \ F) γ (P γ)) := by
  dsimp only
  obtain ⟨γ, hγ⟩ := hΓ
  have hle := Finset.card_le_card (curveFixed_errors h hγ (hQ γ hγ))
  rw [(hreg.mark γ hγ).2.1] at hle
