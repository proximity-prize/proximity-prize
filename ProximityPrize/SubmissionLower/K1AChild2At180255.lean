  if b ≤ q then oldPlanePrice A a b
  else min (oldPlanePrice A a b)
    (max (oldPlanePrice A a q) (newPlanePrice (curveBeta A a C) A a b))

def nativePlanePrice (r g : ℕ) : ℚ :=
