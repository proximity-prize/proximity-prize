  let V := atSlope Q.V γ
  have hrel (i : E) : U.eval (y i) * e i + V.eval (y i) * frobenius K p (e i) = 0 :=
    Strata.decoder_error_identity (frobenius K p) x w hx hfix 131072 H U V _
