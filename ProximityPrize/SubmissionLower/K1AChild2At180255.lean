    (Strata.twoConjugations (frobenius K p)) node (fun i => u 0 i + γ * u 1 i)
    IRSProfile.domain.injective hfix M.decoder 131072 49183 81889 M.degree
    (by rw [IRSProfile.card_index]) E (by omega) hEagree
