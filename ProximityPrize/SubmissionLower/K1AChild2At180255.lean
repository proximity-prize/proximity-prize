      have h := Strata.syndrome_polynomial_multiple x (w b) (B b) (a - 1) j.val (hb b)
      rw [Fin.sum_univ_eq_sum_range (fun n => (B b).coeff n * syndrome x (w b) (n + j.val))] at h ⊢
      simpa only [heq] using h
