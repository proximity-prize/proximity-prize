      (s := (Finset.univ : Finset D')) (p := fun i => P.eval (x i) = w i)
    have hS' : S = Finset.univ.filter (fun i => P.eval (x i) = w i) := by
      ext i
      simp [hgood]
    have hE' : E = Finset.univ.filter (fun i => P.eval (x i) ≠ w i) := by
