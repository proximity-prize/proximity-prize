  have hfix (i : D') : frobenius K p (x i) = x i := Native.native_domain_fixed i.val
  have hfix₂ (b : Fin 2) (i : D') : Strata.twoConjugations (frobenius K p) b (x i) = x i := by
    fin_cases b <;> simp [Strata.twoConjugations, hfix]
