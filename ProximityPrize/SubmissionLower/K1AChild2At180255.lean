    simp [S, goodSet, x, w, Finset.mem_subtype, i.property]
  have herr (i : D') : i ∈ E ↔ P.eval (x i) ≠ w i := by
    simp [E, errorSet, goodSet, x, w, Finset.mem_subtype, i.property]
