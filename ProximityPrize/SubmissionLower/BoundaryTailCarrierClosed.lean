/-- Closed form for `carriers` on the admissible range. -/
def carClosed (R V : ℕ) : Carrier :=
  if V < 2 then carHead R V else
  let t := V - 2
  ⟨kA0 R * (t*(t-1)) + kB0 R * t + kC0 R,
   kA1 R * (t*(t-1)) + kB1 R * t + kC1 R,
   kA2 R * (t*(t-1)) + kB2 R * t + kC2 R,
   kA3 R * (t*(t-1)) + kB3 R * t + kC3 R,
   kA4 R * (t*(t-1)) + kB4 R * t + kC4 R⟩

end ProximityPrize.SubmissionLower.BoundaryTailCarrierClosed
