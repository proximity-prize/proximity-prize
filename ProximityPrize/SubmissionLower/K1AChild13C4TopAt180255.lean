  have he : left = right := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [left, right, e, translate, ray]
    · intro i
      cases i <;>
        simp [left, right, e, translate, ray, atPoint]
  exact DFunLike.congr_fun he F

