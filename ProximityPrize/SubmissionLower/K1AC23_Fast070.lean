  rw [hY, hV]
  congr 1
  ext g
  constructor
  · simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    rintro (rfl | rfl)
    · exact ⟨some 0, rfl⟩
    · exact ⟨none, rfl⟩
  · rintro ⟨o, rfl⟩
    cases o with
