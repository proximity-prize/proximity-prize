set_option Elab.async true

theorem zr14p32:∀ i ∈ List.range 1,ZeroCheckAt 14 (32+i):=by
  intro i hi
  have hi0:i = 0:=by have:=List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast:ZeroAtFast 14 32:=by decide +kernel
  exact zeroAtFast_sound 14 32 hfast

