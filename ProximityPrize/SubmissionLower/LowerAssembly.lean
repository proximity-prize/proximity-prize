theorem chainSeeds_card_le_degree
    (Pc : UnequalParameters) (Q F : MvPolynomial (Fin 4) K) (hQ : Q ≠ 0)
    (hF : F ∈ positiveRFactors Q) (j : ℕ) (hj1 : 1 ≤ j) (hj : j ≤ chainLength F)
