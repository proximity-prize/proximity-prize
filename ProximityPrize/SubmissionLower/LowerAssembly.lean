def choice : ℕ → ℕ → ℕ → ℕ → ℕ
  | 0,r,v,z => LocatorOrdinaryZConvex.rawCost r v z
  | 1,r,v,z => profile 47 157 2233 5 7 r v z
  | 2,r,v,z => profile 38 130 2141 4 5 r v z
  | _,r,v,z => profile 41 146 2111 4 7 r v z

def ChoiceActive : ℕ → ℕ → ℕ → ℕ → Prop
  | 0,_,_,_ => True
  | 1,r,v,z => 3 ≤ r ∧ 2 ≤ v ∧ 2233 < z
  | 2,r,v,z => 3 ≤ r ∧ 2 ≤ v ∧ 2141 < z
  | _,r,v,z => 3 ≤ r ∧ 2 ≤ v ∧ 2111 < z
instance (w r v z : ℕ) : Decidable (ChoiceActive w r v z) := by
  unfold ChoiceActive
  split <;> infer_instance

def choiceSlope : ℕ → ℕ → ℕ → ℕ
  | 0,r,v => Lower80788.BaseDirectAudit.candidateSlope r v
  | 1,r,v => slope 47 157 2233 5 7 r v
  | 2,r,v => slope 38 130 2141 4 5 r v
  | _,r,v => slope 41 146 2111 4 7 r v

theorem cap_le_choice (w r v lo z : ℕ) (h : ChoiceActive w r v lo) (hz : lo ≤ z) :
    SecondJetSingleCap.cap (rawFlag r v z) ≤ choice w r v z := by
  have h0 : SecondJetSingleCap.cap (rawFlag r v z) ≤ LocatorHybridCost.ordinaryCostOf (rawFlag r v z) :=
    min_le_left _ _
  have h1 : SecondJetSingleCap.cap (rawFlag r v z) ≤ activated 47 157 2233 5 7 (rawFlag r v z) :=
    (min_le_right _ _).trans (min_le_left _ _)
  have h2 : SecondJetSingleCap.cap (rawFlag r v z) ≤ activated 38 130 2141 4 5 (rawFlag r v z) :=
    (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
  have h3 : SecondJetSingleCap.cap (rawFlag r v z) ≤ activated 41 146 2111 4 7 (rawFlag r v z) :=
    (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _))
  cases w with
  | zero => exact h0
  | succ w =>
    cases w with
    | zero =>
      change 3 ≤ r ∧ 2 ≤ v ∧ 2233 < lo at h
      have ha : 3 ≤ r ∧ 2 ≤ v ∧ 2233 < z := ⟨h.1,h.2.1,h.2.2.trans_le hz⟩
      simpa only [choice,activated,rawFlag,if_pos ha] using h1
    | succ w =>
      cases w with
      | zero =>
        change 3 ≤ r ∧ 2 ≤ v ∧ 2141 < lo at h
        have ha : 3 ≤ r ∧ 2 ≤ v ∧ 2141 < z := ⟨h.1,h.2.1,h.2.2.trans_le hz⟩
        simpa only [choice,activated,rawFlag,if_pos ha] using h2
      | succ w =>
        change 3 ≤ r ∧ 2 ≤ v ∧ 2111 < lo at h
        have ha : 3 ≤ r ∧ 2 ≤ v ∧ 2111 < z := ⟨h.1,h.2.1,h.2.2.trans_le hz⟩
        simpa only [choice,activated,rawFlag,if_pos ha] using h3

theorem choice_affine (w r v lo z : ℕ) (hr : 1 ≤ r) (hlo : 3 ≤ lo)
    (hactive : ChoiceActive w r v lo) (hz : lo ≤ z) :
    choice w r v z = choice w r v lo+choiceSlope w r v*(z-lo) := by
  cases w with
  | zero =>
    simp only [choice,choiceSlope,Lower80788.BaseDirectAudit.candidateSlope]
    rw [LocatorOrdinaryZConvex.rawCost_affine_from_three r v z hr (hlo.trans hz),
      LocatorOrdinaryZConvex.rawCost_affine_from_three r v lo hr hlo]
    have hsub : z-3 = (lo-3)+(z-lo) := by omega
    rw [hsub,Nat.mul_add]
    omega
  | succ w =>
    cases w with
    | zero => exact profile_affine _ _ _ _ _ _ _ lo z (by have := hactive.2.2; omega) hz
    | succ w =>
      cases w with
      | zero => exact profile_affine _ _ _ _ _ _ _ lo z (by have := hactive.2.2; omega) hz
      | succ w => exact profile_affine _ _ _ _ _ _ _ lo z (by have := hactive.2.2; omega) hz

structure Run where
  stop : ℕ
  witness : ℕ
  deriving DecidableEq, Repr

def RunValid (r v : ℕ) (q : BaseRow) (start : ℕ) (run : Run) : Prop :=
  start < run.stop ∧ 3 ≤ start ∧ ChoiceActive run.witness r v start ∧
    BaseCell q start (run.stop-1) ∧
    BaseCell (SecondJetStrictData.lookup r v) start (run.stop-1) ∧
    choice run.witness r v start ≤ q.evalAt start ∧
    choice run.witness r v (run.stop-1) ≤ q.evalAt (run.stop-1) ∧
    (SecondJetStrictData.lookup r v).evalAt start ≤ q.evalAt start ∧
    (SecondJetStrictData.lookup r v).evalAt (run.stop-1) ≤ q.evalAt (run.stop-1)
instance (r v : ℕ) (q : BaseRow) (start : ℕ) (run : Run) :
    Decidable (RunValid r v q start run) := by unfold RunValid; infer_instance

theorem affine_between (f g : ℕ → ℕ) (lo hi z m M : ℕ)
    (hf : ∀ zz, lo ≤ zz → zz ≤ hi → f zz=f lo+m*(zz-lo))
    (hg : ∀ zz, lo ≤ zz → zz ≤ hi → g zz=g lo+M*(zz-lo))
    (hz : lo ≤ z) (hzi : z ≤ hi) (h0 : f lo ≤ g lo) (h1 : f hi ≤ g hi) :
    f z ≤ g z := by
  have hlo : lo ≤ hi := hz.trans hzi
  rw [hf hi hlo le_rfl,hg hi hlo le_rfl] at h1
  rw [hf z hz hzi,hg z hz hzi]
  exact Lower80788.BaseDirectAudit.affine_le_between _ _ _ _ _ _
    (Nat.sub_le_sub_right hzi lo) h0 h1

theorem RunValid.sound (r v : ℕ) (q : BaseRow) (start : ℕ) (run : Run)
    (hr : 1 ≤ r) (h : RunValid r v q start run) (z : ℕ) (hz : start ≤ z) (hzi : z < run.stop) :
    max (SecondJetSingleCap.cap (rawFlag r v z)) (SecondJetStrictData.cap (rawFlag r v z)) ≤ q.evalAt z := by
  rcases h with ⟨hstop,hs3,hactive,hcell,hscell,hc0,hc1,hs0,hs1⟩
  apply max_le
  · apply (cap_le_choice run.witness r v start z hactive hz).trans
    exact affine_between (choice run.witness r v) q.evalAt start (run.stop-1) z
      (choiceSlope run.witness r v) (baseSlopeAt q start)
      (fun zz hlo _ => choice_affine run.witness r v start zz hr hs3 hactive hlo)
      (fun zz hlo hhi => baseAt_affine q start (run.stop-1) zz hcell hlo hhi)
      hz (by omega) hc0 hc1
  · exact affine_between (SecondJetStrictData.lookup r v).evalAt q.evalAt start (run.stop-1) z
      (baseSlopeAt (SecondJetStrictData.lookup r v) start) (baseSlopeAt q start)
      (fun zz hlo hhi => baseAt_affine _ start (run.stop-1) zz hscell hlo hhi)
      (fun zz hlo hhi => baseAt_affine q start (run.stop-1) zz hcell hlo hhi)
      hz (by omega) hs0 hs1

def RunsValid (r v : ℕ) (q : BaseRow) (finish : ℕ) : ℕ → List Run → Prop
  | start,[] => start=finish
  | start,run::runs => run.stop ≤ finish ∧ RunValid r v q start run ∧ RunsValid r v q finish run.stop runs
instance (r v : ℕ) (q : BaseRow) (finish start : ℕ) (runs : List Run) :
    Decidable (RunsValid r v q finish start runs) := by
  induction runs generalizing start with
  | nil => simp only [RunsValid]; infer_instance
  | cons run runs ih => simp only [RunsValid]; infer_instance

theorem RunsValid.sound (r v : ℕ) (q : BaseRow) (finish start : ℕ) (runs : List Run)
    (hr : 1 ≤ r) (h : RunsValid r v q finish start runs) (z : ℕ) (hlo : start ≤ z) (hhi : z < finish) :
    max (SecondJetSingleCap.cap (rawFlag r v z)) (SecondJetStrictData.cap (rawFlag r v z)) ≤ q.evalAt z := by
  induction runs generalizing start with
  | nil => simp only [RunsValid] at h; omega
  | cons run runs ih =>
    simp only [RunsValid] at h
    by_cases hz : z < run.stop
    · exact RunValid.sound r v q start run hr h.2.1 z hlo hz
    · exact ih run.stop h.2.2 (by omega)

def RowValid (r v : ℕ) (q : BaseRow) (runs : List Run) : Prop :=
  max (choice 0 r v 0) (SecondJetStrictData.cap (rawFlag r v 0)) ≤ q.z0 ∧
  max (choice 0 r v 1) (SecondJetStrictData.cap (rawFlag r v 1)) ≤ q.z1 ∧
  max (choice 0 r v 2) (SecondJetStrictData.cap (rawFlag r v 2)) ≤ q.z2 ∧
  RunsValid r v q (6918-r-v) 3 runs
instance (r v : ℕ) (q : BaseRow) (runs : List Run) : Decidable (RowValid r v q runs) := by
  unfold RowValid
  infer_instance

theorem RowValid.sound (r v : ℕ) (q : BaseRow) (runs : List Run)
    (hr : 1 ≤ r) (h : RowValid r v q runs) (z : ℕ) (hz : r+v+z ≤ 6917) :
    max (SecondJetSingleCap.cap (rawFlag r v z)) (SecondJetStrictData.cap (rawFlag r v z)) ≤ q.evalAt z := by
  rcases h with ⟨h0,h1,h2,hrest⟩
  have hb := max_le_max_right (SecondJetStrictData.cap (rawFlag r v z))
    (cap_le_choice 0 r v z z trivial le_rfl)
  by_cases hz0 : z=0
  · subst z
    exact hb.trans (by simpa only [BaseRow.evalAt,if_pos] using h0)
  by_cases hz1 : z=1
  · subst z
    exact hb.trans (by simpa only [BaseRow.evalAt,if_neg Nat.one_ne_zero,if_pos] using h1)
  by_cases hz2 : z=2
  · subst z
    exact hb.trans (by simpa only [BaseRow.evalAt,if_neg (by decide : 2≠0),if_neg (by decide : 2≠1),if_pos] using h2)
  exact RunsValid.sound r v q (6918-r-v) 3 runs hr hrest z (by omega) (by omega)

