section Compact_PhaseBase80791
/-! The ordinary-cost base and the six fixed scalar-prefix phases. -/
set_option Elab.async false
namespace ProximityPrize.SubmissionLower.Lower80791.PhaseSemantics
open ProximityPrize.Benchmark
open scoped BigOperators
open RCN095 RCN130 RCN140 RCN238 RCN266 RCN275 LocatorFactorAggregate
