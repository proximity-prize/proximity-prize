def CachedStrictCheck (R V r v : ℕ) : Prop :=
  let q := SecondJetStrictData.lookup R V
  let c := carrierCosts r v
  let zero := zeroDirect (R - r) (V - v)
  c.c0 + zero ≤ q.z0 ∧
  c.c1 + zero ≤ q.z1 ∧
  c.c2 + zero ≤ q.z2 ∧
  match q.segments with
  | [s] =>
      s.start = 3 ∧ cachedLine R V r v s.start ≤ s.valueAtStart ∧
        cachedSlope r v ≤ s.slope
  | [s₁, s₂] =>
      s₁.start = 3 ∧ s₁.start < s₂.start ∧
        cachedLine R V r v s₁.start ≤ s₁.valueAtStart ∧
        cachedLine R V r v (s₂.start - 1) ≤ s₁.evalAt (s₂.start - 1) ∧
        cachedLine R V r v s₂.start ≤ s₂.valueAtStart ∧
        cachedSlope r v ≤ s₂.slope
  | _ => False

instance (R V r v : ℕ) : Decidable (CachedStrictCheck R V r v) := by
  unfold CachedStrictCheck
  dsimp only
  generalize hq : SecondJetStrictData.lookup R V = q
  cases hs : q.segments with
  | nil => simp only [hs]; infer_instance
  | cons s tail =>
      cases ht : tail with
      | nil => simp only [hs, ht]; infer_instance
      | cons s₂ rest =>
          cases hu : rest with
          | nil => simp only [hs, ht, hu]; infer_instance
          | cons s₃ rest₃ => simp only [hs, ht, hu]; infer_instance

theorem strictCandidateCheck_of_cached (rows : Array BaseRow)
    (R V r v : ℕ) (hc : CarrierCorrect r v)
    (h : CachedStrictCheck R V r v) :
    StrictCandidateCheck rows R V r v := by
  dsimp [CarrierCorrect, Lower80788.CarrierCostDirectData.Correct,
    carrierCosts] at hc
  rcases hc with ⟨h0, h1, h2, h3, h4⟩
  unfold CachedStrictCheck at h
  unfold StrictCandidateCheck
  dsimp only
  simp only [Lower80788.BaseDirectAudit.lookupBaseRow,
    zeroDirect_eq_baseZeroCap] at h ⊢
  unfold cachedLine cachedSlope at h
  dsimp only [carrierCosts] at h
  rw [h0, h1, h2, h3, h4] at h
  exact h



def Cell (R V : ℕ) : Prop :=
  ∀ r ∈ rBoundaryValues R, ∀ v ∈ vBoundaryValues V,
    1 ≤ r → r < R → v ≤ V → CachedStrictCheck R V r v
instance (R V : ℕ) : Decidable (Cell R V) := by unfold Cell; infer_instance

def Layer (R : ℕ) : Prop := ∀ V ∈ List.range (137-R), Cell R V
instance (R : ℕ) : Decidable (Layer R) := by unfold Layer; infer_instance

def AllChecks : Prop := ∀ R ∈ List.range 31, 1 ≤ R → Layer R

theorem strictRows (checks : AllChecks) : SecondJetAggregateBase.StrictRows SecondJetStrictData.cap := by
  intro R V r v z hr hrlt hv hR hRV ht
  rw [←zeroDirect_eq_baseZeroCap]
  apply SecondJetStrictBoundary.strict_candidate_le_of_boundary zeroDirect
    (coordinateShape_of_cached Lower80788.BaseChecked.shape) R V r v z _ hr hrlt hv hR hRV
  intro rr vv hrr hrrlt hvv hRb hVb
  have hc := checks R (List.mem_range.mpr (by omega)) (by omega)
    V (List.mem_range.mpr (by omega))
    rr (mem_rBoundaryValues R rr hRb) vv (mem_vBoundaryValues V vv hvv hVb)
    hrr hrrlt hvv
  have hcorrect : CarrierCorrect rr vv := by
    exact Lower80788.CarrierCostChecked.correct rr (List.mem_range.mpr (by omega)) hrr
      vv (List.mem_range.mpr (by omega))
  have hbound := strictCandidateCheck_sound (#[]) R V rr vv z hrr
    (strictCandidateCheck_of_cached (#[]) R V rr vv hcorrect hc)
  simpa only [zeroDirect_eq_baseZeroCap (#[])] using hbound

