section Compact_PhaseSemantics80791
/-! Connection from finite scalar-prefix receipts to factor-family bounds.
The finite checks and the ordinary base are explicit hypotheses here. -/
set_option Elab.async false
namespace ProximityPrize.SubmissionLower.Lower80791.PhaseSemantics
open ProximityPrize.Benchmark
open scoped BigOperators
open RCN095 RCN238 RCN266 LocatorFactorAggregate
open LocatorPhase6800Oracle (Potential rawFlag rawFlag_all rawFlag_middle rawFlag_total
