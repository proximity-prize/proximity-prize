    congr 1
    change extendParameters (algebraMap Seeds K1A_14_2.SeedField (MvPolynomial.C a)) = _
    rw [extendParameters_apply]
    exact congrArg (algebraMap (MvPolynomial (Fin 4) FX) SectionField)
      (MvPolynomial.rename_C parameterIndices a)
  · intro i
    fin_cases i <;>
      simp [K1A_14_2_3_1.lineRestriction, K1A_14_2_3_1.eliminate, K1A_14_2_3_1.lineValues,
        substitute, seedBase, K1A_14_2.generic, extendParameters_apply, parameterMap,
