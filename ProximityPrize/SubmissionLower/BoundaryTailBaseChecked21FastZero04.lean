theorem zr21p48:∀ i ∈ List.range 1,ZeroCheckAt 21 (48+i):=by
  intro i hi
  have hi0:i = 0:=by have:=List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast:ZeroAtFast 21 48:=by decide +kernel
  exact zeroAtFast_sound 21 48 hfast

