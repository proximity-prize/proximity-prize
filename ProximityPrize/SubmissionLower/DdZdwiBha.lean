  obtain ⟨a, h⟩ := eventually_atTop.mp h
  refine eventually_atTop.mpr ⟨a, fun b hb => h _ (hb.trans ?_)⟩
  exact fun j => Nat.le_add_right _ _
omit [Fintype ι] in
private theorem deltas_congr (used : List ι) {H G : (ι → ℕ) → ℚ} (h : H =ᶠ[atTop] G) :
