private theorem constants_value {k L : Type*} [Field k] [Field L] [Algebra k L]
    (V : ValuationSubring L) (hV : ∀ c : k, algebraMap k L c ∈ V)
    (c : k) (hc : c ≠ 0) : V.valuation (algebraMap k L c) = 1 := by
