  apply congrArg (Submodule.span GeoField)
  ext p
  constructor
  · rintro ⟨_, ⟨e, he, rfl⟩, rfl⟩
    refine ⟨affineWeight A B e, (mem_gradedExponents a _).2 ⟨e, he, rfl⟩, ?_⟩
