    hb.elim (fun h => (Finset.le_sup (f := fun z : σ →₀ ℕ => z x) h).trans (le_max_left _ _))
      (fun h => (Finset.le_sup (f := fun z : σ →₀ ℕ => z x) h).trans (le_max_right _ _))
