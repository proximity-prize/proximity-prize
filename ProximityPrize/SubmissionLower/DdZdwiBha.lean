def extra (B : ℕ) : ℕ := moment B 0 0 2300 1
def credit (B : ℕ) : ℕ := jetSum B fun q _ _ => 2300 + (B - q)
theorem grade_sum (B : ℕ) (f : ℕ → ℕ) :
    jetSum B (fun q _ _ => f q) =
