    b ≤ base (cellOf T e) ↔ b ≤ e := by
  simp only [Finsupp.le_def, base_apply, cellOf, le_min_iff]
  exact ⟨fun h x => (h x).2, fun h x => ⟨hb x, h x⟩⟩
abbrev grade (slot : σ → ι) : (σ →₀ ℕ) →+ (ι → ℕ) :=
