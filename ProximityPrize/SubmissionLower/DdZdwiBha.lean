private theorem sum_gaps_eq {ι : Type} [Fintype ι] {x y : ι → ExponentSpace}
    {w u : ι → ℝ} (hmass : ∑ i, w i = ∑ i, u i)
    (hsum : ∑ i, w i • x i = ∑ i, u i • y i)
