    Ideal.map_isPrime_of_surjective (reduce_surjective I) (reduce_kernel I ▸ image_le I)
  rw [fibre_comp, ← Ideal.map_map]
  exact IsLocalization.isPrime_of_isPrime_disjoint (fibreDenominators I) (GenericFibre I)
