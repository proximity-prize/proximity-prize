      _ = S g * (S g * D g (S g ^ (2*n) * a) -
          (↑(2*n) : Chart g) * D g (S g) * (S g ^ (2*n) * a)) := by ring
      _ = _ := by rw [quotient_rule, pow_succ' (S g) (2*n+1), mul_assoc]
