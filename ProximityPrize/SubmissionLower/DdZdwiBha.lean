private theorem linear_values {k L Γ : Type*} [Field k] [Field L] [Algebra k L]
    [LinearOrderedCommGroupWithZero Γ] (v : Valuation L Γ)
    (hc : ∀ c : k, c ≠ 0 → v (algebraMap k L c) = 1)
