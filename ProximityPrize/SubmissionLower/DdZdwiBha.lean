  have hneg (p : Lower) : (-p).weightedTotalDegree w = p.weightedTotalDegree w :=
    AddMonoidAlgebra.supDegree_neg (D := Finsupp.weight w)
  rcases Int.units_eq_one_or (Equiv.Perm.sign π) with hs | hs <;>
    simpa [hs, hneg] using hprod
