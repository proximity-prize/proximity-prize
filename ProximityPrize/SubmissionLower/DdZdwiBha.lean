    exact v.map_sub_eq_of_lt_left ((hconst a).trans_lt hhigh)
  have hle (a : k) : v (t - algebraMap k L a) ≤ 1 :=
    v.map_sub_le (le_of_not_gt hhigh) (hconst a)
