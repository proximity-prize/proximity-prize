      refine ⟨⟨cellOf T e, (ho e A (fun _ hb => Or.inl hb)).mpr heA, ?_⟩, rfl, hw⟩
      exact fun h => heB ⟨(ho e B (fun _ hb => Or.inr hb)).mp h, hw⟩
    · rintro ⟨p, he, hw⟩
