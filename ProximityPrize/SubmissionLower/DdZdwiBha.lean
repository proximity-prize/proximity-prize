  rw [← Nat.card_coe_set_eq, Nat.card_congr (flatCapEquiv p hb ht), Nat.card_eq_fintype_card]
  change (Fintype.card (Σ y : Fin (p.j + 1), Σ x : Fin (2 * p.j - 2 * y.val + 1),
