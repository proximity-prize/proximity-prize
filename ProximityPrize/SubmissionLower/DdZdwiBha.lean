noncomputable def slotForm (j : Fin 5) (d k : ℕ) : Form :=
  C ((d.factorial : ℚ)⁻¹) *
    ∏ r ∈ Finset.range d, (MvPolynomial.X j + C ((r : ℚ) + 1 - (k : ℚ)))
