  refine ⟨C d⁻¹ * V, C d⁻¹ * U, ?_⟩
  calc
    _ = C d⁻¹ * (H * U + A * V) := by ring
    _ = 1 := by rw [h, ← C_mul, inv_mul_cancel₀ hd, C_1]
