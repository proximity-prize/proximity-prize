  cases d with
  | zero =>
    rw [show a - w = (a - w - 1) + 1 by omega, Nat.multichoose_zero_succ]
    simp [binom]
  | succ d =>
    simp only [Nat.multichoose_eq, binom, Nat.succ_ne_zero, ite_false, Nat.succ_sub_one]
    rw [show d + 1 + (a - w) - 1 = (a - w) + d by omega, Nat.choose_symm_add,
