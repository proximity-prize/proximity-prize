    rw [← Set.image_singleton, ← Ideal.map_span]
    have : (Ideal.span {ordinaryIncl f}).IsPrime :=
      (Ideal.span_singleton_prime hfAmbient.ne_zero).mpr hfAmbient
    exact Ideal.isPrime_map_of_isLocalizationAtPrime I hle
