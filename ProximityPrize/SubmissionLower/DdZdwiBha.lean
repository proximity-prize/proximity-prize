private theorem quotient_rule (g : Row 4) (n : ℕ) (a : Chart g) :
    S g * D g (S g ^ n * a) - (n : Chart g) * D g (S g) * (S g ^ n * a) =
      S g ^ (n + 1) * D g a := by
  induction n with
