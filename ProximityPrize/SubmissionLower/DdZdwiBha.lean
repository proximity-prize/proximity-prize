  have hr : (MvPolynomial.eval₂Hom (Polynomial.C.comp f) g).comp MvPolynomial.C =
      Polynomial.C.comp f := RingHom.ext fun p => by simp
  rw [hl, hr]
  congr 1
  funext i
  simp [g, add_comm]
theorem order_of_locator_lines (P : Row 4) (S L : (Polynomial Geom)) (hL : L ≠ 0) (d : ℕ)
    (h : ∀ (V : (Polynomial Geom)), V.natDegree ≤ 3 → ∀ j < d, (line P S (L * V)).coeff j = 0) :
    OrderAt P S d := by
