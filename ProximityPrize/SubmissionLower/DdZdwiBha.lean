  | nil => exact h
  | cons i used ih =>
    filter_upwards [eventual_shift ih i, ih] with a h₁ h₂
    exact congrArg₂ (· - ·) h₁ h₂
omit [Fintype ι] in
private theorem deltas_comm (used : List ι) (H : (ι → ℕ) → ℚ) (i : ι) (a : ι → ℕ) :
