      apply sum_congr rfl
      intro y hy
      have hy' := mem_range.mp hy
      have hyj : 2 * y ≤ 2 * p.j := by omega
      rw [Fin.sum_univ_eq_sum_range (fun x => ((2 * p.b - (y + x) + 1 : ℕ) : ℚ))]
