private def binom (n d : ℕ) : ℚ :=
  if d = 0 then 0 else (n.choose (d - 1) : ℚ)
private def model (w c d a : ι → ℕ) : ℚ :=
  ∏ i, binom (a i + c i - w i) (d i)
private theorem binom_step (n d : ℕ) :
    binom (n + 1) d - binom n d = binom n (d - 1) := by
  cases d with
  | zero => simp [binom]
  | succ d =>
