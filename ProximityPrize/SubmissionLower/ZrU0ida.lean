   (hstop : ∀ o∈origins b,∀ j∈stops b,0<j→Nonempty (StopRates b o j))
   (hline : ∀ o∈origins b,isLast b o → ∀ r :bTu,
     (∀ q,0< r q∧r q≤originBudget b o q)→ r 1≤ r 0 →
     (lineFee b r :ℚ)≤dotResources (lineCredit b o) r)
   (hrank : ∀ o∈origins b,∀ k,rankPrice b o k≤ng b o 0 k) :
