theorem zero_r23_part80 : ∀ i ∈ List.range 1, ZeroCheckAt 23 (80+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 23 80 := by decide +kernel
  exact zeroAtFast_sound 23 80 hfast

