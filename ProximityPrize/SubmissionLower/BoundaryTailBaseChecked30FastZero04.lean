theorem zero_r30_part48 : ∀ i ∈ List.range 1, ZeroCheckAt 30 (48+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 30 48 := by decide +kernel
  exact zeroAtFast_sound 30 48 hfast

