theorem factor_cover (g : JetPlane) (hg : g ≠ 0) :
    ∃ fs : Finset JetPlane, (∀ f ∈ fs, Irreducible f) ∧
      (∑ f ∈ fs, total f) ≤ total g ∧ (∑ f ∈ fs, f.natDegree) ≤ g.natDegree ∧
