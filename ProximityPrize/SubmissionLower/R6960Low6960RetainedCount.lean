  have eq : 3*t+i=a.j := by dsimp [i]; omega
  have row := List.all_eq_true.mp hcover i hi
  change decide (maxWidth < (tilesOf batches).foldl (step (3*t+i)) ((3*t+i+2)/3))=true at row
