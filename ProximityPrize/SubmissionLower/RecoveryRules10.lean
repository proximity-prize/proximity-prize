set_option maxRecDepth 100000

def budget:ℕ:=274980718450187492
def CoreRow (r y:ℕ):Prop:=13≤r∧r≤17∧59≤y∧y≤76
instance (r y:ℕ):Decidable (CoreRow r y):=by unfold CoreRow;infer_instance
def fee (r y z:ℕ):ℕ:=if CoreRow r y∧3611≤y+z∧y+z≤4879 then 0 else 1

theorem fee_le (r y z:ℕ):fee r y z≤1:=by unfold fee;split<;>omega

theorem GWY (a b cap r y z:ℕ) (h:a≤b):combined a cap r y z≤combined b cap r y z:=by
 unfold combined
 exact Nat.add_le_add_left (Nat.mul_le_mul_right _ h) _

def part (r y start:ℕ) (p:Piece) (lo hi f:ℕ):Bool:=
 if lo≤hi then decide (Fits f r y start p.base p.slope lo hi budget) else true

def checkPiece (limit r y start:ℕ) (p:Piece):Bool:=
 let hi:=min (p.stop-1) (limit-1)
 part r y start p start (min hi (3611-y-1)) 1 &&
 part r y start p (max start (3611-y)) (min hi (4879-y)) (if CoreRow r y then 0 else 1) &&
 part r y start p (max start (4880-y)) hi 1

theorem part_sound (r y start:ℕ) (p:Piece) (lo hi f z:ℕ)
 (h:part r y start p lo hi f=true) (hz:lo≤z) (hh:z≤hi) (hf:fee r y z≤f):
 combined (fee r y z) (value p start z) r y z≤budget:=by
 simp only [part,if_pos (hz.trans hh),decide_eq_true_eq] at h
 exact (GWY _ _ _ _ _ _ hf).trans
  (fits_between f r y start p.base p.slope lo hi budget z h hz hh)

theorem piece_sound (limit r y start:ℕ) (p:Piece) (h:checkPiece limit r y start p=true)
 (z:ℕ) (hz:start≤z) (hh:z<p.stop) (hl:z<limit) (hY:y≤117):
 combined (fee r y z) (value p start z) r y z≤budget:=by
 simp only [checkPiece,Bool.and_eq_true] at h
 by_cases h0:z<3611-y
 · exact part_sound r y start p start (min (min (p.stop-1) (limit-1)) (3611-y-1)) 1 z h.1.1 hz (by omega) (fee_le _ _ _)
 by_cases h1:z≤4879-y
 · apply part_sound r y start p (max start (3611-y)) (min (min (p.stop-1) (limit-1)) (4879-y)) (if CoreRow r y then 0 else 1) z h.1.2 (by omega) (by omega)
   by_cases hc:CoreRow r y
   · have ht:3611≤y+z∧y+z≤4879:=by omega
     simp only [if_pos hc,fee,hc,ht.1,ht.2,and_self,if_true,le_refl]
   · simp only [if_neg hc];exact fee_le _ _ _
 · exact part_sound r y start p (max start (4880-y)) (min (p.stop-1) (limit-1)) 1 z h.2 (by omega) (by omega) (fee_le _ _ _)

def checkRow (limit r v:ℕ) (curve:List Piece):Bool:=
 validFrom (11193-r-v) 0 curve && allCells (checkPiece limit r (r+v)) 0 curve

theorem row_sound (limit r v:ℕ) (curve:List Piece) (h:checkRow limit r v curve=true)
 (z:ℕ) (hz:z<11193-r-v) (hl:z<limit) (hY:r+v≤117):
 combined (fee r (r+v) z) (eval curve z) r (r+v) z≤budget:=by
 simp only [checkRow,Bool.and_eq_true] at h
 apply DMA (fun z c=>z<limit→combined (fee r (r+v) z) c r (r+v) z≤budget) 0 (11193-r-v) curve h.1 _ z (Nat.zero_le _) hz hl
 apply cells_mono _ _ _ _ (ANC _ 0 curve h.2)
 intro lo p hp z hzl hzh hlim
 exact piece_sound limit r (r+v) lo p hp z hzl hzh hlim hY
end MX

