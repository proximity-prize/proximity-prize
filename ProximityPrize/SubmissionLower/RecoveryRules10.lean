def feeNum (r y z:ℕ):=CY.num 88902 1382 308 (50-r) (229-y) (11784-y-z)
def cleared (fee r y start base slope z:ℕ):=
  50164*(base+slope*(z-start)+others r y z)+fee*feeNum r y z

def combined (fee cap r y z:ℕ):=
 cap+r*foldUnit y (y+z) r+(50-r)*foldUnit (229-y) (17230-(y+z)) (50-r)+
 16220000000000+QQ.cap r y (y+z)+fee*(feeNum r y z/50164)

theorem FBM (fee r y start base slope lo hi:ℕ):
 Chord lo hi (cleared fee r y start base slope):=by
 have hsub:Chord lo hi (fun z=>z-start):=by
  simpa only [Nat.zero_mul,Nat.one_mul,Nat.add_zero,Nat.zero_add] using sub_affine lo hi 1 0 0 start
 have hn:=EYQ 88902 1382 308 (50-r) (229-y) lo hi (11784-y)
 exact add (mul_left (add (add (constant lo hi base) (mul_left hsub slope))
   (others_chord r y lo hi)) 50164) (mul_left hn fee)

theorem DGV (fee r y start base slope z:ℕ)
 (hr:r<50) (ht:y+z≤11785):
 50164*combined fee (base+slope*(z-start)) r y z≤cleared fee r y start base slope z:=by
 have hp:=pair_le r y (y+z) ht
 have hd:=Nat.div_mul_le_self (feeNum r y z) 50164
 have hd' :=Nat.mul_le_mul_left fee hd
 unfold combined cleared others
 rw [QQ.cap,if_pos hr]
 nlinarith only [hp,hd']

def Fits (fee r y start base slope lo hi budget:ℕ):Prop:=
 r<50∧y+hi≤11785∧
 cleared fee r y start base slope lo≤50164*budget∧
 cleared fee r y start base slope hi≤50164*budget
instance (fee r y start base slope lo hi budget:ℕ):
 Decidable (Fits fee r y start base slope lo hi budget):=by unfold Fits;infer_instance

theorem fits_between (fee r y start base slope lo hi budget z:ℕ)
 (h:Fits fee r y start base slope lo hi budget) (hz:lo≤z) (hh:z≤hi):
 combined fee (base+slope*(z-start)) r y z≤budget:=by
 have hc:=EIT (FBM fee r y start base slope lo hi)
  (50164*budget) h.2.2.1 h.2.2.2 z hz hh
 have ht:=h.2.1
 exact Nat.le_of_mul_le_mul_left
  ((DGV fee r y start base slope z h.1 (by omega)).trans hc) (by decide)
end ABM

