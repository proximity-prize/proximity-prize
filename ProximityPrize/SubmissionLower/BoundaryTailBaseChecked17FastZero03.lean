theorem zero_r17_part32 : ∀ i ∈ List.range 1, ZeroCheckAt 17 (32+i) := by
  intro i hi
  have hi0 : i = 0 := by have := List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast : ZeroAtFast 17 32 := by decide +kernel
  exact zeroAtFast_sound 17 32 hfast

