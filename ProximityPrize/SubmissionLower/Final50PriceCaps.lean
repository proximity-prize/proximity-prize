def order (k:Band) (x:Shape):ℕ:=orderFor x.b x.j (thresholds k)

def pricingWeight (k : Band) (b j t : ℕ) : ℕ :=
  if k = .empty then KoalaAllocationWeight.weight b j t else j

def pricingDenom (k : Band) : ℕ :=
  pricingWeight k (137 - (start k).b) (56 - (start k).j) 14

def reserveAt (k : Band) (b : ℕ) : ℕ :=
  Final50FatReserve.charge b (start k).j (start k).t

theorem reserveAt_end (k : Band) : reserveAt k (endWidth k) = reserve k := by
  cases k <;> decide +kernel

theorem reserveAt_mono (k : Band) {a b : ℕ} (h : a ≤ b) (hb : b ≤ endWidth k) :
    reserveAt k a≤reserveAt k b:=by
  have hi:endWidth k < 27:=by cases k <;> decide
  have check (k : Band) : ∀ x y : Fin 27, x.val ≤ y.val → reserveAt k x.val ≤ reserveAt k y.val := by
    cases k <;> decide +kernel
  exact check k ⟨a,by omega⟩ ⟨b,by omega⟩ h

def tileReserve (k:Band) (b:ℕ):ℕ:=reserveAt k (min (endWidth k) (137-b))

theorem tileReserve_anti (k : Band) {a b : ℕ} (h : a ≤ b) :
    tileReserve k b≤tileReserve k a :=
  reserveAt_mono k (min_le_min_left _ (Nat.sub_le_sub_left h _)) (min_le_left _ _)

def allowance (top : ℕ) (k : Band) (b j t : ℕ) : ℕ :=
  (factorCap top - tileReserve k b)*pricingWeight k b j t / pricingDenom k

def actualAllowance (top : ℕ) (k : Band) (r b j t : ℕ) : ℕ :=
  (factorCap top - reserveAt k r)*pricingWeight k b j t / pricingDenom k

theorem weight_mono (k : Band) {b j t B J T : ℕ} (hb : b ≤ B) (hj : j ≤ J) (ht : t ≤ T) :
    pricingWeight k b j t≤pricingWeight k B J T:=by
  by_cases h:k = .empty
  · simpa only [pricingWeight,if_pos h] using KoalaAllocationWeight.mono hb hj ht
  · simpa only [pricingWeight,if_neg h] using hj

theorem factorCap_mono {a b : ℕ} (h : a ≤ b) (hb : b ≤ 14) : factorCap a ≤ factorCap b := by
  have ha:=h.trans hb
  interval_cases a <;> interval_cases b <;> decide

theorem actualAllowance_mono {a b r w j t : ℕ} (k : Band) (h : a ≤ b) (hb : b ≤ 14) :
    actualAllowance a k r w j t≤actualAllowance b k r w j t :=
  Nat.div_le_div_right (Nat.mul_le_mul_right _ (Nat.sub_le_sub_right (factorCap_mono h hb) _))

theorem allowance_mono {a b w j t : ℕ} (k : Band) (h : a ≤ b) (hb : b ≤ 14) :
    allowance a k w j t≤allowance b k w j t :=
  Nat.div_le_div_right (Nat.mul_le_mul_right _ (Nat.sub_le_sub_right (factorCap_mono h hb) _))

theorem order_pos (k : Band) (x : Shape) : 0 < order k x :=
  (P0_9_8.orderFor_select x.b x.j (thresholds k)).1

theorem order_mono (k : Band) {x y : Shape} (hb : x.b ≤ y.b) (hj : x.j ≤ y.j) :
    order k x≤order k y:=P0_9_8.orderFor_mono hb hj _
end Final50PriceCaps
