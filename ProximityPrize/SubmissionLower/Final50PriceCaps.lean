def order (k : Band) (x : Shape) : ℕ := orderFor x.b x.j (thresholds k)

def pricingWeight (k : Band) (b j t : ℕ) : ℕ :=
  if k = .empty then KoalaAllocationWeight.weight b j t else j

def pricingDenom (k : Band) : ℕ :=
  pricingWeight k (132 - (start k).b) (55 - (start k).j) 14

def allowance (top : ℕ) (k : Band) (b j t : ℕ) : ℕ :=
  (factorCap top - reserve k) * pricingWeight k b j t / pricingDenom k

theorem weight_mono (k : Band) {b j t B J T : ℕ} (hb : b ≤ B) (hj : j ≤ J) (ht : t ≤ T) :
    pricingWeight k b j t ≤ pricingWeight k B J T := by
  by_cases h : k = .empty
  · simpa only [pricingWeight, if_pos h] using KoalaAllocationWeight.mono hb hj ht
  · simpa only [pricingWeight, if_neg h] using hj

theorem factorCap_mono {a b : ℕ} (h : a ≤ b) (hb : b ≤ 14) : factorCap a ≤ factorCap b := by
  have ha := h.trans hb
  interval_cases a <;> interval_cases b <;> decide

theorem allowance_mono {a b w j t : ℕ} (k : Band) (h : a ≤ b) (hb : b ≤ 14) :
    allowance a k w j t ≤ allowance b k w j t :=
  Nat.div_le_div_right (Nat.mul_le_mul_right _ (Nat.sub_le_sub_right (factorCap_mono h hb) _))

theorem order_pos (k : Band) (x : Shape) : 0 < order k x :=
  (P0_9_8.orderFor_select x.b x.j (thresholds k)).1

theorem order_mono (k : Band) {x y : Shape} (hb : x.b ≤ y.b) (hj : x.j ≤ y.j) :
    order k x ≤ order k y := P0_9_8.orderFor_mono hb hj _
