      (((n - 1 : ℕ) : ℤ) * B + ((n - 2 : ℕ) : ℤ) * D -
        refinedWeight n j (A - h) (B - g) (D - q)) := by
  have hpow (x : L) (e : ℤ) (hx : v x ≤ WithZero.exp e) (k : ℕ) :
      v x ^ k ≤ WithZero.exp ((k : ℤ) * e) := by
    rw [← nsmul_eq_mul, WithZero.exp_nsmul]
