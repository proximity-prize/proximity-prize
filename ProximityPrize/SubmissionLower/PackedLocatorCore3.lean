def cachedLine (R V r v z : ℕ) : ℕ :=
  (carrierCosts r v).c3 + zeroDirect (R - r) (V - v) +
    cachedSlope r v * (z - 3)

/-- Cached form of `CandidateRowCheck`; every arithmetic leaf is a direct
