namespace K1_13_7_4_2
open K1_13_7
abbrev Local (q : PrimeSpectrum Lower) := Localization.AtPrime q.asIdeal
def remainingIdeal {R ι : Type*} [CommRing R] (f : ι → R) (i : ι) : Ideal R :=
  Ideal.span (f '' {j | j ≠ i})
