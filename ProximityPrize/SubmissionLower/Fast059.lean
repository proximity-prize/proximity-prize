def cHead (p : Nat) : Nat := Nat.mod (Nat.div p 262144) 1024
def cValid : Nat → Nat → Bool
  | 0, _ => true
  | n+1, p => (Nat.beq (Nat.mod p 262144) 0 && Nat.ble (cHead p) 524) && cValid n (Nat.div p 268435456)
def cSum : Nat → Nat → Nat → Nat → Nat
