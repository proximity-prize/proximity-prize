local instance : DecidableEq K := Classical.decEq K

def ActualMCACap6916 (B : ℕ) : Prop :=
  ∀ U : Fin 2 → I → Fin IRSProfile.interleaving → K,
    {gamma | IsMCA (AffineLineGenerator K) IRSProfile.code gamma U radius6916}.ncard ≤ B

def badSlopes6916 (U : Fin 2 → I → Fin IRSProfile.interleaving → K) : Finset K := by
  classical
  exact Finset.univ.filter fun gamma ↦
    IsMCA (AffineLineGenerator K) IRSProfile.code gamma U radius6916

theorem badSlopes_card_eq_ncard (U : Fin 2 → I → Fin IRSProfile.interleaving → K) :
    (badSlopes6916 U).card =
      {gamma | IsMCA (AffineLineGenerator K) IRSProfile.code gamma U radius6916}.ncard := by
  classical
  have hs : {gamma | IsMCA (AffineLineGenerator K) IRSProfile.code gamma U radius6916} =
      (badSlopes6916 U : Set K) := by
    ext gamma
    simp [badSlopes6916]
  rw [hs,Set.ncard_coe_finset]

/-- The actual MCA probability, maximizing over arbitrary native IRS8 word pairs. -/
theorem mca_error_le_of_actualCap (B : ℕ) (hcap : ActualMCACap6916 B) :
    mcaError (AffineLineGenerator K) IRSProfile.code radius6916 ≤
      (B : ENNReal) / (Fintype.card K : ENNReal) := by
  classical
  refine iSup_le fun U ↦ ?_
  rw [SampleableType.prEvent_uniformSample_eq_ofReal]
  change ENNReal.ofReal (((badSlopes6916 U).card : ℝ) / Fintype.card K) ≤ _
  have hc : (badSlopes6916 U).card ≤ B := by
    rw [badSlopes_card_eq_ncard]
    exact hcap U
  calc
    _ ≤ ENNReal.ofReal ((B : ℝ) / Fintype.card K) := by
      apply ENNReal.ofReal_le_ofReal
      exact div_le_div_of_nonneg_right (by exact_mod_cast hc) (by positivity)
    _ = _ := by
      rw [ENNReal.ofReal_div_of_pos (by positivity), ENNReal.ofReal_natCast,
        ENNReal.ofReal_natCast]

/-- The independent IRS16 list is already bounded, so only the MCA cap remains. -/
theorem gamma_error_le_of_actualCap (B : ℕ) (hcap : ActualMCACap6916 B)
    (hbudget : (B + Astra7A.weightedListCap) * 2 ^ 128 ≤ Fintype.card K) :
    ToyProblem.certifiedGammaError IRSProfile.code Sol1.C42.At6916.queryRadius ≤ reductionTarget := by
  have hNat := ENat.toNat_le_of_le_natCast squared_lambda_le
  have hList :
      ((Code.Lambda (squaredCode : Set (I → A16)) radius6916).toNat : ENNReal) /
        (Fintype.card K : ENNReal) ≤ (Astra7A.weightedListCap : ENNReal) / Fintype.card K :=
    ENNReal.div_le_div_right (by exact_mod_cast hNat) _
  have hreal : ((B + Astra7A.weightedListCap : ℕ) : ℝ) / Fintype.card K ≤ (1 : ℝ) / 2 ^ 128 := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).2
    norm_num only [one_mul]
    exact_mod_cast hbudget
  have hENN : ((B + Astra7A.weightedListCap : ℕ) : ENNReal) / Fintype.card K ≤
      (1 : ENNReal) / 2 ^ 128 := by
    have h := ENNReal.ofReal_le_ofReal hreal
    rw [ENNReal.ofReal_div_of_pos (by positivity), ENNReal.ofReal_natCast,
      ENNReal.ofReal_natCast, ENNReal.ofReal_div_of_pos (by positivity)] at h
    simpa using h
  rw [← ENNReal.coe_le_coe,ToyProblem.coe_certifiedGammaError]
  calc
    _ ≤ (B : ENNReal) / Fintype.card K + (Astra7A.weightedListCap : ENNReal) / Fintype.card K :=
      add_le_add (mca_error_le_of_actualCap B hcap) hList
    _ = ((B + Astra7A.weightedListCap : ℕ) : ENNReal) / Fintype.card K := by
      rw [← ENNReal.add_div,Nat.cast_add]
    _ ≤ (1 : ENNReal) / 2 ^ 128 := hENN
    _ = (reductionTarget : ENNReal) := by
      norm_num [reductionTarget,ProximityGap.prizeThreshold]

/-- Exact native benchmark type, with one mathematical count and the explicit integer budget. -/
theorem protocolClaim6916_of_actualCap (B : ℕ) (hcap : ActualMCACap6916 B)
    (hbudget : (B + Astra7A.weightedListCap) * 2 ^ 128 ≤ (2130706433 : ℕ) ^ 6) :
