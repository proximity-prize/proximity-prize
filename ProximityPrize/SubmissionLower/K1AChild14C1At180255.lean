  · apply Polynomial.ringHom_ext
    · exact hbase
    · exact hy
  · exact hv

theorem forward_as_substitute {F : Type} [Field F] (H : F[X]) (lift : (SeedFrac F)[X]) :
    let h := H.map (algebraMap F (SeedFrac F))
