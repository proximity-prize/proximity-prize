    intro i
    apply Polynomial.ext
    intro a
    simp only [jetMap, coe_mapRingHom, Polynomial.coeff_map, seedAt, inc, RingHom.comp_apply]
  have hq : jetMap inc q = ∑ k, v k • jetMap (seedAt point) (Q k) := by
