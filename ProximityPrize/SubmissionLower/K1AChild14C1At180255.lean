      have hz : readRow (Q k) G r = 0 := by
        by_contra hn
        exact hr (Finset.mem_biUnion.mpr ⟨k, Finset.mem_univ k, mem_rowsOfColumn _ _ _ hn⟩)
      rw [hz, map_zero, mul_zero]
