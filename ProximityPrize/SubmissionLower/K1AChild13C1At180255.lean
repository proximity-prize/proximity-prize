theorem eligible_official {u : JetVariable 3 →₀ ℕ} (h : AnchorEligible u) :
    K1_13_1.AnchorEligible u :=
  ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.trans (by decide)⟩

private theorem official_eligible_finite : {u | K1_13_1.AnchorEligible u}.Finite := by
  refine (Finsupp.finite_of_nat_weight_le (differentialWeight (d := 3) 133671)
    ?_ (90 * 180265 - 1)).subset (fun e he => he.2.2.2.2)
  intro v
  cases v with
  | none => decide
  | some j =>
    exact (differentialWeight_some_pos_of_order_lt_degree (by decide : 3 < 133671) j).ne'

instance officialAnchorFinite : Module.Finite Geom K1_13_1.anchorSpace :=
  MvPolynomial.restrictSupport_finite official_eligible_finite

theorem anchorSpace_le : anchorSpace ≤ K1_13_1.anchorSpace :=
  fun p hp e he => eligible_official (hp he)

/-- The official per-node rank bound holds on the A' sub-bank. -/
theorem c1_of_official (h : K1_13_1.c1) : c1 := by
  intro x y
  refine le_trans (Submodule.finrank_mono ?_) (h x y)
  rintro _ ⟨q, rfl⟩
  exact ⟨⟨q.1, anchorSpace_le q.2⟩, rfl⟩

