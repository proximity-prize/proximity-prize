private def register (b : Band) (g : FeeGrade) (mode : Bool) (i : ℕ) : Mass :=
  (registerTable b g mode)[i]?.getD (fun _ => 0)

private def charge (b : Band) (g : FeeGrade) (mode : Bool) (i : ℕ) : ℚ :=
  (chargeTable b g mode)[i]?.getD 0

private theorem register_step (b : Band) (g : FeeGrade) (mode : Bool) :
    ∀ i : Fin (billCount b mode), ∀ k : Fin 4,
      max (register b g mode i k) (tariffWeights b g mode i k)=register b g mode (i+1) k:=by
  cases b <;> cases g <;> cases mode <;> intro i k <;> fin_cases i <;> fin_cases k <;> decide +kernel

private theorem register_eq (b : Band) (g : FeeGrade) (mode : Bool) (i : ℕ) (hi : i ≤ billCount b mode) :
    running (tariffWeights b g mode) i=register b g mode i:=by
  induction i with
  | zero => funext k; cases b <;> cases g <;> cases mode <;> fin_cases k <;> decide +kernel
  | succ i ih =>
    funext k
    rw [running,ih (by omega:i≤billCount b mode)]
    exact register_step b g mode ⟨i,by omega⟩ k

private theorem charge_eq (b : Band) (g : FeeGrade) (mode : Bool) :
    ∀ i : Fin (billCount b mode),
      dotQ (fun k => register b g mode (i+1) k - register b g mode i k) (billHistory b mode i) =
        charge b g mode i:=by
  cases b <;> cases g <;> cases mode <;> intro i <;> fin_cases i <;> decide +kernel

private theorem bill_exact (b : Band) (g : FeeGrade) (mode : Bool) :
    weightedBill (billCount b mode) (tariffWeights b g mode) (billHistory b mode)=credit b g mode:=by
  unfold weightedBill
  trans (∑ i ∈ range (billCount b mode),charge b g mode i)
  · apply sum_congr rfl
    intro i hi
    have h:i < billCount b mode:=mem_range.mp hi
    simp only [register_eq b g mode i (by omega : i ≤ billCount b mode),
      register_eq b g mode (i+1) (by omega:i+1≤billCount b mode)]
    exact charge_eq b g mode ⟨i,h⟩
  · cases b <;> cases g <;> cases mode <;> decide +kernel



private theorem graded_one (b : Band) (e : ℕ) (g : FeeGrade) (hg : g = feeTag e) :
    ∃ a h : ℕ → ℚ,
      (∀ i ≤ laterCount b, RateOK (finish b) (a i) (h i) ∧
        min (adjustedSeed b e) (adjustedLocal b e i)≤a i) ∧
      weightedBill (lossCount b) (lossWeights b a h) (lossHistory b) +
        adjustedSeed b e+lossOffset b - mixedCredit b a h*chargeDegree e≤gradedLoss b e:=by
  have seed : seedLimit b = credit b g false :=
    (seed_bill_eq b (tariffWeights b g false)).trans (bill_exact b g false)
  have seedReg : seedCredit b = register b g false (billCount b false) 0 := by
    unfold seedCredit
    exact congrFun (register_eq b g false (billCount b false) le_rfl) 0
  have mixReg : mixedCredit b (rate0 b g) (rate1 b g) = register b g true (billCount b true) 0 := by
    unfold mixedCredit
    exact congrFun (register_eq b g true (billCount b true) le_rfl) 0
  have hb:start b < 7773:=by cases b <;> decide
  refine ⟨rate0 b g,rate1 b g, ?_, ?_⟩
  · intro i hi
    refine ⟨rate_valid b g hb ⟨i,by omega⟩, ?_⟩
    unfold adjustedSeed adjustedLocal
    rw [seed,seedReg,history_eq b i hi]
    have H : ∀ i : Fin (laterCount b+1),
        min (credit b g false - register b g false (billCount b false) 0 * chargeDegree e)
          (dotQ (cutWeight b 0 i) (receipt b i) - cutWeight b 0 i 0*chargeDegree e)
          ≤ rate0 b g i:=by
      cases b
      all_goals
        by_cases h16:e=16
        · subst e; subst g; decide +kernel
        · by_cases h17 : e = 17
          · subst e; subst g; decide +kernel
          · subst g
            simp only [feeTag,chargeDegree,h16,h17,false_or,ite_false,Nat.cast_zero,mul_zero,sub_zero]
            decide +kernel
    exact H ⟨i,by omega⟩
  · have heq : weightedBill (lossCount b) (lossWeights b (rate0 b g) (rate1 b g)) (lossHistory b) =
        weightedBill (lossCount b) (lossWeights b (rate0 b g) (rate1 b g)) (billHistory b true):=by
      unfold weightedBill
      exact sum_congr rfl fun i hi => by rw [billHistory_eq b i (mem_range.mp hi)]
    have cost:=heq.trans (bill_exact b g true)
    unfold adjustedSeed
    rw [cost,seed,seedReg,mixReg]
    cases b
    all_goals
      by_cases h16:e=16
      · subst e; subst g; decide +kernel
      · by_cases h17 : e = 17
        · subst e; subst g; decide +kernel
        · subst g
          simp only [feeTag,chargeDegree,gradedLoss,h16,h17,false_or,ite_false,Nat.cast_zero,mul_zero,sub_zero]
          decide +kernel

theorem graded_ledger (b : Band) : GradedLedger b := by
  refine ⟨?_,?_,fun e => graded_one b e (feeTag e) rfl,?_⟩
  · intro e
    have H : seedLimit b < (p : ℚ) := by
      have seed : seedLimit b = credit b .base false :=
        (seed_bill_eq b (tariffWeights b .base false)).trans (bill_exact b .base false)
      rw [seed]
      cases b <;> decide +kernel
    have hn:=P1_7_4.running_nonneg (cutWeight b 0) (laterCount b+1) 0
    exact (sub_le_self _ (mul_nonneg hn (Nat.cast_nonneg _))).trans_lt H
  · cases b <;> decide +kernel
  · intro hj
    cases b <;> decide +kernel

#print axioms schedule
