theorem zr22p64:∀ i ∈ List.range 1,ZeroCheckAt 22 (64+i):=by
  intro i hi
  have hi0:i = 0:=by have:=List.mem_range.mp hi; omega
  subst i
  simp only [Nat.add_zero]
  have hfast:ZeroAtFast 22 64:=by decide +kernel
  exact zeroAtFast_sound 22 64 hfast

