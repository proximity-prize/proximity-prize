def cutoff (m k n0 h : ℕ) : ℕ := m*181343-SecondJetRelaxedDifferentiation.reserve k n0 h*50274

def Interpolant (m B s U L k n0 : ℕ) (nodes : N ↪ K) (u0 u1 : N → K)
