    intro e he
    have h := hP.2.1 e he
    exact ⟨h.1,h.2.2.1,h.2.2.2.1⟩
  have hS : ∀ e ∈ P.support, e 1 ≤ s := fun e he => (hP.2.1 e he).2.1
  have hdegree : (asS P).natDegree ≤ s := by
    simpa using asS_derivative_degree P s 0 hS
