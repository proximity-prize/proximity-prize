private theorem joinRemainder (lo a b mid len x y z : ℕ)
    (hm : lo+a=mid) (hl : a+b=len) (hz : x+y=z)
    (hx : remainderChunk lo a ≤ x) (hy : remainderChunk mid b ≤ y) :
    remainderChunk lo len ≤ z := by
  rw [← hl,remainderChunk_add,hm,← hz]
  exact Nat.add_le_add hx hy

private theorem remainderChunk_zero_lo (n : ℕ) :
    remainderChunk 0 n = TaperBudget.sumRange remainderRow n := by
  unfold remainderChunk
  have h : (fun q => remainderRow (0+q)) = remainderRow := by
    funext q
    rw [Nat.zero_add]
  rw [h]

