abbrev Chart (A:Fin 4→Finset Exponent) := ∀ i,↥(A i)
def a2m {A:Fin 4→Finset Exponent} (a :Chart A) (m:ℕ) :af A :=
 MvPolynomial.monomial (m • ∑ i,(a i).val) 1
def byY (A:Fin 4→Finset Exponent) :Prop :=
  ∀ (i:Fin 4) (d:Degree) (p:af A),
    p∈dO A (shift d i 1)→p∈mo A (i.val+1) →
    ∀ a :Chart A,∃ (m:ℕ) (r :af A),
      r∈dO A (d+fun _=>m) ∧
        a2m a m*p - ve A i*r∈mo A i.val
