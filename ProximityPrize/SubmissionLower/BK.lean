namespace UH
noncomputable section
open aR MvPolynomial
abbrev Exponent:=Fin 4 →₀ ℕ
abbrev gQ (k :Type) [Field k] :=MvPolynomial (Fin 4) k
def lattice (p:Shape) :Set Exponent :=
  {e | e 0+e 1+e 2+e 3≤p.b ∧
    e 1+2*e 2 + 3*e 3≤p.j∧e 3≤p.t}
theorem afS (p:Shape) : (lattice p).Finite :=
 (Finsupp.finite_of_degree_le p.b).subset fun e he=> by
   simpa only [Set.mem_ofPred_eq,Finsupp.degree_eq_sum,Fin.sum_univ_four]
    using (show e 0+e 1+e 2+e 3≤p.b from he.1)
abbrev Su {k :Type} [Field k] (f :Fin 4→ gQ k) :Ideal (gQ k) :=
 Ideal.span (Set.range f)
abbrev Rh {k :Type} [Field k] (f :Fin 4→ gQ k) :=
 gQ k ⧸ Su f
abbrev xB (k :Type) [Field k] (P:Fin 4→Shape) :=
 MvPolynomial (Σ i:Fin 4,lattice (P i)) k
abbrev fZ (k :Type) [Field k] (P:Fin 4→Shape) :=
 FractionRing (xB k P)
def ve (k :Type) [Field k] (P:Fin 4→Shape) (i:Fin 4) :
    gQ (fZ k P) := by
  classical
  letI:=(afS (P i)).fintype
  exact ∑ e :lattice (P i),monomial e.val
    (algebraMap (xB k P) (fZ k P) (MvPolynomial.X ⟨i,e⟩))
abbrev ap1 (k :Type) [Field k] (P:Fin 4→Shape) :=
 Rh (ve k P)
def aAk (f :Shape→ℝ) (p R:Shape) :ℝ :=
 f (R.plus p) - f R
def cSW (f :Shape→ℝ) (P:Fin 4→Shape) :Shape→ℝ :=
  aAk (aAk (aAk (aAk f (P 0)) (P 1))
    (P 2)) (P 3)
end
end UH
end
