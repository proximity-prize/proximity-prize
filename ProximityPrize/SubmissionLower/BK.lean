namespace aFM
open xE GI
open scoped BigOperators
private theorem XK (q:ℤ) :2*(q*(q - 1)/2)=q*(q - 1) := by
 have h: (2 :ℤ)∣q*(q - 1) := by
  rcases Int.emod_two_eq_zero_or_one q with h | h
  · exact dvd_mul_of_dvd_left (by omega : (2 :ℤ)∣q) _
  · exact dvd_mul_of_dvd_right (by omega : (2 :ℤ)∣q - 1) _
 rw [mul_comm,Int.ediv_mul_cancel h]
private theorem arn (u:ℤ) :xY u=denominator u:= by
 by_cases hu:u<0
 · simp [xY,denominator,hu]
 simp only [xY,denominator,hu,ite_false]
 let q:=u/6
 let r :=u % 6
 let p:=u*(u*(2*u+21)+66)
 let v :=1+r*(r+1)/2+q*(22+7*r+r*(r - 1)/2) +
   (57+6*r)*(q*(q - 1)/2)+6*q*(q - 1)*(q - 2)
 change p/72+1=v
 suffices p+47≤72*v∧72*v≤p+72 by omega
 have he :u=6*q+r := by dsimp [q,r]; omega
 have hr :r=0∨r=1∨r=2∨r=3∨r=4∨r=5:= by
   dsimp [r]
   omega
 have hq:=XK q
 unfold p v
 rw [he]
 rcases hr with h | h | h | h | h | h <;> rw [h] <;> norm_num <;>
   constructor <;> nlinarith only [hq]
private theorem aHy {u:ℤ} (h:u<0) :denominator u=0:= by
 simp only [denominator,ite_eq_left h]
private theorem bGw (d u:ℤ) :aUK d u=gd d u:= by
  by_cases hd:d<0
  · simp [aUK,gd,hd]
  by_cases hu:u<0
  · simp [aUK,gd,hu]
  simp only [aUK,gd,arn,hd,hu,decide_false,Bool.false_or,Bool.false_eq_true,
    ite_false]
  let v :=min u (3*d)
  have hv :v≤3*d:=min_le_right _ _
  rw [aHy (show v-3*d-6<0 by omega),sub_zero]
  by_cases h₁:v≤d
  · rw [ite_eq_left h₁,aHy (show v - d - 1<0 by omega),
      aHy (show v - d - 2<0 by omega),aHy (show v - d-3<0 by omega),
      aHy (show v - 2*d-3<0 by omega),aHy (show v - 2*d-4<0 by omega),
      aHy (show v - 2*d - 5<0 by omega)]
    simp only [sub_zero,add_zero]
  · rw [ite_eq_right h₁]
    by_cases h₂:v≤2*d+2
    · rw [ite_eq_left h₂,aHy (show v - 2*d-3<0 by omega),
        aHy (show v - 2*d-4<0 by omega),aHy (show v - 2*d - 5<0 by omega)]
      simp only [add_zero]
    · rw [ite_eq_right h₂]
end aFM
