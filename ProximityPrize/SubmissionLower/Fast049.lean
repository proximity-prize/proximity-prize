def ConstantSeed (Q : Ideal Ambient) : Prop :=
  ∀ i : Fin 2, IsAlgebraic FX
    (Ideal.Quotient.mk Q (MvPolynomial.X (Fin.castLE (by decide : 2 ≤ 4) i)))
