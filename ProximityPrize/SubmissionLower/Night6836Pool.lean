def chosen (i:ℕ) : Certified := checked.getD i ⟨w0,window0,by decide⟩
private theorem projectedList :
    checked.toList.map (fun c => project c.w) = Koala6836.Offers.catalogue.toList := by rfl
private theorem checked_size : checked.size=603 := by rfl
private theorem catalogue_size : Koala6836.Offers.catalogue.size=603 := by rfl
theorem project_bank (i r e t:ℕ) (hr:0<r) (h:valid (bank i) r e t t) :
    project (chosen i).w = bank i := by
  have hi := bank_index i r e t hr h
  have hc : i < checked.size := by rw [checked_size]; exact hi
  have hb : i < Koala6836.Offers.catalogue.size := by rw [catalogue_size]; exact hi
  have hlookup := congrArg (fun xs : List Offer => xs[i]?) projectedList
  simp only [List.getElem?_map, Array.getElem?_toList, Array.getElem?_eq_getElem hc,
    Array.getElem?_eq_getElem hb, Option.map_some, Option.some.injEq] at hlookup
  simpa only [chosen, bank, Array.getD_eq_getD_getElem?, Array.getElem?_eq_getElem hc,
    Array.getElem?_eq_getElem hb, Option.getD_some] using hlookup
#print axioms project_bank
