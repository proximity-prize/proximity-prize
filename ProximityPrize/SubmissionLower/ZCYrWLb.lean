theorem early_grade (q s base cols rows budget:ℕ) (hq:q≤50)
    (hb:bve q 56=base) (hc:bC5 q (99 - q)=cols)
    (hr :bvj q q (99 - q)=rows) (hbudget:Ni q=budget)
    (hcost:cols+rows+s≤budget+base) (hs :KC q (99 - q) s) :
    Oi q≤Ni q:= by
  let u:=99 - q
  let P9 (r :ℕ) :=(Gy q (offset r)).rank
  let cap (i:ℕ) :=bve q (155-(q+(i+u)))
  have hd:iO q=q:= by
    rw [iO,P6_6_1.asu,ite_eq_left (by omega :q≤111),min_eq_left (by omega)]
  have hsplit :u+(155 - u)=155:= by dsimp [u]; omega
  have hu:1+(154 - u)=155 - u:= by dsimp [u]; omega
  have hcap:cap 0=base := by
    dsimp [cap,u]
    rw [show 155-(q+(0+(99 - q)))=56 by omega]
    exact hb
  have hblock (i:ℕ) :P9 (i+u)≤ cap i:= by
    simpa only [P9,cap,aq6,DV,hd] using fTk q (offset (i+u))
  have htail: (qI (155 - u) fun i=>P9 (i+u))+base ≤
      bvj q q u+s := by
    rw [← fZi,← hu,aAr,aAr]
    have hyes :=sum_mono (154 - u) (fun i=>hblock (i+1))
    change P9 u≤ s at hs
    simp only [aAs,Finset.sum_range_one,Nat.zero_add,cap] at hcap hyes ⊢
    omega
  have hprefix : (qI u P9)≤ cols := by
    calc
      _≤qI u (fun r=>a2M q (56 - r)) :=sum_mono _ fun r=> by
        simpa only [P9,hd] using fTf q r
      _ = _:=(dNI _ _).trans hc
  have hgrade :Oi q =
      qI u P9+(qI (155 - u) fun i=>P9 (i+u)) := by
    rw [← aAr,hsplit,Qg]
    rfl
  rw [hgrade,hbudget]
  change bvj q q u=rows at hr
  omega
end qaTCFjd
