private theorem bucket_size (g:Fin h53.length) :
    gd g (runLen g)=h53[g.val] := by
  have h:=(checked g.val g.isLt).2.1
  rwa [getElem!_pos h53 g.val g.isLt] at h
private theorem cumulative_le (g:Fin h53.length) (k :ℕ) :
    gd g k≤h53[g.val] := by
  rw [← bucket_size g]
  by_cases h:k≤ runLen g
