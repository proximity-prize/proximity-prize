  intro W hW
  have hWt := mem_range.mp hW
  by_cases h : t ≤ W + j
  · simp only [h, true_and, Nat.add_zero, hWt, ite_true]
    have hsum := sum_slot_drops A hmono n (L W)
    rw [hmin, add_comm] at hsum
    rw [← hsum]
