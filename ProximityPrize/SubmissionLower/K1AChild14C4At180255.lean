/-- Sum the rank bounds of the V-graded pieces at one cutoff. -/
theorem cutoff_finrank_le (w : ℤ) (W : ℕ) (V : Submodule FX Jet)
    {f : Equation} (hf : f ≠ 0) (hv : (K1_14_At.bandNew w).seedBound + 1 ≤ seedDegree f)
    (hk : 0 < 131071 - w.toNat)
    (hV : ∀ P ∈ V, P ≠ 0 →
      P.natDegree ≤ (K1_14_At.bandNew w).vBound ∧
      P.leadingCoeff.natDegree + P.natDegree ≤ (K1_14_At.bandNew w).jetBound ∧
