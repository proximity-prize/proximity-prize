private def entry (r e : Nat) : Entry := (entries r)[e]?.getD default
def maxTotal (r e : Nat) : Nat := (entry r e).top
def lowBudget (r e : Nat) : Nat := (entry r e).low
def highBudget (r e : Nat) : Nat := (entry r e).high
def split (r e : Nat) : Nat := r+e+(maxTotal r e+1-(r+e))/2
def budget (r e t : Nat) : Nat :=
  if t < split r e then lowBudget r e else highBudget r e
