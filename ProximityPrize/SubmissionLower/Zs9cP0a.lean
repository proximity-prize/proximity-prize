def groupCount (g i:ℕ) :ℕ :=
  let z :=counts g
  let lo:=z % 64
  if i<lo then 0 else (z >>> (6*(i-lo+1))) % 64
def JL (g:ℕ) :ℕ :=
  fP.qI 57 (groupCount g)
def ZX (g i j:ℕ) :ℕ×ℕ×ℕ :=
  let z :=(coords g)[i - counts g % 64]?.getD 0 >>> (10*j)
  let a :=z % 32
  let f :=z/32 % 32
  let c:=g+i-(56+3*a+2*f)
  (56-(a+c+f),c,f)
