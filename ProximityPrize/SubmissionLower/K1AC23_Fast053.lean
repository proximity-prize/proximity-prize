    rw [hcomap, cutIdeal, Ideal.map_sup, Ideal.map_span, Set.image_singleton, ← hcomap]
  have hB : B ∈ (A ⊔ Ideal.span {e.symm P}).minimalPrimes := by
    rw [← hEq]
