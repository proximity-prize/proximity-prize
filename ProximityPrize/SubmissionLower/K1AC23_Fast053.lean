  have hP' : e.symm P ∉ A := by
    intro h
    change e (e.symm P) ∈ q.asIdeal at h
    rw [e.apply_symm_apply] at h
    exact hP h
  have hcomap (I : Ideal Jet) : I.comap e = I.map e.symm := by
    simpa only [RingEquiv.symm_symm] using Ideal.comap_symm (I := I) e.symm
