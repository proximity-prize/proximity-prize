/-- Every minimal prime of a proper cut of a height-two parent is a curve. -/
theorem cutCurve {q : Surface} {P : Jet} (hq : q.asIdeal.height = 2) (hP : P ∉ q.asIdeal)
    {R : Ideal Jet} (hR : R ∈ (cutIdeal q P).minimalPrimes) : IsCutCurve R := by
