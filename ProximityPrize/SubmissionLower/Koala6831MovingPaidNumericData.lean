def cutoffs (r y : ℕ) : ℕ × ℕ := (cutoffRow r)[y - 1]!

def cellChecks (r y : ℕ) (hpos : 0 < r) : Prop :=
  let ts := cutoffs r y
  y ≤ ts.1 + 1 ∧ y ≤ ts.2 + 1 ∧ ts.1 ≤ 15351 ∧ ts.2 ≤ ts.1 ∧
  (ts.1 = 15351 ∨ evalGate Stage.adaptive1 (flagAt r y (ts.1 + 1)) = true) ∧
  (ts.2 = ts.1 ∨ evalGate Stage.adaptive2 (flagAt r y (ts.2 + 1)) = true) ∧
  (y ≤ ts.1 →
    stagePrice (flagAt r y ts.1) hpos Stage.adaptive2 Stage.adaptive2.numbers.slopeCap ≤ adaptivePrice₂ ∨
      evalGate Stage.adaptive2 (flagAt r y ts.1) = false) ∧
  (y ≤ ts.2 →
    stagePrice (flagAt r y ts.2) hpos Stage.adaptive3 Stage.adaptive3.numbers.slopeCap ≤ adaptivePrice₃ ∨
      evalGate Stage.adaptive3 (flagAt r y ts.2) = false)

instance paidDecidableCellChecks (r y : ℕ) (hpos : 0 < r) :
    Decidable (cellChecks r y hpos) := by
  unfold cellChecks
  infer_instance

def checkAt (r y : ℕ) (hpos : 0 < r) : Bool :=
  if r ≤ y then decide (cellChecks r y hpos) else true

private def checkedSlope (r : ℕ) : Bool :=
  (List.range 138).all (fun i => checkAt (r + 1) (i + 1) (Nat.succ_pos r))

