def adaptivePrice₁ : ℕ := 2243281056745829
def adaptivePrice₂ : ℕ := 824314952017431
def adaptivePrice₃ : ℕ := 2334906151847889

def flagAt (r y t : ℕ) : FlagDegree := flagFromCaps t y r

def evalGate (s : Stage) (f : FlagDegree) : Bool :=
  decide (evalPowerBandBudget weightGain (total f) (middle f) f.all
    (s.numbers.totalCap - total f) (s.numbers.middleCap - middle f)
    (s.numbers.slopeCap - f.all) (s.numbers.fuel f) < s.numbers.gap)

theorem evalGate_true (s : Stage) (f : FlagDegree) :
    evalGate s f = true ↔ adaptiveGate s.numbers f := by
  simp only [evalGate, decide_eq_true_eq, evalPowerBandBudget_eq, adaptiveGate, adaptiveBand]

