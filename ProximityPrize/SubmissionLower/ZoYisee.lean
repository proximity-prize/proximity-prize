    rfl
  have h₁:qE (lift f)=qE f := by
    simp only [Ex.C6,lift,
      weightedTotalDegree_rename_of_injective (zX8 3)]
    rfl
  have h₂: (lift f).degreeOf 2=f.degreeOf 2 :=
    degreeOf_rename_of_injective (zX8 3) 2
  have h₃: (aR.shape (lift f)).t=0:= by
    rw [← Ex.aQU]
    have he :Ex.YN (lift f)=z1z f := by
      have he' : Ex.YN.toRingHom.comp lift.toRingHom=Polynomial.C:= by
        apply MvPolynomial.ringHom_ext
        · intro x
          simp [lift,Ex.YN,optionEquivLeft_C]
        · intro i
          simp [lift,Ex.YN,optionEquivLeft_X_some,finSuccEquivLast_castSucc]
      exact RingHom.congr_fun he' f
    simp [he]
  change (_∧qE (lift f)≤_∧(aR.shape (lift f)).t≤_)∧_↔_
  rw [h₀,h₁,h₂,h₃]
  simp [and_assoc]
def den (m:ℕ) (f :af 3) :af 3:=separant f^(2*m - 7)
def num (m:ℕ) (f :af 3) (i:ℕ) :af 3 :=
  if hi:i<3 then z9v ⟨i,hi⟩*den m f
  else
    C (z1z ((2 :ao)/(i.factorial:ao))) *
      (separant f^(2*m - 7-(2*(i-3)+1))*AR f (i-3))
def VA (m:ℕ) (f :af 3) (x y :ao) :af 3 :=
  (∑ i:Fin m,C ((z1z x-Polynomial.X)^i.val)*num m f i.val) -
    C (z1z y)*den m f
end
end qdWgQqc
