def fullCheck (r v:ℕ) (curve:List DZ.Piece):Bool:=allN (fun j=>
  affineCheck (full_slope j) (lookup (full_own j) r v) curve) 8
def lightCheck (r v:ℕ) (curve:List DZ.Piece):Bool:=allN (fun j=>
  affineCheck (light_slope j) (lookup (light_own j) r v) curve) 14
def localCheck (r v:ℕ) (curve:List DZ.Piece):Bool:=fullCheck r v curve &&
  (if r<10∧v≤70 then lightCheck r v curve else true)
def rowCheck (r v:ℕ):Bool:=localCheck r v (AF.curve r v)

theorem curve_valid (r v:ℕ) (hr:1≤r) (hR:r≤28) (hy:r+v≤117):
    DZ.validFrom (11193-r-v) 0 (AF.curve r v)=true:=by
  have h:=check_curve r v _ (AF.checked r v hr hR hy)
  simp only [WT.check,Bool.and_eq_true] at h
  exact h.1.1

theorem full_sound (r v z:ℕ) (hr:1≤r) (hR:r≤28) (hy:r+v≤117) (hz:r+v+z≤11192)
    (h:rowCheck r v=true) (j:ℕ) (hj:j<8):
    AF.cap r v z≤full_slope j*z+lookup (full_own j) r v:=by
  simp only [rowCheck,localCheck,Bool.and_eq_true] at h
  exact ETD _ _ (11193-r-v) _ (curve_valid r v hr hR hy)
    (allN_sound _ 8 h.1 j hj) z (by omega)

theorem light_sound (r v z:ℕ) (hr:1≤r) (hR:r<10) (hv:v≤70) (hz:r+v+z≤11192)
    (h:rowCheck r v=true) (j:ℕ) (hj:j<14):
    AF.cap r v z≤light_slope j*z+lookup (light_own j) r v:=by
  simp only [rowCheck,localCheck,Bool.and_eq_true,if_pos (show r<10∧v≤70 from ⟨hR,hv⟩)] at h
  exact ETD _ _ (11193-r-v) _ (curve_valid r v hr (by omega) (by omega))
    (allN_sound _ 14 h.2 j hj) z (by omega)

end ACV
