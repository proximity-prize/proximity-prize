theorem weighted_box {L:ℕ} {p:Shape} (hL:4≤L) :
    ChamberBox (P6_6.weightedChart L p) :=chartChamber hL
variable {R G:af 4} {ell:ℕ}
private theorem representative_minimal (b:Branch R G ell) {p:Shape} (a :Member4 b.g p) :
    (b.aI ⊔ Ideal.span {a.polynomial}).IsMinimalPrime b.curve := by
  obtain ⟨n,hn⟩:=a.aEA
  have hp:=b.member.minimal.isPrime
  have hraw:bC (memberTest b.g)∈b.curve :=
    b.member.minimal.le (Submodule.mem_sup_right (Ideal.mem_span_singleton_self _))
  have hm:a.polynomial∈b.curve := by
    rw [hn] at hraw
    exact (hp.mem_or_mem hraw).resolve_left (fun h=>b.regular (hp.mem_of_pow_mem n h))
  refine ⟨⟨hp,sup_le (le_sup_left.trans b.member.minimal.le)
    ((Ideal.span_singleton_le_iff_mem _).mpr hm)⟩,?_⟩
  intro Q hQ hle
  have hr :bC (memberTest b.g)∈Q:= by
    rw [hn]
    exact Q.mul_mem_left _ (hQ.2 (Submodule.mem_sup_right (Ideal.mem_span_singleton_self _)))
  exact b.member.minimal.2 ⟨hQ.1,sup_le (le_sup_left.trans hQ.2)
    ((Ideal.span_singleton_le_iff_mem _).mpr hr)⟩ hle
private theorem representative_length (b:Branch R G ell) {p:Shape} (a :Member4 b.g p) :
    oA (AX b.aI (memberTest b.g)) b.curve b.member.minimal.isPrime =
