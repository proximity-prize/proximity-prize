open private thinRaw raw_weight thin_fits from ProximityPrize.SubmissionLower.ZLECmAc
open private thin raw_shift from ProximityPrize.SubmissionLower.ZnczBaa
open private c7g from ProximityPrize.SubmissionLower.L
private theorem thin_eq (g:af 4) (n:ℕ) :thinRaw g n=thin g n:= by
  induction n with
  | zero =>
    simp only [thinRaw,thin,show (3:ℕ).factorial=6 by decide]
    apply congrArg (fun A:af 4=>A*MvPolynomial.X 3)
    simpa only [RingHom.comp_apply,Nat.cast_ofNat] using
      (map_natCast ((MvPolynomial.C:ao[X] →+* af 4).comp Polynomial.C) 6)
  | succ n ih=>simp only [thinRaw,thin,ih]
private theorem test_fit {g:af 4} {p:Shape} (hg:aO (shape g) p)
    (hp:bF p) (ht:p.t=1) {n:ℕ} (hn:3≤n) :
    VE (weightedChart (n+1) p) (bC (thinRaw g (n-3))) := by
  apply a6c
  apply thin_fits (by omega) hg hp ht
  intro w δ B hshift _ hB hwg
  rw [show n+1-4=n-3 by omega]
  exact raw_weight w δ hshift hB hwg _
private theorem test_represents {g:af 4} (hg: (shape g).t=1) {n:ℕ} (hn:3≤n) :
    Represents g (bC (su g n)) (bC (thinRaw g (n-3))) := by
  have hlin:=exb hg
  have hraw:=raw_shift g hlin (n-3)
  rw [Nat.sub_add_cancel hn,← thin_eq] at hraw
  refine ⟨n+3,?_⟩
  have he :su g n=separant g^(n+3)*thinRaw g (n-3) := by
    rw [c7g g hlin,hraw,← mul_assoc,← pow_add]
  simpa only [sigma,bC,map_mul,map_pow] using congrArg bC he
theorem proof :qCj6p1d.c2 := by
  intro g p hp hg hpos ht
  have hgt: (shape g).t=1 := by have h:=hg.2.2; omega
  have hn:3≤bf := by decide
  have hn' : 3≤bf+1 :=hn.trans (Nat.le_succ _)
  have hchar :bf+2≤K1.p:= by decide
  have hlen:4≤bf+2 := by decide
  refine ⟨{
    polynomial:=bC (thinRaw g (bf-3))
    fits :=test_fit hg hp ht hn
    aEA:=test_represents hgt hn
    next:=bC (thinRaw g (bf+1 - 3))
    next_fits :=test_fit hg hp ht hn'
    next_represents :=test_represents hgt hn'
    values := ?_ }⟩
  intro x a
  obtain ⟨D,hD,hvalue⟩:=qbRvrcc.d40 hlen hchar hg hp (ht.symm ▸ Nat.zero_lt_one) x a
  refine ⟨D,a6c hD,?_⟩
  intro S hd hr
  exact hvalue S (hd.trans_lt (by decide)) hr.1 (fun hz=>hr.2 (by
    change dN.An (extend S) (bC (separant g))=0
    rw [afz,show cK (separant g) (extend S)=0 from hz,map_zero]))
end
end qyN3hZb
