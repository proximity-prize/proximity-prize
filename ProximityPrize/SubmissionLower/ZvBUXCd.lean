  have hmin:=representative_minimal b a
  have hpos :0<AN J b.curve :=aFq hmin
  change b.demandWeight≤AN J b.curve
  unfold Branch.demandWeight
  split_ifs with h
  · omega
  · have hne :AN J b.curve≠1 := by
      intro he
      apply h
      change oA (AX b.aI (memberTest b.g)) b.curve
        b.member.minimal.isPrime=1
      rw [representative_length b a,← a9B hmin,he]
      rfl
    omega
private theorem gr5 (C:Context) {p:Shape} (b:Branch R G ell)
    (hd:dimension b.curve=1) (hs :ChamberBox (sliceBox p))
    (T:Finset P6.K) (hT:T⊆C.Δ)
    (hon : ∀ γ∈T,b.dY (extend (C.s γ))) (hS:aSG p b C.s T) :
    (T.card:ℚ)≤tW b.curve [sliceBox p] := by
  classical
  rcases hS with hone | ⟨D,hD,hp,hz⟩
  · by_cases he :T = ∅
    · simpa [he] using degree_nonneg hd hs
    · obtain ⟨γ,hγ⟩:=nonempty_iff_ne_empty.mpr he
      have hsingle :T = {γ} := by
        symm
        exact eq_of_subset_of_card_le (singleton_subset_iff.mpr hγ) (by simpa using hone)
      obtain ⟨D,hD,hproper,hz⟩:=cb6 hd hs
        (JV (extend (C.s γ))) (hon γ hγ).1
      exact section_card b.member.minimal.isPrime hd hs (C.messages.mono hT) hD hproper (by
        intro δ hδ
        have hδγ:δ=γ:= by simpa [hsingle] using hδ
        exact ⟨(hon δ hδ).1,hδγ.symm ▸ hz⟩)
  · exact section_card b.member.minimal.isPrime hd hs (C.messages.mono hT) hD hp
      (fun γ hγ=>⟨(hon γ hγ).1,hz γ hγ⟩)
private theorem polynomial_transport {g g' : af 4} {p:Shape} (hg:g=g') (a :Member4 g p) :
    (hg ▸ a :Member4 g' p).polynomial=a.polynomial:= by
  cases hg
  rfl
theorem gxK (C:Context) {p:Shape} (ref :Branch R G ell)
    (hd:dimension ref.aI=2) (hm:ChamberBox (memberBox p))
    (hs :ChamberBox (sliceBox p)) (a :Member4 ref.g p)
    (F:Finset (Branch R G ell)) (T:Branch R G ell→Finset P6.K)
    (hF : ∀ b∈F,b.aI=ref.aI∧b.g=ref.g)
    (hT : ∀ b∈F,aSG p b C.s (T b)∧T b⊆C.Δ ∧
      ∀ γ∈T b,b.dY (extend (C.s γ))) :
    (∑ b∈F,((b.demandWeight*(T b).card:ℕ) :ℚ)) ≤
      tW ref.aI [memberBox p,sliceBox p] := by
  classical
  let:=ref.base.isPrime
  let J:=ref.aI ⊔ Ideal.span {a.polynomial}
  have hproper :a.polynomial∉ref.aI:= by
    obtain ⟨n,hn⟩:=a.aEA
    exact fun ha=>ref.member.proper (hn ▸ ref.aI.mul_mem_left (sigma ref.g^n) ha)
  have hreg:=aPQ ref.base.isPrime hproper
  have hJ:dimension J≤1 := by simpa only [J,hd] using aCR hreg
  have hmin (b) (hb:b∈F) :J.IsMinimalPrime b.curve := by
    obtain ⟨hZ,hg⟩:=hF b hb
    let m:Member4 b.g p:=hg.symm ▸ a
    simpa only [J,hZ,m,polynomial_transport] using representative_minimal b m
  have hweight (b) (hb:b∈F) :b.demandWeight≤AN J b.curve := by
    obtain ⟨hZ,hg⟩:=hF b hb
    let m:Member4 b.g p:=hg.symm ▸ a
    simpa only [J,hZ,m,polynomial_transport] using demand_le b m
  have hbch:lB.bF (sliceBox p) :=⟨hs.1,hs.2.1⟩
  calc
    _ ≤ ∑ b∈F,(AN J b.curve :ℚ)*tW b.curve [sliceBox p] := by
      refine sum_le_sum fun b hb => ?_
      have hd' := MvPolynomial.principalCut_natDegree_affineHilbertPolynomial_add_one hproper (hmin b hb)
      change dimension b.curve+1=dimension ref.aI at hd'
      have hcard:=gr5 C b (by omega) hs (T b) (hT b hb).2.1 (hT b hb).2.2 (hT b hb).1
      rw [Nat.cast_mul]
      exact (mul_le_mul_of_nonneg_right (by exact_mod_cast hweight b hb) (Nat.cast_nonneg _)).trans
        (mul_le_mul_of_nonneg_left hcard (Nat.cast_nonneg _))
    _ = ∑ P∈F.image Branch.curve,(AN J P:ℚ)*tW P [sliceBox p] :=
      (sum_image (f := fun P=>(AN J P:ℚ)*tW P [sliceBox p])
        (fun b hb c hc he=>Branch.b1G
          ((hF b hb).1.trans (hF c hc).1.symm) ((hF b hb).2.trans (hF c hc).2.symm) he)).symm
    _≤tW J [sliceBox p] :=qZqYIua.retain_cycle J [sliceBox p]
      (by simpa using hbch) (by simp) (by simpa using hJ) _ (by
        intro P hP
        obtain ⟨b,hb,rfl⟩:=mem_image.mp hP
        exact hmin b hb)
    _≤_:=bau.proof ref.aI (memberBox p) [sliceBox p] ⟨hm.1,hm.2.1⟩
      (by simpa using hbch) (by simp) (by simp [hd]) a.polynomial a.fits hreg
end
