/-- The coheight of the generic point of the surface is at most two. -/
private theorem surfaceDimension (q : Surface) (hh : q.asIdeal.height = 2) :
    ringKrullDim (SurfaceRing q) ≤ 2 := by
  let e := PrimeSpectrum.comap (Ideal.Quotient.mk q.asIdeal)
  have hm : Monotone e := fun _ _ h => Ideal.comap_mono h
  have he : StrictMono e := hm.strictMono_of_injective
    (PrimeSpectrum.comap_injective_of_surjective _ Ideal.Quotient.mk_surjective)
  have hb : e (⊥ : PrimeSpectrum (SurfaceRing q)) = q := by
    apply PrimeSpectrum.ext
    exact Ideal.mk_ker
  have hc := Order.coheight_le_coheight_apply_of_strictMono e he ⊥
  rw [hb] at hc
  have hdim : ringKrullDim Jet = 4 := by
    change ringKrullDim (Polynomial (Polynomial Seeds)) = _
    rw [Polynomial.ringKrullDim_of_isNoetherianRing,
      Polynomial.ringKrullDim_of_isNoetherianRing,
      MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field]
    norm_num [Nat.card_eq_fintype_card]
  have hsum : ((Order.height q + Order.coheight q : ℕ∞) : WithBot ℕ∞) ≤ ringKrullDim Jet := by
    simp only [ringKrullDim, Order.krullDim_eq_iSup_height_add_coheight_of_nonempty]
    exact WithBot.coe_le_coe.mpr (le_iSup (fun p : Surface => Order.height p + Order.coheight p) q)
  rw [hdim, ← q.height_eq_orderHeight, hh] at hsum
  have hle : Order.coheight q ≤ 2 :=
    (ENat.add_le_add_iff_left (by simp : (2 : ℕ∞) ≠ ⊤)).mp
      (show (2 : ℕ∞) + Order.coheight q ≤ 2 + 2 by
        exact WithBot.coe_le_coe.mp hsum)
  rw [ringKrullDim, ← Order.coheight_bot_eq_krullDim]
  exact WithBot.coe_le_coe.mpr (hc.trans hle)

/-- Bound the transcendence degree using normalization and going up. -/
private theorem affineTrdegLe (A : Type) [CommRing A] [IsDomain A] [Algebra FX A]
    [Algebra.FiniteType FX A] (hA : ringKrullDim A ≤ 4) :
    Algebra.trdeg FX A ≤ 4 := by
  obtain ⟨n, g, hg, hint⟩ := exists_integral_inj_algHom_of_fg FX A
  let P := MvPolynomial (Fin n) FX
  let : Algebra P A := g.toRingHom.toAlgebra
  have hmap : algebraMap P A = g.toRingHom := rfl
  let : Algebra.IsIntegral P A := ⟨hint⟩
  let : Algebra.IsAlgebraic P A := ⟨fun a => (show IsIntegral P a from hint a).isAlgebraic⟩
  let : FaithfulSMul P A := (faithfulSMul_iff_algebraMap_injective P A).mpr (hmap.symm ▸ hg)
  let : IsScalarTower FX P A := IsScalarTower.of_algebraMap_eq' (by
    rw [hmap]
    exact g.comp_algebraMap.symm)
  have hd : ringKrullDim P = n := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field]
    simp [Nat.card_eq_fintype_card]
  obtain ⟨l, hl⟩ := Order.le_krullDim_iff.mp (le_of_eq hd.symm)
  let p := l.head.asIdeal
  have : p.IsPrime := l.head.isPrime
  obtain ⟨Q, hQ, hQp⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain
    (S := A) p (by rw [(RingHom.injective_iff_ker_eq_bot _).mp (hmap.symm ▸ hg)]; exact bot_le)
  let : Q.IsPrime := hQ
  let : Q.LiesOver p := ⟨hQp.symm⟩
  obtain ⟨L, hL, _, _⟩ := Ideal.exists_ltSeries_of_hasGoingUp l Q
  have hn : n ≤ (4 : WithBot ℕ∞) :=
    (show (n : WithBot ℕ∞) ≤ ringKrullDim A from (hL.trans hl) ▸ (Order.LTSeries.length_le_krullDim L)).trans hA
  have hn' : n ≤ 4 := by exact_mod_cast hn
  rw [← trdeg_add_eq FX P (A := A), trdeg_eq_zero (R := P) (A := A), add_zero,
    MvPolynomial.trdeg_of_isDomain]
  simpa using (show (n : Cardinal.{0}) ≤ 4 by exact_mod_cast hn')

private theorem numeratorTrdeg (q : Surface) (hh : q.asIdeal.height = 2) :
    Algebra.trdeg FX (Numerators q) ≤ 4 := by
  apply affineTrdegLe
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite]
  have hcard : (Nat.card (Fin 2) : WithBot ℕ∞) = 2 := by simp [Nat.card_eq_fintype_card]
  rw [hcard]
  calc
    _ ≤ (2 : WithBot ℕ∞) + 2 := add_le_add_left (surfaceDimension q hh) _
    _ = 4 := by norm_num

private def coordinates (i : Fin 4) : Jet :=
  ![C (C (MvPolynomial.X 0)), C (C (MvPolynomial.X 1)), C Polynomial.X, Polynomial.X] i

private def sectionCoordinates (i : Fin 4) : SectionJet :=
  ![C (C (MvPolynomial.X 0)), C (C (MvPolynomial.X 1)), C Polynomial.X, Polynomial.X] i

private theorem sectionMap_coordinates (i : Fin 4) :
    sectionMap (coordinates i) = sectionCoordinates i := by
  fin_cases i <;> simp [coordinates, sectionCoordinates, sectionMap]

private def parameterMap (q : Surface) : Parameters →ₐ[FX] Numerators q :=
  let x (i : Fin 4) : Numerators q := MvPolynomial.C (Ideal.Quotient.mk q.asIdeal (coordinates i))
  MvPolynomial.aeval
    ![MvPolynomial.X 0, MvPolynomial.X 1, x 0 + MvPolynomial.X 0 * x 1,
      x 2 + MvPolynomial.X 1 * x 3]

private abbrev SliceRing (q : Surface) := SectionRing q .mixed

private def sectionMk (q : Surface) : SectionJet →+* SliceRing q :=
  Ideal.Quotient.mk (sectionIdeal q .mixed)

private def surfaceMap (q : Surface) : SurfaceRing q →+* SliceRing q :=
  Ideal.Quotient.lift q.asIdeal ((sectionMk q).comp sectionMap) fun _ hx =>
    Ideal.Quotient.eq_zero_iff_mem.mpr
      ((le_sup_left : q.asIdeal.map sectionMap ≤ sectionIdeal q .mixed)
        (Ideal.mem_map_of_mem sectionMap hx))

private def numeratorMap (q : Surface) : Numerators q →+* SliceRing q :=
  MvPolynomial.eval₂Hom (surfaceMap q)
    ![algebraMap SectionField (SliceRing q) (sectionParameter 0),
      algebraMap SectionField (SliceRing q) (sectionParameter 1)]

private theorem numeratorMap_coordinates (q : Surface) (i : Fin 4) :
    numeratorMap q (MvPolynomial.C (Ideal.Quotient.mk q.asIdeal (coordinates i))) =
      sectionMk q (sectionCoordinates i) := by
  rw [numeratorMap, MvPolynomial.eval₂Hom_C]
  change sectionMk q (sectionMap (coordinates i)) = _
  rw [sectionMap_coordinates]

private theorem parameterScalar (q : Surface) (i : Fin 4) :
    algebraMap SectionField (SliceRing q) (sectionParameter i) =
      sectionMk q (sectionScalar i) := rfl

private theorem numeratorMap_X_zero (q : Surface) :
    numeratorMap q (MvPolynomial.X 0) = sectionMk q (sectionScalar 0) := by
  rw [numeratorMap, MvPolynomial.eval₂Hom_X']
  exact parameterScalar q 0

private theorem numeratorMap_X_one (q : Surface) :
    numeratorMap q (MvPolynomial.X 1) = sectionMk q (sectionScalar 1) := by
  rw [numeratorMap, MvPolynomial.eval₂Hom_X']
  exact parameterScalar q 1

/-- In the section, the two offsets agree with the corresponding affine linear forms. -/
private theorem parameterSquare (q : Surface) :
    (numeratorMap q).comp (parameterMap q).toRingHom =
      (algebraMap SectionField (SliceRing q)).comp (algebraMap Parameters SectionField) := by
  have hline (x : SectionJet) (i : Fin 4)
      (hx : x - sectionScalar i ∈ sectionEquations .mixed) :
      sectionMk q x = sectionMk q (sectionScalar i) := by
    rw [← sub_eq_zero, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      ((le_sup_right : Ideal.span (sectionEquations .mixed) ≤ sectionIdeal q .mixed)
        (Ideal.subset_span hx))
  apply MvPolynomial.ringHom_ext
  · intro r
    change numeratorMap q ((parameterMap q) (MvPolynomial.C r)) = _
    rw [parameterMap, MvPolynomial.aeval_C]
    change numeratorMap q (MvPolynomial.C (Ideal.Quotient.mk q.asIdeal
      (C (C (MvPolynomial.C r))))) = sectionMk q
      (C (C (MvPolynomial.C (algebraMap FX SectionField r))))
    rw [numeratorMap, MvPolynomial.eval₂Hom_C]
    change sectionMk q (sectionMap (C (C (MvPolynomial.C r)))) = _
    simp [sectionMap]
  · intro i
    change numeratorMap q ((parameterMap q) (MvPolynomial.X i)) =
      algebraMap SectionField (SliceRing q) (sectionParameter i)
    rw [parameterMap, MvPolynomial.aeval_X, parameterScalar]
    fin_cases i
    · exact numeratorMap_X_zero q
    · exact numeratorMap_X_one q
    · change numeratorMap q (MvPolynomial.C (Ideal.Quotient.mk q.asIdeal (coordinates 0)) +
        MvPolynomial.X 0 * MvPolynomial.C (Ideal.Quotient.mk q.asIdeal (coordinates 1))) = _
      simp only [map_add, map_mul, numeratorMap_coordinates, numeratorMap_X_zero]
      rw [← map_mul, ← map_add]
      apply hline
      left
      rfl
    · change numeratorMap q (MvPolynomial.C (Ideal.Quotient.mk q.asIdeal (coordinates 2)) +
        MvPolynomial.X 1 * MvPolynomial.C (Ideal.Quotient.mk q.asIdeal (coordinates 3))) = _
      simp only [map_add, map_mul, numeratorMap_coordinates, numeratorMap_X_one]
      rw [← map_mul, ← map_add]
      apply hline
      right
      rfl

private theorem sectionFieldTrdeg : Algebra.trdeg FX SectionField = 4 := by
  let : Algebra.IsAlgebraic Parameters SectionField :=
    IsLocalization.isAlgebraic SectionField (nonZeroDivisors Parameters)
  rw [← trdeg_add_eq FX Parameters (A := SectionField), trdeg_eq_zero (R := Parameters) (A := SectionField),
    add_zero, MvPolynomial.trdeg_of_isDomain]
  simp

private theorem integralOfTrdegLe (D : Type) [CommRing D] [IsDomain D] [Algebra FX D]
    [Algebra SectionField D] [IsScalarTower FX SectionField D]
    (hd : Algebra.trdeg FX D ≤ 4) : Algebra.IsIntegral SectionField D := by
  have hsum := trdeg_add_eq FX SectionField (A := D)
  rw [sectionFieldTrdeg] at hsum
  have hzero : Algebra.trdeg SectionField D = 0 := by
    have hbound : Algebra.trdeg SectionField D + (4 : Cardinal) ≤ 0 + (4 : Cardinal) := by
      rw [add_comm (Algebra.trdeg SectionField D), hsum, zero_add]
      exact hd
    exact le_antisymm ((Cardinal.add_nat_le_add_nat_iff 4).mp hbound) bot_le
  exact Algebra.isAlgebraic_iff_isIntegral.mp (trdeg_eq_zero_iff.mp hzero)

private theorem sectionLiftSurjective (q : Surface) {D : Type} [CommRing D]
    (u : SectionField →+* D) (v : D →+* SliceRing q)
    (hv : v.comp u = algebraMap SectionField (SliceRing q))
    (coord : Fin 4 → D)
    (hcoord : ∀ i, v (coord i) = sectionMk q (sectionCoordinates i)) :
    Function.Surjective v := by
  let eval : SectionJet →+* D :=
    eval₂RingHom (eval₂RingHom (MvPolynomial.eval₂Hom u (fun i => coord i.castSucc.castSucc))
      (coord 2)) (coord 3)
  have heval : v.comp eval = sectionMk q := by
    apply Polynomial.ringHom_ext'
    · apply Polynomial.ringHom_ext'
      · apply MvPolynomial.ringHom_ext
        · intro r
          change v (eval (C (C (MvPolynomial.C r)))) = sectionMk q (C (C (MvPolynomial.C r)))
          simp only [eval, coe_eval₂RingHom, eval₂_C, MvPolynomial.eval₂Hom_C]
          exact RingHom.congr_fun hv r
        · intro i
          change v (eval (C (C (MvPolynomial.X i)))) = sectionMk q (C (C (MvPolynomial.X i)))
          simp only [eval, coe_eval₂RingHom, eval₂_C, MvPolynomial.eval₂Hom_X']
          fin_cases i
          · exact hcoord 0
          · exact hcoord 1
      · change v (eval (C Polynomial.X)) = sectionMk q (sectionCoordinates 2)
        simpa only [eval, coe_eval₂RingHom, eval₂_C, eval₂_X] using hcoord 2
    · change v (eval Polynomial.X) = sectionMk q (sectionCoordinates 3)
      simpa only [eval, coe_eval₂RingHom, eval₂_X] using hcoord 3
  intro x
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (I := sectionIdeal q .mixed) x
  exact ⟨eval p, (RingHom.congr_fun heval p).trans hp⟩

/-- Invert the nonzero parameter polynomials and transfer integrality to the section. -/
private theorem finiteOfParameterMap {A S : Type} [CommRing A] [IsDomain A] [Algebra FX A]
    [CommRing S] [Algebra SectionField S] [Algebra.FiniteType SectionField S]
    (j : Parameters →ₐ[FX] A) (m : A →+* S)
    (hm : m.comp j.toRingHom =
      (algebraMap SectionField S).comp (algebraMap Parameters SectionField))
    (htrdeg : Algebra.trdeg FX A ≤ 4)
    (liftSurjective : ∀ (D : Type) [CommRing D] (u : SectionField →+* D)
      (v : D →+* S) (w : A →+* D), v.comp u = algebraMap SectionField S →
        v.comp w = m → Function.Surjective v) :
    Module.Finite SectionField S := by
  rcases subsingleton_or_nontrivial S with hS | hS
  · let := hS
    exact Module.Finite.of_surjective (Algebra.linearMap SectionField S)
      (fun x => ⟨0, Subsingleton.elim _ x⟩)
  let := hS
  have hcomp : Function.Injective (m.comp j.toRingHom) := by
    rw [hm]
    exact (algebraMap SectionField S).injective.comp
      (IsFractionRing.injective Parameters SectionField)
  have hj : Function.Injective j := fun _ _ h => hcomp (congrArg m h)
  let M := (nonZeroDivisors Parameters).map j.toRingHom.toMonoidHom
  have hM : M ≤ nonZeroDivisors A :=
    map_le_nonZeroDivisors_of_injective j.toRingHom hj le_rfl
  let D := Localization M
  let : IsDomain D := IsLocalization.isDomain_localization hM
  let : FaithfulSMul A D := (faithfulSMul_iff_algebraMap_injective A D).mpr (IsLocalization.injective D hM)
  let u : SectionField →+* D :=
    IsLocalization.lift (M := nonZeroDivisors Parameters)
      (g := (algebraMap A D).comp j.toRingHom)
      (fun x => IsLocalization.map_units D (⟨j x, ⟨x, x.2, rfl⟩⟩ : M))
  let : Algebra SectionField D := u.toAlgebra
  let : IsScalarTower FX SectionField D := IsScalarTower.of_algebraMap_eq (by
    intro r
    rw [IsScalarTower.algebraMap_apply FX A D, IsScalarTower.algebraMap_apply FX Parameters SectionField]
    change algebraMap A D (algebraMap FX A r) = u (algebraMap Parameters SectionField (algebraMap FX Parameters r))
    simp [u])
  have hd : Algebra.trdeg FX D ≤ 4 := by
    let : Algebra.IsAlgebraic A D := IsLocalization.isAlgebraic D M
    rw [← trdeg_add_eq FX A (A := D), trdeg_eq_zero (R := A) (A := D), add_zero]
    exact htrdeg
  let : Algebra.IsIntegral SectionField D := integralOfTrdegLe D hd
  have hu : ∀ x : M, IsUnit (m x) := by
    rintro ⟨_, x, hx, rfl⟩
    change IsUnit ((m.comp j.toRingHom) x)
    rw [hm, RingHom.comp_apply]
    have hx' : algebraMap Parameters SectionField x ≠ 0 := by
      simpa only [map_zero] using
        (IsFractionRing.injective Parameters SectionField).ne
          (mem_nonZeroDivisors_iff_ne_zero.mp hx)
    exact (isUnit_iff_ne_zero.mpr hx').map (algebraMap SectionField S)
  let v : D →+* S := IsLocalization.lift hu
  have hv : v.comp u = algebraMap SectionField S := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors Parameters)
    apply RingHom.ext
    intro x
    simp only [RingHom.comp_apply, u, v, IsLocalization.lift_eq]
    exact RingHom.congr_fun hm x
  let e : D →ₐ[SectionField] S := ⟨v, RingHom.congr_fun hv⟩
  have hsurj := liftSurjective D u v (algebraMap A D) hv (IsLocalization.lift_comp hu)
  let : Algebra.IsIntegral SectionField S := ⟨fun x => by
    obtain ⟨y, rfl⟩ := hsurj x
    exact (Algebra.IsIntegral.isIntegral y).map e⟩
  exact Algebra.IsIntegral.finite

private theorem mixedFinite (q : Surface) (hh : q.asIdeal.height = 2) :
    Module.Finite SectionField (SliceRing q) := by
  apply finiteOfParameterMap (parameterMap q) (numeratorMap q)
    (parameterSquare q) (numeratorTrdeg q hh)
  intro D _ u v w hv hw
  let coord (i : Fin 4) : D :=
    w (MvPolynomial.C (Ideal.Quotient.mk q.asIdeal (coordinates i)))
  apply sectionLiftSurjective q u v hv coord
  intro i
  exact (RingHom.congr_fun hw _).trans (numeratorMap_coordinates q i)

theorem proof : K1A_14_3_2_5.c3 := by
  intro q _ hh _ _
  exact mixedFinite q hh

