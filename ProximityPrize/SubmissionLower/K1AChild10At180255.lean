      ((Fintype.card ι - keep.card : ℕ) : ℚ) * (M * affineDegree P * R^e) =
          (((Fintype.card ι - keep.card) * M : ℕ) : ℚ) * (affineDegree P * R^e) := by
        rw [Nat.cast_mul]
