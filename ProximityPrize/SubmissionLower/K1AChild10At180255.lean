    (hratio : ∀ m < L, (((Fintype.card ι - m) * M : ℕ) : ℚ) ≤ R * ((A - m : ℕ) : ℚ))
    (S : Finset (Fin 3 → F)) (hS : ∀ x ∈ S, aeval x g = 0 ∧ aeval x s ≠ 0)
    (hA : ∀ x ∈ S, A ≤ {i | aeval x (cuts i) = 0}.ncard)
    (hterminal : ∀ J : Ideal (MvPolynomial (Fin 3) F), L ≤ {i | cuts i ∈ J}.ncard →
