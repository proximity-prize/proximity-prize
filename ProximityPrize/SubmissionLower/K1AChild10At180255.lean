        (fun x hx => ⟨hzero x hx, hreg x (hW hx)⟩) (by positivity) fun Q hQ => ?_
      have hQmin := (Ideal.mem_retainedMinimalPrimes.mp hQ).1
      have : Q.IsPrime := hQmin.isPrime
