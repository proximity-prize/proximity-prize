namespace NonicComponents

/-!
There is a classification-free route through the reducible residual cases in
degree nine.  A primitive permutation action of composite degree nine cannot
have a nontrivial suborbit of size one: equality of two point stabilizers gives
a block relation, and the resulting regular alternative is imprimitive in
degree nine.  Hence every collision component of a primitive degree-nine map
has coordinate degree `s` between two and eight.

For all seven values at once, take `h=12`, `k=1`, and `n=25`.  Triviality of
the odd-degree coordinate kernel gives quotient coordinate degree at least
`s`, so the low alternative (which would require it to be at most one) is
impossible.  With `chi <= 2*s^2`, the cleared useful bound is

`15360*s + 1200*s^2 < 50*(504*s)` for `2 <= s <= 8`.

If the degree-nine monodromy is imprimitive, the rational map decomposes as
degrees three after three.  Each of the 56 full nine-point fibres contains
three full fibres of the inner cubic, giving 168 full cubic fibres.  The final
receipts show that these already exceed both cubic collision caps.
-/

def componentParameterH : Nat := 12
def componentParameterK : Nat := 1
def componentParameterN : Nat := 25

def usedSubgroupPoints : Nat := 504
def cubicInnerFullFibres : Nat := 168
def cubicIrreducibleCollisionCap : Nat := 768
def cubicGraphCollisionCap : Nat := 305

theorem component_parameter_denominator_receipt :
    componentParameterH * componentParameterK + componentParameterH +
      componentParameterK = componentParameterN := by
  norm_num [componentParameterH, componentParameterK, componentParameterN]

theorem component_characteristic_condition_receipt (s : Nat) (hs : s ≤ 8) :
    subgroupOrder * s * componentParameterH +
        subgroupOrder * s * componentParameterK < baseCharacteristic := by
  norm_num [subgroupOrder, componentParameterH, componentParameterK,
    baseCharacteristic]
  omega

theorem component_cap_identity (s : Nat) :
    2 * (componentParameterH + 2 * componentParameterK) * (subgroupOrder * s) +
        2 * componentParameterK * (subgroupOrder * s) +
        (componentParameterN - 1) * componentParameterN * (2 * s ^ 2) =
      15360 * s + 1200 * s ^ 2 := by
  norm_num [componentParameterH, componentParameterK, componentParameterN,
    subgroupOrder]
  ring

theorem component_cap_below_required (s : Nat) (hlow : 2 ≤ s) (hhigh : s ≤ 8) :
    15360 * s + 1200 * s ^ 2 < 2 * componentParameterN * (usedSubgroupPoints * s) := by
  interval_cases s <;>
    norm_num [componentParameterN, usedSubgroupPoints]

theorem no_primitive_component_of_parameterized_cap
    (s componentPoints : Nat) (hlow : 2 ≤ s) (hhigh : s ≤ 8)
    (hfull : usedSubgroupPoints * s ≤ componentPoints)
    (hcap : 2 * componentParameterN * componentPoints ≤
      15360 * s + 1200 * s ^ 2) : False := by
  have hscaled : 2 * componentParameterN * (usedSubgroupPoints * s) ≤
      2 * componentParameterN * componentPoints := Nat.mul_le_mul_left _ hfull
  have hupper := hscaled.trans hcap
  exact (Nat.not_le_of_lt (component_cap_below_required s hlow hhigh)) hupper

theorem component_quotient_degree_not_le_one
    (s descentDegree quotientCoordinateDegree : Nat)
    (hs : 2 ≤ s)
    (hdegree : descentDegree * quotientCoordinateDegree = subgroupOrder * s)
    (hdescent : descentDegree ≤ subgroupOrder)
    (hlow : quotientCoordinateDegree ≤ componentParameterK) : False := by
  have hmul : descentDegree * quotientCoordinateDegree ≤
      subgroupOrder * componentParameterK := Nat.mul_le_mul hdescent hlow
  rw [hdegree] at hmul
  norm_num [subgroupOrder, componentParameterK] at hmul
  omega

theorem cubic_inner_fibre_receipt : Nonic.fullFibres * 3 = cubicInnerFullFibres := by
  norm_num [Nonic.fullFibres, cubicInnerFullFibres]

theorem cubic_inner_irreducible_breaks_cap :
    cubicInnerFullFibres * 3 * 2 > cubicIrreducibleCollisionCap := by
  norm_num [cubicInnerFullFibres, cubicIrreducibleCollisionCap]

theorem cubic_inner_graph_breaks_cap :
    cubicInnerFullFibres * 3 > cubicGraphCollisionCap := by
  norm_num [cubicInnerFullFibres, cubicGraphCollisionCap]

end NonicComponents

namespace PrimeComponents

/-!
The same component ledger continues through the next two prime degrees.
For a prime-degree primitive action, a size-one suborbit is the regular cyclic
case; every other component has coordinate degree at least two.  Since 11 and
13 are coprime to 512, the coordinate-kernel/deck argument bounds every
component descent degree by 512.

The one choice `h=5`, `k=1`, `n=11` handles every non-graph component:

`8192*s + 220*s^2`

is the cleared cap.  Degree eleven uses 506 subgroup inputs and component
degrees `2 <= s <= 10`; degree thirteen uses 507 inputs and
`2 <= s <= 12`.  The regular cyclic graph is treated by the same 305-point
non-toric graph cap as in degree seven, with the toric scaling order excluded
by coprimality with 512.
-/

def parameterH : Nat := 5
def parameterK : Nat := 1
def parameterN : Nat := 11

def degreeElevenUsedPoints : Nat := 506
def degreeThirteenUsedPoints : Nat := 507
def graphCap : Nat := 305

theorem parameter_denominator_receipt :
    parameterH * parameterK + parameterH + parameterK = parameterN := by
  norm_num [parameterH, parameterK, parameterN]

theorem characteristic_condition_receipt (s : Nat) (hs : s ≤ 12) :
    subgroupOrder * s * parameterH + subgroupOrder * s * parameterK <
      baseCharacteristic := by
  norm_num [subgroupOrder, parameterH, parameterK, baseCharacteristic]
  omega

theorem component_cap_identity (s : Nat) :
    2 * (parameterH + 2 * parameterK) * (subgroupOrder * s) +
        2 * parameterK * (subgroupOrder * s) +
        (parameterN - 1) * parameterN * (2 * s ^ 2) =
      8192 * s + 220 * s ^ 2 := by
  norm_num [parameterH, parameterK, parameterN, subgroupOrder]
  ring

theorem degree_eleven_cap_below_required
    (s : Nat) (hlow : 2 ≤ s) (hhigh : s ≤ 10) :
    8192 * s + 220 * s ^ 2 <
      2 * parameterN * (degreeElevenUsedPoints * s) := by
  interval_cases s <;>
    norm_num [parameterN, degreeElevenUsedPoints]

theorem degree_thirteen_cap_below_required
    (s : Nat) (hlow : 2 ≤ s) (hhigh : s ≤ 12) :
    8192 * s + 220 * s ^ 2 <
      2 * parameterN * (degreeThirteenUsedPoints * s) := by
  interval_cases s <;>
    norm_num [parameterN, degreeThirteenUsedPoints]

theorem quotient_coordinate_degree_not_le_one
    (s descentDegree quotientCoordinateDegree : Nat)
    (hs : 2 ≤ s)
    (hdegree : descentDegree * quotientCoordinateDegree = subgroupOrder * s)
    (hdescent : descentDegree ≤ subgroupOrder)
    (hlow : quotientCoordinateDegree ≤ parameterK) : False := by
  have hmul : descentDegree * quotientCoordinateDegree ≤ subgroupOrder * parameterK :=
    Nat.mul_le_mul hdescent hlow
  rw [hdegree] at hmul
  norm_num [subgroupOrder, parameterK] at hmul
  omega

theorem no_degree_eleven_component_of_parameterized_cap
    (s componentPoints : Nat) (hlow : 2 ≤ s) (hhigh : s ≤ 10)
    (hfull : degreeElevenUsedPoints * s ≤ componentPoints)
    (hcap : 2 * parameterN * componentPoints ≤ 8192 * s + 220 * s ^ 2) : False := by
  have hscaled : 2 * parameterN * (degreeElevenUsedPoints * s) ≤
      2 * parameterN * componentPoints := Nat.mul_le_mul_left _ hfull
  have hupper := hscaled.trans hcap
  exact (Nat.not_le_of_lt (degree_eleven_cap_below_required s hlow hhigh)) hupper

theorem no_degree_thirteen_component_of_parameterized_cap
    (s componentPoints : Nat) (hlow : 2 ≤ s) (hhigh : s ≤ 12)
    (hfull : degreeThirteenUsedPoints * s ≤ componentPoints)
    (hcap : 2 * parameterN * componentPoints ≤ 8192 * s + 220 * s ^ 2) : False := by
  have hscaled : 2 * parameterN * (degreeThirteenUsedPoints * s) ≤
      2 * parameterN * componentPoints := Nat.mul_le_mul_left _ hfull
  have hupper := hscaled.trans hcap
  exact (Nat.not_le_of_lt (degree_thirteen_cap_below_required s hlow hhigh)) hupper

theorem degree_eleven_cyclic_graph_breaks_cap : degreeElevenUsedPoints > graphCap := by
  norm_num [degreeElevenUsedPoints, graphCap]

theorem degree_thirteen_cyclic_graph_breaks_cap : degreeThirteenUsedPoints > graphCap := by
  norm_num [degreeThirteenUsedPoints, graphCap]

theorem no_degree_eleven_cyclic_graph_of_cap
    (componentPoints : Nat)
    (hfull : degreeElevenUsedPoints ≤ componentPoints)
    (hcap : componentPoints ≤ graphCap) : False := by
  have := hfull.trans hcap
  norm_num [degreeElevenUsedPoints, graphCap] at this

theorem no_degree_thirteen_cyclic_graph_of_cap
    (componentPoints : Nat)
    (hfull : degreeThirteenUsedPoints ≤ componentPoints)
    (hcap : componentPoints ≤ graphCap) : False := by
  have := hfull.trans hcap
  norm_num [degreeThirteenUsedPoints, graphCap] at this

theorem degree_eleven_scaling_trivial {F : Type*} [Field F] {r : F}
    (hdegree : r ^ 11 = 1) (hsubgroup : r ^ subgroupOrder = 1) : r = 1 := by
  exact (pow_eq_one_iff_of_coprime (by norm_num [subgroupOrder] : Nat.Coprime 11 512)).mp
    ⟨hdegree, by simpa [subgroupOrder] using hsubgroup⟩

theorem degree_thirteen_scaling_trivial {F : Type*} [Field F] {r : F}
    (hdegree : r ^ 13 = 1) (hsubgroup : r ^ subgroupOrder = 1) : r = 1 := by
  exact (pow_eq_one_iff_of_coprime (by norm_num [subgroupOrder] : Nat.Coprime 13 512)).mp
    ⟨hdegree, by simpa [subgroupOrder] using hsubgroup⟩

end PrimeComponents

