        2 * frobeniusParameterK * frobeniusPowerCoordinateDegree +
        (frobeniusParameterN - 1) * frobeniusParameterN *
          frobeniusEulerCharacteristicCap = frobeniusClearedCap := by
  norm_num [frobeniusParameterH, frobeniusParameterK, frobeniusParameterN,
