import ProximityPrize.Benchmark.TargetUpper

/-!
# Coordinate-kernel gate for odd collision folds

Let `f` be a rational map and let `C` be an irreducible component of its
off-diagonal collision curve `f(x) = f(y)`.  Suppose that a subgroup of
`mu_512 x mu_512` stabilizes `C`.  A coordinate-kernel element `(1, eta)`
has a consequence special to collision curves:

* on `C`, both `f(x) = f(y)` and `f(x) = f(eta*y)` hold;
* dominance of `C -> P^1_y` therefore gives the rational-function identity
  `f(y) = f(eta*y)`;
* the scaling group generated by `eta` is consequently a deck subgroup of
  `f`, so its order divides `deg(f)`.

The kernel order also divides 512.  Thus it is one for every odd map degree.
Both coordinate projections of the stabilizer are injective and the descent
degree is at most 512.  This is stronger than the generic-fibre estimate
`kernelOrder | collisionCoordinateDegree`, and removes the apparent descent
degrees 1024 in degree seven and 4096 in degree nine.

The function-field implication producing `kernelOrder | mapDegree` is kept as
an explicit hypothesis below.  The finite arithmetic, exact parameter choices,
and numerical consumers are fully checked here.  The accompanying executable
ledger is `scripts/upper-odd-fold-stabilizer-audit.py`.
-/

namespace ProximityPrize.SubmissionUpper.OddFoldStabilizerKernelGate

def subgroupOrder : Nat := 512
def baseCharacteristic : Nat := 2130706433

/-- Once a coordinate-kernel symmetry is known to be a deck symmetry, coprimality
with the ambient subgroup order makes the coordinate kernel trivial. -/
theorem collision_kernel_trivial_of_coprime_map_degree
    (mapDegree kernelOrder : Nat)
    (hcoprime : Nat.Coprime mapDegree subgroupOrder)
    (hmap : kernelOrder ∣ mapDegree)
    (hsubgroup : kernelOrder ∣ subgroupOrder) : kernelOrder = 1 := by
  exact Nat.eq_one_of_dvd_coprimes hcoprime hmap hsubgroup

/-- On the full residual component the same coordinate kernel acts freely on
the generic `(deg(f)-1)`-point off-diagonal fibre.  Combining that divisibility
with the deck divisibility makes the kernel trivial in every map degree, not
only odd degrees. -/
theorem full_collision_kernel_trivial
    (mapDegree collisionCoordinateDegree kernelOrder : Nat)
    (hsucc : mapDegree = collisionCoordinateDegree + 1)
    (hmap : kernelOrder ∣ mapDegree)
    (hcollision : kernelOrder ∣ collisionCoordinateDegree) : kernelOrder = 1 := by
  have hcoprime : Nat.Coprime mapDegree collisionCoordinateDegree := by
    rw [hsucc, Nat.add_comm]
    exact Nat.coprime_add_self_left.mpr (Nat.coprime_one_left _)
  exact Nat.eq_one_of_dvd_coprimes hcoprime hmap hcollision

theorem septic_collision_kernel_trivial
    (kernelOrder : Nat) (hmap : kernelOrder ∣ 7)
    (hsubgroup : kernelOrder ∣ subgroupOrder) : kernelOrder = 1 := by
  exact collision_kernel_trivial_of_coprime_map_degree 7 kernelOrder
    (by norm_num [subgroupOrder]) hmap hsubgroup

theorem nonic_collision_kernel_trivial
    (kernelOrder : Nat) (hmap : kernelOrder ∣ 9)
    (hsubgroup : kernelOrder ∣ subgroupOrder) : kernelOrder = 1 := by
  exact collision_kernel_trivial_of_coprime_map_degree 9 kernelOrder
    (by norm_num [subgroupOrder]) hmap hsubgroup

/-- First-isomorphism cardinal accounting: if the coordinate kernel is a deck
subgroup of an odd-degree map, the collision-component stabilizer has order at
most the order of its coordinate projection, hence at most 512. -/
theorem stabilizer_order_le_subgroup_of_coprime_map_degree
    (mapDegree stabilizerOrder projectionOrder kernelOrder : Nat)
    (hcoprime : Nat.Coprime mapDegree subgroupOrder)
    (hcard : stabilizerOrder = projectionOrder * kernelOrder)
    (hprojection : projectionOrder ≤ subgroupOrder)
    (hmap : kernelOrder ∣ mapDegree)
    (hsubgroup : kernelOrder ∣ subgroupOrder) : stabilizerOrder ≤ subgroupOrder := by
  have hkernel : kernelOrder = 1 :=
    collision_kernel_trivial_of_coprime_map_degree mapDegree kernelOrder
      hcoprime hmap hsubgroup
  calc
    stabilizerOrder = projectionOrder := by simpa [hkernel] using hcard
    _ ≤ subgroupOrder := hprojection

theorem no_septic_descent_degree_1024
    (projectionOrder kernelOrder : Nat)
    (hcard : 1024 = projectionOrder * kernelOrder)
    (hprojection : projectionOrder ≤ subgroupOrder)
    (hmap : kernelOrder ∣ 7)
    (hsubgroup : kernelOrder ∣ subgroupOrder) : False := by
  have hle : 1024 ≤ subgroupOrder :=
    stabilizer_order_le_subgroup_of_coprime_map_degree 7 1024 projectionOrder kernelOrder
      (by norm_num [subgroupOrder]) hcard hprojection hmap hsubgroup
  norm_num [subgroupOrder] at hle

theorem no_nonic_descent_degree_4096
    (projectionOrder kernelOrder : Nat)
    (hcard : 4096 = projectionOrder * kernelOrder)
    (hprojection : projectionOrder ≤ subgroupOrder)
    (hmap : kernelOrder ∣ 9)
    (hsubgroup : kernelOrder ∣ subgroupOrder) : False := by
  have hle : 4096 ≤ subgroupOrder :=
    stabilizer_order_le_subgroup_of_coprime_map_degree 9 4096 projectionOrder kernelOrder
      (by norm_num [subgroupOrder]) hcard hprojection hmap hsubgroup
  norm_num [subgroupOrder] at hle

namespace Septic

def mapDegree : Nat := 7
def collisionCoordinateDegree : Nat := 6
def powerCoordinateDegree : Nat := 3072
def eulerCharacteristicCap : Nat := 72
def fullFibres : Nat := 73
def requiredCollisions : Nat := 3066

def parameterH : Nat := 6
def parameterK : Nat := 2
def parameterN : Nat := 20
def clearedParameterizedCap : Nat := 101088

theorem parameter_denominator_receipt :
    parameterH * parameterK + parameterH + parameterK = parameterN := by
  norm_num [parameterH, parameterK, parameterN]

theorem proposition_characteristic_condition_receipt :
    powerCoordinateDegree * parameterH + powerCoordinateDegree * parameterK <
      baseCharacteristic := by
  norm_num [powerCoordinateDegree, parameterH, parameterK, baseCharacteristic]

theorem parameterized_cap_receipt :
    2 * (parameterH + 2 * parameterK) * powerCoordinateDegree +
        2 * parameterK * powerCoordinateDegree +
        (parameterN - 1) * parameterN * eulerCharacteristicCap =
      clearedParameterizedCap := by
  norm_num [parameterH, parameterK, parameterN, powerCoordinateDegree,
    eulerCharacteristicCap, clearedParameterizedCap]

theorem collision_receipt : fullFibres * mapDegree * collisionCoordinateDegree =
    requiredCollisions := by
  norm_num [fullFibres, mapDegree, collisionCoordinateDegree, requiredCollisions]

theorem quotient_coordinate_degree_not_le_two
    (descentDegree quotientCoordinateDegree : Nat)
    (hdegree : descentDegree * quotientCoordinateDegree = powerCoordinateDegree)
    (hdescent : descentDegree ≤ subgroupOrder)
    (hlow : quotientCoordinateDegree ≤ parameterK) : False := by
  have hmul : descentDegree * quotientCoordinateDegree ≤ subgroupOrder * parameterK :=
    Nat.mul_le_mul hdescent hlow
  norm_num [hdegree, powerCoordinateDegree, subgroupOrder, parameterK] at hmul

theorem required_collisions_break_parameterized_cap :
    2 * parameterN * requiredCollisions > clearedParameterizedCap := by
  norm_num [parameterN, requiredCollisions, clearedParameterizedCap]

theorem no_full_fibres_of_parameterized_cap
    (collisionGcd : Nat)
    (hfull : requiredCollisions ≤ collisionGcd)
    (hparameterized : 2 * parameterN * collisionGcd ≤ clearedParameterizedCap) : False := by
  have hrequired : 2 * parameterN * requiredCollisions ≤
      2 * parameterN * collisionGcd := Nat.mul_le_mul_left _ hfull
  have := hrequired.trans hparameterized
  norm_num [parameterN, requiredCollisions, clearedParameterizedCap] at this

end Septic

namespace SepticComponents

/-!
For degree seven, the non-2-transitive affine monodromy groups have point-
stabilizer suborbits of sizes one (`C7`), two (`D14`), or three (`F21`).
An `s`-suborbit gives a collision component of bidegree `(s,s)` and receives
`73 * 7 * s = 511*s` points from the 73 full fibres.  The deck-kernel gate
still bounds every component descent degree by 512.

The size-two and size-three components are excluded below by asymmetric
exact parameters.  A size-one component is a deck graph.  Its 511 subgroup
points exceed the non-toric `(1,1)` bound 305; a toric graph would be a
scaling or inversion, whose order cannot be seven.
-/

def dihedralCoordinateDegree : Nat := 2
def dihedralPowerCoordinateDegree : Nat := 1024
def dihedralEulerCharacteristicCap : Nat := 8
def dihedralRequiredCollisions : Nat := 1022

def dihedralParameterH : Nat := 3
def dihedralParameterK : Nat := 1
def dihedralParameterN : Nat := 7
def dihedralClearedCap : Nat := 12624

theorem dihedral_component_collision_receipt :
    Septic.fullFibres * Septic.mapDegree * dihedralCoordinateDegree =
      dihedralRequiredCollisions := by
  norm_num [Septic.fullFibres, Septic.mapDegree, dihedralCoordinateDegree,
    dihedralRequiredCollisions]

theorem dihedral_parameter_denominator_receipt :
    dihedralParameterH * dihedralParameterK + dihedralParameterH +
      dihedralParameterK = dihedralParameterN := by
  norm_num [dihedralParameterH, dihedralParameterK, dihedralParameterN]

theorem dihedral_parameterized_cap_receipt :
    2 * (dihedralParameterH + 2 * dihedralParameterK) *
          dihedralPowerCoordinateDegree +
        2 * dihedralParameterK * dihedralPowerCoordinateDegree +
        (dihedralParameterN - 1) * dihedralParameterN *
          dihedralEulerCharacteristicCap = dihedralClearedCap := by
  norm_num [dihedralParameterH, dihedralParameterK, dihedralParameterN,
    dihedralPowerCoordinateDegree, dihedralEulerCharacteristicCap, dihedralClearedCap]

theorem dihedral_quotient_degree_not_le_one
    (descentDegree quotientCoordinateDegree : Nat)
    (hdegree : descentDegree * quotientCoordinateDegree =
      dihedralPowerCoordinateDegree)
    (hdescent : descentDegree ≤ subgroupOrder)
    (hlow : quotientCoordinateDegree ≤ dihedralParameterK) : False := by
  have hmul : descentDegree * quotientCoordinateDegree ≤
      subgroupOrder * dihedralParameterK := Nat.mul_le_mul hdescent hlow
  norm_num [hdegree, dihedralPowerCoordinateDegree, subgroupOrder,
    dihedralParameterK] at hmul

theorem dihedral_required_breaks_cap :
    2 * dihedralParameterN * dihedralRequiredCollisions > dihedralClearedCap := by
  norm_num [dihedralParameterN, dihedralRequiredCollisions, dihedralClearedCap]

theorem no_dihedral_component_of_parameterized_cap
    (componentPoints : Nat)
    (hfull : dihedralRequiredCollisions ≤ componentPoints)
    (hcap : 2 * dihedralParameterN * componentPoints ≤ dihedralClearedCap) : False := by
  have hscaled : 2 * dihedralParameterN * dihedralRequiredCollisions ≤
      2 * dihedralParameterN * componentPoints := Nat.mul_le_mul_left _ hfull
  have := hscaled.trans hcap
  norm_num [dihedralParameterN, dihedralRequiredCollisions, dihedralClearedCap] at this

def frobeniusCoordinateDegree : Nat := 3
def frobeniusPowerCoordinateDegree : Nat := 1536
def frobeniusEulerCharacteristicCap : Nat := 18
def frobeniusRequiredCollisions : Nat := 1533

def frobeniusParameterH : Nat := 6
def frobeniusParameterK : Nat := 2
def frobeniusParameterN : Nat := 20
def frobeniusClearedCap : Nat := 43704

theorem frobenius_component_collision_receipt :
