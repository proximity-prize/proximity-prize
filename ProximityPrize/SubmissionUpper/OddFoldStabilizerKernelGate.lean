theorem frobenius_quotient_degree_not_le_two
    (descentDegree quotientCoordinateDegree : Nat)
    (hdegree : descentDegree * quotientCoordinateDegree =
      frobeniusPowerCoordinateDegree)
    (hdescent : descentDegree ≤ subgroupOrder)
    (hlow : quotientCoordinateDegree ≤ frobeniusParameterK) : False := by
  have hmul : descentDegree * quotientCoordinateDegree ≤
      subgroupOrder * frobeniusParameterK := Nat.mul_le_mul hdescent hlow
  norm_num [hdegree, frobeniusPowerCoordinateDegree, subgroupOrder,
    frobeniusParameterK] at hmul

theorem frobenius_required_breaks_cap :
    2 * frobeniusParameterN * frobeniusRequiredCollisions > frobeniusClearedCap := by
  norm_num [frobeniusParameterN, frobeniusRequiredCollisions, frobeniusClearedCap]

theorem no_frobenius_component_of_parameterized_cap
    (componentPoints : Nat)
    (hfull : frobeniusRequiredCollisions ≤ componentPoints)
    (hcap : 2 * frobeniusParameterN * componentPoints ≤ frobeniusClearedCap) : False := by
  have hscaled : 2 * frobeniusParameterN * frobeniusRequiredCollisions ≤
      2 * frobeniusParameterN * componentPoints := Nat.mul_le_mul_left _ hfull
  have := hscaled.trans hcap
  norm_num [frobeniusParameterN, frobeniusRequiredCollisions, frobeniusClearedCap] at this

def cyclicGraphRequiredCollisions : Nat := 511
def nonToricGraphCap : Nat := 305
def graphEulerCharacteristicCap : Nat := 2

theorem cyclic_component_collision_receipt :
    Septic.fullFibres * Septic.mapDegree = cyclicGraphRequiredCollisions := by
  norm_num [Septic.fullFibres, Septic.mapDegree, cyclicGraphRequiredCollisions]

theorem graph_first_branch_receipt :
    54 * subgroupOrder ^ 2 * graphEulerCharacteristicCap < nonToricGraphCap ^ 3 := by
  norm_num [subgroupOrder, graphEulerCharacteristicCap, nonToricGraphCap]

theorem graph_second_branch_receipt :
    12 * subgroupOrder ^ 2 < nonToricGraphCap * baseCharacteristic := by
  norm_num [subgroupOrder, nonToricGraphCap, baseCharacteristic]

theorem cyclic_required_breaks_graph_cap :
    cyclicGraphRequiredCollisions > nonToricGraphCap := by
  norm_num [cyclicGraphRequiredCollisions, nonToricGraphCap]

theorem no_cyclic_component_of_graph_cap
    (componentPoints : Nat)
    (hfull : cyclicGraphRequiredCollisions ≤ componentPoints)
    (hcap : componentPoints ≤ nonToricGraphCap) : False := by
  have := hfull.trans hcap
  norm_num [cyclicGraphRequiredCollisions, nonToricGraphCap] at this

/-- A toric scaling graph cannot simultaneously have order seven and have
its scaling constant in the order-512 subgroup. -/
theorem septic_scaling_trivial {F : Type*} [Field F] {r : F}
    (hseven : r ^ 7 = 1) (hsubgroup : r ^ subgroupOrder = 1) : r = 1 := by
  exact (pow_eq_one_iff_of_coprime (by norm_num [subgroupOrder] : Nat.Coprime 7 512)).mp
    ⟨hseven, by simpa [subgroupOrder] using hsubgroup⟩

end SepticComponents

